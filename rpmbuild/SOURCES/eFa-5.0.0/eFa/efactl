def _mysql_env():
    env = dict(os.environ)
    for line in _read_lines(MYSQL_CONFIG):
        if line.startswith('MYSQLROOTPWD:'):
            env['MYSQL_PWD'] = line.split(':', 1)[1]
    return env


def backup_now(_args):
    """Back up eFa settings, DKIM keys and the database; backups older than 5 days are removed."""
    os.makedirs(BACKUP_DIR, mode=0o700, exist_ok=True)
    os.chmod(BACKUP_DIR, 0o700)
    # A name used twice would overwrite a backup, for example the one about to be restored.
    while True:
        name = time.strftime('efa-backup-%Y%m%d-%H%M%S.tar.gz')
        if not os.path.exists(f'{BACKUP_DIR}/{name}'):
            break
        time.sleep(1)
    with tempfile.TemporaryDirectory(dir=BACKUP_DIR) as tmp:
        dump = None
        if shutil.which('mysqldump'):
            dump = tmp + '/backup.sql'
            with open(dump, 'w') as f:
                subprocess.run(['mysqldump', '--user=root', '--all-databases', '--events', '--single-transaction'],
                               stdout=f, env=_mysql_env(), check=True, stderr=subprocess.PIPE)
        path = f'{BACKUP_DIR}/{name}'
        with tarfile.open(path + '.tmp', 'w:gz') as tar:
            os.chmod(path + '.tmp', 0o600)
            for item in BACKUP_PATHS:
                if os.path.exists(item):
                    tar.add(item, arcname=item.lstrip('/'))
            if dump:
                tar.add(dump, arcname='backup.sql')
        os.replace(path + '.tmp', path)
    cutoff = time.time() - BACKUP_KEEP_DAYS * 86400
    for old in glob.glob(f'{BACKUP_DIR}/efa-backup-*.tar.gz'):
        if os.path.getmtime(old) < cutoff:
            os.remove(old)
    return {'backup': name, 'size': os.path.getsize(path), 'database': bool(dump)}


def backup_list(_args):
    """List available backups."""
    return {'backups': sorted(os.path.basename(b) for b in glob.glob(f'{BACKUP_DIR}/efa-backup-*.tar.gz'))}


def restore(args):
    """Restore a backup. A backup of the current state is made first."""
    _confirm(args)
    name = args.name.strip()
    if not BACKUP_NAME_RE.match(name) or not os.path.exists(f'{BACKUP_DIR}/{name}'):
        raise EfaError('Unknown backup.')
    safety = backup_now(None)['backup']
    allowed = tuple(item.lstrip('/') for item in BACKUP_PATHS)
    with tempfile.TemporaryDirectory(dir=BACKUP_DIR) as tmp:
        with tarfile.open(f'{BACKUP_DIR}/{name}') as tar:
            members = [m for m in tar.getmembers()
                       if m.name == 'backup.sql' or any(m.name == x or m.name.startswith(x + '/') for x in allowed)]
            tar.extractall(tmp, members=members, filter='tar')
        for member in members:
            if member.name == 'backup.sql' or member.isdir():
                continue
            target = '/' + member.name
            os.makedirs(os.path.dirname(target), exist_ok=True)
            # Copying a symlink fails when the target already exists.
            if member.issym() and os.path.lexists(target):
                os.remove(target)
            shutil.copy2(f'{tmp}/{member.name}', target, follow_symlinks=False)
            os.chown(target, member.uid, member.gid, follow_symlinks=False)
        dump = tmp + '/backup.sql'
        if os.path.exists(dump):
            with open(dump) as f:
                subprocess.run(['mysql', '--user=root'], stdin=f, env=_mysql_env(), check=True, capture_output=True)
    # Copied files keep the label of the temp directory, and SELinux would lock services out of them.
    subprocess.run(['restorecon', '-R'] + [item for item in BACKUP_PATHS if os.path.exists(item)], check=False,
                   capture_output=True)
    for service in ('postfix', 'rspamd', 'nginx', 'unbound'):
        subprocess.run(['systemctl', 'reload-or-restart', service], check=False, capture_output=True)
    return {'restored': name, 'safety_backup': safety, 'files': len(members)}


def mariadb_repair(args):
    """Repair and optimize all databases. Mail stays queued meanwhile."""
    _confirm(args)
    env = _mysql_env()
    subprocess.run(['systemctl', 'stop', 'postfix'], check=False, capture_output=True)
    try:
        for mode in ('--repair', '--optimize'):
            done = subprocess.run(['mysqlcheck', '--user=root', mode, '--all-databases'], env=env,
                                  capture_output=True, text=True, check=True)
    finally:
        subprocess.run(['systemctl', 'start', 'postfix'], check=False, capture_output=True)
    return {'mariadb_repair': 'done', 'output': done.stdout[-500:]}


def network_show(_args):
    """Current hostname and network settings."""
    device = _network_device()
    done = subprocess.run(['nmcli', '-t', '-f', 'ipv4.method,ipv4.addresses,ipv4.gateway,ipv4.dns',
                           'connection', 'show', device], capture_output=True, text=True, check=True)
    return dict(line.split(':', 1) for line in done.stdout.splitlines()) | {
        'connection': device, 'hostname': subprocess.run(['hostname', '-f'], capture_output=True, text=True).stdout.strip()}


def _network_device():
    done = subprocess.run(['nmcli', '-t', '-f', 'NAME,TYPE', 'connection', 'show', '--active'],
                          capture_output=True, text=True, check=True)
    for line in done.stdout.splitlines():
        name, _, kind = line.rpartition(':')
        if kind == '802-3-ethernet':
            return name
    raise EfaError('No active ethernet connection.')


def network_set(args):
    """Set hostname and IPv4 address. Takes effect after the next reboot so a typo cannot cut the session."""
    _confirm(args)
    fqdn = args.hostname.strip().lower()
    if not DOMAIN_RE.match(fqdn):
        raise EfaError('Hostname must be a full name, for example mx1.example.org.')
    method = args.method.strip()
    if method not in ('auto', 'manual'):
        raise EfaError("Method must be 'auto' or 'manual'.")
    # Validate everything first: nmcli only runs once all input is known to be good.
    if method == 'manual':
        try:
            iface = ipaddress.IPv4Interface(args.address.strip())
            gateway = ipaddress.IPv4Address(args.gateway.strip())
        except ValueError:
            raise EfaError('Address must look like 192.0.2.10/24 and the gateway like 192.0.2.1.')
        if gateway not in iface.network:
            raise EfaError('Gateway is not in the network of the address.')
        ipv4 = ['ipv4.method', 'manual', 'ipv4.addresses', str(iface), 'ipv4.gateway', str(gateway)]
        address = str(iface.ip)
    else:
        ipv4 = ['ipv4.method', 'auto', 'ipv4.addresses', '', 'ipv4.gateway', '']
        address = None
    method6 = args.ipv6_method.strip() or 'ignore'
    if method6 not in ('auto', 'manual', 'ignore'):
        raise EfaError("IPv6 method must be 'auto', 'manual' or 'ignore'.")
    address6 = None
    if method6 == 'manual':
        try:
            iface6 = ipaddress.IPv6Interface(args.ipv6_address.strip())
            gateway6 = ipaddress.IPv6Address(args.ipv6_gateway.strip())
        except ValueError:
            raise EfaError('IPv6 address must look like 2001:db8::10/64 and the gateway like 2001:db8::1.')
        ipv6 = ['ipv6.method', 'manual', 'ipv6.addresses', str(iface6), 'ipv6.gateway', str(gateway6), 'ipv6.dns', '::1']
        address6 = str(iface6.ip)
    else:
        ipv6 = ['ipv6.method', method6, 'ipv6.addresses', '', 'ipv6.gateway', '']
    device = _network_device()
    subprocess.run(['nmcli', 'connection', 'modify', device] + ipv4 + ['ipv4.dns', '127.0.0.1'] + ipv6, check=True,
                   capture_output=True)
    short = fqdn.split('.')[0]
    shutil.copy2(HOSTS, HOSTS + '.bak')
    lines = ['127.0.0.1   localhost localhost.localdomain localhost4 localhost4.localdomain4',
             '::1         localhost localhost.localdomain localhost6 localhost6.localdomain6']
    if address:
        lines.append(f'{address}    {fqdn}   {short}')
    if address6:
        lines.append(f'{address6}    {fqdn}   {short}')
    _write(HOSTS, '\n'.join(lines) + '\n')
    _write(ETC + '/hostname', fqdn + '\n')
    _postconf_set('myhostname', fqdn)
    return {'hostname': fqdn, 'method': method, 'address': args.address.strip(), 'ipv6_method': method6,
            'ipv6_address': args.ipv6_address.strip(), 'effective': 'after reboot'}


def letsencrypt_set(args):
    """Request a Let's Encrypt certificate for nginx and postfix. Port 80 must be reachable from outside."""
    domain = args.domain.strip().lower()
    email = args.email.strip().lower()
    if not DOMAIN_RE.match(domain):
        raise EfaError('Invalid domain.')
    if not SENDER_RE.match(email):
        raise EfaError('Invalid email address.')
    if args.accept_tos.strip() != 'yes':
        raise EfaError("Type 'yes' to accept the Let's Encrypt terms of service.")
    done = subprocess.run(['certbot', '--nginx', '--non-interactive', '--agree-tos', '-m', email, '--domains', domain],
                          capture_output=True, text=True)
    if done.returncode != 0:
        raise EfaError('certbot failed: ' + (done.stderr or done.stdout)[-400:])
    live = f'{ETC}/letsencrypt/live/{domain}'
    _postconf_set('smtpd_tls_key_file', f'{live}/privkey.pem')
    _postconf_set('smtpd_tls_cert_file', f'{live}/fullchain.pem')
    _write(ETC + '/cron.d/certbotrenew',
           '0 0,12 * * * root certbot renew --quiet --deploy-hook "systemctl reload nginx postfix"\n')
    return {'letsencrypt': domain}


def _maillog_db():
    import pymysql
    with open(MAILLOG_PW) as f:
        password = f.read().strip()
    return pymysql.connect(unix_socket='/var/lib/mysql/mysql.sock', user='efa_log', password=password, database='efa',
                           charset='utf8mb4', autocommit=True, cursorclass=pymysql.cursors.DictCursor)


def maillog_setup(_args):
    """Create the mail log database and its restricted user. Safe to run again."""
    os.makedirs(WEB_DIR, mode=0o750, exist_ok=True)
    if os.path.exists(MAILLOG_PW):
        with open(MAILLOG_PW) as f:
            password = f.read().strip()
    else:
        password = secrets.token_urlsafe(32)
        fd = os.open(MAILLOG_PW, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o640)
        with os.fdopen(fd, 'w') as f:
            f.write(password + '\n')
    shutil.chown(MAILLOG_PW, 'root', 'efa-web')
    sql = f"""CREATE DATABASE IF NOT EXISTS efa CHARACTER SET utf8mb4;
CREATE TABLE IF NOT EXISTS efa.maillog (
  id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
  ts DATETIME NOT NULL, qid VARCHAR(64), message_id VARCHAR(255), sender VARCHAR(255), rcpt VARCHAR(1000),
  ip VARCHAR(64), action VARCHAR(32), score FLOAT, subject VARCHAR(500),
  KEY ts (ts), KEY sender (sender), KEY qid (qid));
CREATE USER IF NOT EXISTS 'efa_log'@'localhost' IDENTIFIED BY '{password}';
ALTER USER 'efa_log'@'localhost' IDENTIFIED BY '{password}';
GRANT SELECT, INSERT, DELETE ON efa.maillog TO 'efa_log'@'localhost';"""
    subprocess.run(['mysql', '--user=root'], input=sql, text=True, env=_mysql_env(), check=True, capture_output=True)
    return {'maillog_setup': 'done'}


def maillog_search(args):
    """Search the mail log by sender, recipient, subject, queue ID or IP."""
    try:
        limit = int(args.limit)
    except ValueError:
        raise EfaError('Limit must be a number.')
    if not 1 <= limit <= 1000:
        raise EfaError('Limit must be 1 to 1000.')
    needle = '%' + args.text.strip().replace('\\', '\\\\').replace('%', '\\%').replace('_', '\\_') + '%'
    db = _maillog_db()
    try:
        with db.cursor() as cur:
            cur.execute('SELECT CAST(ts AS CHAR) AS ts, qid, sender, rcpt, ip, action, score, subject FROM maillog '
                        'WHERE sender LIKE %s OR rcpt LIKE %s OR subject LIKE %s OR qid LIKE %s OR ip LIKE %s '
                        'ORDER BY ts DESC, id DESC LIMIT %s', (needle, needle, needle, needle, needle, limit))
            return {'mails': cur.fetchall()}
    finally:
        db.close()


def _maillog_days():
    for line in _read_lines(MAILLOG_DAYS_FILE):
        if line.isdigit():
            return int(line)
    return MAILLOG_DEFAULT_DAYS


def maillog_retention_set(args):
    """Days to keep the mail log. It holds personal data, so keep it as short as you can."""
    try:
        days = int(args.days)
    except ValueError:
        raise EfaError('Days must be a number.')
    if not 1 <= days <= 3650:
        raise EfaError('Days must be 1 to 3650.')
    _write(MAILLOG_DAYS_FILE, f'{days}\n')
    return {'maillog_days': days}


def _maillog_max_mb():
    for line in _read_lines(MAILLOG_SIZE_FILE):
        if line.isdigit():
            return int(line)
    return 0


def maillog_size_set(args):
    """Largest size of the mail log in MB; the oldest entries go first. 0 turns the limit off."""
    try:
        megabytes = int(args.megabytes)
    except ValueError:
        raise EfaError('Size must be a number.')
    if not 0 <= megabytes <= 10485760:
        raise EfaError('Size must be 0 to 10485760 MB.')
    _write(MAILLOG_SIZE_FILE, f'{megabytes}\n')
    return {'maillog_max_mb': megabytes}


def maillog_purge(_args):
    """Delete entries older than the retention period and, if set, the oldest ones above the size limit."""
    days, max_mb = _maillog_days(), _maillog_max_mb()
    db = _maillog_db()
    try:
        with db.cursor() as cur:
            deleted = cur.execute('DELETE FROM maillog WHERE ts < NOW() - INTERVAL %s DAY', (days,))
            deleted_size = 0
            if max_mb:
                cur.execute("SELECT data_length + index_length AS size FROM information_schema.tables "
                            "WHERE table_schema = 'efa' AND table_name = 'maillog'")
                size = cur.fetchone()['size'] or 0
                cur.execute('SELECT COUNT(*) AS n FROM maillog')
                rows = cur.fetchone()['n']
                limit = max_mb * 1024 * 1024
                if size > limit and rows:
                    # shortcut: row sizes are averaged, so the result is close to the limit, not exact.
                    keep = int(rows * limit / size)
                    cur.execute('SELECT id FROM maillog ORDER BY id DESC LIMIT 1 OFFSET %s', (keep,))
                    found = cur.fetchone()
                    if found:
                        deleted_size = cur.execute('DELETE FROM maillog WHERE id <= %s', (found['id'],))
    finally:
        db.close()
    if deleted or deleted_size:
        # InnoDB keeps freed space in its file until the table is rebuilt.
        subprocess.run(['mysqlcheck', '--user=root', '--optimize', 'efa', 'maillog'], env=_mysql_env(),
                       check=True, capture_output=True)
    return {'deleted_by_age': deleted, 'deleted_by_size': deleted_size, 'maillog_days': days, 'maillog_max_mb': max_mb}


def _port_listening(port):
    with socket.socket() as probe:
        probe.settimeout(2)
        return probe.connect_ex(('127.0.0.1', port)) == 0


def milter_chain_set(args):
    """Order of the milters by port, for site-specific milters. rspamd (11332) and the health milter must stay in."""
    try:
        ports = [int(item) for item in args.ports.replace(',', ' ').split()]
    except ValueError:
        raise EfaError('Ports must be numbers.')
    if not ports or len(set(ports)) != len(ports) or not all(1 <= port <= 65535 for port in ports):
        raise EfaError('Give each port once, 1 to 65535.')
    for required in REQUIRED_MILTERS:
        if required not in ports:
            raise EfaError(f'Port {required} must stay in the chain.')
    # A wrong port delays every mail until its timeout, so refuse what does not answer.
    closed = [port for port in ports if not _port_listening(port)]
    if closed:
        raise EfaError(f'Nothing listens on port {closed}, nothing changed.')
    chain = ', '.join(f'inet:127.0.0.1:{port}' for port in ports)
    _postconf_set('smtpd_milters', chain)
    return {'smtpd_milters': chain}


def dns_zone_set(args):
    """Send one DNS zone to internal servers, for example a company domain. Everything else resolves directly."""
    zone, action = args.zone.strip().lower().rstrip('.'), args.action.strip()
    if not DOMAIN_RE.match(zone):
        raise EfaError('Invalid zone.')
    if action not in ('add', 'remove'):
        raise EfaError("Action must be 'add' or 'remove'.")
    zones = _dns_zones()
    if action == 'add':
        servers = args.servers.replace(',', ' ').split()
        try:
            servers = [str(ipaddress.ip_address(server)) for server in servers]
        except ValueError:
            raise EfaError('Servers must be IP addresses.')
        if not servers:
            raise EfaError('Give at least one server.')
        zones[zone] = servers
    else:
        zones.pop(zone, None)
    lines = []
    for name, servers in sorted(zones.items()):
        # Internal zones are usually unsigned and would fail DNSSEC validation.
        lines += ['server:', f'  domain-insecure: "{name}"', 'forward-zone:', f'  name: "{name}"']
        lines += [f'  forward-addr: {server}' for server in servers]
    previous = open(DNS_ZONES).read() if os.path.exists(DNS_ZONES) else None
    _write(DNS_ZONES, '\n'.join(lines) + '\n')
    done = subprocess.run(['unbound-checkconf'], capture_output=True, text=True)
    if done.returncode != 0:
        if previous is None:
            os.remove(DNS_ZONES)
        else:
            _write(DNS_ZONES, previous)
        raise EfaError('unbound rejected the change, nothing changed: ' + done.stdout.strip()[-200:])
    subprocess.run(['systemctl', 'restart', 'unbound'], check=False, capture_output=True)
    return {'dns_zones': zones}


def _dns_zones():
    zones = {}
    name = None
    for line in _read_lines(DNS_ZONES):
        if line.startswith('name:'):
            name = line.split('"')[1]
            zones[name] = []
        elif line.startswith('forward-addr:') and name:
            zones[name].append(line.split()[1])
    return zones


def extra_service_set(args):
    """Site-specific systemd services the health service also watches. They show in status, not in mail."""
    name, action = args.name.strip(), args.action.strip()
    if not SERVICE_RE.match(name):
        raise EfaError('Invalid service name.')
    if action not in ('add', 'remove'):
        raise EfaError("Action must be 'add' or 'remove'.")
    entries = [e for e in _read_lines(HEALTH_EXTRA) if e != name]
    if action == 'add':
        entries.append(name)
    _write(HEALTH_EXTRA, ''.join(e + '\n' for e in entries))
    return {'extra_services': entries}


def quarantine_set(args):
    """Hold mail rspamd marks as spam instead of delivering it. It waits in the mail server until released or deleted."""
    enabled = _on_off(args.mode)
    if enabled:
        _write(QUARANTINE_RULES, '/^X-Spam: Yes/ HOLD eFa quarantine\n/^X-Spam-Status: Yes/ HOLD eFa quarantine\n')
        _postconf_set('milter_header_checks', f'regexp:{QUARANTINE_RULES}')
    else:
        _postconf_set('milter_header_checks', '')
    return {'quarantine': enabled}


def _held_mail():
    done = subprocess.run(['postqueue', '-j'], capture_output=True, text=True, check=True)
    mails = []
    for line in done.stdout.splitlines():
        item = json.loads(line)
        if item.get('queue_name') == 'hold':
            mails.append({'id': item['queue_id'], 'sender': item.get('sender', ''),
                          'recipients': [r['address'] for r in item.get('recipients', [])],
                          'arrived': item.get('arrival_time'), 'size': item.get('message_size')})
    return mails


def quarantine_list(_args):
    """List quarantined mail."""
    return {'quarantine': _held_mail(), 'quarantine_days': _quarantine_days()}


def _held_id(args):
    queue_id = args.id.strip()
    if not QUEUE_ID_RE.match(queue_id):
        raise EfaError('Invalid queue ID.')
    if queue_id not in [m['id'] for m in _held_mail()]:
        raise EfaError('This mail is not in quarantine.')
    return queue_id


def quarantine_show(args):
    """Show the headers of a quarantined mail."""
    queue_id = _held_id(args)
    done = subprocess.run(['postcat', '-hq', queue_id], capture_output=True, text=True, check=True)
    return {'id': queue_id, 'headers': done.stdout[:20000]}


def quarantine_release(args):
    """Deliver a quarantined mail."""
    queue_id = _held_id(args)
    # -r, not -H: released mail gets a new arrival time, so old mail does not bounce
    subprocess.run(['postsuper', '-r', queue_id], check=True, capture_output=True)
    return {'released': queue_id}


def quarantine_delete(args):
    """Delete a quarantined mail for good."""
    _confirm(args)
    queue_id = _held_id(args)
    subprocess.run(['postsuper', '-d', queue_id], check=True, capture_output=True)
    return {'deleted': queue_id}


def _quarantine_days():
    for line in _read_lines(QUARANTINE_DAYS_FILE):
        if line.isdigit():
            return int(line)
    return QUARANTINE_DEFAULT_DAYS


def quarantine_days_set(args):
    """Days until quarantined mail is deleted."""
    try:
        days = int(args.days)
    except ValueError:
        raise EfaError('Days must be a number.')
    if not 1 <= days <= 3650:
        raise EfaError('Days must be 1 to 3650.')
    _write(QUARANTINE_DAYS_FILE, f'{days}\n')
    return {'quarantine_days': days}


def quarantine_purge(_args):
    """Delete quarantined mail older than the set number of days."""
    cutoff = time.time() - _quarantine_days() * 86400
    deleted = [m['id'] for m in _held_mail() if (m['arrived'] or 0) < cutoff]
    for queue_id in deleted:
        subprocess.run(['postsuper', '-d', queue_id], check=True, capture_output=True)
    return {'deleted': len(deleted)}


def dmarc_reports_set(args):
    """Send DMARC reports to the addresses domains publish. Needs Redis and outgoing mail."""
    enabled = _on_off(args.mode)
    text = open(DMARC_CONF).read() if os.path.exists(DMARC_CONF) else ''
    text = re.sub(r'reporting \{.*?\n\}\n?', '', text, flags=re.S)
    if enabled:
        domain, email, org = (args.domain or '').strip().lower(), (args.email or '').strip().lower(), (args.org or '').strip()
        if not DOMAIN_RE.match(domain):
            raise EfaError('Invalid domain.')
        if not SENDER_RE.match(email):
            raise EfaError('Invalid email address.')
        if not ORG_RE.match(org):
            raise EfaError('Organization: up to 64 letters, digits or spaces.')
        text += (f'reporting {{\n  enabled = true;\n  email = "{email}";\n  domain = "{domain}";\n'
                 f'  org_name = "{org}";\n  smtp = "127.0.0.1";\n}}\n')
    _write(DMARC_CONF, text)
    done = subprocess.run(['rspamadm', 'configtest'], capture_output=True, text=True)
    if done.returncode != 0:
        raise EfaError('rspamd rejected the setting: ' + (done.stdout + done.stderr)[-200:])
    _reload_rspamd()
    if enabled:
        _write(DMARC_CRON, '0 3 * * * root /usr/bin/rspamadm dmarc_report yesterday >/dev/null 2>&1\n')
    elif os.path.exists(DMARC_CRON):
        os.remove(DMARC_CRON)
    return {'dmarc_reports': enabled}


def admin_password(args):
    """Set the web admin password; only from the CLI, the web cannot change it."""
    from werkzeug.security import generate_password_hash
    password = args.password if args.password is not None else getpass.getpass('New password: ')
    if len(password) < 12:
        raise EfaError('Password needs at least 12 characters.')
    os.makedirs(WEB_DIR, mode=0o750, exist_ok=True)
    shutil.chown(WEB_DIR, 'root', 'efa-web')
    fd, tmp = tempfile.mkstemp(dir=WEB_DIR)
    with os.fdopen(fd, 'w') as f:
        f.write(generate_password_hash(password, method='pbkdf2:sha256:600000'))
    shutil.chown(tmp, 'root', 'efa-web')
    os.chmod(tmp, 0o640)
    os.replace(tmp, PASSWORD_FILE)
    return {'admin_password': 'set'}


