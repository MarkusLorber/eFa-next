def main():
    if '--self-test' in sys.argv:
        self_test()
        return 0
    parser = argparse.ArgumentParser(prog='efactl', description='eFa control tool')
    sub = parser.add_subparsers(dest='command', required=True)
    sub.add_parser('schema').set_defaults(func=schema)
    sub.add_parser('menu')
    for name, cmd in {**COMMANDS, **CLI_ONLY}.items():
        cmd_parser = sub.add_parser(name, help=cmd.get('title'))
        cmd_parser.set_defaults(func=cmd['func'])
        for arg in cmd['args']:
            cmd_parser.add_argument('--' + arg['name'], default=arg.get('default', None if name in CLI_ONLY else ''),
                                    required=arg.get('required', False))
    args = parser.parse_args()
    # A compromised web process must not reach CLI-only commands through its sudo rule.
    if args.command in (*CLI_ONLY, 'menu') and os.environ.get('SUDO_USER') == 'efa-web':
        print(json.dumps({'error': 'not allowed from the web interface'}))
        return 1
    if args.command == 'menu':
        return menu()
    try:
        print(json.dumps(args.func(args), indent=2))
    except (EfaError, subprocess.CalledProcessError, OSError) as err:
        print(json.dumps({'error': str(err)}))
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
