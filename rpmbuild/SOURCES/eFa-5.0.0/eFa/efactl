def schema(_args):
    return {name: {key: cmd.get(key) for key in ('title', 'args', 'writes')} for name, cmd in COMMANDS.items()}


def menu():
    """Interactive menu of eFa-Configure, built from the same table as the web forms."""
    entries = list(COMMANDS.items()) + [('admin-password', {**CLI_ONLY['admin-password'], 'title': 'Web admin password',
                                                            'writes': True})]
    while True:
        print('\n--- eFa configuration ---')
        for number, (_, cmd) in enumerate(entries, 1):
            print(f'{number:>3}) {cmd["title"]}')
        print('  s) Shell\n  l) Log out')
        try:
            choice = input('[eFa] : ').strip()
        except EOFError:
            return 0
        if choice == 's':
            return 0
        if choice == 'l':
            subprocess.run(['pkill', '-KILL', '-t', os.ttyname(0).replace('/dev/', '')], check=False)
            return 0
        if not choice.isdigit() or not 1 <= int(choice) <= len(entries):
            print(f'Error "{choice}" is not an option...')
            continue
        name, cmd = entries[int(choice) - 1]
        values = {}
        for arg in cmd['args']:
            if name == 'admin-password':
                values[arg['name']] = None
                continue
            default = arg.get('default', '')
            label = arg.get('label', arg['name']) + (f' [{default}]' if default else '')
            values[arg['name']] = input(f'{label}: ').strip() or default
        try:
            print(json.dumps(cmd['func'](argparse.Namespace(**values)), indent=2))
        except (EfaError, subprocess.CalledProcessError, OSError) as err:
            print(f'ERROR: {err}')


