#!/usr/bin/python3
"""eFa control tool. Every eFa function lives here once; CLI and web both call it.

The COMMANDS table is the single source of the options: `efactl schema` hands it to
the web interface, which builds its forms from it, so CLI and web cannot drift apart.
Runs as root. Input is validated here because the web interface passes user input on.
"""
import argparse
import getpass
import glob
import ipaddress
import json
import os
import re
import secrets
import shutil
import socket
import subprocess
import sys
import tarfile
import tempfile
import time
import urllib.request

ETC = os.environ.get('EFA_ETC', '/etc')
RSPAMD_DIR = ETC + '/rspamd'
DKIM_DIR = RSPAMD_DIR + '/dkim'
DKIM_CONF = RSPAMD_DIR + '/local.d/dkim_signing.conf'
DKIM_IMPORTED = DKIM_DIR + '/imported'
SUBJECT_TAG = RSPAMD_DIR + '/efa-auth-subject-tag'
OPENDKIM_KEYS = ETC + '/opendkim/keys'
ACTIONS_CONF = RSPAMD_DIR + '/local.d/actions.conf'
GREYLIST_CONF = RSPAMD_DIR + '/local.d/greylist.conf'
# override.d: local.d would only add to rspamd's default, which trusts all private networks.
OPTIONS_INC = RSPAMD_DIR + '/override.d/options.inc'
SENDER_MAPS = {'allow': RSPAMD_DIR + '/local.d/maps.d/efa-sender-allow.map',
               'block': RSPAMD_DIR + '/local.d/maps.d/efa-sender-block.map'}
SENDER_RULES = RSPAMD_DIR + '/local.d/maps.d/efa-sender-rules.map'
MONITOR_CRON = ETC + '/cron.d/eFa-Monitor.cron'
QUARANTINE_RULES = ETC + '/postfix/efa-quarantine'
QUARANTINE_DAYS_FILE = ETC + '/eFa/quarantine-days'
QUARANTINE_DEFAULT_DAYS = 30
DMARC_CONF = RSPAMD_DIR + '/local.d/dmarc.conf'
DMARC_CRON = ETC + '/cron.d/efa-dmarc-report'
REQUIRED_MILTERS = (11332, 8999)
DNS_ZONES = ETC + '/unbound/conf.d/efa-zones.conf'
HEALTH_EXTRA = ETC + '/sysconfig/efa-milter-health'
MAILLOG_DAYS_FILE = ETC + '/eFa/maillog-days'
MAILLOG_DEFAULT_DAYS = 30
MAILLOG_SIZE_FILE = ETC + '/eFa/maillog-max-mb'
BACKUP_DIR = os.environ.get('EFA_BACKUP_DIR', '/var/eFa/backup')
BACKUP_KEEP_DAYS = 5
BACKUP_PATHS = ('/etc/rspamd/local.d', '/etc/rspamd/dkim', '/etc/rspamd/efa-auth-subject-tag', '/etc/postfix',
                '/etc/nginx/conf.d', '/etc/nginx/ssl', '/etc/letsencrypt', '/etc/efa-web', '/etc/eFa',
                '/etc/unbound/conf.d', '/etc/sysconfig/efa-milter-health', '/etc/aliases')
MYSQL_CONFIG = ETC + '/eFa/MySQL-Config'
HOSTS = ETC + '/hosts'
TRANSPORT = ETC + '/postfix/transport'
EFA_CONFIG = ETC + '/eFa/eFa-Config'
ALIASES = ETC + '/aliases'
FAIL2BAN_JAIL = ETC + '/fail2ban/jail.d/efa.local'
BACKUP_DISABLED = ETC + '/eFa/eFa-Backup.disabled'
DEFAULT_ACTIONS = {'greylist': '4', 'rewrite_subject': '6', 'reject': '15'}
WEB_DIR = ETC + '/efa-web'
PASSWORD_FILE = WEB_DIR + '/admin.pw'
MAILLOG_PW = WEB_DIR + '/maillog.pw'
HEALTH_URL = 'http://127.0.0.1:8905/health'

DKIM_MIN_BITS = 2048
DKIM_MAX_BITS = 4096
RSA_SELECTOR = 'efa-rsa'
ED_SELECTOR = 'efa-ed25519'
DOMAIN_RE = re.compile(r'^([a-z0-9]([a-z0-9-]*[a-z0-9])?\.)+[a-z]{2,}$')
SMARTHOST_RE = re.compile(r'^\[?[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?\]?(:[0-9]{1,5})?$')
SENDER_RE = re.compile(r'^[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,}$')
HOST_RE = re.compile(r'^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?(:[0-9]{1,5})?$')
BACKUP_NAME_RE = re.compile(r'^efa-backup-\d{8}-\d{6}\.tar\.gz$')
SERVICE_RE = re.compile(r'^[A-Za-z0-9][A-Za-z0-9@._-]{0,100}$')
SELECTOR_RE = re.compile(r'^[A-Za-z0-9][A-Za-z0-9_-]{0,62}$')
RULE_FROM_RE = re.compile(r'^[A-Za-z0-9._%+=@:*-]{1,255}$')
QUEUE_ID_RE = re.compile(r'^[A-Za-z0-9]{6,32}$')
ORG_RE = re.compile(r'^[A-Za-z0-9 ]{1,64}$')
TAG_RE = re.compile(r'^[\]\[A-Za-z0-9 _:.*!-]{1,40}$')


class EfaError(Exception):
    pass


def _rspamd_user():
    return '_rspamd'


def _dkim_paths(domain):
    return (f'{DKIM_DIR}/{domain}.{RSA_SELECTOR}.key', f'{DKIM_DIR}/{domain}.{ED_SELECTOR}.key')


def _reload_rspamd():
    subprocess.run(['systemctl', 'reload', 'rspamd'], check=False, capture_output=True)


def _postconf(name):
    return subprocess.run(['postconf', '-h', name], capture_output=True, text=True, check=True).stdout.strip()


def _postconf_set(name, value):
    main_cf = subprocess.run(['postconf', '-h', 'config_directory'], capture_output=True, text=True,
                             check=True).stdout.strip() + '/main.cf'
    backup = main_cf + '.efactl'
    shutil.copy2(main_cf, backup)
    try:
        subprocess.run(['postconf', '-e', f'{name} = {value}'], check=True)
        done = subprocess.run(['postfix', 'check'], capture_output=True, text=True)
        if done.returncode != 0:
            # A broken main.cf would stop mail at the next reload, so keep the working one.
            shutil.copy2(backup, main_cf)
            raise EfaError(f'postfix check failed, nothing changed: {done.stderr.strip()[:300]}')
    finally:
        os.remove(backup)
    subprocess.run(['systemctl', 'reload', 'postfix'], check=False, capture_output=True)


def _write(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, 'w') as f:
        f.write(text)
    os.chmod(path, 0o644)


def _read_lines(path):
    try:
        with open(path) as f:
            return [line.strip() for line in f if line.strip()]
    except FileNotFoundError:
        return []


def status(_args):
    """Service and milter state from the health service."""
    try:
        with urllib.request.urlopen(HEALTH_URL, timeout=5) as reply:
            return json.load(reply)
    except urllib.error.HTTPError as err:
        return json.load(err)
    except OSError as err:
        raise EfaError(f'health service not reachable: {err}')


def subject_get(_args):
    """Text put in front of the subject of mail with a hard SPF, DKIM or DMARC failure."""
    try:
        with open(SUBJECT_TAG) as f:
            return {'subject_tag': f.readline().strip()}
    except FileNotFoundError:
        return {'subject_tag': ''}


def subject_set(args):
    """Set the subject marking; an empty text turns it off."""
    tag = args.text.strip()
    if not tag:
        if os.path.exists(SUBJECT_TAG):
            os.remove(SUBJECT_TAG)
        return {'subject_tag': ''}
    if not TAG_RE.match(tag):
        raise EfaError('Text: up to 40 letters, digits, spaces or [ ] _ : . * ! -')
    with open(SUBJECT_TAG, 'w') as f:
        f.write(tag + '\n')
    os.chmod(SUBJECT_TAG, 0o644)
    return {'subject_tag': tag}


def _write_dkim_conf():
    # Rebuilt from the key files so the config cannot drift from what is on disk.
    domains = {}
    for key in sorted(glob.glob(f'{DKIM_IMPORTED}/*.key')):
        domain, selector = os.path.basename(key)[:-4].rsplit('.', 1)
        domains.setdefault(domain, []).append((key, selector))
    for key in sorted(glob.glob(f'{DKIM_DIR}/*.{RSA_SELECTOR}.key')):
        domain = os.path.basename(key)[:-len(f'.{RSA_SELECTOR}.key')]
        rsa_key, ed_key = _dkim_paths(domain)
        domains.setdefault(domain, []).extend([(rsa_key, RSA_SELECTOR), (ed_key, ED_SELECTOR)])
    if not domains:
        text = 'enabled = false;\n'
    else:
        lines = ['allow_username_mismatch = true;', 'use_domain = "header";',
                 '# Keys belong to the exact domain, also for subdomains.', 'use_esld = false;', 'domain {']
        for domain, selectors in sorted(domains.items()):
            items = [f'      {{ path = "{key}"; selector = "{selector}"; }}' for key, selector in selectors]
            lines += [f'  {domain} {{', '    selectors [', ',\n'.join(items), '    ]', '  }']
        lines.append('}')
        text = '\n'.join(lines) + '\n'
    with open(DKIM_CONF, 'w') as f:
        f.write(text)


def dkim_generate(args):
    """Create an RSA key and the mandatory ED25519 key for a domain."""
    domain = args.domain.strip().lower()
    if not DOMAIN_RE.match(domain):
        raise EfaError('Invalid domain.')
    try:
        bits = int(args.bits)
    except ValueError:
        raise EfaError('RSA key size must be a number.')
    if not DKIM_MIN_BITS <= bits <= DKIM_MAX_BITS:
        raise EfaError(f'RSA keys must have {DKIM_MIN_BITS} to {DKIM_MAX_BITS} bits.')
    rsa_key, ed_key = _dkim_paths(domain)
    if os.path.exists(rsa_key) or os.path.exists(ed_key):
        raise EfaError(f'Keys for {domain} already exist, nothing changed.')

    os.makedirs(DKIM_DIR, mode=0o750, exist_ok=True)
    shutil.chown(DKIM_DIR, 'root', _rspamd_user())
    records = {}
    try:
        for selector, key, extra in ((RSA_SELECTOR, rsa_key, ['-t', 'rsa', '-b', str(bits)]),
                                     (ED_SELECTOR, ed_key, ['-t', 'ed25519'])):
            done = subprocess.run(['rspamadm', 'dkim_keygen', '-d', domain, '-s', selector, '-k', key] + extra,
                                  capture_output=True, text=True, check=True)
            shutil.chown(key, 'root', _rspamd_user())
            os.chmod(key, 0o640)
            records[selector] = done.stdout.strip()
    except (subprocess.CalledProcessError, OSError) as err:
        # ED25519 is mandatory: never keep one key without the other.
        for key in (rsa_key, ed_key):
            if os.path.exists(key):
                os.remove(key)
        raise EfaError(f'Key generation failed, no keys were kept: {err}')
    _write_dkim_conf()
    _reload_rspamd()
    return {'domain': domain, 'dns_records': records}


def _key_bits(path):
    done = subprocess.run(['openssl', 'pkey', '-in', path, '-noout', '-text'], capture_output=True, text=True)
    match = re.search(r'Private-Key: \((\d+) bit', done.stdout)
    return int(match.group(1)) if match else None


def dkim_import(args):
    """Take over an existing key with its selector. Used by the migration; dkim-check warns about weak keys."""
    domain, selector = args.domain.strip().lower(), args.selector.strip()
    if not DOMAIN_RE.match(domain):
        raise EfaError('Invalid domain.')
    if not SELECTOR_RE.match(selector):
        raise EfaError('Invalid selector.')
    if _key_bits(args.key_file) is None:
        raise EfaError(f'{args.key_file} is no readable key.')
    os.makedirs(DKIM_IMPORTED, mode=0o750, exist_ok=True)
    shutil.chown(DKIM_DIR, 'root', _rspamd_user())
    shutil.chown(DKIM_IMPORTED, 'root', _rspamd_user())
    key = f'{DKIM_IMPORTED}/{domain}.{selector}.key'
    shutil.copyfile(args.key_file, key)
    shutil.chown(key, 'root', _rspamd_user())
    os.chmod(key, 0o640)
    _write_dkim_conf()
    _reload_rspamd()
    return {'imported': key}


def dkim_check(_args):
    """List DKIM keys. Existing keys below the rules only warn, signing keeps working."""
    warnings = []
    keys = []
    for key in sorted(glob.glob(f'{DKIM_DIR}/*.{RSA_SELECTOR}.key')):
        domain = os.path.basename(key)[:-len(f'.{RSA_SELECTOR}.key')]
        bits = _key_bits(key)
        has_ed = os.path.exists(_dkim_paths(domain)[1])
        keys.append({'domain': domain, 'rsa_bits': bits, 'ed25519': has_ed})
        if bits is None:
            warnings.append(f'{key} cannot be read.')
        elif bits < DKIM_MIN_BITS:
            warnings.append(f'{domain}: RSA key has only {bits} bits, generate a new key.')
        if not has_ed:
            warnings.append(f'{domain}: no ED25519 key.')
    for key in sorted(glob.glob(f'{DKIM_IMPORTED}/*.key')):
        domain, selector = os.path.basename(key)[:-4].rsplit('.', 1)
        bits = _key_bits(key)
        keys.append({'domain': domain, 'selector': selector, 'rsa_bits': bits, 'imported': True})
        if bits is not None and bits < DKIM_MIN_BITS:
            warnings.append(f'{domain}: imported key {selector} has only {bits} bits, generate a new key.')
        if not os.path.exists(_dkim_paths(domain)[1]):
            warnings.append(f'{domain}: no ED25519 key.')
    old = glob.glob(f'{OPENDKIM_KEYS}/*.private') + glob.glob(f'{OPENDKIM_KEYS}/*/*.private')
    for key in sorted(old):
        bits = _key_bits(key)
        warnings.append(f'{key}: opendkim key ({bits} bits) without ED25519, generate new keys.')
    return {'keys': keys, 'warnings': warnings}


def _actions():
    values = dict(DEFAULT_ACTIONS)
    for line in _read_lines(ACTIONS_CONF):
        match = re.match(r'^(greylist|rewrite_subject|reject) = ([0-9.]+);', line)
        if match:
            values[match.group(1)] = match.group(2)
    return values


def settings(_args):
    """Current values of the settings below."""
    return {
        'maintenance_mode': not os.path.exists(MONITOR_CRON),
        'relay_networks': _postconf('mynetworks').split(),
        'smarthost': _postconf('relayhost'),
        'message_size_limit_mb': int(_postconf('message_size_limit')) // (1024 * 1024),
        'spam_scores': _actions(),
        'greylisting': 'enabled = false;' not in _read_lines(GREYLIST_CONF),
        'sender_allow': _read_lines(SENDER_MAPS['allow']),
        'sender_block': _read_lines(SENDER_MAPS['block']),
        'transports': _read_transports(),
        'admin_email': _admin_email(),
        'recipient_verification': 'reject_unverified_recipient' in _postconf('smtpd_recipient_restrictions'),
        'fail2ban': os.path.exists(FAIL2BAN_JAIL),
        'auto_backup': not os.path.exists(BACKUP_DISABLED),
        'smtpd_milters': _postconf('smtpd_milters'),
        'dns_zones': _dns_zones(),
        'extra_services': _read_lines(HEALTH_EXTRA),
        'maillog_days': _maillog_days(),
        'quarantine': bool(_postconf('milter_header_checks')),
        'quarantine_days': _quarantine_days(),
        'dmarc_reports': os.path.exists(DMARC_CRON),
        'maillog_max_mb': _maillog_max_mb(),
    }


def _on_off(value):
    value = value.strip().lower()
    if value not in ('on', 'off'):
        raise EfaError("Value must be 'on' or 'off'.")
    return value == 'on'


def maintenance_set(args):
    """Maintenance mode stops the service monitor from restarting services."""
    if _on_off(args.mode):
        if os.path.exists(MONITOR_CRON):
            os.remove(MONITOR_CRON)
    else:
        _write(MONITOR_CRON, '* * * * * root /usr/sbin/eFa-Monitor-cron >/dev/null 2>&1\n')
    return {'maintenance_mode': not os.path.exists(MONITOR_CRON)}


def relay_networks_set(args):
    """Networks allowed to relay; rspamd treats them as internal."""
    nets = []
    for item in args.networks.replace(',', ' ').split():
        try:
            net = ipaddress.ip_network(item, strict=False)
        except ValueError:
            raise EfaError(f'Invalid network: {item}')
        if net.prefixlen == 0:
            raise EfaError(f'Refusing open relay network: {item}')
        nets.append(str(net))
    postfix_nets = ['127.0.0.0/8', '[::1]/128'] + [f'[{n.split("/")[0]}]/{n.split("/")[1]}' if ':' in n else n
                                                  for n in nets]
    _postconf_set('mynetworks', ' '.join(postfix_nets))
    quoted = ','.join(f'"{n}"' for n in ['127.0.0.0/8', '::1/128'] + nets)
    _write(OPTIONS_INC, f'local_addrs = [{quoted}];\n')
    _reload_rspamd()
    return {'relay_networks': postfix_nets}


def smarthost_set(args):
    """Outbound smarthost, for example [mail.example.org]:587; empty sends directly."""
    host = args.host.strip()
    if host and not SMARTHOST_RE.match(host):
        raise EfaError('Invalid smarthost.')
    _postconf_set('relayhost', host)
    return {'smarthost': host}


def message_size_set(args):
    """Largest accepted message in MB."""
    try:
        size = int(args.megabytes)
    except ValueError:
        raise EfaError('Size must be a number.')
    if not 1 <= size <= 1024:
        raise EfaError('Size must be 1 to 1024 MB.')
    _postconf_set('message_size_limit', str(size * 1024 * 1024))
    return {'message_size_limit_mb': size}


def spam_scores_set(args):
    """Scores for greylisting, spam marking and rejecting; each must be higher than the one before."""
    try:
        values = [float(args.greylist), float(args.mark), float(args.reject)]
    except ValueError:
        raise EfaError('Scores must be numbers.')
    if not 0 < values[0] < values[1] < values[2]:
        raise EfaError('Scores must rise: greylist < mark < reject.')
    _write(ACTIONS_CONF, f'greylist = {values[0]:g};\nrewrite_subject = {values[1]:g};\nreject = {values[2]:g};\n'
                         'subject = "{Spam?} %s";\n')
    _reload_rspamd()
    return {'spam_scores': _actions()}


def greylisting_set(args):
    """Turn rspamd greylisting on or off."""
    enabled = _on_off(args.mode)
    _write(GREYLIST_CONF, 'enabled = true;\n' if enabled else 'enabled = false;\n')
    _reload_rspamd()
    return {'greylisting': enabled}


def sender_list_set(args):
    """Add or remove a sender. Allow only lowers the score; DMARC and virus checks still apply."""
    which, action, address = args.list.strip(), args.action.strip(), args.address.strip().lower()
    if which not in SENDER_MAPS or action not in ('add', 'remove'):
        raise EfaError("List must be 'allow' or 'block', action 'add' or 'remove'.")
    if not SENDER_RE.match(address) and not DOMAIN_RE.match(address):
        raise EfaError('Invalid sender address or domain.')
    entries = _read_lines(SENDER_MAPS[which])
    if action == 'add' and address not in entries:
        entries.append(address)
    elif action == 'remove' and address in entries:
        entries.remove(address)
    _write(SENDER_MAPS[which], ''.join(e + '\n' for e in entries))
    _reload_rspamd()
    return {f'sender_{which}': entries}


def _read_transports():
    entries = {}
    for line in _read_lines(TRANSPORT):
        match = re.match(r'^(\S+)\s+smtp:\[?([^\]\s]+)\]?(:\d+)?$', line)
        if match:
            entries[match.group(1)] = match.group(2) + (match.group(3) or '')
    return entries


def sender_rule_set(args):
    """Rules beyond the lists: IP addresses, patterns with *, or only for one recipient or domain. A word without . @ : matches anywhere."""
    which, action = args.list.strip(), args.action.strip()
    sender, recipient = args.sender.strip().lower(), (args.recipient.strip().lower() or 'default')
    if which not in SENDER_MAPS or action not in ('add', 'remove'):
        raise EfaError("List must be 'allow' or 'block', action 'add' or 'remove'.")
    if not RULE_FROM_RE.match(sender) or sender.strip('*') == '':
        raise EfaError('Invalid sender, IP address or pattern.')
    if recipient != 'default' and not SENDER_RE.match(recipient) and not DOMAIN_RE.match(recipient):
        raise EfaError('Recipient must be an address, a domain or empty.')
    line = f'{which}|{sender}|{recipient}'
    entries = [e for e in _read_lines(SENDER_RULES) if e != line]
    if action == 'add':
        entries.append(line)
    _write(SENDER_RULES, ''.join(e + '\n' for e in entries))
    _reload_rspamd()
    return {'sender_rules': entries}


def transport_set(args):
    """Inbound mail route: which internal server receives mail for a domain."""
    domain, action, dest = args.domain.strip().lower(), args.action.strip(), args.destination.strip()
    if not DOMAIN_RE.match(domain):
        raise EfaError('Invalid domain.')
    if action not in ('add', 'remove'):
        raise EfaError("Action must be 'add' or 'remove'.")
    if action == 'add' and not HOST_RE.match(dest):
        raise EfaError('Invalid destination host.')
    backup = open(TRANSPORT).read() if os.path.exists(TRANSPORT) else ''
    lines = [line for line in backup.splitlines() if line.split()[:1] != [domain]]
    if action == 'add':
        host, _, port = dest.partition(':')
        lines.append(f'{domain}  smtp:[{host}]' + (f':{port}' if port else ''))
    _write(TRANSPORT, '\n'.join(lines) + '\n')
    try:
        subprocess.run(['postmap', TRANSPORT], check=True, capture_output=True)
    except subprocess.CalledProcessError:
        _write(TRANSPORT, backup)
        subprocess.run(['postmap', TRANSPORT], check=False, capture_output=True)
        raise EfaError('postmap failed, nothing changed.')
    subprocess.run(['systemctl', 'reload', 'postfix'], check=False, capture_output=True)
    return {'transports': _read_transports()}


def _admin_email():
    for line in _read_lines(EFA_CONFIG):
        if line.startswith('ADMINEMAIL:'):
            return line.split(':', 1)[1]
    return ''


def admin_email_set(args):
    """Address for system alerts; root mail goes there too."""
    email = args.email.strip().lower()
    if not SENDER_RE.match(email):
        raise EfaError('Invalid email address.')
    lines = [line for line in _read_lines(EFA_CONFIG) if not line.startswith('ADMINEMAIL:')]
    _write(EFA_CONFIG, '\n'.join(lines + [f'ADMINEMAIL:{email}']) + '\n')
    # Keep the raw lines: alias continuation lines depend on their leading whitespace.
    with open(ALIASES) as f:
        aliases = [line for line in f if not line.startswith('root:')]
    _write(ALIASES, ''.join(aliases) + f'root: {email}\n')
    subprocess.run(['newaliases'], check=True, capture_output=True)
    return {'admin_email': email}


def recipient_verification_set(args):
    """Ask the internal mail server if a recipient exists before accepting mail."""
    enabled = _on_off(args.mode)
    items = [i.strip() for i in _postconf('smtpd_recipient_restrictions').split(',') if i.strip()]
    items = [i for i in items if i != 'reject_unverified_recipient']
    if enabled:
        items.append('reject_unverified_recipient')
        _postconf_set('unverified_recipient_reject_reason', 'No user at this address')
        _postconf_set('unverified_recipient_reject_code', '550')
    _postconf_set('smtpd_recipient_restrictions', ', '.join(items))
    return {'recipient_verification': enabled}


def fail2ban_set(args):
    """Ban addresses after failed SSH and SMTP logins."""
    enabled = _on_off(args.mode)
    if shutil.which('fail2ban-client') is None:
        raise EfaError('fail2ban is not installed.')
    if enabled:
        _write(FAIL2BAN_JAIL, '[sshd]\nenabled = true\n\n[postfix-sasl]\nenabled = true\nfilter = postfix[mode=auth]\n')
        subprocess.run(['systemctl', 'enable', '--now', 'fail2ban'], check=True, capture_output=True)
        subprocess.run(['systemctl', 'restart', 'fail2ban'], check=True, capture_output=True)
    else:
        if os.path.exists(FAIL2BAN_JAIL):
            os.remove(FAIL2BAN_JAIL)
        subprocess.run(['systemctl', 'disable', '--now', 'fail2ban'], check=True, capture_output=True)
    return {'fail2ban': enabled}


