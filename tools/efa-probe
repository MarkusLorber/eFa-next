"""Small self-hosted probe for the eFa firewall test. Run it on a machine outside the eFa network.

It connects back only to the address that asks it, and only to the ports listed here. So it cannot be used to scan others.
Usage: efa-probe [port], default 8970. Put it behind HTTPS if the path to it is not trusted.
"""
import json
import socket
import sys
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs, urlparse

ALLOWED_PORTS = {25, 80, 443, 465, 587, 22}


class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        try:
            port = int(parse_qs(urlparse(self.path).query).get('port', ['0'])[0])
        except ValueError:
            port = 0
        if port not in ALLOWED_PORTS:
            self.send_error(400)
            return
        try:
            with socket.create_connection((self.client_address[0], port), timeout=8):
                is_open = True
        except OSError:
            is_open = False
        body = json.dumps({'open': is_open, 'port': port, 'address': self.client_address[0]}).encode()
        self.send_response(200)
        self.send_header('Content-Type', 'application/json')
        self.send_header('Content-Length', str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, *args):
        pass


if __name__ == '__main__':
    ThreadingHTTPServer(('', int(sys.argv[1]) if len(sys.argv) > 1 else 8970), Handler).serve_forever()
