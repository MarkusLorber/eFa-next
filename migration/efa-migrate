def _fetch(url):
    return subprocess.run(['curl', '-fsSL', url], capture_output=True, check=True).stdout


def fetch_rpms():
    """Latest release into a new directory: SHA256SUMS signed by the pinned eFa-next key, then the packages against it."""
    import efa_sign
    key = b''
    for url in KEY_URLS:
        try:
            key = _fetch(url)
            break
        except subprocess.CalledProcessError:
            continue
    target = tempfile.mkdtemp(prefix='efa-rpms-', dir='/root')
    for base in (REPO_URL, RELEASE_URL):
        try:
            sums, signature = _fetch(f'{base}/SHA256SUMS'), _fetch(f'{base}/SHA256SUMS.asc')
        except subprocess.CalledProcessError:
            continue
        if not efa_sign.verify(sums, signature, key):
            continue
        with open(target + '/SHA256SUMS', 'wb') as f:
            f.write(sums)
        for name in [line.split()[1].lstrip('*') for line in sums.decode().splitlines() if line.strip()]:
            run(['curl', '-fsSLO', f'{base}/{name}'], cwd=target)
        run(['sha256sum', '-c', 'SHA256SUMS'], cwd=target)
        return target
    raise Failed(f'No release with SHA256SUMS signed by the eFa-next key {efa_sign.FINGERPRINT} at {REPO_URL} or {RELEASE_URL}.')


def preflight_rpms(rpm_dir):
    rpms = glob.glob(rpm_dir + '/eFa-base-*.rpm') + [r for r in glob.glob(rpm_dir + '/eFa-[0-9]*.rpm')]
    if len(rpms) != 2:
        raise Failed(f'{rpm_dir} must hold one eFa-base and one eFa package.')
    return rpms


def preflight(rpm_dir):
    rpms = preflight_rpms(rpm_dir)
    db_size = int(run(['du', '-sb', '/var/lib/mysql']).split()[0])
    free = shutil.disk_usage('/var').free
    if free < db_size * 2:
        raise Failed(f'Need {db_size * 2} bytes free on /var for the database backup, only {free} are free.')
    return rpms


def backup(target, plan):
    os.makedirs(target, mode=0o700)
    with open(target + '/plan.json', 'w') as f:
        json.dump(plan, f, indent=2)
    paths = [p for p in BACKUP_PATHS if os.path.exists(p)]
    run(['tar', 'czf', target + '/config.tar.gz', '--ignore-failed-read', '-P'] + paths)
    for key in plan['dkim']:
        shutil.copyfile(key['path'], f'{target}/{dkim_name(key)}')
    env = mysql_env()
    with open(target + '/all-databases.sql.gz', 'wb') as out:
        dump = subprocess.Popen(['mysqldump', '--user=root', '--all-databases', '--single-transaction'], env=env,
                                stdout=subprocess.PIPE)
        gz = subprocess.Popen(['gzip'], stdin=dump.stdout, stdout=out)
        dump.stdout.close()
        if gz.wait() != 0 or dump.wait() != 0:
            raise Failed('Database backup failed.')
    run(['gzip', '-t', target + '/all-databases.sql.gz'])
    # Fields in the order of efa.maillog, tab separated as LOAD DATA expects them.
    query = ("SELECT timestamp, LEFT(COALESCE(id,''),64), LEFT(COALESCE(messageid,''),255), LEFT(COALESCE(from_address,''),255),"
             " LEFT(COALESCE(to_address,''),1000), LEFT(COALESCE(clientip,''),64),"
             " IF(virusinfected>0 OR nameinfected>0 OR otherinfected>0,'virus',IF(isspam>0,'add header','no action')),"
             " COALESCE(sascore,0), LEFT(COALESCE(subject,''),500) FROM mailscanner.maillog")
    with open(target + '/maillog.tsv', 'w') as out:
        subprocess.run(['mysql', '--user=root', '--batch', '-N', '-e', query], env=env, stdout=out, check=True)


def _intake(on):
    """Postfix takes mail again, or no longer (while MailScanner empties its spool)."""
    subprocess.run(['postconf', '-e', 'master_service_disable =' if on else 'master_service_disable = inet'], capture_output=True)
    subprocess.run(['systemctl', 'reload', 'postfix'], capture_output=True)  # may already be stopped


def drain_scanner(seconds):
    """Mail handed to MailScanner lives only in its spool, so it has to finish before the removal."""
    _intake(False)
    deadline = time.time() + seconds
    while time.time() < deadline:
        # incoming itself holds locks and caches, mail only sits in its numbered worker directories
        waiting = [f for d in ('milterin/*', 'milterout/*', 'incoming/[0-9]*/*') for f in glob.glob(f'{MAILSCANNER_SPOOL}/{d}')]
        if not waiting:
            return
        time.sleep(5)
    _intake(True)
    raise Failed(f'MailScanner still holds {len(waiting)} files, nothing was removed. Try again later.')


def remove_old(target):
    for service in OLD_SERVICES:
        subprocess.run(['systemctl', 'disable', '--now', service], capture_output=True)
    # The drop-in of the php-fpm package makes nginx start it again.
    subprocess.run(['systemctl', 'mask', 'php-fpm'], capture_output=True)
    run(['tar', 'cf', target + '/postfix-queue.tar', '-C', '/var/spool/postfix', '--ignore-failed-read', *QUEUES])
    if os.path.isdir(MAILSCANNER_SPOOL + '/quarantine'):
        shutil.move(MAILSCANNER_SPOOL + '/quarantine', target + '/mailscanner-quarantine')
    if os.path.isdir('/var/eFa/backup'):
        shutil.move('/var/eFa/backup', target + '/eFa5-backups')
    built = [line for line in run(['rpm', '-qa', '--qf', '%{NAME} %{RELEASE}\n']).splitlines() if '.eFa.' in line]
    names = [line.split()[0] for line in built]
    installed = names + [p for p in FRESH_PACKAGES if subprocess.run(['rpm', '-q', p], capture_output=True).returncode == 0]
    for package in installed:
        # A failing old removal script must not stop the migration half way.
        if subprocess.run(['rpm', '-e', '--nodeps', package], capture_output=True).returncode != 0:
            subprocess.run(['rpm', '-e', '--nodeps', '--noscripts', package], capture_output=True)
    # MailScanner's ramdisk would block the removal of its spool and come back at boot.
    subprocess.run(['umount', MAILSCANNER_SPOOL + '/incoming'], capture_output=True)
    with open('/etc/fstab') as f:
        lines = f.readlines()
    with open('/etc/fstab', 'w') as f:
        f.writelines(line for line in lines if MAILSCANNER_SPOOL not in line)
    for path in REMOVED_PATHS:
        if os.path.isdir(path) and not os.path.islink(path):
            shutil.rmtree(path)
        elif os.path.lexists(path):
            os.remove(path)
    for path in OLD_CRON:
        if os.path.lexists(path):
            os.remove(path)
    with open('/root/.bashrc') as f:
        lines = f.readlines()
    with open('/root/.bashrc', 'w') as f:
        f.writelines(line for line in lines if 'eFa-Init' not in line)
    run(['systemctl', 'daemon-reload'])
    subprocess.run(['systemctl', 'reset-failed'], capture_output=True)


def pause_monitor():
    """The monitor of the new eFa would restart services during the setup, use up its attempts and mail an alert each time."""
    os.makedirs(os.path.dirname(SKIP_MONITOR), exist_ok=True)
    open(SKIP_MONITOR, 'w').close()


def setup_repos():
    asc = run(['curl', '-sSLf', RSPAMD_ASC])
    fingerprints = subprocess.run(['gpg', '--show-keys', '--with-colons'], input=asc, capture_output=True, text=True).stdout
    if f':{RSPAMD_FINGERPRINT}:' not in fingerprints:
        raise Failed('The rspamd signing key has an unexpected fingerprint.')
    # Not a fixed name in /tmp: another local user could prepare that path.
    fd, key_file = tempfile.mkstemp(suffix='.asc')
    with os.fdopen(fd, 'w') as f:
        f.write(asc)
    run(['rpm', '--import', key_file])
    os.remove(key_file)
    with open('/etc/yum.repos.d/rspamd.repo', 'w') as f:
        f.write(RSPAMD_REPO)
    for module in ('nginx', 'redis'):
        # -y: repo_gpgcheck needs the rspamd key accepted even for this read
        out = run(['dnf', '-y', '-q', 'module', 'list', module])
        streams = re.findall(rf'^{module}\s+([0-9.]+)', out, re.M)
        if not streams:
            raise Failed(f'No {module} stream found.')
        newest = max(streams, key=lambda v: [int(x) for x in v.split('.')])
        run(['dnf', 'module', '-y', 'enable', f'{module}:{newest}'])


def install_new(rpms):
    # An aborted run left them installed, and dnf would skip their first-install steps.
    for package in ('eFa', 'eFa-base'):
        if subprocess.run(['rpm', '-q', package], capture_output=True).returncode == 0:
            run(['rpm', '-e', '--nodeps', package])
    run(['dnf', '-y', 'install'] + rpms)
    # dnf reports success even if a package script failed, the version file is written only if all steps passed.
    if not os.path.exists('/etc/eFa-Version'):
        raise Failed('A first-install step failed, see /var/log/eFa/eFa-config.log.')


def apply_answers(plan, password):
    """KEY:value lines for efa-apply. The web admin password goes over stdin, never on a command line."""
    cfg = plan['config']
    answers = {'HOSTNAME': cfg['HOSTNAME'], 'DOMAINNAME': cfg['DOMAINNAME'], 'ADMINEMAIL': cfg.get('ADMINEMAIL', ''),
               'INTERFACE': cfg.get('INTERFACE', ''), 'IPV4ADDRESS': cfg.get('IPV4ADDRESS', ''), 'IPV4NETMASK': cfg.get('IPV4NETMASK', ''),
               'IPV4GATEWAY': cfg.get('IPV4GATEWAY', ''), 'IPV6ADDRESS': cfg.get('IPV6ADDRESS', ''), 'IPV6MASK': cfg.get('IPV6MASK', ''),
               'IPV6GATEWAY': cfg.get('IPV6GATEWAY', ''), 'IPV6DNS': 'YES' if plan['ipv6dns'] else 'NO', 'RECURSION': 'YES',
               'TZONE': cfg.get('TZONE', ''), 'ISUTC': 'YES' if cfg.get('ISUTC') in ('true', '1', 'YES') else 'NO',
               'MAILSERVER': cfg.get('MAILSERVER', ''), 'WEBADMINPASSWORD': password}
    return ''.join(f'{key}:{value}\n' for key, value in answers.items())


def new_config(plan):
    """The settings file of the new system: the old values, as the new setup writes them."""
    values = dict(plan['config'])
    values.update(CONFIGURED='YES', RECURSION='YES', IPV6DNS='YES' if plan['ipv6dns'] else 'NO', DNSIP1='', DNSIP2='',
                  ISUTC='YES' if values.get('ISUTC') in ('true', '1', 'YES') else 'NO')
    return ''.join(f'{key}:{value}\n' for key, value in values.items())


def commit(plan, password):
    # No --all: host keys, addresses, the root lock and the CLI user with its home directory stay as they are.
    # No --finish: it reboots from a marker, and the settings have to come back first.
    run(['/usr/sbin/efa-apply', '--verbose', '--answers', '-', '--mariadb', '--hostname', '--dns', '--timezone', '--transport',
         '--sasl', '--dbpasswords', '--autoupdates', '--cert', '--webadmin'], input=apply_answers(plan, password))
    fd = os.open(CONFIG, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o640)
    with os.fdopen(fd, 'w') as f:
        f.write(new_config(plan))
    # The package has just opened the first-run wizard, a host with settings does not need it.
    subprocess.run(['systemctl', 'disable', '--now', 'efa-init'], capture_output=True)
    for path in ('/etc/sudoers.d/efa-init', '/var/lib/eFa/setup'):
        if os.path.isdir(path):
            shutil.rmtree(path)
        elif os.path.exists(path):
            os.remove(path)
    # dovecot only comes with the logins on port 587 (sasl-apply installs it then): enable what is installed.
    run(['systemctl', 'enable', *[unit for unit in EFA_SERVICES if any(os.path.exists(f'{folder}/{unit}.service')
                                                                       for folder in ('/usr/lib/systemd/system', '/etc/systemd/system'))]])


def restore_settings(plan, target, warnings, disable=False):
    def efactl(*args):
        done = subprocess.run(['/usr/sbin/efactl', *args], capture_output=True, text=True,
                              env={k: v for k, v in os.environ.items() if k != 'SUDO_USER'})
        if done.returncode != 0:
            warnings.append(f"efactl {args[0]} {' '.join(args[1:])}: {(done.stdout + done.stderr)[-200:].strip()}")

    for service in ('mariadb', 'redis', 'rspamd', 'unbound', 'efa-milter-health'):
        subprocess.run(['systemctl', 'start', service], capture_output=True)
    subprocess.run(['systemctl', 'stop', 'postfix'], capture_output=True)

    # A migration must not make the host less secure: its own Postfix setup stays, only the filter stack is replaced.
    run(['tar', 'xzf', target + '/config.tar.gz', '-P', '-C', '/', '--no-same-owner', '--overwrite',
         *[f'--exclude={POSTFIX}/{name}' for name in POSTFIX_NOT_RESTORED], POSTFIX])
    if plan['map_packages']:
        run(['dnf', '-y', 'install', *plan['map_packages']])
    master, dropped = carried_master(run(['tar', 'xzOf', target + '/config.tar.gz', '-P', POSTFIX + '/master.cf']))
    with open(POSTFIX + '/master.cf', 'w') as f:
        f.write(master)
    warnings.extend(f'Postfix master.cf line dropped, it belongs to the removed filters: {line}' for line in dropped)
    # A HOLD rule made mail wait for MailScanner, which no longer picks it up.
    lines = []
    if os.path.exists(POSTFIX + '/header_checks'):
        with open(POSTFIX + '/header_checks') as f:
            lines = f.readlines()
    held = [line for line in lines if re.match(r'\s*/.*/\s+HOLD\b', line)]
    if held:
        with open(POSTFIX + '/header_checks', 'w') as f:
            f.writelines(line for line in lines if line not in held)
        warnings.append('Postfix header_checks: HOLD rules of MailScanner dropped.')
    for name, value in carried_postconf(plan['old_postconf']).items():
        # A missing certificate must not be configured again, see collect().
        if name in plan['postconf'] or name not in KEPT_POSTCONF:
            run(['postconf', '-e', f'{name} = {value}'])
    for table in plan['tables']:
        run(['postmap', f'{POSTFIX}/{table}'])
    if 'sasl_passwd' in plan['tables']:
        os.chmod(POSTFIX + '/sasl_passwd', 0o600)
        os.chmod(POSTFIX + '/sasl_passwd.db', 0o600)
    for name, value in plan['postconf'].items():
        run(['postconf', '-e', f'{name} = {value}'])
    if plan['letsencrypt']:
        run(['tar', 'xzf', target + '/config.tar.gz', '-P', '-C', '/', '/etc/letsencrypt'])
        warnings.append('Lets Encrypt: nginx uses a self-signed certificate. Run efactl letsencrypt-set to get a new one.')

    for step in settings_steps(plan, target, fresh=False):
        efactl(*step)
    import_sender_access(target, warnings, efactl)
    import_mailscanner_rules(target, warnings, efactl)
    import_blockers(plan, target, warnings, efactl, disable)
    run(['postconf', '-e', f"non_smtpd_milters = {plan['non_smtpd_milters']}"])

    run(['tar', 'xf', target + '/postfix-queue.tar', '-C', '/var/spool/postfix', '--same-owner'])
    run(['postsuper', '-s'])
    run(['systemctl', 'start', 'postfix'])

    tsv = target + '/maillog.tsv'
    new_env = mysql_env()
    run(['mysql', '--user=root', '--local-infile=1', '-e',
         f"LOAD DATA LOCAL INFILE '{tsv}' INTO TABLE efa.maillog (ts, qid, message_id, sender, rcpt, ip, action, score, subject)"],
        env=new_env)
    warnings.extend(f'DKIM key file missing, not migrated: {path}' for path in plan['dkim_missing'])
    warnings.extend(f'Own MailScanner rules not migrated, see config.tar.gz: {path}' for path in plan['mailscanner_custom'])
    new_postconf = key_values(run(['postconf']), '=')
    # sender_access went to the sender lists above; every other old table the new main.cf does not read is named.
    for name, ref in lost_maps(plan['old_postconf'], new_postconf):
        if not ref.endswith('/sender_access'):
            warnings.append(f'CHECK: the old main.cf used {ref} in {name}; the new setup does not read it, its entries no longer '
                            'apply. Take them over by hand where they are still needed.')
    lost = lost_postconf(plan['old_postconf'], new_postconf)
    if lost:
        warnings.append('Postfix settings replaced or dropped, the old values are in main.cf in config.tar.gz: ' + ', '.join(lost))


def finish(target, warnings, password):
    with open(target + '/report.txt', 'w') as f:
        f.write('\n'.join(warnings + list(NOT_MIGRATED)) + '\n')
    print('Migration done. Check these points:')
    for line in warnings + list(NOT_MIGRATED):
        print(' - ' + line)
    print(f'Report and backup: {target}')
    # Never into a log: printed only to a terminal, otherwise only in a file for root.
    password_file = target + '/web-admin-password'
    fd = os.open(password_file, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    os.fchmod(fd, 0o600)
    with os.fdopen(fd, 'w') as f:
        f.write(password + '\n')
    if sys.stdout.isatty():
        print(f'New web admin password: {password}')
    print(f'The web admin password is in {password_file}. Delete that file after you have stored the password.')
    print('The system reboots within a minute.')
    # The monitor stays off through the reboot: most services only start with it and would count as down.
    with open('/etc/cron.d/efa-migration-monitor', 'w') as f:
        f.write(f'@reboot root sleep 180 && /usr/sbin/efa-monitor --enable; rm -f {SKIP_MONITOR} /etc/cron.d/efa-migration-monitor\n')
    # Watched by efa-setup-reboot.path, the same way the normal setup ends.
    open('/var/lib/eFa/setup-reboot', 'w').close()
    return 0


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('--rpm-dir', help='Directory with the new eFa-base and eFa packages; default: latest GitHub release')
    parser.add_argument('--execute-i-have-a-snapshot', action='store_true', help='Really migrate. Without it nothing changes.')
    parser.add_argument('--drain-seconds', type=int, default=600)
    parser.add_argument('--self-test', action='store_true')
    parser.add_argument('--accept-legal', metavar='DIGEST', help='Unattended: the digest of the legal texts, instead of typing ja or yes')
    parser.add_argument('--resume', metavar='BACKUP_DIR', help='Continue after a failure during installing, from this backup')
    parser.add_argument('--mailscanner-rules', metavar='BACKUP_DIR', help='Take over the MailScanner rule files of an earlier migration')
    parser.add_argument('--disable-foreign-blockers', metavar='BACKUP_DIR', nargs='?', const='', default=None,
                        help='Switch off the cron jobs and firewalld rules of other blockers once their addresses are in eFa '
                             '(with the migration, or later with the backup directory of the migration)')
    args = parser.parse_args()
    # A stricter umask would make config files unreadable for the services that use them.
    os.umask(0o022)
    if args.self_test:
        self_test()
        return 0
    if args.mailscanner_rules:
        # Later, after a migration made before this step existed: the rule files from its backup.
        warnings = []
        import_mailscanner_rules(args.mailscanner_rules.rstrip('/'), warnings,
                                 lambda *call: subprocess.run(['/usr/sbin/efactl', *call], check=True, capture_output=True))
        print('\n'.join(warnings))
        return 0
    if args.disable_foreign_blockers:
        # Later, after a migration that only imported the addresses.
        target = args.disable_foreign_blockers.rstrip('/')
        with open(target + '/plan.json') as f:
            blockers = json.load(f).get('foreign_blockers') or {}
        warnings = []
        disable_blockers(blockers, target, warnings)
        print('\n'.join(warnings))
        return 0
    step = 'reading the old system'
    target = None
    removing = bool(args.resume)
    try:
        if args.resume:
            target = args.resume.rstrip('/')
            with open(target + '/plan.json') as f:
                plan = json.load(f)
            rpms = preflight_rpms(os.path.abspath(args.rpm_dir or fetch_rpms()))
            password = secrets.token_urlsafe(18)
            warnings = []
            step = 'installing'
            print('Installing the new eFa', flush=True)
            pause_monitor()
            setup_repos()
            install_new(rpms)
            step = 'configuring'
            print('Configuring', flush=True)
            commit(plan, password)
            step = 'restoring settings'
            print('Restoring settings', flush=True)
            restore_settings(plan, target, warnings, args.disable_foreign_blockers == '')
            return finish(target, warnings, password)
        plan = collect()
        plan['foreign_blockers'] = foreign_blockers()
        legal = legal_confirm(args.accept_legal) if args.execute_i_have_a_snapshot else None
        if args.execute_i_have_a_snapshot and not legal:
            return 1
        if not args.execute_i_have_a_snapshot:
            print(json.dumps(plan, indent=2))
            print('Nothing was changed. Take a VM snapshot, then run again with --execute-i-have-a-snapshot.')
            return 0
        # Downloaded before anything is removed: a failed download leaves the old system untouched.
        rpms = preflight(os.path.abspath(args.rpm_dir or fetch_rpms()))
        target = time.strftime('/root/efa-migration-%Y%m%d-%H%M%S')
        password = secrets.token_urlsafe(18)
        warnings = []
        step = 'backup'
        print(f'Backup to {target}', flush=True)
        backup(target, plan)
        step = 'emptying MailScanner'
        print('Stopping mail intake, waiting for MailScanner', flush=True)
        # The old monitor reads the same file, it would restart what the removal stops.
        pause_monitor()
        try:
            drain_scanner(args.drain_seconds)
        except Failed:
            os.remove(SKIP_MONITOR)
            raise
        step = 'removing the old stack'
        removing = True
        print('Removing the old stack', flush=True)
        remove_old(target)
        step = 'installing'
        print('Installing the new eFa', flush=True)
        pause_monitor()
        setup_repos()
        install_new(rpms)
        step = 'configuring'
        print('Configuring', flush=True)
        commit(plan, password)
        step = 'restoring settings'
        print('Restoring settings', flush=True)
        restore_settings(plan, target, warnings, args.disable_foreign_blockers == '')
        record_legal(legal, warnings)
    except (Failed, OSError, subprocess.CalledProcessError) as err:
        print(f'FAILED during {step}: {err}', file=sys.stderr)
        if not removing and step != 'reading the old system':
            # The old system goes on as it was: mail intake back on, the old monitor too.
            _intake(True)
            if os.path.exists(SKIP_MONITOR):
                os.remove(SKIP_MONITOR)
        if removing:
            print(f'Old configuration and databases are in {target}. Roll back with the VM snapshot.', file=sys.stderr)
        elif target:
            print(f'The old system is unchanged. Partial backup in {target}.', file=sys.stderr)
        return 1
    return finish(target, warnings, password)


if __name__ == '__main__':
    sys.exit(main())
