# 9m: blockers of other people's scripts (firewalld rich rules with a source address, kept up by cron jobs) become eFa
# IP blocklists. Rules with "source NOT address", as for services of the host owner, are not blockers and stay.
BLOCK_RULE = re.compile(r'^rule family="ipv[46]" source address="([^"]+)"(?: port port="(\d+)" protocol="tcp"| service name="([a-z-]+)")? '
                        r'(?:reject|drop)\b')
SERVICE_PORTS = {'smtp': '25', 'smtps': '465', 'submission': '587', 'ssh': '22', 'http': '80', 'https': '443', 'imaps': '993', 'pop3s': '995'}
# Before eFa-next is installed there is no platform layer yet: this is the only place that talks to firewalld.
FIREWALL_CMD = 'firewall-cmd'
# A runtime-only rule of a blocker had a timeout; one blocker in use used 120 minutes.
RUNTIME_HOURS = '2'


def _fw(*args):
    return subprocess.run([FIREWALL_CMD, *args], capture_output=True, text=True, timeout=300)


def block_rules(zone, runtime, permanent):
    """The blocker rules of one zone, from the rich rules at run time and permanent: address, ports and whether it stays."""
    found = []
    for rule in sorted(set(runtime) | set(permanent)):
        match = BLOCK_RULE.match(rule.strip())
        if not match:
            continue
        port = match.group(2) or SERVICE_PORTS.get(match.group(3) or '', None if match.group(3) else 'all')
        if port is None:
            continue
        found.append({'zone': zone, 'rule': rule.strip(), 'address': match.group(1), 'ports': port, 'permanent': rule in permanent})
    return found


def blocker_crons(lines, script_text):
    """Cron lines that change the firewall, directly or through a script of their own (read with script_text(path))."""
    found = []
    for source, line in lines:
        text = line.strip()
        if not text or text.startswith('#'):
            continue
        if re.search(r'firewall-cmd|\bipset\b|\biptables\b', text):
            found.append({'file': source, 'line': line})
            continue
        for path in re.findall(r'(/[\w./-]+\.(?:sh|py|pl))\b', text):
            if re.search(r'firewall-cmd|\bipset\b|\biptables\b', script_text(path)):
                found.append({'file': source, 'line': line})
                break
    return found


def _cron_lines():
    lines = [('crontab root', line) for line in subprocess.run(['crontab', '-l'], capture_output=True, text=True).stdout.splitlines()]
    for path in sorted(glob.glob('/etc/cron.d/*')):
        try:
            with open(path) as f:
                lines += [(path, line) for line in f.read().splitlines()]
        except OSError:
            pass
    return lines


def _script_text(path):
    try:
        with open(path, errors='replace') as f:
            return f.read(200000)
    except OSError:
        return ''


def foreign_blockers():
    """What other blockers do on this host: their rules, the cron jobs that keep them up, and zones that make them useless."""
    if shutil.which(FIREWALL_CMD) is None or _fw('--state').returncode != 0:
        return {'rules': [], 'crons': [], 'notes': []}
    rules, notes = [], []
    active = _fw('--get-active-zones').stdout.splitlines()
    active_zones = [line for line in active if line and not line.startswith(' ')]
    for zone in _fw('--get-zones').stdout.split():
        found = block_rules(zone, _fw(f'--zone={zone}', '--list-rich-rules').stdout.splitlines(),
                            _fw('--permanent', f'--zone={zone}', '--list-rich-rules').stdout.splitlines())
        rules += found
        if found and zone not in active_zones:
            notes.append(f'{len(found)} blocker rules in zone {zone}, which has no interface or source: they block nothing. '
                         'eFa-next blocks for every interface.')
    for zone in active_zones:
        if _fw('--permanent', f'--zone={zone}', '--get-target').stdout.strip() == 'ACCEPT':
            notes.append(f'Zone {zone} is active with target ACCEPT: everything it does not reject explicitly is let in. '
                         'efa-migrate does not change zones; check this.')
    return {'rules': rules, 'crons': blocker_crons(_cron_lines(), _script_text), 'notes': notes}


def blocker_lists(rules):
    """The eFa lists for the rules: one per port set, permanent entries for good, runtime-only ones for RUNTIME_HOURS."""
    lists = {}
    for rule in rules:
        name = 'migrated-' + rule['ports'].replace(',', '-')
        lists.setdefault((name, rule['ports'], '' if rule['permanent'] else RUNTIME_HOURS), []).append(rule['address'])
    return lists


# The new Postfix setup does not read sender_access: its entries move to the eFa sender lists, which the web shows.
SENDER_BLOCK = re.compile(r'^(REJECT|DISCARD|5\d\d)\b', re.I)
SENDER_ALLOW = re.compile(r'^(OK|PERMIT)\b', re.I)
SENDER_KEY = re.compile(r'^(?:[a-z0-9._%+-]+@)?@?(?:\*\.)?(?:[a-z0-9-]+\.)+[a-z]{2,63}$', re.I)
SENDER_COMMENT = 'migrated from sender_access'
SENDER_REVIEW = 'migrated from sender_access: OK let mail past every filter in eFa 5, check it'


def sender_access_entries(text):
    """(block, allow, odd) of a sender_access table: addresses and domains with REJECT/DISCARD/5xx or OK/PERMIT. Anything
    else (wildcards, IP keys, other actions, broken lines) is not guessed but reported."""
    block, allow, odd = [], [], []
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith('#'):
            continue
        parts = line.split(None, 1)
        key, action = parts[0], (parts[1].strip() if len(parts) > 1 else '')
        if not SENDER_KEY.match(key) and not _is_ip(key):
            odd.append(line)
        elif SENDER_BLOCK.match(action):
            block.append(key.lstrip('@').lower())
        elif SENDER_ALLOW.match(action):
            allow.append(key.lstrip('@').lower())
        else:
            odd.append(line)
    return sorted(set(block)), sorted(set(allow)), odd


# The rule files of MailScanner (/etc/MailScanner/rules, and the rule sets of the attachment filter and the phishing check in
# /etc/MailScanner itself), the usual kinds as eFa-next settings; everything else into the report with a hint. Lines for
# localhost and the default line of a file need nothing.
MS_RULES_DIR = '/etc/MailScanner/rules/'
MS_ETC_RULES = ('filename.rules', 'filetype.rules', 'archives.filename.rules', 'archives.filetype.rules', 'numeric.phishing.rules')
MS_REVIEW = 'migrated from MailScanner'


def ms_rules(text):
    """(direction, pattern, value) of a MailScanner rule file, without comments, default and localhost lines."""
    found, skipped = [], 0
    for line in text.splitlines():
        parts = line.split('#', 1)[0].split()
        if not parts:
            continue
        if len(parts) < 3 or parts[1].lower() == 'default' or parts[1].startswith('127.') or parts[1] in ('localhost', '::1'):
            skipped += 1
            continue
        found.append((parts[0].rstrip(':').lower(), parts[1].lower(), ' '.join(parts[2:])))
    return found, skipped


def ms_sender(pattern):
    """A MailScanner pattern as a sender of the eFa lists: address, *@domain, domain or IP; None when it is a regex or other."""
    if pattern.startswith('/') or pattern.endswith('/'):
        return None
    if pattern.startswith('*@'):
        pattern = pattern[2:]
    return pattern if SENDER_KEY.match(pattern) or _is_ip(pattern) else None


def ms_plan(files):
    """What eFa-next does with the rule files {name: text}: sender list entries, rules and report lines. A rule name comes
    from file and pattern, so a second run sets the same rule again instead of a second one."""
    allow, block, rules, report, skipped = [], [], [], [], 0
    for name, text in sorted(files.items()):
        found, quiet = ms_rules(text)
        skipped += quiet
        base = name.rsplit('/', 1)[-1]
        for direction, pattern, value in found:
            sender = ms_sender(pattern)
            yes = value.lower() in ('yes', '1')
            rule_name = 'ms-' + re.sub(r'[^a-z0-9]+', '-', f"{base.split('.rules')[0]}-{pattern}").strip('-')[:37]
            kind = 'sender' if sender and '@' in sender else 'sender_domain'
            if base == 'spam.whitelist.rules' and direction == 'from' and sender and yes and not _is_ip(sender):
                allow.append(sender)
            elif base == 'spam.blacklist.rules' and direction == 'from' and sender and yes:
                block.append(sender)
            elif base == 'content.scanning.rules' and direction == 'from' and sender and value.lower() == 'no' and not _is_ip(sender):
                rules.append({'name': rule_name, 'kind': kind, 'value': sender, 'spam_off': True})
            elif base == 'password.rules' and direction == 'from' and sender and yes and not _is_ip(sender):
                rules.append({'name': rule_name, 'kind': kind, 'value': sender, 'allow_encrypted': True})
            elif base.startswith(('sig.', 'inline.sig.')):
                report.append(f'{base}: signature for {pattern}: take it over as a disclaimer (page Disclaimers).')
            elif base in MS_ETC_RULES[:4] and 'allowall' in value:
                report.append(f'{base}: {direction} {pattern}: attachment filter off. eFa-next checks attachments of every sender '
                              '(page Attachments); if this sender needs an exception, add a rule for it.')
            elif base == 'max.message.size.rules':
                report.append(f'{base}: {direction} {pattern} limited to {value}: eFa-next has one size limit (Maintenance: message size).')
            else:
                report.append(f'{base}: {direction} {pattern} {value}: no eFa-next counterpart, check whether it is still needed.')
    return {'allow': sorted(set(allow)), 'block': sorted(set(block)), 'rules': rules, 'report': report, 'skipped': skipped}


# 9m-a: the attachment filter of eFa 5 (filename.rules.conf, filetype.rules.conf and their archive forms). A migration never
# makes eFa less strict: when eFa 5 filtered, the eFa-next filter goes on with reject, the endings of both, the name rules and
# programs by content. What eFa 5 allowed but eFa-next blocks stays blocked and goes into the report.
MS_ATTACH_CONF = ('filename.rules.conf', 'filetype.rules.conf', 'archives.filename.rules.conf', 'archives.filetype.rules.conf')
MS_NAME_RULES = ('.{150,}', r'\{[a-hA-H0-9-]{25,}\}', r'\s{10,}')
MS_PROGRAM_TYPES = ('self-extract', 'executable', 'elf')


def ms_endings(pattern):
    """The endings a pattern of eFa 5 stands for (a dot, then letters, [classes] and ?, then the end); None for any other."""
    match = re.fullmatch(r'\\\.((?:[a-z0-9]|\[[a-z0-9]+\])\??)+\$', pattern, re.I)
    if not match:
        return None
    found = ['']
    for token, optional in re.findall(r'(\[[a-z0-9]+\]|[a-z0-9])(\??)', pattern[2:-1], re.I):
        letters = list(token[1:-1]) if token.startswith('[') else [token]
        found = [start + letter for start in found for letter in letters] + (found if optional else [])
    return sorted({item.lower() for item in found if item})


def ms_attachment_plan(files, current):
    """{on, add, names, executables, differences, report} from the rule set texts {file name: text} of eFa 5."""
    texts = {name.rsplit('/', 1)[-1]: text for name, text in files.items()}
    plan = {'on': False, 'add': [], 'names': False, 'executables': False, 'differences': [], 'report': []}
    deny, allow = set(), set()
    for name in MS_ATTACH_CONF:
        for line in texts.get(name, '').splitlines():
            parts = line.split('#', 1)[0].split('\t')
            parts = [item.strip() for item in parts if item.strip()]
            if len(parts) < 2 or parts[0].lower() not in ('allow', 'deny', 'deny+delete', 'rename'):
                continue
            verb, pattern = parts[0].lower(), parts[1]
            plan['on'] = plan['on'] or verb.startswith('deny')
            if 'filetype' in name:
                if verb.startswith('deny') and pattern.lower() in MS_PROGRAM_TYPES:
                    plan['executables'] = True
                elif verb != 'allow':
                    plan['report'].append(f'{name}: {verb} {pattern}: no eFa-next counterpart, programs are blocked by content.')
                continue
            endings = ms_endings(pattern)
            if verb.startswith('deny') and endings:
                deny.update(endings)
            elif verb == 'allow' and endings:
                allow.update(endings)
            elif verb.startswith('deny') and pattern in MS_NAME_RULES:
                plan['names'] = True
            elif verb.startswith('deny') and r'\s*\.' in pattern:
                plan['report'].append(f'{name}: double endings: eFa-next rejects a dangerous ending behind another one (MIME_DOUBLE_BAD_EXTENSION).')
            elif verb != 'allow':
                plan['report'].append(f'{name}: {verb} {pattern}: no eFa-next counterpart, check whether it is still needed.')
    blocked = set(current) | deny
    plan['add'] = sorted(deny - set(current))
    plan['differences'] = sorted((allow - deny) & blocked)
    plan['report'] = list(dict.fromkeys(plan['report']))
    return plan


def import_attachment_rules(files, warnings, efactl, current):
    plan = ms_attachment_plan(files, current)
    if not plan['on']:
        # The first install turned them on; eFa 5 did not filter, and a migration keeps how the host worked.
        efactl('attachment-set', '--mode=off')
        warnings.append('Attachment filter: off, as eFa 5 had no attachment rules. Recommended: on (page Attachments).')
        return
    call = ['attachment-set', '--mode=on', '--action=reject']
    if plan['add']:
        call.append('--add=' + ' '.join(plan['add']))
    if plan['names']:
        call.append('--names=reject')
    if plan['executables']:
        call.append('--executables=reject')
    efactl(*call)
    warnings.append(f"Attachment filter: on (reject, also in archives), {len(plan['add'])} endings from eFa 5 added"
                    + (', file names that hide what they are' if plan['names'] else '') + (', programs by content' if plan['executables'] else '')
                    + f", {len(plan['differences'])} differences.")
    for ending in plan['differences']:
        warnings.append(f'Attachment filter: eFa 5 allowed .{ending}, eFa-next blocks it. To allow it again: '
                        f'efactl attachment-set --mode on --remove {ending} (page Attachments).')
    warnings.extend(plan['report'])


def _attachment_extensions():
    done = subprocess.run(['/usr/sbin/efactl', 'attachment-status'], capture_output=True, text=True)
    try:
        return json.loads(done.stdout).get('extensions', [])
    except ValueError:
        return []


def legal_confirm(given):
    """5y: before anything changes, the legal texts of eFa-next: shown here, confirmed by typing ja or yes, or unattended with
    --accept-legal=<digest>. Their digest, or None (then nothing changes)."""
    here = os.path.dirname(os.path.abspath(__file__))
    lib_dirs = (os.path.join(here, '..', 'next', 'usr', 'lib', 'eFa', 'python'), '/usr/lib/eFa/python')
    for folder in lib_dirs:
        if os.path.exists(os.path.join(folder, 'efa_legal.py')):
            sys.path.insert(0, folder)
            break
    try:
        import efa_legal
    except ImportError:
        print('The legal texts of eFa-next are missing: run efa-migrate from the eFa-next sources. Nothing was changed.')
        return None
    folders = (os.path.join(here, '..'), efa_legal.FOLDER)
    texts = efa_legal.find_texts(*folders)
    if texts is None:
        print('LICENSE, DISCLAIMER.md and THIRD-PARTY-NOTICES.md are missing next to efa-migrate. Nothing was changed.')
        return None
    the_digest = efa_legal.digest(texts)
    shown = next(folder for folder in folders if efa_legal.find_texts(folder))
    return the_digest if efa_legal.console_confirm(the_digest, os.path.abspath(shown), given) else None


def record_legal(the_digest, warnings):
    """The confirmation of the console, noted by the new eFa-next when its texts are the confirmed ones."""
    done = subprocess.run(['/usr/sbin/efactl', 'legal-accept', f'--digest={the_digest}', '--confirm=yes'], capture_output=True, text=True,
                          env={k: v for k, v in os.environ.items() if k != 'SUDO_USER'})
    if done.returncode != 0:
        warnings.append('Legal texts: the installed version differs from the confirmed one; the first admin login asks for them.')


def import_mailscanner_rules(target, warnings, efactl):
    """The rule files of the old MailScanner from the backup into eFa-next. Rules that weaken the filter stay on and are
    marked for checking; the dashboard lists them."""
    import tarfile
    files, attach = {}, {}
    with tarfile.open(target + '/config.tar.gz') as archive:
        for member in archive.getmembers():
            path = member.name.lstrip('/')
            if member.isfile() and (path.startswith(MS_RULES_DIR.lstrip('/')) and path.endswith('.rules') or
                                    path in {'etc/MailScanner/' + name for name in MS_ETC_RULES}):
                files[member.name] = archive.extractfile(member).read().decode('utf-8', 'replace')
            elif member.isfile() and path in {'etc/MailScanner/' + name for name in MS_ATTACH_CONF}:
                attach[member.name] = archive.extractfile(member).read().decode('utf-8', 'replace')
    found = ms_plan(files)
    for which, items in (('allow', found['allow']), ('block', found['block'])):
        if items:
            efactl('sender-add', f'--list={which}', '--entries=' + ' '.join(items), f'--comment={MS_REVIEW}')
    for rule in found['rules']:
        options = ['--spam_off=on'] if rule.get('spam_off') else ['--allow_encrypted=on']
        efactl('rule-set', f"--name={rule['name']}", '--action=set', f"--kind={rule['kind']}", f"--value={rule['value']}", '--priority=50',
               *options, f'--review={MS_REVIEW}')
    if found['rules']:
        warnings.append(f"CHECK: {len(found['rules'])} MailScanner rules weaken the filter for single senders and are now eFa rules, on and "
                        'marked for checking (Rules page): ' + ', '.join(f"{rule['value']} ({'spam filter off, virus scan stays' if rule.get('spam_off') else 'encrypted archives allowed'})" for rule in found['rules']))
    if found['allow'] or found['block']:
        warnings.append(f"MailScanner lists: {len(found['allow'])} allowed and {len(found['block'])} blocked senders in the eFa sender lists.")
    warnings.extend(found['report'])
    warnings.append(f"MailScanner rule files: {found['skipped']} default or localhost lines need nothing in eFa-next.")
    import_attachment_rules(attach, warnings, efactl, _attachment_extensions())


def _is_ip(text):
    try:
        ipaddress.ip_network(text, strict=False)
        return True
    except ValueError:
        return False


def import_sender_access(target, warnings, efactl):
    path = POSTFIX + '/sender_access'
    if not os.path.exists(path):
        return
    with open(path, errors='replace') as f:
        block, allow, odd = sender_access_entries(f.read())
    for which, items, comment in (('block', block, SENDER_COMMENT), ('allow', allow, SENDER_REVIEW)):
        for start in range(0, len(items), 200):
            efactl('sender-add', f'--list={which}', '--entries=' + ' '.join(items[start:start + 200]), f'--comment={comment}')
    warnings.append(f'Sender lists: {len(block)} blocked and {len(allow)} allowed senders from {path}, marked "{SENDER_COMMENT}". '
                    'The new Postfix setup does not read that file any more.')
    if allow:
        warnings.append('CHECK: these were OK in sender_access and let mail past every filter; in eFa-next they are on the allow '
                        'list, marked for checking: ' + ', '.join(allow))
    if odd:
        warnings.append('Not taken over from sender_access (other actions or broken lines), add them by hand '
                        'if they are still needed: ' + '; '.join(odd))


MAP_REF = re.compile(r'\b((?:hash|btree|lmdb|cdb|regexp|pcre|cidr|texthash|inline|mysql|ldap|proxy:[a-z]+):[^\s,]+)')


def lost_maps(old, new):
    """Maps of the old main.cf (hash:, regexp:, ...) the new one does not use any more: (setting, map) pairs. The new
    setup has its own maps; a table missing here silently stops working, so each one goes into the report."""
    used = {ref for value in new.values() for ref in MAP_REF.findall(value)}
    # The TLS session caches are only caches, the new setup has its own.
    return sorted({(name, ref) for name, value in old.items() for ref in MAP_REF.findall(value)
                   if ref not in used and not name.endswith('_session_cache_database')})


def import_blockers(plan, target, warnings, efactl, disable):
    """The addresses into eFa lists; with disable also the old cron jobs off and the imported rules out, with a way back."""
    blockers = plan.get('foreign_blockers') or {}
    warnings.extend(blockers.get('notes', []))
    if not blockers.get('rules'):
        return
    for (name, ports, hours), addresses in blocker_lists(blockers['rules']).items():
        path = f'{target}/{name}{"-" + hours + "h" if hours else ""}.txt'
        with open(path, 'w') as f:
            f.write('\n'.join(addresses) + '\n')
        efactl('blocklist-import', f'--name={name}', f'--ports={ports}', f'--file={path}', *([f'--hours={hours}'] if hours else []))
    warnings.append(f"Blocklists: {len(blockers['rules'])} addresses of other blockers are now in eFa IP blocklists (page IP blocklists).")
    if not disable:
        if blockers.get('crons'):
            warnings.append('Other blockers still run from cron and keep adding firewalld rules: '
                            + '; '.join(item['line'].strip() for item in blockers['crons'])
                            + '. Run efa-migrate --disable-foreign-blockers BACKUP_DIR to switch them off.')
        return
    disable_blockers(blockers, target, warnings)


def disable_blockers(blockers, target, warnings):
    """The cron lines commented out, the imported rules removed at run time and permanent; never a reload. The way back is
    restore-blockers.sh in the backup."""
    back = ['#!/bin/sh', '# Puts back what efa-migrate --disable-foreign-blockers switched off.']
    for item in blockers.get('crons', []):
        if item['file'] == 'crontab root':
            current = subprocess.run(['crontab', '-l'], capture_output=True, text=True).stdout
            with open(f'{target}/crontab-root.before', 'w') as f:
                f.write(current)
            changed = current.replace(item['line'] + '\n', f"# off by efa-migrate {time.strftime('%F')}: {item['line']}\n", 1)
            subprocess.run(['crontab', '-'], input=changed, text=True, check=True)
            back.append(f'crontab {target}/crontab-root.before')
        else:
            shutil.copy2(item['file'], f"{target}/{os.path.basename(item['file'])}.before")
            with open(item['file']) as f:
                text = f.read()
            with open(item['file'], 'w') as f:
                f.write(text.replace(item['line'] + '\n', f"# off by efa-migrate {time.strftime('%F')}: {item['line']}\n", 1))
            back.append(f"cp {target}/{os.path.basename(item['file'])}.before {item['file']}")
    by_zone = {}
    for rule in blockers['rules']:
        by_zone.setdefault((rule['zone'], rule['permanent']), []).append(rule['rule'])
    for (zone, permanent), rules in by_zone.items():
        for start in range(0, len(rules), 200):
            chunk = rules[start:start + 200]
            _fw(f'--zone={zone}', *[f'--remove-rich-rule={rule}' for rule in chunk])
            if permanent:
                _fw('--permanent', f'--zone={zone}', *[f'--remove-rich-rule={rule}' for rule in chunk])
                back += [f"{FIREWALL_CMD} --permanent --zone={zone} --add-rich-rule='{rule}'" for rule in chunk]
            back += [f"{FIREWALL_CMD} --zone={zone} --add-rich-rule='{rule}'" for rule in chunk]
    with open(f'{target}/restore-blockers.sh', 'w') as f:
        f.write('\n'.join(back) + '\n')
    warnings.append(f"Other blockers switched off: {len(blockers.get('crons', []))} cron jobs, {len(blockers['rules'])} firewalld rules. "
                    f'Way back: sh {target}/restore-blockers.sh')


