# Author: Markus Lorber, Lukasz Galusinski
"""Login shell of a console admin (efactl console-2fa-set): over SSH it asks for the code of the own 2FA of this user and starts
bash only when efactl accepts it. Without one set up: since 2FA is required for every admin (Hans 2026-11-19) it sets up the
first one right here (the app entry, the first code, ten recovery codes), then starts bash; before that day, or on a development
host, no code is asked and efactl notes the login. Never the code of another user. Fails closed: with 2FA (or its setup due) no
terminal, no code, an error of efactl, no shell. On the local console (/dev/ttyN) no code is asked, as Text F of the setup says."""
import getpass
import json
import os
import re
import subprocess
import sys

SHELL = '/bin/bash'
VERIFY = ['sudo', '-n', '/usr/sbin/efactl', 'console-2fa-verify']
ENROLL = ['sudo', '-n', '/usr/sbin/efactl', 'console-2fa-enroll', '--first=yes']


def local_console(fd=0):
    try:
        return bool(re.fullmatch(r'/dev/tty\d+', os.ttyname(fd)))
    except OSError:
        return False


def code_needed(run=subprocess.run):
    """'code' (2FA set up), 'enroll' (none, and required now), '' (none, none asked), None when efactl did not answer."""
    try:
        done = run(VERIFY + ['--check=yes'], capture_output=True, text=True, timeout=30)
        answer = json.loads(done.stdout) if done.returncode == 0 else None
        return None if answer is None else 'code' if answer['needed'] else 'enroll' if answer.get('enroll') else ''
    except (OSError, subprocess.SubprocessError, ValueError, KeyError, TypeError):
        return None


def enroll(ask, run=subprocess.run, out=print):
    """The first 2FA of this user: the app entry, then its first code; True when efactl switched it on."""
    try:
        done = run(ENROLL, capture_output=True, text=True, timeout=30)
        start = json.loads(done.stdout) if done.returncode == 0 else None
    except (OSError, subprocess.SubprocessError, ValueError):
        start = None
    if not start or 'uri' not in start:
        out('eFa-next: the 2FA setup did not start, login refused; log in on the local console.', file=sys.stderr)
        return False
    out('eFa-next: 2FA is required for every admin. Add this entry to an authenticator app '
        '(2FA ist für jeden Admin Pflicht. Diesen Eintrag in eine Authenticator-App übernehmen):')
    out(f"  {start['uri']}")
    out(f"  Secret / Geheimnis: {start['secret']}")
    try:
        code = ask('First code of the app / Erster Code der App: ').strip()
    except (EOFError, KeyboardInterrupt):
        return False
    try:
        done = run(ENROLL + [f'--code={code}'], capture_output=True, text=True, timeout=30)
        result = json.loads(done.stdout) if done.returncode == 0 else None
    except (OSError, subprocess.SubprocessError, ValueError):
        result = None
    if not result or not result.get('active'):
        out('eFa-next: the code did not fit, login refused; log in again to start over.', file=sys.stderr)
        return False
    out('Recovery codes, each works once, shown only now / Wiederherstellungscodes, je einmal gültig, nur jetzt sichtbar:')
    for item in result.get('recovery_codes', []):
        out(f'  {item}')
    return True


def code_ok(code, run=subprocess.run):
    try:
        done = run(VERIFY, input=code + '\n', capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.SubprocessError):
        return False, 'efactl did not answer'
    if done.returncode == 0:
        return True, ''
    message = re.search(r'"error": "([^"]*)"', done.stdout or '')
    return False, message.group(1) if message else 'refused'


def main(argv, ask=input, run=subprocess.run, local=local_console, interactive=None, user=None):
    if not local():
        needed = code_needed(run)
        if needed is None:
            print('eFa-next: the 2FA check did not answer, login refused; log in on the local console.', file=sys.stderr)
            return 1
        if needed and not (sys.stdin.isatty() if interactive is None else interactive):
            print('eFa-next: this login needs 2FA (its code or its first setup): log in with a terminal (ssh -t).', file=sys.stderr)
            return 1
        if needed == 'enroll' and not enroll(ask, run):
            return 1
        if needed == 'code':
            name = user or getpass.getuser()
            try:
                code = ask(f'2FA code for {name} (or a recovery code) / 2FA-Code für {name} (oder ein Wiederherstellungscode): ').strip()
            except (EOFError, KeyboardInterrupt):
                return 1
            ok, why = code_ok(code, run)
            if not ok:
                print(f'eFa-next: login refused: {why}', file=sys.stderr)
                return 1
    # A login shell keeps its dash; ssh -t host command comes as -c command.
    name = '-bash' if argv[0].startswith('-') else 'bash'
    os.execv(SHELL, [name] + argv[1:])
    return 1


def self_test():
    class Done:
        def __init__(self, code, out=''):
            self.returncode, self.stdout = code, out

    def efactl(needed, accept):
        def run(cmd, **kw):
            seen.append((cmd, kw.get('input')))
            if cmd[-1] == '--check=yes':
                return Done(0, json.dumps({'needed': needed}))
            return Done(0) if accept else Done(1, '{"error": "Wrong 2FA code."}')
        return run
    seen = []
    assert code_ok('123456', efactl(True, True)) == (True, '') and seen[-1] == (VERIFY, '123456\n')
    assert code_ok('1', efactl(True, False)) == (False, 'Wrong 2FA code.')
    assert code_ok('1', lambda cmd, **kw: (_ for _ in ()).throw(OSError('no sudo')))[0] is False
    assert code_needed(lambda cmd, **kw: Done(1)) is None and code_needed(lambda cmd, **kw: Done(0, 'x')) is None
    real_execv, started, asked = os.execv, [], []
    os.execv = lambda path, args: started.append((path, args))
    try:
        assert main(['-efa-console-2fa'], ask=lambda p: '000000', run=efactl(True, False), local=lambda: False, interactive=True) == 1 and not started
        assert main(['efa-console-2fa', '-c', 'id'], run=efactl(True, True), local=lambda: False, interactive=False) == 1 and not started, \
            'with 2FA and no terminal: no shell'
        assert main(['-efa-console-2fa'], run=lambda cmd, **kw: Done(1), local=lambda: False, interactive=True) == 1 and not started, \
            'no answer of the check: fail closed'
        assert main(['-efa-console-2fa'], ask=lambda p: (_ for _ in ()).throw(EOFError()), run=efactl(True, True), local=lambda: False,
                    interactive=True) == 1
        main(['efa-console-2fa', '-c', 'id'], ask=lambda p: asked.append(p) or '123456', run=efactl(True, True), local=lambda: False,
             interactive=True, user='efaadmin')
        assert started[-1] == (SHELL, ['bash', '-c', 'id']) and 'efaadmin' in asked[-1]
        asked.clear()
        main(['efa-console-2fa', '-c', 'id'], ask=lambda p: asked.append(p) or '', run=efactl(False, False), local=lambda: False, interactive=False)
        assert started[-1] == (SHELL, ['bash', '-c', 'id']) and not asked, 'no 2FA set up: no code asked, scp and commands work'
        main(['-efa-console-2fa'], run=efactl(True, False), local=lambda: True)
        assert started[-1] == (SHELL, ['-bash']), 'the local console needs no code'
        # Hans 2026-11-19: no 2FA yet and required now: the first one is set up right here, then the shell starts.
        def enrolling(accept):
            def run(cmd, **kw):
                seen.append((cmd, kw.get('input')))
                if cmd[-1] == '--check=yes':
                    return Done(0, json.dumps({'needed': False, 'enroll': True}))
                if cmd == ENROLL:
                    return Done(0, json.dumps({'uri': 'otpauth://totp/x', 'secret': 'ABCD'}))
                if cmd[:-1] == ENROLL and cmd[-1].startswith('--code='):
                    return Done(0, json.dumps({'active': True, 'recovery_codes': ['aaaa-bbbb-cccc']})) if accept else Done(1, '{"error": "Wrong code"}')
                return Done(1)
            return run
        started.clear()
        shown = []
        assert enroll(lambda p: '123456', enrolling(True), out=lambda *a, **k: shown.append(a[0])) and any('aaaa-bbbb-cccc' in line for line in shown)
        assert seen[-1][0] == ENROLL + ['--code=123456'] and ENROLL[-1] == '--first=yes', 'only the first 2FA, never a new one over an active'
        main(['-efa-console-2fa'], ask=lambda p: '123456', run=enrolling(True), local=lambda: False, interactive=True)
        assert started[-1] == (SHELL, ['-bash']), 'set up, then the shell'
        started.clear()
        assert main(['-efa-console-2fa'], ask=lambda p: '000000', run=enrolling(False), local=lambda: False, interactive=True) == 1 and not started
        assert main(['efa-console-2fa', '-c', 'id'], run=enrolling(True), local=lambda: False, interactive=False) == 1 and not started,             'the setup needs a terminal: no shell without one'
        main(['-efa-console-2fa'], run=enrolling(False), local=lambda: True)
        assert started[-1] == (SHELL, ['-bash']), 'the local console needs neither code nor setup'
    finally:
        os.execv = real_execv
    print('self-test ok')


if __name__ == '__main__':
    if sys.argv[1:] == ['--self-test']:
        self_test()
        sys.exit(0)
    sys.exit(main(sys.argv))
