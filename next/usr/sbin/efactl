        # 6.0.0.5: the guard of the security minimum. Only the low values go back; a service that cannot be set back stays stopped.
        weak = lambda ciphers: 'outside' if not ciphers or any(not item.startswith('ECDHE-') for item in ciphers.split(':')) else None
        # openssl ciphers -v on EL9: the TLS 1.3 suites of the crypto policy come with any list, TLS_AES_128_CCM_SHA256 among them.

        def openssl_v(ciphers):
            found = ['TLS_AES_256_GCM_SHA384 TLSv1.3 Kx=any Au=any Enc=AESGCM(256) Mac=AEAD',
                     'TLS_AES_128_CCM_SHA256 TLSv1.3 Kx=any Au=any Enc=AESCCM(128) Mac=AEAD']
            for item in [item for item in ciphers.split(':') if item]:
                if re.fullmatch(r'ECDHE-(ECDSA|RSA)-(AES(128|256)-GCM-SHA(256|384)|CHACHA20-POLY1305)', item):
                    found.append(f"{item} TLSv1.2 Kx=ECDH Au={item.split('-')[1]} Enc={'CHACHA20/POLY1305(256)' if 'CHACHA' in item else 'AESGCM(256)'} Mac=AEAD")
                else:
                    found.append(f'{item} SSLv3 Kx=RSA Au=RSA Enc=AES(128) Mac=SHA1')
            return found
        el9 = lambda ciphers: tls_cipher_problem(openssl_v(ciphers))
        assert el9('AES128-SHA:ECDHE-RSA-AES128-GCM-SHA256') and el9('') and el9('PROFILE=SYSTEM')
        saved_state = tls_profile_state
