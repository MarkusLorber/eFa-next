        assert 'pct' not in second['record']
        history = dmarc_record_history(ns(domain='d.example'))['history']
        assert len(history) == 2 and history[0]['fields']['p'] == 'reject' and history[0]['who'].startswith('console')
        dmarc_record_set(ns(domain='d.example', p='reject', sp='quarantine', np='reject', adkim='s', aspf='s', t='y',
                            rua='mailto:r@other.example', ruf_enable='on', ruf='mailto:f@d.example', fo='1', ruf_ack='yes', external_confirm=EU_CONFIRM))
        assert len(dmarc_record_history(ns(domain='d.example'))['history']) == 2
        # With the EU link of the setup the same report address outside the EU is refused, also with the typed confirmation.
