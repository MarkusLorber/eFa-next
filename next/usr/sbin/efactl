        # 5q: the role matrix. Each predefined role against every command: the system settings only for super, nothing that
        # writes for readonly and auditor, the own mailbox only for user.
        system_only = {'firewall-set', 'firewall-guard-set', 'ssh-root-set', 'web-allowlist-set', 'restore', 'backup-import', 'update-system',
                       'cluster-init', 'cluster-join', 'cluster-leave', 'network-set', 'interface-set', 'reboot', 'halt', 'audit-purge', 'audit-mode',
                       'dkim-provision-set', 'letsencrypt-set', 'service-restart', 'milter-chain-set'}
        own_mailbox = {'uq-list', 'uq-show', 'uq-release', 'uq-request', 'uq-sender', 'uq-delete', 'train-request'}
        for role in ROLES:
            who = {'grants': grants((role, None, None))}
            allowed = {name for name, cmd in COMMANDS.items() if command_allowed(who, name, cmd['writes'])}
            if role != 'super':
                assert not allowed & system_only, (role, sorted(allowed & system_only))
            if role in ('readonly', 'auditor', 'user'):
                writes = {name for name in allowed if COMMANDS[name]['writes'] and COMMAND_PERMISSIONS.get(name, 'x') is not None}
                assert writes <= own_mailbox, (role, sorted(writes - own_mailbox))
            if role == 'user':
                assert {name for name in allowed if COMMAND_PERMISSIONS.get(name, 'x') is not None} <= own_mailbox, 'user: the own mailbox only'
            if role in ('helpdesk', 'readonly', 'auditor', 'user'):
                assert not {'user-set', 'group-set', 'tenant-set'} & allowed, role
            if role == 'domain':
                assert not {'group-set', 'tenant-set', 'tenant-delete'} & allowed, 'a domain admin manages the users of its domain, no groups or tenants'
