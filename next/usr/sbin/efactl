        # The release check: a private repository is a state, an unchanged release a 304, a new one only available once its packages check out.
        class Reply(io.BytesIO):
            def __init__(self, data, etag=None):
                super().__init__(json.dumps(data).encode())
                self.headers = {'ETag': etag}

            def __enter__(self):
                return self

            def __exit__(self, *rest):
                return False
        sent = []

        def answer(code, data=None, etag=None):
            def opener(request, timeout):
                sent.append(dict(request.header_items()))
                if code != 200:
                    raise urllib.error.HTTPError(UPDATE_API, code, 'x', {}, None)
                return Reply(data, etag)
            return opener
