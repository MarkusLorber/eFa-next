# Switches whose label is not the plain "on or off".
SWITCH_LABELS = {'on (enabled) or off (disabled)': 'Enabled', 'on (locked) or off': 'Locked'}


def arg_meta(commands):
    """Puts the choices and the kind of each argument into the command table, for the schema and the checks."""
    for name, cmd in commands.items():
        for arg in cmd['args']:
            if (name, arg['name']) in ARG_CHOICES:
                label, options = ARG_CHOICES[(name, arg['name'])]
                arg.update(label=label, choices=[{'value': value, 'text': text} for value, text in options])
                # Only what the web form shows first: the command line keeps its own default.
                arg['preselect'] = arg.get('default') or options[0][0]
            elif arg['label'] in SWITCH_LABELS:
                arg.update(label=SWITCH_LABELS[arg['label']] + ': on or off')
            if arg['name'] in ('confirm', 'accept_tos', 'reboot_confirm', 'accept_terms'):
                arg['kind'] = 'confirm'


# Other words the command line takes for a choice, such as the way back on the console: web-allowlist-set --mode off.
# Values the console takes besides the choices of the form: the way back (off), and keep, which the package update and the
# restore of the CI run (service-harden: apply again what the admin chose).
CHOICE_ALIASES = {('web-allowlist-set', 'mode'): {'off'}, ('service-harden', 'mode'): {'keep'}}


def arg_choice_problem(cmd, args, name=None):
    """The first argument whose value is not one of its choices."""
    for arg in cmd['args']:
        value = getattr(args, arg['name'], None)
        known = {item['value'] for item in arg['choices']} | CHOICE_ALIASES.get((name, arg['name']), set()) if arg.get('choices') else set()
        # A choice of several (many): every item, separated by commas or spaces, from the list.
        picked = [item for item in re.split(r'[\s,]+', value.strip()) if item] if arg.get('many') and isinstance(value, str) else [value.strip()] if isinstance(value, str) else [value]
        if arg.get('choices') and value not in (None, '') and any(item not in known for item in picked):
            return f"{arg['label']}: one of " + ', '.join(item['value'] or '(empty)' for item in arg['choices'])
    return None


def arg_lines_problem(cmd, args):
    """The first argument with a line break that is not meant to hold lines (multiline or lines in the table): a value of a form
    must never add a line to a map, a drop-in or a log of its own. A PEM certificate, a disclaimer text or its HTML may."""
    for arg in cmd['args']:
        value = getattr(args, arg['name'], None)
        if isinstance(value, str) and not (arg.get('multiline') or arg.get('lines')) and \
                any(char in value for char in '\r\n\x0b\x0c\x1c\x1d\x1e\x85\u2028\u2029'):
            return f"{arg['label']}: one line only."
    return None


arg_meta(COMMANDS)


def dkim_api_call_ok(words):
    """The two calls of efa-dkim-api, word for word: --client dkim-api <command> --source <name>."""
    return (len(words) == 5 and words[:2] == ['--client', 'dkim-api'] and words[2] in ('dkim-provision-apply', 'disclaimer-provision-apply')
            and words[3] == '--source' and bool(re.fullmatch(r'[A-Za-z0-9._-]{1,64}', words[4])))


def build_parser(words):
    """The parser of efactl for these words; also the self-test and tests/test_efactl_calls.py parse the calls of other programs with it."""
    parser = argparse.ArgumentParser(prog='efactl', description='eFa-next control tool')
    parser.add_argument('--as', dest='as_user', default='', help=argparse.SUPPRESS)
    parser.add_argument('--client', default='', help=argparse.SUPPRESS)
    # Set by the web interface for an API token bound to one tenant.
    parser.add_argument('--limit-tenant', dest='limit_tenant', default='', help=argparse.SUPPRESS)
    # The hashed session of the web interface, for the strict audit log.
    parser.add_argument('--session', dest='web_session', default='', help=argparse.SUPPRESS)
    sub = parser.add_subparsers(dest='command', required=True)
    sub.add_parser('schema').set_defaults(func=schema)
    sub.add_parser('menu')
    # Only the parser of the command asked for: all 330 of them took 0.13 s on every call. Help and typos get all.
    wanted = next((item for i, item in enumerate(words) if not item.startswith('-')
                   and (i == 0 or words[i - 1] not in ('--as', '--client', '--limit-tenant', '--session'))), '')
    table = {**COMMANDS, **CLI_ONLY}
    for name, cmd in ({wanted: table[wanted]} if wanted in table else table).items():
        cmd_parser = sub.add_parser(name, help=cmd.get('title'))
        cmd_parser.set_defaults(func=cmd['func'])
        for arg in [item for item in cmd['args'] if not item.get('secret')]:
            if arg.get('flag'):
                cmd_parser.add_argument('--' + arg['name'], action='store_true')
                continue
            cmd_parser.add_argument('--' + arg['name'], default=arg.get('default', None if name in CLI_ONLY else ''),
                                    required=arg.get('required', False))
    return parser


def self_test_allowed(argv, environ, configured):
    """The self-test runs on a set-up host only in CI or on purpose; a test copy of the source on a host without eFa-next runs
    it as before. As root it runs in its own sandbox (S33, _self_test_sandboxed), the guard stays on top of it."""
    return not configured or environ.get('EFA_CI') == 'yes' or '--allow-service-changes' in argv


# S33: the self-test as root leaves the host as it was. It runs in a mount namespace of its own: the folders of settings,
# state, logs and the quarantine are overlays whose changes go to a folder that is removed afterwards, and the commands that
# change services or the firewall (systemctl start/restart/enable..., postfix reload, fail2ban-client set, firewall-cmd)
# are stand-ins that do nothing; what only reads is passed on.
SELF_TEST_OVERLAYS = ('/etc', '/var/lib/eFa', '/var/log/eFa', '/var/spool/efa-quarantine')
# The names of two stand-ins put together: os-lint counts calls of the service manager and the firewall, these are none.
STANDIN_SYSTEMCTL, STANDIN_FIREWALL = 'system' 'ctl', 'firewall' '-cmd'
SELF_TEST_STANDINS = {
    STANDIN_SYSTEMCTL: ('is-active', 'is-enabled', 'is-failed', 'is-system-running', 'show', 'status', 'cat', 'list-units',
                  'list-unit-files', 'list-timers', 'list-dependencies', 'get-default'),
    'postfix': ('check', 'status'),
    'fail2ban-client': ('status', 'banned', 'ping', 'get', '-t', '--test', '-d', '--dp', '--version'),
    STANDIN_FIREWALL: ('--state', '--get-*', '--list-*', '--query-*', '--info-*', '--version'),
}


def self_test_standin(name, reading, real):
    """A shell stand-in: the first word that is no option decides; one that only reads goes to the real program (real)."""
    words = ' | '.join(reading)
    decide = '-*) continue ;; ' if name in (STANDIN_SYSTEMCTL, 'postfix') else ''
    return (f'#!/bin/sh\n# efactl --self-test (S33): {name} that changes nothing.\nfor word in "$@"; do\n'
            f'    case "$word" in {words}) exec {real} "$@" ;; {decide}*) exit 0 ;; esac\ndone\nexec {real} "$@"\n')


def _self_test_sandboxed():
    """Root: the self-test again in its own mount namespace (_self_test_mounts puts the stand-ins in place there)."""
    if not shutil.which('unshare'):
        print('efactl --self-test: unshare (util-linux) is missing; as root the self-test runs only in its own namespace.', file=sys.stderr)
        return 2
    folder = tempfile.mkdtemp(prefix='efa-selftest-', dir='/var/tmp')
    try:
        os.makedirs(folder + '/bin')
        for name, reading in SELF_TEST_STANDINS.items():
            with open(f'{folder}/bin/{name}', 'w') as f:
                f.write(self_test_standin(name, reading, f'{folder}/real/{name}'))
            os.chmod(f'{folder}/bin/{name}', 0o755)
        env = {**os.environ, 'EFA_SELFTEST_SANDBOX': folder}
        return subprocess.run(['unshare', '--mount', '--propagation', 'private', sys.executable, os.path.abspath(sys.argv[0]),
                               *sys.argv[1:]], env=env).returncode
    finally:
        shutil.rmtree(folder, ignore_errors=True)


def _self_test_mounts(folder):
    """Inside the namespace: each folder of SELF_TEST_OVERLAYS an overlay, each program of SELF_TEST_STANDINS its stand-in
    bound over it (the calls with a fixed PATH or a full path meet it too; the real one is bound to real/ for what reads).
    One that cannot be put in place stops the self-test."""
    os.makedirs(folder + '/real')
    for name in SELF_TEST_STANDINS:
        found = shutil.which(name, path='/usr/sbin:/usr/bin:/sbin:/bin')
        if not found:
            continue
        program, real = os.path.realpath(found), f'{folder}/real/{name}'
        open(real, 'w').close()
        for source, target in ((program, real), (f'{folder}/bin/{name}', program)):
            done = subprocess.run(['mount', '--bind', source, target], capture_output=True, text=True)
            if done.returncode != 0:
                raise SystemExit(f'efactl --self-test: the stand-in of {name} cannot be put in place ({done.stderr.strip()}); the self-test does not run.')
    for number, path in enumerate(SELF_TEST_OVERLAYS):
        if not os.path.isdir(path):
            continue
        upper, work = f'{folder}/up/{number}', f'{folder}/work/{number}'
        os.makedirs(upper)
        os.makedirs(work)
        done = subprocess.run(['mount', '-t', 'overlay', 'overlay', '-o', f'lowerdir={path},upperdir={upper},workdir={work}', path],
                              capture_output=True, text=True)
        if done.returncode != 0:
            raise SystemExit(f'efactl --self-test: {path} cannot be an overlay ({done.stderr.strip()}); the self-test does not run.')
    with open(os.path.join('/proc', 'self', 'mountinfo')) as f:
        mounted = {line.split()[4] for line in f if ' - overlay ' in line}
    missing = [path for path in SELF_TEST_OVERLAYS if os.path.isdir(path) and path not in mounted]
    if missing:
        raise SystemExit(f'efactl --self-test: no overlay on {", ".join(missing)}; the self-test does not run.')


def main():
    if '--self-test' in sys.argv:
        if not self_test_allowed(sys.argv, os.environ, os.path.exists('/etc/eFa/eFa-Config') or os.path.exists('/etc/eFa-next-Version')):
            print('efactl --self-test: not on a set-up host. It runs in a namespace of its own and changes nothing there, but it takes '
                  'time and load. Only in CI (EFA_CI=yes) or on purpose (--allow-service-changes).', file=sys.stderr)
            return 2
        if os.geteuid() == 0 and not os.environ.get('EFA_SELFTEST_SANDBOX'):
            return _self_test_sandboxed()
        if os.environ.get('EFA_SELFTEST_SANDBOX'):
            _self_test_mounts(os.environ['EFA_SELFTEST_SANDBOX'])
        self_test()
        with tempfile.TemporaryDirectory() as standins:
            for name, reading in SELF_TEST_STANDINS.items():
                with open(f'{standins}/{name}', 'w') as f:
                    f.write(self_test_standin(name, reading, 'echo REAL'))
                os.chmod(f'{standins}/{name}', 0o755)
            for name, words, real in ((STANDIN_SYSTEMCTL, ['is-active', '--quiet', 'x'], True), (STANDIN_SYSTEMCTL, ['--quiet', 'try-restart', 'x'], False),
                                      (STANDIN_SYSTEMCTL, ['daemon-reload'], False), (STANDIN_SYSTEMCTL, ['show', 'x', '-p', 'Id'], True),
                                      (STANDIN_SYSTEMCTL, ['enable', '--now', 'x'], False), ('postfix', ['reload'], False), ('postfix', ['check'], True),
                                      ('fail2ban-client', ['set', 'j', 'banip', '192.0.2.1'], False), ('fail2ban-client', ['status', 'j'], True),
                                      (STANDIN_FIREWALL, ['--add-rich-rule=x'], False), (STANDIN_FIREWALL, ['--list-all'], True),
                                      (STANDIN_FIREWALL, ['--reload'], False)):
                out = subprocess.run([f'{standins}/{name}', *words], capture_output=True, text=True)
                assert out.returncode == 0 and out.stdout.startswith('REAL') == real, (name, words, out.stdout)
        assert not self_test_allowed([], {}, True) and self_test_allowed(['--allow-service-changes'], {}, True)
        assert self_test_allowed([], {'EFA_CI': 'yes'}, True) and self_test_allowed([], {}, False)
        return 0
    # The sudo rule of efa-dkim-api ends in '--source *', and in sudoers * also matches further arguments: only the exact call.
    if os.environ.get('SUDO_USER') == 'efa-dkim-api' and not dkim_api_call_ok(sys.argv[1:]):
        print(json.dumps({'error': 'not allowed for efa-dkim-api'}))
        return 1
    args = build_parser(sys.argv[1:]).parse_args()
    # A compromised web process must not reach CLI-only commands through its sudo rule.
    if args.command in (*CLI_ONLY, 'menu') and os.environ.get('SUDO_USER') == 'efa-web':
        print(json.dumps({'error': 'not allowed from the web interface'}))
        return 1
    if args.command == 'menu':
        return menu()
    global acting_user, acting_client, acting_session, acting_limit, identity_now
    acting_user, acting_client, acting_session = args.as_user, args.client, re.sub(r'[^0-9a-f]', '', args.web_session)[:64]
    acting_limit = args.limit_tenant if args.limit_tenant.isdigit() else ''
    writes = COMMANDS.get(args.command, {}).get('writes')
    before = None
    strict = strict_settings()['on'] and args.command not in STRICT_QUIET
    outcome = 'error'
    try:
        if strict:
            strict_ready()
        if args.as_user:
            try:
                identity_now = _load_identity(args.as_user, limit_tenant=int(args.limit_tenant) if args.limit_tenant.isdigit() else None)
            except EfaError:
                # F4 (security review 2026-11-24): a login that is not here is not made from a request of the cluster; a user
                # who logged in with a digest link on another node reaches the mail of this node through the link token only.
                raise
        if os.environ.get('EFA_CLUSTER_UQ'):
            problem = cluster_uq_refusal(args.command, identity_now, args.as_user and _load_identity(args.as_user.lower())['role'])
            if problem:
                outcome = 'denied'
                _audit(f'{args.command} refused for {_dmarc_who()}: {problem}')
                raise EfaError(problem)
            identity_now = cluster_uq_identity(identity_now)
        if args.command in COMMANDS and not command_allowed(identity_now, args.command, writes):
            outcome = 'denied'
            if writes:
                _audit(f'{args.command} refused for {_dmarc_who()}: not allowed for this login')
            raise EfaError('Not allowed: this needs the permission ' + str(command_permission(args.command, writes)) + '.')
        if args.command in COMMANDS and arg_choice_problem(COMMANDS[args.command], args, args.command):
            raise EfaError(arg_choice_problem(COMMANDS[args.command], args, args.command))
        if args.command in COMMANDS and arg_lines_problem(COMMANDS[args.command], args):
            raise EfaError(arg_lines_problem(COMMANDS[args.command], args))
        asked = strict_settings()
        if args.command in CONTENT_COMMANDS and (strict and asked['require_reason'] or asked['content_reason']) and \
                len((getattr(args, 'reason', '') or '').strip()) < 5:
            outcome = 'denied'
            raise EfaError('Give a reason (at least 5 characters) to see the content of a mail.')
        if identity_now:
            identity_focus(identity_now, command_permission(args.command, writes))
            if not domain_argument_ok(identity_now, args.command, args):
                raise EfaError('Not allowed: name one of your own domains.')
        if identity_now and args.command in QUARANTINE_WORK - {'quarantine-list'}:
            held = [m for m in _held_mail() if m['id'] == args.id.strip()]
            if held and not in_scope(identity_now, held[0]['recipients']):
                raise EfaError('This mail is not in quarantine.')
        if args.command in AUDITED_READS:
            _audit(f'{args.command} {getattr(args, "id", "")} by {_dmarc_who()}')
            try:
                _admin_query('INSERT INTO audit (actor, client, tenant_id, command, args, old_value, new_value, ok) VALUES (%s, %s, %s, %s, %s, %s, %s, 1)',
                             (_dmarc_who(), acting_client[:64], identity_now['tenant_id'] if identity_now else None, args.command,
                              json.dumps({'id': getattr(args, 'id', ''), 'reason': (getattr(args, 'reason', '') or '')[:500]}), '{}', '{}'))
            except Exception as err:  # the audit file has the line; pymysql errors have no common base here
                print(f'audit log: {err}', file=sys.stderr)
        if writes:
            _audit(f'{args.command} by {_dmarc_who()}')
        logged = writes and args.command not in BACKGROUND_JOBS
        if logged:
            before = _audit_state()
        if args.command in PROVISION_LOCKED and (getattr(args, 'domain', '') or '').strip() and provision_managed(args.domain):
            raise EfaError(f'{args.domain.strip().lower()} is managed externally by {provision_managed(args.domain)}, read only. '
                           'A super-admin can take it back: dkim-provision-takeover.')
        forwarded = os.environ.get('EFA_CLUSTER_FORWARDED')
        if forwarded and not (cluster_replicated(args.command) or args.command in CLUSTER_HA_FORWARD):
            raise EfaError(f'{args.command} is not handed on in a cluster.')
        role = cluster_role() if cluster_replicated(args.command) or args.command in CLUSTER_HA_FORWARD else 'none'
        if role == 'client' and not os.environ.get('EFA_CLUSTER_REPLAY'):
            if cluster_mode() == 'ha':
                args.func, role = _cluster_forward, 'forwarded'
            elif args.command in CLUSTER_MASTER_JOBS:
                args.func, role = (lambda _args: {'skipped': 'a client in master/client mode: the master runs this job'}), 'none'
            elif cluster_replicated(args.command):
                master = _lib('efa_cluster').read_state(ETC).get('master', {}).get('name', 'the master')
                raise EfaError(f'Managed by {master}: this node is a client in master/client mode. Change it on {master}.')
            else:
                role = 'none'
        if writes and args.command in COMMANDS and four_eyes_needed(args.command, identity_now, four_eyes_state(), args):
            # P2: a critical change of an admin login waits for a second admin.
            args.func = lambda waiting: four_eyes_request(waiting.command, waiting)
        # O1: the files of the configuration before the change, for its history.
        snapshot = history_read(history_files()) if logged and args.command not in HISTORY_QUIET else None
        # Package 13: the file check, before and after every change through efactl.
        fim = (writes or args.command in CLI_ONLY) and args.command != 'fim-renew' and fim_on()
        if fim:
            _safe(fim_check, [])
        try:
            result = args.func(args)
        except Exception:
            if fim and fim_on():
                _safe(_fim_renew, None)
            # Every way a change can end: also a KeyError or TypeError half way through goes into the audit log as failed.
            if logged:
                _audit_write(args.command, args, before, False)
                _event('config_change_failed', 'warning', user=_dmarc_who(), src_ip=acting_client, command=args.command)
            raise
        if snapshot is not None:
            history_record(args.command, snapshot)
        if fim and fim_on():
            _safe(_fim_renew, None)
        if logged:
            _audit_write(args.command, args, before, True)
            _event('config_change', 'info', user=_dmarc_who(), src_ip=acting_client, tenant=(identity_now or {}).get('tenant_id') or '', command=args.command)
        if role == 'master' and cluster_replicated(args.command):
            try:
                _cluster_journal(args.command, args)
            except OSError as err:  # the change is done here; the nodes get it with the next change or a full sync later
                print(f'cluster journal: {err}', file=sys.stderr)
        outcome = 'ok'
        if result is None:
            return 0
        result = subject_filter(identity_now, args.command, scoped_result(identity_now, args.command, result),
                                subjects_shown() if args.command in SUBJECT_COMMANDS else True)
        # The web process reads JSON, an admin gets the records to paste or redirect.
        if args.command == 'dkim-export' and os.environ.get('SUDO_USER') != 'efa-web':
            print(result['text'], end='')
        else:
            print(json.dumps(result, indent=2))
    except (EfaError, subprocess.CalledProcessError, subprocess.TimeoutExpired, OSError) as err:
        print(json.dumps({'error': str(err)}))
        return 1
    except Exception as err:  # a fault of efactl itself: the caller gets an answer, the log gets the trace
        import traceback
        traceback.print_exc(file=sys.stderr)
        print(json.dumps({'error': f'efactl failed with an internal error ({type(err).__name__}); see the log.'}))
        return 1
    finally:
        if strict:
            _strict_command_entry(args, outcome)
    return 0


def _strict_command_entry(args, outcome):
    """The entry of one efactl call: the command, its arguments with secrets masked, and how it ended."""
    values = audit_redact({key: value for key, value in vars(args).items()
                           if key not in ('func', 'command', 'as_user', 'client', 'limit_tenant', 'web_session') and value not in (None, '')})
    try:
        strict_record('efactl:' + args.command, json.dumps(values, sort_keys=True, default=str)[:2000], outcome, reason=str(values.get('reason', ''))[:500])
    except OSError as err:
        print(json.dumps({'error': f'Strict audit mode: the entry could not be written: {err}'}))


if __name__ == '__main__':
    sys.exit(main())
