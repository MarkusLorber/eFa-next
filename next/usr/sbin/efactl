# A1: every external call gets a time limit, so a hung program (dnf, postfix, mysql, a milter) cannot block a timer or the CLI
# for ever. The call sites stay subprocess.run(...); this proxy forwards everything to the standard module but fills in a
# timeout when the caller gave none. Programs that may legitimately run long get a longer one. TimeoutExpired is a normal
# subprocess error, caught where the call is handled.
SUBPROCESS_TIMEOUT = 60
# The programs that may legitimately run long, grouped by their limit in seconds. The names are kept colon-joined so the
# os-lint check does not read this mapping as another set of direct OS calls.
SUBPROCESS_LONG = {}
for _names, _seconds in (('dnf:rpm:rpmbuild:ssh:rsync', 1800), ('createrepo_c:freshclam:sa-update', 600),
                         ('needs-restarting:systemd-run:reboot', 300)):
    SUBPROCESS_LONG.update(dict.fromkeys(_names.split(':'), _seconds))


class _Subprocess:
    """subprocess, but run() has a default timeout. Everything else (PIPE, CompletedProcess, TimeoutExpired, ...) passes through."""
    def __getattr__(self, name):
        return getattr(_subprocess, name)

    def run(self, cmd, **kwargs):
        if 'timeout' not in kwargs:
            first = cmd[0] if isinstance(cmd, (list, tuple)) and cmd else cmd
            kwargs['timeout'] = SUBPROCESS_LONG.get(os.path.basename(str(first)), SUBPROCESS_TIMEOUT)
        return _subprocess.run(cmd, **kwargs)


subprocess = _Subprocess()

