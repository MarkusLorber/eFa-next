        assert eu_relation('d.example') is True and eu_relation('mx.free.example') is False and eu_relation('x', {'global': None, 'domains': {}}) is None
        rejected(lambda item: dmarc_record_set(item),
                 ns(domain='d.example', p='none', sp='', np='', adkim='', aspf='', t='', rua='', ruf_enable='on', ruf='mailto:f@d.example', fo='',
