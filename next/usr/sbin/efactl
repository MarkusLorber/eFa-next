        # Restore refuses paths out of the allowed folders, device files and links that leave them.
        class Member:
            def __init__(self, name, kind='file', link=''):
                self.name, self.linkname = name, link
                self.isreg = lambda: kind == 'file'
                self.isdir = lambda: kind == 'dir'
                self.issym = lambda: kind == 'sym'
                self.islnk = lambda: kind == 'hard'
        allowed_roots = ('etc/postfix',)
        good = [Member('etc/postfix/main.cf'), Member('backup.sql'), Member('etc/postfix/a', 'sym', '/usr/share/x'), Member('etc/postfix/b', 'hard', 'etc/postfix/main.cf')]
        assert _restore_unsafe(good, allowed_roots) is None
        for bad in ([Member('etc/postfix/../../root/x')], [Member('etc/postfix/x', 'dev')], [Member('/etc/postfix/x')], [Member('etc/postfix/a', 'hard', 'etc/shadow')],
                    [Member('etc/postfix/a', 'sym', '/root'), Member('etc/postfix/a/x')],
                    [Member('etc/postfix/a', 'sym', '/etc/shadow'), Member('etc/postfix/a')]):
            assert _restore_unsafe(bad, allowed_roots), bad[0].name
        # CVE-2026-11940 pattern, a real tar in memory: a hard link to a symlink entry, then a file written through it.
        def tar_of(entries):
            buf = io.BytesIO()
            with tarfile.open(fileobj=buf, mode='w') as out:
                for name, kind, link in entries:
                    info = tarfile.TarInfo(name)
                    info.type, info.linkname = kind, link
                    out.addfile(info, io.BytesIO(b'') if kind == tarfile.REGTYPE else None)
            buf.seek(0)
            return tarfile.open(fileobj=buf).getmembers()
        assert _restore_unsafe(tar_of([('deep/a/l', tarfile.SYMTYPE, '/etc'), ('deep/hl', tarfile.LNKTYPE, 'deep/a/l'),
                                       ('deep/hl/x', tarfile.REGTYPE, '')]), ('deep',)) == 'deep/hl'
        assert _restore_unsafe(tar_of([('deep/f', tarfile.REGTYPE, ''), ('deep/hl', tarfile.LNKTYPE, 'deep/f'),
                                       ('deep/hl/x', tarfile.REGTYPE, '')]), ('deep',)) == 'deep/hl/x'
        assert _restore_unsafe(tar_of([('deep/f', tarfile.REGTYPE, ''), ('deep/hl', tarfile.LNKTYPE, 'deep/f')]), ('deep',)) is None
