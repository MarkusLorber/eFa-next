# Retention (Q7): the data with their own days; mail log, headers and quarantine have their own settings.
RETENTION_FILE = ETC + '/eFa/retention.json'
RETENTION_DEFAULTS = {'audit': 400, 'reports': 400, 'cdr': 30, 'phish': 30}
RETENTION_LIMITS = {'audit': (90, 3650), 'reports': (30, 3650), 'cdr': (1, 365), 'phish': (1, 365)}


def retention(kind):
    return int(_json_read(RETENTION_FILE, {}).get(kind, RETENTION_DEFAULTS[kind]))


# 9h: a tenant may keep its mail log and its reports shorter or longer than the global days.
RETENTION_TENANT_KINDS = ('maillog', 'reports')


def retention_tenants():
    """{tenant id: {kind: days}} of the tenants with own days."""
    return {int(tid): {kind: int(days) for kind, days in kinds.items() if kind in RETENTION_TENANT_KINDS}
            for tid, kinds in _json_read(RETENTION_FILE, {}).get('tenants', {}).items() if str(tid).isdigit()}


def domain_condition(domains, columns):
    """SQL and parameters: one of the columns names an address of one of the domains (rcpt holds "a@x, b@y")."""
    parts, params = [], []
    for domain in sorted(domains):
        for column in columns:
            if column == 'rcpt':
                parts += ['rcpt LIKE %s', 'rcpt LIKE %s']
                params += [f'%@{search_pattern(domain)}', f'%@{search_pattern(domain)},%']
            elif column == 'domain':
                parts.append('domain = %s')
                params.append(domain)
            else:
                parts.append(f'{column} LIKE %s')
                params.append(f'%@{search_pattern(domain)}')
    return ('(' + ' OR '.join(parts) + ')' if parts else 'FALSE'), params


def retention_deletes(global_days, tenants, tenant_domains, kind, columns):
    """The DELETE conditions of one kind of data: the global days for all rows that no tenant with own days owns, and the days of
    each such tenant for its rows. [(where, params)]."""
    own = [(days[kind], tenant_domains.get(tid, [])) for tid, days in sorted(tenants.items()) if kind in days and tenant_domains.get(tid)]
    found, skip, skip_params = [], [], []
    for days, domains in own:
        where, params = domain_condition(domains, columns)
        found.append((f'ts < NOW() - INTERVAL %s DAY AND {where}', [days] + params))
        skip.append(where)
        skip_params += params
    base = 'ts < NOW() - INTERVAL %s DAY' + (''.join(f' AND NOT {item}' for item in skip))
    return [(base, [global_days] + skip_params)] + found
