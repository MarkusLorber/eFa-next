        assert external_service('rua.dmarcian.com') == 'non-eu' and external_service('a.uriports.com') == 'eu' and external_service('x.example') == 'unknown'
        assert eu_transfer_check('d.example', ['report.uriports.com'], '', 'DMARC reports') == []
        assert any('failure reports' in item for item in eu_findings({'global': 'yes', 'domains': {}}))
        globals().update(EU_FILE=saved_eu, SETUP_VARIANT_FILE=saved_variant)
        # postconf answers kept until main.cf changes: one call for several values, none for a value already read.
        if os.path.exists('/usr/sbin/postconf'):
            saved_pc = (subprocess.run, POSTCONF_CACHE, globals()['ETC'])
            pc_calls = []
            os.makedirs(tmp + '/postfix', exist_ok=True)
            with open(tmp + '/postfix/main.cf', 'w') as f:
                f.write('relayhost =\n')
            globals().update(POSTCONF_CACHE=tmp + '/postconf.json', ETC=tmp)
            subprocess.run = lambda cmd, **kw: (pc_calls.append(cmd), argparse.Namespace(stdout=''.join(f'v-{n}\n' for n in cmd[2:])))[1]
            try:
                assert _postconf_many(['relayhost', 'mynetworks']) == {'relayhost': 'v-relayhost', 'mynetworks': 'v-mynetworks'} and len(pc_calls) == 1
                assert _postconf_many(['mynetworks'])['mynetworks'] == 'v-mynetworks' and len(pc_calls) == 1, 'unchanged main.cf: no postconf'
                assert oct(os.stat(tmp + '/postconf.json').st_mode)[-3:] == '600'
                with open(tmp + '/postfix/main.cf', 'w') as f:
                    f.write('relayhost = [192.0.2.25]\n')
                assert _postconf_many(['relayhost'])['relayhost'] == 'v-relayhost' and len(pc_calls) == 2, 'a changed main.cf is read again'
            finally:
                subprocess.run = saved_pc[0]
                globals().update(POSTCONF_CACHE=saved_pc[1], ETC=saved_pc[2])
        # Relay networks: changes wait for one Apply, system entries stay, open relays never pass.
        global _postconf, _postconf_set, RELAY_FILE, OPTIONS_INC, SENDER_MAPS, SENDER_RULES, SENDER_META, OUTBOUND_FILE
        # Never the files of this host: the relay networks also go into the settings of the outbound milter.
        RELAY_FILE, OPTIONS_INC, kept_outbound = tmp + '/relay.json', tmp + '/options.inc', OUTBOUND_FILE
        OUTBOUND_FILE = tmp + '/outbound.json'
        postfix = {'mynetworks': '127.0.0.0/8 [::1]/128 192.0.2.0/24'}
        _postconf = lambda name: postfix.get(name, '')
        _postconf_set = lambda name, value: postfix.__setitem__(name, value)
        rejected(lambda item: relay_networks_add(item), ns(networks='0.0.0.0/0', description=''), ns(networks='::/0', description=''),
                 ns(networks='198.51.100.1/24', description=''), ns(networks='nope', description=''),
