        # else, also after leaving the setup half way; its sessions end, it gets a mail; switching off is no way around it.
        names_re = ('_admin_query', '_audit', '_account_mail', '_account_row', 'identity_now', '_cli_user', '_users_in_scope', '_actor_scope', '_safe_keys', '_load_identity',
