            open(f'{SANE_DB_DIR}/{name}', 'w').close()
        reloads, real_chown = [], shutil.chown
        shutil.chown = lambda *_a, **_k: None
        _sane_reload = lambda: reloads.append(1)
        def fetch(_connection, name, target, known):
            if name not in ('phish.ndb', 'scam.ndb') or known:
                return None
            with open(target, 'w') as f:
                f.write('new\n')
            return {'etag': '"1"', 'modified': None}
        _sane_fetch = fetch
        _sane_verified = lambda _work, name: 'bad signature' if name == 'scam.ndb' else None
        report = sanesecurity_run(ns())
