                # The transfer on a node: a file is swapped in only with the size and SHA-256 of the manifest (a wrong one keeps
                # the old file), names outside the kind are refused, a file the master dropped goes, other files stay.
                sha = lambda data: hashlib.sha256(data).hexdigest()
                served = {'efa-securiteinfo-a.hdb': b'good', 'efa-urlhaus-urlhaus.ndb': b'evil'}
                listed = {'efa-securiteinfo-a.hdb': {'size': 4, 'sha256': sha(b'good')}, 'efa-urlhaus-urlhaus.ndb': {'size': 4, 'sha256': sha(b'fine')},
                          '../x.hdb': {'size': 1, 'sha256': '0' * 64}, 'other.cvd': {'size': 1, 'sha256': '0' * 64}}
                asked, reloads = [], []

                class Master:
                    SYNC_MAX = 300 * 1024 * 1024

                    @staticmethod
                    def call(base, host, port, path, timeout=10):
                        asked.append(path)
                        return {'kinds': {'clamav': listed}}

                    @staticmethod
                    def fetch_file(base, host, port, path, target, limit):
                        asked.append(path)
                        data = served[urllib.parse.parse_qs(path.split('?', 1)[1])['name'][0]]
                        with open(target, 'wb') as f:
                            f.write(data)
                        return len(data), sha(data)
                kept_sync = (globals()['_cluster_parts'], dict(SYNC_KINDS['clamav']), SYNC_MANIFEST)
                globals().update(_cluster_parts=lambda: (Master, tmp + '/si', {'master': {'host': '192.0.2.1', 'port': 8460}}), SYNC_MANIFEST=tmp + '/si/manifest.json')
                SYNC_KINDS['clamav'].update(check=lambda path: None, after=lambda: reloads.append(1), owner='root')
                try:
