            # At most rate bytes per second: 900 kB at 300 kB/s take 3 seconds, the limit cuts at limit + 1.
            class Slow:
                def __init__(self, size):
                    self.left = size
                def read(self, count):
                    count = min(count, self.left)
                    self.left -= count
                    return b'x' * count
            clock, slept = [0.0], []
            sleeper = lambda seconds: (slept.append(seconds), clock.__setitem__(0, clock[0] + seconds))
            assert len(rate_read(Slow(900000), 10 ** 6, 300000, clock=lambda: clock[0], sleep=sleeper)) == 900000 and abs(clock[0] - 3.0) < 0.01
            assert len(rate_read(Slow(900000), 100000, 300000, clock=lambda: clock[0], sleep=sleeper)) == 100001
