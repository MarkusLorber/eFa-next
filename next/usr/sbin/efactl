RBL_TERMS_TEXT = ('I have read and accept the terms of use of this list. eFa-next, everyone involved in the project and its sponsors, '
                  'including IT-World ITW GmbH, have no influence on this list or its use and are not liable for it. For any problem with the '
                  'list I contact its provider directly.')
RBL_UNCONFIRMED = 'Terms of use not yet confirmed for these active blocklists'


def rbl_accepted(state, name):
    """The confirmation of the terms of a list, if it is for the current state of the terms."""
    item = state.get('accepted', {}).get(name)
    return item if item and item.get('as_of') == RBL_TERMS_AS_OF else None


def _rbl_accept(state, name, args, label):
    """Switching a list on needs the confirmation of its terms, once per state of the terms. Recorded in the audit log."""
    if rbl_accepted(state, name):
        return
    if (getattr(args, 'accept_terms', '') or '').strip() != 'yes':
        raise EfaError(f'Confirm the terms of use of {label} first: {RBL_TERMS_TEXT}')
    who = _dmarc_who()
    state.setdefault('accepted', {})[name] = {'by': who, 'at': time.strftime('%Y-%m-%d %H:%M'), 'as_of': RBL_TERMS_AS_OF}
    _audit(f'terms of use of the blocklist {label} (state {RBL_TERMS_AS_OF}) accepted by {who}')


