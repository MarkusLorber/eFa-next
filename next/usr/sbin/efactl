def schema(_args):
    return {name: {key: cmd.get(key) for key in ('title', 'args', 'writes')} for name, cmd in COMMANDS.items()
            if command_allowed(identity_now, name, cmd.get('writes'))}


def menu():
    """Interactive menu, built from the same table as the web forms."""
    entries = [item for item in COMMANDS.items() if item[0] != 'backup-read'] + [('admin-password', {**CLI_ONLY['admin-password'], 'title': 'Web admin password',
                                                            'writes': True})]
    while True:
        print('\n--- eFa-next configuration ---')
        for number, (_, cmd) in enumerate(entries, 1):
            print(f'{number:>3}) {cmd["title"]}')
        print('  s) Shell\n  l) Log out')
        try:
            choice = input('[eFa-next] : ').strip()
        except EOFError:
            return 0
        if choice == 's':
            return 0
        if choice == 'l':
            subprocess.run(['pkill', '-KILL', '-t', os.ttyname(0).replace('/dev/', '')], check=False)
            return 0
        if not choice.isdigit() or not 1 <= int(choice) <= len(entries):
            print(f'Error "{choice}" is not an option...')
            continue
        name, cmd = entries[int(choice) - 1]
        values = {}
        for arg in cmd['args']:
            if arg.get('secret'):
                continue
            default = arg.get('default', '')
            label = arg.get('label', arg['name']) + (f' [{default}]' if default else '')
            values[arg['name']] = input(f'{label}: ').strip() or default
        try:
            result = cmd['func'](argparse.Namespace(**values))
            print(result['text'] if name == 'dkim-export' else json.dumps(result, indent=2))
        except (EfaError, subprocess.CalledProcessError, OSError) as err:
            print(f'ERROR: {err}')


def acme_test():
    """_acme_request without Let's Encrypt: certbot and DNS are stand-ins."""
    public = lambda name, port, proto=0: [(0, 0, 0, '', ('93.184.215.14', port))]
    private = lambda name, port, proto=0: [(0, 0, 0, '', ('10.0.0.25', port))]
    nowhere = lambda name: set()
    assert acme_name_problem('mx.own.example') and acme_name_problem('efa-dev-test.efa-test.local', public), 'never a non-public name'
    assert acme_name_problem('mx.example.org', private, nowhere) and acme_name_problem('mx', public) and not acme_name_problem('mx.example.org', public)
    # Split horizon: the internal answer is ignored when the public DNS has a public address; no way out to the public DNS warns only.
    notes = []
    assert not acme_name_problem('mx.example.org', private, lambda name: {'93.184.215.14'}, notes) and '10.0.0.25' in notes[0]
    assert not acme_name_problem('mx.example.org', private, lambda name: None, notes) and len(notes) == 2
    saved = (ACME_COOLDOWN, ACME_DEV_FLAG, AUDIT_LOG)
    with tempfile.TemporaryDirectory() as tmp:
        globals().update(ACME_COOLDOWN=tmp + '/cooldown.json', ACME_DEV_FLAG=tmp + '/dev-no-setup-code', AUDIT_LOG=tmp + '/audit.log')
        try:
            calls = []
            ok = lambda cmd, **kw: calls.append(cmd) or subprocess.CompletedProcess(cmd, 0, '', '')
            bad = lambda cmd, **kw: calls.append(cmd) or subprocess.CompletedProcess(cmd, 1, '', 'too many certificates')
            _acme_request(['certbot', 'certonly'], ['mx.example.org'], run=ok, resolve=public)
            assert calls == [['certbot', 'certonly', '--dry-run'], ['certbot', 'certonly', '--keep-until-expiring']], calls
            for names, resolve in ((['efa-dev-test.efa-test.local'], public), (['mx.example.org'], private)):
                calls.clear()
                try:
                    _acme_request(['certbot'], names, run=ok, resolve=resolve, public=nowhere)
                    raise AssertionError('a name that is not public never reaches certbot')
                except EfaError as err:
                    assert 'cannot check this name' in str(err) and not calls
            calls.clear()
            try:
                _acme_request(['certbot'], ['mx.example.org'], run=bad, resolve=public)
                raise AssertionError('a failed dry run stops')
            except EfaError as err:
                assert 'dry run failed' in str(err) and calls == [['certbot', '--dry-run']], 'no real request after a failed dry run'
            assert acme_cooldown() and acme_banner(), "a failure pauses Let's Encrypt"
            calls.clear()
            try:
                _acme_request(['certbot'], ['mx.example.org'], run=ok, resolve=public)
                raise AssertionError('no request while paused')
            except EfaError as err:
                assert 'paused' in str(err) and not calls
            _acme_request(['certbot'], ['mx.example.org'], force=True, run=ok, resolve=public)
            assert len(calls) == 2 and not acme_cooldown() and not acme_banner(), 'force asks again, success ends the pause'
            open(ACME_DEV_FLAG, 'w').close()
            calls.clear()
            try:
                _acme_request(['certbot'], ['mx.example.org'], force=True, run=ok, resolve=public)
                raise AssertionError('never on a dev host')
            except EfaError as err:
                assert 'Dev mode' in str(err) and not calls
        finally:
            globals().update(ACME_COOLDOWN=saved[0], ACME_DEV_FLAG=saved[1], AUDIT_LOG=saved[2])


def self_test():
    assert "name = 'EFA_HIDDEN_FILENAME'" in ATTACH_LUA_TEXT and "name = 'EFA_BAD_FILENAME'" not in ATTACH_LUA_TEXT, 'one symbol, one name'
    # The hourly job: a failing early step is named, the later ones (the security minimum, the EU lock) still run.
    ran = []

    def broken():
        raise OSError('no mail log')
    assert hourly_steps([('first', broken), ('security minimum', lambda: ran.append('floor')), ('EU lock', lambda: ran.append('eu'))]) == ['first']
    assert ran == ['floor', 'eu'], ran
    # Require TLS on port 25: sessions and the senders without TLS of 7 days, never local ones; the switch needs the confirmation.
    day = datetime.date(2026, 11, 9)
    lines = ['Nov  9 10:00:01 mx postfix/smtpd[1]: connect from a.example[192.0.2.1]',
             'Nov  9 10:00:01 mx postfix/smtpd[1]: Anonymous TLS connection established from a.example[192.0.2.1]: TLSv1.3',
             'Nov  9 10:00:02 mx postfix/smtpd[2]: connect from old.example[192.0.2.9]',
             'Nov  9 10:00:03 mx postfix/smtpd[3]: connect from old.example[192.0.2.9]',
             'Nov  9 10:00:04 mx postfix/smtpd[4]: connect from localhost[127.0.0.1]',
             'Nov  9 10:00:05 mx postfix/submission/smtpd[5]: connect from pc[10.0.0.5]']
    counts = tls25_count(lines, {'2026-11-01': {'sessions': 9, 'tls': 0, 'plain': {'x[192.0.2.7]': 9}}}, day)
    assert counts == {'2026-11-09': {'sessions': 3, 'tls': 1, 'plain': {'old.example[192.0.2.9]': 2}}}, counts
    # JOB-2: the run after midnight puts the lines of before midnight on their own day.
    late = tls25_count(['Nov  9 23:59:58 mx postfix/smtpd[7]: connect from late.example[192.0.2.10]',
                        'Nov 10 00:00:02 mx postfix/smtpd[8]: connect from early.example[192.0.2.11]'], {}, datetime.date(2026, 11, 10))
    assert late == {'2026-11-09': {'sessions': 1, 'tls': 0, 'plain': {'late.example[192.0.2.10]': 1}},
                    '2026-11-10': {'sessions': 1, 'tls': 0, 'plain': {'early.example[192.0.2.11]': 1}}}, late
    # JOB-2: the rotated mail log is found by its inode, a compressed one never.
    log_dir = tempfile.mkdtemp()
    with open(log_dir + '/maillog-20261109', 'w') as rotated_file:
        rotated_file.write('x\n')
    open(log_dir + '/maillog-20261102.gz', 'w').close()
    open(log_dir + '/maillog', 'w').close()
    assert rotated_log(log_dir + '/maillog', os.stat(log_dir + '/maillog-20261109').st_ino) == log_dir + '/maillog-20261109'
    assert rotated_log(log_dir + '/maillog', os.stat(log_dir + '/maillog-20261102.gz').st_ino) is None
    shutil.rmtree(log_dir)
    try:
        tls_port25_set(argparse.Namespace(mode='on', confirm=''))
        raise AssertionError('switched on without the confirmation')
    except EfaError as err:
        assert 'RFC 3207' in str(err)
    # S25: the test mails after the release upgrade stay on the host: their queue id, and the transports held meanwhile.
    assert ru_queue_id(b'2.0.0 Ok: queued as 4XyZ1k2LmNz') == '4XyZ1k2LmNz' and ru_queue_id('2.0.0 Ok') is None
    master = ('smtp      inet  n       -       n       -       -       smtpd\n'
              'smtp      unix  -       -       n       -       -       smtp\n'
              'relay     unix  -       -       n       -       -       smtp\n  -o syslog_name=postfix/relay\n'
              'efabulk   unix  -       -       n       -       -       smtp\n'
              'lmtp      unix  -       -       n       -       -       lmtp\n'
              '#old      unix  -       -       n       -       -       smtp\n'
              'retry     unix  -       -       n       -       -       error\n')
    assert ru_delivery_transports(master) == ['efabulk', 'lmtp', 'relay', 'smtp'], ru_delivery_transports(master)
    # S26: the checks after the first EL10 boot keep their mark until they ran to their end; a crash runs them again.
    marker_dir = tempfile.mkdtemp()
    disabled = []

    class FinishPlatform:
        def service_disable(self, name):
            disabled.append(name)

        def release_facts(self, avc_since=None):
            return {}

        def release_service_states(self, names, prefix):
            return {'efa-web': ('notify', 'active'), 'efa-release-upgrade-finish': ('oneshot', 'activating')}

    class FinishLib:
        MANAGED_SERVICES = ('postfix',)
        REPO_FILES = ()  # never the repositories of the host that runs the test
        own_settings_filtered = staticmethod(lambda diff, own: (diff, []))
        RU_OWN_UNITS = ('efa-release-upgrade-finish.service',)
        @staticmethod
        def post_checks(facts, before):
            return {'ok': True, 'checks': [], 'failed': []}

        @staticmethod
        def config_diff(before, after):
            return []
        # No safety net was set up here: its removal at the end finds nothing.
        RECOVER_UNIT = 'efa-release-upgrade-recover.service'
        RECOVER_UNIT_FILE = RECOVER_DIR = RECOVER_MOTD = marker_dir + '/no-safety-net'
        # Nothing leapp left here.
        LEAPP_LEFTOVERS, LEAPP_ETC = (), marker_dir + '/no-leapp'
    crash = [True]

    def after_upgrade(state):
        if crash[0]:
            raise OSError('power cut')
    saved_finish = {name: globals()[name] for name in ('RU_FINISH_MARK', 'RU_STATE', 'RU_DIR', 'RU_LOG', '_platform', '_ru_lib',
                                                        '_ru_after_upgrade', '_ru_baseline', '_ru_mail_test', '_backup_make', '_ru_save',
                                                        '_backup_stored_password', '_ru_mail_start', '_event', '_admin_notify', '_ru_config')}
    globals().update(RU_DIR=marker_dir, RU_FINISH_MARK=marker_dir + '/finish-pending', RU_STATE=marker_dir + '/state.json',
                     RU_LOG=marker_dir + '/log', _platform=FinishPlatform, _ru_lib=FinishLib, _ru_after_upgrade=after_upgrade,
                     _ru_baseline=lambda facts: {key: None for key in ('addresses', 'routes', 'firewall', 'mail_block', 'counts', 'dkim', 'wazuh')} | {'perl': []},
                     _ru_mail_test=lambda: {}, _backup_make=lambda password: None, _backup_stored_password=lambda: 'x',
                     _ru_mail_start=lambda state: None, _event=lambda *a, **k: None, _admin_notify=lambda *a: None, _ru_config=lambda facts: {},
                     # the saving itself is fixed on its own branch; here only the mark counts
                     _ru_save=lambda *a, **k: a[0].update(k) or a[0])
    saved_check = subprocess.run
    subprocess.run = lambda *a, **k: subprocess.CompletedProcess(a, 0, '', '')
    try:
        with open(RU_FINISH_MARK, 'w') as f:
            f.write('x')
        try:
            release_upgrade_finish(None)
            raise AssertionError('the crash went unnoticed')
        except OSError:
            pass
        assert os.path.exists(RU_FINISH_MARK) and not disabled, 'kept for the next boot'
        crash[0] = False
        assert 'all checks passed' in release_upgrade_finish(None)['release_upgrade']
        assert not os.path.exists(RU_FINISH_MARK) and disabled == [RU_FINISH_UNIT]
        assert release_upgrade_finish(None) == {'release_upgrade': 'nothing to do'}
    finally:
        subprocess.run = saved_check
        globals().update(saved_finish)
    # S27: the maintenance block of the release upgrade reaches the smtpd services with a client list of their own too.
    listing = ('submission/inet/syslog_name = postfix/submission\n'
               'submission/inet/smtpd_client_restrictions = permit_sasl_authenticated, reject\n'
               'smtps/inet/smtpd_client_restrictions =\n'
               'smtpd/pass/smtpd_client_restrictions = $mua_client_restrictions\n')
    assert ru_client_overrides(listing) == {'submission/inet': 'permit_sasl_authenticated, reject', 'smtps/inet': '',
                                            'smtpd/pass': '$mua_client_restrictions'}, ru_client_overrides(listing)
    assert ru_client_overrides('') == {} and ru_blocked('check_client_access cidr:/x', '') == 'check_client_access cidr:/x'
    assert ru_blocked('check_client_access cidr:/x', 'reject') == 'check_client_access cidr:/x, reject'
    # S29: the boot entries of the old machine id: its rescue goes, the other entries take the new id; nothing of another id moves.
    boot_dir = tempfile.mkdtemp()
    os.makedirs(boot_dir + '/loader/entries')
    for name in ('vmlinuz-0-rescue-aaa', '.vmlinuz-0-rescue-aaa.hmac', 'initramfs-0-rescue-aaa.img', 'vmlinuz-5.14',
                 'loader/entries/aaa-5.14.el9.conf', 'loader/entries/aaa-0-rescue.conf', 'loader/entries/bbb-5.14.el9.conf'):
        open(os.path.join(boot_dir, name), 'w').close()
    with open(boot_dir + '/loader/entries/aaa-5.14.el9.conf', 'w') as f:
        f.write('title AlmaLinux (5.14) aaa\nlinux /vmlinuz-5.14\ninitrd /initramfs-5.14.img\noptions root=/dev/x\n')
    with open(boot_dir + '/loader/entries/aaa-5.10.el9.conf', 'w') as f:
        f.write('linux /vmlinuz-5.10\ninitrd /initramfs-5.10.img\n')
    with open(boot_dir + '/loader/entries/bbb-5.13.el9.conf', 'w') as f:
        f.write('linux /vmlinuz-5.13\n')
    open(boot_dir + '/initramfs-5.14.img', 'w').close()
    moved = clone_boot_entries(boot_dir, 'aaa', 'ccc', running='5.13')
    assert sorted(os.listdir(boot_dir + '/loader/entries')) == ['bbb-5.13.el9.conf', 'bbb-5.14.el9.conf', 'ccc-5.14.el9.conf'], \
        os.listdir(boot_dir + '/loader/entries')
    with open(boot_dir + '/loader/entries/ccc-5.14.el9.conf') as f:
        assert 'aaa' not in f.read(), 'the old id out of the content too'
    assert sorted(os.listdir(boot_dir)) == ['initramfs-5.14.img', 'loader', 'vmlinuz-5.14'] and len(moved) == 7, moved
    assert ('removed', 'ccc-5.10.el9.conf') in [(what, os.path.basename(path)) for what, path in moved], 'kernel gone: entry dropped'
