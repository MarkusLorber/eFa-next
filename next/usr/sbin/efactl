        kinds = {row['entry']: row['type'] for row in rows['allow'] + rows['rules']}
        assert kinds == {'a@example.org': 'address', 'example.net': 'domain', '192.0.2.1': 'IP', '*news*': 'pattern'}
        assert rows['allow'][0]['comment'] == 'Partner' and rows['allow'][0]['added'] == day[0].isoformat()
