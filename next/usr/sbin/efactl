        # Sanesecurity: only low-risk databases, and a broken download never replaces a file.
        global SANE_FILE, SANE_DB_DIR, SANE_OLD_DIR, _sane_fetch, _sane_verified, _sane_reload
        SANE_FILE, SANE_DB_DIR, SANE_OLD_DIR = tmp + '/sane.json', tmp + '/clamav', tmp + '/old'
