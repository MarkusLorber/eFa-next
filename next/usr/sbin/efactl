        assert pam_toggled(auth, True) == auth and '#!include auth-sql.conf.ext' in pam_toggled(auth, False)
        # Dovecot only while port 587 has logins: off is stopped and disabled, and 587 offers no AUTH.
        done_calls = []

        class FakePlatform:
            def service(self, logical):
                return {'sasl': 'dovecot', 'mta': 'postfix'}[logical]

            def service_exists(self, name):
                return True

            def __getattr__(self, name):
                return lambda *args, **kwargs: done_calls.append((name, args, kwargs))
        saved_platform, kept_run, kept_listen = globals()['_platform'], subprocess.run, DOVECOT_LISTEN
        listen_dir = tempfile.mkdtemp()
        globals().update(_platform=FakePlatform, DOVECOT_LISTEN=listen_dir + '/98-efa-listen.conf')
        subprocess.run = lambda argv, **kwargs: done_calls.append(('run', tuple(argv), {}))
        try:
            _sasl_apply(False, pam_on=False)
            assert ('service_disable', ('efa-sasl.socket',), {'stop': True}) in done_calls
            assert ('run', ('postconf', '-P', 'submission/inet/smtpd_sasl_auth_enable=no'), {}) in done_calls
            done_calls.clear()
            _sasl_apply(True, pam_on=False)
            assert ('service_enable', ('efa-sasl.socket',), {'start': True}) in done_calls and ('service_disable', ('dovecot',), {'stop': True}) in done_calls
            assert ('run', ('postconf', '-P', 'submission/inet/smtpd_sasl_auth_enable=yes'), {}) in done_calls
            assert ('run', ('postconf', '-P', 'submission/inet/smtpd_sasl_path=/run/efa-sasl/auth'), {}) in done_calls
            done_calls.clear()
            _sasl_apply(True, pam_on=True)
            assert ('run', ('postconf', '-PX', 'submission/inet/smtpd_sasl_path'), {}) in done_calls, 'Dovecot: the socket of Postfix again'
            assert ('service_enable', ('dovecot',), {'start': True}) in done_calls and ('service_disable', ('efa-sasl.socket',), {'stop': True}) in done_calls
            # F5: the fake has no IPv6 (ipv6_available gives None): Dovecot listens on IPv4 only, written once; with IPv6 the file goes.
            assert open(DOVECOT_LISTEN).read() == DOVECOT_LISTEN_TEXT and not _dovecot_listen(FakePlatform())

            class WithIPv6:
                def ipv6_available(self):
                    return True
            assert _dovecot_listen(WithIPv6()) and not os.path.exists(DOVECOT_LISTEN) and not _dovecot_listen(WithIPv6())
            # F3: an upgrade with AUTH on 587 off keeps it off, also when the OS upgrade put the 10-auth.conf of the package back.
            pam_dir = tempfile.mkdtemp()
            kept_pam = {name: globals()[name] for name in ('DOVECOT_AUTH', 'PAM_OFF_FILE', '_submitters', '_sasl_logins_write', '_audit')}
            noted = []
            globals().update(DOVECOT_AUTH=pam_dir + '/10-auth.conf', PAM_OFF_FILE=pam_dir + '/submission-pam-off', _submitters=lambda: [],
                             _sasl_logins_write=lambda submitters: [], _audit=noted.append)
            try:
                _write(DOVECOT_AUTH, pam_toggled(auth, False))  # switched off with 6.0.0.5, before the mark existed
                done_calls.clear()
                assert sasl_apply(None)['logins_on_587'] is False and os.path.exists(PAM_OFF_FILE), 'the choice is kept by eFa-next now'
                assert ('run', ('postconf', '-P', 'submission/inet/smtpd_sasl_auth_enable=no'), {}) in done_calls
                _write(DOVECOT_AUTH, auth)  # leapp: the file of the EL10 package, the system accounts on again
                done_calls.clear()
                assert sasl_apply(None)['logins_on_587'] is False and not _pam_on(), 'the stored setting, never the default'
                assert ('run', ('postconf', '-P', 'submission/inet/smtpd_sasl_auth_enable=no'), {}) in done_calls
                assert ('service_disable', ('dovecot',), {'stop': True}) in done_calls and '#!include auth-system.conf.ext' in open(DOVECOT_AUTH).read()
                assert noted and 'switched off again' in noted[0]
                # No mark yet (the last sasl-apply ran on an older build): the release upgrade records 587 before leapp and writes
                # the mark itself; the finish puts back exactly the recorded state after leapp restored the file and AUTH came on.
                os.remove(PAM_OFF_FILE)
                _write(DOVECOT_AUTH, pam_toggled(auth, False))
                kept_auth, auth_now = globals()['_submission_auth'], ['no']
                kept_587 = {name: globals()[name] for name in ('_submission_effective', '_submission_units')}
                globals()['_submission_auth'] = lambda: auth_now[0]
                try:
                    # 2026-11-18: the record has what 587 uses and its login services; port 587 of a host where AUTH came from
                    # main.cf with Dovecot, after leapp with an -o for efa-sasl and efa-sasl on: back exactly to before.
                    before_587 = {'smtpd_sasl_auth_enable': 'yes', 'smtpd_sasl_type': 'dovecot', 'smtpd_sasl_path': 'private/auth',
                                  'smtpd_tls_auth_only': 'yes', 'smtpd_sasl_security_options': 'noanonymous'}
                    now_587 = [({**before_587, 'smtpd_sasl_path': '/run/efa-sasl/auth'}, {'smtpd_sasl_path': '/run/efa-sasl/auth'}), (before_587, {})]
                    units_now = [{'efa-sasl.socket': True, 'dovecot': False}]
                    globals().update(_submission_effective=lambda: now_587.pop(0) if len(now_587) > 1 else now_587[0],
                                     _submission_units=lambda: units_now[0])
                    record_new = {'auth': 'yes', 'pam_on': False, 'effective': before_587, 'overrides': {},
                                  'units': {'efa-sasl.socket': False, 'dovecot': True}}
                    done_calls.clear()
                    changed_587, what_587 = submission_restore(record_new)
                    assert changed_587 and 'dovecot private/auth' in what_587, what_587
                    assert ('run', ('postconf', '-PX', 'submission/inet/smtpd_sasl_path'), {}) in done_calls, 'the -o of eFa-next goes'
                    assert ('service_disable', ('efa-sasl.socket',), {'stop': True}) in done_calls and ('service_enable', ('dovecot',), {'start': True}) in done_calls
                    assert not [call for call in done_calls if call[1][:3] == ('postconf', '-P', 'submission/inet/smtpd_sasl_auth_enable=yes')]
                    # AUTH off before: never on again, and nothing at all when 587 is as before.
                    off_587 = {**before_587, 'smtpd_sasl_auth_enable': 'no'}
                    now_587[:] = [({**off_587, 'smtpd_sasl_auth_enable': 'yes'}, {'smtpd_sasl_auth_enable': 'yes'}), (off_587, {'smtpd_sasl_auth_enable': 'no'})]
                    units_now[0] = {'efa-sasl.socket': False, 'dovecot': False}
                    done_calls.clear()
                    assert submission_restore({'auth': 'no', 'pam_on': False, 'effective': off_587, 'overrides': {'smtpd_sasl_auth_enable': 'no'},
                                               'units': {'efa-sasl.socket': False, 'dovecot': False}})[0]
                    assert ('run', ('postconf', '-P', 'submission/inet/smtpd_sasl_auth_enable=no'), {}) in done_calls
                    assert not [call for call in done_calls if call[0] == 'service_enable'], 'no login service enabled'
                    now_587[:] = [(off_587, {'smtpd_sasl_auth_enable': 'no'})]
                    done_calls.clear()
                    assert not submission_restore({'auth': 'no', 'pam_on': False, 'effective': off_587, 'overrides': {'smtpd_sasl_auth_enable': 'no'},
                                                   'units': {'efa-sasl.socket': False, 'dovecot': False}})[0] and not done_calls
                    globals().update(kept_587)
                    recorded = {'auth': 'no', 'pam_on': False}
                    _pam_keep()
                    assert os.path.exists(PAM_OFF_FILE)
                    # A record of 6.0.0.6.5 (AUTH and the system accounts only).
                    assert submission_restore(recorded) == (False, 'AUTH no as before (the login service of 587 left as it is)'), 'nothing changed: nothing done'
                    os.remove(PAM_OFF_FILE)  # even without the mark after leapp
                    _write(DOVECOT_AUTH, auth)
                    auth_now[0] = 'yes'
                    done_calls.clear()
                    assert submission_restore(recorded)[0] and os.path.exists(PAM_OFF_FILE) and not _pam_on()
                    assert ('run', ('postconf', '-P', 'submission/inet/smtpd_sasl_auth_enable=no'), {}) in done_calls
                    assert ('service_disable', ('dovecot',), {'stop': True}) in done_calls
                    assert submission_restore(None) == (False, 'nothing recorded before the upgrade')
                finally:
                    globals()['_submission_auth'] = kept_auth
                    globals().update(kept_587)
                os.remove(PAM_OFF_FILE)
                _write(DOVECOT_AUTH, auth)
                done_calls.clear()
                assert sasl_apply(None)['logins_on_587'] is True, 'system accounts on as the package sets it: AUTH through Dovecot'
            finally:
