def _el_release(path='/etc/os-release'):
    """el9 or el10: the folder of repo.efa-next.eu for the release of this host (el9 when it cannot be read)."""
    try:
        with open(path) as f:
            found = re.search(r'^VERSION_ID="?(\d+)', f.read(), re.M)
    except OSError:
        found = None
    return f'el{found.group(1)}' if found and found.group(1) in ('9', '10') else 'el9'


EL_RELEASE = _el_release()
# Hans 2026-11-15: eFa-next on EL9 (AlmaLinux, Rocky Linux, RHEL 9) has support and security updates until EL9_SUPPORT_UNTIL; after
# that no updates, only the migration to eFa-next 6.x on version 10. The dashboard warns from EL9_WARN_FROM (yellow, a notice that
# can be confirmed or hidden) and is red after EL9_SUPPORT_UNTIL (a banner: no button takes it away); nothing before. The dates
# only choose texts: they never lock the release upgrade or a migration.
EL9_WARN_FROM = datetime.date(2026, 12, 1)
EL9_SUPPORT_UNTIL = datetime.date(2027, 5, 31)
# The operating system itself (endoflife.date, AlmaLinux, Rocky Linux and RHEL 9 alike): security updates until then.
EL9_OS_SECURITY_UNTIL = datetime.date(2032, 5, 31)


def el9_support_state(release=None, today=None):
    """'' (nothing to say: EL10, or before EL9_WARN_FROM), 'warn' (yellow: the end is near) or 'ended' (red)."""
    today = today or datetime.date.today()
    if (release or EL_RELEASE) != 'el9' or today < EL9_WARN_FROM:
        return ''
    return 'ended' if today > EL9_SUPPORT_UNTIL else 'warn'


def el9_banner(release=None, today=None):
    """Red on the dashboard once eFa-next on EL9 has no support and no updates any more."""
    if el9_support_state(release, today) != 'ended':
        return []
    return [_text('eFa-next on EL9: full support and security updates ended on {until}; this host gets no more updates. Only the '
                  'migration to eFa-next 6.x on version 10 remains (Maintenance & update, Release upgrade).', until=EL9_SUPPORT_UNTIL.isoformat())]


