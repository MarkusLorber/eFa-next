        em_users = {'eva': {'password': web_password_hash('Eva-Pass-2026-long'), 'disabled': 0, 'email': 'eva@example.org'},
                    'otto': {'password': web_password_hash('Otto-Pass-2026-long'), 'disabled': 0, 'email': None}}
