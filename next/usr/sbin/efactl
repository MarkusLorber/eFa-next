def _symbol_texts(fetch=None):
    """rspamd's own description of each symbol, cached for a day. Without rspamd only the names are shown."""
    cached = _json_read(SYMBOL_CACHE, None)
    if cached and time.time() - cached.get('fetched', 0) < 86400:
        return cached['texts']
    try:
        groups = fetch() if fetch else json.loads(urllib.request.urlopen(SYMBOL_URL, timeout=5).read())
        texts = {rule['symbol']: rule.get('description') or '' for group in groups for rule in group.get('rules', [])}
    except (OSError, ValueError, KeyError, TypeError):
        return (cached or {}).get('texts', {})
    try:
        _json_write(SYMBOL_CACHE, {'fetched': time.time(), 'texts': texts})
    except OSError:
        pass
    return texts


# 9n: own scores of rspamd symbols, kept by eFa (rights, audit, cluster) instead of the rspamd web interface.
SYMBOL_SCORES_FILE = ETC + '/eFa/symbol-scores.json'
SYMBOL_GROUPS_CONF = RSPAMD_DIR + '/local.d/groups.conf'
SYMBOL_NAME_RE = re.compile(r'^[A-Z0-9_]{2,64}$')
SYMBOL_SCORE_RANGE = (-50.0, 50.0)


def _symbol_groups(fetch=None):
    """The symbols rspamd knows now: {symbol: (group, weight, description)}."""
    groups = fetch() if fetch else json.loads(urllib.request.urlopen(SYMBOL_URL, timeout=10).read())
    return {rule['symbol']: (group.get('group', ''), rule.get('weight', 0), rule.get('description') or '') for group in groups for rule in group.get('rules', [])}


def symbol_groups_conf(overrides):
    """local.d/groups.conf of the own scores: per group of rspamd, each symbol with its weight. Merged into rspamd's groups."""
    by_group = {}
    for symbol, item in sorted(overrides.items()):
        by_group.setdefault(item['group'], []).append((symbol, item['score']))
    lines = ['# Written by eFa (efactl symbol-score-set). Changes here are overwritten.']
    for group, items in sorted(by_group.items()):
        lines.append(f'group "{group}" {{\n  symbols {{')
        lines += [f'    "{symbol}" {{ weight = {score:g}; }}' for symbol, score in items]
        lines.append('  }\n}')
    return '\n'.join(lines) + '\n'


def symbol_scores(args):
    """The symbols of rspamd with the score that counts now and the own ones; filtered by part of a name or description."""
    wanted = (getattr(args, 'filter', '') or '').strip().lower()
    overrides = _json_read(SYMBOL_SCORES_FILE, {})
    try:
        known = _symbol_groups()
    except (OSError, ValueError, KeyError, TypeError) as err:
        raise EfaError(f'rspamd does not answer: {err}')
    rows = [{'symbol': symbol, 'group': group, 'score': weight, 'own': overrides.get(symbol, {}).get('score'), 'description': text}
            for symbol, (group, weight, text) in sorted(known.items())
            if not wanted or wanted in symbol.lower() or wanted in text.lower()]
    return {'symbols': rows[:300], 'shown': min(len(rows), 300), 'found': len(rows), 'own_scores': len(overrides)}


def symbol_score_set(args):
    """An own score for one symbol, or back to the score of rspamd (--reset on). Checked by rspamd before it loads."""
    symbol = (args.symbol or '').strip().upper()
    if not SYMBOL_NAME_RE.match(symbol):
        raise EfaError('Symbol: the name as rspamd shows it, such as FORGED_SENDER.')
    overrides = _json_read(SYMBOL_SCORES_FILE, {})
    if (args.reset or '').strip() in ('yes', 'on'):
        if symbol not in overrides:
            raise EfaError(f'{symbol} has no own score.')
        before = overrides.pop(symbol)
    else:
        try:
            score = float((args.score or '').strip().replace(',', '.'))
        except ValueError:
            raise EfaError('Score: a number, such as 2.5 or -1.')
        if not SYMBOL_SCORE_RANGE[0] <= score <= SYMBOL_SCORE_RANGE[1]:
            raise EfaError(f'Score: from {SYMBOL_SCORE_RANGE[0]:g} to {SYMBOL_SCORE_RANGE[1]:g}.')
        try:
            known = _symbol_groups()
        except (OSError, ValueError, KeyError, TypeError) as err:
            raise EfaError(f'rspamd does not answer, nothing was changed: {err}')
        if symbol not in known:
            raise EfaError(f'rspamd does not know the symbol {symbol}.')
        before = overrides.get(symbol)
        overrides[symbol] = {'group': known[symbol][0], 'score': score, 'default': known[symbol][1]}
    old_conf = open(SYMBOL_GROUPS_CONF).read() if os.path.exists(SYMBOL_GROUPS_CONF) else None
    _write(SYMBOL_GROUPS_CONF, symbol_groups_conf(overrides))
    done = subprocess.run(['rspamadm', 'configtest'], capture_output=True, text=True, timeout=120)
    if done.returncode != 0:
        if old_conf is None:
            os.remove(SYMBOL_GROUPS_CONF)
        else:
            _write(SYMBOL_GROUPS_CONF, old_conf)
        raise EfaError(f'rspamd does not take it, nothing was changed: {(done.stdout + done.stderr)[-200:]}')
    _json_write(SYMBOL_SCORES_FILE, overrides)
    _reload_rspamd()
    _audit(f"symbol score {symbol}: {before['score'] if before else 'rspamd'} -> {overrides[symbol]['score'] if symbol in overrides else 'rspamd'} by {_dmarc_who()}")
    return {'symbol': symbol, 'score': overrides.get(symbol, {}).get('score', 'rspamd default'), 'own_scores': len(overrides)}


# 9n: "Check a mail": one uploaded mail through rspamd, only to show its verdict. Nothing is learned or kept; rspamd gets the
# flags no_log and no_stat. The mail comes base64 on stdin, never as an argument.
MAIL_CHECK_MAX = 10 * 1024 * 1024
MAIL_CHECK_URL = 'http://127.0.0.1:11333/checkv2'


def mail_check_domains(raw):
    """The domains of the senders and recipients named in the head of a mail."""
    head = email.message_from_bytes(raw.split(b'\r\n\r\n', 1)[0].split(b'\n\n', 1)[0] + b'\n\n', policy=email.policy.default)
    found = set()
    for name in ('From', 'Sender', 'To', 'Cc', 'Delivered-To'):
        for _real, address in email.utils.getaddresses([str(value) for value in head.get_all(name, [])]):
            if '@' in address:
                found.add(address.rpartition('@')[2].lower())
    return found


def mail_check(_args):
    """Scan one mail with rspamd and show the action, the score and each symbol with its meaning."""
    import base64 as b64
    data = sys.stdin.readline().strip()
    try:
        raw = b64.b64decode(data, validate=True)
    except ValueError:
        raise EfaError('Give the mail as an .eml file.')
    if not raw or len(raw) > MAIL_CHECK_MAX:
        raise EfaError(f'A mail of up to {MAIL_CHECK_MAX // 1024 // 1024} MB.')
    if identity_now and identity_now['domains'] is not None:
        # A domain admin checks only mail of the own domains.
        if not mail_check_domains(raw) & set(identity_now['domains']):
            raise EfaError('Not allowed: the mail names none of your domains.')
    request = urllib.request.Request(MAIL_CHECK_URL, data=raw, method='POST', headers={'Flags': 'no_log,no_stat', 'Content-Type': 'message/rfc822'})
    try:
        with urllib.request.urlopen(request, timeout=60) as answer:
            result = json.loads(answer.read())
    except (OSError, ValueError) as err:
        raise EfaError(f'rspamd does not answer: {err}')
    texts = _symbol_texts()
    symbols = sorted(result.get('symbols', {}).values(), key=lambda item: -abs(item.get('score', 0)))
    _audit(f"mail-check by {_dmarc_who()}: {result.get('action')} {result.get('score', 0):.2f} ({len(raw)} bytes)")
    return {'action': result.get('action'), 'score': round(result.get('score', 0), 2), 'required_score': result.get('required_score'),
            'symbols': [{'symbol': item['name'], 'score': round(item.get('score', 0), 2), 'text': texts.get(item['name']) or '',
                         'text_de': SYMBOL_DE.get(item['name'], ''), 'options': ', '.join(item.get('options', []))[:200]} for item in symbols]}


def mail_verdict(symbols, texts):
    """Why a mail got its score: each symbol with its score and one sentence, in English and German where known."""
    try:
        pairs = json.loads(symbols or '[]')
    except ValueError:
        return []
    return [{'symbol': name, 'score': score, 'text': texts.get(name) or '', 'text_de': SYMBOL_DE.get(name, '')} for name, score in pairs]


def _verdict_by_qid(qid):
    if not qid:
        return []
    db = _maillog_db()
    try:
        with db.cursor() as cur:
            cur.execute('SELECT symbols FROM maillog WHERE qid = %s ORDER BY id DESC LIMIT 1', (qid,))
            row = cur.fetchone()
    finally:
        db.close()
    return mail_verdict(row['symbols'], _symbol_texts()) if row else []


def mail_show(args):
    """One mail of the log with its stored headers: raw, the path over the servers, the checks. The content of delivered mail is not stored."""
    mail_id = (args.id or '').strip()
    if not mail_id.isdigit():
        raise EfaError('Mail: its number in the log.')
    db = _maillog_db()
    try:
        with db.cursor() as cur:
            cur.execute('SELECT id, CAST(ts AS CHAR) AS ts, qid, message_id, sender, rcpt, ip, action, score, subject, spf, dkim, dmarc, arc, '
                        'header_from, reply_to, return_path, x_mailer, symbols FROM maillog WHERE id = %s', (int(mail_id),))
            mail = cur.fetchone()
    finally:
        db.close()
    if not mail or (identity_now and identity_now['domains'] is not None and not in_scope(identity_now, [mail['rcpt'] or '', mail['sender'] or ''])):
        raise EfaError('No such mail.')
    mail = local_times(subject_filter(identity_now, 'message-search', {'mails': [mail]}, subjects_shown())['mails'], _reader_timezone())[0]
    rows = _admin_query('SELECT raw_size, truncated, data FROM mail_headers WHERE maillog_id = %s', (int(mail_id),))
    raw = zlib.decompress(rows[0]['data']).decode('utf-8', 'replace') if rows else None
    if (args.format or '').strip() == 'raw':
        if identity_now and 'export' not in identity_now['grants']:
            raise EfaError('Not allowed: the download needs the permission export.')
        if raw is None:
            raise EfaError('No headers stored for this mail.')
        key = mail['qid'] if re.fullmatch(r'[A-Za-z0-9]{5,20}', mail['qid'] or '') else hashlib.sha256((mail['message_id'] or mail_id).encode()).hexdigest()[:16]
        return {'raw': raw, 'filename': f"{mail['ts'][:10]}_{key}.headers.txt"}
    proof = _admin_query('SELECT data FROM mail_evidence WHERE maillog_id = %s', (int(mail_id),))
    evidence = json.loads(zlib.decompress(proof[0]['data'])) if proof else None
    if evidence:
        keys = sorted({check['record'] for check in evidence['checks']})
        found = {row['sha256']: json.loads(zlib.decompress(row['data'])) for row in
                 (_admin_query('SELECT sha256, data FROM dns_records WHERE sha256 IN (' + ','.join(['%s'] * len(keys)) + ')', keys) if keys else [])}
        for check in evidence['checks']:
            check['answers'] = found.get(check['record'], [])
    if (args.format or '').strip() == 'evidence':
        if identity_now and 'export' not in identity_now['grants']:
            raise EfaError('Not allowed: the download needs the permission export.')
        if not evidence:
            raise EfaError('No DNS evidence stored for this mail.')
        return {'evidence': evidence, 'filename': f"{mail['ts'][:10]}_{mail_id}.evidence.json"}
    headers = headers_parse(raw or '')
    verdict = mail_verdict(mail.pop('symbols', None), _symbol_texts())
    return {'mail': mail, 'verdict': verdict, 'headers': raw, 'evidence': evidence, 'headers_note': 'No headers stored for this mail.' if raw is None else
            (f"Cut at {HEADERS_MAX // 1024} KB of {rows[0]['raw_size']} bytes." if rows[0]['truncated'] else ''),
            'received': received_path(headers), 'checks': [{'name': name, 'value': value} for name, value in headers if name.lower() in AUTH_HEADERS],
            'spam': [{'name': name, 'value': value} for name, value in headers if name.lower().startswith(('x-spam', 'x-rspamd'))],
            'content': 'Content not stored: eFa stores the content only of mail in quarantine.'}


# Web exports: readable by the web interface that hands them out, deleted after a day.
EXPORT_DIR = '/var/lib/efa-exports'
EXPORT_LIMIT = 50000
EXPORT_NOW = 5000
EXPORT_HOURS = 24
SEARCH_FILTERS = ('sender', 'rcpt', 'subject', 'ip', 'qid', 'action', 'date_from', 'date_to', 'message_id', 'header_from', 'reply_to', 'return_path', 'x_mailer')


def export_name(ts, qid, message_id, mail_id):
    """A file name from the time and the queue ID, never from text a sender chose beyond plain characters."""
    key = qid if re.fullmatch(r'[A-Za-z0-9]{5,20}', qid or '') else hashlib.sha256((message_id or str(mail_id)).encode()).hexdigest()[:16]
    return f"{re.sub(r'[^0-9]', '', str(ts))[:14]}_{key}"


def headers_zip(path, rows, fetch_headers, fetch_evidence, with_subject):
    """One file per mail and index.csv, written mail by mail: the mails are never all in memory."""
    index = [['file', 'time', 'from', 'to', 'subject', 'result', 'queue_id', 'message_id']]
    seen = set()
    with zipfile.ZipFile(path, 'w', zipfile.ZIP_DEFLATED) as archive:
        for row in rows:
            raw = fetch_headers(row['id'])
            if raw is None:
                continue
            name = export_name(row['ts'], row['qid'], row['message_id'], row['id'])
            while name in seen:
                name += '_'
            seen.add(name)
            archive.writestr(f'{name}.headers.txt', raw)
            evidence = fetch_evidence(row['id']) if fetch_evidence else None
            if evidence is not None:
                archive.writestr(f'{name}.evidence.json', json.dumps(evidence, indent=1))
            index.append([f'{name}.headers.txt', row['ts'], row['sender'], row['rcpt'], row['subject'] if with_subject else '', row['action'], row['qid'], row['message_id']])
        archive.writestr('index.csv', csv_safe_text(index))
    return len(index) - 1


def _stored_headers(mail_id):
    rows = _admin_query('SELECT data FROM mail_headers WHERE maillog_id = %s', (mail_id,))
    return zlib.decompress(rows[0]['data']) if rows else None


def _stored_evidence(mail_id):
    return mail_show(argparse.Namespace(id=str(mail_id), format=''))['evidence']


def headers_export(args):
    """The stored headers of the mails a search finds, as a ZIP with one file per mail and index.csv, optionally with the DNS evidence."""
    if identity_now and 'export' not in identity_now['grants']:
        raise EfaError('Not allowed: the export needs the permission export.')
    filters = {key: getattr(args, key, '') or '' for key in SEARCH_FILTERS}
    where, params = search_where(filters, identity_now['domains'] if identity_now else None)
    joined = (where + ' AND ' if where else 'WHERE ') + 'EXISTS (SELECT 1 FROM mail_headers h WHERE h.maillog_id = maillog.id)'
    job = (args.job or '').strip()
    if job and os.environ.get('EFA_EXPORT_JOB') != job:
        # Only the background run started here names its job: nobody can aim an export at the file of another.
        raise EfaError('Invalid job.')
    db = _maillog_db()
    try:
        with db.cursor() as cur:
            cur.execute(f'SELECT COUNT(*) AS n FROM maillog {joined}', params)
            count = int(cur.fetchone()['n'])
            if count > EXPORT_LIMIT:
                raise EfaError(f'{count} mails: at most {EXPORT_LIMIT} per export. Narrow the search, for example by date.')
            if count > EXPORT_NOW and not job:
                token = secrets.token_hex(16)
                command = ['systemd-run', '--unit', f'efa-export-{token[:8]}', '--collect', f'--setenv=EFA_EXPORT_JOB={token}', '/usr/sbin/efactl', '--client', acting_client,
                           *(['--as', identity_now['username']] if identity_now else []), 'headers-export', f'--job={token}',
                           f"--evidence={(args.evidence or '').strip()}", *[f'--{key}={value}' for key, value in filters.items() if value]]
                subprocess.run(command, check=True, capture_output=True)
                return {'count': count, 'state': 'running', 'job': token, 'note': 'The download link works once the export is done, for 24 hours.'}
            cur.execute(f'SELECT id, CAST(ts AS CHAR) AS ts, qid, message_id, sender, rcpt, subject, action FROM maillog {joined} ORDER BY ts, id', params)
            rows = cur.fetchall()
    finally:
        db.close()
    rows = scoped_result(identity_now, 'message-search', {'mails': rows})['mails']
    with_subject = subjects_shown() and (identity_now is None or 'mail.view_subject' in identity_now['grants'])
    out = (args.out or '').strip() if not identity_now else ''
    token = job or secrets.token_hex(16)
    if not re.fullmatch(r'[0-9a-f]{32}', token):
        raise EfaError('Invalid job.')
    if out:
        target = os.path.realpath(out)
        if not target.startswith('/var/lib/eFa/exports/') or not target.endswith('.zip'):
            raise EfaError('Write the ZIP to /var/lib/eFa/exports/<name>.zip.')
        os.makedirs('/var/lib/eFa/exports', mode=0o700, exist_ok=True)
    else:
        os.makedirs(EXPORT_DIR, mode=0o750, exist_ok=True)
        shutil.chown(EXPORT_DIR, 'root', 'efa-web')
        target = f'{EXPORT_DIR}/{token}.zip'
    fd = os.open(target + '.tmp', os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    os.close(fd)
    written = headers_zip(target + '.tmp', rows, _stored_headers, _stored_evidence if (args.evidence or '').strip() == 'yes' else None, with_subject)
    if not out:
        os.chmod(target + '.tmp', 0o640)
        shutil.chown(target + '.tmp', 'root', 'efa-web')
        _json_write(f'{EXPORT_DIR}/{token}.json', {'user': identity_now['username'] if identity_now else '', 'count': written, 'created': time.time()})
        os.chmod(f'{EXPORT_DIR}/{token}.json', 0o640)
        shutil.chown(f'{EXPORT_DIR}/{token}.json', 'root', 'efa-web')
    os.replace(target + '.tmp', target)
    return {'count': written, 'state': 'done', **({'file': target} if out else {'job': token})}


def _exports_job():
    """Hourly: web exports older than a day go."""
    for path in glob.glob(EXPORT_DIR + '/*'):
        if os.path.getmtime(path) < time.time() - EXPORT_HOURS * 3600:
            os.remove(path)


def _layer_rows():
    rows = {}
    try:
        found = _admin_query('SELECT level, target, name, value FROM scoped_settings')
    except Exception as err:  # pymysql errors have no common base here
        if getattr(err, 'args', (None,))[0] == 1146:
            return rows  # before the upgrade made the table: nothing set yet
        raise
    for row in found:
        rows.setdefault((row['level'], row['target']), {})[row['name']] = row['value']
    return rows


def _layer_defaults():
    actions, quarantine = _actions(), uq_state()
    return {'spam_mark': actions.get('rewrite_subject', ''), 'spam_reject': actions.get('reject', ''), 'quarantine_days': str(quarantine['days']),
            'digest_hour': '0', 'digest_text': '', 'tls': _postconf('smtp_tls_security_level') or 'may', 'language': 'en',
            'headers_store': 'on' if headers_policy()['store'] else 'off', 'headers_days': str(headers_policy()['days'])}


def _layer_target(args):
    """('domain', name, tenant id) or ('tenant', id, id). A limited scope reaches only its own domains and tenants."""
    domain, tenant = (getattr(args, 'domain', '') or '').strip().lower(), (getattr(args, 'tenant', '') or '').strip()
    if bool(domain) == bool(tenant):
        raise EfaError('Name either a domain or a tenant.')
    tenant_domains = _tenant_domains()
    if domain:
        if not DOMAIN_RE.match(domain):
            raise EfaError('Invalid domain.')
        if identity_now and identity_now['domains'] is not None and domain not in identity_now['domains']:
            raise EfaError('Not allowed: name one of your own domains.')
        return 'domain', domain, next((tid for tid, domains in tenant_domains.items() if domain in domains), None)
    tenant_id = _tenant_id(tenant)
    if identity_now and identity_now['tenant_ids'] is not None and tenant_id not in identity_now['tenant_ids']:
        raise EfaError('Not allowed: this tenant is outside your scope.')
    return 'tenant', str(tenant_id), tenant_id


def domain_settings_show(args):
    """The settings of a domain or a tenant, each with where it comes from: domain, tenant or global."""
    level, target, tenant_id = _layer_target(args)
    values = layer_effective(target if level == 'domain' else None, tenant_id, _layer_rows(), _layer_defaults())
    return {level: args.domain.strip().lower() if level == 'domain' else args.tenant.strip(),
            'settings': [{'name': name, 'value': value, 'source': source, 'permission': LAYER_SETTINGS[name]} for name, (value, source) in values.items()],
            **({'mail_server': next((line.split(None, 1)[1] for line in _read_lines(TRANSPORT) if line.split()[:1] == [target]), 'global route')}
               if level == 'domain' else {})}


def _layers_apply():
    """Spam limits as rspamd rules, TLS as a Postfix map. Retention and digest are read by the hourly job."""
    _rules_apply()
    rows = _layer_rows()
    lines = layer_tls_lines(rows, _tenant_domains()) if rows else []
    if lines != _read_lines(TLS_POLICY):
        _rule_map(TLS_POLICY, lines)
        wanted = rule_map_value(_postconf('smtp_tls_policy_maps'), TLS_POLICY, bool(lines))
        if wanted != _postconf('smtp_tls_policy_maps'):
            _postconf_set('smtp_tls_policy_maps', wanted)
        subprocess.run(['systemctl', 'reload', 'postfix'], check=False, capture_output=True)


def _layer_set(args, names):
    """Each given value is set; 'inherit' takes the own value away, so the tenant or global one counts again."""
    level, target, _tenant = _layer_target(args)
    changed = False
    for name in names:
        value = getattr(args, name, '') or ''
        if not value.strip():
            continue
        if value.strip() == 'inherit':
            _admin_query('DELETE FROM scoped_settings WHERE level = %s AND target = %s AND name = %s', (level, target, name))
        else:
            _admin_query('REPLACE INTO scoped_settings (level, target, name, value, changed_by) VALUES (%s, %s, %s, %s, %s)',
                         (level, target, name, layer_value(name, value), _dmarc_who()[:120]))
        changed = True
    if not changed:
        raise EfaError("Give at least one value, or 'inherit' to take the value of the tenant or global again.")
    _layers_apply()
    return domain_settings_show(args)


def domain_spam_set(args):
    """Spam limits of a domain or tenant: mark as spam, reject. Below the rules of the admins."""
    return _layer_set(args, ('spam_mark', 'spam_reject'))


def domain_quarantine_set(args):
    """How long held mail stays, and when and with which text the digest goes out."""
    return _layer_set(args, ('quarantine_days', 'digest_hour', 'digest_text'))


def domain_routing_set(args):
    """TLS for mail to the domain. The mail server of a domain is set with transport-set."""
    return _layer_set(args, ('tls',))


def domain_general_set(args):
    """The language of digests and pages for the domain, and whether and how long the headers of its mail are kept."""
    return _layer_set(args, ('language', 'headers_store', 'headers_days'))


def _rules_apply():
    """Writes the rules to rspamd and Postfix if they changed. A config rspamd rejects is taken back."""
    layer_rows = _layer_rows()
    rules = _rules() + (layer_spam_rules(layer_rows, _tenant_domains()) if layer_rows else [])
    text = rule_settings_text(rules, _rule_tenant_domains, _rule_group_members)
    previous = open(RULES_SETTINGS).read() if os.path.exists(RULES_SETTINGS) else ''
    if previous and not previous.startswith(RULES_MARK):
        raise EfaError(f'{RULES_SETTINGS} was not written by eFa, nothing changed.')
    if text != previous:
        if text:
            _write(RULES_SETTINGS, text)
        elif previous:
            os.remove(RULES_SETTINGS)
        if not _rspamd_config_ok():
            if previous:
                _write(RULES_SETTINGS, previous)
            elif os.path.exists(RULES_SETTINGS):
                os.remove(RULES_SETTINGS)
            raise EfaError('rspamd rejected the rules, nothing changed.')
        subprocess.run(['systemctl', 'try-reload-or-restart', 'rspamd'], check=False, capture_output=True)
    notify_write(_rules())
    to_recipient, to_sender = rule_route_lines(rules, _rule_tenant_domains, _rule_group_members)
    held = _admin_query("SELECT d.domain FROM tenant_domains d JOIN tenants t ON t.id = d.tenant_id WHERE t.locked = 1 AND t.lock_mail = 'defer' ORDER BY d.domain") \
        if os.path.exists(RULES_FILE) or layer_rows or _admin_query("SELECT 1 FROM tenants WHERE locked = 1 LIMIT 1") else []
    if held:
        # A locked tenant whose mail waits: its domains first, with no other route for them.
        gone = {row['domain'] for row in held}
        to_recipient = tenant_hold_lines(held) + [line for line in to_recipient if line.split()[0] not in gone]
    old = [_read_lines(path) for path in (RULES_TRANSPORT, RULES_SENDER_RELAY)]
    if [to_recipient, to_sender] != old:
        _rule_map(RULES_TRANSPORT, to_recipient)
        _rule_map(RULES_SENDER_RELAY, to_sender)
        for parameter, path, lines in (('transport_maps', RULES_TRANSPORT, to_recipient), ('sender_dependent_relayhost_maps', RULES_SENDER_RELAY, to_sender)):
            wanted = rule_map_value(_postconf(parameter), path, bool(lines))
            if wanted != _postconf(parameter):
                _postconf_set(parameter, wanted)
        subprocess.run(['systemctl', 'reload', 'postfix'], check=False, capture_output=True)


def notify_rules(rules, show_subject):
    """The rules with notify, for efa-maillog: the senders as address or @domain, and the addresses to tell."""
    found = [{'name': rule['name'], 'senders': rule_targets(rule, None, None), 'notify': rule['notify']}
             for rule in rules if rule.get('enabled', True) and rule.get('notify') and rule['kind'] in RULE_FROM_SENDER]
    return {'rules': found, 'subject': show_subject}


def notify_write(rules):
    wanted = notify_rules(rules, subjects_shown())
    if not wanted['rules']:
        if os.path.exists(NOTIFY_FILE):
            os.remove(NOTIFY_FILE)
        return
    if _json_read(NOTIFY_FILE, None) != wanted:
        _json_write(NOTIFY_FILE, wanted)
        os.chmod(NOTIFY_FILE, 0o640)
        shutil.chown(NOTIFY_FILE, 'root', 'efa-web')


def rule_check(rule):
    """Checks one rule. Values end up in rspamd and Postfix settings, so they pass here first."""
    if not re.fullmatch(r'[a-z0-9][a-z0-9-]{0,39}', rule['name']):
        raise EfaError('Name: up to 40 small letters, digits or dashes.')
    value = rule['value']
    if rule['kind'] not in RULE_KINDS:
        raise EfaError('Kind must be one of: ' + ', '.join(RULE_KINDS))
    if rule['kind'] in ('sender', 'recipient') and not SENDER_RE.match(value):
        raise EfaError('This kind needs an email address.')
    if rule['kind'] in ('sender_domain', 'domain') and not DOMAIN_RE.match(value):
        raise EfaError('This kind needs a domain.')
    if rule['kind'] in ('tenant', 'group') and (not value or any(ch in value for ch in '\r\n\0"')):
        raise EfaError('This kind needs a tenant name or a group DN.')
    for key in ('reject', 'add_header', 'greylist'):
        if rule[key] != '':
            try:
                score = float(rule[key])
            except ValueError:
                raise EfaError('Scores must be numbers.')
            if not -100 <= score <= 1000:
                raise EfaError('Scores must be from -100 to 1000.')
    if not re.fullmatch(r'\d{1,4}', str(rule['priority'])):
        raise EfaError('Priority must be a number up to 9999.')
    if rule['route'] and not RULE_ROUTE_RE.match(rule['route']):
        raise EfaError('Route: host or IP address, optionally with :port.')
    if rule['route'] and rule['kind'] == 'group':
        raise EfaError('A group cannot have a route.')
    notify = rule.get('notify') or []
    if notify and (rule['kind'] not in RULE_FROM_SENDER or len(notify) > 10 or not all(SENDER_RE.match(address) for address in notify)):
        raise EfaError('Notify: up to 10 addresses, and only for a rule on a sender or a sender domain.')
    if not any((rule['reject'], rule['add_header'], rule['greylist'], rule['quarantine'], rule['route'], notify, rule.get('spam_off'),
                rule.get('allow_encrypted'))):
        raise EfaError('A rule needs a score, quarantine, a route, addresses to notify, spam filter off or encrypted archives allowed.')


def rule_list(_args):
    """Rules: other spam limits, quarantine instead of rejecting, or another route. The highest priority that fits wins."""
    return {'rules': sorted(_rules(), key=lambda r: -int(r['priority']))}


def rule_set(args):
    """Add, change or remove a rule. A rule looks at the whole mail: with several recipients, it applies if one of them fits."""
    name, action = args.name.strip().lower(), args.action.strip()
    rules = [rule for rule in _rules() if rule['name'] != name]
    if action == 'set':
        rule = {'name': name, 'kind': args.kind.strip(), 'value': args.value.strip().lower() if args.kind.strip() in RULE_KINDS[:4] else args.value.strip(),
                'priority': (args.priority or '').strip() or '10', 'reject': (args.reject or '').strip(), 'add_header': (args.add_header or '').strip(),
                'greylist': (args.greylist or '').strip(), 'quarantine': (args.quarantine or '').strip() == 'on', 'route': (args.route or '').strip(), 'enabled': True,
                'notify': sorted({item.strip().lower() for item in (getattr(args, 'notify', '') or '').replace(',', ' ').split()}),
                'spam_off': (getattr(args, 'spam_off', '') or '').strip() == 'on', 'allow_encrypted': (getattr(args, 'allow_encrypted', '') or '').strip() == 'on',
                # Rules efa-migrate made from rules of eFa 5 that weaken the filter: on, and on the dashboard until checked.
                'review': (getattr(args, 'review', '') or '').strip() or ''}
        rule_check(rule)
        rules.append(rule)
    elif action != 'remove':
        raise EfaError("Action must be 'set' or 'remove'.")
    previous = _rules()
    _json_write(RULES_FILE, {'rules': rules})
    try:
        _rules_apply()
    except (EfaError, OSError, subprocess.CalledProcessError):
        _json_write(RULES_FILE, {'rules': previous})
        raise
    return rule_list(None)


def uq_state():
    return {**UQ_DEFAULTS, **_json_read(UQ_FILE, {})}


def uq_status(_args):
    """The quarantine for users. Off by default: mail is then rejected as before."""
    state = uq_state()
    rows = _admin_query("SELECT COUNT(*) AS n, COALESCE(SUM(m.size), 0) AS size FROM quarantine_mail m WHERE EXISTS "
                        "(SELECT 1 FROM quarantine_rcpt r WHERE r.mail_id = m.id AND r.state IN ('held', 'requested'))")
    return {**state, 'held': rows[0]['n'], 'held_mb': round(float(rows[0]['size']) / 1048576, 1)}


# Attachments: rspamd finds the real type and looks into archives; eFa sets the dangerous endings and how strict it is.
ATTACH_FILE = ETC + '/eFa/attachments.json'
ATTACH_TYPES_CONF = RSPAMD_DIR + '/local.d/mime_types.conf'
ATTACH_GROUP_CONF = RSPAMD_DIR + '/local.d/mime_types_group.conf'
ATTACH_LUA = RSPAMD_DIR + '/efa-attachments.lua'
ATTACH_LOAD_LINE = ("do local ok, err = pcall(dofile, '" + ATTACH_LUA + "'); if not ok then require('rspamd_logger').errx(rspamd_config, 'efa-attachments: %s', err) end end "
                    "-- efa-attachments\n")
ATTACH_DANGEROUS = ('ade', 'adp', 'app', 'application', 'bat', 'chm', 'cmd', 'com', 'cpl', 'gadget', 'hta', 'img', 'inf', 'ins', 'iso', 'jar', 'js', 'jse',
                    'lnk', 'msc', 'msi', 'msp', 'mst', 'pif', 'ps1', 'psc1', 'reg', 'scf', 'scr', 'sct', 'shb', 'url', 'vb', 'vbe', 'vbs', 'vhd', 'vhdx',
                    'ws', 'wsc', 'wsf', 'wsh', 'xll', 'exe')
# names: file names that hide what they are (over 150 characters, a CLSID {...}, 10 or more spaces), also inside archives;
# executables: a program by its content (MZ: Windows and self-extracting archives, ELF), whatever its name. Both as eFa 5 had them.
ATTACH_DEFAULTS = {'enabled': False, 'extensions': list(ATTACH_DANGEROUS), 'action': 'reject', 'encrypted': 'mark', 'macros': 'mark',
                   'names': 'off', 'executables': 'off'}
# What reject and mark mean as scores: reject lies above the reject limit, mark at the spam mark.
ATTACH_SCORES = {'reject': 16.0, 'mark': 6.0, 'off': 0.0}
ATTACH_LUA_TEXT = r'''-- Written by efactl attachment-set. Do not edit.
-- Office files with macros: legacy OLE files name their _VBA_PROJECT stream in UTF-16, OOXML files hold a vbaProject.bin,
-- whose name stands uncompressed in the zip. Large parts are skipped: the scan stays cheap.
local MAX = 20 * 1024 * 1024
local OLE = '_\0V\0B\0A\0_\0P\0R\0O\0J\0E\0C\0T\0'
rspamd_config:register_symbol({name = 'EFA_MACRO', score = %(score)s, group = 'efa_attachments',
  description = 'An Office attachment with macros', callback = function(task)
  for _, part in ipairs(task:get_parts() or {}) do
    local name = part:get_filename()
    if name or part:is_attachment() then
      local content = part:get_content()
      if content and #content > 0 and #content < MAX then
        local text = tostring(content)
        if text:find(OLE, 1, true) or text:find('vbaProject.bin', 1, true) then
          return true, 1.0, name or 'attachment'
        end
      end
    end
  end
end})
local function hiding(name)
  return #name > 150 or name:find('{[%%x%%-]+}') and #name:match('{([%%x%%-]+)}') >= 25 or name:find('%%s%%s%%s%%s%%s%%s%%s%%s%%s%%s')
end
rspamd_config:register_symbol({name = 'EFA_BAD_FILENAME', score = %(names)s, group = 'efa_attachments',
  description = 'A file name that hides what the file is', callback = function(task)
  for _, part in ipairs(task:get_parts() or {}) do
    local name = part:get_filename()
    if name and hiding(name) then
      return true, 1.0, name:sub(1, 60)
    end
    if part:is_archive() then
      local ok, files = pcall(function() return part:get_archive():get_files() end)
      for _, inner in ipairs(ok and files or {}) do
        if type(inner) == 'string' and hiding(inner) then
          return true, 1.0, inner:sub(1, 60)
        end
      end
    end
  end
end})
rspamd_config:register_symbol({name = 'EFA_EXECUTABLE', score = %(executables)s, group = 'efa_attachments',
  description = 'An attachment that is a program (Windows, self-extracting, ELF)', callback = function(task)
  for _, part in ipairs(task:get_parts() or {}) do
    if part:get_filename() or part:is_attachment() then
      local content = part:get_content()
      if content and #content > 3 then
        local head = content:sub(1, 4)
        if head:sub(1, 2) == 'MZ' or head == '\127ELF' then
          return true, 1.0, part:get_filename() or 'attachment'
        end
      end
    end
  end
end})
'''


def attach_state():
    return {**ATTACH_DEFAULTS, **_json_read(ATTACH_FILE, {})}


def attach_texts(state):
    """The rspamd settings: the endings, also inside archives, and the weights of the symbols for the chosen strictness."""
    endings = ' '.join(f'{ext} = 4;' for ext in sorted(state['extensions']))
    types = f'bad_extensions {{ {endings} }}\nbad_archive_extensions {{ {endings} }}\n'
    # MIME_BAD_EXTENSION counts its weight times the factor of the ending (4): a quarter of the score reaches it.
    bad = ATTACH_SCORES[state['action']] / 4
    # The group of rspamd caps its symbols at 10: reject has to get above the reject limit.
    group = ('max_score = 30;\nsymbols {\n' + f'  "MIME_BAD_EXTENSION" {{ weight = {bad}; }}\n  "MIME_DOUBLE_BAD_EXTENSION" {{ weight = {ATTACH_SCORES[state["action"]]}; }}\n'
             f'  "MIME_ENCRYPTED_ARCHIVE" {{ weight = {ATTACH_SCORES[state["encrypted"]]}; }}\n}}\n')
    return types, group, ATTACH_LUA_TEXT % {'score': ATTACH_SCORES[state['macros']], 'names': ATTACH_SCORES[state.get('names', 'off')],
                                            'executables': ATTACH_SCORES[state.get('executables', 'off')]}


def attachment_status(_args):
    """How attachments are checked: the endings, also inside archives, encrypted archives and Office macros."""
    return attach_state()


def attachment_set(args):
    """Dangerous endings reject or mark the mail, encrypted archives and Office macros too. rspamd finds the real type of a file."""
    state = attach_state()
    state['enabled'] = _on_off(args.mode)
    for key in ('action', 'encrypted', 'macros', 'names', 'executables'):
        value = (getattr(args, key, '') or '').strip()
        if value:
            if value not in ATTACH_SCORES or (key == 'action' and value == 'off'):
                raise EfaError(f'{key}: reject, mark' + (' or off.' if key != 'action' else '.'))
            state[key] = value
    for field, change in (('add', set.union), ('remove', set.difference)):
        items = {item.strip().lower().lstrip('.') for item in (getattr(args, field, '') or '').replace(',', ' ').split()}
        if any(not re.fullmatch(r'[a-z0-9]{1,12}', item) for item in items):
            raise EfaError('Endings: letters and digits, such as exe or js.')
        state['extensions'] = sorted(change(set(state['extensions']), items))
    files = (ATTACH_TYPES_CONF, ATTACH_GROUP_CONF, ATTACH_LUA, RSPAMD_LOCAL_LUA)
    old = [open(path).read() if os.path.exists(path) else None for path in files]
    lua_local = re.sub(r'^.*-- efa-attachments\n', '', old[3] or '', flags=re.M)
    if state['enabled']:
        types, group, lua = attach_texts(state)
        _write(ATTACH_TYPES_CONF, types)
        _write(ATTACH_GROUP_CONF, group)
        _write(ATTACH_LUA, lua)
        lua_local = lua_local.rstrip('\n') + '\n' + ATTACH_LOAD_LINE
    else:
        for path in (ATTACH_TYPES_CONF, ATTACH_GROUP_CONF):
            if os.path.exists(path):
                os.remove(path)
    _write(RSPAMD_LOCAL_LUA, lua_local)
    if not _rspamd_config_ok():
        for path, text in zip(files, old):
            if text is None:
                if os.path.exists(path):
                    os.remove(path)
            else:
                _write(path, text)
        raise EfaError('rspamd rejected the settings, nothing changed.')
    _json_write(ATTACH_FILE, state)
    _reload_rspamd()
    return state


# Content disarm: its own milter after rspamd, off by default; qpdf is installed only when it is switched on.
CDR_PORT = 8907
RSPAMD_MILTER = REQUIRED_MILTERS[0]
CDR_STORE = '/var/lib/efa-cdr'
CDR_UNIT = 'efa-cdr'
CDR_KEEP_DAYS = 30
CDR_KEY_RE = re.compile(r'^\d{14}-[0-9a-f]{12}$')
# Both features of the content milter; root:efa-web 0640, it holds the key of the link signatures.
CONTENT_FILE = ETC + '/efa-web/content.json'
LINKS_DEFAULTS = {'enabled': False, 'base': '', 'continue': True, 'exceptions': [], 'unchecked': 'page'}
LINK_UNCHECKED = ('page', 'follow', 'block')


def cdr_chain(chain, on):
    """The milter ports with the disarm milter right after rspamd, or without it."""
    ports = [port for port in chain if port != CDR_PORT]
    if on:
        ports.insert(ports.index(RSPAMD_MILTER) + 1 if RSPAMD_MILTER in ports else 0, CDR_PORT)
    return ports


def _milter_ports_now():
    return milter_ports_of(_postconf('smtpd_milters'))


def milter_ports_of(value):
    """The ports of inet:host:port milters, not the numbers of the address."""
    return [int(port) for port in re.findall(r'inet:[^:,\s]+:(\d+)', value)]


def content_state():
    state = _json_read(CONTENT_FILE, {})
    return {'cdr': bool(state.get('cdr')), 'links': {**LINKS_DEFAULTS, **state.get('links', {})},
            'banner': {**BANNER_DEFAULTS, **state.get('banner', {})}}


def cdr_status(_args):
    """Content disarm: on or off, qpdf, and the originals kept for the admin."""
    platform_now = _platform()
    kept = sorted(glob.glob(CDR_STORE + '/*.json'))
    return {'enabled': content_state()['cdr'], 'milter_in_chain': CDR_PORT in _milter_ports_now(), 'service': platform_now.service_is_active(CDR_UNIT),
            'qpdf': platform_now.package_installed('qpdf'), 'originals': len(kept), 'keep_days': retention('cdr')}


def _content_apply(state):
    """The settings for the milter; it runs and sits after rspamd while one of its features is on."""
    _write(CONTENT_FILE, json.dumps(state, indent=1))
    os.chmod(CONTENT_FILE, 0o640)
    shutil.chown(CONTENT_FILE, 'root', 'efa-web')
    on = state['cdr'] or state['links']['enabled'] or state.get('banner', {}).get('enabled')
    platform_now = _platform()
    try:
        if on:
            platform_now.service_enable(CDR_UNIT, start=True)
            for _ in range(20):
                if _port_listening(CDR_PORT):
                    break
                time.sleep(0.5)
            else:
                raise EfaError('The content milter does not answer, nothing changed in the mail flow.')
        chain = cdr_chain(_milter_ports_now(), on)
        if chain != _milter_ports_now():
            milter_chain_set(argparse.Namespace(ports=' '.join(map(str, chain))))
            subprocess.run(['postfix', 'reload'], check=False, capture_output=True)
        if not on:
            platform_now.service_disable(CDR_UNIT, stop=True)
    except EfaError:
        raise
    except Exception as err:  # the StepError of the platform layer
        raise EfaError(str(err))


# Outgoing mail: disclaimers and data loss prevention in their own milter before rspamd, so the text is signed with the mail.
OUTBOUND_FILE = ETC + '/eFa/outbound.json'
OUTBOUND_PORT = 8908
OUTBOUND_UNIT = 'efa-outbound'
DLP_ACTIONS = ('off', 'log', 'encrypt', 'hold', 'reject')
DLP_DEFAULTS = {'cards': 'off', 'iban': 'off', 'ids': 'off', 'ignore': [], 'rules': []}
# The agreed passwords of the PDF encryption: root only, systemd hands them to the milter (LoadCredential).
PDF_PASSWORDS = ETC + '/eFa/pdf-passwords.json'
PDF_KEYWORD_RE = re.compile(r'^[^\s<>"]{3,30}$')
DLP_NAME_RE = re.compile(r'^[a-z0-9][a-z0-9_-]{0,31}$')
IBAN_RE = re.compile(r'^[A-Z]{2}\d{2}[A-Z0-9]{11,30}$')


def outbound_chain(chain, on):
    """The milter ports with the outbound milter right before rspamd, or without it."""
    ports = [port for port in chain if port != OUTBOUND_PORT]
    if on:
        ports.insert(ports.index(RSPAMD_MILTER) if RSPAMD_MILTER in ports else 0, OUTBOUND_PORT)
    return ports


def _outbound_on(state):
    dlp = state.get('dlp', {})
    return bool(state.get('domains')) or bool(state.get('disclaimers')) or any(dlp.get(key, 'off') != 'off' for key in ('cards', 'iban', 'ids')) or \
        any(rule['action'] != 'off' for rule in dlp.get('rules', [])) or bool(state.get('pdf', {}).get('keyword')) or \
        state.get('limits', {}).get('action', 'off') != 'off' or bool(state.get('bulk', {}).get('enabled'))


def _local_domains():
    return sorted({line.split()[0].lower() for line in _read_lines(TRANSPORT) if line.split() and DOMAIN_RE.match(line.split()[0].lower())})


def _outbound_networks():
    # The milter reads plain networks only: without the brackets of IPv6 and without lookup tables.
    return ['127.0.0.0/8', '::1/128'] + _relay_active()[0]


def _outbound_write(state):
    """Writes the settings and puts the milter into the mail flow, or takes it out when nothing is left for it."""
    state['networks'] = _outbound_networks()
    state['admin'] = _admin_email()
    state['local_domains'] = _local_domains()
    _disclaimer_lookups(state)
    _write(OUTBOUND_FILE, json.dumps(state, indent=1))
    os.chmod(OUTBOUND_FILE, 0o644)
    if not os.path.exists(PDF_PASSWORDS):
        _pdf_passwords_write({})  # the unit loads it, it has to exist
    on = _outbound_on(state)
    platform_now = _platform()
    try:
        if on:
            platform_now.service_enable(OUTBOUND_UNIT, start=True)
            for _ in range(20):
                if _port_listening(OUTBOUND_PORT):
                    break
                time.sleep(0.5)
            else:
                raise EfaError('The outbound milter does not answer, nothing changed in the mail flow.')
        chain = outbound_chain(_milter_ports_now(), on)
        if chain != _milter_ports_now():
            milter_chain_set(argparse.Namespace(ports=' '.join(map(str, chain))))
        _outbound_strict_apply(state)
        subprocess.run(['postfix', 'reload'], check=False, capture_output=True)
        if not on:
            platform_now.service_disable(OUTBOUND_UNIT, stop=True)
    except EfaError:
        raise
    except Exception as err:  # the StepError of the platform layer
        raise EfaError(str(err))


OUT_CLIENTS = ETC + '/postfix/efa-outbound-clients.cidr'


def strict_chain(ports):
    """The milter list with efa-outbound on tempfail: when it is down, mail waits instead of leaving unchecked."""
    return ', '.join(f'{{ inet:127.0.0.1:{port}, default_action=tempfail }}' if port == OUTBOUND_PORT else f'inet:127.0.0.1:{port}' for port in ports)


def _outbound_strict(state):
    # Disclaimers alone keep accept: a missing disclaimer is no leak.
    # Bulk mode alone too: without the mark the mail takes the normal transport, nothing leaks.
    return _outbound_on({**state, 'domains': {}, 'disclaimers': [], 'bulk': {}})


def _outbound_strict_apply(state):
    """Port 587 and the clients of the relay networks and submitters get efa-outbound on tempfail while DLP, PDF encryption or
    limits are on. Mail from the internet keeps the global list (milter_default_action accept) and never waits for it."""
    ports = _milter_ports_now()
    strict = _outbound_strict(state) and OUTBOUND_PORT in ports
    if strict:
        chain = strict_chain(ports)
        nets = _outbound_networks() + [item['value'] for item in _submitters() if item['kind'] == 'ip']
        _map_write(OUT_CLIENTS, [f'{net} {chain}' for net in dict.fromkeys(nets)], 'cidr')
        _postconf_set('smtpd_milter_maps', f'cidr:{OUT_CLIENTS}')
    elif _postconf('smtpd_milter_maps') == f'cidr:{OUT_CLIENTS}':
        _postconf_remove(['smtpd_milter_maps'])
    if not strict and os.path.exists(OUT_CLIENTS):
        os.remove(OUT_CLIENTS)
    if strict:
        _postconf_set('efa_submission_milters', strict_chain(ports))
        if _submission_active():
            subprocess.run(['postconf', '-P', 'submission/inet/smtpd_milters=$efa_submission_milters'], check=True, capture_output=True)
    else:
        # Port 587 takes the global list again; a reference to $smtpd_milters there would call itself.
        if _submission_active():
            subprocess.run(['postconf', '-PX', 'submission/inet/smtpd_milters'], check=False, capture_output=True)
        # Unused once 587 no longer names it, so postconf -n does not show it any more: remove it in any case.
        _postconf_remove(['efa_submission_milters'])


# The cluster (9): a master and its clients over TLS with certificates of the own CA of the master. 9a: certificates, join, status.
CLUSTER_UNIT = 'efa-cluster'


# 9b: the master hands its settings on as commands. Each write command that is not about this host goes into a journal (0600);
# the clients fetch it over mutual TLS and run the same commands, so the changes they make to Postfix and rspamd follow too.
CLUSTER_LOCAL = {
    'network-set', 'interface-set', 'interface-confirm', 'interface-revert', 'firewall-set', 'firewall-confirm', 'firewall-revert',
    'firewall-guard-set', 'firewall-probe-set', 'firewall-test', 'letsencrypt-set', 'ssh-root-set', 'admin-password', 'reboot', 'halt',
    'update-system', 'update-system-run', 'update-now', 'update-install', 'update-run', 'update-rollback', 'update-post-boot',
    'autoupdate-set', 'maintenance-set', 'restore', 'backup-now', 'backup-import', 'backup-password-set', 'backup-set',
    'backup-target-set', 'mariadb-repair', 'service-restart', 'extra-service-set', 'load-set', 'load-notify', 'resolver-set',
    'dns-zone-set', 'kernel-hardening-set', 'wazuh-install', 'wazuh-config', 'wazuh-service', 'wazuh-update', 'wazuh-remove',
    'session-open', 'session-end', 'token-create', 'token-revoke', 'audit-mode', 'audit-rules-set', 'audit-note', 'audit-purge',
    'maillog-purge', 'maillog-setup', 'quarantine-release', 'quarantine-delete', 'quarantine-purge', 'queue-action', 'queue-flush',
    'cdr-release', 'uq-release', 'uq-request', 'uq-delete', 'uq-sender', 'uq-link-use', 'train-request', 'train-decide',
    'mailreport-run', 'events-run', 'security-check', 'ml-train', 'efa-headers-apply', 'cluster-init', 'cluster-token',
    'cluster-join', 'cluster-node-remove', 'cluster-leave', 'cluster-mail-action', 'sanesecurity-update', 'sanesecurity-run', 'rotation-run', 'tui',
    # The package setup runs these on every host for itself (nginx, logins of port 587, the memory of redis).
    'web-harden', 'sasl-apply', 'redis-tune',
    # 5o: the API, its certificate files and sources belong to the master; the keys it takes are shared as files (CLUSTER_DKIM).
    'dkim-provision-set', 'dkim-source-set', 'dkim-source-remove'}
# Commands that make random keys: not run again, the master hands on the folder of the keys instead (and the link key).
CLUSTER_DKIM = {'dkim-create', 'dkim-generate', 'dkim-generate-ed25519', 'dkim-remove', 'dkim-import', 'rotation-set', 'rotation-all-set',
                'rotation-pregenerate', 'rotation-run', 'arc-set', 'arc-all-set', 'dkim-provision-apply', 'dkim-provision-takeover'}
CLUSTER_CONTENT = {'links-set'}
# shortcut: each change hands the whole disclaimer folder to the nodes (up to 200 templates); send one template when that grows.
CLUSTER_DISCLAIMER = {'disclaimer-template-set', 'disclaimer-template-remove', 'disclaimer-restore', 'disclaimer-import', 'disclaimer-provision-apply'}


def cluster_role():
    return _lib('efa_cluster').read_state(ETC).get('role', 'none') if os.path.exists(os.path.join(ETC, 'eFa', 'cluster')) else 'none'


# 9g: master/client (settings only on the master, the clients read only) or HA (a change on any node goes to the master, which
# runs it and hands it to all; the order of the master decides, so the last change wins). The overviews of the master too.
CLUSTER_MODES = ('master-client', 'ha')
CLUSTER_HA_FORWARD = {'cluster-maillog', 'cluster-quarantine', 'cluster-queue', 'cluster-mail-action', 'cluster-unban', 'cluster-mx-check'}


def _cluster_managed_by():
    """The master of a client in master/client mode, for the note on every page; empty otherwise."""
    if cluster_role() != 'client' or cluster_mode() != 'master-client':
        return ''
    return _lib('efa_cluster').read_state(ETC).get('master', {}).get('name', '')


def cluster_mode():
    return _lib('efa_cluster').read_state(ETC).get('mode', 'master-client') if os.path.exists(os.path.join(ETC, 'eFa', 'cluster')) else ''


def _cluster_forward(args):
    """HA: the command to the master; it runs it there with the rights already checked here, and answers with its result."""
    cluster, base, state = _cluster_parts()
    spec = COMMANDS[args.command]['args']
    values = {arg['name']: getattr(args, arg['name'], '') for arg in spec if not arg.get('secret')}
    stdin = ''
    if any(arg.get('secret') for arg in spec):
        if sys.stdin.isatty():
            raise EfaError('A secret goes to the master only from the web interface or a pipe; or change it on the master.')
        stdin = sys.stdin.read(65536)
    master = state['master']
    try:
        answer = cluster.call(base, master['host'], master['port'], '/v1/forward',
                              {'command': args.command, 'args': {k: v for k, v in values.items() if v is not None}, 'stdin': stdin,
                               'user': _dmarc_who()}, timeout=180)
    except (OSError, ValueError) as err:
        raise EfaError(f"Cluster (HA): the master {master.get('name', '')} is not reachable, so settings cannot change now: {str(err)[:120]}. "
                       'Mail filtering goes on with the last settings.')
    if isinstance(answer, dict) and set(answer) == {'error'}:
        raise EfaError(answer['error'])
    return answer


# Whole families stay on their host, whatever the list above forgets: a firewall job run on another node with its own files would
# take away rules there (it did, in the test of 9b: the guard of the master ran again on a node and removed the allowlist table).
CLUSTER_LOCAL_PREFIXES = ('firewall-', 'interface-', 'network-', 'update-', 'backup-', 'cluster-', 'wazuh-', 'session-', 'token-', 'audit-')


def cluster_replicated(command):
    if command in CLUSTER_DKIM:
        return True
    return bool(command in COMMANDS and COMMANDS[command].get('writes') and command not in CLUSTER_LOCAL and command not in BACKGROUND_JOBS
                and not command.startswith(CLUSTER_LOCAL_PREFIXES))


def _etc_relative(path):
    # The paths in the journal are below /etc of each node, so a node with another EFA_ETC (a test) writes into its own.
    return os.path.relpath(path, ETC)


def _file_item(path, mode=None):
    with open(path, 'rb') as f:
        data = base64.b64encode(f.read()).decode()
    return {'path': _etc_relative(path), 'mode': os.stat(path).st_mode & 0o777 if mode is None else mode, 'data': data}


def _tree_files(top):
    """Every file below a folder with its mode, as base64."""
    found = []
    for root, dirs, names in os.walk(top):
        dirs.sort()
        for name in sorted(names):
            found.append(_file_item(os.path.join(root, name)))
    return found


def cluster_entries(command, args, secrets_seen):
    """What the journal gets for one command on the master: the command itself, files, or both."""
    # A call of a source that changed nothing (GET, the same version, a refusal) goes to no node.
    if command == 'dkim-provision-apply' and not PROVISION_CHANGED:
        return []
    if command in CLUSTER_DISCLAIMER:
        if not DISCLAIMER_CHANGED:
            return []
        return [{'type': 'files', 'files': _tree_files(DISCLAIMER_DIR) if os.path.isdir(DISCLAIMER_DIR) else [],
                 'mirror': [_etc_relative(DISCLAIMER_DIR)], 'then': 'disclaimer-sync'}]
    if command in CLUSTER_DKIM:
        files = (_tree_files(DKIM_DIR) + ([_file_item(ROTATION_FILE, 0o600)] if os.path.exists(ROTATION_FILE) else [])
                 + ([_file_item(PROVISION_FILE, 0o640)] if os.path.exists(PROVISION_FILE) else []))
        return [{'type': 'files', 'files': files, 'mirror': [_etc_relative(DKIM_DIR)], 'then': 'cluster-dkim-apply'}]
    values = {arg['name']: getattr(args, arg['name'], '') for arg in COMMANDS[command]['args'] if not arg.get('secret')}
    # An empty value stays: it is how a text is cleared (subject-set --text '').
    entries = [{'type': 'command', 'command': command, 'args': {k: v for k, v in values.items() if v is not None}, 'secrets': list(secrets_seen)}]
    if command in CLUSTER_CONTENT and os.path.exists(CONTENT_FILE):
        entries.append({'type': 'files', 'files': [_file_item(CONTENT_FILE, 0o640)], 'mirror': [], 'then': 'cluster-content-apply'})
    return entries


def _cluster_journal(command, args):
    """On the master: the entries of a successful write command, numbered on, the oldest dropped past CLUSTER_KEEP."""
    cluster = _lib('efa_cluster')
    cluster.journal_append(cluster.folder(ETC), cluster_entries(command, args, SECRETS_SEEN))


# 9c, full sync: a new node takes the settings of the master once, then follows the journal from that point.
SNAP_SKIP_EFA = {'audit-strict.json', 'audit-strict.key', 'autoupdate.json', 'backup-targets.json', 'firewall.json', 'interfaces.json',
                 'security-check.json', 'update-system.json', 'MySQL-Config', 'eFa-Config', 'rspamd-sso', 'wazuh.json'}
SNAP_SKIP_DIRS = {'eFa/backup-targets', 'eFa/efa5-import', 'eFa/cluster'}
SNAP_RSPAMD_SKIP = ('redis.conf', 'worker-', '.example')
SNAP_POSTFIX_MAPS = ('access', 'canonical', 'generic', 'header_checks', 'helo_access', 'milter_header_checks', 'efa-quarantine', 'recipient_access',
                     'recipient_canonical', 'relay_recipients', 'relocated', 'sender_access', 'sender_canonical', 'transport', 'virtual', 'sasl_passwd')
SNAP_POSTCONF = ('smtpd_milters', 'smtpd_milter_maps', 'efa_submission_restrictions', 'efa_submission_milters', 'smtpd_restriction_classes',
                 'smtpd_relay_restrictions', 'smtpd_recipient_restrictions', 'recipient_bcc_maps', 'sender_bcc_maps', 'transport_maps',
                 'smtp_tls_policy_maps', 'milter_header_checks', 'message_size_limit', 'relayhost', 'mynetworks', 'smtpd_tls_protocols',
                 'smtpd_tls_mandatory_protocols', 'smtp_tls_protocols', 'smtp_tls_mandatory_protocols', 'smtp_tls_security_level',
                 'smtp_dns_support_level', 'smtpd_tls_ask_ccert', 'smtpd_tls_fingerprint_digest')
SNAP_POSTCONF_PREFIXES = ('efa_sub_', 'efabulk_', 'smtp_sasl_')
SNAP_SERVICES = ('efabulk/unix', 'efa-phish/unix', 'efa-reports/unix')
SNAP_TABLES = ('tenants', 'tenant_domains', 'users', 'efa_groups', 'user_groups', 'group_roles', 'scoped_settings')
SNAP_UNITS = ('efa-outbound', 'efa-cdr')
# What the master sets goes to all nodes; only the identity of a host stays. Values of one node go here, never shared.
LOCAL_DIR = ETC + '/eFa/local.d'


def merged(base, override):
    """The settings with the override of this host on top, key by key."""
    out = dict(base)
    for key, value in override.items():
        out[key] = merged(out[key], value) if isinstance(value, dict) and isinstance(out.get(key), dict) else value
    return out


def own_names(paths, master, own):
    """The name of the master in the shared Postfix tables as the name of this host."""
    fixed = []
    for path in paths:
        if master and own and master != own and os.path.basename(path) in HOSTNAME_MAPS and os.path.exists(path):
            with open(path) as f:
                text = f.read()
            if renamed_text(text, master, own) != text:
                _write(path, renamed_text(text, master, own))
                fixed.append(path)
    return fixed


def snapshot_files():
    """The setting files of this host that a cluster shares, below ETC."""
    found = []
    for name in sorted(os.listdir(ETC + '/eFa')):
        path = f'{ETC}/eFa/{name}'
        if os.path.isfile(path) and name not in SNAP_SKIP_EFA:
            found.append(path)
    for path in (f'{ETC}/efa-web/content.json', f'{ETC}/efa-web/headers-policy.json', SUB_DOVECOT, SUB_PASSWD):
        if os.path.exists(path):
            found.append(path)
    for root, dirs, names in os.walk(RSPAMD_DIR):
        dirs.sort()
        for name in sorted(names):
            if not any(part in name for part in SNAP_RSPAMD_SKIP):
                found.append(os.path.join(root, name))
    postfix = ETC + '/postfix'
    for name in sorted(os.listdir(postfix)) if os.path.isdir(postfix) else []:
        if (name in SNAP_POSTFIX_MAPS or name.startswith('efa-')) and not name.endswith('.db'):
            found.append(f'{postfix}/{name}')
    return [path for path in found if not any(_etc_relative(path).startswith(item + '/') for item in SNAP_SKIP_DIRS)]


def cluster_snapshot(_args):
    """The master: its shared settings in one piece for a new node, with the journal number they stand at."""
    cluster, base, state = _cluster_parts()
    if state.get('role') != 'master':
        raise EfaError('Only the master gives a snapshot.')
    journal = cluster.journal_read(base)
    explicit = {}
    for line in subprocess.run(['postconf', '-n'], capture_output=True, text=True).stdout.splitlines():
        name, _, value = line.partition(' = ')
        if name in SNAP_POSTCONF or name.startswith(SNAP_POSTCONF_PREFIXES):
            explicit[name] = value
    services = {}
    for service in SNAP_SERVICES:
        line = subprocess.run(['postconf', '-M', service], capture_output=True, text=True).stdout.strip()
        if line:
            services[service] = line
    sql = ''
    if shutil.which('mysqldump'):
        done = subprocess.run(['mysqldump', '--user=root', '--single-transaction', 'efa', *SNAP_TABLES], capture_output=True, text=True, env=_mysql_env())
        sql = done.stdout if done.returncode == 0 else ''
    platform_now = _platform()
    files = [{**_file_item(path), 'hash': os.path.exists(path + '.db')} for path in snapshot_files()]
    return {'seq': journal[-1]['seq'] if journal else 0, 'hostname': _postconf('myhostname'), 'files': files, 'postconf': explicit, 'services': services, 'sql': sql,
            'units': {unit: platform_now.service_is_active(unit) for unit in SNAP_UNITS}}


def snapshot_apply(snapshot, files_only=False):
    """A snapshot of the master on this node. With files_only (a test on one host) the rest is only listed."""
    written, maps = [], []
    for item in snapshot['files']:
        path = os.path.realpath(os.path.join(ETC, item['path']))
        if not path.startswith(os.path.realpath(ETC) + os.sep):
            raise EfaError(f'a path outside {ETC}: {item["path"]}')
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path + '.new', 'wb') as f:
            f.write(base64.b64decode(item['data']))
        os.chmod(path + '.new', item['mode'])
        if os.path.exists(path):  # the owner of the file here (rspamd keys, the Dovecot password file) stays
            owner = os.stat(path)
            os.chown(path + '.new', owner.st_uid, owner.st_gid)
        os.replace(path + '.new', path)
        written.append(item['path'])
        if item.get('hash'):
            maps.append(path)
    own_names([os.path.join(ETC, item['path']) for item in snapshot['files']], snapshot.get('hostname', ''), _postconf('myhostname'))
    pending = {'postconf': sorted(snapshot['postconf']), 'services': sorted(snapshot['services']), 'sql_bytes': len(snapshot['sql']),
               'units': snapshot['units'], 'postmap': [os.path.relpath(path, ETC) for path in maps]}
    if files_only:
        return {'files': len(written), 'not_applied_in_this_test': pending}
    for path in maps:
        subprocess.run(['postmap', path], check=False, capture_output=True)
    for name, value in snapshot['postconf'].items():
        subprocess.run(['postconf', '-e', f'{name} = {value}'], check=False, capture_output=True)
    for service, line in snapshot['services'].items():
        subprocess.run(['postconf', '-M', f'{service}={line}'], check=False, capture_output=True)
    if snapshot['sql']:
        subprocess.run(['mysql', '--user=root', 'efa'], input=snapshot['sql'], text=True, env=_mysql_env(), check=False, capture_output=True)
    platform_now = _platform()
    for unit, active in snapshot['units'].items():
        try:
            (platform_now.service_enable(unit, start=True) if active else platform_now.service_disable(unit, stop=True))
        except Exception as err:  # the StepError of the platform layer: the other parts are done
            print(f'cluster sync: {unit}: {err}', file=sys.stderr)
    if os.path.exists(SUB_PASSWD):
        shutil.chown(SUB_PASSWD, 'root', 'dovecot')
    if os.path.exists(CONTENT_FILE):
        cluster_content_apply(None)
    cluster_dkim_apply(None)
    for unit in (_platform().service('mta'), _platform().service('sasl')):
        try:
            _platform().service_reload_if_active(unit)
        except Exception:  # noqa: S110 - a service that is not there here
            pass
    return {'files': len(written), 'postconf': len(snapshot['postconf']), 'services': len(snapshot['services']), 'tables': len(SNAP_TABLES)}


# 9e: failover works through several MX records of equal priority, one per node; no shared storage.
def _addresses_of(host):
    try:
        return sorted({item[4][0] for item in socket.getaddrinfo(host, 25, proto=socket.IPPROTO_TCP)})
    except (OSError, UnicodeError):
        return []


def _own_address(family, probe):
    """The source address this host uses towards the internet. A UDP connect sends nothing."""
    try:
        with socket.socket(family, socket.SOCK_DGRAM) as sock:
            sock.connect((probe, 25))
            return sock.getsockname()[0]
    except OSError:
        return None


def mx_findings(domain, records, addresses_of, nodes):
    """What the MX records of one domain mean for the failover. records: [(priority, host)], nodes: {address: node name}."""
    findings = []
    if not records:
        return [{'level': 'problem', 'domain': domain, 'text': 'No MX record: other servers deliver to the A record of the domain, or not at all.'}]
    covered, foreign = set(), []
    for priority, host in records:
        found = [nodes[address] for address in addresses_of(host) if address in nodes]
        if found:
            covered.update(found)
        else:
            foreign.append(host)
    for host in foreign:
        findings.append({'level': 'warning', 'domain': domain, 'text': f'MX {host} is no node of this cluster: mail sent there does not pass these filters.'})
    for name in sorted(set(nodes.values()) - covered):
        findings.append({'level': 'warning', 'domain': domain, 'text': f'No MX points to {name}: it takes no mail for this domain from outside.'})
    if len(covered) == 1:
        findings.append({'level': 'warning', 'domain': domain, 'text': 'Only one node takes the mail: if it fails, senders queue and retry for days.'})
    ours = sorted({priority for priority, host in records if host not in foreign})
    if len(ours) > 1:
        findings.append({'level': 'note', 'domain': domain, 'text': f'The nodes have the priorities {", ".join(map(str, ours))}: '
                                                                     'the lower takes all mail, the higher only while it fails. Equal priorities share the load.'})
    return findings


def cluster_mx_check(_args):
    """The master: do the MX records of the local domains point to the nodes, so that one can fail without loss of mail?"""
    _cluster, _base, state = _cluster_parts()
    if state.get('role') != 'master':
        raise EfaError('The MX check runs on the master: it knows all nodes.')
    nodes = {}
    for address in (_own_address(socket.AF_INET, '192.0.2.1'), _own_address(socket.AF_INET6, '2001:db8::1')):
        if address:
            nodes[address] = state['name']
    for name, node in state.get('nodes', {}).items():
        for address in _addresses_of(node['host']) or [node['host']]:
            nodes[address] = name
    findings, domains = [], _local_domains()
    for domain in domains:
        lines = subprocess.run(['dig', '+time=4', '+tries=1', '+short', 'MX', domain], capture_output=True, text=True, timeout=15).stdout.split('\n')
        records = []
        for line in lines:
            parts = line.split()
            if len(parts) == 2 and parts[0].isdigit():
                records.append((int(parts[0]), parts[1].rstrip('.').lower()))
        findings += mx_findings(domain, sorted(records), _addresses_of, nodes)
    return {'domains': len(domains), 'nodes': sorted(set(nodes.values())), 'findings': findings,
            'ok': not any(item['level'] in ('problem', 'warning') for item in findings)}


def cluster_resync(_args):
    """A client takes all shared settings of the master anew, then follows the journal from that point. Joining does it once."""
    cluster, base, state = _cluster_parts()
    if state.get('role') != 'client':
        raise EfaError('Only a client takes the settings of a master.')
    master = state['master']
    try:
        snapshot = cluster.call(base, master['host'], master['port'], '/v1/snapshot', timeout=120)
    except (OSError, ValueError) as err:
        raise EfaError(f'The master does not answer: {err}')
    result = snapshot_apply(snapshot, files_only=bool(os.environ.get('EFA_CLUSTER_SYNC_FILES_ONLY')))
    state = cluster.read_state(ETC)
    state['applied'] = snapshot['seq']
    # The snapshot holds the result of the failed entries before it: they are no longer open.
    state['failed'] = [item for item in state.get('failed', []) if int(item.get('seq', 0)) > snapshot['seq']]
    cluster.write_state(state, ETC)
    return {**result, 'journal_from': snapshot['seq']}


def cluster_dkim_apply(_args):
    """On a client, after the keys of the master came: the rspamd settings from the key files, and a reload."""
    for path in glob.glob(DKIM_DIR + '/**/*.key', recursive=True):
        _own_key(path)
    _write_dkim_conf()
    _reload_rspamd()
    return {'dkim': 'applied'}


def cluster_content_apply(_args):
    """On a client, after the link key of the master came: the content milter takes it."""
    os.chmod(CONTENT_FILE, 0o640)
    shutil.chown(CONTENT_FILE, 'root', 'efa-web')
    _content_apply(merged(_json_read(CONTENT_FILE, {}), _json_read(LOCAL_DIR + '/content.json', {})))
    return {'content': 'applied'}


def _cluster_parts():
    cluster = _lib('efa_cluster')
    return cluster, cluster.folder(ETC), cluster.read_state(ETC)


def _host_port(value, default):
    host, _, port = value.strip().rpartition(':') if value.count(':') == 1 else (value.strip(), '', '')
    host = host or value.strip()
    if not HOST_RE.match(host) or ':' in host or (port and not port.isdigit()):
        raise EfaError('Master: a host name or address, with :port if not the default.')
    return host, int(port) if port else default


def cluster_status(_args):
    """The cluster: on the master each node with its state, on a client its master."""
    cluster, base, state = _cluster_parts()
    if not state:
        return {'role': 'none', 'mode': cluster_mode() or 'master-client', 'note': 'Not in a cluster. Start one with cluster-init on the master.'}
    with open(os.path.join(base, 'node.crt')) as f:
        own = f.read()
    result = {'role': state['role'], 'name': state['name'], 'port': state.get('port', cluster.PORT), 'mode': state.get('mode', 'master-client'),
              'certificate_until': time.strftime('%Y-%m-%d', time.localtime(cluster.cert_end(own)))}
    if state['role'] == 'master':
        rows = []
        journal = cluster.journal_read(base)
        seq = journal[-1]['seq'] if journal else 0
        result['journal'] = seq
        for name, node in sorted(state.get('nodes', {}).items()):
            row = {'node': name, 'address': f"{node['host']}:{node['port']}", 'joined': node.get('joined'), 'confirmed': node.get('applied', 0)}
            try:
                answer = cluster.call(base, node['host'], node['port'], '/v1/status', timeout=5)
                row.update(reachable=True, status=answer.get('status'), down=answer.get('down', []), version=answer.get('version'),
                           behind=max(0, seq - int(answer.get('applied', 0))), failed=answer.get('failed', []))
            except (OSError, ValueError) as err:
                row.update(reachable=False, error=str(err)[:120])
            rows.append(row)
        result['nodes'] = rows
    else:
        result['master'] = state['master']
        if state.get('mode', 'master-client') == 'master-client':
            result['managed_by'] = state['master'].get('name', '')
    return result


def _cluster_each(command, args, key):
    """One command on the master and on every node; the rows of key from all, each with its node."""
    cluster, base, state = _cluster_parts()
    if state.get('role') != 'master':
        raise EfaError('Only the master shows all nodes.')
    rows, errors = [], []
    local = COMMANDS[command]['func'](argparse.Namespace(**{arg['name']: args.get(arg['name'], '') for arg in COMMANDS[command]['args']}))
    rows += [{**row, 'node': state['name']} for row in local.get(key, [])]
    for name, node in sorted(state.get('nodes', {}).items()):
        try:
            answer = cluster.call(base, node['host'], node['port'], '/v1/run', {'command': command, 'args': {k: v for k, v in args.items() if v}}, timeout=60)
        except (OSError, ValueError) as err:
            errors.append(f'{name}: {err}'[:200])
            continue
        if 'error' in answer:
            errors.append(f"{name}: {answer['error']}"[:200])
        rows += [{**row, 'node': name} for row in answer.get(key, [])]
    return rows, errors


def cluster_maillog(args):
    """The mail log of all nodes, newest first."""
    limit = (args.limit or '').strip() or '100'
    rows, errors = _cluster_each('maillog-search', {'text': args.text or '', 'limit': limit}, 'mails')
    rows.sort(key=lambda row: str(row.get('ts', '')), reverse=True)
    return {'mails': rows[:int(limit) if limit.isdigit() else 100], 'unreachable': errors}


def cluster_quarantine(_args):
    """The held mail of all nodes."""
    rows, errors = _cluster_each('quarantine-list', {}, 'quarantine')
    return {'quarantine': rows, 'unreachable': errors}


def cluster_queue(args):
    """The mail queues of all nodes."""
    rows, errors = _cluster_each('queue-list', {'queue': args.queue or '', 'text': args.text or ''}, 'mails')
    counts = {}
    for row in rows:
        counts[row['node']] = counts.get(row['node'], 0) + 1
    return {'mails': rows, 'per_node': counts, 'unreachable': errors}


CLUSTER_MAIL_ACTIONS = {'release': ('quarantine-release', {}), 'delete': ('quarantine-delete', {'confirm': 'yes'}),
                        'requeue': ('queue-action', {'action': 'requeue', 'confirm': 'yes'}), 'hold': ('queue-action', {'action': 'hold', 'confirm': 'yes'})}


def cluster_unban(args):
    """Lifts a ban of Fail2Ban on all nodes, and keeps the address out of the shared bans for an hour."""
    cluster, _base, state = _cluster_parts()
    if state.get('role') != 'master':
        raise EfaError('Only the master lifts bans of the cluster.')
    try:
        address = str(ipaddress.ip_address(args.address.strip()))
    except ValueError:
        raise EfaError('Address: an IPv4 or IPv6 address.')
    now = time.time()
    state['unbans'] = {key: until for key, until in state.get('unbans', {}).items() if until > now}
    state['unbans'][address] = now + cluster.BAN_SECONDS
    state['bans'] = {key: item for key, item in state.get('bans', {}).items() if item['address'] != address}
    cluster.write_state(state, ETC)
    cluster.f2b_unban(address)
    return {'unbanned': address, 'on_all_nodes_within_seconds': 30, 'kept_out_until': time.strftime('%H:%M', time.localtime(now + cluster.BAN_SECONDS))}


def cluster_mail_action(args):
    """Release or delete a held mail, or requeue or hold one in the queue, on the node that has it."""
    cluster, base, state = _cluster_parts()
    if state.get('role') != 'master':
        raise EfaError('Only the master acts on other nodes.')
    action, node, mail = args.action.strip(), args.node.strip(), args.id.strip()
    if action not in CLUSTER_MAIL_ACTIONS or not QUEUE_ID_RE.match(mail):
        raise EfaError('Action: release, delete, requeue or hold; and a queue ID.')
    command, extra = CLUSTER_MAIL_ACTIONS[action]
    if node == state['name']:
        spec = COMMANDS[command]
        return spec['func'](argparse.Namespace(**{arg['name']: {**extra, 'id': mail}.get(arg['name'], '') for arg in spec['args']}))
    if node not in state.get('nodes', {}):
        raise EfaError('No such node.')
    target = state['nodes'][node]
    try:
        return cluster.call(base, target['host'], target['port'], '/v1/run', {'command': command, 'args': {**extra, 'id': mail}}, timeout=60)
    except (OSError, ValueError) as err:
        raise EfaError(f'{node} not reached: {err}')


def cluster_init(args):
    """This node becomes the master of a new cluster: its own certificate authority and certificate."""
    cluster, base, state = _cluster_parts()
    name = args.name.strip().lower()
    mode = (getattr(args, 'mode', '') or 'master-client').strip()
    if mode not in CLUSTER_MODES:
        raise EfaError('Mode: master-client or ha.')
    if state:
        raise EfaError('This node is in a cluster already.')
    if not cluster.valid_name(name):
        raise EfaError('Name: small letters, digits and dashes.')
    os.makedirs(base, mode=0o700, exist_ok=True)
    try:
        cluster.make_ca(base, name)
        cert = cluster.sign(base, cluster.make_request(base, name), name)
    except (RuntimeError, ValueError) as err:
        raise EfaError(str(err))
    _write(os.path.join(base, 'node.crt'), cert)
    cluster.write_state({'role': 'master', 'name': name, 'port': cluster.PORT, 'mode': mode, 'nodes': {}, 'tokens': {}}, ETC)
    _cluster_service(True)
    return cluster_status(None)


def cluster_mode_set(args):
    """On the master: master/client or HA. Each node takes all settings anew once it sees the new mode."""
    cluster, _base, state = _cluster_parts()
    if state.get('role') != 'master':
        raise EfaError('The mode is set on the master.')
    mode = args.mode.strip()
    if mode not in CLUSTER_MODES:
        raise EfaError('Mode: master-client or ha.')
    _confirm(args)
    old = state.get('mode', 'master-client')
    if old != mode:
        state['mode'] = mode
        cluster.write_state(state, ETC)
        _event('cluster_mode', 'notice', user=_dmarc_who(), old=old, new=mode)
    return {**cluster_status(None), 'changed': old != mode, 'note': 'Each node takes all settings anew within a minute (cluster-resync).'}


def _cluster_service(on):
    try:
        if on:
            _platform().service_enable(CLUSTER_UNIT, start=True)
        else:
            _platform().service_disable(CLUSTER_UNIT, stop=True)
    except Exception as err:  # the StepError of the platform layer
        raise EfaError(f'The cluster service: {err}')


def cluster_token(_args):
    """A one-time token for one node to join, valid for one hour, with the fingerprint of the CA to check on the node."""
    cluster, base, state = _cluster_parts()
    if state.get('role') != 'master':
        raise EfaError('Only the master gives out tokens.')
    token = secrets.token_urlsafe(24)
    now = time.time()
    state['tokens'] = {key: until for key, until in state.get('tokens', {}).items() if until > now}
    state['tokens'][cluster.token_hash(token)] = now + 3600
    cluster.write_state(state, ETC)
    with open(os.path.join(base, 'ca.crt')) as f:
        fingerprint = cluster.fingerprint_pem(f.read())
    return {'token': token, 'ca_fingerprint': fingerprint, 'valid_until': time.strftime('%Y-%m-%d %H:%M', time.localtime(now + 3600)),
            'on_the_node': f'efactl cluster-join --master <this host>:{state.get("port", cluster.PORT)} --name <node> --address <node address> '
                           f'--ca_fingerprint {fingerprint} (the token on the secret input)'}


def cluster_join(args):
    """This node joins a cluster: the CA of the master is checked by its fingerprint, then the request goes over TLS that
    trusts only that CA, with the one-time token on the secret input."""
    cluster, base, state = _cluster_parts()
    if state:
        raise EfaError('This node is in a cluster already.')
    name, address = args.name.strip().lower(), args.address.strip()
    if not cluster.valid_name(name) or not HOST_RE.match(address):
        raise EfaError('Name: small letters, digits and dashes; address: where the master reaches this node.')
    host, port = _host_port(args.master, cluster.PORT)
    token = _secrets(1, 'Token')[0].strip()
    try:
        ca = cluster.fetch_ca(host, port)
    except (OSError, ValueError, KeyError) as err:
        raise EfaError(f'The master does not answer: {err}')
    if cluster.fingerprint_pem(ca) != args.ca_fingerprint.strip().upper():
        raise EfaError('The CA of the master does not have the fingerprint you gave: not joined. Check the address and the fingerprint.')
    own_port = int((getattr(args, 'port', '') or '').strip() or cluster.PORT)
    os.makedirs(base, mode=0o700, exist_ok=True)
    try:
        csr = cluster.make_request(base, name)
        result = cluster.join_request(host, port, ca, {'token': token, 'name': name, 'host': address, 'port': own_port, 'csr': csr})
    except urllib.error.HTTPError as err:
        shutil.rmtree(base, ignore_errors=True)
        raise EfaError(f'The master refused: {err.read().decode("utf-8", "replace")[:200]}')
    except (OSError, RuntimeError, ValueError) as err:
        shutil.rmtree(base, ignore_errors=True)
        raise EfaError(f'Not joined: {err}')
    if result.get('ca') != ca:
        shutil.rmtree(base, ignore_errors=True)
        raise EfaError('The master answered with another CA: not joined.')
    _write(os.path.join(base, 'ca.crt'), ca)
    _write(os.path.join(base, 'node.crt'), result['cert'])
    cluster.write_state({'role': 'client', 'name': name, 'port': own_port,
                         'master': {'name': result.get('master'), 'host': host, 'port': port, 'fingerprint': result['master_fingerprint']}}, ETC)
    _cluster_service(True)
    try:
        synced = cluster_resync(None)
    except EfaError as err:  # joined; the sync can run again with cluster-resync
        synced = {'error': str(err)}
    return {**cluster_status(None), 'sync': synced}


def cluster_node_remove(args):
    """The master forgets a node: its certificate is no longer taken, whatever it says."""
    cluster, _base, state = _cluster_parts()
    if state.get('role') != 'master':
        raise EfaError('Only the master removes nodes.')
    if state.get('nodes', {}).pop(args.name.strip().lower(), None) is None:
        raise EfaError('No such node.')
    cluster.write_state(state, ETC)
    return cluster_status(None)


def cluster_promote(args):
    """9g-b: a client becomes the master of a new cluster, by hand, when the old master is gone. It makes its own new CA, so
    the CA key stays in one place; the other nodes join it anew, the old master leaves its cluster before it does."""
    _confirm(args)
    cluster, base, state = _cluster_parts()
    if state.get('role') != 'client':
        raise EfaError('Only a client takes over; this node is not one.')
    master = state['master']
    for attempt in range(3):
        try:
            cluster.call(base, master['host'], master['port'], '/v1/status', timeout=5)
            raise EfaError(f"The master {master.get('name')} answers: no take-over while it runs (that would make two masters).")
        except (OSError, ValueError):
            time.sleep(0 if attempt == 2 else 3)
    kept = f"{base}-before-promote-{time.strftime('%Y%m%d%H%M%S')}"
    shutil.copytree(base, kept)
    _cluster_service(False)
    shutil.rmtree(base)
    result = cluster_init(argparse.Namespace(name=state['name'], mode=state.get('mode', 'master-client')))
    _audit(f"cluster: {state['name']} took over from the master {master.get('name')}, which did not answer, by {_dmarc_who()}")
    return {**result, 'kept': kept,
            'next': ['On each other node: efactl cluster-leave --confirm yes, then efactl cluster-join with a token of this node.',
                     f"On the old master {master.get('name')}, once it is back: efactl cluster-leave --confirm yes before it joins this node."]}


def cluster_leave(args):
    """This node leaves the cluster: its certificates and keys are removed. On the master the whole cluster ends."""
    _confirm(args)
    _cluster, base, state = _cluster_parts()
    if not state:
        raise EfaError('Not in a cluster.')
    _cluster_service(False)
    shutil.rmtree(base, ignore_errors=True)
    return {'role': 'none', 'left': state.get('name')}


def disclaimer_status(_args):
    """Disclaimers per domain, and whether the milter runs."""
    state = _json_read(OUTBOUND_FILE, {'domains': {}})
    domains = state.get('domains', {})
    if identity_now and identity_now['domains'] is not None:
        domains = {key: value for key, value in domains.items() if key in identity_now['domains']}
    templates = [{key: item.get(key) for key in ('id', 'name', 'scope', 'target', 'groups', 'format', 'priority', 'enabled', 'valid_from', 'valid_until')}
                 | {'media': len(item.get('media') or []), 'attachments': len(item.get('attachments') or [])}
                 for item in state.get('disclaimers', []) if _disclaimer_visible(item)]
    return {'domains': [{'domain': key, 'text': value.get('text', ''), 'html': bool(value.get('html'))} for key, value in sorted(domains.items())],
            'templates': templates, 'milter_in_chain': OUTBOUND_PORT in _milter_ports_now()}


def disclaimer_set(args):
    """The disclaimer of a domain for outgoing mail, as text and optionally as HTML. Empty text removes it."""
    domain = args.domain.strip().lower()
    if not DOMAIN_RE.match(domain):
        raise EfaError('Invalid domain.')
    if identity_now and identity_now['domains'] is not None and domain not in identity_now['domains']:
        raise EfaError('Not allowed: name one of your own domains.')
    text = (args.text or '').replace('\\n', '\n').strip()
    html = (args.html or '').strip()
    if len(text) > 2000 or len(html) > 5000 or re.search(r'<\s*(script|iframe|object|embed|form)\b|\bon\w+\s*=|javascript:', html, re.I):
        raise EfaError('Text up to 2000 characters, HTML up to 5000 and without scripts, frames, forms or event handlers.')
    state = _json_read(OUTBOUND_FILE, {})
    state.setdefault('domains', {})
    if text:
        state['domains'][domain] = {'text': text, 'html': html}
    else:
        state['domains'].pop(domain, None)
    _outbound_write(state)
    return disclaimer_status(None)


# 8k: disclaimer templates for all domains, a tenant, a domain or groups of senders in a domain (efa_disclaimer.py). The
# templates are in outbound.json, their pictures and attachments in DISCLAIMER_DIR/<id>/, the older versions in <id>.1, <id>.2.
# Below /etc: the cluster journal hands the folder to the nodes (CLUSTER_DISCLAIMER), each builds its outbound.json from it.
DISCLAIMER_DIR = ETC + '/eFa/disclaimers'
LEGAL_ACCEPTED = ETC + '/eFa/legal-accepted.json'
DISCLAIMER_CHANGED = []  # a provisioning call that changed something; only then the nodes get the folder
DISCLAIMER_KEEP = 3
DISCLAIMER_MAX = 200


def _disclaimer_allowed(template):
    """All domains only the main admin, a tenant its admins, a domain or its groups the admins of the domain."""
    if not identity_now or identity_now['domains'] is None:
        return
    if template['scope'] == 'global':
        raise EfaError('Not allowed: a disclaimer for all domains is for the main admin.')
    if template['scope'] == 'tenant':
        if _tenant_id(template['target']) not in (identity_now['tenant_ids'] or []):
            raise EfaError('Not allowed: name your own tenant.')
    elif template['target'] not in identity_now['domains']:
        raise EfaError('Not allowed: name one of your own domains.')


def _disclaimer_visible(template):
    if not identity_now or identity_now['domains'] is None:
        return True
    if template['scope'] == 'tenant':
        return any(_tenant_of_domain(domain) in (identity_now['tenant_ids'] or []) for domain in identity_now['domains']
                   if template['target'] == _tenant_name_of_domain(domain))
    return template['scope'] == 'global' or template['target'] in identity_now['domains']


def _tenant_name_of_domain(domain):
    rows = _admin_query('SELECT t.name FROM tenants t JOIN tenant_domains d ON d.tenant_id = t.id WHERE d.domain = %s', (domain.lower(),))
    return rows[0]['name'].lower() if rows else ''


def _disclaimer_files(template_id):
    folder = f'{DISCLAIMER_DIR}/{template_id}'
    return {name: open(f'{folder}/{name}', 'rb').read() for name in os.listdir(folder) if name != 'template.json'} if os.path.isdir(folder) else {}


def _disclaimer_store(template, files):
    """The files of a template in a new folder, then the switch; the last versions stay for the way back."""
    os.makedirs(DISCLAIMER_DIR, mode=0o755, exist_ok=True)
    folder = f'{DISCLAIMER_DIR}/{template["id"]}'
    new = folder + '.new'
    shutil.rmtree(new, ignore_errors=True)
    os.makedirs(new, mode=0o755)
    for name, content in files.items():
        with open(f'{new}/{name}', 'wb') as f:
            f.write(content)
        os.chmod(f'{new}/{name}', 0o644)  # the milter runs as a dynamic user; a disclaimer goes out with every mail anyway
    _json_write(new + '/template.json', template)
    _disclaimer_shift(folder)
    os.replace(new, folder)


def _disclaimer_shift(folder):
    shutil.rmtree(f'{folder}.{DISCLAIMER_KEEP}', ignore_errors=True)
    for number in range(DISCLAIMER_KEEP - 1, 0, -1):
        if os.path.exists(f'{folder}.{number}'):
            os.replace(f'{folder}.{number}', f'{folder}.{number + 1}')
    if os.path.exists(folder):
        os.replace(folder, folder + '.1')


def _disclaimer_put(template, files):
    """Checks a template, stores it with its files and puts it into the milter."""
    lib = _lib('efa_disclaimer')
    problem = lib.template_problem(template)
    if problem:
        raise EfaError(problem)
    if template['scope'] in ('domain', 'group') and not DOMAIN_RE.match(template['target']):
        raise EfaError('Target: a domain.')
    if template['scope'] == 'tenant':
        _tenant_id(template['target'])
    _disclaimer_allowed(template)
    state = _json_read(OUTBOUND_FILE, {})
    others = [item for item in state.get('disclaimers', []) if item['id'] != template['id']]
    if len(others) >= DISCLAIMER_MAX:
        raise EfaError(f'Up to {DISCLAIMER_MAX} disclaimers.')
    _disclaimer_store(template, files)
    state['disclaimers'] = sorted(others + [template], key=lambda item: item['id'])
    _outbound_write(state)
    DISCLAIMER_CHANGED.append(template['id'])
    _audit(f"disclaimer {template['id']} ({template['scope']} {template.get('target') or ''}, {template['format']}) set by {_dmarc_who()}")


def _disclaimer_group_members(key):
    """Addresses in a group: ldap:<DN of the directory group> or the name of an eFa-next group."""
    if key.lower().startswith('ldap:'):
        return _rule_group_members(key[5:])
    return [row['username'].lower() for row in _admin_query('SELECT u.username FROM user_groups u JOIN efa_groups g ON g.id = u.group_id WHERE g.name = %s',
                                                             (key,)) if '@' in row['username']]


def _disclaimer_lookups(state):
    """What the milter needs to pick: the tenant of each domain and the groups of each sender, read now so mail never waits."""
    templates = state.get('disclaimers', [])
    state.pop('tenant_of', None)
    if any(item['scope'] == 'tenant' for item in templates):
        state['tenant_of'] = {row['domain'].lower(): row['name'].lower() for row in
                              _admin_query('SELECT d.domain, t.name FROM tenant_domains d JOIN tenants t ON t.id = d.tenant_id')}
    keys = sorted({key for item in templates if item['scope'] == 'group' for key in item.get('groups', [])})
    if not keys:
        state.pop('sender_groups', None)
        return
    try:
        found = {}
        for key in keys:
            for address in _disclaimer_group_members(key):
                found.setdefault(address, []).append(key)
        state['sender_groups'] = found
    except (OSError, subprocess.SubprocessError, EfaError) as err:  # the directory is away: the last known members stay
        print(f'efactl: disclaimer groups not read, the last ones stay: {err}', file=sys.stderr)


def _disclaimer_args(args, old):
    keep = lambda name: (getattr(args, name, None) or '').strip() if (getattr(args, name, None) or '').strip() else old.get(name, '')  # noqa: E731
    groups = (args.groups or '').strip()
    return {'id': args.id.strip().lower(), 'name': keep('name')[:80], 'scope': keep('scope'), 'target': keep('target').lower(),
            'groups': [item.strip() for item in groups.split(';') if item.strip()] if groups else old.get('groups', []),
            'format': keep('format'), 'text': (args.text or '').replace('\\n', '\n').strip() if args.text is not None else old.get('text', ''),
            'html': (args.html or '').strip() if args.html is not None else old.get('html', ''),
            'priority': int(keep('priority') or 100) if str(keep('priority') or 100).isdigit() else -1,
            'enabled': (args.enabled or '').strip() != 'off' if (args.enabled or '').strip() else old.get('enabled', True),
            'valid_from': keep('valid_from'), 'valid_until': keep('valid_until'),
            'media': old.get('media', []), 'attachments': old.get('attachments', [])}


def disclaimer_template_set(args):
    """A disclaimer for all domains, a tenant, a domain or groups of senders in a domain. Pictures and attachments come with a ZIP
    (disclaimer-import); a change here keeps them."""
    template_id = args.id.strip().lower()
    old = next((item for item in _json_read(OUTBOUND_FILE, {}).get('disclaimers', []) if item['id'] == template_id), {})
    if old:
        _disclaimer_allowed(old)
    template = _disclaimer_args(args, old)
    if template['priority'] < 0:
        raise EfaError('Priority: a number up to 9999.')
    _disclaimer_put(template, _disclaimer_files(template_id) if old else {})
    return disclaimer_status(None)


def disclaimer_template_remove(args):
    """Takes a disclaimer out of the mail; its folder stays as the last version for the way back."""
    template_id = args.id.strip().lower()
    state = _json_read(OUTBOUND_FILE, {})
    template = next((item for item in state.get('disclaimers', []) if item['id'] == template_id), None)
    if template is None:
        raise EfaError(f'No disclaimer {template_id}.')
    _disclaimer_allowed(template)
    state['disclaimers'] = [item for item in state['disclaimers'] if item['id'] != template_id]
    _outbound_write(state)
    _disclaimer_shift(f'{DISCLAIMER_DIR}/{template_id}')
    DISCLAIMER_CHANGED.append(template_id)
    _audit(f'disclaimer {template_id} removed by {_dmarc_who()}')
    return disclaimer_status(None)


def disclaimer_restore(args):
    """The version of a disclaimer before the last change, or the removed one."""
    template_id = args.id.strip().lower()
    folder = f'{DISCLAIMER_DIR}/{template_id}'
    if not _lib('efa_disclaimer').ID_RE.match(template_id) or not os.path.exists(folder + '.1/template.json'):
        raise EfaError(f'No earlier version of {template_id}.')
    template = _json_read(folder + '.1/template.json', {})
    files = _disclaimer_files(template_id + '.1')
    _disclaimer_put(template, files)
    shutil.rmtree(folder + '.2', ignore_errors=True)  # the restored one was .2 after the shift, it is the current one now
    for number in range(3, DISCLAIMER_KEEP + 1):
        if os.path.exists(f'{folder}.{number}'):
            os.replace(f'{folder}.{number}', f'{folder}.{number - 1}')
    return disclaimer_status(None)


def disclaimer_zip_in(data, dry_run):
    """A template from a ZIP: checked whole, then stored, or with dry_run only shown."""
    try:
        template, files = _lib('efa_disclaimer').read_zip(data)
    except ValueError as err:
        raise EfaError(f'ZIP refused, nothing changed: {err}')
    if template['scope'] in ('domain', 'group') and not DOMAIN_RE.match(template['target']):
        raise EfaError('ZIP refused, nothing changed: the target is no domain.')
    if template['scope'] == 'tenant':
        _tenant_id(template['target'])
    _disclaimer_allowed(template)
    preview = {key: template[key] for key in ('id', 'name', 'scope', 'target', 'groups', 'format', 'priority', 'enabled', 'valid_from', 'valid_until')}
    preview.update(media=[item['file'] for item in template['media']], attachments=[item['file'] for item in template['attachments']],
                   bytes=sum(map(len, files.values())), text=template['text'][:300] or _lib('efa_disclaimer').text_of(template['html'])[:300])
    if dry_run:
        return {'dry_run': True, 'template': preview}
    _disclaimer_put(template, files)
    return {'imported': preview}


def disclaimer_import(args):
    """A disclaimer as ZIP (docs/api-disclaimer.md): manifest.json, body.html and/or body.txt, media/, attachments/."""
    import base64 as b64
    if (args.file or '').strip() and os.environ.get('SUDO_USER') == 'efa-web':
        raise EfaError('A file on the host only on the command line.')
    if (args.file or '').strip():
        with open(args.file.strip(), 'rb') as f:
            data = f.read(_lib('efa_disclaimer').MAX_TEMPLATE_BYTES + 1)
    else:
        try:
            data = b64.b64decode(sys.stdin.readline().strip(), validate=True)
        except ValueError:
            raise EfaError('Give the disclaimer as a .zip file.')
    args.file = ''  # the nodes of a cluster get the stored folder, not the file name of this host
    if not data or len(data) > _lib('efa_disclaimer').MAX_TEMPLATE_BYTES:
        raise EfaError('A ZIP of up to 5 MB.')
    return disclaimer_zip_in(data, (args.dry_run or '').strip() == 'on')


def disclaimer_export(args):
    """A disclaimer as ZIP, as disclaimer-import takes it: written to --file, or as base64."""
    import base64 as b64
    template_id = args.id.strip().lower()
    template = next((item for item in _json_read(OUTBOUND_FILE, {}).get('disclaimers', []) if item['id'] == template_id), None)
    if template is None or not _disclaimer_visible(template):
        raise EfaError(f'No disclaimer {template_id}.')
    files = _disclaimer_files(template_id)
    data = _lib('efa_disclaimer').write_zip(template, files.get)
    if (args.file or '').strip() and os.environ.get('SUDO_USER') == 'efa-web':
        raise EfaError('A file on the host only on the command line.')
    if (args.file or '').strip():
        with open(args.file.strip(), 'wb') as f:
            f.write(data)
        return {'id': template_id, 'file': args.file.strip(), 'bytes': len(data)}
    return {'id': template_id, 'zip': b64.b64encode(data).decode(), 'bytes': len(data)}


def disclaimer_which(args):
    """Which disclaimer a sender gets: the most specific one that fits (group, domain, tenant, all domains)."""
    sender = args.sender.strip().lower()
    if not SENDER_RE.match(sender) or '@' not in sender:
        raise EfaError('Sender: a mail address.')
    if identity_now and identity_now['domains'] is not None and sender.rpartition('@')[2] not in identity_now['domains']:
        raise EfaError('Not allowed: a sender of your own domains.')
    state = _json_read(OUTBOUND_FILE, {})
    _disclaimer_lookups(state)
    templates = state.get('disclaimers', []) + legacy_disclaimers(state)
    found = _lib('efa_disclaimer').pick(templates, sender, lambda domain: state.get('tenant_of', {}).get(domain, ''),
                                        lambda address: state.get('sender_groups', {}).get(address, ()))
    if not found:
        return {'sender': sender, 'disclaimer': None}
    return {'sender': sender, 'disclaimer': found['id'], 'name': found.get('name', ''), 'scope': found['scope'], 'format': found['format'],
            'text': found.get('text') or _lib('efa_disclaimer').text_of(found.get('html') or '')}


def disclaimer_provision_apply(args):
    """For efa-dkim-api only: one disclaimer call of a source, {method, id, zip} on stdin; answers {code, body}. A source sets
    only disclaimers of its own domains, or of a tenant all of whose domains are its own, and only the ones it delivered."""
    result, call = _disclaimer_provision(args)
    _audit(f"disclaimer provisioning: {call.get('method', '?')} {str(call.get('id') or '/')[:40]} by the source {args.source.strip()[:40]}: {result['code']}")
    return result


def _disclaimer_public(item):
    return {key: item.get(key) for key in ('id', 'name', 'scope', 'target', 'groups', 'format', 'priority', 'enabled', 'valid_from', 'valid_until')}


def _disclaimer_provision(args):
    import base64 as b64
    call, state, source = {}, _provision_state(), args.source.strip()
    if state['mode'] != 'on':
        return {'code': 403, 'body': {'error': 'the provisioning is off'}}, call
    if source not in state['sources']:
        return {'code': 401, 'body': {'error': 'unknown source'}}, call
    if 'disclaimer' not in (state['sources'][source].get('rights') or ['dkim']):
        return {'code': 403, 'body': {'error': 'this source has no right for disclaimer'}}, call
    try:
        call = json.loads(sys.stdin.read(8 * 1024 * 1024))
    except ValueError:
        return {'code': 400, 'body': {'error': 'no valid JSON'}}, call
    call = call if isinstance(call, dict) else {}
    method, template_id = call.get('method'), str(call.get('id') or '').strip().lower()
    templates = _json_read(OUTBOUND_FILE, {}).get('disclaimers', [])
    mine = {item['id']: item for item in templates if item.get('source') == source}
    if method == 'GET':
        if not template_id:
            return {'code': 200, 'body': {'disclaimers': [_disclaimer_public(item) for _key, item in sorted(mine.items())]}}, call
        return ({'code': 200, 'body': _disclaimer_public(mine[template_id])} if template_id in mine else {'code': 404, 'body': {'error': 'not delivered'}}), call
    if method == 'DELETE':
        if template_id not in mine:
            return {'code': 404, 'body': {'error': 'not delivered'}}, call
        disclaimer_template_remove(argparse.Namespace(id=template_id))
        return {'code': 200, 'body': {'id': template_id, 'removed': True}}, call
    if method != 'PUT':
        return {'code': 405, 'body': {'error': 'GET, PUT or DELETE'}}, call
    try:
        template, files = _lib('efa_disclaimer').read_zip(b64.b64decode(call.get('zip') or '', validate=True))
    except ValueError as err:
        return {'code': 400, 'body': {'error': f'ZIP refused: {err}'}}, call
    if template['id'] != template_id:
        return {'code': 400, 'body': {'error': 'the id in manifest.json differs from the address'}}, call
    if any(item['id'] == template_id and item.get('source') != source for item in templates):
        return {'code': 409, 'body': {'error': 'this id belongs to another source or to the admins'}}, call
    own = set(state['sources'][source].get('domains') or [])
    if template['scope'] == 'global':
        return {'code': 403, 'body': {'error': 'a source cannot set a disclaimer for all domains'}}, call
    if template['scope'] == 'tenant':
        domains = {row['domain'] for row in _admin_query('SELECT d.domain FROM tenant_domains d JOIN tenants t ON t.id = d.tenant_id WHERE t.name = %s',
                                                         (template['target'],))}
        if not domains or not domains <= own:
            return {'code': 403, 'body': {'error': 'not all domains of this tenant belong to the source'}}, call
    elif template['target'] not in own:
        return {'code': 403, 'body': {'error': 'not a domain of this source'}}, call
    template['source'] = source
    try:
        _disclaimer_put(template, files)
    except EfaError as err:
        return {'code': 400, 'body': {'error': str(err)}}, call
    return {'code': 200, 'body': _disclaimer_public(template)}, call


def disclaimer_sync(_args):
    """On a cluster node: the disclaimers as the master has them in its folder, into the milter of this node."""
    lib = _lib('efa_disclaimer')
    found = []
    for name in sorted(os.listdir(DISCLAIMER_DIR)) if os.path.isdir(DISCLAIMER_DIR) else []:
        path = f'{DISCLAIMER_DIR}/{name}/template.json'
        if lib.ID_RE.match(name) and os.path.exists(path):
            template = _json_read(path, {})
            if template.get('id') == name and lib.template_problem(template) is None:
                found.append(template)
    state = _json_read(OUTBOUND_FILE, {})
    state['disclaimers'] = found
    _outbound_write(state)
    return {'disclaimers': [item['id'] for item in found]}


def legal_status(_args):
    """The legal texts of this version (5y): their digest, where they are, and the confirmation that holds for them."""
    lib = _lib('efa_legal')
    now = lib.current()
    found = lib.accepted(LEGAL_ACCEPTED, now)
    return {'digest': now, 'texts': [f'{lib.FOLDER}/{name}' for name in lib.NAMES], 'pdf': f'{lib.FOLDER}/{lib.ALL_PDF}',
            'accepted': bool(found), 'accepted_by': (found or {}).get('who', ''), 'accepted_at': (found or {}).get('when', ''),
            'warnings': [] if found or not now else ['The legal texts of this version are not confirmed yet: the next admin login asks for it.']}


def legal_accept(args):
    """Notes the confirmation of the legal texts: the digest must be the one of the installed texts. Kept with time, who,
    from where and the version, and in the audit log."""
    lib = _lib('efa_legal')
    now = lib.current()
    given = (args.digest or '').strip().lower()
    if not now:
        raise EfaError(f'The legal texts are missing in {lib.FOLDER}.')
    if given != now:
        raise EfaError(f'The digest does not match the legal texts of this version ({now}).')
    if (args.confirm or '').strip().lower() not in ('ja', 'yes'):
        raise EfaError('Confirm with ja or yes: qualified administrator, no consumer, texts read and accepted.')
    who = acting_user or ('admin (web)' if os.environ.get('SUDO_USER') == 'efa-web' else f"console ({os.environ.get('SUDO_USER') or 'root'})")
    client = (acting_client or 'console').strip()[:45]
    entry = {'digest': now, 'when': time.strftime('%Y-%m-%d %H:%M:%S %z'), 'who': who, 'from': client, 'version': _efa_version()}
    _json_write(LEGAL_ACCEPTED, entry)
    os.chmod(LEGAL_ACCEPTED, 0o644)  # efa-web reads it before each admin page; it holds no secret
    _audit(f'legal texts {now} confirmed by {who} from {client}: qualified administrator, no consumer')
    return legal_status(None)


def legacy_disclaimers(state):
    """The disclaimers of before 8k (disclaimer-set, one per domain) as domain templates."""
    return [{'id': f'domain-{domain}'[:40], 'scope': 'domain', 'target': domain, 'format': 'html' if item.get('html') else 'text',
             'text': item.get('text', ''), 'html': item.get('html', ''), 'priority': 100} for domain, item in sorted(state.get('domains', {}).items())]


def dlp_status(_args):
    """Data loss prevention of outgoing mail: the rules and what each does."""
    dlp = {**DLP_DEFAULTS, **_json_read(OUTBOUND_FILE, {}).get('dlp', {})}
    return {**dlp, 'milter_in_chain': OUTBOUND_PORT in _milter_ports_now()}


def _dlp_action(value, keep):
    value = (value or '').strip()
    if not value:
        return keep
    if value not in DLP_ACTIONS:
        raise EfaError('Action: off, log, encrypt, hold or reject.')
    if value == 'encrypt' and not shutil.which('qpdf'):
        raise EfaError('Encryption needs qpdf: install the package qpdf first.')
    return value


def _dlp_ignore(text):
    """Own IBANs, comma separated, spaces inside allowed; - for none."""
    ignore = [] if text.strip() == '-' else sorted({re.sub(r'\s', '', item).upper() for item in re.split(r'[,;\n]+', text) if item.strip()})
    bad = [item for item in ignore if not IBAN_RE.match(item)]
    if bad:
        raise EfaError(f'No IBAN: {", ".join(bad)}')
    return ignore


def dlp_set(args):
    """What happens to outgoing mail with card numbers or IBANs, and the own IBANs that may leave."""
    state = _json_read(OUTBOUND_FILE, {})
    dlp = {**DLP_DEFAULTS, **state.get('dlp', {})}
    dlp['cards'] = _dlp_action(args.cards, dlp['cards'])
    dlp['iban'] = _dlp_action(args.iban, dlp['iban'])
    dlp['ids'] = _dlp_action(args.ids, dlp['ids'])
    if args.ignore is not None and args.ignore.strip() != '':
        dlp['ignore'] = _dlp_ignore(args.ignore)
    state['dlp'] = dlp
    _outbound_write(state)
    return dlp_status(None)


def dlp_rule_set(args):
    """An own rule: a search pattern in subject, text and text attachments of outgoing mail. Empty pattern removes the rule."""
    name, pattern = args.name.strip().lower(), (args.pattern or '').strip()
    if not DLP_NAME_RE.match(name) or name in ('cards', 'iban'):
        raise EfaError('Name: up to 32 small letters, digits, - or _, not cards or iban.')
    state = _json_read(OUTBOUND_FILE, {})
    dlp = {**DLP_DEFAULTS, **state.get('dlp', {})}
    rules = [rule for rule in dlp['rules'] if rule['name'] != name]
    if pattern:
        # A search pattern of the admin runs on every outgoing mail: short, and no nested repeats that can take forever.
        if len(pattern) > 200 or re.search(r'\([^)]*[+*}]\)[+*{]', pattern):
            raise EfaError('Pattern: up to 200 characters, without nested repeats such as (a+)+.')
        try:
            re.compile(pattern, re.I)
        except re.error as err:
            raise EfaError(f'Pattern does not work: {err}')
        rules.append({'name': name, 'pattern': pattern, 'action': _dlp_action(args.action, 'log')})
    if len(rules) > 50:
        raise EfaError('Up to 50 own rules.')
    dlp['rules'] = sorted(rules, key=lambda rule: rule['name'])
    state['dlp'] = dlp
    _outbound_write(state)
    return dlp_status(None)


def _pdf_passwords_write(passwords):
    fd = os.open(PDF_PASSWORDS + '.new', os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, 'w') as f:
        json.dump(passwords, f)
    os.replace(PDF_PASSWORDS + '.new', PDF_PASSWORDS)


def pdf_status(_args):
    """Mail as encrypted PDF: the keyword in the subject, and who has an agreed password (the passwords stay hidden)."""
    state = _json_read(OUTBOUND_FILE, {})
    agreed = sorted(_json_read(PDF_PASSWORDS, {})) if os.path.exists(PDF_PASSWORDS) else []
    if identity_now and identity_now['domains'] is not None:
        agreed = [item for item in agreed if item.rpartition('@')[2] in identity_now['domains']]
    return {'keyword': state.get('pdf', {}).get('keyword', ''), 'qpdf_installed': bool(shutil.which('qpdf')), 'agreed_passwords': agreed,
            'milter_in_chain': OUTBOUND_PORT in _milter_ports_now()}


def pdf_set(args):
    """The keyword in the subject that sends a mail as encrypted PDF; - for none. DLP rules can ask for it too (action encrypt)."""
    keyword = (args.keyword or '').strip()
    if keyword != '-' and not PDF_KEYWORD_RE.match(keyword):
        raise EfaError('Keyword: 3 to 30 characters without spaces, such as [secure]; - for none.')
    if keyword != '-' and not shutil.which('qpdf'):
        raise EfaError('Encryption needs qpdf: install the package qpdf first.')
    state = _json_read(OUTBOUND_FILE, {})
    state['pdf'] = {**state.get('pdf', {}), 'keyword': '' if keyword == '-' else keyword}
    _outbound_write(state)
    return pdf_status(None)


def pdf_password_set(args):
    """The password agreed with a recipient (address or whole domain), asked twice. Empty removes it: then the sender gets one per mail."""
    recipient = args.recipient.strip().lower()
    if not (DOMAIN_RE.match(recipient) or SENDER_RE.match(recipient)):
        raise EfaError('Recipient: a mail address or a domain.')
    first, second = _secrets(2, 'Password, then again')
    if first != second:
        raise EfaError(PASSWORD_DIFFER + ' Nothing was changed.')
    if first and len(first) < 10:
        raise EfaError('Password: at least 10 characters.')
    passwords = _json_read(PDF_PASSWORDS, {}) if os.path.exists(PDF_PASSWORDS) else {}
    if first:
        passwords[recipient] = first
    else:
        passwords.pop(recipient, None)
    _pdf_passwords_write(passwords)
    # systemd hands the file over at the start only.
    try:
        _platform().service_try_restart(OUTBOUND_UNIT)
    except Exception as err:  # the StepError of the platform layer
        raise EfaError(f'Saved, but the outbound milter did not restart: {err}')
    return pdf_status(None)


def links_status(_args):
    """The link check: on or off, the address links lead over, the domains left as they are. The key is never shown."""
    links = content_state()['links']
    return {key: value for key, value in links.items() if key != 'key'}


def links_set(args):
    """Rewrite links in incoming mail to the check of this server, which looks at them again on each click. Off by default."""
    state = content_state()
    links = state['links']
    links['enabled'] = _on_off(args.mode)
    base = (args.base or '').strip().rstrip('/') or links['base'] or uq_state().get('public_url', '')
    if links['enabled'] and not base:
        raise EfaError('The public https address of this server is needed, for the links.')
    links['base'] = https_url(base) if base else ''
    if (args.allow_continue or '').strip():
        links['continue'] = _on_off(args.allow_continue)
    unchecked = (getattr(args, 'unchecked', '') or '').strip()
    if unchecked:
        if unchecked not in LINK_UNCHECKED:
            raise EfaError('When rspamd does not answer: page, follow or block.')
        links['unchecked'] = unchecked
    for field, change in (('add', set.union), ('remove', set.difference)):
        items = {item.strip().lower() for item in (getattr(args, field, '') or '').replace(',', ' ').split()}
        if any(not DOMAIN_RE.match(item) for item in items):
            raise EfaError('Exceptions are domains, such as partner.example.')
        links['exceptions'] = sorted(change(set(links['exceptions']), items))
    links.setdefault('key', secrets.token_hex(32))
    _content_apply(state)
    return links_status(None)


def _qpdf_install(platform_now):
    """qpdf from the repository, only it and what it needs, and only if no package script would touch firewalld."""
    if platform_now.package_installed('qpdf'):
        return 'present'
    if update_window_wait(datetime.datetime.now()):
        raise EfaError(f'qpdf is installed only between minute {UPDATE_WINDOW[0]} and {UPDATE_WINDOW[1]}, like every package.')
    folder = tempfile.mkdtemp(prefix='efa-qpdf-', dir='/var/tmp')
    try:
        files = platform_now.package_fetch(['qpdf'], folder)
        risky = [line for path in files for line in firewall_script_lines(platform_now.package_scripts(path))]
        if risky:
            raise EfaError(f'Not installed: a package script would touch firewalld: {risky[0][:160]}')
        platform_now.package_install(files)
    finally:
        shutil.rmtree(folder, ignore_errors=True)
    return 'installed'


def cdr_set(args):
    """Switch content disarm. On installs qpdf if needed, starts the milter and puts it right after rspamd."""
    on = _on_off(args.mode)
    qpdf = None
    if on:
        try:
            qpdf = _qpdf_install(_platform())
        except EfaError:
            raise
        except Exception as err:  # the StepError of the platform layer
            raise EfaError(str(err))
    state = content_state()
    state['cdr'] = on
    _content_apply(state)
    return {**cdr_status(None), 'qpdf_install': qpdf}


def cdr_list(_args):
    """Originals of disarmed mail, newest first: sender, recipients and what was done."""
    rows = []
    for path in sorted(glob.glob(CDR_STORE + '/*.json'), reverse=True)[:200]:
        info = _json_read(path, {})
        rows.append({'id': os.path.basename(path)[:-5], 'ts': info.get('ts'), 'sender': info.get('sender'), 'rcpts': ', '.join(info.get('rcpts', [])),
                     'done': '; '.join(info.get('done', []))})
    return {'originals': rows}


def cdr_release(args):
    """Deliver the original of a disarmed mail, unchanged, to its recipients. It does not pass the filters again."""
    _confirm(args)
    key = args.id.strip()
    if not CDR_KEY_RE.match(key) or not os.path.exists(f'{CDR_STORE}/{key}.json'):
        raise EfaError('No such original.')
    info = _json_read(f'{CDR_STORE}/{key}.json', {})
    rcpts = [rcpt for rcpt in info.get('rcpts', []) if SENDER_RE.match(rcpt)]
    if not rcpts:
        raise EfaError('The original names no recipient.')
    with open(f'{CDR_STORE}/{key}.eml', 'rb') as f:
        done = subprocess.run(['sendmail', '-i', '-f', info.get('sender') or '', '--', *rcpts], stdin=f, capture_output=True, timeout=60)
    if done.returncode != 0:
        raise EfaError(f'sendmail failed: {done.stderr.decode("utf-8", "replace")[-200:]}')
    for ending in ('.eml', '.json'):
        os.remove(f'{CDR_STORE}/{key}{ending}')
    _audit(f'disarmed original {key} delivered to {", ".join(rcpts)} by {_dmarc_who()}')
    return {'delivered': key, 'rcpts': rcpts}


def _cdr_job():
    """Hourly: originals older than the days to keep are removed."""
    cutoff = time.time() - retention('cdr') * 86400
    for path in glob.glob(CDR_STORE + '/*.json'):
        if os.path.getmtime(path) < cutoff:
            for item in (path, path[:-5] + '.eml'):
                if os.path.exists(item):
                    os.remove(item)


# The neural network of rspamd: it learns from mail with clear scores by itself. eFa only sets how much and how strongly.
NEURAL_CONF = RSPAMD_DIR + '/local.d/neural.conf'
NEURAL_GROUP_CONF = RSPAMD_DIR + '/local.d/neural_group.conf'
NEURAL_DEFAULTS = {'enabled': None, 'max_trains': 1000, 'max_usages': 20, 'score_spam': 3.0, 'score_ham': -2.0}
NEURAL_FILE = ETC + '/eFa/neural.json'
TRAIN_PER_DAY = 50


def neural_state():
    return {**NEURAL_DEFAULTS, **_json_read(NEURAL_FILE, {})}


def neural_texts(state):
    """The rspamd settings of the neural module and the scores of its two symbols."""
    conf = (f"enabled = {'true' if state['enabled'] else 'false'};\nrules {{\n  default {{\n    train {{\n"
            f"      max_trains = {state['max_trains']};\n      max_usages = {state['max_usages']};\n    }}\n"
            f'    symbol_spam = "NEURAL_SPAM";\n    symbol_ham = "NEURAL_HAM";\n  }}\n}}\n')
    group = (f'symbols = {{\n  "NEURAL_SPAM" {{ weight = {state["score_spam"]}; description = "Neural network: spam"; }}\n'
             f'  "NEURAL_HAM" {{ weight = {state["score_ham"]}; description = "Neural network: ham"; }}\n}}\n')
    return conf, group


def neural_status(_args):
    """The neural network: on or off, how many mails it has collected to learn from, and whether it has learned."""
    state = neural_state()
    sets, trained = {}, 0
    done = subprocess.run(['redis-cli', '--raw', '--scan', '--pattern', 'rn_*'], capture_output=True, text=True, timeout=30)
    for key in done.stdout.split():
        if key.endswith(('_spam_set', '_ham_set')):
            size = subprocess.run(['redis-cli', '--raw', 'SCARD', key], capture_output=True, text=True, timeout=30).stdout.strip()
            kind = 'spam' if key.endswith('_spam_set') else 'ham'
            sets[kind] = sets.get(kind, 0) + int(size or 0)
        else:
            trained += 1
    return {**state, 'enabled': state['enabled'] if state['enabled'] is not None else 'rspamd default', 'collected_spam': sets.get('spam', 0),
            'collected_ham': sets.get('ham', 0), 'trained_networks': trained,
            'note': 'It learns once it has collected max_trains mails of each kind, then again as new ones come.'}


def neural_settings(_args):
    """The settings of the neural network from the configuration of eFa only: for the form, without counting in redis."""
    state = neural_state()
    return {**state, 'enabled': state['enabled'] if state['enabled'] is not None else 'rspamd default'}


def neural_set(args):
    """Switch the neural network and set how much it collects before it learns, and the weight of its result."""
    state = neural_state()
    state['enabled'] = _on_off(args.mode)
    for key, low, high, kind in (('max_trains', 100, 100000, int), ('max_usages', 1, 1000, int), ('score_spam', 0, 20, float), ('score_ham', -20, 0, float)):
        value = (getattr(args, key, '') or '').strip()
        if value:
            try:
                number = kind(value)
            except ValueError:
                raise EfaError(f'{key}: a number.')
            if not low <= number <= high:
                raise EfaError(f'{key}: {low} to {high}.')
            state[key] = number
    conf, group = neural_texts(state)
    old = [open(path).read() if os.path.exists(path) else None for path in (NEURAL_CONF, NEURAL_GROUP_CONF)]
    _write(NEURAL_CONF, conf)
    _write(NEURAL_GROUP_CONF, group)
    if not _rspamd_config_ok():
        for path, text in zip((NEURAL_CONF, NEURAL_GROUP_CONF), old):
            if text is None:
                os.remove(path)
            else:
                _write(path, text)
        raise EfaError('rspamd rejected the settings, nothing changed.')
    _json_write(NEURAL_FILE, state)
    _reload_rspamd()
    return neural_status(None)


def _train_message(source, ref):
    """The raw mail a training request is about: held mail of a user, mail in the quarantine of the mail queue, or a reported one."""
    if source == 'phish':
        rows = _admin_query("SELECT raw FROM train_requests WHERE id = %s AND source = 'phish'", (int(ref),)) if str(ref).isdigit() else []
        if not rows or not rows[0]['raw']:
            raise EfaError('The reported mail is gone.')
        raw = zlib.decompress(rows[0]['raw'])
        head = raw.split(b'\n\n', 1)[0].decode('utf-8', 'replace')
        sender = re.search(r'^From:\s*(.*)$', head, re.M | re.I)
        subject = re.search(r'^Subject:\s*(.*)$', head, re.M | re.I)
        return raw, sender.group(1)[:255] if sender else '', subject.group(1)[:500] if subject else ''
    if source == 'uq':
        item = _uq_item(ref, None, ('held', 'requested', 'released', 'deleted'))
        with open(_uq_path(item['mail_id']), 'rb') as f:
            return f.read(), item['sender'], item['subject']
    if not re.fullmatch(r'[A-Za-z0-9]{5,20}', ref):
        raise EfaError('Invalid queue ID.')
    done = subprocess.run(['postcat', '-hbq', ref], capture_output=True, timeout=30)
    if done.returncode != 0:
        raise EfaError('This mail is not in quarantine.')
    head = done.stdout.split(b'\n\n', 1)[0].decode('utf-8', 'replace')
    sender = re.search(r'^From:\s*(.*)$', head, re.M | re.I)
    subject = re.search(r'^Subject:\s*(.*)$', head, re.M | re.I)
    return done.stdout, sender.group(1)[:255] if sender else '', subject.group(1)[:500] if subject else ''


# Phishing reports: addresses of the domains go to a pipe that keeps the reported mails for the decision of an admin.
PHISH_FILE = ETC + '/eFa/phish.json'
PHISH_TRANSPORT = ETC + '/postfix/efa-phish-transport'
PHISH_SERVICE = 'efa-phish'
PHISH_MASTER = 'efa-phish unix - n n - 4 pipe flags=Rq user=efa-web argv=/usr/bin/python3 /usr/local/sbin/efa-phish.py ${sender}'
PHISH_KEEP_DAYS = 30
BANNER_DEFAULTS = {'enabled': False, 'text': '', 'unsigned_only': True, 'exceptions': []}


def phish_set(args):
    """A report address of a domain, such as phishing@example.org: users forward suspicious mail there, an admin decides."""
    action, address = args.action.strip(), (args.address or '').strip().lower()
    if action not in ('add', 'remove') or not SENDER_RE.match(address):
        raise EfaError("Action 'add' or 'remove', and an address such as phishing@example.org.")
    if identity_now and identity_now['domains'] is not None and address.rpartition('@')[2] not in identity_now['domains']:
        raise EfaError('Not allowed: name one of your own domains.')
    state = _json_read(PHISH_FILE, {'addresses': []})
    addresses = set(state['addresses'])
    addresses = addresses | {address} if action == 'add' else addresses - {address}
    state['addresses'] = sorted(addresses)
    if state['addresses']:
        subprocess.run(['postconf', '-M', f'{PHISH_SERVICE}/unix={PHISH_MASTER}'], check=True, capture_output=True)
    _rule_map(PHISH_TRANSPORT, [f'{item} {PHISH_SERVICE}:' for item in state['addresses']])
    if not state['addresses']:
        subprocess.run(['postconf', '-MX', f'{PHISH_SERVICE}/unix'], check=False, capture_output=True)
    wanted = rule_map_value(_postconf('transport_maps'), PHISH_TRANSPORT, bool(state['addresses']))
    if wanted != _postconf('transport_maps'):
        _postconf_set('transport_maps', wanted)
    subprocess.run(['postfix', 'reload'], check=False, capture_output=True)
    _json_write(PHISH_FILE, state)
    return {'addresses': state['addresses'], 'note': 'Reports appear under Spam reports; Bayes learns from the ones an admin approves.'}


def _milter_ports():
    """The milter ports Postfix calls (inet:127.0.0.1:PORT in smtpd_milters), without the health milter itself."""
    out = subprocess.run(['postconf', '-h', 'smtpd_milters'], capture_output=True, text=True).stdout
    return [p for p in re.findall(r'inet:127\.0\.0\.1:(\d+)', out) if p != '8999']


def milter_health_status(_args):
    """Which milters turn mail away when they are down (tempfail), and which only let it pass (accept, the default)."""
    chosen = set(_json_read(MILTER_HEALTH_FILE, {}).get('tempfail', []))
    ports = _milter_ports()
    return {'milter_default_action': 'accept', 'milters': [{'port': p, 'action': 'tempfail' if p in chosen else 'accept'} for p in ports],
            'tempfail': sorted(p for p in chosen if p in ports)}


def milter_health_set(args):
    """Per milter: accept (let mail pass when it is down, the default) or tempfail (turn mail away with a retryable 4xx)."""
    port, action = (args.milter or '').strip(), (args.action or '').strip()
    if port not in _milter_ports():
        raise EfaError('Name a milter port that Postfix calls. See milter-health-status.')
    if action not in ('accept', 'tempfail'):
        raise EfaError("Action must be 'accept' or 'tempfail'.")
    chosen = {p for p in _json_read(MILTER_HEALTH_FILE, {}).get('tempfail', []) if p in _milter_ports()}
    chosen = chosen | {port} if action == 'tempfail' else chosen - {port}
    _json_write(MILTER_HEALTH_FILE, {'tempfail': sorted(chosen)})
    os.chmod(MILTER_HEALTH_FILE, 0o640)
    try:
        shutil.chown(MILTER_HEALTH_FILE, 'root', 'efa-mail')
    except (OSError, LookupError):
        pass  # on the host it is root:efa-mail; the mode 0640 is the guard
    return milter_health_status(None)


def banner_set(args):
    """A warning at the top of incoming mail from outside. By default only on mail without a valid DKIM signature, so no signature breaks."""
    state = content_state()
    banner = {**BANNER_DEFAULTS, **state.get('banner', {})}
    banner['enabled'] = _on_off(args.mode)
    text = ' '.join((args.text or '').split())
    if text:
        if len(text) > 300 or any(ch in text for ch in '<>'):
            raise EfaError('Banner text: up to 300 characters, no < or >.')
        banner['text'] = text
    if (args.unsigned_only or '').strip():
        banner['unsigned_only'] = _on_off(args.unsigned_only)
    for field, change in (('add', set.union), ('remove', set.difference)):
        items = {item.strip().lower() for item in (getattr(args, field, '') or '').replace(',', ' ').split()}
        if any(not DOMAIN_RE.match(item) for item in items):
            raise EfaError('Exceptions are domains, such as partner.example.')
        banner['exceptions'] = sorted(change(set(banner['exceptions']), items))
    state['banner'] = banner
    _content_apply(state)
    return banner


def _phish_job():
    """Hourly: the mails of reports past their days are removed; the rows of the decisions stay."""
    _admin_query("UPDATE train_requests SET raw = NULL WHERE source = 'phish' AND raw IS NOT NULL AND ts < NOW() - INTERVAL %s DAY", (retention('phish'),))


def train_request(args):
    """Report a held mail as spam or as wanted. An admin decides; after that Bayes learns from it."""
    source, ref, verdict = args.source.strip(), args.id.strip(), args.verdict.strip()
    if source not in ('uq', 'quarantine') or verdict not in ('spam', 'ham'):  # phishing reports come from the pipe only
        raise EfaError("Source 'uq' or 'quarantine', verdict 'spam' or 'ham'.")
    if source == 'uq':
        _uq_item(ref, identity_now, ('held', 'requested'))
    elif identity_now and 'quarantine.view' not in identity_now['grants']:
        raise EfaError('Not allowed: this needs the permission quarantine.view.')
    username = identity_now['username'] if identity_now else (acting_user or 'admin')
    today = _admin_query('SELECT COUNT(*) AS n FROM train_requests WHERE username = %s AND ts >= CURDATE()', (username,))[0]['n']
    if today >= TRAIN_PER_DAY:
        raise EfaError(f'At most {TRAIN_PER_DAY} reports a day.')
    if _admin_query("SELECT 1 FROM train_requests WHERE source = %s AND ref = %s AND state = 'pending' LIMIT 1", (source, ref)):
        raise EfaError('This mail is reported already.')
    _raw, sender, subject = _train_message(source, ref)
    _admin_query('INSERT INTO train_requests (username, source, ref, sender, subject, verdict) VALUES (%s, %s, %s, %s, %s, %s)',
                 (username, source, ref, sender, subject, verdict))
    return {'reported': ref, 'verdict': verdict, 'note': 'An admin decides; then the spam filter learns from it.'}


def train_list(args):
    """Reports waiting for a decision, and the last ones decided."""
    state = (args.state or '').strip() or 'pending'
    if state not in ('pending', 'done', 'rejected'):
        raise EfaError("State 'pending', 'done' or 'rejected'.")
    return {'reports': _admin_query('SELECT id, CAST(ts AS CHAR) AS ts, username, source, ref, sender, subject, verdict, state, decided_by, result '
                                    'FROM train_requests WHERE state = %s ORDER BY id DESC LIMIT 200', (state,))}


def rspamc_learn_result(text):
    """The answer of rspamc learn_spam or learn_ham in a few words."""
    if 'already learned' in text:
        return 'learned before'
    if re.search(r'success\s*=\s*true', text):
        return 'learned'
    error = re.search(r'error\s*=\s*"?([^";\n]+)', text)
    return error.group(1)[:250] if error else (text.strip().splitlines() or ['no answer'])[-1][:250]


def train_decide(args):
    """Approve a report, so Bayes learns from the mail, or reject it. The mail itself stays where it is."""
    if not str(args.id).strip().isdigit():
        raise EfaError('Invalid ID.')
    rows = _admin_query("SELECT * FROM train_requests WHERE id = %s AND state = 'pending'", (int(args.id),))
    if not rows:
        raise EfaError('No such report waiting.')
    row, decision = rows[0], args.decision.strip()
    if decision not in ('approve', 'reject'):
        raise EfaError("Decision 'approve' or 'reject'.")
    result = 'rejected'
    if decision == 'approve':
        raw, _sender, _subject = _train_message(row['source'], row['id'] if row['source'] == 'phish' else row['ref'])
        done = subprocess.run(['rspamc', 'learn_spam' if row['verdict'] == 'spam' else 'learn_ham'], input=raw, capture_output=True, timeout=60)
        result = rspamc_learn_result((done.stdout + done.stderr).decode('utf-8', 'replace'))
        if done.returncode != 0 and result != 'learned before':
            raise EfaError(f'Bayes did not learn it: {result}')
    features = json.dumps(rspamc_symbols(raw)) if decision == 'approve' else None
    _admin_query('UPDATE train_requests SET state = %s, decided_by = %s, decided = NOW(), result = %s, features = %s WHERE id = %s',
                 ('done' if decision == 'approve' else 'rejected', _dmarc_who()[:120], result, features, row['id']))
    return {'report': row['id'], 'decision': decision, 'result': result}


# A small model of its own: logistic regression over the rspamd symbols of the reports admins approved. Standard library only.
ML_FILE = ETC + '/eFa/ml.json'
ML_MODEL = RSPAMD_DIR + '/efa-ml.json'
ML_LUA = RSPAMD_DIR + '/efa-ml.lua'
ML_LOAD_LINE = ("do local ok, err = pcall(dofile, '" + ML_LUA + "'); if not ok then require('rspamd_logger').errx(rspamd_config, 'efa-ml: %s', err) end end "
                "-- efa-ml\n")
ML_DEFAULTS = {'enabled': False, 'min_each': 20, 'score': 4.0, 'trained': None, 'samples': 0}
ML_OWN = ('EFA_ML_SPAM', 'EFA_ML_HAM')
ML_LUA_TEXT = r'''-- Written by efactl ml-train. Do not edit.
-- The model of efactl ml-train: a weight per rspamd symbol; very sure spam or ham adds its score, scaled by how sure.
local ucl = require 'ucl'
local parser = ucl.parser()
if not parser:parse_file('/etc/rspamd/efa-ml.json') then return end
local model = parser:get_object()
local SCORE = %(score)s
rspamd_config:register_symbol({name = 'EFA_ML_SPAM', score = SCORE, group = 'efa_ml', type = 'virtual', parent = -1})
rspamd_config:register_symbol({name = 'EFA_ML_HAM', score = -SCORE, group = 'efa_ml', type = 'virtual', parent = -1})
rspamd_config:register_symbol({name = 'EFA_ML', type = 'postfilter', priority = 5, callback = function(task)
  local z = model.bias or 0
  for _, symbol in ipairs(task:get_symbols_all() or {}) do
    if symbol.name ~= 'EFA_ML_SPAM' and symbol.name ~= 'EFA_ML_HAM' then z = z + (model.weights[symbol.name] or 0) end
  end
  local p = 1 / (1 + math.exp(-z))
  if p >= 0.9 then task:insert_result('EFA_ML_SPAM', (p - 0.5) * 2, string.format('%%.2f', p))
  elseif p <= 0.1 then task:insert_result('EFA_ML_HAM', (0.5 - p) * 2, string.format('%%.2f', p)) end
end})
'''


def ml_train_model(samples, rounds=200, rate=0.1, l2=0.01):
    """Logistic regression by gradient descent. samples: [(symbols, 1 for spam or 0 for ham)]. Returns bias and weights."""
    import math
    weights, bias = {}, 0.0
    for _ in range(rounds):
        for symbols, label in samples:
            z = bias + sum(weights.get(name, 0.0) for name in symbols)
            error = (1 / (1 + math.exp(-max(-30, min(30, z))))) - label
            bias -= rate * error
            for name in symbols:
                weights[name] = weights.get(name, 0.0) - rate * (error + l2 * weights.get(name, 0.0))
    return {'bias': round(bias, 4), 'weights': {name: round(value, 4) for name, value in weights.items() if abs(value) >= 0.001}}


def ml_state():
    return {**ML_DEFAULTS, **_json_read(ML_FILE, {})}


def _ml_samples():
    rows = _admin_query("SELECT verdict, features FROM train_requests WHERE state = 'done' AND features IS NOT NULL")
    samples = []
    for row in rows:
        try:
            symbols = [name for name in json.loads(row['features']) if name not in ML_OWN]
        except ValueError:
            continue
        samples.append((symbols, 1 if row['verdict'] == 'spam' else 0))
    return samples


def ml_status(_args):
    """The own model: on or off, how many approved reports it can learn from, and when it learned last."""
    state = ml_state()
    samples = _ml_samples()
    return {**state, 'spam_reports': sum(1 for _s, label in samples if label), 'ham_reports': sum(1 for _s, label in samples if not label)}


def ml_settings(_args):
    """The settings of the own model from the configuration of eFa only: for the form, without reading the reports."""
    return ml_state()


def ml_train(_args=None):
    """Learn from the approved reports and give the model to rspamd. Needs min_each spam and ham reports."""
    state, samples = ml_state(), _ml_samples()
    spam, ham = sum(1 for _s, label in samples if label), sum(1 for _s, label in samples if not label)
    if spam < state['min_each'] or ham < state['min_each']:
        raise EfaError(f"It needs {state['min_each']} approved spam and ham reports each, there are {spam} and {ham}.")
    _write(ML_MODEL, json.dumps(ml_train_model(samples)))
    state.update(trained=time.strftime('%Y-%m-%d %H:%M:%S'), samples=len(samples))
    _ml_apply(state)
    return ml_status(None)


def _ml_apply(state):
    with open(RSPAMD_LOCAL_LUA) as f:
        before = f.read()
    text = re.sub(r'^.*-- efa-ml\n', '', before, flags=re.M)
    if state['enabled'] and os.path.exists(ML_MODEL):
        _write(ML_LUA, ML_LUA_TEXT % {'score': state['score']})
        text = text.rstrip('\n') + '\n' + ML_LOAD_LINE
    _write(RSPAMD_LOCAL_LUA, text)
    if not _rspamd_config_ok():
        _write(RSPAMD_LOCAL_LUA, before)
        raise EfaError('rspamd rejected the model, nothing changed.')
    _json_write(ML_FILE, state)
    _reload_rspamd()


def ml_set(args):
    """Switch the own model, the reports it needs of each kind, and its score. Off by default."""
    state = ml_state()
    state['enabled'] = _on_off(args.mode)
    for key, low, high, kind in (('min_each', 5, 10000, int), ('score', 0.5, 20, float)):
        value = (getattr(args, key, '') or '').strip()
        if value:
            try:
                number = kind(value)
            except ValueError:
                raise EfaError(f'{key}: a number.')
            if not low <= number <= high:
                raise EfaError(f'{key}: {low} to {high}.')
            state[key] = number
    _ml_apply(state)
    return ml_status(None)


def rspamc_symbols(raw):
    """The rspamd symbols of a mail, for the model."""
    done = subprocess.run(['rspamc', '--json', 'symbols'], input=raw, capture_output=True, timeout=60)
    try:
        reply = json.loads(done.stdout.decode('utf-8', 'replace'))
    except ValueError:
        return []
    return sorted((reply.get('default') or reply).get('symbols', {}).keys()) if isinstance(reply, dict) else []


def bec_state():
    state = {**BEC_DEFAULTS, **_json_read(BEC_FILE, {})}
    state['scores'] = {**BEC_DEFAULTS['scores'], **state.get('scores', {})}
    return state


def _own_domains():
    """Domains this server takes mail for or signs: what a lookalike would imitate."""
    found = {line.split()[0].lower() for line in _read_lines(TRANSPORT) if line.split() and DOMAIN_RE.match(line.split()[0].lower())}
    found |= set(_dkim_conf_domains())
    try:
        found |= {domain for domains in _tenant_domains().values() for domain in domains}
    except Exception:  # no database yet: the files are enough
        pass
    return found


def bec_conf(state, own):
    """The settings rspamd reads: protected domains, VIPs, scores."""
    return {'protected': sorted(set(own) | set(state['partners'])), 'vips': state['vips'], 'scores': state['scores'],
            'relation_days': state['relation_days'], 'style_min': state['style_min'], 'phrases': BEC_PHRASES, 'young_days': state['young_days']}


def rdap_servers(bootstrap):
    """The IANA bootstrap file to a map ending -> RDAP base address; only https servers."""
    found = {}
    for endings, urls in bootstrap.get('services', []):
        base = next((url for url in urls if url.startswith('https://')), None)
        if base:
            for ending in endings:
                found[ending.lower()] = base if base.endswith('/') else base + '/'
    return found


def _rdap_refresh():
    """Fetches the RDAP servers of the registries from IANA, once a day while the domain age counts."""
    if os.path.exists(RDAP_MAP) and time.time() - os.path.getmtime(RDAP_MAP) < 86400:
        return False
    with urllib.request.urlopen(RDAP_BOOTSTRAP, timeout=30) as reply:
        servers = rdap_servers(json.loads(reply.read()))
    if len(servers) < 100:
        raise EfaError('The RDAP list of IANA looks incomplete, the old one stays.')
    _write(RDAP_MAP, json.dumps(servers))
    return True


def _bec_apply(state):
    with open(RSPAMD_LOCAL_LUA) as f:
        before = f.read()
    # Every line with the mark, also one an older version wrote.
    text = re.sub(r'^.*-- efa-bec\n', '', before, flags=re.M)
    if state['enabled']:
        _write(BEC_CONF, json.dumps(bec_conf(state, _own_domains()), indent=1))
        _write(BEC_LUA, BEC_LUA_TEXT)
        text = text.rstrip('\n') + '\n' + BEC_LOAD_LINE
    _write(RSPAMD_LOCAL_LUA, text)
    if not _rspamd_config_ok():
        _write(RSPAMD_LOCAL_LUA, before)
        raise EfaError('rspamd rejected the BEC settings, nothing changed.')
    _json_write(BEC_FILE, state)
    _reload_rspamd()


def bec_status(_args):
    """Impersonation and BEC checks: switch, VIPs, partner domains, scores, and the own domains they protect."""
    state = bec_state()
    return {**state, 'own_domains': sorted(_own_domains())}


def bec_set(args):
    """Switch the BEC checks and set their scores. Off by default."""
    state = bec_state()
    state['enabled'] = _on_off(args.mode)
    for key in ('vip', 'lookalike', 'first_contact', 'style', 'language', 'young_domain'):
        value = (getattr(args, f'score_{key}', '') or '').strip()
        if value:
            try:
                score = float(value)
            except ValueError:
                raise EfaError('Scores must be numbers.')
            if not -20 <= score <= 50:
                raise EfaError('Scores: -20 to 50.')
            state['scores'][key] = score
    days = (args.relation_days or '').strip()
    if days:
        if not days.isdigit() or not 30 <= int(days) <= 3650:
            raise EfaError('Days a mail relation counts: 30 to 3650.')
        state['relation_days'] = int(days)
    young = (getattr(args, 'young_days', '') or '').strip()
    if young:
        if not young.isdigit() or not 1 <= int(young) <= 365:
            raise EfaError('A domain counts as young for 1 to 365 days.')
        state['young_days'] = int(young)
    if state['enabled'] and state['scores']['young_domain']:
        try:
            _rdap_refresh()
        except (OSError, ValueError) as err:
            raise EfaError(f'The RDAP list of IANA could not be fetched: {err}')
    _bec_apply(state)
    return bec_status(None)


def bec_vip_set(args):
    """A VIP: their name in the display name with any other address counts as impersonation."""
    state, action = bec_state(), args.action.strip()
    name, address = ' '.join((args.name or '').split()), (args.address or '').strip().lower()
    if action not in ('add', 'remove') or not 3 <= len(name) <= 100 or any(ch in name for ch in '\r\n\0"\\'):
        raise EfaError("Action 'add' or 'remove', and a name of 3 to 100 characters.")
    vips = [vip for vip in state['vips'] if vip['name'].lower() != name.lower()]
    if action == 'add':
        if not SENDER_RE.match(address):
            raise EfaError('The real address of the VIP is needed.')
        vips.append({'name': name, 'address': address})
    elif len(vips) == len(state['vips']):
        raise EfaError('No such VIP.')
    state['vips'] = sorted(vips, key=lambda vip: vip['name'].lower())
    _bec_apply(state)
    return {'vips': state['vips']}


def bec_partner_set(args):
    """A partner domain is protected like an own one: lookalikes of it count."""
    state, action, domain = bec_state(), args.action.strip(), args.domain.strip().lower()
    if action not in ('add', 'remove') or not DOMAIN_RE.match(domain):
        raise EfaError("Action 'add' or 'remove', and a domain.")
    if action == 'add':
        state['partners'] = sorted(set(state['partners']) | {domain})
    elif domain in state['partners']:
        state['partners'].remove(domain)
    else:
        raise EfaError('No such partner domain.')
    _bec_apply(state)
    return {'partners': state['partners']}


def uq_set(args):
    """Store mail above the limit and viruses instead of rejecting them. Users release it themselves, by digest mail or login."""
    state, enabled = uq_state(), _on_off(args.mode)
    try:
        score, days = float((args.score or '').strip() or state['score']), int((args.days or '').strip() or state['days'])
    except ValueError:
        raise EfaError('Limit and days must be numbers.')
    if not 1 <= score <= 1000 or not 1 <= days <= 3650:
        raise EfaError('Limit: 1 to 1000. Days: 1 to 3650.')
    public_url = (args.public_url or '').strip().rstrip('/') or state['public_url']
    https_url(public_url)
    digest = (args.digest or '').strip() or ('on' if state['digest'] else 'off')
    self_release = (args.self_release or '').strip() or ('on' if state['self_release'] else 'off')
    state.update(enabled=enabled, score=score, days=days, digest=_on_off(digest), self_release=_on_off(self_release), public_url=public_url)
    if state['digest'] and not public_url:
        raise EfaError('The digest needs the public address of this server, for its links.')
    with open(RSPAMD_LOCAL_LUA) as f:
        before = f.read()
    text = before.replace(UQ_LOAD_LINE, '')
    if enabled:
        actions = open(ACTIONS_CONF).read() if os.path.exists(ACTIONS_CONF) else ''
        if ACTION_DISCARD not in actions:
            _write(ACTIONS_CONF, actions.rstrip('\n') + ('\n' if actions else '') + ACTION_DISCARD)
        os.makedirs(UQ_DIR, mode=0o700, exist_ok=True)
        shutil.chown(UQ_DIR, 'efa-mail', 'efa-mail')
        _write(UQ_LUA, UQ_LUA_TEXT % {'score': score})
        text = text.rstrip('\n') + '\n' + UQ_LOAD_LINE
    _write(RSPAMD_LOCAL_LUA, text)
    if not _rspamd_config_ok():
        _write(RSPAMD_LOCAL_LUA, before)
        raise EfaError('rspamd rejected the settings, nothing changed.')
    _json_write(UQ_FILE, state)
    # The writer may only reach a folder that exists when it starts.
    subprocess.run(['systemctl', 'try-restart', 'efa-maillog'], check=False, capture_output=True)
    subprocess.run(['systemctl', 'try-reload-or-restart', 'rspamd'], check=False, capture_output=True)
    return state


def uq_mailbox(identity):
    """The one address of a plain user: the email of the entry, or a user name that is an address."""
    if identity is None:
        return None
    address = identity.get('email') or identity['username']
    return address.lower() if '@' in address else ''


def uq_scope(identity):
    """A WHERE part that limits quarantine rows to the caller. Values travel as parameters."""
    if identity is None:
        return '', []
    if 'quarantine.view' not in identity['grants']:
        return ' AND r.rcpt = %s', [uq_mailbox(identity) or '-']
    scope = identity['grants']['quarantine.view']
    if scope is None:
        return '', []
    if not scope['domains']:
        return ' AND FALSE', []
    domains = sorted(scope['domains'])
    return ' AND (' + ' OR '.join(['r.rcpt LIKE %s'] * len(domains)) + ')', ['%@' + domain for domain in domains]


def uq_can_release(identity, malware, self_release):
    """A virus only by a super-admin. Whether a user may release alone is a setting, otherwise the user asks."""
    if identity is None:
        return True
    if malware:
        return 'quarantine.release_malware' in identity['grants']
    return 'quarantine.release' in identity['grants'] or self_release


def uq_list(args):
    """Mail in quarantine: yours as a user, that of your domains as an admin."""
    limit = (args.limit or '').strip() or '200'
    if not limit.isdigit() or not 1 <= int(limit) <= 1000:
        raise EfaError('Limit must be 1 to 1000.')
    scope, params = uq_scope(identity_now)
    needle = (args.text or '').strip()
    if needle:
        scope += ' AND (m.sender LIKE %s OR r.rcpt LIKE %s OR m.subject LIKE %s)'
        pattern = '%' + search_pattern(needle) + '%'
        params = [*params, pattern, pattern, pattern]
    rows = _admin_query('SELECT r.id, r.rcpt, r.state, CAST(m.ts AS CHAR) AS ts, m.sender, m.subject, m.score, m.malware, m.size FROM quarantine_rcpt r '
                        "JOIN quarantine_mail m ON m.id = r.mail_id WHERE r.state IN ('held', 'requested')" + scope + ' ORDER BY m.ts DESC, r.id DESC LIMIT %s', (*params, int(limit)))
    return {'mails': rows, 'self_release': uq_state()['self_release']}


def _uq_item(item_id, identity=None, states=('held', 'requested')):
    """One quarantine row the caller may touch. Someone else's mail looks like a missing one."""
    if not str(item_id).strip().isdigit():
        raise EfaError('Invalid ID.')
    scope, params = uq_scope(identity)
    rows = _admin_query('SELECT r.id, r.mail_id, r.rcpt, r.state, m.sender, m.subject, m.score, m.malware FROM quarantine_rcpt r '
                        'JOIN quarantine_mail m ON m.id = r.mail_id WHERE r.id = %s' + scope, (int(item_id), *params))
    if not rows or rows[0]['state'] not in states:
        raise EfaError('This mail is not in quarantine.')
    return rows[0]


def _uq_path(mail_id):
    if not re.fullmatch(r'[0-9a-f]{32}', mail_id):
        raise EfaError('Invalid mail.')
    return f'{UQ_DIR}/{mail_id}.eml'


def _uq_mark(item, state, who):
    _admin_query('UPDATE quarantine_rcpt SET state = %s, changed = NOW(), changed_by = %s WHERE id = %s', (state, who[:120], item['id']))
    _event(f'quarantine_{state}', 'notice', user=who, rcpt=item['rcpt'], sender=item['sender'], malware=bool(item['malware']))
    left = _admin_query("SELECT 1 FROM quarantine_rcpt WHERE mail_id = %s AND state IN ('held', 'requested') LIMIT 1", (item['mail_id'],))
    if not left and os.path.exists(_uq_path(item['mail_id'])):
        os.remove(_uq_path(item['mail_id']))


def uq_show(args):
    """The headers of a mail in quarantine. The body stays closed: it may be harmful."""
    item = _uq_item(args.id, identity_now)
    with open(_uq_path(item['mail_id']), 'rb') as f:
        head = f.read(65536).decode('utf-8', 'replace')
    qid = _admin_query('SELECT qid FROM quarantine_mail WHERE id = %s', (item['mail_id'],))
    return {'id': item['id'], 'rcpt': item['rcpt'], 'verdict': _verdict_by_qid(qid[0]['qid'] if qid else ''),
            'headers': re.split(r'\r?\n\r?\n', head, maxsplit=1)[0][:20000]}


CONTENT_LIMIT = 100 * 1024
CONTENT_MORE = 1024 * 1024


class _HtmlText(html.parser.HTMLParser):
    """HTML as plain text: no scripts or styles, links as 'text [URL]', nothing loaded."""
    BLOCKS = {'p', 'div', 'br', 'tr', 'li', 'h1', 'h2', 'h3', 'h4', 'table', 'blockquote'}

    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.parts, self.skip, self.links = [], 0, []

    def handle_starttag(self, tag, attrs):
        if tag in ('script', 'style', 'head', 'title'):
            self.skip += 1
        elif tag in self.BLOCKS:
            self.parts.append('\n')
        if tag == 'a':
            self.links.append(dict(attrs).get('href') or '')

    def handle_endtag(self, tag):
        if tag in ('script', 'style', 'head', 'title'):
            self.skip = max(0, self.skip - 1)
        elif tag == 'a' and self.links:
            target = self.links.pop()
            if target and not target.startswith('#'):
                self.parts.append(f' [{target}]')

    def handle_data(self, data):
        if not self.skip:
            self.parts.append(data)


def html_text(markup):
    parser = _HtmlText()
    parser.feed(markup)
    parser.close()
    return re.sub(r'\n\s*\n+', '\n\n', re.sub(r'[ \t]+', ' ', ''.join(parser.parts))).strip()


def mail_text(raw, limit=CONTENT_LIMIT):
    """The readable text of a mail, never as HTML: the plain part, or the HTML part as text. Attachments only as a list."""
    message = email.parser.BytesParser(policy=email.policy.default).parsebytes(raw)
    body, source = message.get_body(preferencelist=('plain', 'html')), 'none'
    text = ''
    if body is not None:
        try:
            text = body.get_content()
        except (LookupError, UnicodeError, KeyError):
            text = (body.get_payload(decode=True) or b'').decode('utf-8', 'replace')
        source = body.get_content_type()
        if source == 'text/html':
            text = html_text(text)
    text = ''.join(ch if ch in '\n\t' or ch >= ' ' else ' ' for ch in text.replace('\r\n', '\n')).rstrip()
    attachments = []
    for part in message.iter_attachments():
        payload = part.get_payload(decode=True) or b''
        name = re.sub(r'[\x00-\x1f\x7f]', '', str(part.get_filename() or '(no name)'))[:200]
        attachments.append({'name': name, 'type': part.get_content_type(), 'size': len(payload)})
    return {'text': text[:limit], 'cut': len(text) > limit, 'source': source, 'attachments': attachments}


def uq_content(args):
    """The text of a held mail, to judge it before a release. Never shown as HTML, no attachment opens."""
    item = _uq_item(args.id, identity_now)
    with open(_uq_path(item['mail_id']), 'rb') as f:
        raw = f.read(64 * 1024 * 1024)
    return {'id': item['id'], 'rcpt': item['rcpt'], **mail_text(raw, CONTENT_MORE if (args.more or '').strip() == 'yes' else CONTENT_LIMIT)}


def quarantine_content(args):
    """The text of a mail in the quarantine of the mail queue."""
    queue_id = _held_id(args)
    done = subprocess.run(['postcat', '-bhq', queue_id], capture_output=True, check=True, timeout=60)
    return {'id': queue_id, **mail_text(done.stdout[:64 * 1024 * 1024], CONTENT_MORE if (args.more or '').strip() == 'yes' else CONTENT_LIMIT)}


def _uq_deliver(item):
    """Back to the mail server for this one recipient. Not through the filters again: they would stop it again."""
    with open(_uq_path(item['mail_id']), 'rb') as f:
        done = subprocess.run(['sendmail', '-G', '-i', '-f', item['sender'] or '<>', '--', item['rcpt']], stdin=f, capture_output=True)
    if done.returncode != 0:
        raise EfaError('The mail server did not take the mail, it stays in quarantine.')


def uq_release(args):
    """Deliver a mail to its recipient."""
    item = _uq_item(args.id, identity_now)
    if not uq_can_release(identity_now, item['malware'], uq_state()['self_release']):
        raise EfaError('This mail can only be released by an admin. You can ask for it.')
    _uq_deliver(item)
    _uq_mark(item, 'released', _dmarc_who())
    return {'released': item['id']}


def _uq_request(item):
    if item['state'] != 'requested':
        _admin_query("UPDATE quarantine_rcpt SET state = 'requested', changed = NOW() WHERE id = %s", (item['id'],))
        _admin_notify('eFa: a release was requested', f"{item['rcpt']} asks for a mail from {item['sender']}: {item['subject']}\nSee Users' quarantine in the web interface.")


def uq_request(args):
    """Ask an admin to release a mail."""
    item = _uq_item(args.id, identity_now)
    _uq_request(item)
    return {'requested': item['id']}


def uq_delete(args):
    """Delete a mail for its recipient. Gone for good."""
    _confirm(args)
    item = _uq_item(args.id, identity_now)
    _uq_mark(item, 'deleted', _dmarc_who())
    return {'deleted': item['id']}


# Allowing or blocking a sender still makes sense after the mail was released.
UQ_SENDER_STATES = ('held', 'requested', 'released')


def _uq_sender(item, which):
    if not item['sender'] or not SENDER_RE.match(item['sender'].lower()):
        raise EfaError('This mail has no sender to put on a list.')
    return sender_rule_set(argparse.Namespace(list=which, action='add', sender=item['sender'], recipient=item['rcpt']))


def uq_sender(args):
    """Always allow or block the sender of a mail, for its recipient only."""
    which = args.list.strip()
    if which not in ('allow', 'block'):
        raise EfaError("List must be 'allow' or 'block'.")
    item = _uq_item(args.id, identity_now, UQ_SENDER_STATES)
    _uq_sender(item, which)
    return {'list': which, 'sender': item['sender'], 'recipient': item['rcpt']}


UQ_LINK_ACTIONS = {'release': 'Release this mail', 'request': 'Ask an admin to release this mail', 'allow': 'Always allow this sender',
                   'block': 'Always block this sender', 'login': 'Open my quarantine'}


def uq_link_make(purpose, rcpt, item_id=None):
    token = secrets.token_urlsafe(32)
    _admin_query('INSERT INTO quarantine_links (token_sha256, purpose, rcpt, rcpt_id, expires) VALUES (%s, %s, %s, %s, NOW() + INTERVAL %s DAY)',
                 (hashlib.sha256(token.encode()).hexdigest(), purpose, rcpt, item_id, UQ_LINK_DAYS))
    return token


def _uq_link():
    sha = hashlib.sha256(_secrets(1, 'Token')[0].strip().encode()).hexdigest()
    rows = _admin_query('SELECT purpose, rcpt, rcpt_id FROM quarantine_links WHERE token_sha256 = %s AND used IS NULL AND expires > NOW()', (sha,))
    if not rows:
        raise EfaError('This link has expired or was already used.')
    return sha, rows[0]


def uq_link_view(_args):
    """What a link would do. Opening it changes nothing: mail scanners open links too."""
    _sha, link = _uq_link()
    view = {'purpose': link['purpose'], 'question': UQ_LINK_ACTIONS[link['purpose']], 'rcpt': link['rcpt']}
    if link['rcpt_id']:
        item = _uq_item(link['rcpt_id'], None, UQ_SENDER_STATES if link['purpose'] in ('allow', 'block') else ('held', 'requested'))
        view.update(sender=item['sender'], subject=item['subject'])
    return view


def uq_link_use(_args):
    """Does what a link promised, once."""
    sha, link = _uq_link()
    purpose, result = link['purpose'], {'purpose': link['purpose'], 'done': UQ_LINK_ACTIONS[link['purpose']]}
    if purpose == 'login':
        _admin_query("INSERT INTO users (username, role, email, source, groups_migrated) VALUES (%s, 'user', %s, 'link', 1) "
                     "ON DUPLICATE KEY UPDATE last_login = NOW()", (link['rcpt'], link['rcpt']))
        known = _load_identity(link['rcpt'], allow_disabled=True)
        if known['source'] == 'link' and not known['memberships']:
            _admin_query("INSERT IGNORE INTO user_groups (username, group_id) SELECT %s, id FROM efa_groups WHERE builtin = 'user'", (link['rcpt'],))
            known = _load_identity(link['rcpt'], allow_disabled=True)
        if known['role'] != 'user' or known['disabled']:
            raise EfaError('This address has a login of its own, please use that.')
        result.update(username=known['username'], role=known['role'])
    else:
        item = _uq_item(link['rcpt_id'], None, UQ_SENDER_STATES if purpose in ('allow', 'block') else ('held', 'requested'))
        if purpose == 'release':
            if not uq_can_release({'grants': {}}, item['malware'], uq_state()['self_release']):
                raise EfaError('This mail can only be released by an admin.')
            _uq_deliver(item)
            _uq_mark(item, 'released', 'digest link')
        elif purpose == 'request':
            _uq_request(item)
        else:
            _uq_sender(item, purpose)
    _admin_query('UPDATE quarantine_links SET used = NOW() WHERE token_sha256 = %s', (sha,))
    return result


def uq_digest_text(items, links, base, intro=''):
    """Text and HTML of a digest. Senders and subjects come from outside: everything is escaped."""
    lines, cells = ([intro, ''] if intro else []), []
    for item in items:
        actions = links.get(item['id'], {})
        lines.append(f"{item['ts']}  {item['sender'] or '(empty)'}  {item['subject']}")
        lines += [f'    {UQ_LINK_ACTIONS[name]}: {base}/q/{token}' for name, token in actions.items()]
        buttons = ' | '.join(f'<a href="{html.escape(f"{base}/q/{token}", quote=True)}">{html.escape(UQ_LINK_ACTIONS[name])}</a>' for name, token in actions.items())
        cells.append(f"<tr><td>{html.escape(str(item['ts']))}</td><td>{html.escape(item['sender'] or '(empty)')}</td><td>{html.escape(item['subject'] or '')}</td><td>{buttons}</td></tr>")
    lead = ''.join(f'<p>{html.escape(part)}</p>' for part in intro.split('\n') if part.strip())
    return '\n'.join(lines) + '\n', ('<!doctype html><html><body style="font-family:sans-serif"><h1 style="font-size:1.2em">Mail held for you</h1>'
                                     f'{lead}<table cellpadding="4">{"".join(cells)}</table></body></html>')


def _uq_digests(hour=None, layers=None):
    """Once a day: one mail per recipient about what is new. Links stay valid for some days and work once.
    With hour, only recipients whose domain sends at that hour; layers gives the text of each domain."""
    state = uq_state()
    rows = _admin_query("SELECT r.id, r.rcpt, CAST(m.ts AS CHAR) AS ts, m.sender, m.subject, m.malware FROM quarantine_rcpt r JOIN quarantine_mail m ON m.id = r.mail_id "
                        "WHERE r.state = 'held' AND r.digested = 0 ORDER BY r.rcpt, m.ts LIMIT 5000")
    recipients = {}
    for row in rows:
        recipients.setdefault(row['rcpt'], []).append(row)
    for rcpt, items in recipients.items():
        domain_values = (layers or {}).get(rcpt.rsplit('@', 1)[-1].lower(), {})
        if hour is not None and int(domain_values.get('digest_hour', ('0', 'global'))[0]) != hour:
            continue
        links = {}
        shown = items[:UQ_DIGEST_LINES]
        for item in shown:
            names = ['request'] if item['malware'] else (['release'] if state['self_release'] else ['request']) + ['allow', 'block']
            links[item['id']] = {name: uq_link_make(name, rcpt, item['id']) for name in names}
        plain, page = uq_digest_text(shown, links, state['public_url'], domain_values.get('digest_text', ('', 'global'))[0])
        brand = _brand_of_domain(rcpt.rsplit('@', 1)[-1])
        page = brand_html(page, brand)
        login = f"{state['public_url']}/q/{uq_link_make('login', rcpt)}"
        message = email.message.EmailMessage()
        message['To'] = rcpt
        message['Subject'] = f'{len(items)} mails held for you'
        message.set_content(f'{plain}\nOpen my quarantine: {login}\n')
        message.add_alternative(page.replace('</body>', f'<p><a href="{html.escape(login, quote=True)}">Open my quarantine</a></p></body>'), subtype='html')
        brand_logo(message, brand)
        subprocess.run(['sendmail', '-t'], input=message.as_bytes(), capture_output=True, check=False)
        _admin_query('UPDATE quarantine_rcpt SET digested = 1 WHERE id IN (' + ','.join(['%s'] * len(items)) + ')', [item['id'] for item in items])


def _uq_job(state_now, today):
    """Hourly: removes what is past its time, and sends the digest once a day."""
    settings_now = uq_state()
    rows, tenant_domains = _layer_rows(), _tenant_domains()
    layers = {domain: layer_effective(domain, tenant, rows, {}) for domain, tenant in layer_domains(rows, tenant_domains).items()}
    own_days = {domain: int(values['quarantine_days'][0]) for domain, values in layers.items() if values['quarantine_days'][1] != 'global'}
    if not own_days:
        old = _admin_query('SELECT id FROM quarantine_mail WHERE ts < NOW() - INTERVAL %s DAY', (settings_now['days'],))
    else:
        # Per recipient: its domain keeps its mail for its own days; a mail goes once no recipient is left.
        for domain, days in own_days.items():
            _admin_query('DELETE r FROM quarantine_rcpt r JOIN quarantine_mail m ON m.id = r.mail_id WHERE r.rcpt LIKE %s AND m.ts < NOW() - INTERVAL %s DAY',
                         ('%@' + domain.replace('_', '\\_'), days))
        expired = _admin_query('SELECT r.id, r.rcpt FROM quarantine_rcpt r JOIN quarantine_mail m ON m.id = r.mail_id WHERE m.ts < NOW() - INTERVAL %s DAY',
                               (settings_now['days'],))
        for row in expired:
            if row['rcpt'].rsplit('@', 1)[-1].lower() not in own_days:
                _admin_query('DELETE FROM quarantine_rcpt WHERE id = %s', (row['id'],))
        # A fresh mail can be in the table a moment before its recipients.
        old = _admin_query('SELECT m.id FROM quarantine_mail m WHERE m.ts < NOW() - INTERVAL 1 HOUR AND NOT EXISTS (SELECT 1 FROM quarantine_rcpt r WHERE r.mail_id = m.id)')
    for row in old:
        if os.path.exists(_uq_path(row['id'])):
            os.remove(_uq_path(row['id']))
        _admin_query('DELETE FROM quarantine_rcpt WHERE mail_id = %s', (row['id'],))
        _admin_query('DELETE FROM quarantine_mail WHERE id = %s', (row['id'],))
    _admin_query('DELETE FROM quarantine_links WHERE expires < NOW()')
    if not (settings_now['enabled'] and settings_now['digest']):
        return
    if not any(values['digest_hour'][1] != 'global' for values in layers.values()):
        if state_now.get('uq_digest_day') != today.isoformat():
            _uq_digests(None, layers)
            state_now['uq_digest_day'] = today.isoformat()
        return
    # Some domains send at their own hour: each hour once, for the recipients of that hour; global is hour 0.
    hour = datetime.datetime.now().hour
    slot = f'{today.isoformat()}-{hour}'
    if state_now.get('uq_digest_slot') != slot:
        _uq_digests(hour, layers)
        state_now['uq_digest_slot'] = slot
        state_now['uq_digest_day'] = today.isoformat()


def _efa_version():
    lines = _read_lines(ETC + '/eFa-Version')
    return lines[0].replace('eFa-', '', 1) if lines else 'unknown'


def events_on():
    """events.json is written only while something reads it: OTLP, the SIEM export or Wazuh."""
    return bool(_json_read(OTLP_FILE, {}).get('enabled') or _json_read(SIEM_FILE, {}).get('siem') or _json_read(WAZUH_FILE, {}).get('events'))


def events_marker():
    """Keeps the marker of the timer in line with the consumers."""
    if events_on():
        _write(EVENTS_MARKER, '')
    elif os.path.exists(EVENTS_MARKER):
        os.remove(EVENTS_MARKER)


def event_record(event, severity, now=None, **fields):
    """One line of events.json. The fields stay stable, consumers parse them."""
    if severity not in EVENT_SEVERITIES:
        severity = 'info'
    stamp = datetime.datetime.fromtimestamp(now if now is not None else time.time(), datetime.timezone.utc)
    record = {'timestamp': stamp.isoformat(timespec='milliseconds').replace('+00:00', 'Z'), 'event': event, 'severity': severity,
              'user': fields.pop('user', '') or '', 'src_ip': fields.pop('src_ip', '') or '', 'tenant': fields.pop('tenant', '') or '',
              'host': socket.getfqdn(), 'efa_version': _efa_version()}
    record.update({key: value for key, value in fields.items() if value not in (None, '')})
    return record


def _event(event, severity='info', **fields):
    """Appends one event. A full disk or a missing folder must never stop the work itself."""
    if not events_on():
        return
    try:
        line = json.dumps(event_record(event, severity, **fields), sort_keys=True) + '\n'
        fd = os.open(EVENTS_LOG, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o640)
        os.fchmod(fd, 0o640)  # the umask must not take the group read away
        with os.fdopen(fd, 'a') as f:
            f.write(line)
        try:
            # Wazuh reads it with its own group, if that exists.
            os.chown(EVENTS_LOG, 0, grp.getgrnam('wazuh').gr_gid)
        except KeyError:
            pass
    except OSError as err:
        print(f'events: {err}', file=sys.stderr)


LOGIN_RE = re.compile(r'efa-web login (ok|failed) (?:user (\S+) )?from (\S+)')
LINK_EVENT_RE = re.compile(r'efa-web link (blocked|unchecked) (\S+)')
DLP_EVENT_RE = re.compile(r'efa-outbound dlp (log|encrypt|hold|reject) rules=(\S+) from=(\S*) id=(\S+)')
LIMIT_EVENT_RE = re.compile(r'efa-outbound limit (log|throttle|hold|reject) (recipients|domains) who=(\S+) from=(\S*)')
BAN_RE = re.compile(r'\[([\w-]+)\] (Ban|Unban) ([0-9a-fA-F.:]+)')


def journal_events(lines):
    """Events from the journal lines of efa-web and Fail2Ban."""
    found = []
    for line in lines:
        login = LOGIN_RE.search(line)
        if login:
            found.append(('login_ok', 'info', {'user': login.group(2) or 'admin', 'src_ip': login.group(3)}) if login.group(1) == 'ok'
                         else ('login_failed', 'warning', {'user': login.group(2) or '', 'src_ip': login.group(3)}))
            continue
        limit = LIMIT_EVENT_RE.search(line)
        if limit:
            found.append(('sending_limit', 'warning', {'action': limit.group(1), 'limit': limit.group(2), 'who': limit.group(3), 'sender': limit.group(4)}))
            continue
        dlp = DLP_EVENT_RE.search(line)
        if dlp:
            found.append(('dlp_match', 'notice' if dlp.group(1) == 'log' else 'warning',
                          {'action': dlp.group(1), 'rules': dlp.group(2), 'sender': dlp.group(3), 'queue_id': dlp.group(4)}))
            continue
        link = LINK_EVENT_RE.search(line)
        if link:
            found.append((f'link_{link.group(1)}', 'warning' if link.group(1) == 'blocked' else 'notice', {'url': link.group(2)[:200]}))
            continue
        ban = BAN_RE.search(line)
        if ban:
            found.append(('ip_banned' if ban.group(2) == 'Ban' else 'ip_unbanned', 'notice', {'src_ip': ban.group(3), 'jail': ban.group(1)}))
    return found


def counter_events(before, after):
    """Summaries, not one event per mail: viruses and blocklist hits since the last run."""
    found = []
    delta = {name: after[name] - before.get(name, 0) for name in after if after[name] > before.get(name, 0)}
    if delta.get('CLAM_VIRUS'):
        found.append(('virus_found', 'warning', {'count': delta['CLAM_VIRUS']}))
    lists = {preset['id']: _rbl_hits(delta, preset['symbols']) for preset in RBL_PRESETS}
    lists = {name: hits for name, hits in lists.items() if hits}
    if lists:
        found.append(('rbl_hits', 'info', {'count': sum(lists.values()), 'lists': lists}))
    return found


def service_events(before, after):
    found = []
    for name in sorted(set(after) - set(before)):
        found.append(('service_down', 'error', {'service': name}))
    for name in sorted(set(before) - set(after)):
        found.append(('service_up', 'notice', {'service': name}))
    return found


def _events_collect(state):
    """What the other parts of the system know already: the journal, the health service, the rspamd counters."""
    command = ['journalctl', '-o', 'cat', '--show-cursor', '-u', 'efa-web', '-u', 'fail2ban', '-u', 'efa-outbound', '--no-pager']
    command += ['--after-cursor', state['cursor']] if state.get('cursor') else ['--since', '-2min']
    done = subprocess.run(command, capture_output=True, text=True, timeout=60)
    lines = done.stdout.splitlines()
    if lines and lines[-1].startswith('-- cursor: '):
        state['cursor'] = lines.pop()[len('-- cursor: '):]
    found = journal_events(lines)
    counters = _rbl_counters()
    if 'counters' in state:
        found += counter_events(state['counters'], counters)
    state['counters'] = counters
    try:
        down = sorted(status(None).get('down', []))
    except EfaError:
        down = state.get('down', [])
    found += service_events(state.get('down', []), down)
    state['down'] = down
    try:
        active = bayes_status(None)['active']
    except (EfaError, OSError, subprocess.SubprocessError):
        active = state.get('bayes_active')
    if 'bayes_active' in state and active is not None and active != state['bayes_active']:
        found.append(('bayes_active' if active else 'bayes_inactive', 'notice', {}))
    state['bayes_active'] = active
    for event, severity, fields in found:
        _event(event, severity, **fields)


def otlp_state():
    return {'enabled': False, 'endpoint': '', 'auth': 'none', 'header_name': 'X-API-Key', 'secret': '', 'headers': {}, 'verify': True,
            'ca_file': '', 'client_cert': '', 'client_key': '', 'signals': list(OTLP_SIGNALS), 'buffer_mb': 50, **_json_read(OTLP_FILE, {})}


def otlp_status(_args):
    """Export to an OpenTelemetry receiver over OTLP/HTTP with JSON. Off by default."""
    state, run = otlp_state(), _json_read(OTLP_DIR + '/state.json', {})
    shown = {key: value for key, value in state.items() if key not in ('secret', 'headers')}
    shown['secret'] = 'set' if state['secret'] else 'not set'
    shown['headers'] = {name: 'set' for name in state['headers']}
    buffered = sum(os.path.getsize(path) for path in glob.glob(OTLP_DIR + '/*.jsonl'))
    return {**shown, 'buffer_kb': buffered // 1024, 'dropped': run.get('dropped', 0), 'last_status': run.get('last_status', ''),
            'last_sent': run.get('last_sent', ''), 'next_try': run.get('next_try', '')}


def otlp_headers_parse(text):
    """'Name: value; Other: value'. Names as in HTTP, values without line breaks."""
    headers = {}
    for part in (text or '').split(';'):
        if not part.strip():
            continue
        name, separator, value = part.partition(':')
        name, value = name.strip(), value.strip()
        if not separator or not HEADER_NAME_RE.match(name) or not value or any(ch in value for ch in '\r\n\0'):
            raise EfaError('Extra headers: Name: value, separated by ;')
        headers[name] = value
    return headers


def _otlp_file(path):
    path = (path or '').strip()
    if path and (not path.startswith('/') or not os.path.isfile(path)):
        raise EfaError(f'Not a file: {path}')
    return path


def otlp_set(args):
    """Settings of the OTLP export. The token is asked twice and only readable by root. Empty fields keep the old value."""
    state = otlp_state()
    enabled = _on_off(args.mode)
    if not enabled:
        # Off keeps the other settings, so switching on again needs no new token.
        state['enabled'] = False
        _json_write(OTLP_FILE, state, mode=0o600)
        events_marker()
        return otlp_status(None)
    endpoint = (args.endpoint or '').strip().rstrip('/') or state['endpoint']
    https_url(endpoint) if endpoint.startswith('https://') else None
    if enabled and not re.fullmatch(r'https://[A-Za-z0-9.:\[\]-]+(:\d+)?(/[A-Za-z0-9._~/-]*)?', endpoint):
        raise EfaError('Endpoint: the base address of the receiver, like https://otel.example.org:4318')
    auth = (args.auth or '').strip() or state['auth']
    if auth not in OTLP_AUTH:
        raise EfaError('Auth: none, bearer or apikey.')
    header_name = (args.header_name or '').strip() or state['header_name']
    if not HEADER_NAME_RE.match(header_name):
        raise EfaError('Header name: letters, digits and dashes.')
    signals = [item for item in re.split(r'[\s,]+', (args.signals or '').strip()) if item] or state['signals']
    if any(item not in OTLP_SIGNALS for item in signals):
        raise EfaError('Signals: ' + ', '.join(OTLP_SIGNALS))
    first, second = _secrets(2, 'Token, then again')
    if first != second:
        raise EfaError(PASSWORD_DIFFER + ' Nothing was changed.')
    secret = first or state['secret']
    if auth != 'none' and not secret:
        raise EfaError('This kind of auth needs a token.')
    if (args.verify or '').strip() == 'off':
        raise EfaError('The certificate of the receiver is always checked; for an own CA give --ca_file.')
    verify = 'on'
    headers = otlp_headers_parse(args.headers) if (args.headers or '').strip() else state['headers']
    buffer_mb = (args.buffer_mb or '').strip() or str(state['buffer_mb'])
    if not buffer_mb.isdigit() or not 1 <= int(buffer_mb) <= 2000:
        raise EfaError('Buffer: 1 to 2000 MB.')
    state.update(enabled=enabled, endpoint=endpoint, auth=auth, header_name=header_name, secret=secret, headers=headers, signals=signals,
                 verify=_on_off(verify), ca_file=_otlp_file(args.ca_file) if (args.ca_file or '').strip() else state['ca_file'],
                 client_cert=_otlp_file(args.client_cert) if (args.client_cert or '').strip() else state['client_cert'],
                 client_key=_otlp_file(args.client_key) if (args.client_key or '').strip() else state['client_key'], buffer_mb=int(buffer_mb))
    _json_write(OTLP_FILE, state, mode=0o600)
    events_marker()
    return otlp_status(None)


def otlp_value(value):
    if isinstance(value, bool):
        return {'boolValue': value}
    if isinstance(value, int):
        return {'intValue': str(value)}
    if isinstance(value, float):
        return {'doubleValue': value}
    return {'stringValue': value if isinstance(value, str) else json.dumps(value, sort_keys=True)}


def otlp_attributes(values):
    return [{'key': key, 'value': otlp_value(value)} for key, value in sorted(values.items()) if value not in (None, '')]


def otlp_resource():
    return {'attributes': otlp_attributes({'service.name': 'efa-next', 'service.version': _efa_version(), 'host.name': socket.getfqdn()})}


def otlp_log_record(event):
    """An event of events.json, or a mail log row, as an OTLP log record."""
    stamp = event.get('timestamp', '')
    try:
        nanos = int(datetime.datetime.fromisoformat(stamp.replace('Z', '+00:00')).timestamp() * 1e9)
    except ValueError:
        nanos = int(time.time() * 1e9)
    severity = event.get('severity', 'info')
    attributes = {key: value for key, value in event.items() if key not in ('timestamp', 'severity', 'host', 'efa_version')}
    if 'tenant' in attributes:
        attributes['efa.tenant'] = attributes.pop('tenant')
    return {'timeUnixNano': str(nanos), 'severityText': severity.upper(), 'severityNumber': OTLP_SEVERITY.get(severity, 9),
            'body': {'stringValue': event.get('event', '')}, 'attributes': otlp_attributes(attributes)}


METRIC_LINE_RE = re.compile(r'^([a-zA-Z_:][a-zA-Z0-9_:]*)(?:\{(.*)\})? (\S+)$')
METRIC_LABEL_RE = re.compile(r'(\w+)="((?:[^"\\]|\\.)*)"')


def otlp_metric_points(text, nanos):
    """The values of /metrics as OTLP gauge points, one JSON object per line in the buffer."""
    points = []
    for line in text.splitlines():
        match = METRIC_LINE_RE.match(line)
        if not match:
            continue
        labels = {key: value.replace('\\"', '"').replace('\\\\', '\\') for key, value in METRIC_LABEL_RE.findall(match.group(2) or '')}
        points.append({'name': match.group(1), 'point': {'timeUnixNano': str(nanos), 'asDouble': float(match.group(3)), 'attributes': otlp_attributes(labels)}})
    return points


def otlp_payloads(kind, items):
    """The JSON bodies for /v1/logs or /v1/metrics, in batches under the record and size limits."""
    batches, current, size = [], [], 0
    for item in items:
        length = len(json.dumps(item))
        if current and (len(current) >= OTLP_BATCH_RECORDS or size + length > OTLP_BATCH_BYTES):
            batches.append(current)
            current, size = [], 0
        current.append(item)
        size += length
    if current:
        batches.append(current)
    scope = {'name': 'efa-next', 'version': _efa_version()}
    bodies = []
    for batch in batches:
        if kind == 'logs':
            bodies.append((len(batch), {'resourceLogs': [{'resource': otlp_resource(), 'scopeLogs': [{'scope': scope, 'logRecords': batch}]}]}))
        else:
            metrics = {}
            for item in batch:
                metrics.setdefault(item['name'], []).append(item['point'])
            bodies.append((len(batch), {'resourceMetrics': [{'resource': otlp_resource(), 'scopeMetrics': [{'scope': scope, 'metrics': [
                {'name': name, 'gauge': {'dataPoints': points}} for name, points in metrics.items()]}]}]}))
    return bodies


def otlp_buffer_add(path, items, limit_bytes):
    """Appends to the disk buffer. Over its limit the oldest lines go, and their number is returned."""
    if items:
        with open(path, 'a') as f:
            f.writelines(json.dumps(item, sort_keys=True) + '\n' for item in items)
        os.chmod(path, 0o600)
    if not os.path.exists(path) or os.path.getsize(path) <= limit_bytes:
        return 0
    with open(path) as f:
        lines = f.readlines()
    kept, size = [], 0
    for line in reversed(lines):
        if size + len(line) > limit_bytes:
            break
        kept.append(line)
        size += len(line)
    with open(path + '.tmp', 'w') as f:
        f.writelines(reversed(kept))
    os.chmod(path + '.tmp', 0o600)
    os.replace(path + '.tmp', path)
    return len(lines) - len(kept)


def otlp_backoff(failures, retry_after=None):
    """Seconds until the next try: Retry-After if the receiver gave one, otherwise doubling from 30 s, at most an hour."""
    if retry_after and str(retry_after).strip().isdigit():
        return min(int(retry_after), OTLP_BACKOFF_MAX)
    return min(30 * 2 ** max(failures - 1, 0), OTLP_BACKOFF_MAX)


def _otlp_context(state):
    # S1: always checked, also for a setup of before that had it off; the dashboard says so (_system_notices).
    context = ssl.create_default_context(cafile=state['ca_file'] or None)
    if state['client_cert']:
        context.load_cert_chain(state['client_cert'], state['client_key'] or None)
    return context


def _otlp_post(state, kind, body):
    """One request. Returns (HTTP status or 0, Retry-After, text for the admin). Secrets never reach the text."""
    if not str(state['endpoint']).startswith('https://'):
        # S1: a token and mail log rows never go out in clear text, also not for a setup of before.
        return 0, None, 'Not sent: the receiver must be an https:// address (otlp-set).'
    headers = {'Content-Type': 'application/json', 'Content-Encoding': 'gzip', **state['headers']}
    if state['auth'] == 'bearer':
        headers['Authorization'] = 'Bearer ' + state['secret']
    elif state['auth'] == 'apikey':
        headers[state['header_name']] = state['secret']
    request = urllib.request.Request(f"{state['endpoint']}/v1/{kind}", data=gzip.compress(json.dumps(body).encode()), headers=headers, method='POST')
    try:
        context = _otlp_context(state) if state['endpoint'].startswith('https://') else None
        with urllib.request.urlopen(request, timeout=20, context=context) as reply:
            return reply.status, None, f'{reply.status} accepted'
    except urllib.error.HTTPError as err:
        text = {401: 'the receiver refused the token', 403: 'the receiver refused access', 404: 'wrong endpoint path',
                413: 'the batch is too big for the receiver', 429: 'the receiver asks to slow down'}.get(err.code, 'error at the receiver')
        return err.code, err.headers.get('Retry-After'), f'{err.code} {text}'
    except ssl.SSLError as err:
        return 0, None, f'TLS: {err.reason or err}'
    except (OSError, ValueError) as err:
        return 0, None, f'not reachable: {getattr(err, "reason", err)}'


def _otlp_flush(state, run, now):
    """Sends what waits in the buffer. On 429, 5xx or no answer it keeps the data and waits longer each time."""
    if run.get('next_try_epoch', 0) > now:
        return
    for kind, path in (('logs', OTLP_DIR + '/logs.jsonl'), ('metrics', OTLP_DIR + '/metrics.jsonl')):
        if not os.path.exists(path) or not os.path.getsize(path):
            continue
        with open(path) as f:
            items = [json.loads(line) for line in f if line.strip()]
        sent = 0
        for count, body in otlp_payloads(kind, items):
            code, retry_after, text = _otlp_post(state, kind, body)
            run['last_status'] = text
            if not 200 <= code < 300:
                run['failures'] = run.get('failures', 0) + 1
                run['next_try_epoch'] = now + otlp_backoff(run['failures'], retry_after)
                run['next_try'] = datetime.datetime.fromtimestamp(run['next_try_epoch']).strftime('%Y-%m-%d %H:%M:%S')
                break
            sent += count
            run.update(failures=0, next_try_epoch=0, next_try='', last_sent=time.strftime('%Y-%m-%d %H:%M:%S'))
        with open(path + '.tmp', 'w') as f:
            f.writelines(json.dumps(item, sort_keys=True) + '\n' for item in items[sent:])
        os.chmod(path + '.tmp', 0o600)
        os.replace(path + '.tmp', path)
        if run.get('failures'):
            return


def _events_new(state):
    """New lines of events.json since the last run. A rotated file starts from the beginning."""
    try:
        info = os.stat(EVENTS_LOG)
    except FileNotFoundError:
        return []
    offset = state.get('offset', 0) if state.get('inode') == info.st_ino and state.get('offset', 0) <= info.st_size else 0
    with open(EVENTS_LOG, 'rb') as f:
        f.seek(offset)
        data = f.read(8 * 1024 * 1024)
    complete = data[:data.rfind(b'\n') + 1]
    state.update(inode=info.st_ino, offset=offset + len(complete))
    events = []
    for line in complete.decode('utf-8', 'replace').splitlines():
        try:
            events.append(json.loads(line))
        except ValueError:
            continue
    return events


def _otlp_run(state, now):
    otlp = otlp_state()
    os.makedirs(OTLP_DIR, mode=0o700, exist_ok=True)
    run = _json_read(OTLP_DIR + '/state.json', {})
    logs = []
    if 'events' in otlp['signals']:
        logs += [otlp_log_record(event) for event in _events_new(state)]
    if 'maillog' in otlp['signals']:
        try:
            db = _maillog_db()
            try:
                with db.cursor() as cur:
                    cur.execute('SELECT id, CAST(ts AS CHAR) AS ts, qid, sender, rcpt, ip, action, score, subject, spf, dkim, dmarc FROM maillog '
                                'WHERE id > %s ORDER BY id LIMIT %s', (run.get('maillog_id', 0), OTLP_MAILLOG_ROWS))
                    rows = cur.fetchall()
            finally:
                db.close()
            if 'maillog_id' not in run:
                # The first run starts from now, not with the whole history.
                rows = []
                run['maillog_id'] = int(_admin_query('SELECT COALESCE(MAX(id), 0) AS n FROM maillog')[0]['n'])
            for row in rows:
                run['maillog_id'] = int(row['id'])
                stamp = datetime.datetime.fromisoformat(row.pop('ts')).astimezone(datetime.timezone.utc).isoformat().replace('+00:00', 'Z')
                logs.append(otlp_log_record({'timestamp': stamp, 'event': 'mail', 'severity': 'info', **{key: value for key, value in row.items() if key != 'id'}}))
        except (EfaError, OSError, ValueError) as err:
            print(f'otlp maillog: {err}', file=sys.stderr)
    limit = otlp['buffer_mb'] * 1024 * 1024
    dropped = otlp_buffer_add(OTLP_DIR + '/logs.jsonl', logs, limit)
    if 'metrics' in otlp['signals']:
        dropped += otlp_buffer_add(OTLP_DIR + '/metrics.jsonl', otlp_metric_points(metrics(None)['text'], int(now * 1e9)), limit)
    run['dropped'] = run.get('dropped', 0) + dropped
    _otlp_flush(otlp, run, now)
    _json_write(OTLP_DIR + '/state.json', run)


def events_run(_args):
    """Every minute: collects events and sends them on. Without a consumer it does nothing."""
    if not events_on():
        return {'events': 'off'}
    state = _json_read(EVENTS_STATE, {})
    _events_collect(state)
    if otlp_state()['enabled']:
        _otlp_run(state, time.time())
    _json_write(EVENTS_STATE, state)
    return {'events': 'done'}


def otlp_test(_args):
    """Sends one test record now and shows how the receiver answered."""
    state = otlp_state()
    if not state['endpoint']:
        raise EfaError('Set the endpoint first.')
    record = otlp_log_record(event_record('otlp_test', 'info', user=_dmarc_who()))
    code, _retry, text = _otlp_post(state, 'logs', otlp_payloads('logs', [record])[0][1])
    return {'http_status': code, 'result': text, 'ok': 200 <= code < 300}


def wazuh_settings():
    return {'events': False, 'manager': '', 'port': 1514, 'enrollment_port': 1515, 'agent_name': '', 'groups': '', 'active_response': False,
            **_json_read(WAZUH_FILE, {})}


def wazuh_block(settings_now):
    """The part of ossec.conf that eFa owns. FIM checks hashes only: report_changes stays off, so no file content leaves the host."""
    lines = [WAZUH_BEGIN, '<ossec_config>']
    if settings_now['events']:
        lines += ['  <localfile>', '    <log_format>json</log_format>', f'    <location>{EVENTS_LOG}</location>', '  </localfile>']
    lines += ['  <localfile>', '    <log_format>syslog</log_format>', '    <location>/var/log/maillog</location>', '  </localfile>',
              '  <syscheck>', '    <directories check_all="yes" report_changes="no">/etc/eFa,/etc/postfix,/etc/rspamd/local.d,/etc/nginx</directories>', '  </syscheck>',
              '  <sca>', '    <policies>', f'      <policy>{WAZUH_SCA}</policy>', '    </policies>', '  </sca>']
    if not settings_now['active_response']:
        # The manager could otherwise change firewalld at any time, see docs/WAZUH.md.
        lines += ['  <active-response>', '    <disabled>yes</disabled>', '  </active-response>']
    return '\n'.join(lines + ['</ossec_config>', WAZUH_END]) + '\n'


def wazuh_conf_update(conf, settings_now):
    """ossec.conf with the eFa block at the end, and the manager in the client section. Everything else stays as it is."""
    if '<client>' not in conf or '</client>' not in conf:
        raise EfaError('ossec.conf has no client section, nothing was changed.')
    conf = re.sub(re.escape(WAZUH_BEGIN) + r'.*?' + re.escape(WAZUH_END) + r'\n?', '', conf, flags=re.S)
    if settings_now['manager']:
        start, end = conf.index('<client>'), conf.index('</client>') + len('</client>')
        client = conf[start:end]
        client = re.sub(r'<address>[^<]*</address>', f"<address>{settings_now['manager']}</address>", client, count=1)
        client = re.sub(r'<port>[^<]*</port>', f"<port>{settings_now['port']}</port>", client, count=1)
        enrollment = (f"<enrollment>\n      <enabled>yes</enabled>\n      <port>{settings_now['enrollment_port']}</port>\n"
                      + (f"      <agent_name>{settings_now['agent_name']}</agent_name>\n" if settings_now['agent_name'] else '')
                      + (f"      <groups>{settings_now['groups']}</groups>\n" if settings_now['groups'] else '')
                      + f"      <authorization_pass_path>{WAZUH_AUTHD_PASS}</authorization_pass_path>\n    </enrollment>")
        if '<enrollment>' in client:
            client = re.sub(r'<enrollment>.*?</enrollment>', lambda found: enrollment, client, count=1, flags=re.S)
        else:
            client = client.replace('</client>', f'  {enrollment}\n  </client>', 1)
        conf = conf[:start] + client + conf[end:]
    return conf.rstrip('\n') + '\n' + wazuh_block(settings_now)


def wazuh_foreign(installed, state):
    """An agent that eFa did not install or take over: eFa only reads its status."""
    return bool(installed) and not state.get('managed')


def _wazuh_guard(args=None):
    """Stops before anything touches an agent of someone else. Taking it over needs --adopt yes and the confirmation."""
    state = wazuh_settings()
    if not wazuh_foreign(_wazuh_installed(), state):
        return state
    if args is not None and (getattr(args, 'adopt', '') or '').strip() == 'yes':
        _confirm(args)
        state['managed'] = True
        return state
    raise EfaError('A Wazuh agent is installed that eFa did not install. eFa does not change it; '
                   'to let eFa manage it, run wazuh-config with --adopt yes and confirm.')


def _wazuh_installed():
    done = subprocess.run(['rpm', '-q', '--qf', '%{VERSION}-%{RELEASE}', 'wazuh-agent'], capture_output=True, text=True)
    return done.stdout.strip() if done.returncode == 0 else ''


def wazuh_last_error(lines):
    """Why the agent is not connected, from the end of its log: the manager names it (an unknown group, a wrong password)."""
    for line in reversed(lines[-400:]):
        if 'wazuh-agentd: INFO: (4102)' in line or 'Connected to the server' in line:
            return ''
        if 'wazuh-agentd: ERROR:' in line:
            return line.split('ERROR:', 1)[1].strip()[:200]
    return ''


def wazuh_status(_args):
    """The Wazuh agent: installed version, running, connected to the manager, last keep-alive. The agent itself runs as root."""
    version = _wazuh_installed()
    agent = {key: value.strip("'") for key, _sep, value in (line.partition('=') for line in _read_lines(WAZUH_STATE)) if value}
    conf = open(WAZUH_CONF).read() if os.path.exists(WAZUH_CONF) else ''
    address = re.search(r'<client>.*?<address>([^<]*)</address>', conf, re.S)
    state = wazuh_settings()
    foreign = wazuh_foreign(version, state)
    return {'installed': version or 'not present', 'managed_by_efa': bool(version) and not foreign,
            **({'warning': 'Agent present, not managed by eFa: only its status is shown.'} if foreign else {}), 'running': bool(version) and subprocess.run(['systemctl', 'is-active', '--quiet', 'wazuh-agent']).returncode == 0,
            'connection': agent.get('status', 'unknown') if version else 'not present', 'last_keepalive': agent.get('last_keepalive', ''),
            **({'last_error': wazuh_last_error(_read_lines(WAZUH_LOG))} if version and agent.get('status') != 'connected' else {}),
            'manager': address.group(1) if address else '', 'efa_block': WAZUH_BEGIN in conf, 'repo': os.path.exists(WAZUH_REPO),
            'events': state['events'], 'active_response': state['active_response'], 'enrollment_password': 'set' if os.path.exists(WAZUH_AUTHD_PASS) else 'not set',
            'note': 'The Wazuh agent is a third-party program and runs as root.'}


def _wazuh_repo():
    """The repository of Wazuh, off by default: only the buttons of eFa install or update from it, never dnf-automatic."""
    with urllib.request.urlopen(WAZUH_KEY_URL, timeout=30) as reply:
        key = reply.read()
    shown = subprocess.run(['gpg', '--show-keys', '--with-colons'], input=key, capture_output=True, check=False).stdout.decode()
    if f':{WAZUH_KEY_FINGERPRINT}:' not in shown:
        raise EfaError('The Wazuh signing key has an unexpected fingerprint, nothing was installed.')
    fd, path = tempfile.mkstemp(suffix='.asc')
    with os.fdopen(fd, 'wb') as f:
        f.write(key)
    try:
        subprocess.run(['rpm', '--import', path], check=True, capture_output=True)
    finally:
        os.remove(path)
    _write(WAZUH_REPO, '[wazuh]\nname=Wazuh repository\nbaseurl=https://packages.wazuh.com/4.x/yum/\ngpgcheck=1\n'
                       f'gpgkey={WAZUH_KEY_URL}\nenabled=0\nprotect=1\n')


def wazuh_script_problems(scripts):
    """Lines of the package scripts that would touch the firewall."""
    return [line.strip() for line in scripts.splitlines() if WAZUH_FORBIDDEN_SCRIPT.search(line)]


def _wazuh_fetch(version):
    """Downloads the package, checks its signature and its scripts. Returns the file, or stops before anything is installed."""
    if version and not re.fullmatch(r'\d+\.\d+\.\d+(-\d+)?', version):
        raise EfaError('Version like 4.14.10 or 4.14.10-1.')
    _wazuh_repo()
    folder = tempfile.mkdtemp(prefix='efa-wazuh-')
    name = 'wazuh-agent' + (f'-{version}' if version else '')
    try:
        # The repository has the packages of all architectures under one name.
        subprocess.run(['dnf', '-q', '--enablerepo=wazuh', 'download', '--arch', os.uname().machine, '--destdir', folder, name],
                       check=True, capture_output=True, timeout=600)
        files = glob.glob(folder + '/wazuh-agent-*.rpm')
        if len(files) != 1:
            raise EfaError('The download did not give one package.')
        signature = subprocess.run(['rpm', '-K', files[0]], capture_output=True, text=True)
        if signature.returncode != 0 or 'signatures OK' not in signature.stdout:
            raise EfaError('The package signature does not check out, nothing was installed.')
        scripts = subprocess.run(['rpm', '-qp', '--scripts', files[0]], capture_output=True, text=True, check=True).stdout
        problems = wazuh_script_problems(scripts)
        if problems:
            raise EfaError('The package scripts would touch the firewall, nothing was installed: ' + '; '.join(problems[:3]))
    except BaseException:
        shutil.rmtree(folder, ignore_errors=True)
        raise
    return files[0]


def wazuh_check(args):
    """Downloads the agent package and checks it, without installing it."""
    path = _wazuh_fetch((args.version or '').strip())
    try:
        name = subprocess.run(['rpm', '-qp', path], capture_output=True, text=True, check=True).stdout.strip()
    finally:
        shutil.rmtree(os.path.dirname(path), ignore_errors=True)
    return {'package': name, 'signature': 'ok', 'scripts': 'do not touch the firewall'}


def wazuh_install(args):
    """Install the Wazuh agent from the official repository. It starts only after wazuh-config."""
    _confirm(args)
    if _wazuh_installed():
        raise EfaError('The Wazuh agent is installed already.')
    path = _wazuh_fetch((args.version or '').strip())
    try:
        subprocess.run(['dnf', '-y', 'install', path], check=True, capture_output=True, timeout=900)
    finally:
        shutil.rmtree(os.path.dirname(path), ignore_errors=True)
    _json_write(WAZUH_FILE, {**wazuh_settings(), 'managed': True})
    subprocess.run(['systemctl', 'disable', '--now', 'wazuh-agent'], check=False, capture_output=True)
    return wazuh_status(None)


def wazuh_update(args):
    """Update the Wazuh agent, only with this button. The same checks as for the install."""
    _confirm(args)
    if not _wazuh_installed():
        raise EfaError('The Wazuh agent is not installed.')
    _wazuh_guard()
    path = _wazuh_fetch((args.version or '').strip())
    try:
        subprocess.run(['dnf', '-y', 'upgrade', path], check=True, capture_output=True, timeout=900)
    finally:
        shutil.rmtree(os.path.dirname(path), ignore_errors=True)
    return wazuh_status(None)


def wazuh_config(args):
    """Manager, ports, name, groups and the eFa block of ossec.conf. The enrollment password is asked twice, readable only by root and the agent."""
    state = _wazuh_guard(args) if os.path.exists(WAZUH_CONF) else wazuh_settings()
    manager = (args.manager or '').strip() or state['manager']
    if manager:
        try:
            ipaddress.ip_address(manager)
        except ValueError:
            if not DOMAIN_RE.match(manager):
                raise EfaError('Manager: a host name or an IP address.')
    ports = {}
    for key in ('port', 'enrollment_port'):
        value = (getattr(args, key) or '').strip() or str(state[key])
        if not value.isdigit() or not 1 <= int(value) <= 65535:
            raise EfaError('Ports: 1 to 65535.')
        ports[key] = int(value)
    name = (args.agent_name or '').strip() or state['agent_name']
    groups = (args.groups or '').strip() or state['groups']
    if (name and not WAZUH_NAME_RE.match(name)) or (groups and not re.fullmatch(r'[A-Za-z0-9_-]+(,[A-Za-z0-9_-]+)*', groups)):
        raise EfaError('Agent name: letters, digits, . _ -. Groups: separated by commas.')
    state.update(manager=manager, agent_name=name, groups=groups, events=_on_off((args.events or '').strip() or ('on' if state['events'] else 'off')),
                 active_response=_on_off((args.active_response or '').strip() or ('on' if state['active_response'] else 'off')), **ports)
    first, second = _secrets(2, 'Enrollment password, then again')
    if first != second:
        raise EfaError(PASSWORD_DIFFER + ' Nothing was changed.')
    if not os.path.exists(WAZUH_CONF):
        raise EfaError('The Wazuh agent is not installed.')
    with open(WAZUH_CONF) as f:
        conf = f.read()
    new = wazuh_conf_update(conf, state)
    real = WAZUH_CONF == '/var/ossec/etc/ossec.conf'
    if first and real:
        fd = os.open(WAZUH_AUTHD_PASS + '.tmp', os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o640)
        os.fchmod(fd, 0o640)  # the umask must not take the group read away
        with os.fdopen(fd, 'w') as f:
            f.write(first + '\n')
        shutil.chown(WAZUH_AUTHD_PASS + '.tmp', 'root', 'wazuh')
        os.replace(WAZUH_AUTHD_PASS + '.tmp', WAZUH_AUTHD_PASS)
    with open(WAZUH_CONF + '.efa-tmp', 'w') as f:
        f.write(new)
    shutil.copymode(WAZUH_CONF, WAZUH_CONF + '.efa-tmp')
    if real:
        shutil.chown(WAZUH_CONF + '.efa-tmp', 'root', 'wazuh')
    os.replace(WAZUH_CONF + '.efa-tmp', WAZUH_CONF)
    _json_write(WAZUH_FILE, state)
    events_marker()
    if real and manager:
        subprocess.run(['systemctl', 'enable', '--now', 'wazuh-agent'], check=False, capture_output=True)
        subprocess.run(['systemctl', 'restart', 'wazuh-agent'], check=False, capture_output=True)
    return {**wazuh_status(None), 'written': WAZUH_CONF}


def wazuh_service(args):
    """Start, stop or restart the Wazuh agent."""
    action = args.action.strip()
    if action not in ('start', 'stop', 'restart'):
        raise EfaError("Action must be 'start', 'stop' or 'restart'.")
    if not _wazuh_installed():
        raise EfaError('The Wazuh agent is not installed.')
    _wazuh_guard()
    subprocess.run(['systemctl', action, 'wazuh-agent'], check=True, capture_output=True, timeout=120)
    return wazuh_status(None)


def wazuh_remove(args):
    """Stop and remove the agent and the eFa block. The repository goes only if asked."""
    _confirm(args)
    _wazuh_guard()
    if _wazuh_installed():
        subprocess.run(['systemctl', 'disable', '--now', 'wazuh-agent'], check=False, capture_output=True)
        subprocess.run(['dnf', '-y', 'remove', 'wazuh-agent'], check=True, capture_output=True, timeout=600)
    for path in glob.glob('/var/ossec/etc/ossec.conf*'):
        with open(path) as f:
            text = f.read()
        if WAZUH_BEGIN in text:
            _write(path, re.sub(re.escape(WAZUH_BEGIN) + r'.*?' + re.escape(WAZUH_END) + r'\n?', '', text, flags=re.S))
    if (args.repo or '').strip() == 'yes' and os.path.exists(WAZUH_REPO):
        os.remove(WAZUH_REPO)
    _json_write(WAZUH_FILE, {**wazuh_settings(), 'events': False, 'managed': False})
    events_marker()
    return wazuh_status(None)


def _report_settings():
    return _json_read(REPORT_FILE, {'daily': False})


def sign_rows(day, fields):
    """Redis hash fields kind|domain|selector to rows for sign_daily. Odd fields are skipped, they come from rspamd."""
    rows = []
    for field, count in fields.items():
        parts = field.split('|')
        if len(parts) == 3 and parts[0] in ('dkim', 'arc', 'unsigned') and DOMAIN_RE.match(parts[1]) and str(count).isdigit():
            rows.append((day, parts[0], parts[1][:253], parts[2][:64], int(count)))
    return rows


def _sign_counts_store(today):
    """The signing and sealing counters of the last days, from Redis into MariaDB. Today is overwritten each hour."""
    rows = []
    for offset in range(3):
        day = (today - datetime.timedelta(days=offset)).isoformat()
        done = subprocess.run(['redis-cli', '--raw', 'HGETALL', SIGN_KEY + day], capture_output=True, text=True)
        values = done.stdout.splitlines() if done.returncode == 0 else []
        rows += sign_rows(day, dict(zip(values[::2], values[1::2])))
    if not rows:
        return 0
    db = _admin_db()
    try:
        with db.cursor() as cur:
            cur.executemany('REPLACE INTO sign_daily (day, kind, domain, selector, n) VALUES (%s, %s, %s, %s, %s)', rows)
    finally:
        db.close()
    return len(rows)


def mailreport_run(_args):
    """Hourly job: reads only the new log lines. The first run of a day also mails yesterday, if that is on."""
    state = _json_read(REPORT_STATE, {'inode': None, 'offset': 0, 'pending': {}, 'last_daily': None})
    today = _today()
    info = os.stat(REPORT_LOG)
    # shortcut: lines between the last run and a log rotation are lost, at most an hour of one day each week; read the rotated file if that ever matters.
    offset = state['offset'] if state['inode'] == info.st_ino and state['offset'] <= info.st_size else 0
    days, pending, new_lines = {}, state['pending'], []
    with open(REPORT_LOG, 'rb') as log:
        log.seek(offset)
        for raw in log:
            if not raw.endswith(b'\n'):
                break
            offset += len(raw)
            line = raw.decode('utf-8', 'replace')
            new_lines.append(line)
            match = REPORT_LINE.match(line)
            if match and match.group(1) in REPORT_MONTHS:
                date = _report_day(match.group(1), match.group(2), today)
                if date not in days:
                    days[date] = _report_read(date) or _report_empty()
                _report_line(days, pending, line, today)
    os.makedirs(REPORT_DIR, mode=0o750, exist_ok=True)
    today_text = today.isoformat()
    if today_text not in days:
        days[today_text] = _report_read(today_text) or _report_empty()
    days[today_text]['queue'] = _report_queue()
    for date, agg in days.items():
        _report_trim(agg)
        _json_write(f'{REPORT_DIR}/{date}.json', agg)
    for path in glob.glob(REPORT_DIR + '/*.json'):
        if os.path.basename(path)[:-5] < (today - datetime.timedelta(days=REPORT_DAYS)).isoformat():
            os.remove(path)
    # Mail that is still in the queue after this many entries is unusual, its size only feeds the delivered bytes.
    state.update(inode=info.st_ino, offset=offset, pending=dict(list(pending.items())[-REPORT_PENDING:]))
    yesterday = (today - datetime.timedelta(days=1)).isoformat()
    # Tenants and directory groups change without anyone touching the rules.
    try:
        if _rules() or _layer_rows():
            _rules_apply()
        _tenant_limits_job(today)
        _headers_job(today, state)
        try:
            if bec_state()['enabled'] and bec_state()['scores']['young_domain']:
                _rdap_refresh()
        except (EfaError, OSError, ValueError) as err:
            print(f'RDAP list: {err}', file=sys.stderr)
        try:
            state_ml = ml_state()
            if state_ml['enabled'] and len(_ml_samples()) > state_ml['samples']:
                ml_train()
        except (EfaError, OSError) as err:
            print(f'own model: {err}', file=sys.stderr)
        try:
            _queue_job(new_lines)
        except (EfaError, OSError, ValueError) as err:
            print(f'queue: {err}', file=sys.stderr)
        try:
            _phish_job()
        except (EfaError, OSError) as err:
            print(f'phishing reports: {err}', file=sys.stderr)
        try:
            _cdr_job()
        except OSError as err:
            print(f'disarm originals: {err}', file=sys.stderr)
        try:
            _strict_job(today)
        except (EfaError, OSError) as err:
            print(f'strict audit log: {err}', file=sys.stderr)
        try:
            _sign_counts_store(today)
        except (EfaError, OSError) as err:
            print(f'signing counters: {err}', file=sys.stderr)
        _exports_job()
        if _json_read(SECURITY_SETTINGS, {}).get('daily') and state.get('security_day') != today.isoformat():
            state['security_day'] = today.isoformat()
            security_check(None)
    except Exception as err:  # also pymysql errors, before the upgrade made the columns: the mail report still runs
        print(f'rules and tenants: {err}', file=sys.stderr)
    if uq_state()['enabled']:
        try:
            _uq_job(state, today)
        except (EfaError, OSError, subprocess.CalledProcessError) as err:
            print(f'quarantine: {err}', file=sys.stderr)
    wanted = _json_read(REPORTS_FILE, {})
    # The new daily report replaces the short one.
    if not wanted.get('daily') and _report_settings()['daily'] and state.get('last_daily') != yesterday and _report_read(yesterday):
        _admin_notify(f'eFa: mail report {yesterday}', _report_text(_report_view(_report_merge([yesterday]), yesterday)))
        state['last_daily'] = yesterday
    for period in reports_due(wanted, state, today):
        try:
            _reports_send(period, today)
            state[f'sent_{period}'] = today.isoformat()
        except EfaError as err:
            print(f'report {period}: {err}', file=sys.stderr)
    _json_write(REPORT_STATE, state)
    return {'lines_read_to': offset}


def mailreport_today(_args):
    """Today so far, as of the last hourly run."""
    day = _today().isoformat()
    return _report_view(_report_merge([day]), day)


def mailreport_yesterday(_args):
    """Yesterday."""
    day = (_today() - datetime.timedelta(days=1)).isoformat()
    return _report_view(_report_merge([day]), day)


def mailreport_week(_args):
    """The last 7 days."""
    days = [(_today() - datetime.timedelta(days=offset)).isoformat() for offset in range(7)]
    return _report_view(_report_merge(days), f'{days[-1]} to {days[0]}')


def mailreport_set(args):
    """Daily mail with yesterday's report to the admin."""
    data = {'daily': _on_off(args.mode)}
    _json_write(REPORT_FILE, data)
    return data


