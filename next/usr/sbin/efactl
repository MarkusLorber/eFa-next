BEC_LUA_TEXT = r'''-- Written by efactl bec-set. Do not edit.
-- Impersonation and BEC: a VIP name with another address, a domain that looks like an own or partner domain (typos, homoglyphs,
-- IDN, cousins), the first mail from a sender to a recipient, and a known sender that writes with other tools than before.
local rspamd_util = require 'rspamd_util'
local rspamd_redis = require 'rspamd_redis'
local rspamd_logger = require 'rspamd_logger'
local ucl = require 'ucl'
local parser = ucl.parser()
local parsed = parser:parse_file('/etc/rspamd/efa-bec.json')
if not parsed then
  rspamd_logger.errx(rspamd_config, 'efa-bec: no settings, the BEC checks are off')
  return
end
local conf = parser:get_object()
local REDIS = '127.0.0.1:6379'
local function lower(s) return rspamd_util.lower_utf8(s or '') end
local function skeleton(s) return rspamd_util.utf8_confusable_skeleton(lower(s)) end

-- RFC 3492: an IDN label of a domain, back to its letters.
local function puny_decode(input)
  local base, tmin, tmax, skew, damp = 36, 1, 26, 38, 700
  local n, i, bias, output = 128, 0, 72, {}
  local last = input:match('^.*()-')
  if last then
    for c in input:sub(1, last - 1):gmatch('.') do output[#output + 1] = c:byte() end
    input = input:sub(last + 1)
  end
  local pos = 1
  while pos <= #input do
    local oldi, w, k = i, 1, base
    while true do
      if pos > #input then return nil end
      local c = input:byte(pos); pos = pos + 1
      local digit = (c >= 48 and c <= 57) and c - 22 or (c >= 97 and c <= 122) and c - 97 or (c >= 65 and c <= 90) and c - 65 or nil
      if not digit then return nil end
      i = i + digit * w
      local t = k <= bias and tmin or (k >= bias + tmax and tmax or k - bias)
      if digit < t then break end
      w = w * (base - t); k = k + base
      if w > 1e9 then return nil end
    end
    local delta = (oldi == 0) and math.floor((i - oldi) / damp) or math.floor((i - oldi) / 2)
    delta = delta + math.floor(delta / (#output + 1))
    local kk = 0
    while delta > math.floor(((base - tmin) * tmax) / 2) do delta = math.floor(delta / (base - tmin)); kk = kk + base end
    bias = kk + math.floor((base - tmin + 1) * delta / (delta + skew))
    n = n + math.floor(i / (#output + 1)); i = i % (#output + 1)
    if n > 0x10FFFF then return nil end
    table.insert(output, i + 1, n); i = i + 1
  end
  -- LuaJIT has no utf8 library: the bytes of each code point by hand.
  local chars = {}
  for _, cp in ipairs(output) do
    if cp < 0x80 then chars[#chars + 1] = string.char(cp)
    elseif cp < 0x800 then chars[#chars + 1] = string.char(0xC0 + math.floor(cp / 0x40), 0x80 + cp % 0x40)
    elseif cp < 0x10000 then chars[#chars + 1] = string.char(0xE0 + math.floor(cp / 0x1000), 0x80 + math.floor(cp / 0x40) % 0x40, 0x80 + cp % 0x40)
    else chars[#chars + 1] = string.char(0xF0 + math.floor(cp / 0x40000), 0x80 + math.floor(cp / 0x1000) % 0x40, 0x80 + math.floor(cp / 0x40) % 0x40, 0x80 + cp % 0x40) end
  end
  return table.concat(chars)
end

local function unicode_domain(domain)
  local labels = {}
  for label in lower(domain):gmatch('[^.]+') do
    labels[#labels + 1] = label:sub(1, 4) == 'xn--' and (puny_decode(label:sub(5)) or label) or label
  end
  return table.concat(labels, '.')
end

local protected, by_skeleton = {}, {}
for _, domain in ipairs(conf.protected or {}) do
  protected[domain] = true
  by_skeleton[skeleton(domain)] = domain
end
local vips = {}
for _, vip in ipairs(conf.vips or {}) do vips[#vips + 1] = {name = skeleton(vip.name), address = lower(vip.address)} end

local function lookalike(domain)
  domain = lower(domain)
  if domain == '' or protected[domain] then return nil end
  for own in pairs(protected) do
    if domain:sub(-#own - 1) == '.' .. own then return nil end
  end
  local text = unicode_domain(domain)
  local found = by_skeleton[skeleton(text)]
  if found then return found, 'homoglyph' end
  local esld = rspamd_util.get_tld(text) or text
  for own in pairs(protected) do
    local own_esld = rspamd_util.get_tld(own) or own
    local limit = #own_esld >= 12 and 2 or 1
    if #own_esld >= 6 and math.abs(#own_esld - #esld) <= limit and rspamd_util.levenshtein_distance(esld, own_esld) <= limit then
      return own, 'typo'
    end
    local label = own_esld:match('^[^.]+') or ''
    if #label >= 5 and text:find(label, 1, true) and not text:find('^' .. label:gsub('%p', '%%%0') .. '%.') then
      return own, 'cousin'
    end
  end
  return nil
end

local function outbound(task)
  local ip = task:get_from_ip()
  return task:get_user() or (ip and ip:is_valid() and ip:is_local())
end

rspamd_config:register_symbol({name = 'EFA_BEC_VIP_NAME', score = conf.scores.vip, group = 'efa_bec',
  description = 'The display name of a VIP with another address', callback = function(task)
  if outbound(task) or #vips == 0 then return end
  local from = task:get_from('mime')
  if not from or not from[1] or not from[1].name or from[1].name == '' then return end
  local name, address = skeleton(from[1].name), lower(from[1].addr)
  for _, vip in ipairs(vips) do
    if (name == vip.name or name:find(vip.name, 1, true)) and address ~= vip.address then
      return true, 1.0, vip.address
    end
  end
end})

rspamd_config:register_symbol({name = 'EFA_BEC_LOOKALIKE', score = conf.scores.lookalike, group = 'efa_bec',
  description = 'A domain that looks like an own or partner domain', callback = function(task)
  if outbound(task) then return end
  local checked = {}
  for _, field in ipairs({'mime', 'smtp'}) do
    local from = task:get_from(field)
    if from and from[1] and from[1].domain then checked[#checked + 1] = from[1].domain end
  end
  local reply = task:get_header('Reply-To')
  if reply then
    local parsed_reply = rspamd_util.parse_mail_address(reply, task:get_mempool())
    if parsed_reply and parsed_reply[1] and parsed_reply[1].domain then checked[#checked + 1] = parsed_reply[1].domain end
  end
  for _, domain in ipairs(checked) do
    local own, kind = lookalike(domain)
    if own then return true, 1.0, domain .. ':' .. kind .. ':' .. own end
  end
end})

-- Pairs from outbound mail: an own user wrote to that address. Inbound mail without such a pair is a first contact.
rspamd_config:register_symbol({name = 'EFA_BEC_FIRST_CONTACT', score = conf.scores.first_contact, group = 'efa_bec',
  description = 'No mail went from this recipient to this sender before', callback = function(task)
  local from = task:get_from('smtp')
  local sender = from and from[1] and lower(from[1].addr) or ''
  if sender == '' then return end
  local rcpts = task:get_recipients('smtp') or {}
  if outbound(task) then
    for _, rcpt in ipairs(rcpts) do
      rspamd_redis.make_request({task = task, host = REDIS, cmd = 'SET',
        args = {'efa:bec:rel:' .. sender .. '|' .. lower(rcpt.addr), '1', 'EX', tostring(conf.relation_days * 86400)}, callback = function() end})
    end
    return
  end
  if not rcpts[1] then return end
  rspamd_redis.make_request({task = task, host = REDIS, cmd = 'EXISTS', args = {'efa:bec:rel:' .. lower(rcpts[1].addr) .. '|' .. sender},
    callback = function(err, data)
      if not err and tonumber(data) == 0 then task:insert_result('EFA_BEC_FIRST_CONTACT', 1.0, sender) end
    end})
end})

-- What a sender writes with: the mail program and the domain of its Message-ID. A known sender with both new looks taken over.
rspamd_config:register_symbol({name = 'EFA_BEC_STYLE_CHANGE', score = conf.scores.style, group = 'efa_bec',
  description = 'A known sender writes with another program and Message-ID domain than before', callback = function(task)
  if outbound(task) then return end
  local from = task:get_from('mime')
  local sender = from and from[1] and lower(from[1].addr) or ''
  if sender == '' then return end
  local mailer = lower(task:get_header('X-Mailer') or task:get_header('User-Agent') or 'none'):match('^[%w%-%._ ]*'):sub(1, 40)
  local mid = lower((task:get_message_id() or ''):match('@([^>]+)') or 'none'):sub(1, 80)
  local key = 'efa:bec:style:' .. sender
  rspamd_redis.make_request({task = task, host = REDIS, cmd = 'HMGET', args = {key, 'n', 'm:' .. mailer, 'd:' .. mid},
    callback = function(err, data)
      if err or type(data) ~= 'table' then return end
      local seen = tonumber(data[1]) or 0
      if seen >= conf.style_min and not tonumber(data[2]) and not tonumber(data[3]) then
        task:insert_result('EFA_BEC_STYLE_CHANGE', 1.0, mailer .. '@' .. mid)
      end
      for _, field in ipairs({'n', 'm:' .. mailer, 'd:' .. mid}) do
        rspamd_redis.make_request({task = task, host = REDIS, cmd = 'HINCRBY', args = {key, field, '1'}, callback = function() end})
      end
      rspamd_redis.make_request({task = task, host = REDIS, cmd = 'EXPIRE', args = {key, tostring(conf.relation_days * 86400)}, callback = function() end})
    end})
end})

-- What BEC mails push for: two kinds of it in the text of one mail.
if (conf.scores.language or 0) ~= 0 then
  rspamd_config:register_symbol({name = 'EFA_BEC_LANGUAGE', score = conf.scores.language, group = 'efa_bec',
    description = 'The words of a BEC mail: urgency, payment, secrecy, gift cards, a new account', callback = function(task)
    if outbound(task) then return end
    local found = {}
    for _, part in ipairs(task:get_text_parts() or {}) do
      local content = part:get_content()
      if content and #content < 200000 then
        local text = lower(tostring(content))
        for kind, words in pairs(conf.phrases or {}) do
          if not found[kind] then
            for _, word in ipairs(words) do
              if text:find(word, 1, true) then found[kind] = true; break end
            end
          end
        end
      end
    end
    local kinds = {}
    for kind in pairs(found) do kinds[#kinds + 1] = kind end
    if #kinds >= 2 then table.sort(kinds); return true, 1.0, table.concat(kinds, ',') end
  end})
end

-- Young domains: the registration date from the RDAP server of its registry, cached in Redis.
if (conf.scores.young_domain or 0) ~= 0 then
  local rspamd_http = require 'rspamd_http'
  local rdap = {}
  local rdap_parser = ucl.parser()
  if rdap_parser:parse_file('/etc/rspamd/efa-rdap.json') then rdap = rdap_parser:get_object() end
  local function registered(text)
    local y, m, d = (text or ''):match('^(%d%d%d%d)-(%d%d)-(%d%d)')
    return y and os.time({year = tonumber(y), month = tonumber(m), day = tonumber(d), hour = 12}) or nil
  end
  rspamd_config:register_symbol({name = 'EFA_YOUNG_DOMAIN', score = conf.scores.young_domain, group = 'efa_bec',
    description = 'The domain of the sender or of a link is only a few days old', callback = function(task)
    if outbound(task) then return end
    local domains, seen = {}, {}
    local from = task:get_from('mime')
    if from and from[1] and from[1].domain then domains[#domains + 1] = rspamd_util.get_tld(lower(from[1].domain)) end
    for _, url in ipairs(task:get_urls() or {}) do
      if #domains >= 4 then break end
      domains[#domains + 1] = url:get_tld()
    end
    local limit = os.time() - conf.young_days * 86400
    for _, domain in ipairs(domains) do
      if domain and domain ~= '' and not seen[domain] and not protected[domain] then
        seen[domain] = true
        local key = 'efa:age:' .. domain
        local function judge(stamp)
          if stamp and stamp > limit then task:insert_result('EFA_YOUNG_DOMAIN', 1.0, domain .. ':' .. os.date('!%Y-%m-%d', stamp)) end
        end
        rspamd_redis.make_request({task = task, host = REDIS, cmd = 'GET', args = {key}, callback = function(err, data)
          if not err and type(data) == 'string' then judge(tonumber(data)); return end
          local base = rdap[domain:match('([^.]+)$') or '']
          if not base then return end
          rspamd_http.request({task = task, url = base .. 'domain/' .. domain, timeout = 3, callback = function(http_err, code, body)
            local stamp
            if not http_err and code == 200 and body then
              local reply = ucl.parser()
              if reply:parse_string(tostring(body)) then
                for _, event in ipairs(reply:get_object().events or {}) do
                  if event.eventAction == 'registration' then stamp = registered(event.eventDate) end
                end
              end
            end
            -- A known date for 30 days, an unknown one for a day: RDAP servers limit how often they answer.
            rspamd_redis.make_request({task = task, host = REDIS, cmd = 'SET', args = {key, tostring(stamp or 'unknown'), 'EX', stamp and '2592000' or '86400'},
              callback = function() end})
            judge(stamp)
          end})
        end})
      end
    end
  end})
end
'''
UQ_DEFAULTS = {'enabled': False, 'score': 15.0, 'days': 30, 'digest': False, 'self_release': True, 'public_url': ''}
UQ_LINK_DAYS = 7
UQ_DIGEST_LINES = 200
UQ_LUA_TEXT = '''-- Written by efactl uq-set. Do not edit.
-- Mail above the limit, and viruses, go to the eFa quarantine instead of being rejected. Only once the copy is stored:
-- if that fails, the mail takes its normal way. Own mail and hard blocks (sender lists, DMARC) stay as they are.
local rspamd_http = require 'rspamd_http'
local rspamd_util = require 'rspamd_util'
local ucl = require 'ucl'
local LIMIT = %(score)s
rspamd_config:register_symbol({
  name = 'EFA_USER_QUARANTINE',
  type = 'postfilter',
  -- The virus scanner ends the scan early with its reject: this has to run anyway.
  flags = 'ignore_passthrough',
  callback = function(task)
    local ip = task:get_from_ip()
    if task:get_user() or (ip and ip:is_valid() and ip:is_local()) then return end
    local malware = task:has_symbol('CLAM_VIRUS')
    local score = task:get_metric_score('default')[1]
    if not malware and (task:has_pre_result() or score < LIMIT) then return end
    local rcpts, senders = {}, task:get_from('smtp')
    for _, rcpt in ipairs(task:get_recipients('smtp') or {}) do rcpts[#rcpts + 1] = rcpt.addr end
    if #rcpts == 0 then return end
    local meta = {sender = senders and senders[1] and senders[1].addr or '', rcpts = rcpts, subject = task:get_subject() or '', score = score,
                  malware = malware and 1 or 0, message_id = task:get_message_id() or '', ip = ip and tostring(ip) or '', qid = task:get_queue_id() or ''}
    rspamd_http.request({
      task = task,
      url = 'http://127.0.0.1:8906/quarantine',
      timeout = 20,
      body = task:get_content(),
      -- A string, not rspamd text: other types are left out of the request.
      headers = {['X-Efa-Meta'] = tostring(rspamd_util.encode_base64(ucl.to_format(meta, 'json-compact'), 0))},
      callback = function(err, code)
        if not err and code == 200 then
          -- High: it has to outrank the reject of the virus scanner, a stored virus must not also bounce.
          task:set_pre_result({action = 'discard', message = 'Held in quarantine', module = 'efa_quarantine', priority = 2})
        end
      end,
    })
  end,
})
'''
