        assert _update_fetch_latest(state, answer(200, release, '"abc"')) and state['security'] and state['published'] == '2026-11-10' and state['etag'] == '"abc"'
        assert _update_fetch_latest(state, answer(304)) is False and sent[-1].get('If-none-match') == '"abc"' and state['latest'] == 'v99.0.0.1'
        assert 'eFa-next' == sent[-1].get('User-agent'), 'no version or host in the request'
        assert not _update_available(state), 'not available before the packages are checked'
