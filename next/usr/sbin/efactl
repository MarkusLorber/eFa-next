# Arguments with a fixed set of values: the web interface shows a dropdown, efactl refuses anything else.
# (label, [(value, text), ...]). An empty value in the list means "not set" or "keep".
ADD_REMOVE = [('add', 'Add'), ('remove', 'Remove')]
SET_REMOVE = [('set', 'Set'), ('remove', 'Remove')]
ALLOW_BLOCK = [('allow', 'Allow'), ('block', 'Block')]
INHERIT = [('', 'Keep as it is'), ('inherit', 'Inherit from above')]
