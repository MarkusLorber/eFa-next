                     "print(registered.EFA_EXECUTABLE(task('report.dat', 'MZ' .. string.rep('x', 60))) and 'program' or 'none')\n"
                     "print(registered.EFA_EXECUTABLE(task('elf.bin', string.char(127) .. 'ELF' .. string.rep('x', 60))) and 'program' or 'none')\n"
                     "print(registered.EFA_EXECUTABLE(task('note.txt', 'just a text, no program')) and 'program' or 'none')\n")
