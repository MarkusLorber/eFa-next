        assert allow_lists(placed, ref, log_ref, True) == placed, 'a second run changes nothing'
        assert allow_lists({**chains, 'smtpd_relay_restrictions': 'permit_mynetworks'}, ref, log_ref, True)['smtpd_relay_restrictions'] == \
            'permit_mynetworks', 'no relay check in the list: no OK there'
        cleared = allow_lists(placed, ref, log_ref, False)
        assert not any(_allow_item(item) for value in cleared.values() for item in restriction_items(value)), 'no entry: no lookup'
        assert allow_lists({'smtpd_helo_restrictions': ''}, ref, log_ref, True)['smtpd_helo_restrictions'] == '', 'an empty list stays empty'
        # Each pass and each virus cut out goes to the audit log, from the journal of Postfix and efa-cdr.
        assert allow_audit_lines(['NOQUEUE: warn: RCPT from mx-relay1.example.net[203.0.113.25]: <arnold-it@ai.local>: Sender address triggers WARN '
