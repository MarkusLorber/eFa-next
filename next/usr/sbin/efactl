class EfaError(Exception):
    pass


def _text(template, **values):
    """UI-1: a text for the dashboard with values in it. The template is the msgid of the catalogs (scripts/i18n_extract.py
    collects every _text template); the web interface finds the template again and shows the translation with the same values."""
    return template.format(**values)

def _rspamd_user():
    return '_rspamd'


def _own_key(path):
    shutil.chown(path, 'root', _rspamd_user())


def _today():
    return datetime.date.today()


class DamagedFile(EfaError, ValueError):
    """A settings file that is no valid JSON: a clear message for the web, and still the ValueError its callers catch."""


def _json_read(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except FileNotFoundError:
        return default
    except ValueError:
        # Not the default instead: a broken file of a security setting must not quietly turn it off.
        raise DamagedFile(f'{path} is damaged (no valid JSON); restore it from a backup or fix it by hand.')


# A snapshot of the state (the tar of scripts/ci.sh snap_tar) holds this lock exclusively: the writers wait the few seconds
# instead of changing the folder under it. Shared among the writers; without the file (no root) they write as before.
STATE_LOCK = '/run/efa-state.lock'


# The settings below /etc/eFa: never readable by everyone (the security self-check). Each file a service reads gets the group of
# that reader, 0640; everything else only root reads (efactl, efa-runner): 0640 root:root. efa-conf: efa-web and efa-portal;
# efa-mailconf: the mail services (efa-maillog, efa-milter-health, efa-outbound), S32: the portal reads none of theirs.
# Not in the table: root:root.
CONF_READERS = {'audit-strict.json': 'efa-conf', 'admin-idle.json': 'efa-conf', 'login-banner.json': 'efa-conf', 'load.json': 'efa-conf', 'setup-variant.json': 'efa-conf', 'web-allowlist.json': 'efa-conf',
                'legal-accepted.json': 'efa-conf', 'outbound.json': 'efa-mailconf', 'milter-health.json': 'efa-mailconf',
                'dkim-provision.json': 'efa-dkim-api'}


def conf_mode(path, wanted=0o640):
    """(mode, group) of a settings file below /etc/eFa, or None for any other path. A file only root reads keeps a stricter mode
    it is written with (0600 for one with a secret); never more than 0640."""
    if os.path.dirname(path) != ETC + '/eFa' or not path.endswith('.json'):
        return None
    group = CONF_READERS.get(os.path.basename(path), 'root')
    return (0o640 if group != 'root' else wanted & 0o640), group


def _conf_own(path, mode, group):
    """mode and root:group on a file; a group that does not exist yet (before its setup step) leaves root."""
    try:
        gid = grp.getgrnam(group).gr_gid
    except KeyError:
        gid = 0
    os.chown(path, 0, gid)
    os.chmod(path, mode)


def conf_modes_heal(_args):
    """The update: every settings file below /etc/eFa as the table says (written 0644 by earlier versions)."""
    changed = []
    for path in sorted(glob.glob(ETC + '/eFa/*.json')):
        info = os.stat(path)
        mode, group = conf_mode(path, info.st_mode & 0o777)
        try:
            gid = grp.getgrnam(group).gr_gid
        except KeyError:
            gid = 0
        if info.st_mode & 0o777 != mode or info.st_gid != gid or info.st_uid != 0:
            _conf_own(path, mode, group)
            changed.append(f'{os.path.basename(path)}: {oct(info.st_mode & 0o777)} -> {oct(mode)} root:{group}')
    if changed:
        _audit('settings file modes healed: ' + '; '.join(changed)[:900])
    return {'changed': changed}


def _json_write(path, data, mode=0o640):
    # shortcut: no lock between writers of one file, the daily timer and an admin could overwrite each other; add one if that ever matters.
    os.makedirs(os.path.dirname(path), exist_ok=True)
    try:
        lock = open(STATE_LOCK, 'a')
        fcntl.flock(lock, fcntl.LOCK_SH)
    except OSError:
        lock = None
    try:
        # A name of its own per writer: two writers at once (the floor guard and a service start) took the same .tmp from each
        # other. Only for root while it is written (mkstemp: 0600): some of these files hold passwords and keys.
        fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=os.path.basename(path) + '.', suffix='.tmp')
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, 'w') as f:
            json.dump(data, f, indent=2, sort_keys=True)
            f.flush()
            os.fsync(f.fileno())
        own = conf_mode(path, mode)
        if own:
            _conf_own(tmp, *own)
        else:
            os.chmod(tmp, mode)
        os.replace(tmp, path)
    finally:
        if lock:
            lock.close()


def _reload_rspamd():
    subprocess.run(['systemctl', 'reload', 'rspamd'], check=False, capture_output=True)


def own_hostname():
    """The own name of the host for reports, headers and labels (efa_host): myhostname of Postfix, else the kernel's."""
    return _lib('efa_host').own_hostname(ETC)


def _postconf(name):
    return _postconf_many([name])[name]


# postconf takes 20 to 50 ms a call: its answers are kept until main.cf or postconf itself (a Postfix update) changes.
POSTCONF_CACHE = '/run/efa-postconf.json'


def _postconf_key():
    try:
        return [[found.st_mtime_ns, found.st_size, found.st_ino] for found in (os.stat(ETC + '/postfix/main.cf'), os.stat('/usr/sbin/postconf'))]
    except OSError:
        return None


def _postconf_many(names):
    """Several values in one call of postconf (it prints them in this order, one per line): one process instead of one each,
    none while main.cf is as it was."""
    key = _postconf_key()
    try:
        with open(POSTCONF_CACHE) as f:
            cached = json.load(f)
    except (OSError, ValueError):
        cached = {}
    if key is None or cached.get('key') != key:
        cached = {'key': key, 'values': {}}
    if all(name in cached['values'] for name in names):
        return {name: cached['values'][name] for name in names}
    lines = subprocess.run(['postconf', '-h', *names], capture_output=True, text=True, check=True).stdout.splitlines()
    found = dict(zip(names, (line.strip() for line in lines)))
    complete, found = len(found) == len(names), {name: found.get(name, '') for name in names}
    if key is not None and complete and _postconf_key() == key:
        cached['values'].update(found)
        try:
            fd = os.open(POSTCONF_CACHE + '.new', os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
            with os.fdopen(fd, 'w') as f:
                json.dump(cached, f)
            os.replace(POSTCONF_CACHE + '.new', POSTCONF_CACHE)
        except OSError:
            pass  # not root (a test): every call asks postconf
    return found


def _postconf_set(name, value):
    main_cf = subprocess.run(['postconf', '-h', 'config_directory'], capture_output=True, text=True,
                             check=True).stdout.strip() + '/main.cf'
    backup = main_cf + '.efactl'
    shutil.copy2(main_cf, backup)
    try:
        subprocess.run(['postconf', '-e', f'{name} = {value}'], check=True)
        done = subprocess.run(['postfix', 'check'], capture_output=True, text=True)
        if done.returncode != 0:
            # A broken main.cf would stop mail at the next reload, so keep the working one.
            shutil.copy2(backup, main_cf)
            raise EfaError(f'postfix check failed, nothing changed: {done.stderr.strip()[:300]}')
    finally:
        os.remove(backup)
    subprocess.run(['systemctl', 'reload', 'postfix'], check=False, capture_output=True)


def _write(path, text, mode=0o644):
    """Writes in place, so the file keeps its owner and SELinux label. A new file is created with mode; an existing one gets
    mode before the new text goes in, so a key is never readable for a moment by everyone."""
    os.makedirs(os.path.dirname(path), exist_ok=True)
    own = conf_mode(path, mode)
    mode = own[0] if own else mode
    if os.path.exists(path):
        os.chmod(path, mode)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, mode)
    os.fchmod(fd, mode)  # the umask could have taken bits away; never more than mode either
    with os.fdopen(fd, 'w') as f:
        f.write(text)
    if own:
        _conf_own(path, *own)  # a settings file below /etc/eFa: the group of its reader (CONF_READERS)
    else:
        os.chmod(path, mode)


def _read_lines(path):
    try:
        with open(path) as f:
            return [line.strip() for line in f if line.strip()]
    except FileNotFoundError:
        return []


def protection_gaps(actions, greylisting, bec_on):
    """MIG-GREY: [(text, page, command)] for the dashboard. Greylisting off with its score below the spam marking: mail in between
    gets no action at all. Greylisting and BEC off: on is recommended (an update changes no settings, a new install has both on)."""
    found = []
    try:
        grey, mark = float(actions['greylist']), float(actions['rewrite_subject'])
    except (KeyError, TypeError, ValueError):
        grey = mark = 0.0
    if not greylisting and grey < mark:
        found.append((_text('Greylisting is off, but its score {grey} is below the spam marking ({mark}): mail scoring {grey} to {mark} gets '
                            'no action at all. Switch greylisting on (recommended), or raise the greylist score to {mark} (Spam scores).',
                            grey=f'{grey:g}', mark=f'{mark:g}'), 'spam', 'greylisting-set'))
    elif not greylisting:
        found.append((_text('Greylisting is off: on is recommended (a new sender waits 5 minutes, known for 7 days).'), 'spam', 'greylisting-set'))
    if not bec_on:
        found.append((_text('The BEC checks (fake names of VIPs, lookalike domains, first contacts) are off: on is recommended.'), 'bec', 'bec-set'))
    return found


# Hans 2026-11-15: each notice of the dashboard can be confirmed or hidden, and shown again. Confirmed: away for 30 days, or until
# its text changes. Hidden: away until shown again, also when only a number in it changes. Per host: /var/lib, not in the backup,
# not sent to cluster nodes (CLUSTER_LOCAL). The text is kept for the list "shown again" of the dashboard.
NOTICE_ACK_FILE = '/var/lib/eFa/notice-ack.json'
NOTICE_ACK_KEEP = 300
NOTICE_CONFIRM_DAYS = 30
# These go only once their cause is gone: a stopped service, the queues, problems of the security check.
NOTICE_FIXED_ONLY = {('dash', 'status'), ('sec', 'security-status')}


def notice_keys(text, slug, anchor):
    """(exact, kind): the key of this very text, and of the notice with any number in it. efa-web builds the same (notice_keys)."""
    exact = hashlib.sha256(f'{slug}|{anchor}|{text}'.encode()).hexdigest()[:16]
    kind = hashlib.sha256(f'{slug}|{anchor}|{re.sub(r"[0-9]+", "#", text)}'.encode()).hexdigest()[:16]
    return exact, kind


def notice_acks(now=None):
    """The confirmed and hidden notices in effect, each [text, page, card, key, state, until]: as a notice, so a domain scope
    drops the ones that name a foreign domain (domain_filter)."""
    now = time.time() if now is None else now
    found = []
    for key, item in _json_read(NOTICE_ACK_FILE, {}).items():
        if not isinstance(item, dict) or item.get('state') not in ('confirmed', 'hidden'):
            continue
        if item['state'] == 'confirmed' and float(item.get('until') or 0) < now:
            continue
        found.append([str(item.get('text', '')), str(item.get('slug', '')), str(item.get('anchor', '')), key, item['state'],
                      time.strftime('%Y-%m-%d', time.localtime(item['until'])) if item.get('until') else ''])
    return found


def notice_ack(args):
    """Confirms, hides or shows again one notice of the dashboard on this host."""
    action = (args.action or '').strip()
    if action not in ('confirm', 'hide', 'show'):
        raise EfaError('Action: confirm, hide or show.')
    acks = {key: item for key, item in _json_read(NOTICE_ACK_FILE, {}).items() if isinstance(item, dict)}
    who = _dmarc_who()
    if action == 'show':
        key = (args.key or '').strip()
        if not re.fullmatch(r'[0-9a-f]{16}', key) or key not in acks:
            raise EfaError('No confirmed or hidden notice with this key.')
        item = acks.pop(key)
        _json_write(NOTICE_ACK_FILE, acks, mode=0o600)
        _audit(f"dashboard notice shown again by {who}: {item.get('text', '')[:200]}")
        return {'action': action, 'key': key, 'notice_acks': notice_acks()}
    text = ' '.join((args.text or '').split())
    slug, anchor = (args.slug or '').strip(), (args.anchor or '').strip()
    if not text or len(text) > 500 or not re.fullmatch(r'[a-z0-9-]{1,40}', slug) or not re.fullmatch(r'[a-z0-9-]{1,60}', anchor):
        raise EfaError('The notice as the dashboard shows it: text, page and card.')
    if (slug, anchor) in NOTICE_FIXED_ONLY:
        raise EfaError('This notice goes only once its cause is fixed.')
    exact, kind = notice_keys(text, slug, anchor)
    now = time.time()
    key = exact if action == 'confirm' else kind
    acks.pop(exact, None)
    acks.pop(kind, None)
    acks[key] = {'state': 'confirmed' if action == 'confirm' else 'hidden', 'text': text, 'slug': slug, 'anchor': anchor, 'at': int(now), 'by': who,
                 **({'until': int(now + NOTICE_CONFIRM_DAYS * 86400)} if action == 'confirm' else {})}
    # Old confirmations first, then the oldest: the file stays small.
    for old in [name for name, item in acks.items() if item.get('state') == 'confirmed' and float(item.get('until') or 0) < now]:
        acks.pop(old)
    for old in sorted(acks, key=lambda name: acks[name].get('at', 0))[:-NOTICE_ACK_KEEP]:
        acks.pop(old)
    _json_write(NOTICE_ACK_FILE, acks, mode=0o600)
    _audit(f"dashboard notice {'confirmed' if action == 'confirm' else 'hidden'} by {who}: {text[:200]}")
    return {'action': action, 'key': key, 'notice_acks': notice_acks()}


def feature_notices():
    """The notices of the dashboard with the card that fixes them in one click."""
    return (protection_gaps(_actions(), 'enabled = false;' not in _read_lines(GREYLIST_CONF), bec_state()['enabled'])
            + [(text, 'net', 'dns-forward-fix') for text in _safe(dns_forward_notices, [])])


def status(_args):
    """Service and milter state from the health service."""
    try:
        with urllib.request.urlopen(HEALTH_URL, timeout=5) as reply:
            return {**json.load(reply), 'dkim_rotation': _rotation_notices(), 'system_notices': _system_notices(), 'feature_notices': _safe(feature_notices, []), 'cve_banner': _safe(cve_banner, []) + _safe(floor_banner, []) + _safe(totp_banner, []) + _safe(dev_flag_banner, []) + _safe(acme_banner, []) + _safe(os_check_banner, []) + _safe(el9_banner, []) + _safe(lua_banner, []), 'security_minimum': _safe(floor_banner, []), 'notice_acks': _safe(notice_acks, []),
                    'dkim_rotation_last_check': _rotation_state()['last_run'], 'dkim_rotation_next_check': _rotation_next_check()}
    except urllib.error.HTTPError as err:
        return {**json.load(err), 'dkim_rotation': _rotation_notices(), 'system_notices': _system_notices(), 'feature_notices': _safe(feature_notices, []), 'cve_banner': _safe(cve_banner, []) + _safe(floor_banner, []) + _safe(dev_flag_banner, []) + _safe(os_check_banner, []) + _safe(el9_banner, []) + _safe(lua_banner, []), 'security_minimum': _safe(floor_banner, []), 'notice_acks': _safe(notice_acks, []),
                'dkim_rotation_last_check': _rotation_state()['last_run'], 'dkim_rotation_next_check': _rotation_next_check()}
    except OSError as err:
        raise EfaError(f'health service not reachable: {err}')


def subject_get(_args):
    """Text put in front of the subject of mail with a hard SPF, DKIM or DMARC failure."""
    try:
        with open(SUBJECT_TAG) as f:
            return {'subject_tag': f.readline().strip()}
    except FileNotFoundError:
        return {'subject_tag': ''}


def subject_set(args):
    """Set the subject marking; an empty text turns it off."""
    tag = args.text.strip()
    if not tag:
        if os.path.exists(SUBJECT_TAG):
            os.remove(SUBJECT_TAG)
        return {'subject_tag': ''}
    if not TAG_RE.match(tag):
        raise EfaError('Text: up to 40 letters, digits, spaces or [ ] _ : . * ! -')
    with open(SUBJECT_TAG, 'w') as f:
        f.write(tag + '\n')
    os.chmod(SUBJECT_TAG, 0o644)
    return {'subject_tag': tag}


# 5o: another system that signs for some domains hands its keys, their times and its DNS records to eFa-next
# (docs/api-dkim-provisioning.md). efa-dkim-api.py takes the calls on 8463 and hands each one to dkim-provision-apply.
PROVISION_FILE = ETC + '/eFa/dkim-provision.json'
PROVISION_DIR = ETC + '/eFa/dkim-api'
DKIM_PROVISIONED = DKIM_DIR + '/provisioned'
PROVISION_UNIT = 'efa-dkim-api'
PROVISION_USER = 'efa-dkim-api'
PROVISION_RATES = (60, 120, 300, 600, 1200)
PROVISION_MAX_DOMAINS = 500
PROVISION_CHANGED = []  # filled when a call stored or released something; the cluster journal looks at it
PROVISION_MODES = ('sign_here', 'signed_downstream')
# What a source may deliver; each its own right, so a DKIM source cannot set disclaimers and the other way round.
PROVISION_RIGHTS = ('dkim', 'disclaimer')
FAIL2BAN_DKIM_API_FILTER = ETC + '/fail2ban/filter.d/efa-dkim-api.conf'
FAIL2BAN_DKIM_API_JAIL = '[efa-dkim-api]\nenabled = true\nbackend = systemd\nfilter = efa-dkim-api\nport = 8463\nmaxretry = 30\nfindtime = 60\n'
# The own DKIM commands that would change a domain the source manages.
PROVISION_LOCKED = {'dkim-create', 'dkim-generate', 'dkim-generate-ed25519', 'dkim-remove', 'dkim-import', 'rotation-set', 'rotation-pregenerate', 'arc-set'}


def _provision_state():
    state = _json_read(PROVISION_FILE, {})
    state.setdefault('mode', 'off')
    state.setdefault('sources', {})
    state.setdefault('domains', {})
    return state


def _provision_write(state):
    _json_write(PROVISION_FILE, state)
    if os.path.exists(PROVISION_FILE) and _group_exists(PROVISION_USER):
        shutil.chown(PROVISION_FILE, 'root', PROVISION_USER)


def _group_exists(name):
    try:
        import grp
        grp.getgrnam(name)
        return True
    except (KeyError, ImportError):
        return False


def provision_managed(domain):
    """The source that manages a domain, or ''."""
    return _provision_state()['domains'].get(domain.strip().lower(), {}).get('source', '')


def provision_checksum(body):
    rest = {key: value for key, value in body.items() if key != 'checksum'}
    return 'sha256:' + hashlib.sha256(json.dumps(rest, sort_keys=True, separators=(',', ':')).encode()).hexdigest()


def _provision_time(value):
    if not value:
        return None
    try:
        return datetime.datetime.strptime(str(value), '%Y-%m-%dT%H:%M:%SZ').replace(tzinfo=datetime.timezone.utc)
    except ValueError:
        raise ValueError(f'time {str(value)[:30]}: like 2026-06-01T00:00:00Z')


def provision_check(body, source, sources):
    """The state of one domain as the source sent it: an error text (400/403) or None."""
    if not isinstance(body, dict):
        return 400, 'the state of a domain is a JSON object'
    domain = str(body.get('domain', '')).strip().lower()
    if not DOMAIN_RE.match(domain):
        return 400, 'domain: not a domain'
    allowed = sources[source].get('domains', [])
    if domain not in allowed:
        return 403, f'{domain} is not one of the domains of this source'
    if not isinstance(body.get('version'), int) or body['version'] < 0:
        return 400, 'version: a whole number'
    if body.get('mode') not in PROVISION_MODES:
        return 400, 'mode: sign_here or signed_downstream'
    selectors = body.get('selectors', [])
    if not isinstance(selectors, list) or (body['mode'] == 'sign_here' and not selectors) or len(selectors) > 20:
        return 400, 'selectors: for sign_here at least one, at most 20'
    for item in selectors:
        if not isinstance(item, dict) or not SELECTOR_RE.match(str(item.get('selector', ''))) or item.get('type') not in ('rsa', 'ed25519'):
            return 400, 'selector: name and type rsa or ed25519'
        if body['mode'] == 'sign_here' and 'PRIVATE KEY-----' not in str(item.get('private_key', '')):
            return 400, f"selector {item['selector']}: private_key in PEM"
        try:
            start, end = _provision_time(item.get('valid_from')), _provision_time(item.get('valid_until'))
        except ValueError as err:
            return 400, f"selector {item['selector']}: {err}"
        if start and end and end <= start:
            return 400, f"selector {item['selector']}: valid_until before valid_from"
    if body.get('checksum') != provision_checksum(body):
        return 400, 'checksum does not match'
    return None


def _provision_key_file(domain, item, folder):
    """The private key of a selector in the form rspamd reads; the type and size checked. Returns the path."""
    os.makedirs(folder, mode=0o750, exist_ok=True)
    fd, temp = tempfile.mkstemp(prefix='efa-prov-')
    with os.fdopen(fd, 'w') as f:
        f.write(item['private_key'])
    try:
        public = _dkim_public_read(temp)
        if not public or public[0] != item['type']:
            raise ValueError(f"selector {item['selector']}: the key is no {item['type']} key")
        if item['type'] == 'rsa' and (_key_bits(temp) or 0) not in DKIM_RSA_SIZES:
            raise ValueError(f"selector {item['selector']}: RSA keys of 2048, 3072 or 4096 bits only")
        path = f"{folder}/{domain}.{item['selector']}.key"
        if item['type'] == 'ed25519':
            # rspamd reads ED25519 as base64 of seed and public key.
            der = subprocess.run(['openssl', 'pkey', '-in', temp, '-outform', 'DER'], capture_output=True, check=True).stdout
            _write(path, base64.b64encode(der[-32:] + base64.b64decode(public[1])).decode() + '\n')
        else:
            shutil.copyfile(temp, path)
        _own_key(path)
        return path, public
    finally:
        os.remove(temp)


def _provision_active(domain, entry, now=None):
    """The selectors of a domain that sign now: valid now and seen in DNS by enough resolvers; until a new one is, the last one."""
    if entry.get('mode') != 'sign_here':
        return []
    now = now or datetime.datetime.now(datetime.timezone.utc)
    rotation = _rotation_state()
    resolvers = [value for value in rotation['resolvers'].values() if value]
    need = min(int(rotation.get('threshold') or 2), len(resolvers))
    valid = []
    for item in entry.get('selectors', []):
        start, end = _provision_time(item.get('valid_from')), _provision_time(item.get('valid_until'))
        if (start is None or start <= now) and (end is None or now < end):
            seen = len(_rotation_check(rotation, f"{item['selector']}._domainkey.{domain}", item.get('public', ''))[0]) if need else 0
            item['dns_visible'] = seen
            if seen >= need:
                valid.append(item['selector'])
    return valid or [name for name in entry.get('active', []) if name in {item['selector'] for item in entry.get('selectors', [])}]


def provision_refresh(state=None, write=True):
    """Sets which delivered selectors sign now; rewrites the rspamd settings when that changed. True if it changed."""
    state = state or _provision_state()
    changed = False
    for domain, entry in state['domains'].items():
        active = _provision_active(domain, entry)
        if active != entry.get('active'):
            entry['active'], changed = active, True
    if changed and write:
        _provision_write(state)
        _write_dkim_conf()
        _reload_rspamd()
    return changed


def provision_public(domain, entry):
    """What a GET shows of a domain: never a private key."""
    active = set(entry.get('active', []))
    rows = [{'selector': item['selector'], 'type': item['type'], 'public_key': item.get('public', ''), 'valid_from': item.get('valid_from'),
             'dns_visible': item.get('dns_visible', 0)} for item in entry.get('selectors', [])]
    return {'domain': domain, 'version': entry['version'], 'mode': entry['mode'], 'managed_by': entry['source'],
            'active': [row for row in rows if row['selector'] in active], 'waiting': [row for row in rows if row['selector'] not in active],
            'dns_check': entry.get('dns_check', {}), 'warnings': entry.get('warnings', [])}


def _provision_put(state, source, body):
    error = provision_check(body, source, state['sources'])
    if error:
        return error
    domain = body['domain'].strip().lower()
    old = state['domains'].get(domain)
    if old and old.get('source') != source:
        return 403, f'{domain} is managed by another source'
    if old and body['version'] < old['version']:
        return 409, f"version {body['version']} is lower than the stored {old['version']}"
    if old and body['version'] == old['version']:
        return 200, provision_public(domain, old)
    folder = f'{DKIM_PROVISIONED}/{domain}'
    selectors = []
    try:
        for item in body.get('selectors', []):
            row = {key: item.get(key) for key in ('selector', 'type', 'valid_from', 'valid_until')}
            if body['mode'] == 'sign_here':
                path, public = _provision_key_file(domain, item, folder)
                row.update(public=public[1], path=path)
            selectors.append(row)
    except (ValueError, subprocess.CalledProcessError) as err:
        return 400, str(err)
    keep = {row.get('path') for row in selectors}
    for path in glob.glob(f'{folder}/*.key'):
        if path not in keep:
            os.remove(path)
    entry = {'source': source, 'version': body['version'], 'mode': body['mode'], 'selectors': selectors,
             'dns': body.get('dns', {}) if isinstance(body.get('dns'), dict) else {}, 'updated': time.strftime('%Y-%m-%d %H:%M:%S'),
             'active': (old or {}).get('active', [])}
    entry['active'] = _provision_active(domain, entry)
    state['domains'][domain] = entry
    _provision_write(state)
    PROVISION_CHANGED.append(domain)
    _write_dkim_conf()
    _reload_rspamd()
    _event('dkim_provisioned', 'notice', source=source, domain=domain, version=body['version'], mode=body['mode'])
    return 200, provision_public(domain, entry)


def dkim_provision_apply(args):
    """For efa-dkim-api only: one call of a source, read from stdin as {method, domain, body}; answers {code, body}.
    Every call goes to the audit log, never a key."""
    result, call = _provision_apply(args)
    _audit(f"DKIM provisioning: {call.get('method', '?')} {str(call.get('domain') or '/')[:255]} by the source {args.source.strip()[:40]}: {result['code']}")
    return result


def _provision_apply(args):
    call = {}
    state = _provision_state()
    source = args.source.strip()
    if state['mode'] != 'on':
        return {'code': 403, 'body': {'error': 'the provisioning is off'}}, call
    if source not in state['sources']:
        return {'code': 401, 'body': {'error': 'unknown source'}}, call
    if 'dkim' not in (state['sources'][source].get('rights') or ['dkim']):
        return {'code': 403, 'body': {'error': 'this source has no right for dkim'}}, call
    try:
        call = json.loads(sys.stdin.read(3 * 1024 * 1024))
    except ValueError:
        return {'code': 400, 'body': {'error': 'no valid JSON'}}, call
    call = call if isinstance(call, dict) else {}
    method, domain = call.get('method'), str(call.get('domain') or '').strip().lower()
    mine = {name: entry for name, entry in state['domains'].items() if entry.get('source') == source}
    if method == 'GET' and not domain:
        return {'code': 200, 'body': {'domains': [provision_public(name, entry) for name, entry in sorted(mine.items())]}}, call
    if method == 'GET':
        return {'code': 200, 'body': provision_public(domain, mine[domain])} if domain in mine else {'code': 404, 'body': {'error': 'not delivered'}}, call
    if method == 'DELETE':
        if domain not in mine:
            return {'code': 404, 'body': {'error': 'not delivered'}}, call
        _provision_release(state, domain)
        return {'code': 200, 'body': {'domain': domain, 'managed_by': None}}, call
    if method == 'PUT':
        body = call.get('body')
        if isinstance(body, dict) and str(body.get('domain', '')).strip().lower() != domain:
            return {'code': 400, 'body': {'error': 'the domain in the body differs from the address'}}, call
        code, answer = _provision_put(state, source, body)
        return {'code': code, 'body': answer if code == 200 else {'error': answer}}, call
    if method == 'POST':
        items = (call.get('body') or {}).get('domains') if isinstance(call.get('body'), dict) else None
        if not isinstance(items, list) or len(items) > PROVISION_MAX_DOMAINS:
            return {'code': 413 if isinstance(items, list) else 400, 'body': {'error': f'domains: a list of at most {PROVISION_MAX_DOMAINS}'}}, call
        results = []
        for item in items:
            code, answer = _provision_put(_provision_state(), source, item)
            results.append({'code': code, **(answer if code == 200 else {'domain': str((item or {}).get('domain', ''))[:255], 'error': answer})})
        return {'code': 200, 'body': {'results': results}}, call
    return {'code': 405, 'body': {'error': 'GET, PUT, POST or DELETE'}}, call


def _provision_release(state, domain):
    """The domain goes back to eFa-next: its delivered keys become own imported keys, so mail stays signed."""
    entry = state['domains'].pop(domain)
    for item in entry.get('selectors', []):
        if item.get('path') and os.path.exists(item['path']) and item['selector'] in entry.get('active', []):
            os.makedirs(DKIM_IMPORTED, mode=0o750, exist_ok=True)
            os.replace(item['path'], f"{DKIM_IMPORTED}/{domain}.{item['selector']}.key")
    shutil.rmtree(f'{DKIM_PROVISIONED}/{domain}', ignore_errors=True)
    _provision_write(state)
    PROVISION_CHANGED.append(domain)
    _write_dkim_conf()
    _reload_rspamd()
    _event('dkim_provisioned', 'notice', source=entry.get('source'), domain=domain, released=True)


def dkim_provision_takeover(args):
    """A super-admin takes a domain back from its source; the keys stay and eFa-next manages them from now on."""
    _confirm(args)
    state = _provision_state()
    domain = args.domain.strip().lower()
    if domain not in state['domains']:
        raise EfaError(f'{domain} is not managed by a source.')
    source = state['domains'][domain]['source']
    _provision_release(state, domain)
    _audit(f'DKIM of {domain} taken back from the source {source} by {_dmarc_who()}')
    return {'domain': domain, 'taken_from': source}


def _provision_server_cert():
    """The own long-lived certificate of port 8463, so a pin on it stays valid (not the one of Let's Encrypt)."""
    crt, key = f'{PROVISION_DIR}/server.crt', f'{PROVISION_DIR}/server.key'
    os.makedirs(PROVISION_DIR, mode=0o750, exist_ok=True)
    if not os.path.exists(crt):
        name = own_hostname()
        subprocess.run(['openssl', 'req', '-x509', '-newkey', 'ec', '-pkeyopt', 'ec_paramgen_curve:P-256', '-nodes', '-days', '3650',
                        '-subj', f'/CN={name}', '-addext', f'subjectAltName=DNS:{name}', '-keyout', key, '-out', crt],
                       check=True, capture_output=True)
        os.chmod(key, 0o640)
    if _group_exists(PROVISION_USER):
        for path in (PROVISION_DIR, crt, key):
            shutil.chown(path, 'root', PROVISION_USER)
    return crt


def _cert_fingerprint(pem_path):
    done = subprocess.run(['openssl', 'x509', '-in', pem_path, '-noout', '-fingerprint', '-sha256'], capture_output=True, text=True)
    return done.stdout.strip().split('=', 1)[-1] if done.returncode == 0 else ''


def _provision_clients(state):
    """The certificates of all sources in one file: the server trusts exactly these."""
    pems = []
    for name in sorted(state['sources']):
        path = f'{PROVISION_DIR}/sources/{name}.crt'
        if os.path.exists(path):
            with open(path) as f:
                pems.append(f.read().strip())
    _write(f'{PROVISION_DIR}/clients.pem', '\n'.join(pems) + '\n')
    if _group_exists(PROVISION_USER):
        shutil.chown(f'{PROVISION_DIR}/clients.pem', 'root', PROVISION_USER)


def _provision_service(on):
    try:
        if on:
            _platform().service_enable(PROVISION_UNIT, start=True)
            _platform().service_restart(PROVISION_UNIT, check=False)
        else:
            _platform().service_disable(PROVISION_UNIT, stop=True)
    except Exception as err:  # the StepError of the platform layer
        raise EfaError(str(err))


def dkim_provision_status(_args):
    state = _provision_state()
    crt = f'{PROVISION_DIR}/server.crt'
    return {'mode': state['mode'], 'port': 8463, 'server_certificate_sha256': _cert_fingerprint(crt) if os.path.exists(crt) else '',
            'sources': [{'name': name, 'fingerprint': item.get('fingerprint', ''), 'domains': item.get('domains', []),
                         'addresses': item.get('addresses', []), 'rate': item.get('rate', 600)} for name, item in sorted(state['sources'].items())],
            'domains': [{'domain': name, 'source': entry['source'], 'mode': entry['mode'], 'version': entry['version'], 'active': entry.get('active', [])}
                        for name, entry in sorted(state['domains'].items())]}


def dkim_provision_set(args):
    """Switches the DKIM provisioning API on port 8463 on or off. Off keeps the delivered keys; they go on signing."""
    mode = _on_off(args.mode.strip())
    if mode and cluster_role() == 'client':
        raise EfaError('In a cluster only the master takes these calls.')
    state = _provision_state()
    state['mode'] = 'on' if mode else 'off'
    if mode:
        _provision_server_cert()
        _provision_clients(state)
        _write(FAIL2BAN_DKIM_API_FILTER, '[Definition]\nfailregex = efa-dkim-api login failed from <HOST>\njournalmatch = _SYSTEMD_UNIT=efa-dkim-api.service\n')
        if os.path.exists(FAIL2BAN_JAIL):
            with open(FAIL2BAN_JAIL) as f:
                jail = f.read()
            if '[efa-dkim-api]' not in jail:
                _write(FAIL2BAN_JAIL, jail.rstrip('\n') + '\n\n' + FAIL2BAN_DKIM_API_JAIL)
                _platform().service_try_restart('fail2ban')
    _provision_write(state)
    _provision_service(mode)
    return dkim_provision_status(None)


def dkim_source_set(args):
    """A source: its client certificate, its domains, the allowed addresses and calls per minute. A new token is shown once."""
    state = _provision_state()
    name = args.name.strip().lower()
    if not re.fullmatch(r'[a-z0-9][a-z0-9-]{0,40}', name):
        raise EfaError('Name: small letters, digits and dashes.')
    domains = sorted({item.strip().lower() for item in (args.domains or '').replace(',', ' ').split() if item.strip()})
    if not domains or any(not DOMAIN_RE.match(item) for item in domains):
        raise EfaError('Domains: one or more domains, separated by commas.')
    addresses = [item.strip() for item in (args.addresses or '').replace(',', ' ').split() if item.strip()]
    for item in addresses:
        try:
            ipaddress.ip_network(item, strict=False)
        except ValueError:
            raise EfaError(f'{item} is no address or network.')
    rate = int(args.rate or 600) if str(args.rate or '600').isdigit() else 0
    if rate not in PROVISION_RATES:
        raise EfaError('Calls per minute: 60, 120, 300, 600 or 1200.')
    source = state['sources'].get(name, {})
    if (args.cert or '').strip():
        with open(args.cert.strip()) as f:
            pem = f.read()
        # Only certificates: the path comes from the form, and a file with a key too must not be copied out of its place.
        if 'BEGIN CERTIFICATE' not in pem or 'PRIVATE KEY' in pem or len(pem) > 20000:
            raise EfaError('Certificate: a PEM file with certificates only.')
        os.makedirs(f'{PROVISION_DIR}/sources', mode=0o750, exist_ok=True)
        _write(f'{PROVISION_DIR}/sources/{name}.crt', pem)
        source['fingerprint'] = _cert_fingerprint(f'{PROVISION_DIR}/sources/{name}.crt')
        if not source['fingerprint']:
            os.remove(f'{PROVISION_DIR}/sources/{name}.crt')
            raise EfaError('Certificate: openssl cannot read it.')
    if not source.get('fingerprint'):
        raise EfaError('A new source needs its client certificate (--cert).')
    token = None
    if not source.get('token_hash') or (args.new_token or '').strip() == 'yes':
        token = secrets.token_urlsafe(32)
        source['token_hash'] = hashlib.sha256(token.encode()).hexdigest()
    rights = sorted({item.strip() for item in (getattr(args, 'rights', '') or '').replace(',', ' ').split()}) or source.get('rights') or ['dkim']
    if not set(rights) <= set(PROVISION_RIGHTS):
        raise EfaError('Rights: dkim and/or disclaimer.')
    source.update(domains=domains, addresses=addresses, rate=rate, rights=rights)
    state['sources'][name] = source
    _provision_write(state)
    _provision_clients(state)
    if state['mode'] == 'on':
        _provision_service(True)
    result = {'source': name, 'fingerprint': source['fingerprint'], 'domains': domains, 'addresses': addresses, 'rate': rate, 'rights': rights}
    if token:
        result['token'] = token
        result['note'] = 'The token is shown only now. Store it in the source.'
    return result


def dkim_source_remove(args):
    state = _provision_state()
    name = args.name.strip().lower()
    if name not in state['sources']:
        raise EfaError(f'No source {name}.')
    if any(entry.get('source') == name for entry in state['domains'].values()):
        raise EfaError(f'{name} still manages domains: take them back first (dkim-provision-takeover).')
    del state['sources'][name]
    _provision_write(state)
    if os.path.exists(f'{PROVISION_DIR}/sources/{name}.crt'):
        os.remove(f'{PROVISION_DIR}/sources/{name}.crt')
    _provision_clients(state)
    if state['mode'] == 'on':
        _provision_service(True)
    return {'removed': name}


def _dkim_conf_domains(include_hsm=False):
    domains = {}
    managed = _provision_state()['domains']
    for key in sorted(glob.glob(f'{DKIM_IMPORTED}/*.key') + glob.glob(f'{DKIM_DIR}/*.key')):
        domain, selector = os.path.basename(key)[:-4].rsplit('.', 1)
        if domain not in managed:
            domains.setdefault(domain, []).append((key, selector))
    # 5o: a domain of a source signs only with its delivered keys, or not at all (signed_downstream).
    for domain, entry in managed.items():
        rows = [(item['path'], item['selector']) for item in entry.get('selectors', [])
                if item['selector'] in entry.get('active', []) and item.get('path') and os.path.exists(item['path'])]
        if rows:
            domains[domain] = rows
    # G7-17: a domain with its key in a hardware module is signed by efa-cdr through the module, not by rspamd.
    if not include_hsm:
        for domain in _safe(dkim_hsm_domains, set()):
            domains.pop(domain, None)
    return domains


def _write_dkim_conf():
    # Rebuilt from the key files so the config cannot drift from what is on disk.
    domains = _dkim_conf_domains()
    if not domains:
        text = 'enabled = false;\n'
    else:
        lines = ['allow_username_mismatch = true;', 'use_domain = "header";',
                 '# Keys belong to the exact domain, also for subdomains.', 'use_esld = false;', 'domain {']
        for domain, selectors in sorted(domains.items()):
            items = [f'      {{ path = "{key}"; selector = "{selector}"; }}' for key, selector in selectors]
            lines += [f'  {domain} {{', '    selectors [', ',\n'.join(items), '    ]', '  }']
        lines.append('}')
        text = '\n'.join(lines) + '\n'
    with open(DKIM_CONF, 'w') as f:
        f.write(text)
    _write_arc_conf()
    _safe(_dkim_sign_keys, None)


def _rspamd_config_ok():
    done = subprocess.run(['rspamadm', 'configtest'], capture_output=True, text=True)
    return done.returncode == 0


def _dkim_keygen(domain, selector, key, kind, bits):
    extra = ['-t', 'rsa', '-b', str(bits)] if kind == 'rsa' else ['-t', 'ed25519']
    done = subprocess.run(['rspamadm', 'dkim_keygen', '-d', domain, '-s', selector, '-k', key] + extra,
                          capture_output=True, text=True, check=True)
    _own_key(key)
    os.chmod(key, 0o640)
    return done.stdout.strip()


def _dkim_make_key(domain, selector, kind, bits, folder):
    """Creates one key in folder. A failed attempt leaves no key behind."""
    if not SELECTOR_RE.match(selector):
        raise EfaError('Invalid selector.')
    if any(key['domain'] == domain and key['selector'] == selector for key in _dkim_keys()):
        raise EfaError(f'Selector {selector} already exists for {domain}, nothing changed.')
    for path in sorted({DKIM_DIR, ARC_DIR if folder.startswith(ARC_DIR) else DKIM_DIR, folder}):
        os.makedirs(path, mode=0o750, exist_ok=True)
        _own_key(path)
    key = f'{folder}/{domain}.{selector}.key'
    try:
        return _dkim_keygen(domain, selector, key, kind, bits)
    except (subprocess.CalledProcessError, OSError) as err:
        if os.path.exists(key):
            os.remove(key)
        raise EfaError(f'Key generation failed, no key was kept: {err}')


def _dkim_rsa_bits(value):
    try:
        bits = int(value)
    except ValueError:
        raise EfaError('RSA key size must be a number.')
    if bits not in DKIM_RSA_SIZES:
        raise EfaError(f'RSA keys must have one of these sizes: {", ".join(map(str, DKIM_RSA_SIZES))} bits.')
    return bits


def _dkim_domain(value):
    domain = value.strip().lower()
    if not DOMAIN_RE.match(domain):
        raise EfaError('Invalid domain.')
    return domain


def _dkim_create(domain, kind, bits, selector):
    if any(key['domain'] == domain and key['state'] == 'active' and key['purpose'] == 'dkim' and key['public']
           and key['public'][0] == kind for key in _dkim_keys()):
        raise EfaError(f'{domain} already has an active {kind} key, nothing changed.')
    record = _dkim_make_key(domain, selector, kind, bits, DKIM_DIR)
    _write_dkim_conf()
    _reload_rspamd()
    return {'domain': domain, 'type': kind, 'selector': selector, 'dns_record': record}


def dkim_generate(args):
    """Create an RSA key for a domain."""
    domain, bits = _dkim_domain(args.domain), _dkim_rsa_bits(args.bits)
    return _dkim_create(domain, 'rsa', bits, (args.selector or '').strip() or RSA_SELECTOR)


def dkim_generate_ed25519(args):
    """Create an ED25519 key for a domain."""
    domain = _dkim_domain(args.domain)
    return _dkim_create(domain, 'ed25519', None, (args.selector or '').strip() or ED_SELECTOR)


DKIM_KINDS = {'both': ['rsa', 'ed25519'], 'rsa': ['rsa'], 'ed25519': ['ed25519']}


def dkim_create(args):
    """RSA, Ed25519 or both for one domain in one step. With both, a kind the domain already has an active key of stays."""
    domain, kind = _dkim_domain(args.domain), (args.kind or 'both').strip().lower()
    if kind not in DKIM_KINDS:
        raise EfaError('Key type: both, rsa or ed25519.')
    bits = _dkim_rsa_bits(args.bits) if kind != 'ed25519' else None
    have = {key['public'][0] for key in _dkim_keys() if key['domain'] == domain and key['state'] == 'active'
            and key['purpose'] == 'dkim' and key['public']}
    todo = [item for item in DKIM_KINDS[kind] if kind != 'both' or item not in have]
    if not todo:
        raise EfaError(f'{domain} already has an active RSA and Ed25519 key, nothing changed.')
    selectors = {'rsa': (args.selector or '').strip() or RSA_SELECTOR, 'ed25519': (args.ed_selector or '').strip() or ED_SELECTOR}
    made = [_dkim_create(domain, item, bits if item == 'rsa' else None, selectors[item]) for item in todo]
    note = ('RSA below 3000 bits is under BSI TR-02102-1; 2048 is still the common size for DNS. 3072 makes a longer TXT record.'
            if 'rsa' in todo and bits < 3000 else '')
    return {'domain': domain, 'keys': made, 'kept': [item for item in DKIM_KINDS[kind] if item not in todo], 'note': note}


def dkim_remove(args):
    """Remove one key. Mail stops being signed with it at once, its DNS record is no longer needed after that."""
    domain, selector = _dkim_domain(args.domain), args.selector.strip()
    _confirm(args)
    found = [key for key in _dkim_keys() if key['domain'] == domain and key['selector'] == selector]
    if not found:
        raise EfaError(f'No key {selector} for {domain}.')
    os.remove(found[0]['path'])
    state = _rotation_state()
    state['retired'].pop(f'{domain} {selector}', None)
    _json_write(ROTATION_FILE, state)
    _write_dkim_conf()
    _reload_rspamd()
    return {'removed': selector, 'domain': domain}


def _key_bits(path):
    done = subprocess.run(['openssl', 'pkey', '-in', path, '-noout', '-text'], capture_output=True, text=True)
    match = re.search(r'Private-Key: \((\d+) bit', done.stdout)
    return int(match.group(1)) if match else None


def dkim_import(args):
    """Take over an existing key with its selector, so a domain is signed once, here, and not twice. From a file on this host
    (the migration) or, in the web and the API, as the PEM file in base64 through the secret input. dkim-check warns about weak keys."""
    domain, selector = args.domain.strip().lower(), args.selector.strip()
    if not DOMAIN_RE.match(domain):
        raise EfaError('Invalid domain.')
    if not SELECTOR_RE.match(selector):
        raise EfaError('Invalid selector.')
    if not (getattr(args, 'key_file', '') or '').strip():
        try:
            pem = base64.b64decode(_secrets(1, 'Private key: the PEM file in base64')[0].strip(), validate=True)
        except (ValueError, IndexError):
            raise EfaError('Key: the PEM file in base64, on one line.')
        if not 100 < len(pem) < 20000 or b'PRIVATE KEY-----' not in pem:
            raise EfaError('Key: a private key in PEM format.')
        fd, temp = tempfile.mkstemp(prefix='efa-dkim-')
        with os.fdopen(fd, 'wb') as f:
            f.write(pem)
        try:
            return dkim_import(argparse.Namespace(domain=domain, selector=selector, key_file=temp))
        finally:
            os.remove(temp)
    if _key_bits(args.key_file) is None:
        raise EfaError(f'{args.key_file} is no readable key.')
    os.makedirs(DKIM_IMPORTED, mode=0o750, exist_ok=True)
    shutil.chown(DKIM_DIR, 'root', _rspamd_user())
    shutil.chown(DKIM_IMPORTED, 'root', _rspamd_user())
    key = f'{DKIM_IMPORTED}/{domain}.{selector}.key'
    shutil.copyfile(args.key_file, key)
    shutil.chown(key, 'root', _rspamd_user())
    os.chmod(key, 0o640)
    _write_dkim_conf()
    _reload_rspamd()
    return {'imported': key}


def _dkim_public(path):
    # One page asks for each key many times, and every openssl call costs a process.
    if path not in _dkim_public_cache:
        _dkim_public_cache[path] = _dkim_public_read(path)
    return _dkim_public_cache[path]


_dkim_public_cache = {}


def _dkim_public_read(path):
    """Type and public DNS value of a key file, or None. The private key never leaves this function."""
    done = subprocess.run(['openssl', 'pkey', '-in', path, '-pubout', '-outform', 'DER'], capture_output=True)
    if done.returncode == 0:
        # 44 bytes are the ED25519 header and key, DKIM wants only the key.
        if len(done.stdout) == 44:
            return 'ed25519', base64.b64encode(done.stdout[-32:]).decode()
        return 'rsa', base64.b64encode(done.stdout).decode()
    # rspamd stores ED25519 as base64 of 64 bytes, with the public key in the last 32.
    try:
        with open(path) as f:
            raw = base64.b64decode(f.read().strip(), validate=True)
    except (OSError, ValueError):
        return None
    return ('ed25519', base64.b64encode(raw[-32:]).decode()) if len(raw) == 64 else None


def _dkim_keys():
    keys = []
    for state, purpose, folder in (('active', 'dkim', DKIM_DIR), ('active', 'dkim', DKIM_IMPORTED),
                                   ('pending', 'dkim', DKIM_PENDING), ('retired', 'dkim', DKIM_RETIRED),
                                   ('active', 'arc', ARC_DIR), ('pending', 'arc', ARC_PENDING),
                                   ('retired', 'arc', ARC_RETIRED)):
        for path in sorted(glob.glob(f'{folder}/*.key')):
            domain, selector = os.path.basename(path)[:-4].rsplit('.', 1)
            keys.append({'domain': domain, 'selector': selector, 'state': state, 'purpose': purpose, 'path': path,
                         'public': _dkim_public(path)})
    return keys


def _dkim_value(key):
    return f'v=DKIM1; k={key["public"][0]}; p={key["public"][1]}'


def _retired_expired(state, domain, selector):
    since = state['retired'].get(f'{domain} {selector}')
    return bool(since) and datetime.date.fromisoformat(since) + datetime.timedelta(days=ROTATION_GRACE_DAYS) < _today()


def _dkim_zone_lines(record):
    # A TXT string holds at most 255 characters, longer values are split into several strings.
    value = record['value']
    parts = [f'"{value[i:i + 255]}"' for i in range(0, len(value), 255)]
    return [f'{record["name"]}. IN TXT ( {parts[0]}'] + [f'\t{part}' for part in parts[1:]] + ['\t)']


def dkim_export(args):
    """Public DNS records, of one domain or all. Never contains private keys."""
    domain, fmt = (args.domain or '').strip().lower(), (args.format or 'zone').strip()
    if domain and not DOMAIN_RE.match(domain):
        raise EfaError('Invalid domain.')
    if fmt not in ('zone', 'csv'):
        raise EfaError("Format must be 'zone' or 'csv'.")
    state = _rotation_state()
    keys = [key for key in _dkim_keys() if not domain or key['domain'] == domain]
    dmarc = {name: item for name, item in _json_read(DMARC_RECORDS, {}).items()
             if item.get('current') and (not domain or name == domain)}
    if domain and not keys and not dmarc:
        raise EfaError(f'No DNS records known for {domain}.')
    records, unreadable = [], []
    for key in keys:
        if key['public'] is None:
            unreadable.append(f'{key["domain"]} {key["selector"]}')
        elif not (key['state'] == 'retired' and _retired_expired(state, key['domain'], key['selector'])):
            records.append({'domain': key['domain'], 'selector': key['selector'], 'type': key['public'][0],
                            'name': f'{key["selector"]}._domainkey.{key["domain"]}', 'value': _dkim_value(key),
                            'state': key['state'], 'purpose': key['purpose']})
    for name, item in sorted(dmarc.items()):
        current = item['current']
        records.append({'domain': name, 'selector': '', 'type': 'dmarc', 'name': f'_dmarc.{name}',
                        'value': current['record'], 'state': 'active', 'purpose': 'dmarc'})
        for host in current['external']:
            records.append({'domain': name, 'selector': '', 'type': 'dmarc-report-authorization',
                            'name': f'{name}._report._dmarc.{host}', 'value': 'v=DMARC1', 'state': 'active',
                            'purpose': 'dmarc'})
    if fmt == 'csv':
        out = io.StringIO(newline='')
        writer = csv.DictWriter(out, ('domain', 'selector', 'type', 'name', 'value', 'state', 'purpose'),
                                lineterminator='\n')
        writer.writeheader()
        writer.writerows(records)
        text = out.getvalue()
    else:
        lines = ['; DNS records from eFa-next.',
                 '; SPF is left out: eFa-next does not know all mail servers that send for your domain.']
        without = sorted({key['domain'] for key in keys} - set(dmarc))
        if without:
            lines.append(f'; DMARC is left out, no record saved in eFa-next for: {", ".join(without)}')
        lines += [f'; No record, key cannot be read: {item}' for item in unreadable]
        for record in records:
            if record['purpose'] == 'arc':
                lines.append('; ARC key')
            if record['state'] == 'pending':
                lines.append('; Key for a future rotation: publish now, it does not sign yet.')
            elif record['state'] == 'retired':
                lines.append('; Key after a rotation: keep this record until the grace period has passed.')
            lines += _dkim_zone_lines(record)
        text = '\n'.join(lines) + '\n'
    return {'format': fmt, 'text': text, 'records': records, 'unreadable': unreadable}


def dkim_check(_args):
    """List DKIM keys. Existing keys below the rules only warn, signing keeps working."""
    warnings, notes, keys = [], [], []
    types = {}
    for key in _dkim_keys():
        if key['purpose'] != 'dkim':
            continue
        if key['public'] is None:
            warnings.append(_text('{path} cannot be read.', path=key['path']))
            keys.append({'domain': key['domain'], 'selector': key['selector'], 'type': 'unreadable',
                         'state': key['state'], 'bits': None, 'dns': ''})
            continue
        kind = key['public'][0]
        bits = _key_bits(key['path']) if kind == 'rsa' else None
        keys.append({'domain': key['domain'], 'selector': key['selector'], 'type': kind, 'state': key['state'],
                     'bits': bits, 'dns': _dkim_value(key), 'imported': key['path'].startswith(DKIM_IMPORTED)})
        if key['state'] == 'active':
            types.setdefault(key['domain'], set()).add(kind)
            if bits is not None and bits < DKIM_MIN_BITS:
                warnings.append(_text('{domain}: key {selector} has only {bits} bits, generate a new key.', domain=key['domain'], selector=key['selector'], bits=bits))
    notes += [f'{domain}: signs with {kinds.copy().pop()} only.' for domain, kinds in sorted(types.items())
              if len(kinds) == 1]
    old = glob.glob(f'{OPENDKIM_KEYS}/*.private') + glob.glob(f'{OPENDKIM_KEYS}/*/*.private')
    for key in sorted(old):
        bits = _key_bits(key)
        warnings.append(_text('{key}: opendkim key ({bits} bits), generate new keys.', key=key, bits=bits))
    domains = {key['domain'] for key in keys} | set(_json_read(DMARC_RECORDS, {}))
    return {'keys': keys, 'warnings': warnings, 'notes': notes, 'export_domains': sorted(domains)}


def _add_months(day, months):
    index = day.month - 1 + months
    year, month = day.year + index // 12, index % 12 + 1
    following = datetime.date(year + month // 12, month % 12 + 1, 1)
    return min(day.replace(year=year, month=month, day=1) + datetime.timedelta(days=day.day - 1),
               following - datetime.timedelta(days=1))


def _rotation_state():
    state = _json_read(ROTATION_FILE, {})
    state.setdefault('resolvers', {'ipv4_1': '', 'ipv4_2': '', 'ipv6_1': '', 'ipv6_2': ''})
    state.setdefault('all', {'enabled': False, 'interval': 6, 'horizon': ROTATION_MAX_MONTHS, 'bits': DKIM_MIN_BITS})
    state.setdefault('domains', {})
    state.setdefault('retired', {})
    state.setdefault('threshold', ROTATION_THRESHOLD)
    state.setdefault('mailed', {})
    state.setdefault('warnings', [])
    state.setdefault('last_run', None)
    return state


def _rotation_settings(state, domain, kind):
    override = state['domains'].get(domain, {}).get(kind)
    settings = {**state['all'], 'source': 'default', 'next': None}
    if override:
        settings.update(override, source='override')
    if kind == 'arc':
        arc = _arc_settings(_arc_state(), domain)
        settings['bits'] = arc['bits'] if arc else settings['bits']
    return settings


def _rotation_targets(state):
    targets = {(domain, kind) for domain, kinds in state['domains'].items() for kind in kinds}
    for key in _dkim_keys():
        if key['state'] == 'active' and key['public'] and key['purpose'] == 'dkim':
            targets.add((key['domain'], key['public'][0]))
    arc_state = _arc_state()
    for domain in _arc_domains(arc_state):
        arc = _arc_settings(arc_state, domain)
        if arc and arc['enabled'] and arc['key'] == 'own':
            targets.add((domain, 'arc'))
    return sorted(targets)


def _rotation_pending(domain, kind):
    found = []
    for key in _dkim_keys():
        match = re.search(r'-(\d{8})$', key['selector'])
        if (key['state'] == 'pending' and key['domain'] == domain and match and key['public']
                and (key['purpose'] == 'arc' if kind == 'arc' else key['purpose'] == 'dkim' and key['public'][0] == kind)):
            found.append((datetime.datetime.strptime(match.group(1), '%Y%m%d').date(), key))
    return sorted(found, key=lambda item: item[0])


def _rotation_log(text):
    os.makedirs(os.path.dirname(ROTATION_LOG), exist_ok=True)
    with open(ROTATION_LOG, 'a') as f:
        f.write(f'{time.strftime("%Y-%m-%d %H:%M:%S")} {text}\n')


def _rotation_pregenerate(state, domain, kind):
    """Creates the missing keys up to the horizon. They do not sign until a rotation activates them."""
    settings = _rotation_settings(state, domain, kind)
    if not settings['enabled']:
        return []
    today, created = _today(), []
    pending = _rotation_pending(domain, kind)
    if pending:
        day = _add_months(pending[-1][0], settings['interval'])
    elif settings['next'] and datetime.date.fromisoformat(settings['next']) > today:
        day = datetime.date.fromisoformat(settings['next'])
    else:
        day = _add_months(today, settings['interval'])
    end = _add_months(today, settings['horizon'])
    folder = ARC_PENDING if kind == 'arc' else DKIM_PENDING
    while day <= end:
        selector = f'efa-{kind}-{day:%Y%m%d}'
        _dkim_make_key(domain, selector, 'rsa' if kind == 'arc' else kind, settings['bits'], folder)
        _rotation_log(f'{domain} {kind}: pre-generated {selector} for {day}')
        created.append(selector)
        day = _add_months(day, settings['interval'])
    return created


def _dns_txt(resolver, name):
    try:
        done = subprocess.run(['dig', '+time=5', '+tries=2', '+short', 'TXT', name, f'@{resolver}'],
                              capture_output=True, text=True, timeout=30)
    except subprocess.TimeoutExpired:
        return None
    return done.stdout.splitlines() if done.returncode == 0 else None


def _dns_shows_key(lines, public):
    for line in lines or []:
        match = re.search(r'(?:^|;)\s*p=([^;\s]+)', ''.join(re.findall(r'"([^"]*)"', line)))
        if match and match.group(1) == public:
            return True
    return False


def _rotation_check(state, name, public):
    """Which configured resolvers show the record, show another value, or show nothing."""
    matched, different, missing = [], [], []
    for resolver in [value for value in state['resolvers'].values() if value]:
        lines = _dns_txt(resolver, name)
        if _dns_shows_key(lines, public):
            matched.append(resolver)
        elif lines:
            different.append(resolver)
        else:
            missing.append(resolver)
    return matched, different, missing


def _rotation_activate(state, domain, kind, new):
    moved = []
    active_dir, retired_dir = (ARC_DIR, ARC_RETIRED) if kind == 'arc' else (DKIM_DIR, DKIM_RETIRED)
    os.makedirs(retired_dir, mode=0o750, exist_ok=True)
    _own_key(retired_dir)
    for key in _dkim_keys():
        if (key['domain'] == domain and key['state'] == 'active' and key['public']
                and (key['purpose'] == 'arc' if kind == 'arc' else key['purpose'] == 'dkim' and key['public'][0] == kind)):
            target = f'{retired_dir}/{os.path.basename(key["path"])}'
            os.replace(key['path'], target)
            moved.append((key['path'], target, key['selector']))
    active = f'{active_dir}/{domain}.{new["selector"]}.key'
    os.replace(new['path'], active)
    _write_dkim_conf()
    if not _rspamd_config_ok():
        os.replace(active, new['path'])
        for path, target, _selector in moved:
            os.replace(target, path)
        _write_dkim_conf()
        return False
    _reload_rspamd()
    for _path, _target, selector in moved:
        state['retired'][f'{domain} {selector}'] = _today().isoformat()
    return True


def _admin_notify(subject, text):
    address = _admin_email()
    if not address:
        return
    message = f'To: {address}\nSubject: {subject}\n\n{text}\n'
    subprocess.run(['sendmail', '-t'], input=message, text=True, capture_output=True, check=False)


def rotation_run(args):
    """Job every 2 hours: top up keys, and rotate a key from its date on once enough resolvers show its record."""
    if cluster_role() == 'client':
        return {'skipped': 'a client of a cluster: the master rotates the keys and hands them on'}
    if os.path.exists(PROVISION_FILE):
        provision_refresh()
    state = _rotation_state()
    today, warnings, rotated, created, to_mail = _today(), [], [], [], []
    notify = (args.notify or 'yes').strip() != 'no'
    _write_arc_conf()
    for domain, kind in _rotation_targets(state):
        if not _rotation_settings(state, domain, kind)['enabled']:
            continue
        created += _rotation_pregenerate(state, domain, kind)
        pending = _rotation_pending(domain, kind)
        if not pending or pending[0][0] > today:
            continue
        day, key = pending[0]
        name = f'{key["selector"]}._domainkey.{domain}'
        matched, different, missing = _rotation_check(state, name, key['public'][1])
        if different:
            text = f'{domain} {kind}: key {key["selector"]} has a different record on: {", ".join(different)}'
            warnings.append(text)
            _rotation_log(f'warning: {text}')
        if len(matched) < state['threshold']:
            text = (f'{domain} {kind}: key {key["selector"]} is due since {day}, found on {len(matched)} of '
                    f'{state["threshold"]} needed DNS servers. Not visible on: {", ".join(different + missing) or "none configured"}')
            warnings.append(text)
            _rotation_log(f'check failed, not rotated: {text}')
            if notify and state['mailed'].get(key['selector'] + ' ' + domain) != today.isoformat():
                state['mailed'][key['selector'] + ' ' + domain] = today.isoformat()
                to_mail.append(text)
        elif _rotation_activate(state, domain, kind, key):
            rotated.append(f'{domain} {kind} {key["selector"]}')
            state['mailed'].pop(key['selector'] + ' ' + domain, None)
            _rotation_log(f'{domain} {kind}: rotated to {key["selector"]}, found on: {", ".join(matched)}')
        else:
            text = f'{domain} {kind}: rspamd rejected the config with key {key["selector"]}, not rotated.'
            warnings.append(text)
            _rotation_log(text)
    state['warnings'] = warnings
    state['last_run'] = time.strftime('%Y-%m-%d %H:%M:%S')
    _json_write(ROTATION_FILE, state)
    # The warning stays current on every run, the mail goes out once a day per key.
    if to_mail:
        _admin_notify('eFa-next: DKIM key rotation waits for DNS', '\n'.join(to_mail))
    return {'rotated': rotated, 'pre_generated': created, 'warnings': warnings}


def _rotation_due_removal(state):
    return [{'domain': item.split()[0], 'selector': item.split()[1], 'retired_on': since,
             'record': f'{item.split()[1]}._domainkey.{item.split()[0]}'}
            for item, since in sorted(state['retired'].items()) if _retired_expired(state, *item.split())]


def _rotation_next_check():
    done = subprocess.run(['systemctl', 'show', 'efa-dkim-rotation.timer', '-p', 'NextElapseUSecRealtime', '--value'],
                          capture_output=True, text=True)
    return done.stdout.strip() or None


def _rotation_notices():
    """Warnings of the DKIM key rotation, for the dashboard and efactl status."""
    state = _rotation_state()
    return state['warnings'] + [_text('{record}: the rotation is {days} days past, remove this DNS record.', record=item['record'], days=ROTATION_GRACE_DAYS)
                                for item in _rotation_due_removal(state)]


# The comment efa-migrate puts on the OK lines of sender_access (they bypassed every filter of eFa 5).
MIGRATED_ALLOW_MARK = 'migrated from sender_access: OK'


def migrated_allow_review(meta, entries):
    """The allowed senders from the migration still marked for checking: a new comment (an edit) takes them off."""
    return [entry for entry in entries if str(meta.get(entry, {}).get('comment', '')).startswith(MIGRATED_ALLOW_MARK)]


def _notice_at(slug, anchor, texts, **query):
    """UI-LINK: notices with the page and the card that holds their setting; query fills in a field of that card (domain)."""
    return [[text, slug, anchor, query] if query else [text, slug, anchor] for text in texts]


def _system_notices():
    """The notices of the dashboard, each [text, page, card(, query)]: the card is the one that holds the setting."""
    found = []
    # A host of a cluster without its own break-glass admin (a cluster of before 6.0.0.6.7): red, with the way to make it.
    if os.path.exists(os.path.join(ETC, 'eFa', 'cluster', 'cluster.json')) and not _safe(lambda: _breakglass().read_state().get('user'), None):
        found += _notice_at('sec', 'breakglass-issue', [_text('Break-glass admin missing: this host of a cluster has no way in of its own when the '
                                                              'logins of the master fail. Make it now (the PDF with its codes).')])
    # The break-glass admin: every try of the last day, never hidden for good (Hans 2026-11-18).
    alarms = _safe(lambda: _json_read(BREAKGLASS_ALARMS, []), [])
    recent = [item for item in (alarms if isinstance(alarms, list) else []) if isinstance(item, dict) and time.time() - item.get('at', 0) < 86400]
    if recent:
        found += _notice_at('sec', 'breakglass-status', [_text('Break-glass admin: {count} tries in the last 24 hours, the last: {text}',
                                                               count=len(recent), text=str(recent[-1].get('text', ''))[:200])])
    # Hans 2026-11-19: the SSH profile of BSI TR-02102-4 / CIS is not set by the setup (it needs a new SSH login within 10
    # minutes): a notice with the way there until it is set, or hidden. Root login off stays a choice of its own.
    if not os.path.exists(SSH_BSI_FILE) and _safe(lambda: setup_variant_state().get('set'), None):
        found += _notice_at('standards', 'standards-set', [_text('SSH still uses the settings of the operating system: the hardening wizard sets the SSH '
                                                                   'profile of BSI TR-02102-4 and CIS (keep a second SSH session open, then log in again '
                                                                   'within 10 minutes to confirm it). Root login off is a choice of its own (Security, '
                                                                   'Admin access).')])
    return found + _system_notices_rest()


def _system_notices_rest():
    update = _update_state()
    values = {'version': update.get('latest'), 'published': update.get('published')}
    if update.get('security'):
        found = [_text('eFa-next security update {version} is available, published {published}.', **values) if values['published'] else
                 _text('eFa-next security update {version} is available.', **values)]
    else:
        found = [_text('eFa-next update {version} is available, published {published}.', **values) if values['published'] else
                 _text('eFa-next update {version} is available.', **values)]
    found = _notice_at('maint', 'update-system', found if _update_available(update) else [])
    held = _json_read(UPDATE_PENDING_FILE, {}).get('held') or []
    if held:
        found += _notice_at('maint', 'update-system', [_text('Held back at the last system update, dnf cannot resolve their dependencies now (the next '
                                                            'update tries again): {names}.', names=held_text(held))])
    senders = migrated_allow_review(_json_read(SENDER_META, {}), _read_lines(SENDER_MAPS['allow']))
    if senders:
        found += _notice_at('senders', 'sender-list', [_text('{count} allowed senders from the migration let mail past every filter in eFa 5, for an envelope sender anyone can '
                           'fake (Sender lists): {names}. Keep only senders you need, as exact addresses; change or remove the others, then '
                           'they leave this list.', count=len(senders), names=', '.join(senders[:5]) + (' ...' if len(senders) > 5 else ''))])
    review = [rule['name'] for rule in _rules() if rule.get('review')]
    if review:
        found += _notice_at('rules', 'rule-set', [_text('{count} rules from the migration weaken the filter and need checking (Rules page): {names}. Change or remove them, '
                           'then they leave this list.', count=len(review), names=', '.join(review[:5]) + (' ...' if len(review) > 5 else ''))])
    if os.path.exists(SUBMISSION_EFA5_AUTH) and _submission_auth() == 'no':
        found += _notice_at('flow', 'submitter-list', [_text('Port 587 offers no SMTP AUTH since the migration: eFa 5 had it on through Dovecot, eFa-next did not '
                           'take it over. Add submitters with a login (Mail routing, Submitters) or switch on the system accounts, if '
                           'programs log in on 587.')])
    rpmnew = _json_read(OS_CHECK_FILE, {}).get('rpmnew', [])
    if rpmnew:
        found += _notice_at('maint', 'os-check-status', [_text('A package update left new versions beside changed files: {files}. Compare and merge them, then remove the '
                           '.rpmnew/.rpmsave file.', files=', '.join(rpmnew[:5]) + (' ...' if len(rpmnew) > 5 else ''))])
    system = _system_state()
    if system['state'] == 'failed':
        found += _notice_at('maint', 'update-system', [_text('Last system update ({date}) failed: {result}', date=system.get('finished') or '?', result=system['result'])])
    setup_failed = setup_failed_state()
    if setup_failed:
        found += _notice_at('maint', 'update-status', [_text('The setup of the eFa-next package ({mode}, {at}) did not finish these steps: {steps}. '
                                                             'The output is in {log}; install the package again (dnf reinstall eFa-next) '
                                                             'once the cause is fixed.', mode=setup_failed['mode'], at=setup_failed['at'],
                                                             steps=setup_failed['steps'][:400], log=SETUP_LOG)])
    if el9_support_state() == 'warn':
        found += _notice_at('maint', 'release-upgrade', [_text('eFa-next on EL9: full support and security updates until {until}, then only the migration to eFa-next 6.x on '
                                                               'version 10. The operating system itself (AlmaLinux, Rocky Linux, RHEL 9): security updates until {os_until}. '
                                                               'Please plan the release upgrade (Maintenance & update, Release upgrade).',
                                                               until=EL9_SUPPORT_UNTIL.isoformat(), os_until=EL9_OS_SECURITY_UNTIL.isoformat())])
    for device in new_interfaces():
        found += _notice_at('net', 'interface-set', [_text('New interface {device} found, not set up: it stays unused until it has a role (Network, More interfaces).', device=device)])
    if os.path.exists(RSPAMD_SSO_UPGRADED) and time.time() - os.stat(RSPAMD_SSO_UPGRADED).st_mtime < 7 * 86400:
        found += _notice_at('sec', 'rspamd-sso-set', [_text('rspamd web interface: full access is no longer offered. After the update it was open read only for one hour; '
                           'changes go through eFa-next (Spam filter, Rules, Symbol scores).')])
    if os.path.exists(os.path.join(ETC, 'eFa', 'cluster')):
        cluster_state = _lib('efa_cluster').read_state(ETC)
        if cluster_state.get('master_down_since'):
            found += _notice_at('cluster', 'cluster-promote', [_text('Cluster master {name} not reachable since {since}. Mail filtering goes on with the last settings. If it is gone for '
                               'good: efactl cluster-promote on one node.', name=cluster_state.get('master', {}).get('name', ''),
                               since=time.strftime('%Y-%m-%d %H:%M', time.localtime(cluster_state['master_down_since'])))])
            # P7-8: what that means for the send limits of efa-outbound, while they are on.
            if _json_read(OUTBOUND_FILE, {}).get('limits', {}).get('action', 'off') != 'off':
                found += _notice_at('cluster', 'cluster-promote', [_text('Meanwhile each node holds the send limits at 1/{nodes} of the setting, as it no longer sees what the others send.',
                                    nodes=len(cluster_state.get('nodes', {})) + 1 if cluster_state.get('nodes') else _safe(
                                        lambda: int(_lib('efa_redis').call([('GET', 'efa:cluster:size')])[0] or 2), 2))])
    sandbox_failed = sorted(name for name, state in _json_read(HARDEN_FILE, {}).get('services', {}).items() if state.startswith(('failed', 'error')))
    if sandbox_failed:
        found += _notice_at('sec', 'service-harden-status', [_text('The systemd sandbox did not work for {names}: they run without it (Hardening report, Sandbox of the services).',
                           names=', '.join(sandbox_failed))])
    if _json_read(HARDEN_FILE, {}).get('mode', 'off') == 'off':
        # D-1: an upgraded host keeps its choice; new installs and migrations have the sandbox on. One choice on the card turns it on.
        found += _notice_at('sec', 'service-harden', [_text('The mail services run without the systemd sandbox. New installs have it on: choose default '
                                                            '(Hardening report, Sandbox of the services).')])
    siem = _json_read(SIEM_FILE, {})
    if siem.get('siem') and siem.get('protocol') in ('tcp', 'udp'):
        found += _notice_at('export', 'siem-set', [_text('SIEM export stopped: it sent the logs unencrypted ({protocol}). Switch it to TLS: siem-set --protocol tls --port 6514 '
                           '(the SIEM must take syslog over TLS).', protocol=siem['protocol'])])
    otlp = _json_read(OTLP_FILE, {})
    if otlp.get('enabled') and str(otlp.get('endpoint', '')).startswith('http://'):
        found += _notice_at('export', 'otlp-set', [_text('OpenTelemetry export to an http:// address: nothing is sent until it is an https:// address (otlp-set).')])
    found += _notice_at('dkim', 'tls-report-show', _tls_report_notices())
    found += _notice_at('standards', 'standards-show', _safe(standards_notices, []))
    found += _notice_at('net', 'letsencrypt-takeover', _safe(letsencrypt_takeover_notices, []))
    if eu_state()['global'] is None:
        found += _notice_at('domset', 'eu-relation-set', [_text('Answer the EU question: do the domains belong to persons or companies in the EU, or does this server run in the EU? '
                           '(Domain settings, EU relation). Until then eFa-next treats them as EU.')])
    found += _notice_at('sec', 'cve-watch-status', _safe(cve_notices, []))
    found += _notice_at('sec', 'setup-variant-status', _safe(_setup_notices, []))
    found += _notice_at('sec', 'floor-status', _safe(floor_notices, []))
    if setup_guided() and not (_safe(lambda: _totp_row('@admin'), None) or {}).get('active'):
        found += _notice_at('account', 'totp-setup', [_text('Set up 2FA for the main admin (login admin).')])
    found += _notice_at('net', 'mta-sts-set', _safe(mta_sts_notices, []))
    found += _notice_at('domset', 'domain-check-status', _safe(domain_check_notices, []))
    found += _notice_at('domset', 'role-set', _safe(role_notices, []))
    found += _notice_at('spam', 'lookalike-status', _safe(lookalike_notices, []))
    found += _notice_at('spam', 'pyzor-status', _safe(pyzor_notices, []))
    found += _notice_at('quar', 'emergency-set', _safe(emergency_notices, []))
    found += _notice_at('dkim', 'dkim-hsm-fallback', _safe(dkim_hsm_notices, []))
    found += _notice_at('net', 'uplink-failover-set', _safe(uplink_notices, []))
    found += _notice_at('cluster', 'offline-status', _safe(offline_notices, []))
    found += _notice_at('spam', 'clam-source-status', _safe(sync_notices, []))
    found += _notice_at('spam', 'clam-source-status', _safe(si_id_notices, []))
    found += _notice_at('disclaimer', 'crypto-status', _safe(crypto_notices, []))
    found += _notice_at('bak', 'backup-key-show', _safe(cluster_keys_notices, []))
    found += _notice_at('net', 'hostname-set', _safe(hosts_notices, []))
    found += _notice_at('dkim', 'dmarc-record-set', eu_findings())
    unconfirmed = _safe(lambda: application_unconfirmed(application_state()), [])
    if unconfirmed:
        found += _notice_at('domset', 'application-set', [_text('Job applications are allowed to every address of {domains}: confirm it or name the allowed addresses (Domain settings, '
                           'Job applications).', domains=', '.join(unconfirmed[:5]) + (' ...' if len(unconfirmed) > 5 else ''))], domain=unconfirmed[0])
    for key, target in sorted(_json_read(BACKUP_TARGETS, {}).items()):
        if target.get('locked'):
            found += _notice_at('bak', 'backup-target-set', [_text('Backup target {name} is locked: {reason}. Choose a provider in the EU (Backup & restore).', name=key, reason=target['locked'])])
    if _harvest_settings()['mode'] == 'on':
        banned = _harvest_banned()
        if banned:
            found += _notice_at('sec', 'harvest-status', [_text('Address harvesting: {count} addresses banned now (harvest-status).', count=len(banned)) if len(banned) > 1 else
                         _text('Address harvesting: {count} address banned now (harvest-status).', count=len(banned))])
    return found


def rotation_status(_args):
    """Rotation settings per domain and key type, next dates and open warnings."""
    state = _rotation_state()
    rows = []
    for domain, kind in _rotation_targets(state):
        settings = _rotation_settings(state, domain, kind)
        pending = _rotation_pending(domain, kind)
        rows.append({'domain': domain, 'type': kind, 'settings_from': settings['source'], 'auto_rotate': settings['enabled'],
                     'interval_months': settings['interval'], 'months_ahead': settings['horizon'],
                     'next_rotation': pending[0][0].isoformat() if pending else None,
                     'next_selector': pending[0][1]['selector'] if pending else None, 'keys_ready': len(pending)})
    return {'threshold': str(state['threshold']), 'next_check': _rotation_next_check(),
            'rotation_all': state['all']['enabled'], 'rotation_interval': str(state['all']['interval']),
            'rotation_horizon': str(state['all']['horizon']), 'rotation_bits': str(state['all']['bits']),
            **state['resolvers'], 'domains': rows, 'rotation_warnings': state['warnings'],
            'remove_from_dns': _rotation_due_removal(state), 'last_run': state['last_run']}


def _rotation_numbers(interval, horizon, bits):
    try:
        interval, horizon, bits = int(interval), int(horizon), int(bits)
    except ValueError:
        raise EfaError('Interval, months ahead and key size must be numbers.')
    if interval not in ROTATION_INTERVALS:
        raise EfaError(f'Interval must be one of {", ".join(map(str, ROTATION_INTERVALS))} months.')
    if not interval <= horizon <= ROTATION_MAX_MONTHS:
        raise EfaError(f'Months ahead must be from the interval up to {ROTATION_MAX_MONTHS}.')
    if bits not in DKIM_RSA_SIZES:
        raise EfaError('Invalid RSA key size.')
    return interval, horizon, bits


def rotation_all_set(args):
    """Default for every domain and key type, also for domains added later. Off keeps all pre-generated keys."""
    enabled = _on_off(args.mode)
    interval, horizon, bits = _rotation_numbers(args.interval, args.horizon, args.bits)
    state = _rotation_state()
    state['all'] = {'enabled': enabled, 'interval': interval, 'horizon': horizon, 'bits': bits}
    created = []
    for domain, kind in _rotation_targets(state):
        created += _rotation_pregenerate(state, domain, kind)
    _json_write(ROTATION_FILE, state)
    return {'rotation_all': enabled, 'pre_generated': created}


def rotation_set(args):
    """Own settings for one domain and key type. 'default' removes them again; pre-generated keys stay."""
    domain, kind, mode = _dkim_domain(args.domain), args.type.strip(), args.mode.strip()
    if kind not in ('rsa', 'ed25519', 'arc'):
        raise EfaError("Type must be 'rsa', 'ed25519' or 'arc'.")
    state = _rotation_state()
    kinds = state['domains'].setdefault(domain, {})
    if mode == 'default':
        kinds.pop(kind, None)
        if not kinds:
            state['domains'].pop(domain)
    elif mode in ('on', 'off'):
        interval, horizon, bits = _rotation_numbers(args.interval, args.horizon, args.bits)
        first = (args.next or '').strip()
        if first:
            try:
                if datetime.date.fromisoformat(first) <= _today():
                    raise EfaError('The first rotation date must be in the future.')
            except ValueError:
                raise EfaError('First rotation date must look like 2027-01-31.')
        kinds[kind] = {'enabled': mode == 'on', 'interval': interval, 'horizon': horizon, 'bits': bits,
                       'next': first or None}
    else:
        raise EfaError("Mode must be 'on', 'off' or 'default'.")
    created = _rotation_pregenerate(state, domain, kind)
    _json_write(ROTATION_FILE, state)
    return {'domain': domain, 'type': kind, 'settings': _rotation_settings(state, domain, kind), 'pre_generated': created}


def rotation_pregenerate(args):
    """Create the missing future keys now, so their DNS records can be published early."""
    domain = _dkim_domain(args.domain) if (args.domain or '').strip() else ''
    state = _rotation_state()
    created = []
    for name, kind in _rotation_targets(state):
        if not domain or name == domain:
            created += _rotation_pregenerate(state, name, kind)
    return {'pre_generated': created}


def resolver_set(args):
    """External DNS servers that are asked for a new key, and how many must show it. Two IPv4, two IPv6."""
    state = _rotation_state()
    new = {}
    for name, version in (('ipv4_1', 4), ('ipv4_2', 4), ('ipv6_1', 6), ('ipv6_2', 6)):
        value = (getattr(args, name) or '').strip()
        if value:
            try:
                address = ipaddress.ip_address(value)
            except ValueError:
                raise EfaError(f'{value} is no IP address.')
            if address.version != version or address.is_unspecified or address.is_multicast:
                raise EfaError(f'{value} is no usable IPv{version} address.')
        new[name] = value
    configured = len([value for value in new.values() if value])
    needed = (args.threshold or '').strip() or str(ROTATION_THRESHOLD)
    # The default needs no check, it may be set before all servers are entered.
    if (args.threshold or '').strip():
        if not needed.isdigit() or not 1 <= int(needed) <= configured:
            raise EfaError(f'DNS servers needed must be from 1 to {configured}, the number of servers entered.')
    state['resolvers'], state['threshold'] = new, int(needed)
    _json_write(ROTATION_FILE, state)
    return new


def _arc_state():
    state = _json_read(ARC_FILE, {})
    state.setdefault('all', {'enabled': False, 'key': 'dkim', 'bits': DKIM_MIN_BITS})
    state.setdefault('domains', {})
    state.setdefault('trusted', [])
    return state


def _arc_settings(state, domain):
    return state['domains'].get(domain) or (state['all'] if state['all']['enabled'] else None)


def _arc_domains(state):
    return sorted(set(state['domains']) | set(_dkim_conf_domains()) if state['all']['enabled'] else set(state['domains']))


def _arc_rsa_key(domain):
    for key in _dkim_keys():
        if key['domain'] == domain and key['state'] == 'active' and key['purpose'] == 'dkim' and key['public'] \
                and key['public'][0] == 'rsa':
            return key
    return None


def _arc_own_key(domain):
    return next((key for key in _dkim_keys() if key['domain'] == domain and key['state'] == 'active'
                 and key['purpose'] == 'arc'), None)


def _arc_key_for(domain, settings):
    return _arc_own_key(domain) if settings['key'] == 'own' else _arc_rsa_key(domain)


def _write_arc_conf():
    """Seals inside rspamd, the milter order stays. Without a key rspamd still checks incoming ARC chains."""
    state = _arc_state()
    # Inbound for the recipient domain, outbound for the sender domain; exact domains only, no default key.
    lines = ['allow_username_mismatch = true;', 'try_fallback = false;', 'use_esld = false;', 'sign_inbound = true;',
             'use_domain = "recipient";', 'sign_local = true;', 'sign_authenticated = true;',
             'use_domain_sign_local = "header";', 'use_domain_sign_networks = "header";']
    entries = []
    for domain in _arc_domains(state):
        settings = _arc_settings(state, domain)
        key = _arc_key_for(domain, settings) if settings and settings['enabled'] else None
        if key:
            entries += [f'  {domain} {{', f'    path = "{key["path"]}";', f'    selector = "{key["selector"]}";', '  }']
    if entries:
        lines += ['domain {'] + entries + ['}']
    _arc_seal_keys({domain: _arc_key_for(domain, _arc_settings(state, domain)) for domain in _arc_domains(state)
                    if _arc_settings(state, domain) and _arc_settings(state, domain)['enabled']})
    if state['trusted']:
        # A valid ARC chain of these sealers counts (ARC_ALLOW_TRUSTED) and softens a DMARC reject of forwarded mail.
        lines.append('whitelisted_signers_map = [' + ', '.join(f'"{domain}"' for domain in state['trusted']) + '];')
    _write(ARC_CONF, '\n'.join(lines) + '\n')


def _arc_seal_keys(keys):
    """The keys rspamd seals with, for efa-cdr: <domain>.key and <domain>.selector, root only; efa-cdr gets them as credentials and
    is restarted when they change."""
    wanted = {}
    for domain, key in keys.items():
        if key:
            with open(key['path'], 'rb') as f:
                wanted[f'{domain}.key'] = f.read()
            wanted[f'{domain}.selector'] = (key['selector'] + '\n').encode()
    return _credential_dir(ARC_SEAL_DIR, wanted)


def _dkim_sign_keys():
    """G7-25: the DKIM keys rspamd signs with, as <domain>.<selector>.key for efa-cdr, while CDR outbound is on; else none."""
    wanted = {}
    if content_state()['outbound']:
        for domain, rows in _dkim_conf_domains().items():
            for path, selector in rows:
                with open(path, 'rb') as f:
                    wanted[f'{domain}.{selector}.key'] = f.read()
    return _credential_dir(DKIM_SIGN_DIR, wanted)


def _credential_dir(folder, wanted):
    """A folder of systemd credentials for efa-cdr made equal to wanted {name: bytes}, root only; efa-cdr restarts on a change."""
    os.makedirs(folder, mode=0o700, exist_ok=True)
    changed = False
    for name in os.listdir(folder):
        if name not in wanted:
            os.remove(os.path.join(folder, name))
            changed = True
    for name, data in wanted.items():
        path = os.path.join(folder, name)
        try:
            with open(path, 'rb') as f:
                if f.read() == data:
                    continue
        except OSError:
            pass
        fd = os.open(path + '.tmp', os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, 'wb') as f:
            f.write(data)
        os.replace(path + '.tmp', path)
        changed = True
    if changed:
        _safe(lambda: _platform().service_try_restart(CDR_UNIT), None)
    return changed


def add_efa_headers(conf):
    '''The milter_headers settings with the headers of eFa-next. Safe to run again, an older version of a routine is replaced.'''
    if not re.search(r'^use = \[', conf, re.M) or not re.search(r'^custom \{\n', conf, re.M):
        raise EfaError('milter_headers.conf has an unknown form, nothing was changed.')
    for name, routine in EFA_HEADER_ROUTINES.items():
        if f'  {name} = <<EOD' in conf:
            conf = re.sub(rf'^  {name} = <<EOD\n.*?^EOD;\n', lambda found: routine, conf, count=1, flags=re.M | re.S)
        else:
            conf = re.sub(r'^use = \[', f'use = ["{name}", ', conf, count=1, flags=re.M)
            conf = re.sub(r'^custom \{\n', lambda found: found.group(0) + routine, conf, count=1, flags=re.M)
    return conf


def efa_headers_apply(_args):
    '''Adds the headers X-eFa-next-ARC-Sealer and X-eFa-next-DKIM-Signer to the rspamd settings. A config rspamd rejects is taken back.'''
    with open(MILTER_HEADERS_CONF) as f:
        conf = f.read()
    new = add_efa_headers(conf)
    if new == conf:
        return {'efa_headers': 'present'}
    _write(MILTER_HEADERS_CONF, new)
    if not _rspamd_config_ok():
        _write(MILTER_HEADERS_CONF, conf)
        raise EfaError('rspamd rejected the config, it was taken back.')
    subprocess.run(['systemctl', 'try-reload-or-restart', 'rspamd'], check=False, capture_output=True)
    return {'efa_headers': 'added'}


def _arc_prepare(domain, settings, selector=None):
    """Makes sure the key exists. Returns a note if it cannot be used."""
    if settings['key'] == 'own':
        if not _arc_own_key(domain):
            _dkim_make_key(domain, selector or ARC_SELECTOR, 'rsa', settings['bits'], ARC_DIR)
        return None
    if not _arc_rsa_key(domain):
        return f'{domain} has no DKIM RSA key, ARC needs its own key here.'
    return None


def _arc_apply():
    _write_arc_conf()
    if not _rspamd_config_ok():
        raise EfaError('rspamd rejected the ARC config, it is written but not loaded. Check rspamadm configtest.')
    _reload_rspamd()


def _arc_key_choice(args):
    key = args.key.strip() or 'dkim'
    if key not in ('dkim', 'own'):
        raise EfaError("Key must be 'dkim' or 'own'.")
    return key, _dkim_rsa_bits(args.bits or str(DKIM_MIN_BITS))


def arc_set(args):
    """ARC for one domain, with the DKIM RSA key or an own RSA key. 'default' follows the switch for all domains."""
    domain, mode = _dkim_domain(args.domain), args.mode.strip()
    state = _arc_state()
    if mode == 'default':
        state['domains'].pop(domain, None)
        note = None
    elif mode in ('on', 'off'):
        key, bits = _arc_key_choice(args)
        settings = {'enabled': mode == 'on', 'key': key, 'bits': bits}
        note = _arc_prepare(domain, settings, (args.selector or '').strip() or None) if mode == 'on' else None
        if note:
            raise EfaError(note)
        state['domains'][domain] = settings
    else:
        raise EfaError("Mode must be 'on', 'off' or 'default'.")
    _json_write(ARC_FILE, state)
    _arc_apply()
    return arc_show(args)


def arc_trusted_set(args):
    """Sealers whose ARC chain is trusted, such as microsoft.com or google.com. Empty by default: then nothing changes."""
    action, domain = args.action.strip(), args.domain.strip().lower()
    if action not in ('add', 'remove') or not DOMAIN_RE.match(domain):
        raise EfaError("Action 'add' or 'remove', and a domain.")
    state = _arc_state()
    previous = list(state['trusted'])
    if action == 'add' and domain not in state['trusted']:
        state['trusted'] = sorted(state['trusted'] + [domain])
    elif action == 'remove':
        if domain not in state['trusted']:
            raise EfaError('This sealer is not in the list.')
        state['trusted'].remove(domain)
    _json_write(ARC_FILE, state)
    try:
        _arc_apply()
    except EfaError:
        state['trusted'] = previous
        _json_write(ARC_FILE, state)
        _write_arc_conf()
        raise
    return {'trusted_sealers': state['trusted']}


def arc_all_set(args):
    """ARC for all domains with DKIM keys, also for domains added later. A domain may keep its own setting."""
    enabled = _on_off(args.mode)
    key, bits = _arc_key_choice(args)
    state = _arc_state()
    state['all'] = {'enabled': enabled, 'key': key, 'bits': bits}
    if enabled:
        for domain in _arc_domains(state):
            if domain not in state['domains']:
                _arc_prepare(domain, state['all'])
    _json_write(ARC_FILE, state)
    _arc_apply()
    return arc_show(args)


def arc_show(_args):
    """ARC state per domain with the DNS record of the key in use."""
    state = _arc_state()
    rows = []
    for domain in _arc_domains(state):
        settings = _arc_settings(state, domain)
        key = _arc_key_for(domain, settings)
        note = '' if key else ('No DKIM RSA key: choose an own key.' if settings['key'] == 'dkim' else 'Own key is missing.')
        rows.append({'domain': domain, 'active': bool(settings['enabled'] and key), 'settings_from': 'override' if domain
                     in state['domains'] else 'default', 'key': settings['key'], 'selector': key['selector'] if key else '',
                     'bits': _key_bits(key['path']) if key else None, 'dns': _dkim_value(key) if key else '', 'note': note,
                     'has_dkim_rsa': bool(_arc_rsa_key(domain))})
    return {'arc_all': state['all']['enabled'], 'arc_all_key': state['all']['key'], 'arc_all_bits': str(state['all']['bits']),
            'arc_domains': rows, 'trusted_sealers': state['trusted']}


def _dmarc_who():
    user = os.environ.get('SUDO_USER')
    if os.environ.get('EFA_CLUSTER_UQ'):
        # 6.0.0.7 (R7-2): held mail handled for a login through another node of the cluster; the audit names both.
        return f"cluster node {os.environ['EFA_CLUSTER_UQ']} ({acting_user or '-'})"
    if os.environ.get('EFA_CLUSTER_FORWARDED'):
        # HA: a change a node handed on runs here as root; the audit names the node and its login (efa-cluster --client).
        return acting_client or f"cluster node {os.environ['EFA_CLUSTER_FORWARDED']}"
    if user == 'efa-web':
        return f'web interface ({acting_user})' if acting_user else 'web interface'
    # The portal acts for its logged-in user (--as): the audit and the quarantine have to name that user.
    if user == 'efa-portal':
        return f'user portal ({acting_user})' if acting_user else 'user portal'
    return f'console ({user or "root"})'


def _dmarc_uris(value, name):
    """Checks mailto addresses and returns them with their hosts."""
    uris, hosts = [], []
    for uri in [item.strip() for item in (value or '').split(',') if item.strip()]:
        match = re.match(r'^mailto:([a-z0-9._%+-]+)@([a-z0-9.-]+\.[a-z]{2,})$', uri.lower())
        if not match:
            raise EfaError(f'{name}: {uri} is no valid mailto address, like mailto:dmarc@example.org')
        uris.append(uri.lower())
        hosts.append(match.group(2))
    return uris, hosts


def _dmarc_policy(value, name, optional=True):
    value = (value or '').strip()
    if (not value and optional) or value in ('none', 'quarantine', 'reject'):
        return value
    raise EfaError(f'{name} must be none, quarantine or reject.')


def _dmarc_flag(value, name, allowed, default):
    value = (value or default).strip()
    if value not in allowed:
        raise EfaError(f'{name} must be one of {", ".join(allowed)}.')
    return value


def dmarc_record_set(args):
    """Builds the _dmarc TXT record of a domain after RFC 9989 and keeps every saved version."""
    domain = _dkim_domain(args.domain)
    use_ruf = (args.ruf_enable or 'off').strip() == 'on'
    fields = {'p': _dmarc_policy(args.p or 'none', 'p', optional=False), 'sp': _dmarc_policy(args.sp, 'sp'),
              'np': _dmarc_policy(args.np, 'np'), 'adkim': _dmarc_flag(args.adkim, 'adkim', ('r', 's'), 'r'),
              'aspf': _dmarc_flag(args.aspf, 'aspf', ('r', 's'), 'r'), 't': _dmarc_flag(args.t, 't', ('y', 'n'), 'n'),
              'rua': '', 'ruf': '', 'fo': '0'}
    rua_text = args.rua or ''
    # The report service template: efa adds the own report address, which eFa-next reads (reports-in-set).
    if (getattr(args, 'service', '') or '').strip() == 'efa':
        own = _json_read(REPORTS_FILE_IN, {})
        if not own.get('enabled') or not own.get('address'):
            raise EfaError('Switch on the own report address first: reports-in-set.')
        rua_text = ','.join(item for item in (rua_text.strip(), f"mailto:{own['address']}") if item)
    rua, hosts = _dmarc_uris(rua_text, 'rua')
    fields['rua'] = ','.join(rua)
    warnings = [P_NONE_HINT] if fields['p'] == 'none' else []
    if use_ruf and eu_relation(domain) is not False:
        raise EfaError('No failure reports (ruf) for a domain with EU relation: they carry whole mails to a third party.')
    if use_ruf:
        if (args.ruf_ack or '').strip() != 'yes':
            raise EfaError(RUF_WARNING + " Confirm this warning to save failure reports (--ruf_ack yes).")
        warnings.append(RUF_WARNING)
        ruf, ruf_hosts = _dmarc_uris(args.ruf, 'ruf')
        if not ruf:
            raise EfaError('Failure reports need at least one ruf address.')
        fields['ruf'] = ','.join(ruf)
        hosts += ruf_hosts
        fields['fo'] = _dmarc_flag(args.fo, 'fo', ('0', '1', 'd', 's'), '0')
    elif (args.ruf or '').strip():
        warnings.append('The ruf address was not saved, failure reports are not switched on.')
    parts = ['v=DMARC1', f'p={fields["p"]}']
    parts += [f'{tag}={fields[tag]}' for tag in ('sp', 'np') if fields[tag]]
    parts += [f'{tag}={fields[tag]}' for tag in ('adkim', 'aspf') if fields[tag] != 'r']
    parts += [f'{tag}={fields[tag]}' for tag in ('rua', 'ruf') if fields[tag]]
    if fields['ruf'] and fields['fo'] != '0':
        parts.append(f'fo={fields["fo"]}')
    if fields['t'] == 'y':
        parts.append('t=y')
    # shortcut: compares domains directly instead of the RFC 9989 DNS tree walk; a sibling subdomain gets one record too many.
    external = sorted({host for host in hosts if host != domain and not host.endswith('.' + domain)
                       and not domain.endswith('.' + host)})
    confirmed = eu_transfer_check(domain, external, getattr(args, 'external_confirm', ''), 'DMARC reports')
    if confirmed:
        warnings.append('Reports go to a service not shown to be in the EU, as you confirmed: ' + ', '.join(confirmed))
    if external:
        warnings.append('Reports go to another domain, it must publish the authorization record: '
                        + ', '.join(f'{domain}._report._dmarc.{host}' for host in external))
    version = {'record': '; '.join(parts), 'fields': fields, 'external': external, 'when': time.strftime('%Y-%m-%d %H:%M:%S'),
               'who': _dmarc_who()}
    records = _json_read(DMARC_RECORDS, {})
    item = records.setdefault(domain, {'current': None, 'history': []})
    if not item['current'] or item['current']['record'] != version['record']:
        item['current'] = version
        item['history'].append(version)
        _json_write(DMARC_RECORDS, records)
    return {'domain': domain, 'name': f'_dmarc.{domain}', 'record': item['current']['record'], 'external': external,
            'warnings': warnings}



def dkim_selector_warnings(rows, own, own_selectors, today):
    """6c: new selectors of own domains that eFa-next does not sign with, many failures of the last day, weak keys."""
    found = []
    for row in rows:
        key = (row['domain'], row['selector'])
        if row['domain'] in own and key not in own_selectors and str(row['first_seen'])[:10] >= (today - datetime.timedelta(days=7)).isoformat():
            found.append(_text('New DKIM selector {selector} of the own domain {domain} since {since}: is it yours?', selector=row['selector'],
                               domain=row['domain'], since=str(row['first_seen'])[:10]))
        if row['alg'].endswith('sha1') or (row['alg'].startswith('rsa') and row.get('key_bits') and int(row['key_bits']) < 2048):
            found.append(_text('Weak DKIM key: {domain} selector {selector} ({what}).', domain=row['domain'], selector=row['selector'],
                               what=row['alg'] + (f", {row['key_bits']} bits" if row.get('key_bits') else '')))
        if row.get('fail_day', 0) >= 10 and row['fail_day'] * 5 >= row.get('pass_day', 0) + row['fail_day']:
            found.append(_text('DKIM of {domain} selector {selector} failed {count} times yesterday.', domain=row['domain'], selector=row['selector'],
                               count=row['fail_day']))
    return found


def dkim_selectors(args):
    """6c: every DKIM selector seen in and out, with first and last time, results and key length; CSV or JSON with --format."""
    domain = (getattr(args, 'domain', '') or '').strip().lower()
    where, params = ([' WHERE s.domain = %s'], [domain]) if domain else ([''], [])
    if identity_now and identity_now.get('domains') is not None:
        allowed = identity_now['domains'] or ['']
        where = [(where[0] + ' AND ' if where[0] else ' WHERE ') + 's.domain IN (' + ', '.join(['%s'] * len(allowed)) + ')']
        params += allowed
    rows = _admin_query('SELECT s.domain, s.selector, s.alg, s.direction, CAST(s.first_seen AS CHAR) AS first_seen, CAST(s.last_seen AS CHAR) AS last_seen, '
                        's.n_pass, s.n_fail, s.last_result, s.key_bits, COALESCE(d.n_pass, 0) AS pass_day, COALESCE(d.n_fail, 0) AS fail_day '
                        'FROM dkim_selectors s LEFT JOIN dkim_selector_daily d ON d.day = CURDATE() - INTERVAL 1 DAY AND d.domain = s.domain '
                        'AND d.selector = s.selector AND d.alg = s.alg AND d.direction = s.direction' + where[0] + ' ORDER BY s.domain, s.selector LIMIT 5000', params)
    rows = [{**row, 'n_pass': int(row['n_pass']), 'n_fail': int(row['n_fail']), 'pass_day': int(row['pass_day']), 'fail_day': int(row['fail_day'])} for row in rows]
    own_selectors = {(key['domain'], key['selector']) for key in _dkim_keys()}
    warnings = dkim_selector_warnings(rows, set(_own_domains()), own_selectors, _today())
    fmt = (getattr(args, 'format', '') or '').strip()
    if fmt == 'csv':
        out = io.StringIO()
        writer = csv.writer(out)
        columns = ('domain', 'selector', 'alg', 'direction', 'first_seen', 'last_seen', 'n_pass', 'n_fail', 'last_result', 'key_bits')
        writer.writerow(columns)
        for row in rows:
            writer.writerow([row.get(column) for column in columns])
        return {'csv': out.getvalue()}
    if fmt == 'json':
        return {'json': json.dumps(rows, indent=1, default=str)}
    return {'selectors': rows, 'warnings': warnings}


def _dkim_key_bits_job():
    """Daily: the length of the published key of up to 200 selectors not checked for a week, through the own resolver."""
    rows = _admin_query("SELECT domain, selector, alg, direction FROM dkim_selectors WHERE alg LIKE 'rsa%%' AND (key_checked IS NULL OR "
                        "key_checked < NOW() - INTERVAL 7 DAY) LIMIT 200")
    for row in rows:
        done = subprocess.run(['dig', '+short', '+time=3', '+tries=1', f"{row['selector']}._domainkey.{row['domain']}", 'TXT', '@127.0.0.1'],
                              capture_output=True, text=True, timeout=10)
        text = ''.join(re.findall(r'"([^"]*)"', done.stdout))
        found = re.search(r'p=([A-Za-z0-9+/=]+)', text)
        bits = None
        if found:
            try:
                from cryptography.hazmat.primitives import serialization
                bits = serialization.load_der_public_key(base64.b64decode(found.group(1))).key_size
            except (ValueError, TypeError, AttributeError):
                bits = None
        _admin_query('UPDATE dkim_selectors SET key_bits = %s, key_checked = NOW() WHERE domain = %s AND selector = %s AND alg = %s AND direction = %s',
                     (bits, row['domain'], row['selector'], row['alg'], row['direction']))
    for where, params in retention_deletes(retention_global('dkim'), retention_tenants(), _tenant_domains_or_none(), 'dkim', ('domain',)):
        _admin_query(f"DELETE FROM dkim_selector_daily WHERE {where.replace('ts < NOW()', 'day < CURDATE()', 1)}", params)
        # 9h: a selector not seen for as long goes from the list as well.
        _admin_query(f"DELETE FROM dkim_selectors WHERE {where.replace('ts <', 'last_seen <', 1)}", params)

def dmarc_record_show(_args):
    """Saved _dmarc records of all domains with their history."""
    rows = []
    for domain, item in sorted(_json_read(DMARC_RECORDS, {}).items()):
        current = item['current']
        rows.append({'domain': domain, 'name': f'_dmarc.{domain}', 'record': current['record'],
                     'authorization': [f'{domain}._report._dmarc.{host}' for host in current['external']],
                     'ruf': bool(current['fields']['ruf']), 'history': list(reversed(item['history']))})
    return {'dmarc_records': rows, 'hint': P_NONE_HINT}


def dmarc_record_history(args):
    """All saved versions of one domain, newest first."""
    domain = _dkim_domain(args.domain)
    return {'domain': domain, 'history': list(reversed(_json_read(DMARC_RECORDS, {}).get(domain, {}).get('history', [])))}


def dmarc_record_check(args):
    """Reads an existing record and names tags that RFC 9989 removed. Saves nothing."""
    tags, notes = {}, []
    for part in [item.strip() for item in args.record.split(';') if item.strip()]:
        tag, _, value = part.partition('=')
        tags[tag.strip()] = value.strip()
    if next(iter(tags), None) != 'v' or tags.get('v') != 'DMARC1':
        raise EfaError('A DMARC record must start with v=DMARC1.')
    for tag, text in (('pct', 'use t=y for a test phase'), ('rf', 'failure report format is fixed'),
                      ('ri', 'report interval is up to the reporter')):
        if tag in tags:
            notes.append(f'{tag} is deprecated, RFC 9989 removed it: {text}.')
    known = {'v', 'p', 'sp', 'np', 'adkim', 'aspf', 'fo', 'rua', 'ruf', 't', 'psd', 'pct', 'rf', 'ri'}
    notes += [f'{tag} is no known tag.' for tag in tags if tag not in known]
    if 'ruf' in tags:
        notes.append(RUF_WARNING)
    return {'tags': tags, 'notes': notes}


def _actions():
    values = dict(DEFAULT_ACTIONS)
    for line in _read_lines(ACTIONS_CONF):
        match = re.match(r'^(greylist|rewrite_subject|reject) = ([0-9.]+);', line)
        if match:
            values[match.group(1)] = match.group(2)
    return values


def _load_limits():
    data = _json_read(LOAD_FILE, {})
    return {'load_percent': data.get('percent', 80), 'load_minutes': data.get('minutes', 30)}


def settings(_args):
    """Current values of the settings below."""
    # One postconf for all six values: six processes took about 120 ms of the users page (budget 100 ms).
    pc = _postconf_many(['mynetworks', 'relayhost', 'message_size_limit', 'smtpd_recipient_restrictions', 'smtpd_milters', 'milter_header_checks'])
    return {
        'maintenance_mode': not os.path.exists(MONITOR_CRON), 'first_boot': os.path.exists(FIRSTBOOT_PENDING),
        'relay_networks': pc['mynetworks'].split(),
        'smarthost': pc['relayhost'],
        'message_size_limit_mb': int(pc['message_size_limit']) // (1024 * 1024),
        'spam_scores': _actions(), 'show_subjects': subjects_shown(), 'firewall_pending_seconds': firewall_pending_seconds(), 'cluster_managed_by': _cluster_managed_by(), 'store_headers': headers_policy()['store'], 'headers_days': headers_policy()['days'],
        'greylisting': 'enabled = false;' not in _read_lines(GREYLIST_CONF),
        'greylist_minutes': greylist_values(open(GREYLIST_CONF).read() if os.path.exists(GREYLIST_CONF) else '')[0],
        'greylist_days': greylist_values(open(GREYLIST_CONF).read() if os.path.exists(GREYLIST_CONF) else '')[1],
        'sender_allow': _read_lines(SENDER_MAPS['allow']),
        'sender_block': _read_lines(SENDER_MAPS['block']),
        'transports': _read_transports(),
        'admin_email': _admin_email(),
        'recipient_verification': 'reject_unverified_recipient' in pc['smtpd_recipient_restrictions'],
        'fail2ban': os.path.exists(FAIL2BAN_JAIL),
        'auto_backup': not os.path.exists(BACKUP_DISABLED),
        'smtpd_milters': pc['smtpd_milters'],
        'dns_zones': _dns_zones(),
        'own_hosts': _safe(lambda: hosts_show(HOSTS_SHARED), {}),
        'own_hosts_local': _safe(lambda: hosts_show(HOSTS_LOCAL), {}),
        'extra_services': _read_lines(HEALTH_EXTRA),
        'maillog_days': _maillog_days(),
        'quarantine': f'regexp:{QUARANTINE_RULES}' in pc['milter_header_checks'],
        'quarantine_days': _quarantine_days(),
        'dmarc_reports': os.path.exists(DMARC_CRON),
        'maillog_max_mb': _maillog_max_mb(),
        'rspamd_sso': _rspamd_sso_mode(),
        'rspamd_sso_until': time.strftime('%H:%M', time.localtime(_rspamd_sso_until())) if _rspamd_sso_until() else '',
        'sanesecurity': _sane_state()['enabled'],
        'mailreport_daily': _report_settings()['daily'],
        **_load_limits(),
    }


def _on_off(value):
    value = value.strip().lower()
    if value not in ('on', 'off'):
        raise EfaError("Value must be 'on' or 'off'.")
    return value == 'on'


def redis_limit(ram, ipv6=True):
    """Redis may use a quarter of the memory, and only drops keys with a TTL: Bayes keys have none. Without IPv6 on the host it
    listens on 127.0.0.1 only: its default 'bind 127.0.0.1 -::1' makes the kernel try to load IPv6 (an SELinux denial each start)."""
    return f'maxmemory {ram // 4}\nmaxmemory-policy volatile-lru\n' + ('' if ipv6 else 'bind 127.0.0.1\n')


def _redis_cli():
    """redis-cli on EL9, valkey-cli on EL10 (the platform layer)."""
    # An eFa-next-base of before (during an update) has no such path yet: the EL9 one.
    return _platform().PATHS.get('redis_cli', '/usr/bin/redis-cli')


def redis_tune(_args):
    """Limit the memory of Redis (Valkey on EL10). Safe to run again; takes effect without a restart."""
    platform_now = _platform()
    conf_path = platform_now.PATHS.get('redis_conf', '/etc/redis/redis.conf')
    efa_conf = os.path.join(os.path.dirname(conf_path), 'efa.conf')
    text = redis_limit(os.sysconf('SC_PAGE_SIZE') * os.sysconf('SC_PHYS_PAGES'), ipv6=platform_now.ipv6_available())
    _write(efa_conf, text)
    shutil.chown(efa_conf, platform_now.ACCOUNTS.get('redis_user', 'redis'), 'root')
    with open(conf_path) as f:
        conf = f.read()
    include = f'include {efa_conf}\n'
    if include not in conf:
        with open(conf_path, 'a') as f:
            f.write('\n' + include)
    for line in text.splitlines():
        subprocess.run([_redis_cli(), 'config', 'set', *line.split()], check=False, capture_output=True)
    return {'redis': text.split()}


def ssh_admin_problem(user, groups, sudo_text, has_key, password_hash, sshd_text):
    """Why this user cannot replace root: None if the user has full sudo and can log in through SSH. Anything unclear counts against it."""
    full_sudo = re.search(r'\(ALL(\s*:\s*ALL)?\)\s+(NOPASSWD:\s*)?ALL\s*$', sudo_text, re.M)
    if not full_sudo:
        return 'no full sudo rights'
    settings = {}
    for line in sshd_text.lower().splitlines():
        key, _, value = line.partition(' ')
        settings.setdefault(key, []).extend(value.split())
    name, member = user.lower(), {group.lower() for group in groups}
    if name in settings.get('denyusers', []) or member & set(settings.get('denygroups', [])):
        return 'denied by the SSH settings'
    if settings.get('allowusers') and name not in settings['allowusers']:
        return 'not in AllowUsers'
    if settings.get('allowgroups') and not member & set(settings['allowgroups']):
        return 'not in AllowGroups'
    password = bool(password_hash) and password_hash[0] not in '!*'
    if not full_sudo.group(2) and not password:
        return 'sudo asks for a password, and the user has none'
    if password and 'yes' in settings.get('passwordauthentication', []):
        return None
    if has_key is None and 'yes' in settings.get('pubkeyauthentication', []):
        return 'unknown: eFa-next cannot read the SSH keys of this user'
    if not (has_key and 'yes' in settings.get('pubkeyauthentication', [])):
        return 'no SSH key and no password login'
    return None


def ssh_has_key(user, home, sshd_text):
    """True or False for an SSH key in the files of AuthorizedKeysFile, None when eFa-next cannot read them (such as a home it cannot see)."""
    files = next((line.split()[1:] for line in sshd_text.splitlines() if line.lower().startswith('authorizedkeysfile ')), ['.ssh/authorized_keys'])
    if not os.path.isdir(home):
        return None
    unknown = False
    for name in files:
        if name.lower() == 'none':
            continue
        path = '%'.join(part.replace('%h', home).replace('%u', user) for part in name.split('%%'))
        path = path if path.startswith('/') else os.path.join(home, path)
        try:
            with open(path) as f:
                if any(line.strip() and not line.lstrip().startswith('#') for line in f):
                    return True
        except FileNotFoundError:
            continue
        except OSError:
            unknown = True
    return None if unknown else False


def _ssh_admins():
    """Users who can take over from root, and why the others cannot."""
    with open(ETC + '/shadow') as f:
        hashes = dict(line.split(':')[:2] for line in f if ':' in line)
    admins, refused = [], {}
    for entry in pwd.getpwall():
        if not 1000 <= entry.pw_uid < 65534 or entry.pw_shell.endswith(('nologin', 'false')):
            continue
        groups = [group.gr_name for group in grp.getgrall() if entry.pw_name in group.gr_mem] + [grp.getgrgid(entry.pw_gid).gr_name]
        sudo = subprocess.run(['sudo', '-n', '-l', '-U', entry.pw_name], capture_output=True, text=True).stdout
        sshd = subprocess.run(['sshd', '-T', '-C', f'user={entry.pw_name},host=localhost,addr=127.0.0.1'], capture_output=True, text=True).stdout
        has_key = ssh_has_key(entry.pw_name, entry.pw_dir, sshd)
        problem = ssh_admin_problem(entry.pw_name, groups, sudo, has_key, hashes.get(entry.pw_name, ''), sshd)
        if problem:
            refused[entry.pw_name] = problem
        else:
            admins.append(entry.pw_name)
    return admins, refused


def _ssh_root_value():
    done = subprocess.run(['sshd', '-T'], capture_output=True, text=True)
    match = re.search(r'^permitrootlogin (\S+)$', done.stdout, re.M)
    if not match:
        raise EfaError('sshd does not answer: ' + done.stderr.strip()[-200:])
    return match.group(1)


def _sshd_apply():
    """Checks the configuration, then a reload: running sessions stay."""
    done = subprocess.run(['sshd', '-t'], capture_output=True, text=True)
    if done.returncode != 0:
        raise EfaError('sshd rejected the configuration: ' + done.stderr.strip()[-200:])
    subprocess.run(['systemctl', 'reload', 'sshd'], check=True, capture_output=True)


def _platform_path(name):
    return _platform().path(name)


def sshd_first(key, path=None):
    """The line sshd takes an option from: (value, file, line number), or None. sshd keeps the first value it reads, reads an
    Include in place (files in name order), and a Match line ends the part that holds for all logins."""
    path = path or ETC + '/ssh/sshd_config'
    try:
        with open(path) as f:
            lines = f.read().splitlines()
    except OSError:
        return None
    for number, line in enumerate(lines, 1):
        words = line.split('#', 1)[0].split()
        if not words:
            continue
        if words[0].lower() == 'match':
            return None
        if words[0].lower() == 'include':
            for pattern in words[1:]:
                pattern = ETC + pattern[4:] if pattern.startswith('/etc/') else pattern if pattern.startswith('/') else f'{ETC}/ssh/{pattern}'
                for included in sorted(glob.glob(pattern)):
                    found = sshd_first(key, included)
                    if found:
                        return found
        elif words[0].lower() == key.lower() and len(words) > 1:
            return words[1].lower(), path, number
    return None


# sshd -T names prohibit-password by its old name.
SSHD_SAME = {'without-password': 'prohibit-password'}


def ssh_override_problem(wanted, effective):
    """An error text when sshd does not take the value eFa-next wrote: which line comes first."""
    if SSHD_SAME.get(effective, effective) == SSHD_SAME.get(wanted, wanted):
        return None
    first = sshd_first('PermitRootLogin')
    where = f'{first[1]} line {first[2]} sets PermitRootLogin {first[0]} and comes first' if first else 'another setting comes first'
    return f'sshd does not take PermitRootLogin {wanted}: {where}.'


# The modes of the switch from what sshd -T shows.
SSH_ROOT_SHOWN = {'yes': 'on', 'prohibit-password': 'key-only', 'without-password': 'key-only', 'no': 'off'}


def ssh_root_status(_args):
    """Whether root can log in through SSH, and who could take over."""
    value = _ssh_root_value()
    admins, refused = _ssh_admins()
    warnings = []
    # eFa-next wrote another value than the one sshd takes: an earlier file (such as the 01-permitrootlogin.conf of Anaconda) wins.
    # Only the first file of eFa-next in the order sshd reads them counts: a later one of eFa-next is overruled by eFa-next itself.
    own = sorted({path for path in (SSH_ROOT_DROPIN, _platform_path('sshd_root_dropin'), SSH_ROOT_OLD_DROPIN) if path and os.path.exists(path)})
    written = sshd_first('PermitRootLogin', own[0]) if own else None
    problem = ssh_override_problem(written[0], value) if written else None
    if problem:
        warnings.append(problem)
    if value == 'yes':
        warnings.append(_text('Root can log in through SSH with a password (PermitRootLogin yes). With key-only, root keeps its SSH keys and passwords stop.'))
    elif value not in ('no',):
        warnings.append(_text('Root can log in through SSH with an SSH key (PermitRootLogin {value}).', value=value))
    if value != 'no':
        if not admins:
            warnings.append(_text('No other user can take over yet: it needs full sudo rights and an SSH key or a password login.'))
    return {'ssh_root_login': value, 'mode': SSH_ROOT_SHOWN.get(value, value), 'ssh_admins': admins, 'ssh_refused': refused, 'warnings': warnings,
            'overridden': ssh_root_overridden()}


def ssh_root_overridden():
    """S30: other files in sshd_config.d that set PermitRootLogin while 00-efa-root.conf comes first: kept, named here."""
    folder = ETC + '/ssh/sshd_config.d'
    if not os.path.exists(SSH_ROOT_DROPIN):
        return []
    found = []
    for path in sorted(glob.glob(folder + '/*.conf')):
        # A file read before ours wins and is a warning of the status already; the later ones are what this lists.
        if os.path.basename(path) <= os.path.basename(SSH_ROOT_DROPIN):
            continue
        first = sshd_first('PermitRootLogin', path)
        if first:
            found.append(f'{os.path.basename(path)} sets PermitRootLogin {first[0]}: overridden by 00-efa-root.conf')
    return found


# What each mode of the switch writes. "off" also stops SSH keys of root; "key-only" stops passwords only.
SSH_ROOT_MODES = {'on': 'yes', 'key-only': 'prohibit-password', 'off': 'no'}


def ssh_root_set(args):
    """Root login through SSH: on, with an SSH key only, or off. Off also refuses the SSH keys of root,
    so it needs another user with full sudo rights and SSH access."""
    _confirm(args)
    mode = args.mode.strip().lower()
    mode = {'yes': 'on', 'no': 'off', 'prohibit-password': 'key-only'}.get(mode, mode)
    if mode not in SSH_ROOT_MODES:
        raise EfaError('Mode: on, key-only or off.')
    previous = open(SSH_ROOT_DROPIN).read() if os.path.exists(SSH_ROOT_DROPIN) else None
    if mode == 'off' and not _ssh_admins()[0]:
        raise EfaError('Refused: no other user with full sudo rights and an SSH key or a password login. Root login stays on.')
    if SSH_ROOT_MODES[mode] is None:
        if previous is not None:
            os.remove(SSH_ROOT_DROPIN)
    else:
        _write(SSH_ROOT_DROPIN, f'PermitRootLogin {SSH_ROOT_MODES[mode]}\n')
    try:
        _sshd_apply()
        # A file read before ours can hold another value: then the switch would show a state that is not there.
        problem = ssh_override_problem(SSH_ROOT_MODES[mode], _ssh_root_value()) if SSH_ROOT_MODES[mode] else None
        if problem:
            raise EfaError(problem + ' The switch is taken back; remove or change that line first.')
    except (EfaError, subprocess.CalledProcessError):
        if previous is None:
            if os.path.exists(SSH_ROOT_DROPIN):
                os.remove(SSH_ROOT_DROPIN)
        else:
            _write(SSH_ROOT_DROPIN, previous)
        try:
            _sshd_apply()
        except (EfaError, subprocess.CalledProcessError):
            pass
        raise
    _audit(f'root login through SSH set to {mode} by {_dmarc_who()}')
    return {'ssh_root_login': _ssh_root_value()}


def _admin_db():
    """As root: users, tokens and the audit log are out of reach of the mail log user."""
    import pymysql
    try:
        return pymysql.connect(unix_socket='/var/lib/mysql/mysql.sock', user='root', password=_mysql_env().get('MYSQL_PWD', ''), database='efa',
                               charset='utf8mb4', autocommit=True, cursorclass=pymysql.cursors.DictCursor)
    except pymysql.MySQLError as err:
        raise EfaError(f'The database does not answer: {err}')


def _admin_query(sql, params=()):
    db = _admin_db()
    try:
        with db.cursor() as cur:
            cur.execute(sql, params)
            return cur.fetchall()
    finally:
        db.close()


# S31: what a login leaves in the database: its second factor (TOTP secret and recovery codes), passkeys, API tokens and groups.
# A removed user takes all of it along; the sessions end at once and its login links of the portal go.
USER_ROWS = ('api_tokens', 'user_groups', 'user_totp', 'user_passkeys', 'user_email_codes')


def user_remove_statements(username, who):
    """The statements that remove a login and everything bound to it, in this order (one transaction)."""
    return ([(f'DELETE FROM {table} WHERE username = %s', (username,)) for table in USER_ROWS]
            + [("DELETE FROM quarantine_links WHERE purpose = 'login' AND rcpt = %s", (username,)),
               ('UPDATE web_sessions SET ended = NOW(), ended_by = %s WHERE username = %s AND ended IS NULL', (who[:120], username)),
               ('DELETE FROM users WHERE username = %s', (username,))])


# S38: the accounts that are no row of users on purpose start with @ (the main admin @admin, the console admins): never an orphan.
ORPHAN_WHERE = "SUBSTR(username, 1, 1) <> '@' AND username NOT IN (SELECT username FROM users)"


def orphan_selects():
    """The names of logins that are gone (removed by 6.0.0.6 or older, which left the second factor and the passkeys behind)."""
    return [f'SELECT DISTINCT username FROM {table} WHERE {ORPHAN_WHERE}' for table in USER_ROWS]


def orphan_statements(names):
    """Only the rows of these names, found by orphan_selects and named in the audit before they go."""
    marks = ', '.join(['%s'] * len(names))
    return [(f'DELETE FROM {table} WHERE username IN ({marks}) AND {ORPHAN_WHERE}', tuple(names)) for table in USER_ROWS]


def totp_active_count():
    """The second factors switched on; an error as text (counted on both sides of an update or a release upgrade)."""
    try:
        return _admin_query('SELECT COUNT(*) AS n FROM user_totp WHERE active = 1')[0]['n']
    except Exception as err:  # pymysql errors have no common base here
        return f'error: {str(err)[:80]}'


def _admin_transaction(statements):
    """All or nothing: the counts of the rows each statement changed."""
    db = _admin_db()
    try:
        db.autocommit(False)
        counts = []
        with db.cursor() as cur:
            for sql, params in statements:
                counts.append(cur.execute(sql, params))
        db.commit()
        return counts
    except Exception:
        db.rollback()
        raise
    finally:
        db.close()


def web_password_hash(password, salt=None, rounds=600000):
    salt = salt or secrets.token_bytes(16)
    digest = hashlib.pbkdf2_hmac('sha256', password.encode(), salt, rounds)
    return f'pbkdf2_sha256${rounds}${base64.b64encode(salt).decode()}${base64.b64encode(digest).decode()}'


def web_password_ok(stored, password):
    try:
        _, rounds, salt, digest = stored.split('$')
        calculated = hashlib.pbkdf2_hmac('sha256', password.encode(), base64.b64decode(salt), int(rounds))
        return secrets.compare_digest(calculated, base64.b64decode(digest))
    except ValueError:
        return False


def command_permission(name, writes):
    """The one permission a command needs. Everything without its own is a system setting."""
    if name in COMMAND_PERMISSIONS:
        return COMMAND_PERMISSIONS[name]
    for prefix, read, write in COMMAND_PERMISSION_PREFIXES:
        if name.startswith(prefix):
            return write if writes else read
    return 'settings.edit' if writes else 'settings.view'


def command_allowed(identity, name, writes):
    """identity None is root on the console, or the main admin of the web interface."""
    if identity is None:
        return True
    # The release upgrade and the security standards: super admins only, whatever permissions another group holds.
    if name in SUPER_COMMANDS:
        return identity.get('role') == 'super'
    permission = command_permission(name, writes)
    return permission is None or permission in identity['grants']


def _scope_merge(old, new):
    """None is the whole system and wins."""
    if old is None or new is None:
        return None
    return {'tenants': old['tenants'] | new['tenants'], 'domains': old['domains'] | new['domains']}


def membership_scope(group, member, tenant_domains):
    if group['scope'] == 'member':
        if member.get('tenant_id') is not None:
            return {'tenants': {member['tenant_id']}, 'domains': set(tenant_domains.get(member['tenant_id'], ()))}
        if member.get('domain'):
            return {'tenants': set(), 'domains': {member['domain']}}
        return None
    if group['scope'] == 'global':
        return None
    domains = set(group['scope_domains'])
    for tenant in group['scope_tenants']:
        domains |= set(tenant_domains.get(tenant, ()))
    return {'tenants': set(group['scope_tenants']), 'domains': domains}


def grants_of(memberships, tenant_domains):
    """{permission: scope} of a user. The permissions of all groups add up, each with the scope of its group."""
    grants = {}
    for member in memberships:
        group = member['group']
        if group.get('disabled'):
            continue
        scope = membership_scope(group, member, tenant_domains)
        permissions = set(group['permissions']) | (set(group.get('global_extra', ())) if scope is None else set())
        permissions |= {implied for permission in permissions for implied in IMPLIED_PERMISSIONS.get(permission, ())}
        for permission in permissions:
            if permission in GLOBAL_PERMISSIONS and scope is not None:
                continue
            grants[permission] = _scope_merge(grants[permission], scope) if permission in grants else (
                None if scope is None else {'tenants': set(scope['tenants']), 'domains': set(scope['domains'])})
    return grants


def grants_cover(have, wanted):
    """Nobody hands out a permission or a scope they do not have themselves. have None is root or the main admin."""
    if have is None:
        return True
    for permission, scope in wanted.items():
        if permission not in have:
            return False
        if have[permission] is None:
            continue
        if scope is None or not scope['tenants'] <= have[permission]['tenants'] or not scope['domains'] <= have[permission]['domains']:
            return False
    return True


def _group_row(row):
    """A row of efa_groups as used by grants_of. Predefined groups take their permissions from the code."""
    if row['builtin'] in BUILTIN_GROUPS:
        spec = BUILTIN_GROUPS[row['builtin']]
        return {**row, 'permissions': set(spec['permissions']), 'global_extra': set(spec.get('global_extra', ())), 'scope': 'member',
                'scope_tenants': set(), 'scope_domains': set(), 'description': spec['description'], 'disabled': 0}
    return {**row, 'permissions': set((row['permissions'] or '').split()), 'global_extra': set(),
            'scope_tenants': {int(item) for item in (row['scope_tenants'] or '').split(',') if item.isdigit()},
            'scope_domains': {item for item in (row['scope_domains'] or '').split(',') if item}}


def _groups():
    return {row['id']: _group_row(row) for row in _admin_query('SELECT id, name, description, builtin, permissions, scope, scope_tenants, scope_domains, '
                                                               'disabled FROM efa_groups')}


def _tenant_domains():
    found = {}
    for row in _admin_query('SELECT domain, tenant_id FROM tenant_domains'):
        found.setdefault(row['tenant_id'], []).append(row['domain'])
    return found


def _memberships(username, groups=None):
    groups = groups if groups is not None else _groups()
    return [{**row, 'group': groups[row['group_id']]} for row in _admin_query('SELECT group_id, tenant_id, domain FROM user_groups WHERE username = %s',
                                                                              (username,)) if row['group_id'] in groups]


def user_tenants(memberships, tenant_domains):
    """The tenants a user belongs to, and whether one of the memberships reaches beyond tenants (global or a domain without tenant)."""
    tenant_of = {domain: tenant for tenant, domains in tenant_domains.items() for domain in domains}
    found, beyond = set(), False
    for member in memberships:
        scope = membership_scope(member['group'], member, tenant_domains)
        if scope is None:
            beyond = True
            continue
        found |= set(scope['tenants'])
        for domain in scope['domains']:
            if domain in tenant_of:
                found.add(tenant_of[domain])
            else:
                beyond = True
    return found, beyond


def restrict_grants(grants, tenant_id, tenant_domains):
    """The permissions of a token bound to one tenant: only inside it, nothing of the whole system."""
    inside = {'tenants': {tenant_id}, 'domains': set(tenant_domains.get(tenant_id, ()))}
    found = {}
    for permission, scope in grants.items():
        if permission in GLOBAL_PERMISSIONS:
            continue
        if scope is None:
            found[permission] = {'tenants': set(inside['tenants']), 'domains': set(inside['domains'])}
            continue
        kept = {'tenants': scope['tenants'] & inside['tenants'], 'domains': scope['domains'] & inside['domains']}
        if kept['tenants'] or kept['domains']:
            found[permission] = kept
    return found


def role_label(memberships, grants):
    """A short word for the web interface: super sees all pages, user gets the quarantine as start page."""
    if any(member['group'].get('builtin') == 'super' for member in memberships):
        return 'super'
    return 'user' if set(grants) <= {'quarantine.self'} else 'admin'


def _identity(row, memberships, tenant_domains):
    grants = grants_of(memberships, tenant_domains)
    return {**row, 'memberships': memberships, 'grants': grants, 'role': role_label(memberships, grants), 'domains': [], 'tenant_ids': [], 'tenant_id': None}


def identity_focus(identity, permission):
    """Sets the scope of the permission the command needs: domains and tenant_ids None mean the whole system."""
    nothing = {'tenants': set(), 'domains': set()}
    scope = identity['grants'].get(permission, nothing) if permission else nothing
    identity['domains'] = None if scope is None else sorted(scope['domains'])
    identity['tenant_ids'] = None if scope is None else sorted(scope['tenants'])
    identity['tenant_id'] = identity['tenant_ids'][0] if identity['tenant_ids'] else None
    return identity


def _mail_domains(text):
    return {item.rsplit('@', 1)[1].lower() for item in re.split(r'[\s,;<>]+', text or '') if '@' in item}


def in_scope(identity, addresses):
    """identity['domains'] None means no limit."""
    if identity is None or identity['domains'] is None:
        return True
    return bool(_mail_domains(' '.join(addresses)) & set(identity['domains']))


DOMAIN_WORD_RE = re.compile(r'\b(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\.)+[a-z]{2,}\b', re.I)


def domain_filter(value, domains, own_host=''):
    """Removes what names a domain outside the scope: list entries, keys, and texts in lists. The host name of eFa-next itself stays."""
    def foreign(text):
        words = [word.lower() for word in DOMAIN_WORD_RE.findall(text)]
        return any(word != own_host and word not in domains and not any(word.endswith('.' + domain) for domain in domains) for word in words)
    if isinstance(value, dict):
        return {key: domain_filter(item, domains, own_host) for key, item in value.items()
                if not (DOMAIN_RE.match(str(key).lower()) and str(key).lower() not in domains)}
    if isinstance(value, list):
        kept = []
        for item in value:
            if isinstance(item, dict) and isinstance(item.get('domain'), str) and item['domain'].lower() not in domains:
                continue
            if isinstance(item, str) and foreign(item):
                continue
            # A notice [text, page, card(, query)]: the whole of it goes when its text names a foreign domain. Only the text went
            # before, and the dashboard got [page, card] (a domain admin's dashboard, 2026-11-13).
            if isinstance(item, list) and item and isinstance(item[0], str) and foreign(item[0]):
                continue
            kept.append(domain_filter(item, domains, own_host))
        return kept
    return value


def domain_argument_ok(identity, name, args):
    """The domain named in the arguments is one of the own, for a limited scope. An empty one means all, so it is refused then."""
    if identity is None or identity['domains'] is None or name not in DOMAIN_ARGUMENTS:
        return True
    value = (getattr(args, DOMAIN_ARGUMENTS[name], '') or '').strip().lower()
    return bool(value) and value.rsplit('@', 1)[-1] in identity['domains']


def subjects_shown():
    return _json_read(PRIVACY_FILE, {}).get('show_subjects', True)


def subject_filter(identity, name, result, shown):
    """Subjects in the log and the search only with the permission, and while the switch is on."""
    if name not in SUBJECT_COMMANDS or not isinstance(result, dict) or 'mails' not in result:
        return result
    if shown and (identity is None or 'mail.view_subject' in identity['grants']):
        return result
    return {**result, 'mails': [{**mail, 'subject': ''} for mail in result['mails']]}


def subject_display_set(args):
    """Show subjects in the mail log and the search, or not. On by default: it changes nothing in the mail flow."""
    enabled = _on_off(args.mode)
    _json_write(PRIVACY_FILE, {**_json_read(PRIVACY_FILE, {}), 'show_subjects': enabled})
    return {'show_subjects': enabled}


def scoped_result(identity, name, result):
    """Leaves only what belongs to the caller. Everything a limited role may run and that shows mail passes here."""
    if identity is None or identity['domains'] is None or not isinstance(result, dict):
        return result
    if name in DOMAIN_FILTERED:
        return domain_filter(result, set(identity['domains']), own_hostname().lower())
    if name == 'sender-list':
        # The global lists are for the whole system; a domain sees its own rules.
        return {'allow': [], 'block': [], 'rules': [rule for rule in result.get('rules', []) if rule.get('recipient', '').rsplit('@', 1)[-1] in identity['domains']]}
    if name == 'quarantine-list':
        return {**result, 'quarantine': [m for m in result['quarantine'] if in_scope(identity, m['recipients'])]}
    if name in ('maillog-search', 'maillog-live', 'message-search') and 'mails' in result:
        return {**result, 'mails': [m for m in result['mails'] if in_scope(identity, [m.get('rcpt') or '', m.get('sender') or ''])]}
    return result


def _load_identity(username, allow_disabled=False, limit_tenant=None):
    rows = _admin_query('SELECT username, email, source, disabled FROM users WHERE username = %s', (username,))
    if not rows:
        raise EfaError('Unknown user.')
    if rows[0]['disabled'] and not allow_disabled:
        raise EfaError('This user is disabled.')
    tenant_domains = _tenant_domains()
    memberships = _memberships(username)
    tenants, beyond = user_tenants(memberships, tenant_domains)
    if tenants and not beyond and not allow_disabled:
        locked = {row['id'] for row in _admin_query('SELECT id FROM tenants WHERE locked = 1')}
        if tenants <= locked:
            raise EfaError('This tenant is locked.')
    identity = _identity(rows[0], memberships, tenant_domains)
    identity['tenants_of_user'] = tenants if not beyond else None
    if limit_tenant is not None:
        identity['grants'] = restrict_grants(identity['grants'], limit_tenant, tenant_domains)
        identity['role'] = role_label([], identity['grants']) if identity['role'] == 'super' else identity['role']
    return identity


def _scope_text(scope, tenant_names):
    if scope is None:
        return 'global'
    return ', '.join(sorted([f"tenant {tenant_names.get(item, item)}" for item in scope['tenants']] + sorted(scope['domains']))) or 'nothing'


def _grants_text(grants):
    names = {row['id']: row['name'] for row in _admin_query('SELECT id, name FROM tenants')}
    return {permission: _scope_text(scope, names) for permission, scope in sorted(grants.items())}


# Personal settings: the main admin has no user row, so its settings are in a file.
PREFS_DEFAULTS = {'language': 'auto', 'timezone': '', 'page_size': 100, 'notifications': True, 'view': 'standard', 'manual': []}
PREFS_PAGE_SIZES = (25, 50, 100, 200, 500)
# G7-7: the blocks of the dashboard a login may move, hide or set to half width. "Needs attention" and the CVE banner are
# not in this list: they always stay on top.
DASH_BLOCKS = ('board', 'flow', 'tiles', 'chart', 'load', 'cluster')
DASH_ACTIONS = ('up', 'down', 'hide', 'show', 'half', 'full')


def dash_layout(prefs):
    """The dashboard layout of a login, cleaned: every known block once in the order, unknown ones dropped."""
    found = prefs.get('dashboard') if isinstance(prefs.get('dashboard'), dict) else {}
    order = [name for name in found.get('order', []) if name in DASH_BLOCKS] if isinstance(found.get('order'), list) else []
    order = list(dict.fromkeys(order)) + [name for name in DASH_BLOCKS if name not in order]
    def names(key):
        return sorted({name for name in found.get(key, []) if name in DASH_BLOCKS}) if isinstance(found.get(key), list) else []
    return {'order': order, 'hidden': names('hidden'), 'half': names('half')}


def dash_change(prefs, change):
    """One change of the dashboard layout: reset, <block>:up|down|hide|show|half|full or <block>:to=<position from 0>."""
    if change == 'reset':
        return None
    name, _sep, action = change.partition(':')
    layout = dash_layout(prefs)
    if name not in DASH_BLOCKS or not (action in DASH_ACTIONS or re.fullmatch(r'to=\d{1,2}', action)):
        raise EfaError('Dashboard: reset, or <block>:up, down, hide, show, half, full or to=<position>; blocks: ' + ', '.join(DASH_BLOCKS) + '.')
    order = layout['order']
    where = order.index(name)
    if action in ('up', 'down') or action.startswith('to='):
        target = where - 1 if action == 'up' else where + 1 if action == 'down' else int(action[3:])
        target = max(0, min(len(order) - 1, target))
        order.insert(target, order.pop(where))
    elif action in ('hide', 'show'):
        layout['hidden'] = sorted(set(layout['hidden']) - {name} | ({name} if action == 'hide' else set()))
    else:
        layout['half'] = sorted(set(layout['half']) - {name} | ({name} if action == 'half' else set()))
    return layout
ADMIN_PREFS = ETC + '/eFa/admin-prefs.json'


def prefs_of(username):
    """The personal settings of a login, with the defaults for what it never set."""
    if not username:
        return {**PREFS_DEFAULTS, **_json_read(ADMIN_PREFS, {})}
    rows = _admin_query('SELECT prefs FROM users WHERE username = %s', (username,))
    try:
        stored = json.loads(rows[0]['prefs']) if rows and rows[0]['prefs'] else {}
    except ValueError:
        stored = {}
    return {**PREFS_DEFAULTS, **stored}


def prefs_check(current, language, timezone, page_size, notifications, view='', manual='', dashboard=''):
    """The new settings from the form; empty keeps a value."""
    found = dict(current)
    if language:
        if language not in ('auto', 'en', 'de'):
            raise EfaError('Language: auto, en or de.')
        found['language'] = language
    if timezone:
        import zoneinfo
        if timezone != 'server':
            try:
                zoneinfo.ZoneInfo(timezone)
            except (zoneinfo.ZoneInfoNotFoundError, ValueError):
                raise EfaError('Time zone: a name such as Europe/Vienna, or server.')
        found['timezone'] = '' if timezone == 'server' else timezone
    if page_size:
        if not page_size.isdigit() or int(page_size) not in PREFS_PAGE_SIZES:
            raise EfaError('Rows per page: ' + ', '.join(map(str, PREFS_PAGE_SIZES)) + '.')
        found['page_size'] = int(page_size)
    if notifications:
        found['notifications'] = _on_off(notifications)
    if view:
        if view not in ('standard', 'expert'):
            raise EfaError('View: standard or expert.')
        found['view'] = view
    if manual:
        # Pages with a wizard where this login wants the manual cards: <page>:on or <page>:off.
        page, _sep, state = manual.partition(':')
        if not re.fullmatch(r'[a-z0-9]{1,20}', page) or state not in ('on', 'off'):
            raise EfaError('Manual view: <page>:on or <page>:off.')
        pages = [item for item in found.get('manual', []) if item != page] + ([page] if state == 'on' else [])
        found['manual'] = sorted(pages)[-64:]
    if dashboard:
        layout = dash_change(found, dashboard)
        if layout is None:
            found.pop('dashboard', None)
        else:
            found['dashboard'] = layout
    return found


def my_settings(_args):
    """Your own settings: language, time zone, rows per page, report mails."""
    return prefs_of(identity_now['username'] if identity_now else '')


def my_settings_set(args):
    """Change your own settings. Nobody changes the settings of another login here."""
    username = identity_now['username'] if identity_now else ''
    found = prefs_check(prefs_of(username), (args.language or '').strip(), (args.timezone or '').strip(), (args.page_size or '').strip(),
                        (args.notifications or '').strip(), (getattr(args, 'view', '') or '').strip(),
                        (getattr(args, 'manual', '') or '').strip(), (getattr(args, 'dashboard', '') or '').strip())
    if username:
        _admin_query('UPDATE users SET prefs = %s WHERE username = %s', (json.dumps(found), username))
    else:
        _json_write(ADMIN_PREFS, found)
    return found


def local_times(rows, timezone, key='ts'):
    """Times of the mail log, stored in server time, in the time zone of the reader."""
    if not timezone:
        return rows
    import zoneinfo
    zone = zoneinfo.ZoneInfo(timezone)
    for row in rows:
        try:
            row[key] = datetime.datetime.fromisoformat(str(row[key])).astimezone(zone).strftime('%Y-%m-%d %H:%M:%S')
        except (ValueError, TypeError, KeyError):
            pass
    return rows


def _reader_timezone():
    try:
        return prefs_of(identity_now['username'] if identity_now else '')['timezone']
    except Exception:  # no database yet: server time
        return ''


def whoami(_args):
    """Who this login is, its groups and what it may do where."""
    if identity_now is None:
        return {'username': acting_user or 'admin', 'role': 'super', 'domains': None, 'permissions': {permission: 'global' for permission in PERMISSIONS}}
    tenants = identity_now.get('tenants_of_user')
    brand = tenant_brand(next(iter(tenants))) if tenants and len(tenants) == 1 else None
    return {'username': identity_now['username'], 'role': identity_now['role'], 'groups': [m['group']['name'] for m in identity_now['memberships']],
            'permissions': _grants_text(identity_now['grants']), 'brand': brand}


def permission_list(_args):
    """The permissions that groups can hold. Those marked global need a group for the whole system."""
    return {'permissions': [{'name': name, 'description': text, 'global_only': name in GLOBAL_PERMISSIONS} for name, text in PERMISSIONS.items()]}


def _tenant_id(name):
    rows = _admin_query('SELECT id FROM tenants WHERE name = %s', (name,))
    if not rows:
        raise EfaError(f'Unknown tenant: {name}')
    return rows[0]['id']


def tenant_list(_args):
    """Tenants with their domains."""
    tenants = _admin_query('SELECT t.id, t.name, GROUP_CONCAT(d.domain ORDER BY d.domain) AS domains FROM tenants t '
                           'LEFT JOIN tenant_domains d ON d.tenant_id = t.id GROUP BY t.id ORDER BY t.name')
    if identity_now and identity_now['tenant_ids'] is not None:
        tenants = [t for t in tenants if t['id'] in identity_now['tenant_ids']]
    return {'tenants': [{'name': t['name'], 'domains': (t['domains'] or '').split(',') if t['domains'] else []} for t in tenants]}


def tenant_set(args):
    """Add or remove a tenant. A tenant is one customer, with its domains and users."""
    name, action = args.name.strip(), args.action.strip()
    if not TENANT_RE.match(name):
        raise EfaError('Invalid tenant name.')
    if action == 'add':
        _admin_query('INSERT IGNORE INTO tenants (name) VALUES (%s)', (name,))
    elif action == 'remove':
        tenant = _tenant_id(name)
        if _admin_query('SELECT 1 FROM users WHERE tenant_id = %s LIMIT 1', (tenant,)):
            raise EfaError('This tenant still has users.')
        _admin_query('DELETE FROM tenant_domains WHERE tenant_id = %s', (tenant,))
        _admin_query('DELETE FROM tenants WHERE id = %s', (tenant,))
    else:
        raise EfaError("Action must be 'add' or 'remove'.")
    return tenant_list(None)


def tenant_domain_set(args):
    """Give a domain to a tenant, or take it away. A domain belongs to one tenant."""
    domain, action = args.domain.strip().lower(), args.action.strip()
    if not DOMAIN_RE.match(domain):
        raise EfaError('Invalid domain.')
    tenant = _tenant_id(args.tenant.strip())
    if action == 'add':
        _tenant_add_domain(tenant, domain)
        _bec_refresh()
        _scan_refresh()
        _uq_keys_refresh()
        return tenant_list(None)
    elif action == 'remove':
        _admin_query('DELETE FROM tenant_domains WHERE domain = %s AND tenant_id = %s', (domain, tenant))
    else:
        raise EfaError("Action must be 'add' or 'remove'.")
    if _layer_rows():
        # The settings of the tenant now count for this domain, or no longer.
        _layers_apply()
    _bec_refresh()
    _scan_refresh()
    return tenant_list(None)


def _member_text(member, tenant_names):
    where = tenant_names.get(member['tenant_id']) if member['tenant_id'] is not None else member['domain']
    return member['group']['name'] + (f' ({where})' if where else '')


def _users_in_scope(scope):
    """Users with a membership in the scope. None: all."""
    rows = _admin_query('SELECT username, email, source, disabled, CAST(last_login AS CHAR) AS last_login FROM users ORDER BY username')
    if scope is None:
        return rows
    inside = {row['username'] for row in _admin_query('SELECT username, tenant_id, domain FROM user_groups')
              if row['tenant_id'] in scope['tenants'] or (row['domain'] and row['domain'] in scope['domains'])}
    return [row for row in rows if row['username'] in inside]


def _actor_grants():
    return None if identity_now is None else identity_now['grants']


def _actor_scope(permission):
    return None if identity_now is None else identity_now['grants'].get(permission, {'tenants': set(), 'domains': set()})


def user_list(_args):
    """Users of the web interface and the API, besides the main admin, with their groups."""
    names = {row['id']: row['name'] for row in _admin_query('SELECT id, name FROM tenants')}
    groups = _groups()
    users = _users_in_scope(_actor_scope('users.view'))
    for user in users:
        user['groups'] = [_member_text(member, names) for member in _memberships(user['username'], groups)]
        user['disabled'] = bool(user['disabled'])
    return {'users': users}


def user_show(args):
    """One user with the effective permissions and where they count."""
    username = args.username.strip()
    if username not in {row['username'] for row in _users_in_scope(_actor_scope('users.view'))}:
        raise EfaError('Unknown user.')
    target = _load_identity(username, allow_disabled=True)
    names = {row['id']: row['name'] for row in _admin_query('SELECT id, name FROM tenants')}
    return {'username': username, 'email': target['email'], 'source': target['source'], 'disabled': bool(target['disabled']), 'role': target['role'],
            'groups': [_member_text(member, names) for member in target['memberships']], 'permissions': _grants_text(target['grants'])}


def _super_admins(changes=None):
    """Active users in the group super admin, after the changes {username: memberships or None for gone or disabled}. The main admin counts too."""
    found = 1 if os.path.exists(PASSWORD_FILE) else 0
    supers = {row['username'] for row in _admin_query("SELECT m.username FROM user_groups m JOIN efa_groups g ON g.id = m.group_id "
                                                      "JOIN users u ON u.username = m.username WHERE g.builtin = 'super' AND u.disabled = 0")}
    for username, memberships in (changes or {}).items():
        supers.discard(username)
        if memberships and any(member['group'].get('builtin') == 'super' for member in memberships):
            supers.add(username)
    return found + len(supers)


def user_change_problem(actor, target, old_grants, new_grants, removing, super_left):
    """Why a change of a user is refused, or None. actor is the user name of who works, None for root or the main admin."""
    if actor is not None and actor == target and (removing or old_grants != new_grants):
        return 'You cannot remove, disable or change the groups of your own login.'
    if super_left == 0:
        return 'This is the last active super admin.'
    return None


def _check_user_change(target, old_grants, new_grants, removing, new_memberships):
    have = _actor_grants()
    if not grants_cover(have, old_grants) or not grants_cover(have, new_grants):
        raise EfaError('Not allowed: this needs permissions or a scope you do not have.')
    problem = user_change_problem(identity_now['username'] if identity_now else None, target, old_grants, new_grants, removing,
                                  _super_admins({target: None if removing else new_memberships}))
    if problem:
        raise EfaError(problem)


def _group_by_name(name, groups):
    for group in groups.values():
        if group['name'].lower() == name.strip().lower():
            return group
    raise EfaError(f'Unknown group: {name.strip()}')


def wanted_memberships(group_names, tenant, domain, groups):
    """Memberships from a list of group names. Tenant and domain are the scope of the predefined groups."""
    found = []
    for name in group_names:
        group = _group_by_name(name, groups)
        member = {'group_id': group['id'], 'group': group, 'tenant_id': None, 'domain': None}
        if group['scope'] == 'member':
            member.update(tenant_id=tenant, domain=domain or None)
            if group.get('builtin') == 'super' and (tenant is not None or domain):
                raise EfaError('A super admin has no tenant or domain.')
            if group.get('builtin') == 'tenant' and tenant is None:
                raise EfaError('A tenant admin needs a tenant.')
            if group.get('builtin') == 'domain' and not domain:
                raise EfaError('A domain admin needs a domain.')
        found.append(member)
    return found


def _set_memberships(username, memberships):
    _admin_query('DELETE FROM user_groups WHERE username = %s', (username,))
    for member in memberships:
        _admin_query('INSERT INTO user_groups (username, group_id, tenant_id, domain) VALUES (%s, %s, %s, %s)',
                     (username, member['group_id'], member['tenant_id'], member['domain']))


def user_set(args):
    """Add or change a user, or remove one. Groups by name, separated by commas; tenant and domain are the scope of the predefined groups."""
    username, action = args.username.strip(), args.action.strip()
    if not USER_RE.match(username):
        raise EfaError('Invalid user name.')
    known = _admin_query('SELECT username FROM users WHERE username = %s', (username,))
    tenant_domains = _tenant_domains()
    old = _load_identity(username, allow_disabled=True) if known else None
    old_grants = old['grants'] if old else {}
    if action == 'remove':
        if not known:
            raise EfaError('Unknown user.')
        _confirm(args)
        _check_user_change(username, old_grants, {}, True, [])
        counts = _admin_transaction(user_remove_statements(username, _dmarc_who()))
        _audit(f'user {username} removed by {_dmarc_who()} with its 2FA, passkeys ({counts[3]}), API tokens ({counts[0]}) and '
               f'sessions ({counts[5]} ended)')
        return user_list(None)
    if action != 'set':
        raise EfaError("Action must be 'set' or 'remove'.")
    domain = (args.domain or '').strip().lower()
    address = (args.email or '').strip().lower()
    if address and not SENDER_RE.match(address):
        raise EfaError('Invalid email address.')
    tenant = _tenant_id(args.tenant.strip()) if (args.tenant or '').strip() else None
    if domain and not DOMAIN_RE.match(domain):
        raise EfaError('Invalid domain.')
    if domain and tenant is not None and domain not in tenant_domains.get(tenant, ()):
        raise EfaError('This domain does not belong to the tenant.')
    names = [item for item in (args.groups or '').split(',') if item.strip()]
    if not known:
        limit_tenants = {tenant} if tenant is not None else ({_tenant_of_domain(domain)} - {None} if domain else set())
        for item in limit_tenants:
            _tenant_limit(item, 'users')
    role = (args.role or '').strip()
    if role and not names:
        if role not in ROLES:
            raise EfaError('Role must be one of: ' + ', '.join(ROLES))
        names = [BUILTIN_GROUPS[role]['name']]
    groups = _groups()
    memberships = wanted_memberships(names, tenant, domain, groups) if names else (old['memberships'] if old else [])
    if not memberships:
        raise EfaError('A new user needs at least one group.')
    new_grants = grants_of(memberships, tenant_domains)
    _check_user_change(username, old_grants, new_grants, False, memberships)
    password = password_twice('Password, empty keeps it')
    if password and password_problem(password, username):
        raise EfaError(password_problem(password, username))
    if not known and not password:
        raise EfaError('A new user needs a password.')
    stored = web_password_hash(password) if password else None
    first = next((member['group']['builtin'] for member in memberships if member['group'].get('builtin')), 'custom')
    _admin_query('INSERT INTO users (username, role, tenant_id, domain, email, password, groups_migrated) VALUES (%s, %s, %s, %s, %s, %s, 1) '
                 'ON DUPLICATE KEY UPDATE role = VALUES(role), tenant_id = VALUES(tenant_id), domain = VALUES(domain), email = VALUES(email), '
                 'password = IF(%s, VALUES(password), password)', (username, first, tenant, domain or None, address or None, stored or '', bool(stored)))
    if names or not known:
        _set_memberships(username, memberships)
    if known and old and grants_of(memberships, tenant_domains) != old_grants:
        _admin_query('UPDATE web_sessions SET ended = NOW(), ended_by = %s WHERE username = %s AND ended IS NULL', (_dmarc_who()[:120], username))
    return user_list(None)


def user_state(args):
    """Disable a user, or enable again. A disabled user cannot log in; the API tokens stop working too."""
    username, enabled = args.username.strip(), _on_off(args.mode)
    if not _admin_query('SELECT 1 FROM users WHERE username = %s', (username,)):
        raise EfaError('Unknown user.')
    target = _load_identity(username, allow_disabled=True)
    _check_user_change(username, target['grants'], target['grants'] if enabled else {}, not enabled, target['memberships'])
    _admin_query('UPDATE users SET disabled = %s WHERE username = %s', (int(not enabled), username))
    if not enabled:
        # Locked means out now, not at the next login.
        _admin_query('UPDATE web_sessions SET ended = NOW(), ended_by = %s WHERE username = %s AND ended IS NULL', (_dmarc_who()[:120], username))
    return user_show(argparse.Namespace(username=username))


SESSION_IDLE_SECONDS = 3600
SESSION_ID_RE = re.compile(r'^[0-9a-f]{12}([0-9a-f]{52})?$')


def _session_id(args):
    value = (args.session or '').strip().lower()
    if not SESSION_ID_RE.match(value):
        raise EfaError('Session: its ID, 12 or 64 hex characters.')
    return value


def session_open(args):
    """The web interface tells a new login. Only the hash of the session cookie is stored."""
    sha = _session_id(args)
    if len(sha) != 64:
        raise EfaError('Session: the full hash.')
    _admin_query('DELETE FROM web_sessions WHERE last_seen < NOW() - INTERVAL 1 DAY')
    _admin_query('INSERT INTO web_sessions (sid_sha256, username, client, agent) VALUES (%s, %s, %s, %s)',
                 (sha, identity_now['username'] if identity_now else '', acting_client[:64], (args.agent or '')[:200]))
    return {'session': sha[:12]}


def session_check(args):
    """Is this session still on: not ended, the user not disabled. Also the role again, so a change of groups takes effect."""
    sha = _session_id(args)
    rows = _admin_query('SELECT username, ended FROM web_sessions WHERE sid_sha256 = %s', (sha,))
    if not rows or rows[0]['ended'] or rows[0]['username'] != (identity_now['username'] if identity_now else ''):
        return {'active': False}
    _admin_query('UPDATE web_sessions SET last_seen = NOW() WHERE sid_sha256 = %s', (sha,))
    return {'active': True, 'role': identity_now['role'] if identity_now else 'super'}


def _session_visible(row):
    """Own sessions always. Others for whoever may change that user; those of the main admin only for a super admin."""
    if identity_now is None:
        return True
    if row['username'] == identity_now['username']:
        return True
    if not row['username']:
        return identity_now['role'] == 'super'
    if 'users.manage' not in identity_now['grants']:
        return False
    if row['username'] not in {user['username'] for user in _users_in_scope(identity_now['grants']['users.manage'])}:
        return False
    return grants_cover(identity_now['grants'], _load_identity(row['username'], allow_disabled=True)['grants'])


def session_list(_args):
    """Active logins of the web interface, your own on other devices too."""
    rows = _admin_query('SELECT sid_sha256, username, client, agent, CAST(started AS CHAR) AS started, CAST(last_seen AS CHAR) AS last_seen FROM web_sessions '
                        'WHERE ended IS NULL AND last_seen > NOW() - INTERVAL %s SECOND ORDER BY last_seen DESC', (SESSION_IDLE_SECONDS,))
    return {'sessions': [{'id': row['sid_sha256'][:12], 'user': row['username'] or 'admin (main)', 'client': row['client'], 'browser': row['agent'],
                          'started': row['started'], 'last_seen': row['last_seen']} for row in rows if _session_visible(row)]}


def session_end(args):
    """End a session: the browser is logged out within 15 seconds."""
    value = _session_id(args)
    rows = [row for row in _admin_query('SELECT sid_sha256, username FROM web_sessions WHERE ended IS NULL AND sid_sha256 LIKE %s', (value + '%',))
            if _session_visible(row)]
    if len(rows) != 1:
        raise EfaError('No such active session.')
    _admin_query('UPDATE web_sessions SET ended = NOW(), ended_by = %s WHERE sid_sha256 = %s', (_dmarc_who()[:120], rows[0]['sid_sha256']))
    return {'ended': rows[0]['sid_sha256'][:12], 'user': rows[0]['username'] or 'admin (main)'}


def _own_tenant(args):
    """The tenant named in the arguments, if it is inside the scope of the permission of the command."""
    tenant_id = _tenant_id((args.tenant or '').strip())
    if identity_now and identity_now['tenant_ids'] is not None and tenant_id not in identity_now['tenant_ids']:
        raise EfaError('Not allowed: this tenant is outside your scope.')
    return tenant_id


def tenant_idp_status(args):
    """The login directory of a tenant: LDAP and OIDC, and its group mappings."""
    tenant_id = _own_tenant(args)
    ldap, oidc = ldap_status(None, _idp_file('ldap', tenant_id)), oidc_status(None, _idp_file('oidc', tenant_id))
    ldap['bind_password'] = secret_cell(ldap.pop('bind_password_stored'), f'tenant-ldap-set bind_password {tenant_id}', ldap.get('ldap'))
    oidc['client_secret'] = secret_cell(oidc.pop('client_secret_stored'), f'tenant-oidc-set client_secret {tenant_id}', oidc.get('oidc'))
    return {'ldap': ldap, 'oidc': oidc, 'groups': group_map_list(None, tenant_id)['groups']}


def tenant_ldap_set(args):
    """LDAP or Active Directory of a tenant: for logins with an address of its domains."""
    return ldap_set(args, _idp_file('ldap', _own_tenant(args)))


def tenant_oidc_set(args):
    """Single sign-on of a tenant: the login page asks for the mail domain and uses it."""
    return oidc_set(args, _idp_file('oidc', _own_tenant(args)))


def tenant_group_map_set(args):
    """A group of the directory of a tenant gets an eFa-next group, inside the tenant only."""
    return group_map_set(args, _own_tenant(args))


def png_size(data):
    """(width, height) of a PNG, or an error: only PNG, as an SVG can carry script."""
    if len(data) > BRAND_LOGO_BYTES:
        raise EfaError(f'Logo: at most {BRAND_LOGO_BYTES // 1024} KB.')
    if data[:8] != b'\x89PNG\r\n\x1a\n' or data[12:16] != b'IHDR' or not data.rstrip(b'\0').endswith(b'IEND\xaeB`\x82'):
        raise EfaError('Logo: a PNG file only.')
    width, height = int.from_bytes(data[16:20], 'big'), int.from_bytes(data[20:24], 'big')
    if not (1 <= width <= 1024 and 1 <= height <= 1024):
        raise EfaError('Logo: at most 1024 by 1024 pixels.')
    return width, height


def tenant_brand(tenant_id):
    rows = _admin_query('SELECT name, brand_name, brand_color FROM tenants WHERE id = %s', (tenant_id,))
    if not rows or not (rows[0]['brand_name'] or rows[0]['brand_color'] or os.path.exists(f'{BRAND_DIR}/{tenant_id}.png')):
        return None
    return {'tenant_id': tenant_id, 'name': rows[0]['brand_name'] or rows[0]['name'], 'color': rows[0]['brand_color'] or '',
            'logo': os.path.exists(f'{BRAND_DIR}/{tenant_id}.png')}


def tenant_brand_show(args):
    """Name, colour and logo of a tenant, for the web interface, the digest and the reports."""
    return {'brand': tenant_brand(_own_tenant(args))}


def tenant_brand_set(args):
    """Name, colour (#rrggbb) and logo (PNG, up to 200 KB and 1024 pixels) of a tenant. none takes a value away."""
    tenant_id = _own_tenant(args)
    name, color = (args.name or '').strip(), (args.color or '').strip()
    if name:
        if name != 'none' and (len(name) > 100 or any(ord(ch) < 32 for ch in name)):
            raise EfaError('Name: up to 100 characters.')
        _admin_query('UPDATE tenants SET brand_name = %s WHERE id = %s', (None if name == 'none' else name, tenant_id))
    if color:
        if color != 'none' and not BRAND_COLOR_RE.match(color):
            raise EfaError('Colour: like #1f6feb.')
        _admin_query('UPDATE tenants SET brand_color = %s WHERE id = %s', (None if color == 'none' else color.lower(), tenant_id))
    logo = (args.logo_file or '').strip()
    if logo == '-':
        # From the upload of the web interface, over stdin.
        data = sys.stdin.buffer.read(BRAND_LOGO_BYTES + 1)
        png_size(data)
        os.makedirs(BRAND_DIR, mode=0o755, exist_ok=True)
        with open(f'{BRAND_DIR}/{tenant_id}.png.tmp', 'wb') as f:
            f.write(data)
        os.chmod(f'{BRAND_DIR}/{tenant_id}.png.tmp', 0o644)
        os.replace(f'{BRAND_DIR}/{tenant_id}.png.tmp', f'{BRAND_DIR}/{tenant_id}.png')
    elif logo == 'none':
        if os.path.exists(f'{BRAND_DIR}/{tenant_id}.png'):
            os.remove(f'{BRAND_DIR}/{tenant_id}.png')
    elif logo:
        with open(logo, 'rb') as f:
            data = f.read(BRAND_LOGO_BYTES + 1)
        png_size(data)
        os.makedirs(BRAND_DIR, mode=0o755, exist_ok=True)
        with open(f'{BRAND_DIR}/{tenant_id}.png.tmp', 'wb') as f:
            f.write(data)
        os.chmod(f'{BRAND_DIR}/{tenant_id}.png.tmp', 0o644)
        os.replace(f'{BRAND_DIR}/{tenant_id}.png.tmp', f'{BRAND_DIR}/{tenant_id}.png')
    return {'brand': tenant_brand(tenant_id)}


def _brand_of_domain(domain):
    try:
        tenant_id = _tenant_of_domain(domain)
        return tenant_brand(tenant_id) if tenant_id is not None else None
    except EfaError:
        return None


def _tenant_counts(tenant_id, tenant_domains):
    """Domains, users and quarantine size of a tenant now."""
    domains = set(tenant_domains.get(tenant_id, ()))
    users = 0
    groups = _groups()
    for row in _admin_query('SELECT DISTINCT username FROM user_groups'):
        found, beyond = user_tenants(_memberships(row['username'], groups), tenant_domains)
        users += tenant_id in found
    size = 0
    if domains:
        found = _admin_query('SELECT COALESCE(SUM(m.size), 0) AS size FROM quarantine_mail m WHERE EXISTS (SELECT 1 FROM quarantine_rcpt r WHERE r.mail_id = m.id AND ('
                             + ' OR '.join(['r.rcpt LIKE %s'] * len(domains)) + '))', ['%@' + domain for domain in sorted(domains)])
        size = int(found[0]['size'])
    return {'domains': len(domains), 'users': users, 'quarantine_mb': round(size / 1048576, 1)}


def _tenant_mails(domains, since, until):
    """Mails to the domains of a tenant in a time range, from the mail log."""
    if not domains:
        return 0
    pattern = '@(' + '|'.join(re.escape(domain) for domain in sorted(domains)) + ')([ ,;>]|$)'
    db = _maillog_db()
    try:
        with db.cursor() as cur:
            cur.execute('SELECT COUNT(*) AS n FROM maillog WHERE ts >= %s AND ts < %s AND rcpt REGEXP %s', (since, until, pattern))
            return int(cur.fetchone()['n'])
    finally:
        db.close()


def limit_level(used, limit):
    """0 below 80 %, 1 from 80 %, 2 at the limit. No limit set: 0."""
    if not limit:
        return 0
    return 2 if used >= limit else 1 if used >= 0.8 * limit else 0


def _tenant_limit(tenant_id, kind, adding=1):
    """Refuses a new domain or user once the tenant is at its limit. Mail is never refused for this."""
    rows = _admin_query(f'SELECT limit_{kind} AS n FROM tenants WHERE id = %s', (tenant_id,))
    if rows and rows[0]['n'] is not None and _tenant_counts(tenant_id, _tenant_domains())[kind] + adding > rows[0]['n']:
        raise EfaError(f'This tenant is at its limit of {rows[0]["n"]} {kind}.')


def tenant_limits_set(args):
    """Limits of a tenant: domains, users, mails per day, quarantine in MB. none takes one away. From 80 % the admin gets a mail."""
    tenant_id = _tenant_id(args.tenant.strip())
    for kind in LIMITS:
        value = (getattr(args, kind) or '').strip()
        if not value:
            continue
        if value != 'none' and (not value.isdigit() or not 0 < int(value) <= 100000000):
            raise EfaError(f'{kind}: a positive number, or none.')
        _admin_query(f'UPDATE tenants SET limit_{kind} = %s WHERE id = %s', (None if value == 'none' else int(value), tenant_id))
    _tenant_limits_job(datetime.date.today())
    return tenant_usage(argparse.Namespace(tenant=args.tenant, month='', format=''))


def tenant_usage(args):
    """What a tenant uses: domains, users, quarantine now, mails per month. JSON, or CSV for a month."""
    tenant_id = _own_tenant(args)
    tenant_domains = _tenant_domains()
    month = (args.month or '').strip() or datetime.date.today().strftime('%Y-%m')
    if not re.fullmatch(r'\d{4}-(0[1-9]|1[0-2])', month):
        raise EfaError('Month like 2026-11.')
    start = datetime.date(int(month[:4]), int(month[5:]), 1)
    end = _add_months(start, 1)
    limits = _admin_query('SELECT name, limit_domains, limit_users, limit_mails_day, limit_quarantine_mb FROM tenants WHERE id = %s', (tenant_id,))[0]
    today = datetime.date.today()
    usage = {'tenant': limits['name'], 'month': month, **_tenant_counts(tenant_id, tenant_domains),
             'mails_month': _tenant_mails(tenant_domains.get(tenant_id, ()), start, end),
             'mails_today': _tenant_mails(tenant_domains.get(tenant_id, ()), today, today + datetime.timedelta(days=1)),
             'limits': {kind: limits[f'limit_{kind}'] for kind in LIMITS}}
    if (args.format or '').strip() == 'csv':
        keys = ('tenant', 'month', 'domains', 'users', 'quarantine_mb', 'mails_month', 'mails_today')
        return {'csv': csv_safe_text([keys, [usage[key] for key in keys]]), 'rows': 1}
    if (args.format or '').strip() == 'json':
        return {'json': json.dumps(usage, indent=1, default=str), 'rows': 1}
    return usage


def csv_safe_text(rows):
    """CSV where no cell can start a formula in a spreadsheet."""
    out = io.StringIO()
    writer = csv.writer(out)
    for row in rows:
        writer.writerow(["'" + str(cell) if str(cell)[:1] in ('=', '+', '-', '@', '\t', '\r') else cell for cell in row])
    return out.getvalue()


def _tenant_limits_job(today):
    """Hourly: limits at 80 % and 100 % send one mail a day to the admin; a full quarantine stops new quarantine for the tenant."""
    _uq_keys_refresh()  # D3: a key pair for a tenant made since the last hour
    tenants = _admin_query('SELECT id, name, limit_domains, limit_users, limit_mails_day, limit_quarantine_mb FROM tenants WHERE '
                           'limit_domains IS NOT NULL OR limit_users IS NOT NULL OR limit_mails_day IS NOT NULL OR limit_quarantine_mb IS NOT NULL')
    tenant_domains, full = _tenant_domains(), []
    for tenant in tenants:
        counts = _tenant_counts(tenant['id'], tenant_domains)
        counts['mails_day'] = _tenant_mails(tenant_domains.get(tenant['id'], ()), today, today + datetime.timedelta(days=1))
        for kind in LIMITS:
            level = limit_level(counts[kind], tenant[f'limit_{kind}'])
            if kind == 'quarantine_mb' and level == 2:
                full += tenant_domains.get(tenant['id'], [])
            if not level:
                continue
            known = _admin_query('SELECT level FROM tenant_alerts WHERE tenant_id = %s AND kind = %s AND day = %s', (tenant['id'], kind, today))
            if known and known[0]['level'] >= level:
                continue
            _admin_query('REPLACE INTO tenant_alerts (tenant_id, kind, day, level) VALUES (%s, %s, %s, %s)', (tenant['id'], kind, today, level))
            text = f"Tenant {tenant['name']}: {kind} at {counts[kind]} of {tenant[f'limit_{kind}']}."
            _event('tenant_limit', 'warning' if level == 1 else 'error', tenant=tenant['name'], limit=kind, used=counts[kind])
            _admin_notify(f"eFa-next: tenant {tenant['name']} {'near' if level == 1 else 'at'} its limit", text + (
                ' Mail still flows; ' + ('new mail is not quarantined for it.' if kind == 'quarantine_mb' else 'nothing new of this kind can be added.')
                if level == 2 else ''))
    if sorted(full) != sorted(_json_read(QUARANTINE_FULL, {}).get('domains', [])):
        if full:
            _json_write(QUARANTINE_FULL, {'domains': sorted(full)})
            os.chmod(QUARANTINE_FULL, 0o640)
            shutil.chown(QUARANTINE_FULL, 'root', 'efa-web')
        elif os.path.exists(QUARANTINE_FULL):
            os.remove(QUARANTINE_FULL)


def _tenant_add_domain(tenant_id, domain):
    taken = _admin_query('SELECT tenant_id FROM tenant_domains WHERE domain = %s', (domain,))
    if taken and taken[0]['tenant_id'] != tenant_id:
        raise EfaError('This domain belongs to another tenant.')
    if not taken:
        _tenant_limit(tenant_id, 'domains')
    _admin_query('INSERT IGNORE INTO tenant_domains (domain, tenant_id) VALUES (%s, %s)', (domain, tenant_id))
    _admin_query('DELETE FROM domain_pending WHERE domain = %s', (domain,))
    if _layer_rows():
        _layers_apply()


def domain_onboard(args):
    """A tenant admin adds a domain: it counts only after a TXT record shows the tenant owns it. A super admin adds it at once."""
    tenant_id, domain = _own_tenant(args), args.domain.strip().lower()
    if not DOMAIN_RE.match(domain):
        raise EfaError('Invalid domain.')
    if _admin_query('SELECT 1 FROM tenant_domains WHERE domain = %s', (domain,)) or \
            _admin_query('SELECT 1 FROM domain_pending WHERE domain = %s AND tenant_id <> %s', (domain, tenant_id)):
        raise EfaError('This domain is taken.')
    if identity_now is None or identity_now['grants'].get('tenants.manage', False) is None:
        _tenant_add_domain(tenant_id, domain)
        return {'domain': domain, 'state': 'active'}
    _tenant_limit(tenant_id, 'domains')
    known = _admin_query('SELECT token FROM domain_pending WHERE domain = %s', (domain,))
    token = known[0]['token'] if known else secrets.token_hex(16)
    if not known:
        _admin_query('INSERT INTO domain_pending (domain, tenant_id, token, created_by) VALUES (%s, %s, %s, %s)', (domain, tenant_id, token, _dmarc_who()[:120]))
    return {'domain': domain, 'state': 'waiting for DNS', 'record': f'_efa-verify.{domain}. TXT "efa-verify={token}"'}


def dns_txt(name):
    done = subprocess.run(['dig', '+short', '+time=5', '+tries=2', 'TXT', name], capture_output=True, text=True, timeout=30)
    return [''.join(re.findall(r'"([^"]*)"', line)) for line in done.stdout.splitlines() if line.strip()]


def domain_verify(args):
    """Looks up the TXT record of a waiting domain and turns it on when it is right."""
    domain = args.domain.strip().lower()
    rows = _admin_query('SELECT tenant_id, token FROM domain_pending WHERE domain = %s', (domain,))
    if not rows or (identity_now and identity_now['tenant_ids'] is not None and rows[0]['tenant_id'] not in identity_now['tenant_ids']):
        raise EfaError('No such waiting domain.')
    if f"efa-verify={rows[0]['token']}" not in dns_txt(f'_efa-verify.{domain}'):
        raise EfaError(f'The TXT record of _efa-verify.{domain} is not there yet, or is different.')
    _tenant_add_domain(rows[0]['tenant_id'], domain)
    return {'domain': domain, 'state': 'active'}


def domain_pending_list(_args):
    """Domains that wait for their DNS check."""
    rows = _admin_query('SELECT p.domain, p.tenant_id, t.name AS tenant, p.token, CAST(p.created AS CHAR) AS created FROM domain_pending p '
                        'JOIN tenants t ON t.id = p.tenant_id ORDER BY p.domain')
    if identity_now and identity_now['tenant_ids'] is not None:
        rows = [row for row in rows if row['tenant_id'] in identity_now['tenant_ids']]
    return {'pending': [{'domain': row['domain'], 'tenant': row['tenant'], 'created': row['created'],
                         'record': f"_efa-verify.{row['domain']}. TXT \"efa-verify={row['token']}\""} for row in rows]}


def tenant_hold_lines(rows):
    """Postfix transport lines that keep mail of locked tenants in the queue."""
    return [f"{row['domain']} retry:4.3.2 tenant locked" for row in rows]


def _tenant_users(tenant_id):
    """(users only in this tenant, users also elsewhere)."""
    tenant_domains, groups = _tenant_domains(), _groups()
    only, mixed = [], []
    for row in _admin_query('SELECT DISTINCT username FROM user_groups'):
        found, beyond = user_tenants(_memberships(row['username'], groups), tenant_domains)
        if tenant_id in found:
            (only if found == {tenant_id} and not beyond else mixed).append(row['username'])
    return only, mixed


def tenant_lock(args):
    """Lock a tenant: its users cannot log in and are logged out. Mail flows on, or waits in the queue with --mail defer."""
    tenant_id, enabled = _tenant_id(args.tenant.strip()), _on_off(args.mode)
    mail = (args.mail or '').strip() or 'flow'
    if mail not in ('flow', 'defer'):
        raise EfaError("Mail: flow or defer.")
    _admin_query('UPDATE tenants SET locked = %s, lock_mail = %s WHERE id = %s', (int(enabled), mail, tenant_id))
    if enabled:
        for username in _tenant_users(tenant_id)[0]:
            _admin_query('UPDATE web_sessions SET ended = NOW(), ended_by = %s WHERE username = %s AND ended IS NULL', (_dmarc_who()[:120], username))
    _rules_apply()
    return {'tenant': args.tenant.strip(), 'locked': enabled, 'mail': mail if enabled else 'flow'}


def tenant_delete(args):
    """Delete a tenant with all its data: users only in it, its groups, settings, keys, quarantine and mail log. Type its name again."""
    _confirm(args)
    name = args.tenant.strip()
    if (args.name_again or '').strip() != name:
        raise EfaError('Type the name of the tenant again, exactly.')
    tenant_id = _tenant_id(name)
    domains = [row['domain'] for row in _admin_query('SELECT domain FROM tenant_domains WHERE tenant_id = %s', (tenant_id,))]
    done = {'users': 0, 'groups': 0, 'quarantine': 0, 'maillog': 0, 'dkim_keys': 0}
    only, mixed = _tenant_users(tenant_id)
    for username in only:
        for table in ('api_tokens', 'user_groups', 'users'):
            _admin_query(f'DELETE FROM {table} WHERE username = %s', (username,))
        _admin_query('UPDATE web_sessions SET ended = NOW(), ended_by = %s WHERE username = %s AND ended IS NULL', (_dmarc_who()[:120], username))
        done['users'] += 1
    _admin_query('DELETE FROM user_groups WHERE tenant_id = %s' + (' OR domain IN (' + ','.join(['%s'] * len(domains)) + ')' if domains else ''), (tenant_id, *domains))
    for group in _groups().values():
        if group['builtin'] or group['scope'] not in ('tenants', 'domains'):
            continue
        tenants_left, domains_left = group['scope_tenants'] - {tenant_id}, group['scope_domains'] - set(domains)
        if (tenants_left, domains_left) == (group['scope_tenants'], group['scope_domains']):
            continue
        if not tenants_left and not domains_left:
            for table in ('user_groups', 'group_roles'):
                _admin_query(f'DELETE FROM {table} WHERE group_id = %s', (group['id'],))
            _admin_query('DELETE FROM efa_groups WHERE id = %s', (group['id'],))
            done['groups'] += 1
        else:
            _admin_query('UPDATE efa_groups SET scope_tenants = %s, scope_domains = %s WHERE id = %s',
                         (','.join(str(item) for item in sorted(tenants_left)), ','.join(sorted(domains_left)), group['id']))
    _admin_query('DELETE FROM group_roles WHERE idp_tenant = %s OR tenant_id = %s' + (' OR domain IN (' + ','.join(['%s'] * len(domains)) + ')' if domains else ''),
                 (tenant_id, tenant_id, *domains))
    _admin_query("DELETE FROM scoped_settings WHERE (level = 'tenant' AND target = %s)" + (" OR (level = 'domain' AND target IN (" + ','.join(['%s'] * len(domains)) + '))'
                                                                                         if domains else ''), (str(tenant_id), *domains))
    for domain in domains:
        _admin_query('DELETE r FROM quarantine_rcpt r WHERE r.rcpt LIKE %s', ('%@' + domain.replace('_', '\\_'),))
        for key in [key for key in _dkim_keys() if key['domain'] == domain and key['purpose'] == 'dkim']:
            dkim_remove(argparse.Namespace(domain=domain, selector=key['selector'], confirm='yes'))
            done['dkim_keys'] += 1
    for row in _admin_query('SELECT m.id FROM quarantine_mail m WHERE NOT EXISTS (SELECT 1 FROM quarantine_rcpt r WHERE r.mail_id = m.id)'):
        if os.path.exists(_uq_path(row['id'])):
            os.remove(_uq_path(row['id']))
        _admin_query('DELETE FROM quarantine_mail WHERE id = %s', (row['id'],))
        done['quarantine'] += 1
    if domains:
        pattern = '@(' + '|'.join(re.escape(domain) for domain in sorted(domains)) + ')([ ,;>]|$)'
        db = _maillog_db()
        try:
            with db.cursor() as cur:
                done['maillog'] = cur.execute('DELETE FROM maillog WHERE rcpt REGEXP %s', (pattern,))
            db.commit()
        finally:
            db.close()
        kept = [line for line in _read_lines(TRANSPORT) if line.split()[:1] and line.split()[0] not in domains]
        if kept != _read_lines(TRANSPORT):
            _write(TRANSPORT, ''.join(line + '\n' for line in kept))
            subprocess.run(['postmap', _map(TRANSPORT)], check=False, capture_output=True)
        rules = [entry for entry in _read_lines(SENDER_RULES) if entry.split('|')[-1].rsplit('@', 1)[-1] not in domains]
        if rules != _read_lines(SENDER_RULES):
            _write(SENDER_RULES, ''.join(entry + '\n' for entry in rules))
    _json_write(RULES_FILE, {'rules': [rule for rule in _rules() if not (rule['kind'] == 'tenant' and rule['value'] == name)
                                       and not (rule['kind'] == 'domain' and rule['value'].lstrip('@') in domains)]})
    for path in (f'{BRAND_DIR}/{tenant_id}.png', _idp_file('ldap', tenant_id), _idp_file('oidc', tenant_id)):
        if os.path.exists(path):
            os.remove(path)
    for table, column in (('domain_pending', 'tenant_id'), ('tenant_alerts', 'tenant_id'), ('tenant_domains', 'tenant_id'), ('tenants', 'id')):
        _admin_query(f'DELETE FROM {table} WHERE {column} = %s', (tenant_id,))
    _admin_query('UPDATE api_tokens SET expires = NOW() WHERE tenant_id = %s', (tenant_id,))
    _layers_apply()
    _tenant_limits_job(datetime.date.today())
    return {'deleted': name, 'domains': domains, 'users_kept_elsewhere': mixed, **done}


def user_verify(args):
    """Checks a login of the web interface."""
    username, password = args.username.strip(), _secrets(1, 'Password')[0]
    strict = (getattr(args, 'strict', '') or '').strip() == 'yes'
    # 5r: the code of the second factor, if the user has one: a second line, given or empty.
    code = sys.stdin.readline().strip() if not sys.stdin.isatty() else ''
    # 5s: or the answer of a passkey, a third line.
    code = (code, sys.stdin.readline(65536).strip() if not sys.stdin.isatty() else '')
    SECRETS_SEEN.extend(code)
    rows = _admin_query('SELECT password, disabled FROM users WHERE username = %s AND source = %s', (username, 'local'))
    tenant = _tenant_of_domain(username.rsplit('@', 1)[1]) if not rows and '@' in username and DOMAIN_RE.match(username.rsplit('@', 1)[1].lower()) else None
    own = _json_read(_idp_file('ldap', tenant), {}) if tenant is not None else {}
    if not rows and own.get('ldap'):
        return _totp_gate(_external_login(username.lower(), _ldap_groups(username, password, own), f'ldap:{tenant}', tenant), code, strict)
    if not rows and _json_read(LDAP_FILE, {}).get('ldap'):
        return _totp_gate(_external_login(username, _ldap_groups(username, password), 'ldap'), code, strict)
    # The same work for an unknown name, so the time does not tell which names exist.
    stored = rows[0]['password'] if rows and rows[0]['password'] else web_password_hash('')
    if not web_password_ok(stored, password) or not rows or not rows[0]['password']:
        raise EfaError('Wrong user name or password.')
    if rows[0]['disabled']:
        raise EfaError('This user is disabled.')
    found = _totp_gate({key: value for key, value in _load_identity(username).items() if key in ('username', 'role')}, code, strict)
    _admin_query('UPDATE users SET last_login = NOW() WHERE username = %s', (username,))
    # F4: on a node of a cluster the master checks the same password and signs a ticket for the held mail on other nodes.
    if not os.environ.get('EFA_CLUSTER_UQ') and os.path.isdir(os.path.join(ETC, 'eFa', 'cluster')):
        _uq_ticket_fetch(username, password, code[0])
    return found


def _totp_gate(found, code, strict=False):
    """5r/5s: the login counts only with the second factor, if the user has one (a TOTP code or a passkey); the role may ask to set
    one up. code is (TOTP code, passkey answer). strict: a confirmation of the dashboard, the code of the 2FA app for an admin."""
    code, assertion = code if isinstance(code, tuple) else (code, '')
    if strict and confirm_code_required(found['username'], found.get('role')):
        if not code:
            raise EfaError(CONFIRM_CODE)
        assertion = ''
    keys = _passkey_mode(found.get('role')) != 'off' and bool(_safe_keys(found['username']))
    if assertion and keys:
        passkey_check(assertion, found['username'])
        return found
    row = _totp_row(found['username'])
    if keys and not (row and row['active'] and code):
        raise EfaError(TOTP_NEEDED)
    if row and row['active'] and code and EMAIL_CODE_RE.match(code) and _email_code_use(found['username'], code, found.get('role')):
        # 6.0.0.7: the code by mail only sets up a new app (Hans 2026-11-16): the old app and its recovery codes go now, and
        # this login reaches nothing but the 2FA setup until the new app is confirmed (the mark of a reset).
        _totp_self_reset(found['username'])
        found['totp_setup_needed'] = True
        found['email_recovery'] = True
        return found
    totp_check(found['username'], code or None)
    if not (row and row['active']):
        # No 2FA set up, none asked (owner's rule); the login is noted, as the one of a console admin over SSH.
        _audit(f"login of {found['username']} without 2FA (not set up)")
        found['no_2fa'] = True
    if _totp_required(found['username'], found.get('role')) and not _second_factor_set(found['username']):
        found['totp_setup_needed'] = True
    if not (row and row['active']) and _totp_reenroll(found['username']):
        # 6.0.0.6.5: an admin reset the 2FA (lost phone): this login sets up a new one before anything else.
        found['totp_setup_needed'] = True
    return found


# 5r: a second factor with TOTP (RFC 6238: HMAC-SHA1, 30 seconds, 6 digits), for the authenticator apps (FreeOTP, Aegis, Microsoft
# or Google Authenticator, Duo Mobile). The secret is stored encrypted (AES-256-GCM, key for root only); a code counts once (the
# step is kept), one step before and after counts too. Ten recovery codes, stored as hashes, each once. Required per role only
# when set (off by default). The main admin of the console login is '@admin'. OIDC logins have the factor of their provider.
TOTP_KEY = ETC + '/eFa/totp.key'
TOTP_POLICY = ETC + '/eFa/2fa-policy.json'
TOTP_ROLES = ('super', 'tenant', 'domain', 'manager', 'helpdesk', 'readonly', 'auditor', 'user')
TOTP_NEEDED = '2FA code needed.'


def hotp(secret, counter, digits=6):
    """RFC 4226: the code of one counter (efa_totp, which the setup wizard uses too)."""
    return _lib('efa_totp').hotp(secret, counter, digits)


def totp_step(secret, code, last_step, now=None):
    """The step of a code that fits now (one step of slack each way) and is newer than the last one used, else None."""
    return _lib('efa_totp').totp_step(secret, code, last_step, now)


def _totp_box():
    from cryptography.hazmat.primitives.ciphers.aead import AESGCM
    if not os.path.exists(TOTP_KEY):
        fd = os.open(TOTP_KEY, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, 'w') as f:
            f.write(secrets.token_hex(32) + '\n')
    with open(TOTP_KEY) as f:
        return AESGCM(bytes.fromhex(f.read().strip()))


def totp_seal(secret, username):
    nonce = os.urandom(12)
    return base64.b64encode(nonce + _totp_box().encrypt(nonce, secret, username.encode())).decode()


def totp_open(blob, username):
    raw = base64.b64decode(blob)
    return _totp_box().decrypt(raw[:12], raw[12:], username.encode())


def _totp_row(username):
    import pymysql
    try:
        rows = _admin_query('SELECT secret, active, last_step, recovery FROM user_totp WHERE username = %s', (username,))
    except pymysql.MySQLError as err:
        if err.args and err.args[0] == 1146:
            # S38: a missing table never counts as "no second factor"; the login is refused (efactl maillog-setup makes it again).
            _audit('2FA table user_totp missing: login refused')
            raise EfaError('2FA cannot be checked (table user_totp missing): login refused. On the console: sudo efactl maillog-setup.')
        raise  # any other error fails the login, it never skips the factor
    return rows[0] if rows else None


def recovery_hash(code):
    return _lib('efa_totp').recovery_hash(code)


def totp_check(username, code):
    """True when the user has no active second factor, or the code (or a recovery code) fits; raises on a wrong or missing one."""
    row = _totp_row(username)
    if not row or not row['active']:
        return True
    if not code:
        raise EfaError(TOTP_NEEDED)
    try:
        secret = totp_open(row['secret'], username)
    except Exception as err:  # noqa: BLE001 - InvalidTag of another key, or a damaged value: never a login without the factor
        # 6.0.0.6.6.1: a node that joined a cluster kept rows sealed with its own old key while totp.key came from the master.
        _audit(f'2FA of {username} cannot be read on this host ({type(err).__name__}): login refused')
        raise EfaError('The 2FA of this login cannot be read on this host (sealed with another key): login refused. '
                       'In a cluster: sudo efactl cluster-2fa-pull on this node; else an admin resets the 2FA of this login.')
    step = totp_step(secret, code, int(row['last_step']))
    if step is not None:
        _admin_query('UPDATE user_totp SET last_step = %s WHERE username = %s AND last_step < %s', (step, username, step))
        return True
    hashes = json.loads(row['recovery'] or '[]')
    if recovery_hash(code) in hashes:
        hashes.remove(recovery_hash(code))
        _admin_query('UPDATE user_totp SET recovery = %s WHERE username = %s', (json.dumps(hashes), username))
        _audit(f'recovery code used by {username}, {len(hashes)} left')
        _2fa_mail(username, f'ein Wiederherstellungscode wurde benutzt, {len(hashes)} übrig.', f'a recovery code was used, {len(hashes)} left.')
        return True
    raise EfaError('Wrong 2FA code.')


def _totp_reenroll(username):
    """6.0.0.6.5: the 2FA of this login was reset by an admin and is not set up again yet (no before the column exists)."""
    import pymysql
    try:
        rows = _admin_query('SELECT reenroll FROM user_totp WHERE username = %s', (username,))
    except pymysql.MySQLError as err:
        if err.args and err.args[0] in (1054, 1146):
            return False
        raise
    return bool(rows and rows[0]['reenroll'])


def _2fa_mail(username, what_de, what_en):
    """6.0.0.6.5: a note to the own confirmed address of a login when its 2FA changed without its app (reset by an admin, a
    recovery code used). Never stops the work; without an address only the audit log has it."""
    def send():
        address = _admin_email() if username == '@admin' else (_account_row(username)['email'] or '')
        if not SENDER_RE.match(address or ''):
            return False
        name = 'admin' if username == '@admin' else username
        when = time.strftime('%Y-%m-%d %H:%M %Z')
        _account_mail(address, 'eFa-next: 2FA Ihres Logins / 2FA of your login',
                      f'Login {name} auf {own_hostname()}, {when}: {what_de}\n'
                      'Waren Sie das nicht, melden Sie sich sofort beim Admin.\n\n'
                      f'Login {name} on {own_hostname()}, {when}: {what_en}\n'
                      'If this was not you, tell your admin at once.\n')
        return True
    if not _safe(send, False):
        _audit(f'2FA note for {username}: no confirmed address, no mail')


# 6.0.0.7 (Hans 2026-11-16, card "Nur App neu einrichten"): a code by mail instead of the lost app. It only lets the login set
# up a new app: the old app and its recovery codes stop at once, the login reaches nothing else until the new app is confirmed.
# Only to the confirmed address of the login (its link was clicked), only with the right password, 8 digits, 10 minutes, once,
# at most 3 mails in 15 minutes and 5 wrong tries; every mail, use and refusal is in the audit log (and the strict audit).
# Per role, set by a super admin: on for every role but super admin by default. The main admin and logins of a provider have
# none (no confirmed address here): recovery codes or the reset by an admin.
EMAIL_RECOVERY_FILE = ETC + '/eFa/2fa-email-recovery.json'
EMAIL_CODE_RE = re.compile(r'^[0-9]{8}$')
EMAIL_CODE_MINUTES, EMAIL_CODE_SENDS, EMAIL_CODE_WINDOW, EMAIL_CODE_TRIES = 10, 3, 900, 5
EMAIL_CODE_NOTE = ('If this login may use a code by mail, it went to its confirmed address now. It is valid for 10 minutes, '
                   'and it only lets you set up a new 2FA app: type it as the 2FA code.')


def email_recovery_on(role):
    """Whether logins of this role may get a code by mail."""
    default = 'off' if role == 'super' else 'on'
    return _json_read(EMAIL_RECOVERY_FILE, {}).get('roles', {}).get(role, default) == 'on'


def email_recovery_status(_args):
    """Per role: may a login with a lost app get a code by mail (only to set up a new app)?"""
    return {'roles': {role: 'on' if email_recovery_on(role) else 'off' for role in TOTP_ROLES}, 'minutes': EMAIL_CODE_MINUTES,
            'mails_per_15_minutes': EMAIL_CODE_SENDS, 'note': 'The code only sets up a new app; the old app and its recovery codes stop.'}


def email_recovery_set(args):
    """A code by mail for a lost app, per role, on or off. Only a super admin."""
    role, mode = (args.role or '').strip(), (args.mode or '').strip()
    if role not in TOTP_ROLES or mode not in ('on', 'off'):
        raise EfaError('Role: ' + ', '.join(TOTP_ROLES) + '; mode on or off.')
    if identity_now and identity_now.get('role') != 'super':
        raise EfaError('Only a super admin sets the 2FA rules.')
    state = _json_read(EMAIL_RECOVERY_FILE, {})
    state.setdefault('roles', {})[role] = mode
    _json_write(EMAIL_RECOVERY_FILE, state, mode=0o644)
    _audit(f'2FA by mail for role {role} set to {mode} by {_dmarc_who()}')
    strict_record('totp_email_policy', role, mode=mode)
    return email_recovery_status(None)


def _email_code_hash(username, code):
    """Keyed with the 2FA key: a copy of the database alone does not give the code back."""
    _totp_box()  # makes the key if there is none yet
    with open(TOTP_KEY) as f:
        key = bytes.fromhex(f.read().strip())
    return hmac.new(key, f'{username}\0{code}'.encode(), hashlib.sha256).hexdigest()


def _mask_address(address):
    local, _at, domain = address.partition('@')
    return (local[:1] + '***@' + domain) if domain else '***'


def totp_email_send(args):
    """Before the login, with the right password: a code by mail instead of the lost app, only to set up a new one."""
    username, password = (args.username or '').strip(), _secrets(1, 'Password')[0]
    rows = _admin_query('SELECT password, disabled, email FROM users WHERE username = %s AND source = %s', (username, 'local'))
    # The same work for an unknown name, as the login does.
    stored = rows[0]['password'] if rows and rows[0]['password'] else web_password_hash('')
    if not web_password_ok(stored, password) or not rows or not rows[0]['password']:
        _audit(f'2FA by mail for {username[:100]} refused: wrong user name or password, from {acting_client or "console"}')
        raise EfaError('Wrong user name or password.')
    address = (rows[0]['email'] or '').strip().lower()
    reason = ''
    if rows[0]['disabled']:
        reason = 'login disabled'
    elif not (_totp_row(username) or {}).get('active'):
        reason = 'no active 2FA'
    elif not SENDER_RE.match(address):
        reason = 'no confirmed address'
    elif not email_recovery_on(_load_identity(username).get('role')):
        reason = 'off for its role'
    now = time.time()
    if not reason:
        old = _admin_query('SELECT sends FROM user_email_codes WHERE username = %s', (username,))
        sends = [stamp for stamp in json.loads((old[0]['sends'] if old else None) or '[]') if now - stamp < EMAIL_CODE_WINDOW]
        if len(sends) >= EMAIL_CODE_SENDS:
            reason = f'{EMAIL_CODE_SENDS} mails in 15 minutes already'
    if reason:
        # The same answer as a sent code: nothing tells a guesser more than the password did.
        _audit(f'2FA by mail for {username}: no code sent ({reason}), from {acting_client or "console"}')
        strict_record('totp_email_refused', username, result='refused', reason=reason)
        return {'note': EMAIL_CODE_NOTE}
    code = f'{secrets.randbelow(10 ** 8):08d}'
    _admin_query('REPLACE INTO user_email_codes (username, code_hash, expires, tries, sends) VALUES (%s, %s, NOW() + INTERVAL %s MINUTE, 0, %s)',
                 (username, _email_code_hash(username, code), EMAIL_CODE_MINUTES, json.dumps(sends + [int(now)])))
    when = time.strftime('%Y-%m-%d %H:%M %Z')
    _account_mail(address, 'eFa-next: Code zum Neueinrichten der 2FA / code to set up 2FA again',
                  f'Code: {code}\n\n'
                  f'Login {username} auf {own_hostname()}, {when}, von {acting_client or "Konsole"}. Gültig {EMAIL_CODE_MINUTES} Minuten, einmal. '
                  'Er ersetzt die verlorene App nur zum Einrichten einer neuen: die alte App und die alten Wiederherstellungscodes gelten danach nicht mehr.\n'
                  'Waren Sie das nicht, kennt jemand Ihr Passwort: ändern Sie es und melden Sie sich beim Admin.\n\n'
                  f'Login {username} on {own_hostname()}, {when}, from {acting_client or "console"}. Valid for {EMAIL_CODE_MINUTES} minutes, once. '
                  'It replaces the lost app only to set up a new one: the old app and the old recovery codes stop then.\n'
                  'If this was not you, someone knows your password: change it and tell your admin.\n')
    _audit(f'2FA by mail: code sent to {_mask_address(address)} for {username}, from {acting_client or "console"}')
    strict_record('totp_email_sent', username, address=_mask_address(address))
    return {'note': EMAIL_CODE_NOTE}


def _email_code_use(username, code, role):
    """True once for the right code within its minutes; a wrong one counts, after 5 the code is gone."""
    import pymysql
    try:
        rows = _admin_query('SELECT code_hash, tries, expires > NOW() AS fresh FROM user_email_codes WHERE username = %s', (username,))
    except pymysql.MySQLError as err:
        if err.args and err.args[0] in (1054, 1146):
            return False
        raise
    if not rows or not rows[0]['code_hash']:
        return False
    row = rows[0]
    if not row['fresh'] or not email_recovery_on(role):
        _admin_query('UPDATE user_email_codes SET code_hash = NULL WHERE username = %s', (username,))
        _audit(f'2FA by mail: code of {username} refused (expired or off for its role)')
        return False
    if not hmac.compare_digest(row['code_hash'], _email_code_hash(username, code)):
        tries = int(row['tries']) + 1
        _admin_query('UPDATE user_email_codes SET tries = %s, code_hash = %s WHERE username = %s',
                     (tries, row['code_hash'] if tries < EMAIL_CODE_TRIES else None, username))
        _audit(f'2FA by mail: wrong code for {username} ({tries} of {EMAIL_CODE_TRIES})')
        strict_record('totp_email_used', username, result='failed', tries=tries)
        return False
    _admin_query('UPDATE user_email_codes SET code_hash = NULL, tries = 0 WHERE username = %s', (username,))
    return True


def _totp_self_reset(username):
    """The code by mail was right: as a reset by an admin, but by the login itself; its other sessions end, it gets a mail."""
    _admin_query('REPLACE INTO user_totp (username, secret, active, last_step, recovery, pending, reenroll) VALUES (%s, %s, 0, 0, NULL, NULL, 1)',
                 (username, ''))
    _admin_query('UPDATE web_sessions SET ended = NOW(), ended_by = %s WHERE username = %s AND ended IS NULL', ('2FA code by mail', username))
    _audit(f'2FA by mail: {username} logged in with the code from {acting_client or "console"}; old app and recovery codes stopped, '
           'only the 2FA setup until a new app is confirmed')
    strict_record('totp_email_used', username)
    _2fa_mail(username, 'mit einem Code per Mail angemeldet. Die alte App und die alten Wiederherstellungscodes gelten nicht mehr; '
                        'richten Sie jetzt eine neue App ein.',
              'logged in with a code by mail. The old app and the old recovery codes no longer count; set up a new app now.')


def _safe_keys(username):
    import pymysql
    try:
        return _admin_query('SELECT id FROM user_passkeys WHERE username = %s LIMIT 1', (username,))
    except pymysql.MySQLError as err:
        if err.args and err.args[0] == 1146:  # no table yet
            return []
        raise


def _totp_self():
    """The account the TOTP commands act on: the logged-in user, or the main admin on the console."""
    if identity_now and identity_now.get('username'):
        return identity_now['username']
    return '@admin'


def totp_policy():
    return _json_read(TOTP_POLICY, {})


def totp_status(_args):
    """The second factor of the own login: on or off, recovery codes left, and whether the role asks for it."""
    username = _totp_self()
    row = _safe(lambda: _totp_row(username), None)
    role = (identity_now or {}).get('role') or 'super'
    return {'account': username, 'active': bool(row and row['active']), 'recovery_codes_left': len(json.loads(row['recovery'] or '[]')) if row else 0,
            'required_for_my_role': _totp_required(username, role), 'policy': totp_policy(),
            'reset_by_admin': not (row and row['active']) and _safe(lambda: _totp_reenroll(username), False)}


def totp_setup(args):
    """Starts the second factor of the own login: a new secret, as QR code and as text for the app. It counts after totp-confirm."""
    username = _totp_self()
    row = _totp_row(username)
    secret = os.urandom(20)
    if row and row['active']:
        _reauth(username)
        _admin_query('UPDATE user_totp SET pending = %s WHERE username = %s', (totp_seal(secret, username), username))
        _audit(f'2FA: new app of {username} started, the old one counts until it is confirmed')
    else:
        # 6.0.0.6.6: a first app only with the password too: a taken-over session must not bind an app of its own and lock the
        # login out. A login of a provider or a link has no password here; the console asks nothing (_reauth).
        if _password_login(username):
            _reauth(username, setup=True)
        # The mark of a reset (reenroll) stays until the new app is confirmed: leaving the setup half way does not end it.
        _admin_query('INSERT INTO user_totp (username, secret, active, last_step, recovery) VALUES (%s, %s, 0, 0, NULL) '
                     'ON DUPLICATE KEY UPDATE secret = VALUES(secret), active = 0, last_step = 0, recovery = NULL', (username, totp_seal(secret, username)))
    lib = _lib('efa_totp')
    uri = lib.uri(secret, username if username != '@admin' else 'admin@' + own_hostname())
    if getattr(args, 'qr', False):
        # ACC-1: on the console the QR code itself, in half blocks; stderr, so the JSON on stdout stays as it is.
        print(_lib('efa_qr').terminal(uri), file=sys.stderr)
    return {'secret': lib.grouped(secret), 'otpauth': uri, 'qr_svg': _lib('efa_qr').svg(uri),
            'next': 'Add it in the app, then confirm with the code it shows (totp-confirm).'
                    + (' Until then the old app counts.' if row and row['active'] else '')}


def totp_confirm(args):
    """Switches the second factor on with the first code of the app; shows the ten recovery codes once."""
    username = _totp_self()
    row = _totp_row(username)
    pending = _totp_pending(username) if row and row['active'] else None
    if not row or (row['active'] and not pending) or not (pending or row['secret']):
        raise EfaError('Start with totp-setup.')
    step = totp_step(totp_open(pending or row['secret'], username), (args.code or '').strip(), 0)
    if step is None:
        raise EfaError('Wrong code: check the time of the phone and try the next code.')
    codes = _lib('efa_totp').recovery_codes()
    hashes = json.dumps([recovery_hash(code) for code in codes])
    if pending:
        _admin_query('UPDATE user_totp SET secret = %s, pending = NULL, last_step = %s, recovery = %s WHERE username = %s', (pending, step, hashes, username))
        _audit(f'2FA of {username}: new app confirmed, the old app and the old recovery codes no longer count')
    else:
        _admin_query('UPDATE user_totp SET active = 1, last_step = %s, recovery = %s, reenroll = 0 WHERE username = %s', (step, hashes, username))
        _audit(f'2FA switched on by {username}')
    return {'active': True, 'recovery_codes': codes, 'note': 'Keep these codes safe, each works once. They are not shown again.'}


def totp_disable(args):
    """Switches the own second factor off, with a current code. Not when the role asks for it."""
    username = _totp_self()
    role = (identity_now or {}).get('role') or 'super'
    if _totp_required(username, role):
        raise EfaError('Your role asks for 2FA: it cannot be switched off.')
    if not (_totp_row(username) or {}).get('active') and _totp_reenroll(username):
        raise EfaError('An admin reset your 2FA: set up a new one first (totp-setup).')
    # The web interface and the API: password and current code (the re-auth takes the code); the console: the code.
    if not _reauth(username):
        totp_check(username, (args.code or '').strip() or None)
    _admin_query('DELETE FROM user_totp WHERE username = %s', (username,))
    _audit(f'2FA switched off by {username}')
    return {'active': False}


def _totp_pending(username):
    """The sealed secret of a new app not yet confirmed, or None (also before the column exists)."""
    import pymysql
    try:
        rows = _admin_query('SELECT pending FROM user_totp WHERE username = %s', (username,))
    except pymysql.MySQLError as err:
        if err.args and err.args[0] in (1054, 1146):
            return None
        raise
    return rows[0]['pending'] if rows else None


def totp_recovery_new(_args):
    """Ten new recovery codes for the own login, after a fresh re-auth; the old ones no longer count."""
    username = _totp_self()
    if not (_totp_row(username) or {}).get('active'):
        raise EfaError('2FA is off: there are no recovery codes.')
    _reauth(username)
    codes = _lib('efa_totp').recovery_codes()
    _admin_query('UPDATE user_totp SET recovery = %s WHERE username = %s', (json.dumps([recovery_hash(code) for code in codes]), username))
    _audit(f'2FA of {username}: new recovery codes, the old ones no longer count')
    return {'recovery_codes': codes, 'note': 'Keep these codes safe, each works once. They are not shown again.'}


# ACC-1: the own account in the web interface (My account): contact, address, password, 2FA. Each change acts on the login
# itself only (no user name to give) and goes to the audit log. Address, password and 2FA ask the password again, with the
# current 2FA code if one is set up, every time; the console (root) asks for nothing more.
ACCOUNT_FILE = ETC + '/eFa/admin-account.json'
ACCOUNT_PHONE_RE = re.compile(r'^\+?[0-9 ()/.-]{3,40}$')
ACCOUNT_LINK_DAYS = 1
REAUTH_FAILED = 'Password or 2FA code wrong, nothing changed.'
REAUTH_ARGS = [{'name': 'reauth', 'label': 'Your password, to confirm', 'secret': True, 'required': False},
               {'name': 'reauth_code', 'label': '2FA code', 'secret': True, 'required': False}]
ACCOUNT_PROVIDER = 'The address and password of this login come from its login provider: change them there.'


def _web_call():
    return identity_now is not None or os.environ.get('SUDO_USER') == 'efa-web'


def _password_login(username):
    """True for a login whose password eFa-next can check: the main admin, a local login, an LDAP login."""
    if username == '@admin':
        return True
    rows = _admin_query('SELECT source FROM users WHERE username = %s', (username,))
    source = (rows[0]['source'] or '') if rows else ''
    return source == 'local' or source.startswith('ldap')


# Hans 2026-11-22: the 2FA code of an admin is no longer optional. Every confirmation in the dashboard (the password again)
# asks for the code of the 2FA app, checked here; an admin without one sets it up first. The user portal (role user), OIDC logins
# (the factor of their provider) and a counting dev flag (admin_2fa_exempt) as before.
CONFIRM_SETUP = 'Set up your 2FA app first (My account, Two-factor login): every confirmation of an admin asks for its code.'
CONFIRM_CODE = 'Enter the code of your 2FA app: every confirmation of an admin asks for it.'


def confirm_code_required(username, role):
    """True when a confirmation of this login asks for its TOTP code; EfaError when it has no 2FA app (fail closed: a passkey
    alone gives no code)."""
    if role == 'user' or admin_2fa_exempt() or _oidc_login(username):
        return False
    if not (_totp_row(username) or {}).get('active'):
        raise EfaError(CONFIRM_SETUP)
    return True


def _reauth(username, setup=False):
    """A fresh password and, for an admin, the current 2FA code, for a change of the own login (web interface and API). setup:
    the first 2FA app itself, with the password only. True when it was asked (the code is used then), False on the console."""
    if not _web_call():
        return False
    password, code = _secrets(2, 'Your password, to confirm')
    code = code.strip()[:20]
    role = 'super' if username == '@admin' else (identity_now or {}).get('role', 'user')
    if not setup and confirm_code_required(username, role) and not code:
        raise EfaError(CONFIRM_CODE)
    try:
        if username == '@admin':
            from werkzeug.security import check_password_hash
            with open(PASSWORD_FILE) as f:
                ok = check_password_hash(f.read().strip(), password)
        else:
            rows = _admin_query('SELECT password, source FROM users WHERE username = %s', (username,))
            source = rows[0]['source'] if rows else ''
            if source == 'local':
                ok = web_password_ok(rows[0]['password'], password)
            elif source.startswith('ldap'):
                tenant = source.split(':', 1)[1] if ':' in source else None
                _ldap_groups(username, password, _json_read(_idp_file('ldap', int(tenant)), {}) if tenant and tenant.isdigit() else None)
                ok = True
            else:
                ok = False  # a login of the provider or of a link: no password here
        if not ok:
            raise EfaError(REAUTH_FAILED)
        totp_check(username, code or None)
    except EfaError:
        _audit(f're-auth of {username} failed')
        raise EfaError(REAUTH_FAILED)
    return True


def _account_row(username):
    rows = _admin_query('SELECT email, email_pending, full_name, phone, source FROM users WHERE username = %s', (username,))
    if not rows:
        raise EfaError('Unknown user.')
    return rows[0]


def _local_login(username):
    if username != '@admin' and _account_row(username)['source'] != 'local':
        raise EfaError(ACCOUNT_PROVIDER)


def account_show(_args):
    """Your own account: user name, address, name and phone."""
    username = _totp_self()
    if username == '@admin':
        own = _json_read(ACCOUNT_FILE, {})
        return {'username': 'admin', 'email': _admin_email() or '', 'email_pending': '', 'name': own.get('name', ''), 'phone': own.get('phone', ''),
                'email_note': 'The address of the main admin is the admin address of the system (admin-email-set).'}
    row = _account_row(username)
    found = {'username': username, 'email': row['email'] or '', 'email_pending': row['email_pending'] or '', 'name': row['full_name'] or '',
             'phone': row['phone'] or ''}
    if row['source'] != 'local':
        found['email_note'] = ACCOUNT_PROVIDER
    return found


def account_set(args):
    """Name and phone of your own login. Nobody changes another login here."""
    username = _totp_self()
    name, phone = (args.name or '').strip(), (args.phone or '').strip()
    if len(name) > 100 or any(ord(char) < 32 for char in name):
        raise EfaError('Name: up to 100 characters.')
    if phone and not ACCOUNT_PHONE_RE.match(phone):
        raise EfaError('Phone: digits, spaces and + ( ) / . - only.')
    if username == '@admin':
        _json_write(ACCOUNT_FILE, {'name': name, 'phone': phone}, mode=0o600)
    else:
        _account_row(username)
        _admin_query('UPDATE users SET full_name = %s, phone = %s WHERE username = %s', (name or None, phone or None, username))
    _audit(f'contact details of {username} changed by {_dmarc_who()}')
    return account_show(None)


def _account_mail(address, subject, text):
    """A mail about the own account, to an address checked with SENDER_RE."""
    from email.message import EmailMessage
    message = EmailMessage()
    message['To'], message['Subject'] = address, subject
    message.set_content(text)
    subprocess.run(['sendmail', '-t'], input=message.as_bytes(), capture_output=True, check=False)


def account_email_set(args):
    """A new address for your own login: it counts once the link sent to it is clicked; the old address gets a note then."""
    username = _totp_self()
    if username == '@admin':
        raise EfaError('The address of the main admin is the admin address of the system: admin-email-set.')
    _local_login(username)
    address = (args.email or '').strip().lower()
    if not SENDER_RE.match(address):
        raise EfaError('Invalid email address.')
    _reauth(username)
    if address == (_account_row(username)['email'] or ''):
        raise EfaError('This is the address already.')
    _admin_query('UPDATE users SET email_pending = %s WHERE username = %s', (address, username))
    _admin_query("DELETE FROM quarantine_links WHERE purpose = 'email' AND rcpt = %s AND used IS NULL", (username,))
    token = uq_link_make('email', username, days=ACCOUNT_LINK_DAYS)
    base = uq_state().get('public_url', '').rstrip('/') or f'https://{own_hostname()}'
    _account_mail(address, 'eFa-next: neue Adresse bestätigen / confirm the new address',
                  f'Die Adresse des Logins {username} soll {address} werden. Bestätigen (einen Tag gültig): {base}/q/{token}\n'
                  'Wenn Sie das nicht waren, ignorieren Sie diese Mail.\n\n'
                  f'The address of the login {username} is to become {address}. Confirm (valid for one day): {base}/q/{token}\n'
                  'If this was not you, ignore this mail.\n')
    _audit(f'address of {username}: {address} asked, waits for its link')
    return {'email_pending': address, 'note': 'A link went to the new address (valid for one day). The old address counts until it is clicked.'}


def _account_email_confirm(username):
    """The link of a new address was clicked: it counts now, the old address gets a note."""
    row = _account_row(username)
    if not row['email_pending']:
        raise EfaError('This link has expired or was already used.')
    _admin_query('UPDATE users SET email = email_pending, email_pending = NULL WHERE username = %s', (username,))
    if row['email']:
        _account_mail(row['email'], 'eFa-next: Adresse geändert / address changed',
                      f'Die Adresse des Logins {username} ist jetzt {row["email_pending"]}. Waren Sie das nicht, melden Sie sich beim Admin.\n\n'
                      f'The address of the login {username} is now {row["email_pending"]}. If this was not you, tell your admin.\n')
    _audit(f'address of {username} changed from {row["email"] or "-"} to {row["email_pending"]} (link clicked)')


def password_change(args):
    """Your own password: the current one, then the new one twice. Your other sessions end."""
    username = _totp_self()
    _local_login(username)
    _reauth(username)
    password = password_twice('New password')
    problem = password_problem(password, 'admin' if username == '@admin' else username)
    if problem:
        raise EfaError(problem)
    if username == '@admin':
        _admin_password_write(password)
    else:
        _admin_query('UPDATE users SET password = %s WHERE username = %s', (web_password_hash(password), username))
    _admin_query('UPDATE web_sessions SET ended = NOW(), ended_by = %s WHERE username = %s AND ended IS NULL AND sid_sha256 <> %s',
                 ('password change', '' if username == '@admin' else username, acting_session))
    _audit(f'password of {username} changed by {_dmarc_who()}, its other sessions ended')
    return {'password': 'changed', 'note': 'Your other sessions were ended.'}


def _on_console():
    """efactl as root on the console. The web interface always passes --client, and for the main admin it passes no --as: no
    identity alone is not the console."""
    return identity_now is None and not acting_client


def user_2fa_reset(args):
    """An admin takes the second factor of a lost phone away; the user sets it up again at the next login."""
    username = (args.username or '').strip()
    # On the console (root) the main admin is the one this resets: "reset on the console only" below (2026-11-16 it was refused).
    if username == _totp_self() and not _on_console():
        raise EfaError('Not your own: use your recovery codes, or ask another admin.')
    console = _console_key(_cli_user()) if _cli_user() else None
    if username not in ('@admin', console) and username not in {row['username'] for row in _users_in_scope(_actor_scope('users.manage'))}:
        raise EfaError('Unknown user.')
    if username == console and identity_now is not None and identity_now.get('role') != 'super':
        raise EfaError('The 2FA of the console admin is reset by a super admin.')
    if username == console:
        _console_store(_cli_user(), None)
        _audit(f'2FA of {username} reset by {_dmarc_who()}')
        strict_record('totp_reset', username)
        return {'reset': username}
    if username == '@admin' and not _on_console():
        raise EfaError('The 2FA of the main admin is reset on the console only.')
    if _web_call():
        # 6.0.0.6.5 (Hans 2026-11-16): a reset over the web interface or the API only by an admin with an own second factor,
        # and the 2FA of an admin login only by a super admin; logins of the portal (role user) by the admins of their scope.
        actor = _totp_self()
        if not ((_totp_row(actor) or {}).get('active') or _safe_keys(actor)):
            raise EfaError('Set up your own 2FA first: only an admin with 2FA resets the 2FA of others.')
        if username != '@admin' and (identity_now or {}).get('role', 'super') != 'super' \
                and _load_identity(username, allow_disabled=True).get('role') != 'user':
            raise EfaError('The 2FA of an admin login is reset by a super admin.')
    # 6.0.0.6.5: the old app and its recovery codes go; the login must set up a new one at its next login before anything else
    # (before, it came in with the password alone unless its role asked for 2FA). Its open sessions end, and it gets a mail.
    _admin_query('REPLACE INTO user_totp (username, secret, active, last_step, recovery, pending, reenroll) VALUES (%s, %s, 0, 0, NULL, NULL, 1)',
                 (username, ''))
    _admin_query('UPDATE web_sessions SET ended = NOW(), ended_by = %s WHERE username = %s AND ended IS NULL',
                 (('2FA reset by ' + _dmarc_who())[:120], '' if username == '@admin' else username))
    _audit(f'2FA of {username} reset by {_dmarc_who()}: a new one is set up at the next login, its sessions ended')
    strict_record('totp_reset', username)
    _2fa_mail(username, f'die 2FA wurde von {_dmarc_who()} zurückgesetzt. Bei der nächsten Anmeldung richten Sie eine neue ein.',
              f'the 2FA was reset by {_dmarc_who()}. At your next login you set up a new one.')
    return {'reset': username, 'next': 'The login sets up a new 2FA at its next login; its open sessions ended.'}


def totp_policy_set(args):
    """2FA required per role, or optional (the default)."""
    role, mode = (args.role or '').strip(), (args.mode or '').strip()
    if role not in TOTP_ROLES or mode not in ('required', 'optional'):
        raise EfaError('Role: ' + ', '.join(TOTP_ROLES) + '; mode required or optional.')
    if identity_now and identity_now.get('role') != 'super':
        raise EfaError('Only a super admin sets the 2FA rules.')
    policy = totp_policy()
    policy[role] = mode
    _json_write(TOTP_POLICY, policy, mode=0o644)
    _audit(f'2FA for role {role} set to {mode} by {_dmarc_who()}')
    return {'policy': policy}


def admin_2fa_verify(args):
    """The second factor of the main admin, after its password matched in the web interface; strict: a confirmation."""
    code = _secrets(1, '2FA code')[0].strip()
    if (getattr(args, 'strict', '') or '').strip() == 'yes' and confirm_code_required('@admin', 'super') and not code:
        raise EfaError(CONFIRM_CODE)
    totp_check('@admin', code or None)
    if not (_totp_row('@admin') or {}).get('active'):
        _audit('login of the main admin without 2FA (not set up)')
        return {'ok': True, 'no_2fa': True}
    return {'ok': True}


# 6.0.0.5: the setup variant, guided or manual (docs/install.md). The setup wizard hands its answers over through efa-apply
# (setup-variant-apply); Re-Setup asks the same questions later, in the web interface or here (resetup). Guided raises the
# settings of the chosen frameworks, never lowers one, and makes 2FA a must for the main admin and the console admin. The texts,
# the frameworks and the plan are in efa_setup. The file is readable for efa-web, which greys out what the EU link forbids.
SETUP_VARIANT_FILE = ETC + '/eFa/setup-variant.json'
SETUP_OFFER_DISMISSED = '/var/lib/eFa/setup-variant-offer-dismissed'
# The console admin with 2FA: this login shell asks for the code of the main admin before the shell starts (efa-console-2fa).
CONSOLE_GATE = '/usr/sbin/efa-console-2fa'
CONSOLE_SUDOERS = ETC + '/sudoers.d/efa-console-2fa'
CONSOLE_SSHD = ETC + '/ssh/sshd_config.d/50-efa-console-2fa.conf'
CONSOLE_FAILS = '/var/lib/eFa/console-2fa.json'
CONSOLE_MAX_FAILS, CONSOLE_LOCK_SECONDS = 5, 900
# A domain under one of these endings brings an EU link (Text D): the setup then locks the EU settings again.
EU_TLDS = ('at', 'be', 'bg', 'cy', 'cz', 'de', 'dk', 'ee', 'es', 'eu', 'fi', 'fr', 'gr', 'hr', 'hu', 'ie', 'it', 'lt', 'lu', 'lv', 'mt',
           'nl', 'pl', 'pt', 'ro', 'se', 'si', 'sk')


def setup_variant_state():
    return _json_read(SETUP_VARIANT_FILE, {})


def setup_guided():
    return setup_variant_state().get('variant') == 'guided'


# Hans 2026-11-19: every admin sets up a second factor (TOTP or a passkey) at the first login, on new and on upgraded hosts
# alike: after an update at the next login (Hans 2026-11-22: no days of notice). Not the user portal (role user), not a login of an OIDC
# provider (its own factor), not the break-glass admin (its one-time codes). Only the dev flag of efa-init lifts it (a
# development host), never a setting. Fail closed: no date file, or a broken one, means the rule counts now.
ADMIN_2FA_FILE = ETC + '/eFa/admin-2fa.json'


def admin_2fa_exempt():
    """Only a counting dev flag of efa-init (root:root, not writable for others, no symlink)."""
    return _lib('efa_setup').dev_flag_problem() is None


def admin_2fa_from():
    try:
        return datetime.date.fromisoformat(str(_json_read(ADMIN_2FA_FILE, {}).get('from', '')))
    except (ValueError, AttributeError, DamagedFile):
        return datetime.date.min


def admin_2fa_due(today=None):
    return not admin_2fa_exempt() and (today or datetime.date.today()) >= admin_2fa_from()


def _oidc_login(username):
    """A login of an OIDC provider: the second factor is the one of the provider."""
    if username.startswith('@'):
        return False
    rows = _admin_query('SELECT source FROM users WHERE username = %s', (username,))
    return bool(rows) and (rows[0]['source'] or '').startswith('oidc')


def _second_factor_set(username):
    """An active TOTP or a passkey; a missing table raises (S38), it never means "set"."""
    return bool((_totp_row(username) or {}).get('active')) or bool(_safe_keys(username))


def _totp_required(username, role):
    """Every admin role (Hans 2026-11-19), 5r per role, and the main admin in the guided setup."""
    if role != 'user' and admin_2fa_due() and not _oidc_login(username):
        return True
    return totp_policy().get(role) == 'required' or (username == '@admin' and setup_guided())


def admin_2fa_heal(args):
    """Package setup: the day the rule counts from (now, on a new install and on an upgrade alike), and the console admin
    behind efa-console-2fa so its first SSH login sets up its 2FA. A day in the future (a build of before 2026-11-22 gave days of
    notice) is brought back to today; an earlier day stays."""
    found = {}
    today = datetime.date.today()
    if not os.path.exists(ADMIN_2FA_FILE) or admin_2fa_from() > today:
        _json_write(ADMIN_2FA_FILE, {'from': today.isoformat()}, mode=0o644)
        _audit(f'2FA required for every admin from {today.isoformat()} ({getattr(args, "mode", "") or "heal"})')
        found['from'] = today.isoformat()
    user = _cli_user()
    rule = _read_lines(CONSOLE_SUDOERS) if os.path.exists(CONSOLE_SUDOERS) else []
    if user and not admin_2fa_exempt() and not any('console-2fa-enroll' in line for line in rule):
        found['console_admin'] = _safe(lambda: _console_2fa(True, user), None)
    return {**found, 'from': admin_2fa_from().isoformat(), 'exempt': admin_2fa_exempt()}


def _setup_current():
    """What the plan of efa_setup compares with: the 2FA policy, the audit days, the TLS profile, the daily check."""
    return {'policy': totp_policy(), 'main_admin_2fa': setup_guided(), 'audit_days': retention('audit'),
            'tls': tls_profile_state()['profile'], 'security_daily': bool(_json_read(SECURITY_SETTINGS, {}).get('daily')),
            'idle_minutes': admin_idle_minutes(), 'maillog_days': _maillog_days()}


def _setup_plan_apply(changes):
    for setting, _now, then in changes:
        if setting.startswith('2fa:') and setting != '2fa:main-admin':
            _json_write(TOTP_POLICY, {**totp_policy(), setting[4:]: 'required'}, mode=0o644)
        elif setting == 'audit_days':
            _json_write(RETENTION_FILE, {**_json_read(RETENTION_FILE, {}), 'audit': int(then)})
        elif setting == 'tls_profile':
            tls_profile_set(argparse.Namespace(profile='bsi', ciphers=''))
        elif setting == 'security_daily':
            _json_write(SECURITY_SETTINGS, {**_json_read(SECURITY_SETTINGS, {}), 'daily': True})
        elif setting == 'maillog_days':
            _write(MAILLOG_DAYS_FILE, f'{int(then)}\n')  # only ever longer (efa_setup.plan)
        elif setting == 'idle_minutes':
            _admin_idle_write(int(then))  # only ever shorter (efa_setup.plan), so no re-auth


def setup_variant_status(_args):
    """The setup variant: guided or manual, the EU link, the frameworks, when each text was confirmed, and what Re-Setup would raise."""
    lib, state = _lib('efa_setup'), setup_variant_state()
    pending = lib.plan(_setup_current(), lib.targets(state.get('frameworks', []), state.get('variant'), state.get('eulink')))
    return {'variant': state.get('variant', 'not set'), 'eulink': state.get('eulink', 'not set'), 'frameworks': ', '.join(state.get('frameworks', [])),
            'note': state.get('note', ''), 'notice_confirmed': state.get('notice', ''), 'noeu_confirmed': state.get('noeu', ''),
            'set_by': state.get('set_by', ''), 'locked': state.get('locked', ''), 'console_2fa': os.path.exists(CONSOLE_SSHD),
            'notes': [f'{title}: {note} ({lib.NONBINDING})' for title, note in lib.notes(state.get('frameworks', []))],
            'to_raise': pending, 'resetup': 'Security, Setup variant: /resetup in the web interface, or efactl resetup on the console.'}


def _setup_state_from(args, lib):
    state = {'variant': (args.variant or '').strip(), 'eulink': (args.eulink or '').strip(), 'notice': (args.notice or '').strip(),
             'noeu': (getattr(args, 'noeu', '') or '').strip(), 'frameworks': lib.frameworks_clean(getattr(args, 'frameworks', '') or ''),
             'note': (getattr(args, 'note', '') or '').strip(), 'lang': (getattr(args, 'lang', '') or 'en').strip()}
    if state['eulink'] == 'yes':
        state['noeu'] = ''
    if state['variant'] != 'guided':
        state['frameworks'], state['note'] = [], ''
    problem = lib.state_problem(state) or (None if state['lang'] in ('en', 'de') else 'language en or de')
    if problem:
        raise EfaError(f'Setup variant: {problem}. Nothing was changed.')
    return state


def _setup_write(state, before, who, console_user=None):
    """Writes the setup state, sets the EU link, raises what the plan says, switches the console 2FA on in guided. Audited."""
    lib = _lib('efa_setup')
    changes = lib.plan(_setup_current(), lib.targets(state['frameworks'], state['variant'], state['eulink']))
    state['set'] = time.strftime('%Y-%m-%d %H:%M:%S')
    # First the state: with it eu-relation-set accepts no for all, which the EU link of the setup refuses otherwise.
    _json_write(SETUP_VARIANT_FILE, state, mode=0o644)
    if eu_state()['global'] != state['eulink']:
        eu_relation_set(argparse.Namespace(mode=state['eulink'], domain=''))
    _setup_plan_apply(changes)
    if (state['variant'] == 'guided' or not admin_2fa_exempt()) and not os.path.exists(CONSOLE_SSHD):
        _console_2fa(True, console_user)
    _audit(f"setup variant {state['variant']}, EU link {state['eulink']}, frameworks {','.join(state['frameworks']) or 'none'} by {who}; "
           f"note on presets confirmed {state['notice']}" + (f", no EU link confirmed with the typed phrase {state['noeu']}" if state['noeu'] else ''))
    for setting, now, then in changes:
        _audit(f'setup variant raised {setting} from {now} to {then}')
    strict_record('setup_variant', state['variant'], old={key: before.get(key) for key in ('variant', 'eulink', 'frameworks')},
                  new={key: state[key] for key in ('variant', 'eulink', 'frameworks')}, changes=changes)
    _event('setup_variant_set', 'notice', user=who, variant=state['variant'], eulink=state['eulink'], frameworks=','.join(state['frameworks']))
    setup_eu_autolock()
    return {'state': setup_variant_state(), 'raised': changes, 'notes': [f'{title}: {note} ({lib.NONBINDING})' for title, note in lib.notes(state['frameworks'])]}


def setup_variant_apply(args):
    """The setup wizard, through efa-apply: its answers with the digest and time of each confirmed text."""
    if identity_now is not None or os.environ.get('SUDO_USER') == 'efa-web':
        raise EfaError('Only the setup sets this; later: resetup.')
    lib = _lib('efa_setup')
    state = _setup_state_from(args, lib)
    if state['variant'] == 'guided' and not (_totp_row('@admin') or {}).get('active'):
        raise EfaError('Guided setup: the 2FA of the main admin is missing (totp-import). Nothing was changed.')
    result = _setup_write({**state, 'set_by': 'setup'}, {}, 'setup', (getattr(args, 'console_user', '') or '').strip() or None)
    return {**result, **_setup_standards(getattr(args, 'standards', ''), apply=True)}


def _setup_standards(text, apply):
    """HARD-W: the standards of the setup and of Re-Setup, the strictest value of all chosen ones (efa_harden.plan_for), added to
    those chosen before (raise only). The SSH profile is left out (it needs a new SSH login within 10 minutes), port 25 stays."""
    lib = _harden()
    before = standards_state()['selected']
    selected = lib.clean(list(before) + lib.clean(text or ''))
    if not lib.clean(text or ''):
        return {}
    plan = lib.plan_for(selected, setup=True)
    found = standards_set(argparse.Namespace(select=' '.join(selected), port25_tls='', os=','.join(plan['os']) or 'none',
                                             efa=','.join(plan['efa']) or 'none', apply='yes' if apply else '', confirm='yes'))
    return {'standards': {'selected': selected, 'changes': found['changes'], 'warnings': found['warnings'],
                          **({'check': {sid: item['status'] for sid, item in found.get('check', {}).items() if sid in selected}} if apply else {}),
                          'ssh_profile': 'not set by the setup: the hardening wizard sets it, with a new SSH login within 10 minutes'
                          if 'ssh-profile' in lib.plan_for(selected)['os'] else '',
                          'web_cert': "not set by the setup: the web interface keeps its certificate; the own ECDSA certificate needs "
                                      "Let's Encrypt (Security standards or Web certificate, later)"
                          if 'web-ecdsa' in lib.plan_for(selected)['efa'] else ''}}


def _resetup_ask(lib):
    """Re-Setup on the console: the same texts and questions as the setup wizard, English or German after LANG."""
    lang = 'de' if os.environ.get('LANG', '').startswith('de') else 'en'
    tr = _lib('efa_i18n').catalog(lang).gettext
    ask = lambda prompt: input(prompt + ' ').strip()
    print('\n'.join([tr(lib.NOTICE_TITLE), '', *map(tr, lib.NOTICE), '', tr(lib.NOTICE_CONFIRM)]))
    if ask('ja/yes?').lower() not in ('ja', 'yes'):
        raise EfaError('Not confirmed, nothing was changed.')
    answers = {'notice': lib.confirmation(lib.notice_digest(tr)), 'lang': lang}
    print('\n' + tr(lib.VARIANT_TITLE) + '\n' + '\n'.join(f'  {key}: {tr(title)}: {tr(text)}' for key, (title, text) in lib.VARIANT_TEXT.items()))
    answers['variant'] = ask('guided/manual?')
    print('\n' + tr(lib.EULINK_TITLE) + '\n' + tr(lib.EULINK_TEXT) + '\n  yes: ' + tr(lib.EULINK_YES))
    answers['eulink'] = ask('yes/no?')
    answers['noeu'] = ''
    if answers['eulink'] == 'no':
        print('\n'.join(['', tr(lib.NOEU_TITLE), *map(tr, lib.NOEU), tr(lib.NOEU_CONFIRM)]))
        if not lib.phrase_ok(ask(tr(lib.NOEU_TYPE).format(phrase=lib.PHRASES[lang]))):
            raise EfaError('Not confirmed, nothing was changed.')
        answers['noeu'] = lib.confirmation(lib.noeu_digest(tr, lang))
    answers['frameworks'] = answers['note'] = ''
    if answers['variant'] == 'guided':
        print('\n' + tr(lib.FRAMEWORKS_TITLE) + '\n' + tr(lib.FRAMEWORKS_TEXT) + '\n  ' + ', '.join(lib.FRAMEWORKS))
        answers['frameworks'] = ask('?')
        answers['note'] = ask(tr(lib.FRAMEWORKS_OTHER) + ':')
    return argparse.Namespace(**answers)


def resetup(args):
    """Re-Setup: the questions of the setup for a running system. Without apply only the comparison old and new; with apply a
    backup first, then the frameworks raise (never lower) and the audit log keeps it. Guided to manual needs password and 2FA."""
    lib, before = _lib('efa_setup'), setup_variant_state()
    if identity_now and identity_now.get('role') != 'super':
        raise EfaError('Only a super admin runs Re-Setup.')
    console = identity_now is None and sys.stdin.isatty() and not args.variant
    state = _setup_state_from(_resetup_ask(lib) if console else args, lib)
    compare = [[key, before.get(key, 'not set'), state[key]] for key in ('variant', 'eulink', 'frameworks', 'note') if before.get(key) != state[key]]
    raised = lib.plan(_setup_current(), lib.targets(state['frameworks'], state['variant'], state['eulink']))
    if not console and (args.apply or '').strip() != 'yes':
        return {'compare': compare, 'raised': raised, 'notes': [f'{title}: {note} ({lib.NONBINDING})' for title, note in lib.notes(state['frameworks'])],
                **_setup_standards(getattr(args, 'standards', ''), apply=False),
                'next': 'Nothing changed yet. Check the comparison, then run it again with apply.'}
    if console:
        print(json.dumps({'compare': compare, 'raised': raised}, indent=1))
        if input('ja/yes? ').strip().lower() not in ('ja', 'yes'):
            raise EfaError('Not confirmed, nothing was changed.')
    if before.get('variant') == 'guided' and state['variant'] == 'manual':
        # 2FA stays on. On the console the code of the main admin; the web interface asked for the password and the code already.
        username = _totp_self()
        if not (_totp_row(username) or {}).get('active'):
            raise EfaError('Guided to manual needs your 2FA: set it up first (Users, 2FA).')
        if identity_now is None and sys.stdin.isatty():
            totp_check('@admin', _secrets(1, '2FA code of the main admin')[0].strip() or None)
    if state['variant'] == 'guided' and not (_totp_row('@admin') or {}).get('active'):
        compare.append(['2fa:main-admin', 'not set up', 'set up at the next login of the main admin (forced); SSH of the console admin only after that'])
    backup = _backup_make(_backup_stored_password())
    who = _dmarc_who()
    result = _setup_write({**state, 'set_by': f'resetup by {who}'}, before, who)
    _audit(f'Re-Setup by {who}, backup {backup.get("backup")} first')
    return {**result, **_setup_standards(getattr(args, 'standards', ''), apply=True), 'compare': compare, 'backup': backup.get('backup')}


def setup_offer_dismiss(_args):
    """After an update or a migration the dashboard offers Re-Setup once; this hides the offer."""
    _write(SETUP_OFFER_DISMISSED, time.strftime('%Y-%m-%d %H:%M:%S') + '\n')
    _audit(f'Re-Setup offer hidden by {_dmarc_who()}')
    return {'dismissed': True}


def _domain_eu_tld(domain):
    return domain.lower().rstrip('.').rsplit('.', 1)[-1] in EU_TLDS


def setup_eu_autolock():
    """No EU link was confirmed, but one arose (an answer yes for all or a domain, or an own domain under an EU ending): the EU
    settings are locked again (Text D), with a notice and an entry in the audit log."""
    state = setup_variant_state()
    if state.get('eulink') != 'no':
        return None
    eu = eu_state()
    reasons = (['EU relation yes for all domains'] if eu['global'] == 'yes' else []) + \
        [f'EU relation yes for {domain}' for domain, mode in sorted(eu['domains'].items()) if mode == 'yes'] + \
        [f'own domain {domain}' for domain in _safe(_local_domains, []) if _domain_eu_tld(domain)]
    if not reasons:
        return None
    state.update(eulink='yes', noeu='', locked=f"{time.strftime('%Y-%m-%d %H:%M')}: {reasons[0]}")
    _json_write(SETUP_VARIANT_FILE, state, mode=0o644)
    if eu['global'] != 'yes':
        eu['global'] = 'yes'
        _json_write(EU_FILE, eu, mode=0o644)
    _safe(lambda: backup_targets_eu_lock(None), None)
    _audit(f'setup variant: EU link arose ({", ".join(reasons[:3])}), EU settings locked again')
    strict_record('setup_eu_locked', reasons[0])
    _event('setup_eu_locked', 'warning', reason=reasons[0])
    _admin_notify('eFa-next: EU settings locked again', 'An EU link arose: ' + ', '.join(reasons) + '.\nThe EU rules apply again (Security, Setup variant).')
    return reasons


def eu_hard():
    """With an EU link from the setup or Re-Setup the EU rules apply hard: no typed transfer outside the EU."""
    return _lib('efa_setup').eu_locked(setup_variant_state())


def _setup_notices():
    """The yellow note without EU link, the offer of Re-Setup after an update or migration."""
    state, found = setup_variant_state(), []
    if state.get('eulink') == 'no':
        found.append(_text('No EU link confirmed in the setup: settings outside the EU rules are possible. A new EU link locks them again '
                           '(Security, Setup variant).'))
    if state.get('locked'):
        found.append(_text('EU settings locked again: {reason}. Check the settings (Security, Setup variant).', reason=state['locked']))
    if not state and not os.path.exists(SETUP_OFFER_DISMISSED) and os.path.exists(EFA_CONFIG):
        found.append(_text('New in this version: Re-Setup asks for the EU link and the frameworks and raises the settings to match, never '
                           'lower (Security, Setup variant).'))
    return found


def _console_key(user):
    """The 2FA of a console admin (SSH) is its own, never the one of the main admin: sealed under this name."""
    return '@console:' + user


# The 2FA of a console admin lives in a file of root, not in the database: SSH must work when MariaDB is the thing to repair.
CONSOLE_2FA_DIR = ETC + '/eFa/console-2fa'


def _console_row(user):
    """{secret, active, last_step, recovery} of the own 2FA of a console admin, None when none is set up. A file that cannot be
    read is an error: the login then fails closed (the local console still works)."""
    path = f'{CONSOLE_2FA_DIR}/{user}.json'
    if not os.path.exists(path):
        return None
    try:
        with open(path) as f:
            row = json.load(f)
        assert isinstance(row, dict) and isinstance(row.get('secret'), str) and isinstance(row.get('recovery', []), list)
    except (OSError, ValueError, AssertionError):
        raise EfaError(f'The 2FA file of {user} cannot be read: log in on the local console.')
    return row


def _console_store(user, row):
    """Writes the 2FA of a console admin (0600, root), or removes it with None."""
    path = f'{CONSOLE_2FA_DIR}/{user}.json'
    if row is None:
        if os.path.exists(path):
            os.remove(path)
        return
    os.makedirs(CONSOLE_2FA_DIR, mode=0o700, exist_ok=True)
    fd = os.open(path + '.new', os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, 'w') as f:
        json.dump(row, f)
    os.replace(path + '.new', path)


def _console_check(user, code):
    """The code (or a recovery code) of the own 2FA of a console admin; raises on a wrong one. Only the file, no database."""
    row, account = _console_row(user), _console_key(user)
    step = totp_step(totp_open(row['secret'], account), code, int(row.get('last_step', 0))) if code else None
    if step is not None:
        _console_store(user, {**row, 'last_step': step})
        return
    if code and recovery_hash(code) in row.get('recovery', []):
        _console_store(user, {**row, 'recovery': [item for item in row['recovery'] if item != recovery_hash(code)]})
        _audit(f'recovery code used by the console admin {user}, {len(row["recovery"]) - 1} left')
        return
    raise EfaError('Wrong 2FA code.')


def totp_import(args):
    """The setup wizard set up the 2FA of the main admin (and with console_user the own one of the console admin) before the
    database was there: secret, last step and the hashes of the ten recovery codes come on stdin, one per line. Only from the
    setup (efa-apply)."""
    if identity_now is not None or os.environ.get('SUDO_USER') == 'efa-web':
        raise EfaError('Only the setup sets this.')
    console = (getattr(args, 'console_user', '') or '').strip()
    if console and not re.fullmatch(r'[a-z_][a-z0-9_-]{0,31}', console):
        raise EfaError('Console admin: not a valid user name.')
    account = _console_key(console) if console else '@admin'
    text, step, hashes = (line.strip() for line in _secrets(3, 'Secret, step, recovery hashes'))
    lib = _lib('efa_totp')
    try:
        secret = lib.secret_from_text(text)
    except ValueError:
        secret = b''
    hashes = [item for item in hashes.split(',') if re.fullmatch(r'[0-9a-f]{64}', item)]
    if len(secret) != 20 or not step.isdigit() or len(hashes) != 10:
        raise EfaError(f'2FA of {account}: secret, step or recovery codes invalid.')
    if console:
        _console_store(console, {'secret': totp_seal(secret, account), 'active': True, 'last_step': int(step), 'recovery': hashes})
    else:
        _admin_query('REPLACE INTO user_totp (username, secret, active, last_step, recovery) VALUES (%s, %s, 1, %s, %s)',
                     (account, totp_seal(secret, account), int(step), json.dumps(hashes)))
    _audit(f'2FA of {account} set up in the setup wizard')
    return {'active': True, 'account': account}


def _cli_user():
    for line in _read_lines(EFA_CONFIG):
        if line.startswith('CLIUSERNAME:'):
            return line.split(':', 1)[1].strip()
    return ''


def _console_2fa(on, user=None):
    """The login shell of the console admin of the setup asks over SSH for the code of its own 2FA, when it has one set up
    (none set up: none asked, owner's rule). No forwarding without a shell, so ssh -N cannot pass the question. The local
    console (tty) needs no code (Text F)."""
    user = user or _cli_user()
    if not re.fullmatch(r'[a-z_][a-z0-9_-]{0,31}', user):
        return None
    if on:
        # The login shell asks for the code, or sets up the first 2FA (only while none is active: console-2fa-enroll --first yes).
        sudoers = f'{user} ALL=(root) NOPASSWD: /usr/sbin/efactl console-2fa-verify, /usr/sbin/efactl console-2fa-enroll\n'
        fd = os.open(CONSOLE_SUDOERS + '.new', os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o440)
        with os.fdopen(fd, 'w') as f:
            f.write(sudoers)
        if subprocess.run(['visudo', '-cqf', CONSOLE_SUDOERS + '.new'], capture_output=True).returncode != 0:
            os.remove(CONSOLE_SUDOERS + '.new')
            raise EfaError('visudo refused the rule for the console 2FA, nothing was changed.')
        os.replace(CONSOLE_SUDOERS + '.new', CONSOLE_SUDOERS)
        _write(CONSOLE_SSHD, f'# eFa-next: the console admin with 2FA (efa-console-2fa); no tunnels that bypass the login shell.\n'
                             f'Match User {user}\n    AllowTcpForwarding no\n    AllowStreamLocalForwarding no\n    AllowAgentForwarding no\n'
                             f'    X11Forwarding no\n    PermitTunnel no\nMatch all\n')
        try:
            _sshd_apply()
        except EfaError:
            os.remove(CONSOLE_SSHD)
            os.remove(CONSOLE_SUDOERS)
            raise
        subprocess.run(['usermod', '-s', CONSOLE_GATE, user], check=True, capture_output=True)
    else:
        subprocess.run(['usermod', '-s', '/bin/bash', user], check=True, capture_output=True)
        for path in (CONSOLE_SSHD, CONSOLE_SUDOERS):
            if os.path.exists(path):
                os.remove(path)
        _sshd_apply()
    _audit(f'console 2FA of {user} {"on" if on else "off"} by {_dmarc_who()}')
    return user


def console_2fa_set(args):
    """The 2FA of the console admin (SSH): on or off. In the guided setup it stays on."""
    on = _on_off(args.mode)
    if identity_now is not None:
        raise EfaError('The console 2FA is set on the console.')
    if not on and setup_guided():
        raise EfaError('Guided setup: the console 2FA stays on.')
    if not on and admin_2fa_due():
        raise EfaError('2FA is required for every admin: the console 2FA stays on.')
    return {'user': _console_2fa(on), 'console_2fa': on}


def console_2fa_verify(args):
    """The login shell of a console admin asks here, for the user sudo names (SUDO_USER, not given by the caller): with check
    only whether that user has an own 2FA; without, its code (or a recovery code). No 2FA set up: no code asked, the login is
    noted. Five wrong codes lock that user for 15 minutes. Never the code of another user."""
    who = os.environ.get('SUDO_USER', '')
    if not re.fullmatch(r'[a-z_][a-z0-9_-]{0,31}', who) or who == 'root':
        raise EfaError('Only the login shell of a console admin asks here.')
    active = bool((_console_row(who) or {}).get('active'))
    enroll = not active and admin_2fa_due()
    if (getattr(args, 'check', '') or '') == 'yes':
        if not active:
            _audit(f'console login of {who} without 2FA ({"set up now" if enroll else "not set up"})')
        return {'needed': active, 'enroll': enroll}
    if enroll:
        raise EfaError('2FA is required for every admin: set it up first (the login shell asks for it).')
    if not active:
        _audit(f'console login of {who} without 2FA (not set up)')
        return {'ok': True}
    state = _json_read(CONSOLE_FAILS, {}).get('fails', {})
    state = state if isinstance(state, dict) else {}
    fails = [stamp for stamp in state.get(who, []) if time.time() - stamp < CONSOLE_LOCK_SECONDS]
    if len(fails) >= CONSOLE_MAX_FAILS:
        raise EfaError('Too many wrong 2FA codes: wait 15 minutes, or log in on the local console.')
    code = _secrets(1, '2FA code')[0].strip()
    try:
        _console_check(who, code)
    except EfaError:
        _json_write(CONSOLE_FAILS, {'fails': {**state, who: fails + [time.time()]}})
        _audit(f'console login of {who}: wrong 2FA code')
        _event('console_2fa_failed', 'warning', user=who)
        raise
    if fails:
        _json_write(CONSOLE_FAILS, {'fails': {**state, who: []}})
    _audit(f'console login of {who} with 2FA')
    return {'ok': True}


def console_2fa_enroll(args):
    """The own 2FA of a console admin, on the console only: without code a new secret (an app entry user@host) that counts after
    the first code; with code the confirmation and ten recovery codes, shown once. sudo by the console admin sets its own, root
    the one of the console admin of the setup."""
    if identity_now is not None or os.environ.get('SUDO_USER') == 'efa-web':
        raise EfaError('The 2FA of a console admin is set on the console: sudo efactl console-2fa-enroll.')
    user = os.environ.get('SUDO_USER') or _cli_user()
    if user == 'root' or not re.fullmatch(r'[a-z_][a-z0-9_-]{0,31}', user or ''):
        raise EfaError('No console admin: set CLIUSERNAME, or run it with sudo as the console admin.')
    account, lib, code = _console_key(user), _lib('efa_totp'), (getattr(args, 'code', '') or '').strip()
    if (getattr(args, 'first', '') or '') == 'yes' and (_console_row(user) or {}).get('active'):
        # The login shell sets up the first 2FA only: an active one is changed on the console, after its own code.
        raise EfaError('A 2FA is set up already.')
    if not code:
        secret = os.urandom(20)
        _console_store(user, {'secret': totp_seal(secret, account), 'active': False, 'last_step': 0, 'recovery': []})
        return {'user': user, 'uri': lib.uri(secret, f'{user}@{own_hostname()}'), 'secret': lib.grouped(secret),
                'next': 'Add it to the app (the link as QR code, or the secret by hand), then: efactl console-2fa-enroll --code NNNNNN'}
    row = _console_row(user)
    if not row or row['active']:
        raise EfaError('Start with efactl console-2fa-enroll (without a code) first.')
    step = totp_step(totp_open(row['secret'], account), code, 0)
    if step is None:
        raise EfaError('Wrong code: check the time of the phone and the server, then try the next code.')
    codes = lib.recovery_codes()
    _console_store(user, {**row, 'active': True, 'last_step': step, 'recovery': [recovery_hash(item) for item in codes]})
    _audit(f'own 2FA of the console admin {user} set up')
    return {'user': user, 'active': True, 'recovery_codes': codes, 'note': 'Keep these codes safe, each works once. They are not shown again.'}


def main_admin_2fa_lost(lines, active):
    """S38: the main admin switched 2FA on (audit) and never off or reset, but has none now: the time it went on, else None."""
    on = None
    for line in lines:
        if '2FA switched on by @admin' in line or '2FA of @admin set up in the setup wizard' in line:
            on = line[:19]
        elif '2FA switched off by @admin' in line or '2FA of @admin reset' in line:
            on = None
    return None if active else on


DEV_NO_SETUP_CODE = ETC + '/eFa/dev-no-setup-code'


def dev_flag_banner():
    """Red on the dashboard while the dev flag of efa-init is there and the host is not set to development: a flagged host
    that claims production or test, or a flag that does not count (wrong owner, mode, a symlink). Set to development the
    header mark is enough (Hans 2026-11-17)."""
    if not os.path.lexists(DEV_NO_SETUP_CODE):
        return []
    # The flag this function looks at, not the default path of efa_setup (a self-test, a test root).
    if _safe(lambda: environment_status()['set'], '') == 'dev' and _lib('efa_setup').dev_flag_problem(DEV_NO_SETUP_CODE) is None:
        return []
    return [_text('{path} exists: the setup wizard opens without the setup code (dev mode, not for production). '
                  'Remove the file on a production host.', path=DEV_NO_SETUP_CODE)]


def totp_banner():
    """Red on the dashboard: the guided setup asks for 2FA, and a main or console admin has none (a reset, or a host of before)."""
    start = admin_2fa_from()
    if not admin_2fa_exempt() and datetime.date.today() < start:
        return [_text('From {date} every admin needs 2FA (TOTP or a passkey): an admin without one sets it up right after the password '
                      'at the next login, the console admin at the next SSH login. Set it up now under My account.', date=start.isoformat())]
    active = (_safe(lambda: _totp_row('@admin'), None) or {}).get('active')
    lost = _safe(lambda: main_admin_2fa_lost(_read_lines(AUDIT_LOG), active), None)
    found = [_text('The 2FA of the main admin (login admin) was switched on ({date}) and is gone without being switched off or reset: '
                   'the login takes the password alone. Set it up again under My account and check the audit log.', date=lost)] if lost else []
    if not setup_guided():
        return found
    # Owner, 2026-11-12: "I have 2FA and still the message". Two different accounts: the main admin of the web interface (login
    # admin) and the console admin of the setup (an SSH login, its own 2FA). Each line names exactly which one has none.
    if not active:
        found.append(_text('The main admin of the web interface (login admin) has no active 2FA (the guided setup asks for it). '
                           'Logged in as admin: My account, Two-factor login (2FA), Set up.'))
    console = _cli_user()
    if console and not (_safe(lambda: _console_row(console), None) or {}).get('active'):
        found.append(_text('The console admin {user} (the SSH login of the setup, not the web interface) has no 2FA of its own '
                           '(the guided setup asks for it). On the console: sudo efactl console-2fa-enroll.', user=console))
    return found

# 5s: passkeys and security keys. Per role off, as second factor, or as second factor or alone (passwordless, with user
# verification). The relying party is one host name of this server with a certificate a browser trusts (Let's Encrypt or an
# own CA); a self-signed certificate keeps passkeys off. Challenges are random, used once, valid for two minutes.
PASSKEY_FILE = ETC + '/eFa/passkeys.json'
PASSKEY_CHALLENGES = '/var/lib/eFa/webauthn-challenges.json'
PASSKEY_MODES = ('off', 'second', 'passwordless')
PASSKEY_SECONDS = 120


def passkey_settings():
    return {'rp_id': '', 'policy': {}, **_json_read(PASSKEY_FILE, {})}


def _challenge_store(key, value=None, take=False):
    """Keeps, or takes once, the challenge under key; old ones go."""
    os.makedirs(os.path.dirname(PASSKEY_CHALLENGES), exist_ok=True)
    fd = os.open(PASSKEY_CHALLENGES, os.O_RDWR | os.O_CREAT, 0o600)
    with os.fdopen(fd, 'r+') as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        try:
            items = json.loads(f.read() or '{}')
        except ValueError:
            items = {}
        now = time.time()
        items = {k: v for k, v in items.items() if v[1] > now}
        found = items.pop(key, None) if take else None
        if value is not None:
            items[key] = [value, now + PASSKEY_SECONDS]
        f.seek(0)
        f.truncate()
        f.write(json.dumps(items))
    return base64.b64decode(found[0]) if found else None


def cert_valid_from(cert):
    """notBefore, timezone-aware: *_utc from cryptography 42 on (the naive one warns there), the naive one before (EL9)."""
    return getattr(cert, 'not_valid_before_utc', None) or cert.not_valid_before.replace(tzinfo=datetime.timezone.utc)


def cert_valid_until(cert):
    """notAfter, timezone-aware, as cert_valid_from."""
    return getattr(cert, 'not_valid_after_utc', None) or cert.not_valid_after.replace(tzinfo=datetime.timezone.utc)


def certificate_for(rp_id, pem):
    """'' when the certificate is not self-signed, valid now and names rp_id, else why not."""
    from cryptography import x509
    cert = x509.load_pem_x509_certificate(pem)
    rp_id = rp_id.lower()
    if cert.issuer == cert.subject:
        return 'the certificate is self-signed: passkeys need Let\'s Encrypt or a certificate of a CA the browsers of the admins trust'
    if not cert_valid_from(cert) <= datetime.datetime.now(datetime.timezone.utc) <= cert_valid_until(cert):
        return 'the certificate is not valid now'
    try:
        names = cert.extensions.get_extension_for_class(x509.SubjectAlternativeName).value.get_values_for_type(x509.DNSName)
    except x509.ExtensionNotFound:
        names = []
    if not any(name.lower() == rp_id or (name.startswith('*.') and rp_id.split('.', 1)[-1] == name[2:].lower()) for name in names):
        return f'the certificate does not name {rp_id}'
    return ''


def _passkey_rp():
    rp_id = passkey_settings()['rp_id']
    if not rp_id:
        raise EfaError('Passkeys are off: a super admin chooses the host name first (passkey-set).')
    return rp_id, f'https://{rp_id}'


def _passkey_mode(role):
    return passkey_settings()['policy'].get(role or 'super', 'off')


def passkey_status(_args):
    """Passkeys: the host name, the mode per role, and the own keys."""
    state = passkey_settings()
    username = _totp_self()
    rows = _safe(lambda: _admin_query('SELECT id, name, alg, aaguid, CAST(created AS CHAR) AS created, CAST(last_used AS CHAR) AS last_used '
                                      'FROM user_passkeys WHERE username = %s ORDER BY id', (username,)), [])
    return {'rp_id': state['rp_id'] or 'off', 'policy': state['policy'], 'my_keys': rows,
            'my_mode': _passkey_mode((identity_now or {}).get('role'))}


def passkey_set(args):
    """The host name of the passkeys and their mode for one role. Only a super admin; the host name needs a trusted certificate."""
    if identity_now and identity_now.get('role') != 'super':
        raise EfaError('Only a super admin sets passkeys.')
    state = passkey_settings()
    rp_id = (args.rp_id or '').strip().lower()
    if rp_id:
        if rp_id not in passkey_hosts():
            raise EfaError('Host name: one of ' + ', '.join(passkey_hosts()))
        with open(_postconf('smtpd_tls_cert_file'), 'rb') as f:
            problem = certificate_for(rp_id, f.read())
        if problem:
            raise EfaError(f'Passkeys stay off: {problem}.')
        state['rp_id'] = rp_id
    role, mode = (args.role or '').strip(), (args.mode or '').strip()
    if role or mode:
        if role not in TOTP_ROLES or mode not in PASSKEY_MODES:
            raise EfaError('Role: ' + ', '.join(TOTP_ROLES) + '; mode off, second or passwordless.')
        if mode != 'off' and not state['rp_id']:
            raise EfaError('Choose the host name first.')
        state['policy'][role] = mode
    _json_write(PASSKEY_FILE, state, mode=0o644)
    _audit(f'passkeys set to {state} by {_dmarc_who()}')
    return passkey_status(None)


def passkey_hosts():
    """The host names a passkey can belong to: the name of the server and the names of its certificate."""
    names = {_postconf('myhostname').lower()}
    try:
        from cryptography import x509
        with open(_postconf('smtpd_tls_cert_file'), 'rb') as f:
            cert = x509.load_pem_x509_certificate(f.read())
        names |= {name.lower() for name in cert.extensions.get_extension_for_class(x509.SubjectAlternativeName).value.get_values_for_type(x509.DNSName)
                  if not name.startswith('*.')}
    except (OSError, ValueError, Exception):  # noqa: B014 - no certificate or no SAN: only the host name
        pass
    return sorted(name for name in names if DOMAIN_RE.match(name))


def passkey_register_options(_args):
    """What the browser needs to make a new passkey for the own login."""
    rp_id, _origin = _passkey_rp()
    username = _totp_self()
    if username == '@admin':
        raise EfaError('The main admin of the console uses password and TOTP; passkeys are for named users.')
    challenge = os.urandom(32)
    _challenge_store('reg:' + username, base64.b64encode(challenge).decode())
    wa = _lib('efa_webauthn')
    known = _admin_query('SELECT cred_id FROM user_passkeys WHERE username = %s', (username,))
    return {'publicKey': {'challenge': wa.b64url(challenge), 'rp': {'id': rp_id, 'name': 'eFa-next'},
                          'user': {'id': wa.b64url(hashlib.sha256(username.encode()).digest()[:16]), 'name': username, 'displayName': username},
                          'pubKeyCredParams': [{'type': 'public-key', 'alg': alg} for alg in (-7, -8, -257)], 'timeout': PASSKEY_SECONDS * 1000,
                          'attestation': 'none', 'authenticatorSelection': {'residentKey': 'preferred', 'userVerification': 'preferred'},
                          'excludeCredentials': [{'type': 'public-key', 'id': row['cred_id']} for row in known]}}


def passkey_register(args):
    """Stores a new passkey of the own login after the browser made it; more than one per login, each with a name."""
    rp_id, origin = _passkey_rp()
    username = _totp_self()
    challenge = _challenge_store('reg:' + username, take=True)
    if not challenge:
        raise EfaError('The request is too old: start again.')
    name = ' '.join((args.name or '').split())[:60] or 'passkey'
    wa = _lib('efa_webauthn')
    try:
        cred_id, alg, pem, count, aaguid = wa.verify_registration(args.attestation or '', args.client_data or '', challenge, rp_id, origin)
    except wa.Invalid as err:
        raise EfaError(f'Passkey not taken: {err}.')
    _admin_query('INSERT INTO user_passkeys (username, cred_id, alg, pem, sign_count, name, aaguid) VALUES (%s, %s, %s, %s, %s, %s, %s)',
                 (username, wa.b64url(cred_id), alg, pem, count, name, aaguid))
    _audit(f'passkey "{name}" added by {username}')
    return passkey_status(None)


def passkey_remove(args):
    """Removes one of the own passkeys."""
    _admin_query('DELETE FROM user_passkeys WHERE id = %s AND username = %s', (str(args.id or '').strip(), _totp_self()))
    _audit(f'passkey {args.id} removed by {_totp_self()}')
    return passkey_status(None)


def passkey_reset(args):
    """An admin removes all passkeys of a user (lost key); the user adds new ones after a login with password and TOTP or recovery code."""
    username = (args.username or '').strip()
    if username == _totp_self() or username not in {row['username'] for row in _users_in_scope(_actor_scope('users.manage'))}:
        raise EfaError('Unknown user, or your own.')
    _admin_query('DELETE FROM user_passkeys WHERE username = %s', (username,))
    _audit(f'passkeys of {username} reset by {_dmarc_who()}')
    strict_record('passkey_reset', username)
    return {'reset': username}


def passkey_login_options(args):
    """Before a login: a challenge and, for a named user, the ids of their keys. The handle names the challenge."""
    rp_id, _origin = _passkey_rp()
    username = (args.username or '').strip()
    challenge, handle = os.urandom(32), secrets.token_urlsafe(18)
    _challenge_store('login:' + handle, base64.b64encode(challenge).decode())
    wa = _lib('efa_webauthn')
    allowed = _admin_query('SELECT cred_id FROM user_passkeys WHERE username = %s', (username,)) if username else []
    return {'handle': handle, 'publicKey': {'challenge': wa.b64url(challenge), 'rpId': rp_id, 'timeout': PASSKEY_SECONDS * 1000,
                                            'userVerification': 'preferred' if username else 'required',
                                            'allowCredentials': [{'type': 'public-key', 'id': row['cred_id']} for row in allowed]}}


def passkey_check(assertion, username=None, need_uv=False):
    """The login of an assertion (JSON from the browser): the user name, or EfaError. With username only a key of that user counts."""
    rp_id, origin = _passkey_rp()
    wa = _lib('efa_webauthn')
    try:
        data = json.loads(assertion)
        challenge = _challenge_store('login:' + str(data['handle'])[:40], take=True)
        rows = _admin_query('SELECT id, username, alg, pem, sign_count FROM user_passkeys WHERE cred_id = %s', (str(data['id'])[:1400],))
    except (ValueError, KeyError, TypeError):
        raise EfaError('Passkey login not readable.')
    if not challenge or not rows or (username and rows[0]['username'] != username):
        raise EfaError('Passkey not accepted.')
    row = rows[0]
    try:
        count = wa.verify_assertion(data['client_data'], data['auth_data'], data['signature'], row['pem'], row['alg'], int(row['sign_count']),
                                    challenge, rp_id, origin, need_uv=need_uv)
    except (wa.Invalid, KeyError):
        raise EfaError('Passkey not accepted.')
    _admin_query('UPDATE user_passkeys SET sign_count = %s, last_used = NOW() WHERE id = %s', (count, row['id']))
    return row['username']


def passkey_login(_args):
    """A login with a passkey alone (passwordless), when the role of the user allows it; user verification is required."""
    username = passkey_check(_secrets(1, 'Passkey')[0], need_uv=True)
    found = {key: value for key, value in _load_identity(username).items() if key in ('username', 'role')}
    if _passkey_mode(found.get('role')) != 'passwordless':
        raise EfaError('Your role logs in with password and second factor.')
    if _admin_query('SELECT disabled FROM users WHERE username = %s', (username,))[0]['disabled']:
        raise EfaError('This user is disabled.')
    _admin_query('UPDATE users SET last_login = NOW() WHERE username = %s', (username,))
    return found

def mapped_memberships(directory_groups, mapping, groups):
    """The eFa-next groups of a directory login: one per mapped directory group. No mapped group means no login."""
    names = {group.lower() for group in directory_groups}
    return [{'group_id': row['group_id'], 'group': groups[row['group_id']], 'tenant_id': row['tenant_id'], 'domain': row['domain']}
            for row in mapping if row['group_name'] in names and row['group_id'] in groups]


def tenant_admin_grants(tenant_id, tenant_domains):
    """The most a tenant can hand out: what its tenant admin holds."""
    return grants_of([{'group': {**BUILTIN_GROUPS['tenant'], 'scope': 'member'}, 'tenant_id': tenant_id, 'domain': None}], tenant_domains)


def _bound_username(username, external, query=None):
    """The account of an OIDC login: the one bound to its issuer and subject; else the name it sends, unless that name is
    bound to another subject. An account of 6.0.0.5 and older (no binding yet) is bound on its next login."""
    query = query or _admin_query
    bound = query('SELECT username FROM users WHERE external_id = %s', (external,))
    if bound:
        return bound[0]['username']
    other = query('SELECT external_id FROM users WHERE username = %s', (username,))
    if other and other[0]['external_id']:
        raise EfaError('This user name belongs to another login of the provider.')
    return username


def _external_login(username, directory_groups, source, tenant=None, external=None):
    """An OIDC or LDAP login: its groups decide the eFa-next groups on each login, so a change in the directory takes effect.
    The directory of a tenant only maps its own groups, and never beyond the tenant. external: issuer and subject of an OIDC
    login; the account bound to it is the one used, whatever name the provider sends now."""
    if external:
        username = _bound_username(username, external)
    if not USER_RE.match(username):
        raise EfaError('Wrong user name or password.')
    memberships = mapped_memberships(directory_groups, _admin_query('SELECT group_name, group_id, tenant_id, domain FROM group_roles WHERE idp_tenant = %s',
                                                                     (tenant or 0,)), _groups())
    if tenant is not None:
        tenant_domains = _tenant_domains()
        most = tenant_admin_grants(tenant, tenant_domains)
        memberships = [member for member in memberships if grants_cover(most, grants_of([member], tenant_domains))]
    if not memberships:
        raise EfaError('Your login is valid, but none of your groups has a group here.')
    current = _admin_query('SELECT source, disabled FROM users WHERE username = %s', (username,))
    if current and current[0]['source'] != source:
        raise EfaError('This user name belongs to another kind of login.')
    if current and current[0]['disabled']:
        raise EfaError('This user is disabled.')
    first = next((member['group']['builtin'] for member in memberships if member['group'].get('builtin')), 'custom')
    _admin_query('INSERT INTO users (username, role, source, last_login, groups_migrated, external_id) VALUES (%s, %s, %s, NOW(), 1, %s) '
                 'ON DUPLICATE KEY UPDATE role = VALUES(role), last_login = NOW(), external_id = COALESCE(external_id, VALUES(external_id))',
                 (username, first, source, external or None))
    _set_memberships(username, memberships)
    return {'username': username, 'role': _load_identity(username)['role']}


def group_list(_args):
    """The predefined and the own groups, their permissions, scope and members."""
    names = {row['id']: row['name'] for row in _admin_query('SELECT id, name FROM tenants')}
    counts = {row['group_id']: row['n'] for row in _admin_query('SELECT group_id, COUNT(*) AS n FROM user_groups GROUP BY group_id')}
    found = []
    for group in sorted(_groups().values(), key=lambda item: (item['builtin'] is None, item['name'])):
        scope = 'per member: tenant or domain' if group['scope'] == 'member' else group['scope']
        if group['scope'] in ('tenants', 'domains'):
            scope += ': ' + ', '.join(sorted([names.get(item, str(item)) for item in group['scope_tenants']] + sorted(group['scope_domains'])))
        found.append({'name': group['name'], 'description': group['description'], 'predefined': group['builtin'] is not None, 'disabled': bool(group['disabled']),
                      'permissions': sorted(group['permissions'] | group['global_extra']), 'scope': scope, 'members': counts.get(group['id'], 0)})
    return {'groups': found}


def group_spec(args, base, tenant_ids, tenant_domains):
    """The new state of an own group from the arguments, on top of base. Checks names, permissions and scope."""
    spec = {'permissions': set(base['permissions']), 'scope': base['scope'] if base['scope'] != 'member' else 'global',
            'scope_tenants': set(base['scope_tenants']), 'scope_domains': set(base['scope_domains']), 'description': base['description'], 'disabled': 0}
    if (args.description or '').strip():
        spec['description'] = args.description.strip()[:255]
    if (args.permissions or '').strip():
        spec['permissions'] = set(re.split(r'[\s,]+', args.permissions.strip()))
    unknown = spec['permissions'] - set(PERMISSIONS)
    if unknown:
        raise EfaError('Unknown permissions: ' + ', '.join(sorted(unknown)))
    if (args.scope or '').strip():
        spec['scope'] = args.scope.strip()
        values = [item.strip() for item in (args.scope_values or '').split(',') if item.strip()]
        spec['scope_tenants'], spec['scope_domains'] = set(), set()
        if spec['scope'] == 'tenants':
            for value in values:
                if value not in tenant_ids:
                    raise EfaError(f'Unknown tenant: {value}')
                spec['scope_tenants'].add(tenant_ids[value])
        elif spec['scope'] == 'domains':
            for value in values:
                if not DOMAIN_RE.match(value.lower()):
                    raise EfaError(f'Invalid domain: {value}')
                spec['scope_domains'].add(value.lower())
    if spec['scope'] not in GROUP_SCOPES:
        raise EfaError('Scope: global, tenants or domains.')
    if spec['scope'] != 'global' and not (spec['scope_tenants'] or spec['scope_domains']):
        raise EfaError('Name the tenants or domains of the scope.')
    held = spec['permissions'] & GLOBAL_PERMISSIONS
    if spec['scope'] != 'global' and held:
        raise EfaError('Only a global group can hold: ' + ', '.join(sorted(held)))
    return spec


def _group_grants(group, tenant_domains):
    return grants_of([{'group': group, 'tenant_id': None, 'domain': None}], tenant_domains)


def _check_own_access(group_id, new_group, tenant_domains):
    """Self-lockout: whoever changes a group of their own keeps the right to manage users and groups."""
    if identity_now is None:
        return
    after = [{**member, 'group': new_group} if member['group']['id'] == group_id else member for member in identity_now['memberships']]
    after = [member for member in after if member['group'] is not None]
    kept = grants_of(after, tenant_domains)
    for permission in ('users.manage', 'groups.manage'):
        if permission in identity_now['grants'] and permission not in kept:
            raise EfaError(f'Refused: you would lose {permission} yourself.')


def group_set(args):
    """Add or change an own group. --copy_from takes permissions and scope of another group, a predefined one too."""
    name = args.name.strip()
    if not TENANT_RE.match(name):
        raise EfaError('Group name: letters, digits, space . _ -, up to 100.')
    groups, tenant_domains = _groups(), _tenant_domains()
    tenant_ids = {row['name']: row['id'] for row in _admin_query('SELECT id, name FROM tenants')}
    existing = next((group for group in groups.values() if group['name'].lower() == name.lower()), None)
    if existing and existing['builtin']:
        raise EfaError('Predefined groups cannot be changed. Copy one with --copy_from and change the copy.')
    if (args.copy_from or '').strip():
        base = _group_by_name(args.copy_from, groups)
        if base['scope'] == 'member' and (args.scope or 'global').strip() == 'global':
            # A global copy of the helpdesk reads the whole system, as its members without tenant do.
            base = {**base, 'permissions': base['permissions'] | base['global_extra']}
    else:
        base = existing or {'permissions': set(), 'scope': 'global', 'scope_tenants': set(), 'scope_domains': set(), 'description': ''}
    spec = group_spec(args, base, tenant_ids, tenant_domains)
    have = _actor_grants()
    if not grants_cover(have, _group_grants(spec, tenant_domains)) or (existing and not grants_cover(have, _group_grants(existing, tenant_domains))):
        raise EfaError('Not allowed: this needs permissions or a scope you do not have.')
    if existing:
        _check_own_access(existing['id'], {**existing, **spec}, tenant_domains)
    values = (spec['description'], ' '.join(sorted(spec['permissions'])), spec['scope'], ','.join(str(item) for item in sorted(spec['scope_tenants'])),
              ','.join(sorted(spec['scope_domains'])))
    if existing:
        _admin_query('UPDATE efa_groups SET description = %s, permissions = %s, scope = %s, scope_tenants = %s, scope_domains = %s WHERE id = %s',
                     (*values, existing['id']))
    else:
        _admin_query('INSERT INTO efa_groups (name, description, permissions, scope, scope_tenants, scope_domains) VALUES (%s, %s, %s, %s, %s, %s)',
                     (name, *values))
    return group_list(None)


def _own_group(args):
    group = _group_by_name(args.name, _groups())
    if group['builtin']:
        raise EfaError('Predefined groups cannot be changed or removed.')
    if not grants_cover(_actor_grants(), _group_grants(group, _tenant_domains())):
        raise EfaError('Not allowed: this needs permissions or a scope you do not have.')
    return group


def group_state(args):
    """Disable an own group, or enable it again. Its members lose its permissions while it is off."""
    group, enabled = _own_group(args), _on_off(args.mode)
    if not enabled:
        _check_own_access(group['id'], {**group, 'disabled': 1}, _tenant_domains())
    _admin_query('UPDATE efa_groups SET disabled = %s WHERE id = %s', (int(not enabled), group['id']))
    return group_list(None)


def group_remove(args):
    """Remove an own group. Its members and directory mappings lose it."""
    _confirm(args)
    group = _own_group(args)
    _check_own_access(group['id'], None, _tenant_domains())
    _admin_query('DELETE FROM user_groups WHERE group_id = %s', (group['id'],))
    _admin_query('DELETE FROM group_roles WHERE group_id = %s', (group['id'],))
    _admin_query('DELETE FROM efa_groups WHERE id = %s', (group['id'],))
    return group_list(None)


def group_map_list(_args, idp_tenant=0):
    """Which group of the directory gets which eFa-next group."""
    return {'groups': _admin_query('SELECT r.group_name, g.name AS efa_group, t.name AS tenant, r.domain FROM group_roles r '
                                   'LEFT JOIN efa_groups g ON g.id = r.group_id LEFT JOIN tenants t ON t.id = r.tenant_id WHERE r.idp_tenant = %s '
                                   'ORDER BY r.group_name', (idp_tenant,))}


def group_map_set(args, idp_tenant=0):
    """Give a group from OIDC or LDAP an eFa-next group, or remove it. For LDAP the full DN or the CN."""
    directory_group, action = args.group.strip().lower(), args.action.strip()
    if not directory_group or len(directory_group) > 255:
        raise EfaError('Group: 1 to 255 characters.')
    if action == 'remove':
        _admin_query('DELETE FROM group_roles WHERE group_name = %s AND idp_tenant = %s', (directory_group, idp_tenant))
        return group_map_list(None, idp_tenant)
    if action != 'set':
        raise EfaError("Action must be 'set' or 'remove'.")
    name = (args.efa_group or '').strip()
    role = (args.role or '').strip()
    if not name and role:
        if role not in ROLES:
            raise EfaError('Role must be one of: ' + ', '.join(ROLES))
        name = BUILTIN_GROUPS[role]['name']
    domain = (args.domain or '').strip().lower()
    tenant = _tenant_id(args.tenant.strip()) if (args.tenant or '').strip() else None
    if domain and not DOMAIN_RE.match(domain):
        raise EfaError('Invalid domain.')
    groups, tenant_domains = _groups(), _tenant_domains()
    if idp_tenant:
        # The tenant argument names the directory here; a domain narrows the group to that domain of the tenant.
        tenant = None if domain else idp_tenant
        if domain and domain not in tenant_domains.get(idp_tenant, ()):
            raise EfaError('This domain does not belong to the tenant.')
    elif domain and tenant is not None and domain not in tenant_domains.get(tenant, ()):
        raise EfaError('This domain does not belong to the tenant.')
    member = wanted_memberships([name], tenant, domain, groups)[0] if name else None
    if member is None:
        raise EfaError('Name the eFa-next group.')
    if not grants_cover(_actor_grants(), grants_of([member], tenant_domains)):
        raise EfaError('Not allowed: this needs permissions or a scope you do not have.')
    if idp_tenant and not grants_cover(tenant_admin_grants(idp_tenant, tenant_domains), grants_of([member], tenant_domains)):
        raise EfaError('The directory of a tenant can only give groups inside the tenant.')
    _admin_query('REPLACE INTO group_roles (group_name, role, group_id, tenant_id, domain, idp_tenant) VALUES (%s, %s, %s, %s, %s, %s)',
                 (directory_group, member['group'].get('builtin') or 'custom', member['group_id'], member['tenant_id'], member['domain'], idp_tenant))
    return group_map_list(None, idp_tenant)


def ldap_filter_escape(text):
    """RFC 4515: a user name must not change the search."""
    return ''.join(f'\\{ord(ch):02x}' if ch in '*()\\\0' else ch for ch in text)


def ldif_entries(text):
    """(dn, values of memberOf) of each entry in the output of ldapsearch -LLL. Long lines are folded, values can be base64."""
    entries = []
    for block in re.sub(r'\r?\n ', '', text).split('\n\n'):
        dn, groups = None, []
        for line in block.splitlines():
            name, separator, value = line.partition(':')
            if not separator:
                continue
            if value.startswith(':'):
                value = base64.b64decode(value[1:].strip()).decode('utf-8', 'replace')
            value = value.strip()
            if name.lower() == 'dn':
                dn = value
            elif name.lower() == 'memberof':
                groups.append(value)
        if dn:
            entries.append((dn, groups))
    return entries


def ldap_group_names(member_of):
    """A group can be mapped by its full DN or its CN."""
    names = []
    for dn in member_of:
        names.append(dn)
        match = re.match(r'(?i)cn=((?:[^,\\]|\\.)+)', dn)
        if match:
            names.append(match.group(1))
    return names


def ldap_command(tool, state, dn, password_file):
    # ldap:// only with STARTTLS (-ZZ): passwords must not cross the network in clear text.
    return [tool, '-x', '-H', state['uri'], *(['-ZZ'] if state['uri'].lower().startswith('ldap://') else []), '-D', dn, '-y', password_file]


def _idp_file(kind, tenant_id):
    """The login directory of a tenant, or the global one for None."""
    if tenant_id is None:
        return LDAP_FILE if kind == 'ldap' else OIDC_FILE
    return f'{IDP_DIR}/{kind}-{int(tenant_id)}.json'


def _tenant_of_domain(domain):
    rows = _admin_query('SELECT tenant_id FROM tenant_domains WHERE domain = %s', (domain.lower(),))
    return rows[0]['tenant_id'] if rows else None


def _ldap_groups(username, password, state=None):
    """Finds the user with the service account, then binds as the user. An empty password would be an anonymous bind, which proves nothing."""
    state = state if state is not None else _json_read(LDAP_FILE, {})
    if not password or not USER_RE.match(username):
        raise EfaError('Wrong user name or password.')
    _directory_check(urllib.parse.urlsplit(state['uri']).hostname or '')
    search = state['user_filter'].replace('{user}', ldap_filter_escape(username))
    with tempfile.NamedTemporaryFile('w', dir='/run', prefix='efa-ldap-') as service, tempfile.NamedTemporaryFile('w', dir='/run', prefix='efa-ldap-') as user:
        # -y takes the whole file as the password: no line end.
        service.write(state['bind_password'])
        service.flush()
        user.write(password)
        user.flush()
        found = subprocess.run(ldap_command('ldapsearch', state, state['bind_dn'], service.name) + ['-LLL', '-o', 'ldif-wrap=no', '-b', state['base'], search, 'dn', 'memberOf'],
                               capture_output=True, text=True, timeout=20)
        entries = ldif_entries(found.stdout) if found.returncode == 0 else []
        if found.returncode != 0:
            print(f'ldapsearch: {found.stderr.strip()[-200:]}', file=sys.stderr)
        if len(entries) != 1:
            raise EfaError('Wrong user name or password.')
        dn, groups = entries[0]
        if subprocess.run(ldap_command('ldapwhoami', state, dn, user.name), capture_output=True, timeout=20).returncode != 0:
            raise EfaError('Wrong user name or password.')
    return ldap_group_names(groups)


def ldap_status(_args, path=None):
    """Login with a directory: LDAP or Active Directory. Off by default."""
    state = _json_read(path or LDAP_FILE, {'ldap': False})
    return {**{key: value for key, value in state.items() if key != 'bind_password'}, 'bind_password_stored': bool(state.get('bind_password'))}


def ldap_set(args, path=None):
    """Turn LDAP login on or off. Roles come from the group table. Uses ldaps, or ldap with STARTTLS."""
    path = path or LDAP_FILE
    if not _on_off(args.mode):
        _json_write(path, {'ldap': False})
        return {'ldap': False}
    uri, bind_dn, base = args.uri.strip(), args.bind_dn.strip(), args.base.strip()
    user_filter = args.user_filter.strip() or LDAP_DEFAULT_FILTER
    if not re.fullmatch(r'ldaps?://[A-Za-z0-9.:\[\]-]+(:\d+)?/?', uri, re.I):
        raise EfaError('URI like ldaps://dc1.example.org')
    _directory_check(urllib.parse.urlsplit(uri).hostname or '', unknown_ok=True)
    if not bind_dn or not base or any(ch in bind_dn + base for ch in '\r\n\0'):
        raise EfaError('Service account DN and search base are needed.')
    if '{user}' not in user_filter or not user_filter.startswith('(') or user_filter.count('(') != user_filter.count(')'):
        raise EfaError('Filter: in brackets, with {user} for the name.')
    password = _secrets(1, 'Password of the service account')[0] or _json_read(path, {}).get('bind_password', '')
    if not password:
        raise EfaError('The service account needs a password.')
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    _json_write(path, {'ldap': True, 'uri': uri, 'bind_dn': bind_dn, 'base': base, 'user_filter': user_filter, 'bind_password': password}, mode=0o600)
    return ldap_status(None, path)


def b64url(text):
    return base64.urlsafe_b64decode(text + '=' * (-len(text) % 4))


def rs256_ok(message, signature, modulus, exponent):
    """RSASSA-PKCS1-v1_5 with SHA-256, the signature OIDC requires of a provider. Keys below 2048 bits count as bad."""
    size = (modulus.bit_length() + 7) // 8
    if size < 256 or len(signature) != size or int.from_bytes(signature, 'big') >= modulus:
        return False
    tail = SHA256_PREFIX + hashlib.sha256(message).digest()
    expected = b'\x00\x01' + b'\xff' * (size - 3 - len(tail)) + b'\x00' + tail
    return secrets.compare_digest(pow(int.from_bytes(signature, 'big'), exponent, modulus).to_bytes(size, 'big'), expected)


def verify_id_token(token, keys, issuer, audience, nonce, now):
    """Checks an OIDC ID token and returns its claims. Only RS256: a token cannot choose a weaker way to be checked."""
    try:
        head, body, signature = token.split('.')
        header, claims = json.loads(b64url(head)), json.loads(b64url(body))
        raw_signature = b64url(signature)
    except ValueError:
        raise EfaError('OIDC: the ID token is damaged.')
    if header.get('alg') != 'RS256':
        raise EfaError('OIDC: only RS256 is accepted.')
    candidates = [key for key in keys if key.get('kty') == 'RSA' and (not header.get('kid') or key.get('kid') == header['kid'])]
    message = f'{head}.{body}'.encode()
    if not any(rs256_ok(message, raw_signature, int.from_bytes(b64url(key['n']), 'big'), int.from_bytes(b64url(key['e']), 'big')) for key in candidates):
        raise EfaError('OIDC: the signature of the ID token is wrong.')
    audiences = claims.get('aud') if isinstance(claims.get('aud'), list) else [claims.get('aud')]
    if claims.get('iss') != issuer or audience not in audiences:
        raise EfaError('OIDC: the ID token is for someone else.')
    if not isinstance(claims.get('exp'), (int, float)) or claims['exp'] < now - 60:
        raise EfaError('OIDC: the ID token has expired.')
    if isinstance(claims.get('nbf'), (int, float)) and claims['nbf'] > now + 60 or isinstance(claims.get('iat'), (int, float)) and claims['iat'] > now + 300:
        raise EfaError('OIDC: the ID token is not valid yet.')
    if not nonce or not secrets.compare_digest(str(claims.get('nonce', '')), nonce):
        raise EfaError('OIDC: the login does not match this browser session.')
    return claims


def directory_target_problem(host, resolve=None, own=None):
    """Why a login directory (LDAP, OIDC) may not be reached at this host, or None. efactl reaches it as root from this host:
    never this host itself, link-local (cloud metadata) or other special addresses. Private networks stay allowed: an
    Active Directory in the own network is the usual case."""
    resolve = resolve or (lambda name: {info[4][0] for info in socket.getaddrinfo(name, None)})
    try:
        found = {ipaddress.ip_address(item.split('%', 1)[0]) for item in resolve(host.strip('[]'))}
    except (OSError, ValueError, UnicodeError):
        return f'{host} is not known in DNS'
    own = _own_addresses() if own is None else own
    for ip in found:
        if ip.is_loopback or ip.is_link_local or ip.is_unspecified or ip.is_multicast or ip.is_reserved or str(ip) in own:
            return f'{host} is this host or a special address'
    return None


def _own_addresses():
    try:
        out = subprocess.run(['ip', '-j', 'addr'], capture_output=True, text=True, timeout=10).stdout
        return {item['local'] for link in json.loads(out or '[]') for item in link.get('addr_info', []) if item.get('local')}
    except (OSError, ValueError, subprocess.SubprocessError):
        return set()


def _directory_check(host, unknown_ok=False):
    """unknown_ok: a name not (yet) in DNS passes when it is set; every connection checks it again."""
    problem = directory_target_problem(host)
    if problem and not (unknown_ok and problem.endswith('is not known in DNS')):
        raise EfaError(f'Login directory not allowed: {problem}.')


def _oidc_json(url, data=None):
    if not url.startswith('https://'):
        raise EfaError('OIDC: the provider must use https.')
    _directory_check(urllib.parse.urlsplit(url).hostname or '')
    request = urllib.request.Request(url, data=urllib.parse.urlencode(data).encode() if data else None, headers={'Accept': 'application/json'})
    try:
        with urllib.request.urlopen(request, timeout=15) as reply:
            return json.load(reply)
    except urllib.error.HTTPError as err:
        raise EfaError(f'OIDC: the provider answered {err.code}.')
    except (OSError, ValueError) as err:
        # The reason only in the log: in the answer it would tell a tenant admin which hosts and ports exist behind this one.
        print(f'OIDC: {url[:200]}: {err}', file=sys.stderr)
        raise EfaError('OIDC: the provider does not answer.')


def _oidc_provider(state):
    found = _oidc_json(state['issuer'].rstrip('/') + '/.well-known/openid-configuration')
    if found.get('issuer', '').rstrip('/') != state['issuer'].rstrip('/'):
        raise EfaError('OIDC: the provider names another issuer.')
    return found


def oidc_status(_args, path=None):
    """Single sign-on for the web interface: Entra ID, Keycloak or another OIDC provider. Off by default."""
    state = _json_read(path or OIDC_FILE, {'oidc': False})
    found = {key: value for key, value in state.items() if key != 'client_secret'}
    found['client_secret_stored'] = bool(state.get('client_secret'))
    found['portal'] = bool(state.get('oidc') and state.get('portal_redirect_uri'))
    if path is None:
        # The login page asks for the mail domain when a tenant has its own.
        tenants = [_json_read(item, {}) for item in glob.glob(IDP_DIR + '/oidc-*.json')]
        found['tenant_sso'] = any(item.get('oidc') for item in tenants)
        found['tenant_portal_sso'] = any(item.get('oidc') and item.get('portal_redirect_uri') for item in tenants)
    return found


def oidc_set(args, path=None):
    """Turn single sign-on on or off. Roles come from the group table, matched against the groups claim."""
    path = path or OIDC_FILE
    if not _on_off(args.mode):
        _json_write(path, {'oidc': False})
        return {'oidc': False}
    issuer, client_id, redirect = args.issuer.strip(), args.client_id.strip(), args.redirect_uri.strip()
    https_url(issuer)
    https_url(redirect)
    if not issuer or not client_id or not redirect.endswith('/login/oidc/callback'):
        raise EfaError('Issuer, client ID and a redirect address ending in /login/oidc/callback are needed.')
    claim = args.group_claim.strip() or 'groups'
    secret = _secrets(1, 'Client secret')[0] or _json_read(path, {}).get('client_secret', '')
    if not secret:
        raise EfaError('The client secret is needed.')
    # The user portal has its own redirect address at the provider; without one the portal keeps password, link and passkey.
    portal = (getattr(args, 'portal_redirect_uri', '') or '').strip()
    portal = '' if portal == '-' else portal or _json_read(path, {}).get('portal_redirect_uri', '')
    if portal:
        https_url(portal)
        if not portal.endswith(OIDC_PORTAL_CALLBACK):
            raise EfaError(f'The redirect address of the user portal ends in {OIDC_PORTAL_CALLBACK}.')
    state = {'oidc': True, 'issuer': issuer, 'client_id': client_id, 'redirect_uri': redirect, 'group_claim': claim, 'client_secret': secret,
             **({'portal_redirect_uri': portal} if portal else {})}
    _oidc_provider(state)
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    _json_write(path, state, mode=0o600)
    return oidc_status(None, path)


OIDC_PORTAL_CALLBACK = '/portal/login/oidc/callback'


def oidc_redirect(state, portal):
    """The redirect address of a login: the one of the admin interface, or the own one of the user portal."""
    if not portal:
        return state['redirect_uri']
    if not state.get('portal_redirect_uri'):
        raise EfaError('Single sign-on is off for the user portal.')
    return state['portal_redirect_uri']


def _admin_has_address(address, query=None, identity=None):
    """True when an admin account (any role but user, also of a tenant or disabled) has this address as its name or its e-mail,
    in any case: the portal never logs in by such an address (single sign-on, login link), that one uses the admin interface."""
    query, identity = query or _admin_query, identity or (lambda name: _load_identity(name, allow_disabled=True))
    address = (address or '').strip().lower()
    if not address:
        return False
    rows = query('SELECT username FROM users WHERE LOWER(username) = %s OR LOWER(email) = %s', (address, address))
    return any(identity(row['username'])['role'] != 'user' for row in rows)


def _portal_oidc_login(email, external, tenant=None):
    """A login of the user portal by single sign-on: the address the provider has checked, of an own domain (of the tenant when
    its directory answered), as a user of the role user bound to issuer and subject. An address with an admin login of its own
    is refused: that one logs in at the admin interface."""
    email = (email or '').lower()
    domain = email.rsplit('@', 1)[1] if '@' in email else ''
    if not domain or domain not in _own_domains() or (tenant is not None and _tenant_of_domain(domain) != tenant):
        raise EfaError('This login has no checked address of a domain here.')
    if _admin_has_address(email):
        raise EfaError('This address has a login of its own, please use that.')
    username = _bound_username(email, external)
    _admin_query("INSERT INTO users (username, role, email, source, groups_migrated, external_id) VALUES (%s, 'user', %s, 'oidc-portal', 1, %s) "
                 'ON DUPLICATE KEY UPDATE last_login = NOW(), external_id = COALESCE(external_id, VALUES(external_id))', (username, email, external))
    known = _load_identity(username, allow_disabled=True)
    if known['source'] in ('oidc-portal', 'link') and not known['memberships']:
        _admin_query("INSERT IGNORE INTO user_groups (username, group_id) SELECT %s, id FROM efa_groups WHERE builtin = 'user'", (username,))
        known = _load_identity(username, allow_disabled=True)
    if known['source'] not in ('oidc-portal', 'link') or known['role'] != 'user' or known['disabled']:
        raise EfaError('This address has a login of its own, please use that.')
    return {'username': known['username'], 'role': known['role']}


def _oidc_tenant(args):
    """The tenant whose single sign-on a login uses, by the mail domain typed on the login page. None: the global one."""
    domain = (getattr(args, 'domain', '') or '').strip().lower().rsplit('@', 1)[-1]
    if domain:
        tenant = _tenant_of_domain(domain) if DOMAIN_RE.match(domain) else None
        if tenant is not None and _json_read(_idp_file('oidc', tenant), {}).get('oidc'):
            return tenant
    tenant = (getattr(args, 'tenant', '') or '').strip()
    return int(tenant) if tenant.isdigit() else None


def oidc_start(args):
    """The address a browser goes to for its login, and what must come back. With PKCE."""
    tenant = _oidc_tenant(args)
    state = _json_read(_idp_file('oidc', tenant), {})
    if not state.get('oidc'):
        raise EfaError('Single sign-on is off.')
    provider = _oidc_provider(state)
    login_state, nonce, verifier = secrets.token_urlsafe(32), secrets.token_urlsafe(32), secrets.token_urlsafe(48)
    challenge = base64.urlsafe_b64encode(hashlib.sha256(verifier.encode()).digest()).rstrip(b'=').decode()
    portal = (getattr(args, 'portal', '') or '').strip() == 'yes'
    params = {'response_type': 'code', 'client_id': state['client_id'], 'redirect_uri': oidc_redirect(state, portal),
              'scope': 'openid profile email', 'state': login_state, 'nonce': nonce, 'code_challenge': challenge, 'code_challenge_method': 'S256'}
    if (getattr(args, 'stepup', '') or '').strip() == 'yes':
        # Hans 2026-11-22 (6.0.0.7): an admin of single sign-on confirms a critical change at its provider: a new login there.
        params.update(prompt='login', max_age='0')
    query = urllib.parse.urlencode(params)
    return {'url': f"{provider['authorization_endpoint']}?{query}", 'state': login_state, 'nonce': nonce, 'verifier': verifier,
            'tenant': '' if tenant is None else str(tenant), 'started': int(time.time())}


OIDC_STEPUP_SKEW = 60


def oidc_stepup_check(claims, started, expected, bound):
    """The step-up of an OIDC admin counts only when the provider logged the same person in again after it was asked:
    auth_time (OIDC Core 3.1.2.1, required with max_age) not before the start, and the account bound to iss and sub."""
    at = claims.get('auth_time')
    if not isinstance(at, (int, float)) or isinstance(at, bool) or at < started - OIDC_STEPUP_SKEW:
        raise EfaError('OIDC: the provider did not log you in again (no new auth_time): the change is not confirmed.')
    if not expected or bound != expected:
        raise EfaError('OIDC: the provider logged in another account: the change is not confirmed.')


def oidc_finish(args):
    """Trades the code of the browser for an ID token, checks it and logs the user in."""
    tenant = _oidc_tenant(argparse.Namespace(tenant=getattr(args, 'tenant', '') or ''))
    state = _json_read(_idp_file('oidc', tenant), {})
    if not state.get('oidc'):
        raise EfaError('Single sign-on is off.')
    portal = (getattr(args, 'portal', '') or '').strip() == 'yes'
    redirect = oidc_redirect(state, portal)
    provider = _oidc_provider(state)
    answer = _oidc_json(provider['token_endpoint'], {'grant_type': 'authorization_code', 'code': args.code.strip(), 'redirect_uri': redirect,
                                                     'client_id': state['client_id'], 'client_secret': state['client_secret'], 'code_verifier': args.verifier.strip()})
    if 'id_token' not in answer:
        raise EfaError('OIDC: the provider sent no ID token.')
    keys = _oidc_json(provider['jwks_uri']).get('keys', [])
    claims = verify_id_token(answer['id_token'], keys, provider['issuer'], state['client_id'], args.nonce.strip(), time.time())
    # The account is the one of iss and sub (OIDC: the only stable, unique pair); a name or an address the user can change
    # at the provider never moves a login to another account. An address counts only when the provider has checked it.
    email = claims.get('email') if claims.get('email_verified') is True else ''
    username = claims.get('preferred_username') or email or claims.get('sub') or ''
    external = f"{claims['iss']}|{claims.get('sub', '')}" if claims.get('sub') else ''
    if not external:
        raise EfaError('OIDC: the ID token names no subject (sub).')
    if (getattr(args, 'stepup', '') or '').strip() == 'yes' and not portal:
        name = (email or '').lower() if tenant is not None else username
        bound = _bound_username(name, external)
        started = (getattr(args, 'started', '') or '').strip()
        oidc_stepup_check(claims, int(started) if started.isdigit() else 0, (getattr(args, 'expect', '') or '').strip(), bound)
        if (_admin_query('SELECT disabled FROM users WHERE username = %s', (bound,)) or [{'disabled': 1}])[0]['disabled']:
            raise EfaError('This user is disabled.')
        _audit(f'single sign-on: {bound} confirmed a critical change at the provider')
        return {'stepup': True, 'username': bound}
    if portal:
        return _portal_oidc_login(email, external, tenant)
    groups = claims.get(state['group_claim']) or []
    if tenant is not None:
        # The directory of a tenant speaks only for addresses of that tenant, and only for addresses it has checked.
        username = (email or '').lower()
        if '@' not in username or _tenant_of_domain(username.rsplit('@', 1)[1]) != tenant:
            raise EfaError('This login does not belong to a domain of the tenant (or the provider has not checked its address).')
        return _external_login(username, groups if isinstance(groups, list) else [str(groups)], f'oidc:{tenant}', tenant, external)
    return _external_login(username, groups if isinstance(groups, list) else [str(groups)], 'oidc', external=external)


def _api_state():
    return _json_read(API_FILE, {}).get('api', False)


def api_status(_args):
    """REST API on /api/v1/<command>, with a token per user."""
    return {'api': _api_state()}


def api_set(args):
    """Turn the REST API on or off. Off is the default. Tokens stay when it is off."""
    enabled = _on_off(args.mode)
    _json_write(API_FILE, {'api': enabled})
    return {'api': enabled}


def _token_owner(args):
    username = args.username.strip()
    if identity_now is None or 'api_tokens.manage' in identity_now['grants']:
        return username or (identity_now or {}).get('username') or ''
    if username and username != identity_now['username']:
        raise EfaError('Only your own tokens.')
    return identity_now['username']


def token_list(args):
    """API tokens. The token itself is only shown once, when it is made."""
    owner = _token_owner(args)
    where, params = ('WHERE username = %s', (owner,)) if owner else ('', ())
    return {'tokens': _admin_query('SELECT id, username, label, CAST(expires AS CHAR) AS expires, CAST(last_used AS CHAR) AS last_used '
                                   f'FROM api_tokens {where} ORDER BY id', params)}


def token_create(args):
    """Make an API token. It has the rights of its user."""
    owner = _token_owner(args)
    if not owner or not _admin_query('SELECT 1 FROM users WHERE username = %s', (owner,)):
        raise EfaError('Name an existing user. The main admin has no token: make a user with the role super for that.')
    if _load_identity(owner).get('role') == 'user':
        raise EfaError('Users of the portal get no API token: the API belongs to the admin interface.')
    label = args.label.strip() or 'token'
    days = (args.days or '').strip() or str(TOKEN_DAYS_DEFAULT)
    if not days.isdigit() or not 1 <= int(days) <= 3650 or len(label) > 100:
        raise EfaError('Days: 1 to 3650. Label: up to 100 characters.')
    tenant = _tenant_id(args.tenant.strip()) if (getattr(args, 'tenant', '') or '').strip() else None
    if tenant is not None:
        holder = _load_identity(owner)['grants']
        if not any(scope is None or tenant in scope['tenants'] for scope in holder.values()):
            raise EfaError('This user has nothing in that tenant.')
        if identity_now and not any(scope is None or tenant in scope['tenants'] for scope in identity_now['grants'].values()):
            raise EfaError('Not allowed: this tenant is outside your scope.')
    token = 'efa_' + secrets.token_urlsafe(32)
    _admin_query('INSERT INTO api_tokens (token_sha256, username, label, expires, tenant_id) VALUES (%s, %s, %s, NOW() + INTERVAL %s DAY, %s)',
                 (hashlib.sha256(token.encode()).hexdigest(), owner, label, int(days), tenant))
    return {'token': token, 'username': owner, 'label': label, 'days': int(days), 'tenant': args.tenant.strip() if tenant is not None else '',
            'note': 'Shown only now. Store it.'}


def token_revoke(args):
    """Delete an API token."""
    if not args.id.strip().isdigit():
        raise EfaError('Token ID must be a number.')
    owner = _token_owner(args) if identity_now and 'api_tokens.manage' not in identity_now['grants'] else ''
    where, params = ('AND username = %s', (owner,)) if owner else ('', ())
    _admin_query(f'DELETE FROM api_tokens WHERE id = %s {where}', (int(args.id), *params))
    return {'revoked': args.id.strip()}


def token_check(_args):
    """Who an API token belongs to, for the web interface. Fails while the API is off."""
    if not _api_state():
        raise EfaError('The API is off.')
    sha = hashlib.sha256(_secrets(1, 'Token')[0].strip().encode()).hexdigest()
    rows = _admin_query('SELECT username, tenant_id FROM api_tokens WHERE token_sha256 = %s AND expires > NOW()', (sha,))
    if not rows or _load_identity(rows[0]['username']).get('role') == 'user':
        raise EfaError('Invalid token.')
    _admin_query('UPDATE api_tokens SET last_used = NOW() WHERE token_sha256 = %s', (sha,))
    return {'username': rows[0]['username'], 'tenant_id': rows[0]['tenant_id']}


def audit_redact(values):
    """Passwords and keys never reach the audit log."""
    return {key: '***' if re.search(r'pass|secret|token|key', key, re.I) and value else value for key, value in values.items()}


def audit_changes(before, after):
    """Only what changed; a key that is gone, such as a removed user, shows as None."""
    keys = [key for key in {**before, **after} if before.get(key) != after.get(key)]
    return {key: before.get(key) for key in keys}, {key: after.get(key) for key in keys}


def _access_state():
    """Users, groups and directory mappings, one key each, so the audit log shows old and new of each one."""
    state = {}
    names = {row['id']: row['name'] for row in _admin_query('SELECT id, name FROM tenants')}
    groups = _groups()
    for row in _admin_query('SELECT username, email, disabled FROM users'):
        state['user:' + row['username']] = {'groups': sorted(_member_text(member, names) for member in _memberships(row['username'], groups)),
                                            'email': row['email'], 'disabled': bool(row['disabled'])}
    for group in groups.values():
        if not group['builtin']:
            state['group:' + group['name']] = {'permissions': sorted(group['permissions']), 'scope': group['scope'],
                                               'tenants': sorted(names.get(item, str(item)) for item in group['scope_tenants']),
                                               'domains': sorted(group['scope_domains']), 'disabled': bool(group['disabled'])}
    for row in _admin_query('SELECT group_name, group_id, tenant_id, domain FROM group_roles'):
        state['directory group:' + row['group_name']] = {'efa_group': groups.get(row['group_id'], {}).get('name'),
                                                         'tenant': names.get(row['tenant_id']), 'domain': row['domain']}
    return state


def _audit_state():
    try:
        found = settings(None)
    except (EfaError, OSError, subprocess.CalledProcessError, ValueError):
        found = {}
    try:
        found.update(_access_state())
    except Exception:  # no database yet, or pymysql errors without a common base: the settings still count
        pass
    return found


def _audit_write(command, args, before, ok):
    """Who, what, when, old and new. A failing database must not stop the work: the file log has the line already."""
    old, new = audit_changes(before, _audit_state())
    values = audit_redact({key: value for key, value in vars(args).items() if key not in ('func', 'command', 'as_user', 'client', 'limit_tenant')})
    tenant = identity_now['tenant_id'] if identity_now else None
    try:
        _admin_query('INSERT INTO audit (actor, client, tenant_id, command, args, old_value, new_value, ok) VALUES (%s, %s, %s, %s, %s, %s, %s, %s)',
                     (_dmarc_who(), acting_client[:64], tenant, command, json.dumps(values), json.dumps(audit_redact(old), default=str),
                      json.dumps(audit_redact(new), default=str), int(ok)))
    except Exception as err:  # also pymysql errors, which have no common base here: the change itself is done
        # Before the wizard there is no database yet (no root password of MariaDB): the file log has the line, no error.
        if any(line.startswith('MYSQLROOTPWD:') for line in _read_lines(MYSQL_CONFIG)):
            print(f'audit log: {err}', file=sys.stderr)


def audit_search(args):
    """Search the audit log of changes: who, what, when, old and new."""
    limit = (args.limit or '').strip() or '100'
    if not limit.isdigit() or not 1 <= int(limit) <= 1000:
        raise EfaError('Limit must be 1 to 1000.')
    needle = '%' + args.text.strip().replace('\\', '\\\\').replace('%', '\\%').replace('_', '\\_') + '%'
    where, params = 'WHERE (actor LIKE %s OR command LIKE %s OR args LIKE %s)', [needle, needle, needle]
    if identity_now and identity_now['tenant_ids'] is not None:
        where += ' AND tenant_id IN (' + ','.join(['%s'] * len(identity_now['tenant_ids'])) + ')' if identity_now['tenant_ids'] else ' AND FALSE'
        params.extend(identity_now['tenant_ids'])
    return {'audit': _admin_query('SELECT CAST(ts AS CHAR) AS ts, actor, client, command, args, old_value, new_value, ok '
                                  f'FROM audit {where} ORDER BY id DESC LIMIT %s', (*params, int(limit)))}


def strict_settings():
    return {**STRICT_DEFAULTS, **_json_read(STRICT_FILE, {})}


def strict_mac(key, prev, entry):
    """HMAC-SHA256 over the previous MAC and the entry without its own MAC: changing or removing a line breaks the chain."""
    body = json.dumps({name: value for name, value in entry.items() if name != 'mac'}, sort_keys=True, separators=(',', ':'), default=str)
    return hmac.new(key, (prev + body).encode(), hashlib.sha256).hexdigest()


def _strict_key():
    if not os.path.exists(STRICT_KEY):
        fd = os.open(STRICT_KEY, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, 'w') as f:
            f.write(secrets.token_hex(32) + '\n')
    with open(STRICT_KEY) as f:
        return bytes.fromhex(f.read().strip())


def _strict_last_mac(path):
    """The MAC of the last line, '' for an empty or missing file."""
    try:
        with open(path, 'rb') as f:
            f.seek(0, os.SEEK_END)
            f.seek(max(0, f.tell() - 65536))
            lines = f.read().splitlines()
    except OSError:
        return ''
    return json.loads(lines[-1]).get('mac', '') if lines else ''


def strict_entry(action, object_='', result='ok', old=None, new=None, reason='', session=''):
    """One entry, the time in UTC. Secrets never get here: arguments go through audit_redact first."""
    who = identity_now or {}
    return {'ts': datetime.datetime.now(datetime.timezone.utc).isoformat(timespec='milliseconds').replace('+00:00', 'Z'),
            'user': who.get('username') or acting_user or ('admin (web)' if os.environ.get('SUDO_USER') == 'efa-web' else f"console ({os.environ.get('SUDO_USER') or 'root'})"),
            'role': who.get('role') or ('super' if not acting_user else ''), 'tenant': who.get('tenant_id') or '', 'src_ip': acting_client or '',
            'session': session or acting_session or '', 'action': action, 'object': object_, 'result': result,
            'old': old, 'new': new, 'reason': reason}


def strict_write(entry, prev=None, path=None):
    """Appends one entry under a lock, with fsync. Raises OSError if it cannot: the caller refuses the action then."""
    path = path or STRICT_LOG
    os.makedirs(os.path.dirname(path), mode=0o750, exist_ok=True)
    key = _strict_key()
    new_file = not os.path.exists(path)
    fd = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
    with os.fdopen(fd, 'a') as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        entry['prev'] = _strict_last_mac(path) if prev is None else prev
        entry['mac'] = strict_mac(key, entry['prev'], entry)
        f.write(json.dumps(entry, sort_keys=True, separators=(',', ':'), default=str) + '\n')
        f.flush()
        os.fsync(f.fileno())
    if new_file:
        _strict_append_only(path, True)
    return entry


def _strict_append_only(path, on):
    try:
        _platform().append_only(path, on)
    except Exception:  # not every file system knows it; the HMAC chain still shows any change
        pass


def strict_ready():
    """Fail closed: in strict mode an action runs only if its entry can be written."""
    folder = os.path.dirname(STRICT_LOG)
    try:
        os.makedirs(folder, mode=0o750, exist_ok=True)
        usage = shutil.disk_usage(folder)
    except OSError as err:
        raise EfaError(f'Strict audit mode: the audit log cannot be written ({err}), so this is refused.')
    if usage.free < STRICT_MIN_FREE or (os.path.exists(STRICT_LOG) and not os.access(STRICT_LOG, os.W_OK)):
        raise EfaError('Strict audit mode: the audit log cannot be written (disk full?), so this is refused.')


def strict_record(action, object_='', result='ok', **fields):
    """Writes an entry if strict mode is on, and forwards it as an event to Syslog, OTLP and Wazuh."""
    if not strict_settings()['on']:
        return None
    entry = strict_write(strict_entry(action, object_, result, **fields))
    _event('audit_entry', 'notice' if result == 'ok' else 'warning', user=entry['user'], src_ip=entry['src_ip'], tenant=entry['tenant'],
           action=action, object=str(object_)[:200], result=result)
    return entry


def strict_verify(paths, key):
    """Checks the chain over all files in order. Returns entries counted and the first break, or None."""
    prev, count = '', 0
    for path in paths:
        if path != paths[-1] and os.path.exists(path + '.sig'):
            with open(path, 'rb') as f, open(path + '.sig') as sig:
                if not hmac.compare_digest(hmac.new(key, f.read(), hashlib.sha256).hexdigest(), sig.read().strip()):
                    return count, {'file': path, 'line': 0, 'reason': 'the signature of the closed file does not match'}
        with open(path) as f:
            for number, line in enumerate(f, 1):
                try:
                    entry = json.loads(line)
                except ValueError:
                    return count, {'file': path, 'line': number, 'reason': 'not a valid entry'}
                if entry.get('prev') != prev:
                    return count, {'file': path, 'line': number, 'reason': 'an entry before it is missing or changed'}
                if not hmac.compare_digest(strict_mac(key, prev, entry), entry.get('mac', '')):
                    return count, {'file': path, 'line': number, 'reason': 'this entry was changed'}
                prev, count = entry['mac'], count + 1
    return count, None


def _strict_files():
    return sorted(glob.glob(STRICT_LOG + '-*[0-9]')) + ([STRICT_LOG] if os.path.exists(STRICT_LOG) else [])


def audit_verify(_args):
    """Checks the strict audit log: every entry, the chain between them and the signature of each closed file."""
    files = _strict_files()
    if not files:
        return {'ok': True, 'entries': 0, 'files': 0, 'note': 'No strict audit log yet.'}
    count, broken = strict_verify(files, _strict_key())
    return {'ok': broken is None, 'entries': count, 'files': len(files), 'first_break': broken}


def strict_rotate(now=None):
    """Closes the log of an earlier day: a last entry naming the next file, a signature over the file, then the next file goes on with the chain."""
    if not os.path.exists(STRICT_LOG) or not os.path.getsize(STRICT_LOG):
        return None
    now = now or time.time()
    # The day of the first entry: every entry changes the time of the file, so that cannot tell.
    with open(STRICT_LOG) as f:
        first = json.loads(f.readline())['ts']
    started = datetime.datetime.fromisoformat(first.replace('Z', '+00:00')).astimezone()
    if started.strftime('%Y-%m-%d') == time.strftime('%Y-%m-%d', time.localtime(now)):
        return None
    closed = STRICT_LOG + time.strftime('-%Y%m%d-%H%M%S', time.localtime(now))
    while os.path.exists(closed):
        closed += '0'
    last = strict_write(strict_entry('audit_log_closed', os.path.basename(closed)))
    _strict_append_only(STRICT_LOG, False)
    os.rename(STRICT_LOG, closed)
    with open(closed, 'rb') as f:
        _write(closed + '.sig', hmac.new(_strict_key(), f.read(), hashlib.sha256).hexdigest() + '\n')
    os.chmod(closed, 0o400)
    strict_write(strict_entry('audit_log_opened', os.path.basename(closed)), prev=last['mac'])
    return closed


def _strict_job(today):
    """Hourly: rotation at a new day, and closed files past their days are removed."""
    if not strict_settings()['on'] and not os.path.exists(STRICT_LOG):
        return
    strict_rotate()
    if strict_settings()['on']:
        _anchor_job(today)
    cutoff = time.time() - strict_settings()['days'] * 86400
    for path in _strict_files()[:-1]:
        if os.path.getmtime(path) < cutoff:
            for item in (path, path + '.sig'):
                if os.path.exists(item):
                    os.remove(item)


# B2: once a day a signed anchor of the strict audit chain: its last MAC, the number of entries and the SHA-256 of each closed
# file, linked to the anchor before. The HMAC key proves the chain to this host; the anchor is signed with an Ed25519 key of
# its own, and goes out as an event to the SIEM, so a chain written anew with the HMAC key no longer matches what left the host.
ANCHOR_KEY = ETC + '/eFa/audit-anchor.key'
ANCHOR_PUB = ETC + '/eFa/audit-anchor.pub'


def _anchor_dir():
    return os.path.join(os.path.dirname(STRICT_LOG), 'anchors')


def _anchor_keys():
    from cryptography.hazmat.primitives import serialization
    from cryptography.hazmat.primitives.asymmetric import ed25519
    if not os.path.exists(ANCHOR_KEY):
        key = ed25519.Ed25519PrivateKey.generate()
        fd = os.open(ANCHOR_KEY, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, 'wb') as f:
            f.write(key.private_bytes(serialization.Encoding.PEM, serialization.PrivateFormat.PKCS8, serialization.NoEncryption()))
        _write(ANCHOR_PUB, key.public_key().public_bytes(serialization.Encoding.PEM, serialization.PublicFormat.SubjectPublicKeyInfo).decode())
    with open(ANCHOR_KEY, 'rb') as f:
        return serialization.load_pem_private_key(f.read(), None)


def anchor_body(anchor):
    return json.dumps({name: value for name, value in anchor.items() if name != 'signature'}, sort_keys=True, separators=(',', ':')).encode()


def anchor_make(files, last_mac, entries, previous, day, private_key, chain_ok=True):
    """The anchor of one day, signed. previous is the anchor before (or None)."""
    closed = []
    for path in files[:-1]:
        with open(path, 'rb') as f:
            closed.append({'file': os.path.basename(path), 'sha256': hashlib.sha256(f.read()).hexdigest()})
    anchor = {'day': day, 'last_mac': last_mac, 'entries': entries, 'closed': closed, 'chain_ok': chain_ok,
              'previous': hashlib.sha256(anchor_body(previous)).hexdigest() if previous else ''}
    anchor['signature'] = base64.b64encode(private_key.sign(anchor_body(anchor))).decode()
    return anchor


def anchor_check(anchors, public_key, macs, folder, kept_from=''):
    """Problems of a list of anchors (oldest first): signature, link to the one before, last MAC still in the chain, closed files unchanged."""
    from cryptography.exceptions import InvalidSignature
    problems, before = [], None
    for anchor in anchors:
        day = anchor.get('day', '?')
        try:
            public_key.verify(base64.b64decode(anchor.get('signature', '')), anchor_body(anchor))
        except (InvalidSignature, ValueError):
            problems.append(f'{day}: the signature does not match')
            before = anchor
            continue
        if before is not None and anchor.get('previous') != hashlib.sha256(anchor_body(before)).hexdigest():
            problems.append(f'{day}: the anchor before it is missing or changed')
        if anchor.get('last_mac') and anchor['last_mac'] not in macs and day >= kept_from:
            problems.append(f'{day}: the last entry it names is no longer in the chain')
        for item in anchor.get('closed', []):
            path = os.path.join(folder, item['file'])
            if os.path.exists(path):
                with open(path, 'rb') as f:
                    if hashlib.sha256(f.read()).hexdigest() != item['sha256']:
                        problems.append(f"{day}: {item['file']} was changed after it was closed")
        before = anchor
    return problems


def _anchors():
    found = []
    for path in sorted(glob.glob(os.path.join(_anchor_dir(), '*.json'))):
        try:
            found.append(_json_read(path, {}))
        except ValueError:
            found.append({'day': os.path.basename(path), 'signature': ''})
    return found


def _chain_macs(files):
    macs = set()
    for path in files:
        with open(path) as f:
            for line in f:
                try:
                    macs.add(json.loads(line).get('mac', ''))
                except ValueError:
                    pass
    return macs


def _anchor_job(today):
    """Daily, after the rotation: the anchor of the chain as it is now, unless today has one."""
    path = os.path.join(_anchor_dir(), today.isoformat() + '.json')
    files = _strict_files()
    if os.path.exists(path) or not files:
        return None
    count, broken = strict_verify(files, _strict_key())
    anchors = _anchors()
    anchor = anchor_make(files, _strict_last_mac(files[-1]), count, anchors[-1] if anchors else None, today.isoformat(), _anchor_keys(),
                         broken is None)
    os.makedirs(_anchor_dir(), mode=0o750, exist_ok=True)
    _json_write(path, anchor, mode=0o440)
    _event('audit_anchor', 'notice' if broken is None else 'warning', day=anchor['day'], last_mac=anchor['last_mac'], entries=count,
           digest=hashlib.sha256(anchor_body(anchor)).hexdigest())
    return anchor


def audit_anchor_verify(_args):
    """B2: checks the signed daily anchors against the strict audit chain."""
    anchors = _anchors()
    if not anchors:
        return {'ok': True, 'anchors': 0, 'note': 'No anchor yet: the first one is written in the night after the strict audit mode is on.'}
    from cryptography.hazmat.primitives import serialization
    with open(ANCHOR_PUB, 'rb') as f:
        public_key = serialization.load_pem_public_key(f.read())
    files = _strict_files()
    # Anchors older than the files kept: their entries left with the retention, only signature and link still count.
    oldest = min((os.path.getmtime(path) for path in files), default=time.time())
    problems = anchor_check(anchors, public_key, _chain_macs(files), os.path.dirname(STRICT_LOG), time.strftime('%Y-%m-%d', time.localtime(oldest)))
    return {'ok': not problems, 'anchors': len(anchors), 'last': anchors[-1].get('day'), 'problems': problems,
            'public_key': open(ANCHOR_PUB).read()}

def audit_mode(args):
    """Strict audit mode: on or off, only by a super admin, with a reason. Off by default."""
    if identity_now and identity_now['role'] != 'super':
        raise EfaError('Only a super admin switches the strict audit mode.')
    mode, reason = _on_off(args.mode), (args.reason or '').strip()
    if len(reason) < 5:
        raise EfaError('Give a reason, at least 5 characters.')
    state = strict_settings()
    days = (args.days or '').strip()
    if days:
        if not days.isdigit() or not 30 <= int(days) <= 3650:
            raise EfaError('Days: 30 to 3650.')
        state['days'] = int(days)
    if (args.require_reason or '').strip():
        state['require_reason'] = _on_off(args.require_reason)
    if not mode and state['on']:
        # Logged while still on; the external targets learn it as a warning.
        strict_record('audit_mode_off', reason=reason)
        _event('audit_mode_off', 'warning', user=_dmarc_who(), src_ip=acting_client, reason=reason)
    state['on'] = mode
    _json_write(STRICT_FILE, state)  # efa-web and the portal read it: 0640 root:efa-conf (CONF_READERS)
    if mode:
        try:
            strict_ready()
            strict_record('audit_mode_on', reason=reason, new={'require_reason': state['require_reason'], 'days': state['days']})
        except (EfaError, OSError):
            state['on'] = False
            _json_write(STRICT_FILE, state)
            raise
    return {'strict_audit': mode, 'require_reason': state['require_reason'], 'days': state['days']}


def audit_strict_status(_args):
    """Strict audit mode: on or off, files, size, and the check of the chain."""
    state, files = strict_settings(), _strict_files()
    return {**state, 'files': len(files), 'megabytes': round(sum(os.path.getsize(path) for path in files) / 1048576, 1),
            'audit_rules': _audit_rules_present()}


def _audit_rules_present():
    try:
        return _platform().audit_rules_present()
    except Exception:  # no platform layer, as in a test
        return False


# The package setup (efa-next-setup) writes this file when a step failed and removes it when all passed; its output per
# failed step goes to SETUP_LOG. A failed step is never silent: dashboard, audit line and the exit code of the setup.
SETUP_FAILED = '/var/lib/eFa/setup-failed'
SETUP_LOG = '/var/log/eFa/setup.log'


def setup_failed_state():
    """{'mode', 'at', 'steps'} of the last package setup with a failed step, or None."""
    lines = _read_lines(SETUP_FAILED)
    if len(lines) < 3:
        return None
    return {'mode': lines[0][:20], 'at': lines[1][:20], 'steps': ' '.join(lines[2:])[:2000]}


def setup_failed_note(_args):
    """Run by efa-next-setup after a failed step: the audit line of it."""
    state = setup_failed_state()
    if state:
        _audit(f"package setup {state['mode']} FAILED: {state['steps'][:500]} (output in {SETUP_LOG})")
    return {'failed': state}


def audit_note(args):
    """An action of the web interface without a command of its own: login, logout, page view, download, refusal."""
    action = (args.action or '').strip()[:64]
    if not re.fullmatch(r'[a-z_]+(:[A-Z]+ [\w./<>-]+)?', action):
        raise EfaError('Unknown action.')
    entry = strict_record(action, (args.object or '')[:500], (args.result or 'ok').strip()[:32], session=(args.session or '')[:64])
    return {'logged': bool(entry)}


def refusal_note(args):
    """UI-CLAM: the web interface refused a change to this login (403): into the audit log, without the values of the form. Only
    for a change the login may really not make, so nobody writes a refusal for another."""
    name = (args.command or '').strip()
    if name not in COMMANDS or not COMMANDS[name].get('writes') or command_allowed(identity_now, name, True):
        raise EfaError('Not a refused change.')
    _audit(f'{name} refused for {_dmarc_who()}: not allowed for this login')
    return {'logged': True}


def audit_rules_text():
    return '# Written by efactl audit-rules-set. Do not edit: it is replaced.\n' + ''.join(f'-w {path} -p wa -k efa\n' for path in AUDIT_RULE_PATHS)


def audit_rules_set(args):
    """Rules of the audit daemon for the eFa-next settings and programs, loaded without a reboot."""
    mode = _on_off(args.mode)
    try:
        _platform().audit_rules(audit_rules_text() if mode else None)
    except Exception as err:  # the StepError of the platform layer
        raise EfaError(f'The audit daemon did not take the rules: {err}')
    return {'audit_rules': mode}


def content_reason_set(args):
    """A reason is needed before the content of a mail is shown, also without the strict audit mode. The reason goes to the audit log."""
    state = _json_read(STRICT_FILE, {})
    state['content_reason'] = _on_off(args.mode)
    _json_write(STRICT_FILE, state)
    return {'content_reason': state['content_reason']}


def audit_purge(_args):
    """Remove audit entries after their days (400 by default), and the rows of DMARC and TLS reports after theirs."""
    own = {tid: days['audit'] for tid, days in retention_tenants().items() if 'audit' in days}
    for where, params in retention_tenant_deletes(retention('audit'), own):
        _admin_query(f'DELETE FROM audit WHERE {where}', params)
    for table in ('dmarc_rua', 'tls_rpt'):
        try:
            for where, params in retention_deletes(retention('reports'), retention_tenants(), _tenant_domains_or_none(), 'reports', ('domain',)):
                _admin_query(f"DELETE FROM {table} WHERE {where.replace('ts <', 'begin_ts <', 1)} LIMIT 100000", params)
        except Exception:  # pymysql: the table exists only once reports are read
            pass
    tenants = {tid: days for tid, days in retention_tenants().items() if days}
    _audit(f"retention: audit log after {retention('audit')} days, reports after {retention('reports')} days purged"
           + (f'; own days of tenants {", ".join(f"{tid} {days}" for tid, days in sorted(tenants.items()))}' if tenants else ''))
    return {'kept_days': retention('audit'), 'report_days': retention('reports')}


def retention_status(_args):
    """How long each kind of data is kept, and where that is set."""
    policy = headers_policy()
    names = {}
    try:
        names = {row['id']: row['name'] for row in _admin_query('SELECT id, name FROM tenants')}
    except Exception:  # no database yet
        pass
    return {'retention': [
        {'data': 'mail log', 'days': _maillog_days(), 'set_with': 'maillog-retention-set'},
        {'data': 'headers of all mail', 'days': policy['days'] if policy['store'] else 0, 'set_with': 'headers-store-set, per domain: domain-general-set'},
        {'data': 'quarantine', 'days': _quarantine_days(), 'set_with': 'quarantine-days-set'},
        {'data': 'audit log', 'days': retention('audit'), 'set_with': 'retention-set'},
        {'data': 'DMARC and TLS reports', 'days': retention('reports'), 'set_with': 'retention-set'},
        {'data': 'originals of disarmed attachments', 'days': retention('cdr'), 'set_with': 'retention-set'},
        {'data': 'reported phishing mails', 'days': retention('phish'), 'set_with': 'retention-set'},
        {'data': 'web sessions', 'days': 1, 'set_with': ''},
        {'data': 'local backups', 'days': BACKUP_KEEP_DAYS, 'set_with': ''},
        {'data': 'event log (SIEM, OTLP, Wazuh)', 'days': 120, 'set_with': 'monthly rotation, 4 files'}],
        'tenants': [{'tenant': names.get(tid, str(tid)), **days} for tid, days in sorted(retention_tenants().items())],
        'tenant_kinds': list(RETENTION_TENANT_KINDS),
        'tenant_elsewhere': 'Per tenant in their own settings: headers of all mail and held mail for users (domain settings of the tenant), '
                            'emergency copies (Emergency access). The mail report statistics hold counts only.',
        'note': 'Keep personal data only as long as needed (GDPR Art. 5 (1) e). Templates for the records of processing: docs/datenschutz.'
                + (' With EU relation the days are part of the record of processing (GDPR Art. 30) and of the erasure duty (Art. 17).'
                   if _safe(lambda: eu_state()['global'] != 'no', True) else '')}


def retention_set(args):
    """Days to keep the audit log, DMARC and TLS reports, originals of disarmed attachments or reported phishing mails."""
    kind, days, tenant = (args.data or '').strip(), (args.days or '').strip(), (getattr(args, 'tenant', '') or '').strip()
    state = _json_read(RETENTION_FILE, {})
    if tenant:
        # 9h: own days of a tenant; inherit takes the global days again.
        if kind not in RETENTION_TENANT_KINDS:
            raise EfaError('Per tenant: ' + ', '.join(RETENTION_TENANT_KINDS))
        tid = str(_tenant_id(tenant))
        if identity_now and identity_now.get('tenant_ids') is not None and int(tid) not in identity_now['tenant_ids']:
            raise EfaError('Not allowed: this tenant is outside your scope.')
        kinds = state.setdefault('tenants', {}).setdefault(tid, {})
        if days == 'inherit':
            kinds.pop(kind, None)
        else:
            low, high = RETENTION_TENANT_LIMITS[kind]
            if not days.isdigit() or not low <= int(days) <= high:
                raise EfaError(f'Days for {kind}: {low} to {high}, or inherit.')
            # A tenant admin may keep data shorter, never longer than the global days; longer only a super admin.
            if identity_now and identity_now.get('tenant_ids') is not None and int(days) > retention_global(kind):
                raise EfaError(f'Longer than the global {retention_global(kind)} days only by a super admin.')
            kinds[kind] = int(days)
        _json_write(RETENTION_FILE, state)
        _audit(f'retention of {kind} for tenant {tenant} set to {days} by {_dmarc_who()}')
        return retention_status(None)
    if kind not in RETENTION_DEFAULTS:
        raise EfaError('Data: ' + ', '.join(RETENTION_DEFAULTS))
    low, high = RETENTION_LIMITS[kind]
    if not days.isdigit() or not low <= int(days) <= high:
        raise EfaError(f'Days for {kind}: {low} to {high}.')
    state[kind] = int(days)
    _json_write(RETENTION_FILE, state)
    _audit(f'retention of {kind} set to {days} days by {_dmarc_who()}')
    return retention_status(None)


def search_pattern(text):
    """A plain value matches exactly and can use the index, * is the wildcard."""
    escaped = text.strip().replace('\\', '\\\\').replace('%', '\\%').replace('_', '\\_')
    return escaped.replace('*', '%')


def search_where(filters, domains, pseudo_key=None):
    """The WHERE clause of a message search. Values only ever travel as parameters. With pseudo_key an exact address also finds
    its pseudonymised rows (D2). G7-1: filters['match'] == 'any' joins the conditions with OR, in a bracket of their own; the
    time frame and the domains of the login always stay AND around it, so no OR can reach mail outside them."""
    match = (filters.get('match') or 'all').strip()
    if match not in SEARCH_MATCHES:
        raise EfaError('Match: all or any.')
    where, params = [], []
    for column in ('sender', 'rcpt', 'ip', 'qid', 'action', 'message_id', 'header_from', 'reply_to', 'return_path', 'x_mailer'):
        value = filters.get(column, '').strip()
        if value:
            if pseudo_key and column in PSEUDO_COLUMNS + ('rcpt',) and '*' not in value and '@' in value:
                where.append(f'({column} LIKE %s OR {column} LIKE %s)')
                params += [search_pattern(value), search_pattern(pseudonym(pseudo_key, value))]
                continue
            where.append(f'{column} LIKE %s')
            params.append(search_pattern(value))
    subject = filters.get('subject', '').strip()
    if subject:
        words = re.findall(r'\w{3,}', subject)
        if words and '*' not in subject:
            where.append('MATCH(subject) AGAINST(%s IN BOOLEAN MODE)')
            params.append(' '.join('+' + word for word in words))
        else:
            where.append('subject LIKE %s')
            params.append('%' + search_pattern(subject) + '%')
    if match == 'any' and len(where) > 1:
        where = ['(' + ' OR '.join(where) + ')']
    for key, sign in (('date_from', '>='), ('date_to', '<=')):
        value = filters.get(key, '').strip()
        if value:
            if not re.fullmatch(r'\d{4}-\d{2}-\d{2}( \d{2}:\d{2}(:\d{2})?)?', value):
                raise EfaError('Dates like 2026-11-05 or 2026-11-05 14:30.')
            where.append(f'ts {sign} %s')
            params.append(value + (' 23:59:59' if sign == '<=' and len(value) == 10 else ''))
    if domains is not None:
        # Empty list: this login sees no mail at all.
        scope = [f'{column} LIKE %s' for column in ('rcpt', 'sender') for _ in domains]
        where.append('(' + ' OR '.join(scope) + ')' if scope else 'FALSE')
        params += [f'%@{domain}%' for _ in ('rcpt', 'sender') for domain in domains]
    return ('WHERE ' + ' AND '.join(where) if where else ''), params


SEARCH_MATCHES = ('all', 'any')
# G7-1: saved searches of a login, in its personal settings. Only the filters, never results.
SAVED_SEARCH_KEYS = ('sender', 'rcpt', 'subject', 'ip', 'qid', 'action', 'date_from', 'date_to', 'message_id', 'header_from', 'reply_to',
                     'return_path', 'x_mailer', 'match')
SAVED_SEARCH_MAX = 20


def _prefs_write(username, prefs):
    if username:
        _admin_query('UPDATE users SET prefs = %s WHERE username = %s', (json.dumps(prefs), username))
    else:
        _json_write(ADMIN_PREFS, prefs)


def search_saved(_args):
    """G7-1: the saved searches of this login."""
    return {'searches': prefs_of(identity_now['username'] if identity_now else '').get('searches', [])}


def search_save(args):
    """G7-1: save the filters of a search under a name; the same name again replaces it."""
    name = (args.name or '').strip()
    if not re.fullmatch(r'[\w .,:()/+-]{1,60}', name):
        raise EfaError('Name: 1 to 60 letters, digits, spaces and . , : ( ) / + -')
    filters = {key: (getattr(args, key, '') or '').strip() for key in SAVED_SEARCH_KEYS}
    filters = {key: value for key, value in filters.items() if value}
    if any(len(value) > 200 for value in filters.values()):
        raise EfaError('A filter is longer than 200 characters.')
    search_where(filters, None)  # the same checks as the search itself
    if not [key for key in filters if key != 'match']:
        raise EfaError('Nothing to save: give at least one filter.')
    username = identity_now['username'] if identity_now else ''
    prefs = prefs_of(username)
    searches = [item for item in prefs.get('searches', []) if item.get('name') != name]
    if len(searches) >= SAVED_SEARCH_MAX:
        raise EfaError(f'At most {SAVED_SEARCH_MAX} saved searches; delete one first.')
    prefs['searches'] = sorted(searches + [{'name': name, 'filters': filters}], key=lambda item: item['name'].lower())
    _prefs_write(username, prefs)
    return {'searches': prefs['searches']}


def search_delete(args):
    """G7-1: delete a saved search of this login."""
    name = (args.name or '').strip()
    username = identity_now['username'] if identity_now else ''
    prefs = prefs_of(username)
    kept = [item for item in prefs.get('searches', []) if item.get('name') != name]
    if len(kept) == len(prefs.get('searches', [])):
        raise EfaError('No saved search of that name.')
    prefs['searches'] = kept
    _prefs_write(username, prefs)
    return {'searches': kept}


def search_csv(rows):
    """A cell a spreadsheet would run as a formula gets a leading quote: senders and subjects come from outside."""
    out = io.StringIO()
    writer = csv.writer(out)
    writer.writerow(SEARCH_COLUMNS)
    for row in rows:
        cells = ['' if row.get(column) is None else str(row[column]) for column in SEARCH_COLUMNS]
        writer.writerow(["'" + cell if cell[:1] in ('=', '+', '-', '@', '\t', '\r') else cell for cell in cells])
    return out.getvalue()


def message_search(args):
    """Search all mail in the log with filters, also as CSV. Exact values use the index, * is the wildcard."""
    fmt = (args.format or '').strip()
    as_csv = fmt in ('csv', 'json')
    if as_csv and identity_now and 'export' not in identity_now['grants']:
        raise EfaError('Not allowed: the export needs the permission export.')
    top = SEARCH_LIMIT_CSV if as_csv else SEARCH_LIMIT_PAGE
    limit = (args.limit or '').strip() or '100'
    if not limit.isdigit() or not 1 <= int(limit) <= top:
        raise EfaError(f'Limit must be 1 to {top}.')
    filters = {key: getattr(args, key, '') or '' for key in ('sender', 'rcpt', 'subject', 'ip', 'qid', 'action', 'date_from', 'date_to', 'message_id',
                                                                 'header_from', 'reply_to', 'return_path', 'x_mailer', 'match')}
    # 6.0.0.6: live filtering of the advanced search asks only for the rows after the newest it shows (the primary key, cheap).
    after = (getattr(args, 'after_id', '') or '').strip()
    if after and not after.isdigit():
        raise EfaError('after_id must be a number.')
    readable = pseudo_days() and (identity_now is None or 'mail.view_headers' in identity_now['grants'])
    where, params = search_where(filters, identity_now['domains'] if identity_now else None, _pseudo_key() if readable else None)
    if after:
        where, params = (where + ' AND ' if where else 'WHERE ') + 'id > %s', params + [int(after)]
    db = _maillog_db()
    try:
        with db.cursor() as cur:
            cur.execute('SELECT id, CAST(ts AS CHAR) AS ts, qid, message_id, sender, rcpt, ip, action, score, subject, spf, dkim, dmarc '
                        f'FROM maillog {where} ORDER BY ts DESC, id DESC LIMIT %s', (*params, int(limit)))
            rows = cur.fetchall()
    finally:
        db.close()
    rows = subject_filter(identity_now, 'message-search', scoped_result(identity_now, 'message-search', {'mails': rows}), subjects_shown())['mails']
    rows = local_times(rows, _reader_timezone())
    if fmt == 'json':
        return {'json': json.dumps(rows, indent=1, default=str), 'rows': len(rows)}
    if as_csv:
        return {'csv': search_csv(rows), 'rows': len(rows)}
    rows = geo_rows(rows)
    return {'mails': rows, **({'geo_credit': GEOIP_CREDIT} if any('origin' in row for row in rows) else {})}


SIEM_CA_DEFAULT = '/etc/pki/tls/certs/ca-bundle.crt'


def siem_conf(target, port, protocol, kind, ca_file=SIEM_CA_DEFAULT):
    """rsyslog sends mail, audit and firewall lines on, over TLS with the certificate of the target checked by its name. The
    queue is bounded, so a dead target only costs the oldest lines. tcp and udp stay only for a setup of before (S1 notice)."""
    if kind == 'eve':
        return siem_eve_conf(target, port, ca_file)
    template = 'RSYSLOG_SyslogProtocol23Format' if kind == 'rfc5424' else 'efaSiemJson'
    json_template = """template(name="efaSiemJson" type="list" option.jsonf="on") {
  property(outname="@timestamp" name="timereported" dateformat="rfc3339" format="jsonf")
  property(outname="host" name="hostname" format="jsonf")
  property(outname="facility" name="syslogfacility-text" format="jsonf")
  property(outname="severity" name="syslogseverity-text" format="jsonf")
  property(outname="program" name="programname" format="jsonf")
  property(outname="message" name="msg" format="jsonf")
}
""" if kind == 'json' else ''
    tls = (f'StreamDriver="gtls" StreamDriverMode="1" StreamDriverAuthMode="x509/name" StreamDriverPermittedPeers="{target}"\n'
           f'         StreamDriver.CAFile="{ca_file}"\n         ') if protocol == 'tls' else ''
    return f"""# Written by efactl siem-set. Do not edit: the next change replaces it.
module(load="imfile")
input(type="imfile" File="{AUDIT_LOG}" Tag="efa-audit:" Facility="local6" Severity="info" freshStartTail="on")
input(type="imfile" File="{FIREWALL_LOG}" Tag="efa-firewall:" Facility="local6" Severity="info" freshStartTail="on")
input(type="imfile" File="{EVENTS_LOG}" Tag="efa-events:" Facility="local6" Severity="info" freshStartTail="on")
{json_template}if ($syslogfacility-text == "mail" or $programname startswith "efa-" or $programname startswith "fail2ban") then {{
  action(type="omfwd" target="{target}" port="{port}" protocol="{'tcp' if protocol == 'tls' else protocol}" template="{template}"
         {tls}queue.type="LinkedList" queue.size="10000" queue.discardMark="9000" action.resumeRetryCount="-1")
}}
"""



def siem_eve_conf(target, port, ca_file):
    """E1: the lines of the EVE file as they are, one JSON object per line, over TLS."""
    return f"""# Written by efactl siem-set. Do not edit: the next change replaces it.
module(load="imfile")
input(type="imfile" File="{EVE_FILE}" Tag="efa-eve:" Facility="local6" Severity="info" freshStartTail="on")
template(name="efaEve" type="string" string="%msg%\\n")
if ($programname == "efa-eve") then {{
  action(type="omfwd" target="{target}" port="{port}" protocol="tcp" template="efaEve"
         StreamDriver="gtls" StreamDriverMode="1" StreamDriverAuthMode="x509/name" StreamDriverPermittedPeers="{target}"
         StreamDriver.CAFile="{ca_file}"
         queue.type="LinkedList" queue.size="10000" queue.discardMark="9000" action.resumeRetryCount="-1")
  stop
}}
"""


def eve_settings_write(on):
    """What efa-maillog reads for the EVE lines: own domains, tenants, and the key of the pseudonyms while D2 is on."""
    if not on:
        if os.path.exists(EVE_SETTINGS):
            os.remove(EVE_SETTINGS)
        return
    os.makedirs(EVE_DIR, mode=0o750, exist_ok=True)
    shutil.chown(EVE_DIR, 'efa-mail', 'efa-mail')
    key = ''
    if pseudo_days():
        if not os.path.exists(EVE_KEY):
            fd = os.open(EVE_KEY, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
            with os.fdopen(fd, 'w') as f:
                f.write(secrets.token_hex(32) + '\n')
        key = open(EVE_KEY).read().strip()
    tenants = {domain: str(tid) for tid, domains in _tenant_domains_or_none().items() for domain in domains}
    _json_write(EVE_SETTINGS, {'enabled': True, 'local_domains': _local_domains(), 'tenants': tenants, 'key': key, 'host': own_hostname()}, mode=0o640)
    shutil.chown(EVE_SETTINGS, 'root', 'efa-web')


def eve_event_line(record):
    """An eFa-next event (_event) as EVE line: event_type efa, the event in the efa part."""
    return {'timestamp': record.get('timestamp', ''), 'event_type': 'efa', 'src_ip': record.get('src_ip', ''), 'proto': '',
            'efa': {name: value for name, value in record.items() if name not in ('timestamp', 'src_ip')}}


def siem_stop_plain(_args):
    """Upgrade step (S1, fail closed): an export of before over plain TCP or UDP stops; its settings stay for the switch to TLS."""
    state = _json_read(SIEM_FILE, {})
    if state.get('siem') and state.get('protocol') in ('tcp', 'udp') and os.path.exists(SIEM_CONF):
        os.remove(SIEM_CONF)
        _platform().service_try_restart('rsyslog')
        state['stopped_plain'] = True
        _json_write(SIEM_FILE, state)
    return {'stopped': bool(state.get('stopped_plain'))}


def siem_status(_args):
    """Forwarding of logs to a SIEM. Off by default."""
    return _json_read(SIEM_FILE, {'siem': False})


def siem_set(args):
    """Send logs to a SIEM through rsyslog, as RFC 5424 or JSON. A target rsyslog rejects is not kept."""
    if not _on_off(args.mode):
        if os.path.exists(SIEM_CONF):
            os.remove(SIEM_CONF)
        _json_write(SIEM_FILE, {'siem': False})
        eve_settings_write(False)
        events_marker()
        subprocess.run(['systemctl', 'try-restart', 'rsyslog'], check=False, capture_output=True)
        return {'siem': False}
    target, port, protocol, kind = args.target.strip(), args.port.strip() or '6514', args.protocol.strip() or 'tls', args.format.strip() or 'rfc5424'
    ca_file = (getattr(args, 'ca_file', '') or '').strip() or SIEM_CA_DEFAULT
    try:
        ipaddress.ip_address(target)
    except ValueError:
        if not DOMAIN_RE.match(target):
            raise EfaError('Target: a host name or an IP address.')
    if not port.isdigit() or not 1 <= int(port) <= 65535:
        raise EfaError('Port: 1 to 65535.')
    if protocol in ('tcp', 'udp'):
        raise EfaError('Plain tcp or udp would send the logs readable over the network: use tls (port 6514 by default).')
    if protocol != 'tls':
        raise EfaError('Protocol: tls.')
    if not os.path.isfile(ca_file):
        raise EfaError(f'CA file {ca_file} is not there.')
    if ca_file != SIEM_CA_DEFAULT:
        # rsyslog runs confined by SELinux: it reads a copy below /etc/pki, not the file where the admin put it.
        with open(ca_file) as f:
            pem = f.read()
        if 'BEGIN CERTIFICATE' not in pem:
            raise EfaError('CA file: a certificate in PEM format.')
        os.makedirs(ETC + '/pki/rsyslog', exist_ok=True)
        ca_file = ETC + '/pki/rsyslog/efa-siem-ca.pem'
        _write(ca_file, pem)
        os.chmod(ca_file, 0o644)
        _platform().restore_context(ca_file)
    if not _platform().package_installed('rsyslog-gnutls'):
        _dnf_install(['rsyslog-gnutls'], 'siem')
    if kind not in SIEM_FORMATS:
        raise EfaError('Format: ' + ' or '.join(SIEM_FORMATS) + '.')
    previous = open(SIEM_CONF).read() if os.path.exists(SIEM_CONF) else None
    _write(SIEM_CONF, siem_conf(target, port, protocol, kind, ca_file))
    done = subprocess.run(['rsyslogd', '-N1'], capture_output=True, text=True)
    if done.returncode != 0:
        if previous is None:
            os.remove(SIEM_CONF)
        else:
            _write(SIEM_CONF, previous)
        raise EfaError('rsyslog rejected this, nothing changed: ' + (done.stderr or done.stdout).strip()[-200:])
    subprocess.run(['systemctl', 'restart', 'rsyslog'], check=True, capture_output=True)
    state = {'siem': True, 'target': target, 'port': int(port), 'protocol': protocol, 'format': kind, 'ca_file': ca_file}
    _json_write(SIEM_FILE, state)
    eve_settings_write(kind == 'eve')
    events_marker()
    return state


def metric_label(value):
    return str(value).replace('\\', '\\\\').replace('"', '\\"').replace('\n', ' ')


BAYES_CONF = RSPAMD_DIR + '/local.d/classifier-bayes.conf'
# The default of rspamd when the file does not set it.
BAYES_MIN_LEARNS = 200


def bayes_parse(stat_text, conf_text):
    """Learned spam and ham from rspamc stat, the switches from classifier-bayes.conf. Only reads."""
    learned = {'spam': 0, 'ham': 0}
    for match in re.finditer(r'^Statfile: BAYES_(SPAM|HAM) .*?learned: (\d+)', stat_text, re.M):
        learned[match.group(1).lower()] += int(match.group(2))
    def value(name):
        found = re.search(rf'^\s*{name}\s*=\s*([^;#\n]+)', conf_text, re.M)
        return found.group(1).strip().strip('"') if found else None
    min_learns = int(value('min_learns')) if (value('min_learns') or '').isdigit() else BAYES_MIN_LEARNS
    autolearn = value('autolearn')
    return {'spam_learned': learned['spam'], 'ham_learned': learned['ham'], 'min_learns': min_learns,
            'active': learned['spam'] >= min_learns and learned['ham'] >= min_learns,
            'autolearn': 'off' if autolearn in (None, 'false') else ('on, rspamd thresholds' if autolearn == 'true' else f'on: {autolearn}'),
            'per_user': value('per_user') not in (None, 'false'), 'backend': value('backend') or 'redis'}


# The processes the dashboard counts, by their name or the program in their command line.
DASH_PROCESSES = {'Postfix': ('master', 'smtpd', 'smtp', 'qmgr', 'pickup', 'cleanup', 'tlsmgr', 'anvil', 'postscreen', 'proxymap', 'trivial-rewrite',
                              'bounce', 'lmtp', 'local', 'showq', 'scache', 'verify', 'dnsblog', 'tlsproxy', 'smtp-sink'),
                  'rspamd': ('rspamd',), 'Milter': ('efa-milter-health', 'efa-milter-health.py'), 'ClamAV': ('clamd',),
                  'Unbound': ('unbound',), 'MariaDB': ('mariadbd', 'mysqld'), 'Redis': ('redis-server',)}
DASH_QUEUE_WARN = 100


def dash_queues(entries, own):
    """postqueue -j lines to counts per queue, split into inbound (to an own domain) and outbound."""
    counts = {}
    for entry in entries:
        recipients = [item.get('address', '') for item in entry.get('recipients') or []]
        way = 'in' if recipients and all(address.rpartition('@')[2].lower() in own for address in recipients) else 'out'
        name = entry.get('queue_name', 'unknown')
        counts.setdefault(name, {'in': 0, 'out': 0})[way] += 1
    return counts


def dash_minutes(rows, now):
    """The last 60 minutes, oldest first, each with mails, spam and viruses; minutes without mail count 0."""
    found = {row['minute']: row for row in rows}
    minutes = []
    for back in range(59, -1, -1):
        key = (now - datetime.timedelta(minutes=back)).strftime('%H:%M')
        row = found.get(key, {})
        minutes.append({'minute': key, 'mails': int(row.get('mails') or 0), 'spam': int(row.get('spam') or 0), 'virus': int(row.get('virus') or 0)})
    return minutes


def dash_stats(_args):
    """Today's totals, the last hour per minute, queues and processes for the dashboard. Reads only; the host-wide parts need all domains."""
    domains = identity_now['domains'] if identity_now else None
    where, params = search_where({'date_from': _today().isoformat()}, domains)
    hour_where, hour_params = search_where({'date_from': (datetime.datetime.now() - datetime.timedelta(minutes=59)).strftime('%Y-%m-%d %H:%M')}, domains)
    spam = "action IN ('add header', 'rewrite subject')"
    db = _maillog_db()
    try:
        with db.cursor() as cur:
            cur.execute("SELECT COUNT(*) AS processed, COALESCE(SUM(size), 0) AS bytes, SUM(action = 'no action') AS clean, SUM(" + spam + ") AS spam,"
                        " SUM(action = 'reject' AND COALESCE(threat, '') = '') AS high_spam, SUM(threat LIKE 'virus:%%') AS viruses,"
                        " SUM(threat LIKE 'file:%%') AS blocked_files FROM maillog " + where, params)
            today = {key: int(value or 0) for key, value in cur.fetchone().items()}
            cur.execute("SELECT SUBSTRING(threat, 7) AS name, COUNT(*) AS n FROM maillog " + where + (' AND ' if where else ' WHERE ')
                        + "threat LIKE 'virus:%%' GROUP BY name ORDER BY n DESC LIMIT 1", params)
            top = cur.fetchone()
            cur.execute("SELECT DATE_FORMAT(ts, '%%H:%%i') AS minute, COUNT(*) AS mails, SUM(" + spam + " OR action = 'reject' AND COALESCE(threat, '') = '') AS spam,"
                        " SUM(threat LIKE 'virus:%%') AS virus FROM maillog " + hour_where + ' GROUP BY minute', hour_params)
            minutes = dash_minutes(cur.fetchall(), datetime.datetime.now())
    finally:
        db.close()
    processed = today['processed']
    today['megabytes'] = round(today.pop('bytes') / 1048576, 1)
    today['other'] = max(0, processed - today['clean'] - today['spam'] - today['high_spam'] - today['viruses'] - today['blocked_files'])
    today['percent'] = {key: round(100 * today[key] / processed, 1) if processed else 0
                        for key in ('clean', 'spam', 'high_spam', 'viruses', 'blocked_files', 'other')}
    today['top_virus'] = top['name'] if top else None
    result = {'today': today, 'last_hour': minutes}
    if domains is None:
        done = subprocess.run(['postqueue', '-j'], capture_output=True, text=True, timeout=30)
        entries = [json.loads(line) for line in done.stdout.splitlines() if line.startswith('{')] if done.returncode == 0 else []
        queues = dash_queues(entries, {line.split()[0].lower() for line in _read_lines(TRANSPORT) if line.split()})
        result['queues'] = {'counts': queues, 'warn': sum(sum(way.values()) for way in queues.values()) >= DASH_QUEUE_WARN}
        try:
            result['processes'] = _platform().process_counts(DASH_PROCESSES)
        except Exception:  # the StepError of the platform layer; the dashboard shows the rest
            result['processes'] = None
    return result


# 6.0.0.6 (Hans): the state of attack on this host, for the dashboard and the banner on every page of the web interface.
# efa-web runs threat-run once a minute in its own load thread (no own timer, no own daemon). Everything comes from what the
# host counts anyway: the journal of Postfix, Fail2Ban and efa-web since the last run, the TCP counters of the kernel, the mail
# log and the queue folders. Nothing asks DNS or another host; the run stays well under a second on a busy server.
THREAT_FILE = ETC + '/eFa/threat.json'
THREAT_STATE = '/var/lib/eFa/threat-state.json'
THREAT_SENSITIVITY = {'low': 2.0, 'normal': 1.0, 'high': 0.5}
# Minutes kept for the 10-minute sums and the normal value (median) of the last hour.
THREAT_RING = 60
# An alert stays on this long after its value fell back, so it does not flicker on and off with every minute.
THREAT_HOLD = 300
THREAT_CONNECT_RE = re.compile(r'^(?:CONNECT from \[([0-9a-fA-F.:]+)\]|connect from \S*\[([0-9a-fA-F.:]+)\])')
THREAT_AUTH_RE = re.compile(r'\[([0-9a-fA-F.:]+)\]: SASL \S+ authentication failed')
THREAT_REJECT_RE = re.compile(r'NOQUEUE: reject: |^(?:PREGREET|DNSBL rank|HANGUP after|BARE NEWLINE|COMMAND PIPELINING|NON-SMTP COMMAND) ')
THREAT_QUEUES = ('incoming', 'active', 'deferred', 'hold')
# What each kind is, for the texts of efa-web and the link to the page that helps: kind -> (group, page, card).
THREAT_KINDS = {
    'smtp_flood': ('attack', 'sec', 'firewall-show'), 'syn_flood': ('attack', 'sec', 'firewall-show'),
    'password_attack': ('attack', 'sec', 'login-lockout-status'), 'spam_wave': ('attack', 'spam', 'spam-scores-set'),
    'virus_wave': ('attack', 'spam', 'spam-scores-set'), 'reject_wave': ('attack', 'sec', 'firewall-show'),
    'ban_wave': ('attack', 'sec', 'login-lockout-status'), 'queue_flood': ('problem', 'queue', 'queue-list'),
    'service_down': ('problem', 'dash', 'status'), 'disk_full': ('problem', 'maint', 'load-set'),
    'memory_low': ('problem', 'maint', 'load-set'), 'load_high': ('problem', 'maint', 'load-set'),
    'swap_high': ('problem', 'maint', 'load-set'),
}
THREAT_LEVELS = ('ok', 'warn', 'alert')


def threat_settings():
    data = _json_read(THREAT_FILE, {})
    return {'sensitivity': data.get('sensitivity') if data.get('sensitivity') in THREAT_SENSITIVITY else 'normal'}


def threat_limits(factor):
    """(warn, alert) per kind at a sensitivity. The fixed floors keep a quiet server from crying wolf at its first busy minute."""
    return {'smtp_flood': (120 * factor, 300 * factor), 'syn_flood': (50 * factor, 200 * factor), 'password_attack': (30 * factor, 100 * factor),
            'spam_wave': (60 * factor, 150 * factor), 'virus_wave': (5 * factor, 20 * factor), 'reject_wave': (300 * factor, 10 ** 9),
            'ban_wave': (30 * factor, 10 ** 9), 'queue_flood': (100 * factor, 1000 * factor)}


def threat_journal_counts(lines):
    """Per run: connections, failed logins, rejects and bans, with the addresses that caused most of them."""
    counts = {'connections': 0, 'auth_failed': 0, 'rejects': 0, 'bans': 0}
    sources = {}
    smtpd_connects, screen_connects = [], []
    for line in lines:
        connect = THREAT_CONNECT_RE.search(line)
        if connect:
            (screen_connects if connect.group(1) else smtpd_connects).append(connect.group(1) or connect.group(2))
            continue
        auth = THREAT_AUTH_RE.search(line)
        if auth:
            counts['auth_failed'] += 1
            sources[auth.group(1)] = sources.get(auth.group(1), 0) + 1
            continue
        login = LOGIN_RE.search(line)
        if login and login.group(1) == 'failed':
            counts['auth_failed'] += 1
            sources[login.group(3)] = sources.get(login.group(3), 0) + 1
            continue
        if THREAT_REJECT_RE.search(line):
            counts['rejects'] += 1
            continue
        ban = BAN_RE.search(line)
        if ban and ban.group(2) == 'Ban':
            counts['bans'] += 1
    # With postscreen every client shows there first; smtpd sees only those it lets through, so it would count twice.
    connects = screen_connects or smtpd_connects
    counts['connections'] = len(connects)
    for address in connects:
        sources[address] = sources.get(address, 0) + 1
    return counts, dict(sorted(sources.items(), key=lambda item: -item[1])[:5])


def threat_queue_size(spool='/var/spool/postfix'):
    total = 0
    for name in THREAT_QUEUES:
        for _root, _dirs, files in os.walk(os.path.join(spool, name)):
            total += len(files)
    return total


def threat_mail(state, now):
    """Mail, spam and viruses of the last 10 minutes from the mail log, and the normal value per 10 minutes of the day before
    (renewed every 15 minutes: that query reads a day of rows)."""
    spam = "action IN ('add header', 'rewrite subject') OR action = 'reject' AND COALESCE(threat, '') = ''"
    db = _maillog_db()
    try:
        with db.cursor() as cur:
            cur.execute('SELECT COUNT(*) AS mails, SUM(' + spam + ") AS spam, SUM(threat LIKE 'virus:%%') AS virus FROM maillog "
                        'WHERE ts >= NOW() - INTERVAL 10 MINUTE')
            recent = {key: int(value or 0) for key, value in cur.fetchone().items()}
            base = state.get('mail_base')
            if not base or now - base.get('at', 0) > 900:
                cur.execute('SELECT COUNT(*) AS mails, SUM(' + spam + ") AS spam, SUM(threat LIKE 'virus:%%') AS virus FROM maillog "
                            'WHERE ts >= NOW() - INTERVAL 1 DAY AND ts < NOW() - INTERVAL 1 HOUR')
                # 23 hours = 138 blocks of 10 minutes.
                base = {key: round(int(value or 0) / 138, 1) for key, value in cur.fetchone().items()}
                base['at'] = now
                state['mail_base'] = base
    finally:
        db.close()
    return recent, base


def _median(values):
    values = sorted(values)
    return values[len(values) // 2] if values else 0


def threat_judge(ring, mail, mail_base, queue, down, resources, factor):
    """The kinds that are on now, each with its level, value and normal value. ring: the per-minute samples, newest last."""
    limits = threat_limits(factor)
    last, ten = (ring[-1] if ring else {}), ring[-10:]
    hour = ring[:-1] or ring
    found = {}

    def judge(kind, value, normal=0, factor_of_normal=0):
        warn, alert = limits[kind]
        # Above the floor, and on a busy server also well above its own normal value.
        level = 'alert' if value >= max(alert, normal * factor_of_normal * 2) else 'warn' if value >= max(warn, normal * factor_of_normal) else None
        if level:
            found[kind] = {'level': level, 'value': round(value), 'normal': round(normal, 1)}

    judge('smtp_flood', last.get('connections', 0), _median([item.get('connections', 0) for item in hour]), 4)
    judge('syn_flood', last.get('syn', 0))
    judge('password_attack', sum(item.get('auth_failed', 0) for item in ten))
    judge('reject_wave', last.get('rejects', 0), _median([item.get('rejects', 0) for item in hour]), 8)
    judge('ban_wave', sum(item.get('bans', 0) for item in ten))
    if mail is not None:
        share = mail['spam'] / mail['mails'] if mail['mails'] else 0
        if share >= 0.5:
            judge('spam_wave', mail['spam'], (mail_base or {}).get('spam', 0), 3)
            if 'spam_wave' in found:
                found['spam_wave']['share'] = round(100 * share)
        judge('virus_wave', mail['virus'], (mail_base or {}).get('virus', 0), 3)
    if queue is not None:
        judge('queue_flood', queue)
    if down:
        found['service_down'] = {'level': 'alert', 'value': len(down), 'normal': 0, 'names': down}
    for kind, (value, warn, alert) in resources.items():
        if value >= warn:
            found[kind] = {'level': 'alert' if value >= alert else 'warn', 'value': round(value), 'normal': 0}
    sources = {}
    for item in ten:
        for address, count in item.get('top', {}).items():
            sources[address] = sources.get(address, 0) + count
    top = [[address, count] for address, count in sorted(sources.items(), key=lambda pair: -pair[1])[:5]]
    for kind in ('smtp_flood', 'password_attack', 'reject_wave'):
        if kind in found and top:
            found[kind]['top'] = top
    return found


def swap_used_percent(text=None):
    """G7-3: the share of the swap in use (0 to 100), from the memory counters of the kernel; None on a host without swap."""
    if text is None:
        text = _platform().meminfo_text()
    memory = {}
    for line in text.splitlines():
        name, _sep, rest = line.partition(':')
        if name in ('SwapTotal', 'SwapFree') and rest.split():
            memory[name] = int(rest.split()[0])
    if not memory.get('SwapTotal'):
        return None
    return round(100 * (1 - memory.get('SwapFree', 0) / memory['SwapTotal']), 1)


def threat_resources():
    """Disk, memory, swap and load: (value, warn, alert) each, the same in every sensitivity (a full disk stops mail)."""
    found = {}
    disks = []
    for mount in ('/', '/var'):
        try:
            stat = os.statvfs(mount)
        except OSError:
            continue
        if stat.f_blocks:
            disks.append(100 * (1 - stat.f_bavail / stat.f_blocks))
    if disks:
        found['disk_full'] = (max(disks), 90, 95)
    try:
        found['memory_low'] = (_platform().memory_used_percent(), 92, 97)
    except Exception:  # the StepError of the platform layer, or a system without these values: the rest still counts
        pass
    swap = _safe(swap_used_percent, None)
    if swap is not None:
        found['swap_high'] = (swap, 50, 80)
    cpus = os.cpu_count() or 1
    found['load_high'] = (100 * os.getloadavg()[1] / cpus, 200, 400)
    return found


def threat_track(state, found, now):
    """Keeps when each kind began; a kind whose value fell back stays THREAT_HOLD seconds, marked as easing."""
    active = state.get('active', {})
    for kind, item in found.items():
        before = active.get(kind, {})
        alert_at = now if item['level'] == 'alert' else before.get('alert_at', 0)
        level = 'alert' if now - alert_at <= THREAT_HOLD else item['level']
        active[kind] = {**item, 'level': level, 'since': before.get('since', now), 'seen': now, 'alert_at': alert_at}
    for kind in list(active):
        if kind not in found:
            if now - active[kind].get('seen', 0) > THREAT_HOLD:
                del active[kind]
            else:
                active[kind]['easing'] = True
    state['active'] = active
    return active


FIRSTBOOT_PENDING = '/var/lib/eFa/firstboot-pending'
# After a boot the services start one after the other (clamd takes a minute): their start is no outage.
THREAT_BOOT_GRACE = 300


def _setup_running():
    """Until the setup is done: efa-init enabled or running (the setup disables it at its end, the package scripts restart
    it) or the first boot after the setup pending. The threat and package checks wait: the setup stops and starts services."""
    pl = _safe(_platform, None)
    return (os.path.exists(FIRSTBOOT_PENDING)
            or bool(pl and (_safe(lambda: pl.service_is_enabled('efa-init'), False) or _safe(lambda: pl.service_is_active('efa-init'), False))))


def _uptime():
    # Seconds since boot (suspend included), the number of /proc/uptime without reading it.
    try:
        return time.clock_gettime(time.CLOCK_BOOTTIME)
    except (AttributeError, OSError):
        return THREAT_BOOT_GRACE


# A unit in a restart loop can be up at every check: its automatic restarts (NRestarts) count instead. 3 or more within 10
# minutes is an alarm at once, whatever the checks saw.
THREAT_FLAP_UNITS = ('postfix', 'rspamd', 'redis', 'clamd@scan', 'nginx', 'mariadb', 'unbound', 'fail2ban', 'firewalld', 'efa-web',
                     'efactl-runner', 'efa-milter-health')
THREAT_FLAP_RESTARTS = 3
THREAT_FLAP_WINDOW = 600


def threat_flapping(state, counts, now):
    """['service:NAME (restarting)'] for units with THREAT_FLAP_RESTARTS automatic restarts within THREAT_FLAP_WINDOW. counts:
    {name: NRestarts} now; the history of the window is kept in state['restarts']. A counter that went down (the unit was
    started by hand) starts over."""
    history = [item for item in state.get('restarts', []) if now - item['at'] <= THREAT_FLAP_WINDOW]
    history.append({'at': now, 'counts': counts})
    state['restarts'] = history
    flapping = []
    for name, count in sorted(counts.items()):
        seen = [item['counts'][name] for item in history if name in item['counts']]
        # Only the stretch since the counter last went down counts (a start by hand resets NRestarts).
        start = max((index for index in range(1, len(seen)) if seen[index] < seen[index - 1]), default=0)
        if seen and seen[-1] - min(seen[start:]) >= THREAT_FLAP_RESTARTS:
            flapping.append(f'service:{name} (restarting)')
    return flapping


def threat_down_confirmed(state, down):
    """The services down at this check and the one before (a minute): a restart is no alarm, an outage alarms a minute later.
    2026-11-17: the restart of rspamd right after the first boot of a new install stood as "service down" and was held."""
    before = set(state.get('down_before') or [])
    state['down_before'] = list(down)
    return [name for name in down if name in before]


def threat_run(_args):
    """Once a minute from efa-web: reads what changed since the last run, judges it and keeps the result for threat-status."""
    if identity_now and identity_now.get('domains') is not None:
        raise EfaError('Only for the whole host.')
    if _setup_running():
        # 2026-11-16: the restarts of the setup stood on the dashboard as "services down since ..." long after it.
        return {'skipped': 'the setup wizard runs'}
    now = time.time()
    state = _json_read(THREAT_STATE, {})
    if now - state.get('at', 0) > 600:
        # After a stop of efa-web: only the last two minutes, never the whole backlog of the journal.
        state.pop('cursor', None)
        state.pop('net', None)
    minutes = min(max((now - state['at']) / 60, 0.5), 10) if state.get('cursor') else 2
    lines = _safe(lambda: _journal_since(state, ('postfix', 'fail2ban', 'efa-web')), [])
    counts, top = threat_journal_counts(lines)
    net, before = _safe(lambda: _platform().tcp_counters(), {}), state.get('net', {})
    syn = sum(max(0, net.get(key, 0) - before.get(key, 0)) for key in ('SyncookiesSent', 'ListenDrops', 'ListenOverflows')) if before else 0
    sample = {key: round(value / minutes, 1) for key, value in counts.items()}
    sample.update(syn=round(syn / minutes, 1), at=now, top=top)
    ring = (state.get('ring', []) + [sample])[-THREAT_RING:]
    mail, mail_base = _safe(lambda: threat_mail(state, now), (None, None))
    queue = _safe(threat_queue_size, None)
    try:
        down = sorted(name for name in status(None).get('down', []) if not name.startswith('milter:'))
    except EfaError:
        down = []
    if _uptime() < THREAT_BOOT_GRACE:
        # 2026-11-17: efa-web ran its first check while clamd, unbound and nginx were still starting after the setup reboot.
        down = []
    down = threat_down_confirmed(state, down)
    down += [name for name in threat_flapping(state, _safe(lambda: _platform().service_restarts(THREAT_FLAP_UNITS), {}), now) if name not in down]
    found = threat_judge(ring, mail, mail_base, queue, down, threat_resources(), THREAT_SENSITIVITY[threat_settings()['sensitivity']])
    active = threat_track(state, found, now)
    level = max((item['level'] for item in active.values()), key=THREAT_LEVELS.index, default='ok')
    gauges = {'connections': sample['connections'], 'connections_normal': _median([item.get('connections', 0) for item in ring[:-1] or ring]),
              'auth_failed_10': round(sum(item.get('auth_failed', 0) for item in ring[-10:])), 'syn': sample['syn'], 'queue': queue,
              'mails_10': mail['mails'] if mail else None, 'spam_10': mail['spam'] if mail else None, 'virus_10': mail['virus'] if mail else None,
              'mails_normal': mail_base.get('mails') if mail_base else None}
    result = {'level': level, 'checked': int(now), 'alerts': [{'kind': kind, 'group': THREAT_KINDS[kind][0], 'slug': THREAT_KINDS[kind][1],
                                                               'anchor': THREAT_KINDS[kind][2], **{k: v for k, v in item.items() if k not in ('seen', 'alert_at')}}
                                                              for kind, item in sorted(active.items(), key=lambda pair: (-THREAT_LEVELS.index(pair[1]['level']), pair[0]))],
              'gauges': gauges}
    state.update(at=now, net=net, ring=ring, last=result)
    _json_write(THREAT_STATE, state, mode=0o600)
    return result


def threat_status(_args):
    """The last result of the attack check and its setting. Reads the kept result only; a tenant admin gets no addresses."""
    state = _json_read(THREAT_STATE, {})
    result = state.get('last') or {'level': 'ok', 'checked': None, 'alerts': [], 'gauges': {}}
    if identity_now and identity_now.get('domains') is not None:
        result = {**result, 'alerts': [{k: v for k, v in item.items() if k != 'top'} for item in result['alerts']]}
    return {**threat_settings(), **result}


def threat_set(args):
    """How early the attack alert speaks up: low (twice the limits), normal, high (half the limits)."""
    sensitivity = (args.sensitivity or '').strip()
    if sensitivity not in THREAT_SENSITIVITY:
        raise EfaError('Sensitivity: low, normal or high.')
    before = threat_settings()['sensitivity']
    _json_write(THREAT_FILE, {'sensitivity': sensitivity}, mode=0o644)
    _audit(f'attack alert sensitivity {before} -> {sensitivity} by {_dmarc_who()}')
    return threat_settings()


def bayes_status(_args):
    """The Bayes classifier of rspamd: how much it has learned, whether it counts yet, and how it learns. Changes nothing."""
    done = subprocess.run(['rspamc', 'stat'], capture_output=True, text=True, timeout=30)
    if done.returncode != 0:
        raise EfaError('rspamd does not answer.')
    conf = open(BAYES_CONF).read() if os.path.exists(BAYES_CONF) else ''
    return bayes_parse(done.stdout, conf)


def metrics_text(health, queues, mails, held, bayes=None, swap=None):
    """Prometheus text format, from the values the other commands already know."""
    lines = ['# TYPE efa_up gauge', f"efa_up {1 if health.get('status') == 'ok' else 0}", '# TYPE efa_check_up gauge']
    lines += [f'efa_check_up{{check="{metric_label(name)}"}} {1 if good else 0}' for name, good in sorted(health.get('checks', {}).items())]
    lines.append('# TYPE efa_queue_messages gauge')
    lines += [f'efa_queue_messages{{queue="{metric_label(name)}"}} {count}' for name, count in sorted(queues.items())]
    lines.append('# TYPE efa_mail_today gauge')
    lines += [f'efa_mail_today{{action="{metric_label(name)}"}} {count}' for name, count in sorted(mails.items())]
    lines += ['# TYPE efa_quarantine_messages gauge', f'efa_quarantine_messages {held}']
    if bayes:
        lines += ['# TYPE efa_bayes_learned gauge', f"efa_bayes_learned{{class=\"spam\"}} {bayes['spam_learned']}",
                  f"efa_bayes_learned{{class=\"ham\"}} {bayes['ham_learned']}", '# TYPE efa_bayes_active gauge', f"efa_bayes_active {int(bayes['active'])}"]
    if swap is not None:
        lines += ['# TYPE efa_swap_used_percent gauge', f'efa_swap_used_percent {swap}']
    return '\n'.join(lines) + '\n'


def metrics(_args):
    """Values for Prometheus, at /metrics with an API token."""
    try:
        health = status(None)
    except EfaError:
        health = {}
    queues = {}
    held = 0
    done = subprocess.run(['postqueue', '-j'], capture_output=True, text=True)
    for line in done.stdout.splitlines():
        name = json.loads(line).get('queue_name', 'unknown')
        queues[name] = queues.get(name, 0) + 1
        held += name == 'hold'
    mails = {}
    try:
        db = _maillog_db()
        try:
            with db.cursor() as cur:
                cur.execute('SELECT action, COUNT(*) AS n FROM maillog WHERE ts >= CURDATE() GROUP BY action')
                mails = {row['action'] or 'unknown': row['n'] for row in cur.fetchall()}
        finally:
            db.close()
    except (EfaError, OSError):
        pass
    try:
        bayes = bayes_status(None)
    except (EfaError, OSError, subprocess.SubprocessError):
        bayes = None
    return {'text': metrics_text(health, queues, mails, held, bayes, _safe(swap_used_percent, None))}


# The services an admin may restart from the web and the text interface.
RESTARTABLE = ('postfix', 'rspamd', 'redis', 'clamd@scan', 'nginx', 'mariadb', 'unbound', 'fail2ban', 'efa-web', 'efa-portal', 'efa-portal-helper',
               'efa-maillog', 'efa-milter-health')
LOGS = {'mail': '/var/log/maillog', 'efa': '/var/log/eFa/eFa-config.log', 'audit': '/var/log/eFa/audit.log', 'firewall': '/var/log/eFa/firewall.log',
        'update': '/var/log/eFa/update-system.log'}


def _platform():
    """The platform layer of eFa-base: service control without calling the service manager here."""
    if '/usr/lib/eFa/python' not in sys.path:
        sys.path.insert(0, '/usr/lib/eFa/python')
    import efa_platform
    return efa_platform.detect()



# 5v (h): sandbox settings of systemd for third-party services. The distribution units run in their own SELinux domains, and
# NoNewPrivileges blocks the change into them (6.0.0.5 test builds: unbound did not start, and with it the DNS of the host; redis
# failed; AVC denials for freshclam). So these drop-ins use only what works through mount namespaces and needs no
# NoNewPrivileges: a read-only system with the folders each daemon writes, no /home, an own /tmp, read-only kernel tunables and
# control groups. Not here, because systemd then implies NoNewPrivileges for a unit with a user or without CAP_SYS_ADMIN:
# SystemCallFilter, RestrictAddressFamilies, RestrictNamespaces, LockPersonality, MemoryDenyWriteExecute, ProtectKernelModules,
# ProtectKernelLogs, ProtectClock, CapabilityBoundingSet with SYS_ADMIN dropped. /run stays writable: the daemons make and
# reach sockets there. Valid on EL9 and EL10 (systemd 252 and newer); a valkey unit gets its own entry the same way.
# redis runs as its own user: for such a unit ProtectKernelTunables and ProtectControlGroups bring NoNewPrivileges as well (the
# SELinux nnp_transition denial of the first test), so it gets the mount limits without them. nginx: its check of the security
# minimum before the start runs outside the sandbox ("+" in efa-floor.conf), it writes the audit log.
SANDBOX_USER_UNITS = ('redis', 'valkey')
SANDBOX_BASE = 'ProtectSystem=strict\nProtectHome=yes\nPrivateTmp=yes\nProtectKernelTunables=yes\nProtectControlGroups=yes\n'
SANDBOX_PATHS = {
    'rspamd': ('/run', '/var/lib/rspamd', '-/var/log/rspamd'),
    'clamd@scan': ('/run', '-/var/log/clamd.scan'),
    'clamav-freshclam': ('/run', '/var/lib/clamav', '-/var/log/freshclam.log'),
    'redis': ('/run', '/var/lib/redis', '-/var/log/redis'),
    # EL10: Valkey instead of Redis, its own unit and folders (efa_platform_el10).
    'valkey': ('/run', '/var/lib/valkey', '-/var/log/valkey'),
    'unbound': ('/run', '/var/lib/unbound'),
    'nginx': ('/run', '/var/lib/nginx', '/var/log/nginx', '-/var/cache/nginx'),
}


def sandbox_text(name):
    """The drop-in of one third-party unit: the common limits and the folders it writes."""
    base = SANDBOX_BASE
    if name in SANDBOX_USER_UNITS:
        base = ''.join(line + '\n' for line in base.splitlines() if line.split('=')[0] not in ('ProtectKernelTunables', 'ProtectControlGroups'))
    return '[Service]\n' + base + f"ReadWritePaths={' '.join(SANDBOX_PATHS[name])}\n"


HARDENED_SERVICES = tuple(SANDBOX_PATHS)
# D-1: the units a new install and a migration put in the sandbox (mode default). redis/valkey and nginx only with mode on, by
# the admin (OV-1b: redis gave SELinux denials, nginx did not stay up in the test; both fall back without the sandbox).
SANDBOX_DEFAULT = ('rspamd', 'clamd@scan', 'clamav-freshclam', 'unbound')
# EL10 (OV-1b): Valkey instead of Redis and nginx ran with mode on on a production host since 2026-11-12 without a SELinux
# denial and active throughout, so on EL10 the default takes them too; EL9 stays as tested there.
SANDBOX_DEFAULT_EL10 = ('valkey', 'nginx')


def sandbox_default():
    return SANDBOX_DEFAULT + (SANDBOX_DEFAULT_EL10 if EL_RELEASE == 'el10' else ())
HARDEN_MODES = ('default', 'on', 'off')
# Their drop-in of the 6.0.0.5 test builds goes on every run; Postfix and MariaDB stay without a sandbox.
UNHARDENED_SERVICES = ('postfix', 'mariadb')
HARDEN_FILE = ETC + '/eFa/service-hardening.json'
HARDEN_STABLE_SECONDS = 10


def _stays_active(platform_now, name, stable=HARDEN_STABLE_SECONDS):
    """Active within 30 seconds and then without a break for stable seconds: a unit that comes up and falls over fails."""
    for _ in range(30):
        if platform_now.service_is_active(name):
            break
        time.sleep(1)
    else:
        return False
    for _ in range(stable):
        time.sleep(1)
        if not platform_now.service_is_active(name):
            return False
    return True


def _sandbox_start(platform_now, name):
    """Restart and check that the unit comes up and stays up (_stays_active); a failed restart counts as not coming up."""
    try:
        platform_now.service_restart(name)
        return _stays_active(platform_now, name)
    except Exception:  # noqa: BLE001 - the StepError of the platform layer: the same as not coming up
        return False


def _sandbox_write(platform_now, name):
    """The drop-in of this unit (efa-hardening.conf, the name service_hardening removes again). True when it changed."""
    dropin = getattr(platform_now, '_dropin', None)
    if dropin is None:
        return platform_now.service_hardening(name, True)
    header = ('# SPDX-License-Identifier: AGPL-3.0-or-later\n# Copyright (C) 2026 Markus Lorber and eFa-next contributors\n'
              '# Author: Markus Lorber, Lukasz Galusinski\n# eFa-next 5v (h): written by efactl service-harden, removed by --mode off.\n')
    return dropin(name, 'efa-hardening.conf', header + sandbox_text(name))


def service_harden(args):
    """The sandbox of systemd for the tested third-party units; a unit that fails or flaps with it runs without again. keep (the
    package update) applies again what the admin chose, so an update never switches it on or off."""
    mode = (args.mode or '').strip()
    if mode == 'keep':
        mode = _json_read(HARDEN_FILE, {}).get('mode', 'off')
    if mode not in HARDEN_MODES:
        raise EfaError('Sandbox: default (the tested mail services), on (also redis and nginx) or off.')
    on, wanted = mode != 'off', sandbox_default() if mode == 'default' else HARDENED_SERVICES
    platform_now, result = _platform(), {}
    # A name that is another unit on this release (redis on EL10 is valkey) is skipped: the real unit has its own entry.
    aliases = getattr(platform_now, 'UNIT_ALIASES', {})
    for name in UNHARDENED_SERVICES:
        try:
            if not platform_now.service_exists(name):
                continue
            was_active = platform_now.service_is_active(name)
            if platform_now.service_hardening(name, False):
                # A unit that ran, or one the drop-in kept from starting (enabled, not running), runs again; a stopped one stays.
                if was_active or platform_now.service_is_enabled(name):
                    platform_now.service_restart(name, check=False)
                result[name] = 'sandbox removed (not tested with SELinux)'
        except NotImplementedError:
            pass
        except Exception as err:  # the StepError of the platform layer
            result[name] = f'error removing the sandbox: {str(err)[:100]}'
    for name in HARDENED_SERVICES:
        try:
            if name in aliases or not platform_now.service_exists(name):
                continue
            unit_on = on and name in wanted
            changed = _sandbox_write(platform_now, name) if unit_on else platform_now.service_hardening(name, False)
            if not changed:
                result[name] = 'unchanged' if unit_on or name in wanted else 'off'
                continue
            if unit_on and not platform_now.service_is_active(name):
                # Not running (the setup applies the standards before clamd@scan can start, enabled or not, 2026-11-17): the check
                # would start a unit that cannot run yet. The drop-in counts from its next start; a unit that then fails is a
                # service down for the health service and the attack alert.
                result[name] = 'on'
                continue
            if not unit_on:
                platform_now.service_try_restart(name)
                result[name] = 'off'
                continue
            started = time.time()
            # 2026-11-17: in the setup clamd@scan fell over once with the sandbox (a parallel restart or its first start, the
            # sandbox itself works) and stayed without it. One failed start is not the sandbox: once more before going back.
            stable = _sandbox_start(platform_now, name) or _sandbox_start(platform_now, name)
            if stable:
                result[name] = 'on'
            else:
                why = [line[-200:] for line in _safe(lambda: platform_now.journal_window(started - 5, time.time(), [name.split('@')[0]]), [])][-5:]
                platform_now.service_hardening(name, False)
                if _sandbox_start(platform_now, name):
                    result[name] = 'failed with the sandbox, back without it'
                    _event('service_sandbox_failed', 'warning', service=name, journal=why)
                else:
                    # It does not run without the sandbox either: not the sandbox's fault, so the sandbox stays on.
                    _sandbox_write(platform_now, name)
                    platform_now.service_restart(name, check=False)
                    result[name] = 'does not start, with or without the sandbox (sandbox kept)'
                    _event('service_not_starting', 'warning', service=name, journal=why)
        except NotImplementedError:
            result[name] = 'not on this platform'
        except Exception as err:  # the StepError of the platform layer
            result[name] = f'error: {str(err)[:100]}'
            try:
                platform_now.service_hardening(name, False)
                platform_now.service_restart(name, check=False)
            except Exception:  # nothing more to take back
                pass
    _json_write(HARDEN_FILE, {'mode': mode, 'services': result}, mode=0o644)
    _audit(f'service sandbox {mode} by {_dmarc_who()}: {result}')
    return {'mode': mode, 'services': result}


def service_harden_status(_args):
    return {'mode': 'off', 'services': {}, **_json_read(HARDEN_FILE, {})}

def service_restart(args):
    """Restart one service of eFa-next, for example after a change by hand. Mail waits for the seconds it takes."""
    name = args.name.strip()
    if name not in RESTARTABLE:
        raise EfaError('Service: one of ' + ', '.join(RESTARTABLE))
    platform_now = _platform()
    try:
        platform_now.service_restart(name)
    except Exception as err:  # the StepError of the platform layer
        raise EfaError(str(err))
    return {'service': name, 'active': platform_now.service_is_active(name)}


def log_tail(path, lines):
    """The last lines of a log file, read from the end: a large log costs no more than a small one."""
    if not os.path.exists(path):
        return []
    with open(path, 'rb') as f:
        f.seek(0, 2)
        size, block, data = f.tell(), 65536, b''
        while size > 0 and data.count(b'\n') <= lines:
            step = min(block, size)
            size -= step
            f.seek(size)
            data = f.read(step) + data
    return [line.decode('utf-8', 'replace') for line in data.splitlines()[-lines:]]


def log_show(args):
    """The last lines of a log: mail, eFa-next setup, audit, firewall or system update."""
    name = args.name.strip()
    if name not in LOGS:
        raise EfaError('Log: one of ' + ', '.join(LOGS))
    count = (args.lines or '').strip() or '100'
    if not count.isdigit() or not 1 <= int(count) <= 2000:
        raise EfaError('Lines: 1 to 2000.')
    return {'log': LOGS[name], 'lines': log_tail(LOGS[name], int(count))}


SECURITY_FILE = '/var/lib/eFa/security-check.json'
SECURITY_SETTINGS = ETC + '/eFa/security-check.json'
COMMON_PASSWORDS = '/usr/share/eFa/common-passwords.txt'
# What listens on more than the loopback by design: SMTP, submission, web, SSH.
EXPECTED_PORTS = {25, 465, 587, 80, 443, 22}
LEVELS = ('ok', 'warning', 'problem')


def finding(level, title, detail, fix=''):
    return {'level': level, 'title': title, 'detail': detail, 'fix': fix}


def zone_findings(zones, routed):
    """firewalld zones that let everything in on an interface with the default route, and rules in zones no traffic reaches.
    zones: {name: {'target', 'interfaces', 'sources', 'rules'}} of the permanent configuration; routed: interfaces with the
    default route. Changes nothing (the fix is the admin's, between minute 20 and 50)."""
    found = []
    for name, zone in sorted(zones.items()):
        open_on = sorted(set(zone['interfaces']) & set(routed))
        if zone['target'] == 'ACCEPT' and open_on:
            found.append(finding('problem', f'Interface {", ".join(open_on)} in zone {name}, which lets everything in',
                                 'Every port that listens is open to every network the host can be reached from; rules of other zones do not apply.',
                                 'Move the interface into a zone such as public that allows only what is needed, with a way back armed.'))
        if zone['rules'] and not zone['interfaces'] and not zone['sources']:
            found.append(finding('warning', f'{zone["rules"]} firewall rules in zone {name} do nothing',
                                 'The zone has no interface and no source, so no packet reaches its rules.',
                                 'Move the interface into this zone, or keep blocklists in eFa-next (Blocklists, Firewall blocklists), which work for every interface.'))
    return found


def _firewall_zones():
    """The permanent zones as zone_findings takes them, and the interfaces with the default route."""
    zones = {}
    for name in _fw('--permanent', '--get-zones').stdout.split():
        info = _fw('--permanent', f'--zone={name}', '--list-all').stdout
        get = lambda key: (re.search(rf'^\s+{key}: ?(.*)$', info, re.M) or [None, ''])[1].split()
        zones[name] = {'target': (get('target') or ['default'])[0], 'interfaces': get('interfaces'), 'sources': get('sources'),
                       'rules': len(re.findall(r'^\s+rule ', info, re.M))}
    # Interfaces NetworkManager put into a zone are not in the files of firewalld: the zones at run time hold them.
    current = None
    for line in _fw('--get-active-zones').stdout.splitlines():
        if line and not line.startswith(' '):
            current = line.split()[0]
        elif current and line.strip().startswith('interfaces:') and current in zones:
            zones[current]['interfaces'] = sorted(set(zones[current]['interfaces']) | set(line.split(':', 1)[1].split()))
    routes = subprocess.run(['ip', 'route', 'show', 'default'], capture_output=True, text=True, timeout=15).stdout
    return zones, sorted(set(re.findall(r'\bdev (\S+)', routes)))


def update_findings(updates, listening):
    """Security updates that are missing; first those of packages that listen on the network."""
    exposed = {item['package'] for item in listening if item['package'] and item['address'] not in ('127.0.0.1', '::1')}
    found = []
    for item in sorted(updates, key=lambda item: (item['package'] not in exposed, item['package'])):
        ids = ', '.join(item['ids'][:8]) + (' ...' if len(item['ids']) > 8 else '')
        level = 'problem' if item['package'] in exposed and item['severity'] in ('Critical', 'Important') else 'warning'
        found.append(finding(level, f"Security update for {item['package']}" + (' (listens on the network)' if item['package'] in exposed else ''),
                             f"{item['severity']}: {ids}", 'Maintenance & update: Update system.'))
    return found


# Services of the site that are not part of eFa-next: one per line, "port/proto process comment" (process * for any).
SECURITY_EXCLUDE_DIR = ETC + '/eFa/security-check.d'


def security_excludes(texts):
    """The excluded services of the files: [(port, proto, process, comment)]. Lines it cannot read are skipped."""
    found = []
    for text in texts:
        for line in text.splitlines():
            parts = line.split('#', 1)[0].split(None, 2)
            match = re.match(r'^(\d{1,5})/(tcp|udp)$', parts[0]) if len(parts) >= 2 else None
            if match:
                found.append((int(match.group(1)), match.group(2), parts[1], (parts[2] if len(parts) > 2 else '').strip()[:80]))
    return found


def _security_excludes():
    texts = []
    for path in sorted(glob.glob(SECURITY_EXCLUDE_DIR + '/*.conf')):
        try:
            with open(path) as f:
                texts.append(f.read())
        except OSError:
            continue
    return security_excludes(texts)


def port_findings(listening, excludes=(), excluded=None):
    found = []
    for item in listening:
        if item['address'] in ('127.0.0.1', '::1') or item['address'].startswith('127.') or item['port'] in EXPECTED_PORTS or item['proto'] == 'udp':
            continue
        hit = next((rule for rule in excludes if rule[0] == int(item['port']) and rule[1] == item['proto'] and rule[2] in ('*', item['process'])), None)
        if hit:
            if excluded is not None:
                excluded.append({'port': f"{item['port']}/{item['proto']}", 'process': item['process'] or 'unknown', 'comment': hit[3] or 'not part of eFa-next'})
            continue
        found.append(finding('warning', f"Port {item['port']}/{item['proto']} is open to the network", f"{item['process'] or 'unknown'} ({item['package'] or 'no package'})",
                             'Stop the service or bind it to 127.0.0.1, if it is not needed from outside.'))
    return found


def sshd_findings(text):
    values = dict(line.split(None, 1) for line in text.splitlines() if ' ' in line)
    found = []
    if values.get('permitrootlogin') == 'yes':
        found.append(finding('warning', 'Root can log in through SSH with a password', 'PermitRootLogin yes', 'Security: Root login through SSH.'))
    if values.get('passwordauthentication') == 'yes' and values.get('permitrootlogin') in ('yes',):
        found.append(finding('warning', 'SSH accepts passwords', 'PasswordAuthentication yes', 'Use SSH keys, then turn password logins off.'))
    return found


def tls_findings(smtpd_protocols, nginx_conf, dovecot_min):
    found = []
    allowed = smtpd_protocols.replace(',', ' ').split()
    if '!SSLv3' not in allowed and '>=TLSv1.2' not in allowed and '>=TLSv1' not in allowed:
        found.append(finding('problem', 'Postfix allows SSLv3', f'smtpd_tls_protocols = {smtpd_protocols or "(default)"}', 'postconf smtpd_tls_protocols="!SSLv2, !SSLv3"'))
    match = re.search(r'ssl_protocols\s+([^;]+);', nginx_conf)
    # TLSv1 alone, not the start of TLSv1.2.
    if match and re.search(r'(?<![\w.])(SSLv3|TLSv1|TLSv1\.1)(?![\w.])', match.group(1)):
        found.append(finding('problem', 'nginx allows old TLS versions', match.group(1), 'ssl_protocols TLSv1.2 TLSv1.3;'))
    if '!SSLv3' in allowed and not _tls12(smtpd_protocols):
        found.append(finding('warning', 'Postfix still allows TLS 1.0 and 1.1', f'smtpd_tls_protocols = {smtpd_protocols}',
                             'efactl tls-min-set --mode on; a very old server then sends unencrypted'))
    if dovecot_min and dovecot_min in ('SSLv3', 'TLSv1', 'TLSv1.1'):
        found.append(finding('warning', 'Dovecot allows old TLS versions', f'ssl_min_protocol = {dovecot_min}', 'ssl_min_protocol = TLSv1.2'))
    return found


CIPHER_GRADES = ('export', 'low', 'medium', 'high', 'null')


def cipher_findings(values):
    """A cipher list where Postfix wants a grade: Postfix logs "invalid cipher grade" and STARTTLS breaks."""
    return [finding('problem', 'Postfix cipher setting is no grade, STARTTLS fails', f'{name} = {value[:80]}',
                    f'postconf "{name} = high" "tls_high_cipherlist = {value[:40]}…"')
            for name, value in values.items() if value and value.lower() not in CIPHER_GRADES]


def protocol_syntax_findings(values, version):
    """">=TLSv1.2" before Postfix 3.6: it rejects the value, and STARTTLS no longer works."""
    parts = [int(item) for item in re.findall(r'\d+', version)[:2]] or [0, 0]
    if parts >= [3, 6]:
        return []
    return [finding('problem', 'Postfix does not understand this TLS protocol setting', f'{name} = {value} (Postfix {version})',
                    f'postconf "{name} = {TLS_MIN_NEW}"') for name, value in values.items() if '>=' in value or '<=' in value]


def pam_findings(pam_on, submission_on):
    if pam_on and submission_on:
        return [finding('warning', 'SMTP AUTH uses system accounts via PAM', 'port 587 checks logins against the accounts of this host, through Dovecot',
                        'Switch to submitter logins to drop Dovecot: Mail routing → Submitters, then efactl submission-pam-set --mode off.')]
    return []


def relay_findings(restrictions, mynetworks):
    found = []
    if 'reject_unauth_destination' not in restrictions and 'defer_unauth_destination' not in restrictions:
        found.append(finding('problem', 'Postfix may be an open relay', 'neither reject_unauth_destination nor defer_unauth_destination in the relay restrictions',
                             'Mail routing: relay networks; postconf smtpd_relay_restrictions.'))
    if re.search(r'(^|[\s,])(0\.0\.0\.0/0|::/0|\[::\]/0)([\s,]|$)', mynetworks):
        found.append(finding('problem', 'Everybody may relay', f'mynetworks = {mynetworks}', 'Mail routing: Relay networks.'))
    return found


def mode_findings(paths):
    found = []
    for path in paths:
        try:
            mode = os.stat(path).st_mode
        except OSError:
            continue
        if mode & 0o004:
            fix = 'efactl conf-modes-heal' if conf_mode(path) else f'chmod o-r {path}'
            found.append(finding('problem', f'{path} is readable by everyone', oct(mode & 0o777), fix))
    return found


def certificate_findings(not_after, now=None):
    if not_after is None:
        return []
    left = (not_after - (now or time.time())) / 86400
    if left < 0:
        return [finding('problem', 'The certificate of the web interface has expired', f'{-int(left)} days ago', 'Network & certificate: Let\'s Encrypt.')]
    if left < 21:
        return [finding('warning', 'The certificate of the web interface expires soon', f'in {int(left)} days', 'Network & certificate: Let\'s Encrypt.')]
    return []


def _certificate_end():
    match = re.search(r'ssl_certificate\s+([^;]+);', open('/etc/nginx/conf.d/efa.conf').read()) if os.path.exists('/etc/nginx/conf.d/efa.conf') else None
    if not match:
        return None
    done = subprocess.run(['openssl', 'x509', '-noout', '-enddate', '-in', match.group(1).strip()], capture_output=True, text=True)
    found = re.search(r'notAfter=(.+)', done.stdout)
    return time.mktime(time.strptime(found.group(1).strip().replace(' GMT', ''), '%b %d %H:%M:%S %Y')) if found else None


def clam_domains(proc='/proc'):
    """{program: sorted SELinux types} of the running clamd and freshclam, read from /proc (no tool)."""
    found = {}
    for pid in (name for name in _safe(lambda: os.listdir(proc), []) if name.isdigit()):
        try:
            with open(f'{proc}/{pid}/comm') as f:
                comm = f.read().strip()
            if comm not in ('clamd', 'freshclam'):
                continue
            with open(f'{proc}/{pid}/attr/current') as f:
                context = f.read().strip('\x00\n ')
        except OSError:
            continue
        parts = context.split(':')
        found.setdefault(comm, set()).add(parts[2] if len(parts) > 2 else context)
    return {comm: sorted(types) for comm, types in found.items()}


def selinux_domain_findings(installed, domains, fixes):
    """EL10: a warning for each missing policy package of a program eFa-next runs, and for clamd or freshclam running in
    another domain than antivirus_t while its policy is there. installed: {package: bool}, domains: clam_domains(), fixes: the
    commands of the platform (SELINUX_DOMAIN_FIX)."""
    found = []
    if not installed.get('selinux-policy-targeted-extra', True):
        found.append(finding('warning', 'clamd/freshclam run without their own SELinux domain',
                             'selinux-policy-targeted-extra (repository CRB) is not installed: antivirus_t is missing',
                             fixes.get('selinux-policy-targeted-extra', '')))
    else:
        wrong = [f"{comm} ({', '.join(types)})" for comm, types in sorted(domains.items()) if types != ['antivirus_t']]
        if wrong:
            found.append(finding('warning', 'clamd/freshclam not in their SELinux domain antivirus_t', ', '.join(wrong), fixes.get('antivirus_t', '')))
    if not installed.get('fail2ban-selinux', True):
        found.append(finding('warning', 'fail2ban runs without its own SELinux domain', 'fail2ban-selinux is not installed: fail2ban_t is missing',
                             fixes.get('fail2ban-selinux', '')))
    return found


def security_check(_args):
    """Looks for what makes this host weak: missing security updates, ports, firewall, SSH, TLS, relay, file modes, certificate. Changes nothing."""
    checks, platform_now = [], _platform()
    try:
        listening = platform_now.listening()
    except Exception as err:  # the StepError of the platform layer
        listening, checks = [], [finding('warning', 'Listening ports not readable', str(err)[:200])]
    try:
        checks += update_findings(platform_now.security_updates(), listening)
    except Exception as err:
        checks.append(finding('warning', 'Security updates not checked', str(err)[:200], 'Check the access to the package repositories.'))
    excluded = []
    checks += port_findings(listening, _security_excludes(), excluded)
    try:
        found, _status = oval_check(listening)
        checks += found
    except Exception as err:  # a broken OVAL file or a platform without it: the other checks go on
        checks.append(finding('warning', 'OVAL check failed', str(err)[:200], 'security-oval-set --mode off, then on again to load it anew.'))
    fw = _firewall_state()
    try:
        firewall_up = _fw('--state').returncode == 0
    except OSError:
        firewall_up = False
    if not firewall_up:
        checks.append(finding('problem', 'The firewall does not run', 'firewalld is down', 'Security: Firewall guard, or start firewalld between minute 20 and 50.'))
    if os.path.lexists(DEV_NO_SETUP_CODE):
        checks.append(finding('warning', 'Dev mode: the setup wizard needs no setup code', DEV_NO_SETUP_CODE,
                              'Not for production: remove the file (rm ' + DEV_NO_SETUP_CODE + ').'))
    if not fw.get('guard'):
        checks.append(finding('warning', 'The firewall guard is off', 'missing eFa-next rules are not restored', 'Security: Firewall guard.'))
    if firewall_up:
        try:
            checks += zone_findings(*_firewall_zones())
        except (OSError, subprocess.SubprocessError) as err:
            checks.append(finding('warning', 'Firewall zones not checked', str(err)[:200]))
    try:
        health = status(None)
        failed = health.get('down', [])
        if failed:
            checks.append(finding('problem', 'A mail filter or service is down', ', '.join(failed),
                                  'Status: start the service; set milter-health-set to tempfail for a milter that must never be skipped.'))
    except EfaError as err:
        checks.append(finding('warning', 'The health service does not answer', str(err)[:200], 'Start efa-milter-health.'))
    checks += sshd_findings(subprocess.run(['sshd', '-T'], capture_output=True, text=True).stdout)
    try:
        overruled = [text for text in ssh_root_status(None)['warnings'] if text.startswith('sshd does not take')]
    except EfaError:
        overruled = []
    checks += [finding('warning', 'An eFa-next setting of SSH does not take effect', text, 'Security: Root login through SSH.') for text in overruled]
    nginx = open('/etc/nginx/conf.d/efa.conf').read() if os.path.exists('/etc/nginx/conf.d/efa.conf') else ''
    dovecot = subprocess.run(['doveconf', '-h', 'ssl_min_protocol'], capture_output=True, text=True).stdout.strip() if shutil.which('doveconf') else ''
    checks += tls_findings(_postconf('smtpd_tls_protocols'), nginx, dovecot)
    checks += cipher_findings({name: _postconf(name) for name in ('smtpd_tls_ciphers', 'smtpd_tls_mandatory_ciphers', 'smtp_tls_ciphers',
                                                                  'smtp_tls_mandatory_ciphers')})
    checks += protocol_syntax_findings({name: _postconf(name) for name in TLS_PARAMETERS}, _postconf('mail_version'))
    checks += pam_findings(_pam_on(), _submission_active())
    checks += relay_findings(_postconf('smtpd_relay_restrictions') + ' ' + _postconf('smtpd_recipient_restrictions'), _postconf('mynetworks'))
    checks += mode_findings(sorted(glob.glob(ETC + '/eFa/*.json')) + [ETC + '/eFa/MySQL-Config', WEB_DIR + '/admin.pw', WEB_DIR + '/maillog.pw'])
    # 2026-11-18: in EL10 the SELinux domains of ClamAV (selinux-policy-targeted-extra, CRB) and fail2ban (fail2ban-selinux)
    # come with packages of their own; a host upgraded from EL9 may lack them, and then these programs run unconfined.
    if _safe(lambda: platform_now.mac_enabled(), False) and _safe(lambda: _ru_lib().os_major(open('/etc/os-release').read()), 0) == 10:
        checks += selinux_domain_findings({package: _safe(lambda package=package: platform_now.package_installed(package), True)
                                           for package in ('selinux-policy-targeted-extra', 'fail2ban-selinux')}, clam_domains(),
                                          getattr(platform_now, 'SELINUX_DOMAIN_FIX', {}))
    if _safe(lambda: platform_now.package_installed(_ru_lib().EFA5_KEY_RPM), False):
        checks.append(finding('ok', 'Signing key of eFa 5 still trusted', f'{_ru_lib().EFA5_KEY_RPM} is in the package database',
                              'Once no package of eFa 5 is left: rpm -e ' + _ru_lib().EFA5_KEY_RPM))
    try:
        checks += certificate_findings(_certificate_end())
    except (OSError, ValueError):
        pass
    update = _update_state()
    if update.get('security') and _update_available(update) and update.get('first_seen') and \
            datetime.date.today() - datetime.date.fromisoformat(update['first_seen']) > datetime.timedelta(days=7):
        checks.append(finding('problem', f"eFa-next security update {update['latest']} waits for more than 7 days", f"available since {update['first_seen']}",
                              'Maintenance & update: Install the eFa-next update now.'))
    checks += [finding('warning', 'Break-glass admin: its files changed', text, 'efactl breakglass-heal') for text in _safe(breakglass_problems, [])]
    level = max((LEVELS.index(item['level']) for item in checks), default=0)
    result = {'checked': time.strftime('%Y-%m-%d %H:%M:%S'), 'level': LEVELS[level], 'findings': sorted(checks, key=lambda item: -LEVELS.index(item['level'])),
              'excluded_not_part_of_efa_next': excluded}
    previous = _json_read(SECURITY_FILE, {})
    _json_write(SECURITY_FILE, result)
    new = {item['title'] for item in checks if item['level'] == 'problem'} - {item['title'] for item in previous.get('findings', []) if item['level'] == 'problem'}
    if new:
        _event('security_findings', 'warning', problems=len(new))
        _admin_notify('eFa-next: security self check found problems', '\n'.join(f"- {item['title']}: {item['detail']} -> {item['fix']}"
                                                                          for item in checks if item['title'] in new))
    return result


# Hardening report (Q5): the state of this host against the CIS benchmark for AlmaLinux 9 (system part) and BSI TR-03108
# (secure mail transport). Own short texts; the references name the topic, the documents themselves are not copied.
SYSCTL_WANTED = {'net.ipv4.ip_forward': '0', 'net.ipv4.conf.all.accept_redirects': '0', 'net.ipv4.conf.all.send_redirects': '0',
                 'net.ipv4.tcp_syncookies': '1', 'kernel.randomize_va_space': '2', 'fs.suid_dumpable': '0'}


def _tls12(value):
    """Whether a Postfix protocol list leaves out everything below TLS 1.2."""
    items = value.replace(',', ' ').split()
    return '>=TLSv1.2' in items or {'!SSLv2', '!SSLv3', '!TLSv1', '!TLSv1.1'} <= set(items)


TLS_PARAMETERS = ('smtpd_tls_protocols', 'smtpd_tls_mandatory_protocols', 'smtp_tls_protocols', 'smtp_tls_mandatory_protocols')
TLS_MIN_OLD = '!SSLv2, !SSLv3'
# Postfix 3.5 (EL9) knows no ">=TLSv1.2"; the list of exclusions works with every version.
TLS_MIN_NEW = '!SSLv2, !SSLv3, !TLSv1, !TLSv1.1'
KERNEL_OWN = {'net.ipv4.conf.all.accept_redirects': '0', 'net.ipv4.conf.default.accept_redirects': '0',
              'net.ipv6.conf.all.accept_redirects': '0', 'net.ipv4.conf.all.send_redirects': '0',
              'net.ipv4.conf.default.send_redirects': '0', 'fs.suid_dumpable': '0'}


def kernel_cis_values(data=None):
    """The sysctl values of CIS in standards.json (what the check asks), with the same value for default.* where all.* is set."""
    found = {}
    for rule in (data or standards_data())['standards']['cis-el']['rules']:
        if rule.get('kind') == 'sysctl':
            found.update(rule['values'])
    for name, value in list(found.items()):
        if '.conf.all.' in name:
            found.setdefault(name.replace('.conf.all.', '.conf.default.'), value)
    return found


class _KernelSettings(dict):
    """KERNEL_SETTINGS as before: the own values and those of CIS, read once from standards.json when first used."""
    def _load(self):
        if not dict.__len__(self):
            self.update({**KERNEL_OWN, **kernel_cis_values()})

    def items(self):
        self._load()
        return dict.items(self)

    def __iter__(self):
        self._load()
        return dict.__iter__(self)

    def __len__(self):
        self._load()
        return dict.__len__(self)

    def __getitem__(self, key):
        self._load()
        return dict.__getitem__(self, key)


KERNEL_SETTINGS = _KernelSettings()


def tls_min_set(args):
    """TLS 1.2 or newer for all SMTP (BSI TR-03108). Back to TLS 1.0 is no longer offered (5t, docs/tls-profiles.md)."""
    on = _on_off(args.mode)
    if not on:
        raise EfaError('TLS 1.0 and 1.1 are no longer offered by eFa-next: see Security, TLS profile.')
    for name in TLS_PARAMETERS:
        _postconf_set(name, TLS_MIN_NEW if on else TLS_MIN_OLD)
    return {name: _postconf(name) for name in TLS_PARAMETERS}


# 5t: TLS profiles. Each one stays inside the lower limit of docs/tls-profiles.md (TLS 1.2+, ECDHE, AEAD); a custom list is
# checked against it with openssl. The profile sets nginx (443) and Postfix (25, 587/465, outgoing); the cluster (8460) and
# the provisioning API (8463) have the limit in their code. The crypto policy of the system stays as it is.
TLS_PROFILE_FILE = ETC + '/eFa/tls-profile.json'
TLS_RAISED = '/var/lib/eFa/tls-raised'
TLS_CURVES = ('X25519', 'prime256v1', 'secp384r1')
TLS_PROFILES = {
    'bsi': {'title': 'BSI TR-02102-2 (default)', 'protocols': ('TLSv1.2', 'TLSv1.3'),
            'ciphers': 'ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256'},
    'rfc9325': {'title': 'RFC 9325 (BCP 195)', 'protocols': ('TLSv1.2', 'TLSv1.3'),
                'ciphers': 'ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:'
                           'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256'},
    # TLS 1.3 only for the web and for logins (587/465); port 25 and outgoing mail keep TLS 1.2, or old servers send in clear text.
    'mozilla-modern': {'title': 'Mozilla modern (TLS 1.3 only for web and logins)', 'protocols': ('TLSv1.3',),
                       'ciphers': 'ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:'
                                  'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256'},
}
TLS_EXCLUDE = {'TLSv1.2': '!SSLv2, !SSLv3, !TLSv1, !TLSv1.1', 'TLSv1.3': '!SSLv2, !SSLv3, !TLSv1, !TLSv1.1, !TLSv1.2'}


def tls_cipher_problem(openssl_lines):
    """None when every cipher of `openssl ciphers -v` lies inside the limit: TLS 1.2, ECDHE, AEAD. openssl lists the TLS 1.3 suites
    of the system with any list (on EL9 also TLS_AES_128_CCM_SHA256); a cipher list does not choose them, they are all AEAD: left out."""
    openssl_lines = [line for line in openssl_lines if line.split()[1:2] != ['TLSv1.3']]
    if not openssl_lines:
        return 'The list names no cipher openssl knows.'
    for line in openssl_lines:
        parts = line.split()
        fields = dict(item.split('=', 1) for item in parts if '=' in item)
        if parts[1:2] not in (['TLSv1.2'], ['TLSv1.3']) or fields.get('Kx') not in ('ECDH', 'any') or fields.get('Mac') != 'AEAD' or \
                not re.search(r'GCM|CHACHA20', fields.get('Enc', '')):
            return f'{parts[0]} is outside the limit (TLS 1.2+, ECDHE, AES-GCM or ChaCha20-Poly1305).'
    return None


def tls_profile_state():
    return {'profile': 'bsi', 'custom': '', **_json_read(TLS_PROFILE_FILE, {})}


def tls_wanted(state):
    """(nginx protocols, cipher list, Postfix protocols for 25 and outgoing, for 587/465) of a profile."""
    profile = TLS_PROFILES.get(state['profile'], TLS_PROFILES['bsi'])
    ciphers = state['custom'] if state['profile'] == 'custom' else profile['ciphers']
    protocols = ('TLSv1.2', 'TLSv1.3') if state['profile'] == 'custom' else profile['protocols']
    web = ('TLSv1.3',) if state.get('web13') else protocols
    return ' '.join(web), ciphers, TLS_EXCLUDE['TLSv1.2'], TLS_EXCLUDE[protocols[0]]


def _tls_postfix_values(state):
    _protocols, ciphers, opportunistic, mandatory = tls_wanted(state)
    return {'smtpd_tls_protocols': opportunistic, 'smtp_tls_protocols': opportunistic, 'smtp_tls_mandatory_protocols': opportunistic,
            'smtpd_tls_mandatory_protocols': mandatory, 'smtpd_tls_ciphers': 'high', 'smtpd_tls_mandatory_ciphers': 'high',
            'smtp_tls_ciphers': 'high', 'smtp_tls_mandatory_ciphers': 'high', 'tls_high_cipherlist': ciphers,
            'tls_preempt_cipherlist': 'yes', 'tls_eecdh_auto_curves': ' '.join(mail_curves())}


def mail_curves(postfix_version=None):
    """The groups of Postfix: the classic ones, then brainpool (BSI TR-03116-4; brainpoolP256r1tls13 for TLS 1.3 by name, 3.6+).
    Not X25519MLKEM768: Postfix 3.8.5 (EL10) too logs "ignoring unknown key exchange group" for it on every start."""
    version = tuple(int(part) for part in re.findall(r'\d+', postfix_version or _postconf('mail_version'))[:2])
    return TLS_CURVES + ('brainpoolP256r1',) + (('brainpoolP256r1tls13',) if version >= (3, 6) else ())


def _tls_postfix(state):
    values = _tls_postfix_values(state)
    changed = {name: value for name, value in values.items() if _postconf(name) != value}
    if not changed:
        return []
    main_cf = _postconf('config_directory') + '/main.cf'
    backup = main_cf + '.efactl-tls'
    shutil.copy2(main_cf, backup)
    try:
        subprocess.run(['postconf', '-e'] + [f'{name} = {value}' for name, value in changed.items()], check=True, capture_output=True)
        done = subprocess.run(['postfix', 'check'], capture_output=True, text=True)
        if done.returncode != 0:
            shutil.copy2(backup, main_cf)
            raise EfaError(f'postfix check failed, nothing changed: {done.stderr.strip()[:300]}')
    finally:
        os.remove(backup)
    subprocess.run(['postfix', 'reload'], check=False, capture_output=True)
    return sorted(changed)


def tls_profile_status(_args):
    """The TLS profile and what it sets: web (443) and mail (25, 587/465, outgoing)."""
    state = tls_profile_state()
    protocols, ciphers, opportunistic, mandatory = tls_wanted(state)
    raised = os.path.exists(TLS_RAISED) and time.time() - os.stat(TLS_RAISED).st_mtime < 7 * 86400
    return {'profile': state['profile'], 'profiles': {name: item['title'] for name, item in TLS_PROFILES.items()} | {'custom': 'Custom, checked'},
            'web_protocols': protocols, 'ciphers': ciphers.split(':'), 'curves': list(mail_curves()),
            'smtp_25_and_out': opportunistic, 'smtp_587_465': mandatory, 'in_effect': _postconf_many(TLS_PARAMETERS), **tls25_status(),
            'warnings': ['TLS was raised to the profile BSI TR-02102-2 by the update: no TLS 1.0/1.1, no CBC or SHA-1 ciphers. '
                         'An old server without a fitting cipher delivers to port 25 without encryption.'] if raised else []}


# Require TLS on port 25: off by default and on new installs; a public MX normally accepts mail without TLS (RFC 3207).
TLS25_FILE = ETC + '/eFa/tls-port25.json'
TLS25_COUNTS = '/var/lib/eFa/mailreport/tls-port25.json'
TLS25_DAYS = 7
TLS25_CONNECT = re.compile(r' postfix/smtpd\[\d+\]: connect from (\S+)\[([^\]]+)\]')
TLS25_TLS = re.compile(r' postfix/smtpd\[\d+\]: \w+ TLS connection established from (\S+)\[([^\]]+)\]')
TLS25_LOCAL = ('127.0.0.1', '::1')
TLS25_WARNING = ('Required TLS on port 25 refuses every sending server that does not start TLS, and its mail goes back to the sender. '
                 'RFC 3207 says a public mail server should not require it; MTA-STS, DANE and TLS for partner domains protect the way '
                 'without refusing anyone. Look at the senders without TLS of the last 7 days before you switch it on.')


def tls25_count(lines, counts, day):
    """Adds the sessions on port 25 of these log lines to counts {day: {sessions, tls, plain: {client: n}}}; keeps 7 days.
    Each line counts for the day in its own time stamp (JOB-2), so the lines before midnight read after it stay on their day."""
    opened, touched = {}, set()
    for line in lines:
        for pattern, step in ((TLS25_CONNECT, 1), (TLS25_TLS, -1)):
            match = pattern.search(line)
            if match and match.group(2) not in TLS25_LOCAL:
                stamp = REPORT_LINE.match(line)
                key = _report_day(stamp.group(1), stamp.group(2), day) if stamp and stamp.group(1) in REPORT_MONTHS else day.isoformat()
                entry = counts.setdefault(key, {'sessions': 0, 'tls': 0, 'plain': {}})
                touched.add(key)
                entry['sessions' if step > 0 else 'tls'] += 1
                client = (key, f'{match.group(1)}[{match.group(2)}]')
                opened[client] = opened.get(client, 0) + step
                break
    for (key, client), count in opened.items():
        if count > 0:
            counts[key]['plain'][client] = counts[key]['plain'].get(client, 0) + count
    for key in touched:
        counts[key]['plain'] = dict(sorted(counts[key]['plain'].items(), key=lambda item: (-item[1], item[0]))[:50])
    counts.setdefault(day.isoformat(), {'sessions': 0, 'tls': 0, 'plain': {}})
    oldest = (day - datetime.timedelta(days=TLS25_DAYS - 1)).isoformat()
    return {key: value for key, value in counts.items() if key >= oldest}


def tls25_status():
    """The switch and the sessions on port 25 of the last 7 days, from the hourly counts (no log read on the page)."""
    counts = _json_read(TLS25_COUNTS, {})
    sessions = sum(item.get('sessions', 0) for item in counts.values())
    plain = {}
    for item in counts.values():
        for client, count in item.get('plain', {}).items():
            plain[client] = plain.get(client, 0) + count
    # A host migrated from eFa 5 may require it for all of Postfix (main.cf): the form shows what is in effect.
    required = _json_read(TLS25_FILE, {}).get('on') or _postconf_many(['smtpd_tls_security_level']).get('smtpd_tls_security_level') == 'encrypt'
    return {'port25_mode': 'on' if required else 'off', 'port25_sessions_7d': sessions,
            'port25_without_tls_7d': sum(plain.values()),
            'port25_senders_without_tls': [f'{client}: {count}' for client, count in sorted(plain.items(), key=lambda item: (-item[1], item[0]))[:10]],
            'port25_warning': TLS25_WARNING}


def tls_port25_set(args):
    """Require TLS from every server that sends to port 25 (encrypt), or take it back. Only on with the risk confirmed."""
    on = _on_off(args.mode)
    if on and (getattr(args, 'confirm', '') or '').strip().lower() != 'yes':
        raise EfaError('Confirm that you read the warning: ' + TLS25_WARNING)
    # The smtpd behind postscreen when it is on; postscreen moves the options of the service along when it is switched.
    service = 'smtpd/pass' if 'postscreen' in _master_lines() else 'smtp/inet'
    master = f"{_postconf('config_directory')}/master.cf"
    with open(master) as f:
        before = f.read()
    if on:
        subprocess.run(['postconf', '-P', f'{service}/smtpd_tls_security_level=encrypt'], check=True, capture_output=True)
    else:
        subprocess.run(['postconf', '-PX', f'{service}/smtpd_tls_security_level'], check=False, capture_output=True)
        if _postconf('smtpd_tls_security_level') == 'encrypt':
            # taken over from eFa 5 for all of Postfix; submission keeps its own encrypt in master.cf
            _postconf_set('smtpd_tls_security_level', 'may')
    if subprocess.run(['postfix', 'check'], capture_output=True).returncode != 0:
        _write(master, before)
        raise EfaError('Postfix did not take the setting; nothing changed.')
    subprocess.run(['postfix', 'reload'], check=False, capture_output=True)
    _json_write(TLS25_FILE, {'on': on})
    _audit(f"TLS on port 25 {'required' if on else 'not required'} by {_dmarc_who()}")
    _event('tls_port25', 'warning' if on else 'notice', required=on)
    return tls_profile_status(None)


def tls_profile_set(args):
    """A TLS profile for the web interface and for mail. Everything stays inside the limit; nginx and Postfix check their
    settings before they load them, a refused one is taken back."""
    name = (args.profile or '').strip()
    if name not in (*TLS_PROFILES, 'custom'):
        raise EfaError('Profile: bsi, rfc9325, mozilla-modern or custom.')
    custom = (args.ciphers or '').strip()
    if name == 'custom':
        if not re.fullmatch(r'[A-Za-z0-9:+_-]{1,1000}', custom):
            raise EfaError('Ciphers: an OpenSSL list, separated by colons.')
        done = subprocess.run(['openssl', 'ciphers', '-v', '-tls1_2', custom], capture_output=True, text=True)
        problem = tls_cipher_problem(done.stdout.splitlines() if done.returncode == 0 else [])
        if problem:
            raise EfaError(problem)
    previous = tls_profile_state()
    state = {'profile': name, 'custom': custom if name == 'custom' else ''}
    _json_write(TLS_PROFILE_FILE, state)
    try:
        changed = _tls_postfix(state)
        _nginx_apply()
    except (EfaError, OSError, subprocess.CalledProcessError):
        _json_write(TLS_PROFILE_FILE, previous)
        _tls_postfix(previous)
        raise
    _audit(f'TLS profile {name} set by {_dmarc_who()}')
    return {**tls_profile_status(None), 'postfix_changed': changed}


def _tls_state_apply(state):
    """A TLS state for Postfix and nginx; nginx and Postfix check before they load, a refused one is taken back."""
    previous = tls_profile_state()
    _json_write(TLS_PROFILE_FILE, state)
    try:
        changed = _tls_postfix(state)
        _nginx_apply()
    except (EfaError, OSError, subprocess.CalledProcessError):
        _json_write(TLS_PROFILE_FILE, previous)
        _tls_postfix(previous)
        _nginx_apply()
        raise
    return changed


# SEC-STD: standards to choose (docs/tls-profiles.md, the values in /usr/share/eFa/standards.json). The strictest value of the chosen
# ones goes to the existing settings (TLS profile, SSH profile, kernel settings, DANE, TLS on port 25), never below the floor of
# eFa-next; port 25 stays opportunistic unless TLS is required there on purpose. The check reads what is in effect (postconf,
# nginx -T, sshd -T, sysctl, crypto policy), for every standard, chosen or not.
STANDARDS_DATA = next((path for path in (os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', 'share', 'eFa', 'standards.json'),
                                         '/usr/share/eFa/standards.json') if os.path.exists(path)), '/usr/share/eFa/standards.json')
STANDARDS_FILE = ETC + '/eFa/standards.json'
STANDARDS_CHECK = '/var/lib/eFa/standards-check.json'
STANDARDS_ROLLBACK = '/var/lib/eFa/standards-rollback.json'
STANDARDS_GUIDE = 'docs/dmarc-dane-mta-sts.md'
STANDARDS_BSI_TLS = ('bsi-02102-2', 'bsi-03116-4', 'bsi-03108')
TLS_VERSION_NAMES = {'SSLv2': '0.2', 'SSLv3': '0.3', 'TLSv1': '1.0', 'TLSv1.1': '1.1', 'TLSv1.2': '1.2', 'TLSv1.3': '1.3'}


def standards_data():
    with open(STANDARDS_DATA, encoding='utf-8') as f:
        return json.load(f)


def tls_versions(value):
    """The TLS versions a setting lets through: a list of nginx (TLSv1.2 TLSv1.3) or an exclusion of Postfix (!SSLv2, !TLSv1)."""
    words = [word for word in re.split(r'[\s,:]+', value or '') if word]
    if any(word.startswith('!') for word in words) or not words:
        out = {TLS_VERSION_NAMES[word[1:]] for word in words if word.startswith('!') and word[1:] in TLS_VERSION_NAMES}
        return sorted(v for v in ('1.0', '1.1', '1.2', '1.3') if v not in out)
    floor = next((word[2:] for word in words if word.startswith('>=')), None)
    if floor:
        return sorted(v for v in ('1.0', '1.1', '1.2', '1.3') if TLS_VERSION_NAMES.get(floor, '9') <= v)
    return sorted(TLS_VERSION_NAMES[word] for word in words if word in TLS_VERSION_NAMES and TLS_VERSION_NAMES[word] >= '1.0')


def _wild(name, patterns):
    return any(fnmatch.fnmatch(name, pattern) for pattern in patterns)


def standards_equivalents(data):
    """{name: entry} of the values that count as fulfilling a standard although not in its list (owner, 2026-11-13: a
    standard fulfilled through a stronger one says so). Only the table of standards.json with its sources, never a guess;
    none when "deliberate" is off (strictly the lists)."""
    if not (data.get('deliberate') or {}).get('on'):
        return {}
    return {name: entry for name, entry in (data.get('equivalents') or {}).items() if isinstance(entry, dict)}


def equivalent_text(name, entry):
    relation = 'stronger than' if entry['relation'] == 'stronger' else 'as strong as'
    return f"{name}: {relation} {entry['than']} ({entry['why']}; {', '.join(entry['refs'])})"


def _std_bad(bad, soft):
    """(status, wanted) of names outside a list: alternative (fulfilled through a stronger or equal standard) when each has an
    entry in the table of equivalents, else not."""
    if not bad:
        return None
    if all(name in soft for name in bad):
        return 'alternative', 'fulfilled through: ' + '; '.join(equivalent_text(name, soft[name]) for name in bad)
    return 'not', 'not ' + ':'.join(name for name in bad if name not in soft)


def _std_rule(rule, facts, lists):
    """[(service or setting, status, now, wanted)] of one rule; status fulfilled, over, not, needs (DNS records or a mailbox),
    alternative (only values the table of equivalents names: fulfilled through a stronger or equal standard)."""
    found = []
    soft = lists.get('_equivalents', {})
    kind = rule['kind']
    allowed = lists.get(rule.get('list'), rule.get('list')) if isinstance(rule.get('list'), str) else rule.get('list', [])
    allowed = list(allowed or []) + rule.get('extra', [])
    for service in rule.get('services', [None]):
        versions = facts['versions'].get(service, []) if service else []
        if kind == 'tls_min':
            low = versions[0] if versions else ''
            status = 'not' if not low or low < rule['value'] else 'over' if low > rule['value'] else 'fulfilled'
            found.append((service, status, ', '.join(versions) or 'unknown', 'from TLS ' + rule['value']))
        elif kind == 'tls13':
            found.append((service, 'fulfilled' if '1.3' in versions else 'not', ', '.join(versions), 'TLS 1.3 offered'))
        elif kind in ('ciphers12', 'ciphers12_aead_pfs'):
            if '1.2' not in versions:
                found.append((service, 'over', 'TLS 1.2 off', 'TLS 1.2 cipher suites'))
                continue
            names = facts['ciphers'].get(service, [])
            if kind == 'ciphers12':
                bad = [name for name in names if name not in allowed]
            else:
                bad = [name for name in names if not (name.startswith(('ECDHE-', 'DHE-')) and re.search(r'GCM|CHACHA20|CCM', name))]
            found.append((service, 'not' if bad or not names else 'fulfilled', ':'.join(names) or 'unknown',
                          'not ' + ':'.join(bad) if bad else 'only the listed suites'))
        elif kind == 'groups':
            names = facts['groups'].get(service, [])
            status, wanted = _std_bad([name for name in names if name not in allowed], soft) or ('fulfilled', 'only the listed groups')
            found.append((service, status, ':'.join(names) or 'default of OpenSSL', wanted))
        elif kind == 'groups_required':
            names = facts['groups'].get(service, [])
            missing = [name for name in allowed if name not in names and name + 'tls13' not in names]
            found.append((service, 'not' if missing else 'fulfilled', ':'.join(names) or 'default of OpenSSL', 'also ' + ':'.join(missing) if missing else 'all listed'))
        elif kind == 'cert_key':
            for where, key in sorted(facts['cert_keys'].items()):
                if not key:
                    continue
                need = rule['ec'] if key[0] in ('ec', 'ed25519') else rule['rsa']
                status = 'not' if key[1] < need else 'over' if key[1] > need and key[0] == 'rsa' else 'fulfilled'
                found.append((f'certificate {where}', status, f'{key[0]} {key[1]} bits', f'RSA from {rule["rsa"]}, ECC from {rule["ec"]} bits'))
        elif kind == 'cert_type':
            key = facts['cert_keys'].get('web')
            found.append(('certificate web', 'fulfilled' if key and key[0] == 'ec' else 'not', f'{key[0]} {key[1]} bits' if key else 'none', 'ECDSA'))
        elif kind == 'dkim_rsa':
            small = [bits for bits in facts['dkim_rsa_bits'] if bits < rule['value']]
            found.append(('DKIM keys', 'not' if small else 'fulfilled', ', '.join(f'RSA {bits}' for bits in facts['dkim_rsa_bits']) or 'no RSA key',
                          f'RSA from {rule["value"]} bits'))
        elif kind in ('ssh_allowed', 'ssh_forbidden'):
            names = [name for name in facts['sshd'].get(rule['field'], '').split(',') if name]
            bad = [name for name in names if (not _wild(name, allowed)) == (kind == 'ssh_allowed')]
            status, wanted = _std_bad(bad, soft if kind == 'ssh_allowed' else {}) or ('fulfilled', 'as listed')
            found.append((f'sshd {rule["field"]}', status, ','.join(names) or 'unknown', wanted))
        elif kind == 'ssh_option':
            now = facts['sshd'].get(rule['field'], '')
            ok = now.isdigit() and int(now) <= int(rule['value']) if rule['op'] == '<=' else now == rule['value']
            found.append((f'sshd {rule["field"]}', 'fulfilled' if ok else 'not', now or 'unknown', f'{rule["op"]} {rule["value"]}'))
        elif kind == 'sysctl':
            for name, value in sorted(rule['values'].items()):
                now = facts['sysctl'].get(name, '')
                found.append((name, 'fulfilled' if now == value else 'not', now or 'unknown', value))
        elif kind == 'crypto_policy_not':
            now = facts['crypto_policy']
            found.append(('crypto policy', 'not' if not now or now.split(':')[0] in allowed else 'fulfilled', now or 'unknown', 'not ' + ', '.join(allowed)))
        elif kind == 'session_max':
            # TR-03116-4 2.1.1: a TLS session (resumption included) lives 48 hours at most.
            now = facts.get('session_seconds', {}).get(service)
            found.append((f'{service} TLS session', 'not' if now is None or now > rule['hours'] * 3600 else 'fulfilled',
                          'unknown' if now is None else f'{now} s', f'at most {rule["hours"]} h'))
        elif kind == 'no_early_data':
            # TR-03116-4 2.3.1: no 0-RTT data. Postfix has none; nginx only with ssl_early_data on.
            found.append(('TLS 1.3 0-RTT (early data)', 'not' if facts.get('early_data') else 'fulfilled',
                          'on' if facts.get('early_data') else 'off', 'off'))
        elif kind == 'hsts':
            now = facts['hsts']
            found.append(('HSTS', 'fulfilled' if now >= rule['value'] else 'not', f'{now} s', f'from {rule["value"]} s'))
        elif kind == 'starttls_in':
            found.append(('port 25 STARTTLS', 'fulfilled' if facts['starttls_in'] else 'not', 'offered' if facts['starttls_in'] else 'off', 'offered'))
        elif kind == 'dnssec_resolver':
            found.append(('DNSSEC resolver', 'fulfilled' if facts['dnssec'] else 'not', 'validates' if facts['dnssec'] else 'does not validate', 'validates'))
        elif kind == 'dane_out':
            found.append(('DANE outgoing', 'fulfilled' if facts['dane'] else 'not', 'on' if facts['dane'] else 'off', 'on (dane-set)'))
        elif kind == 'dane_in':
            found.append(('DANE incoming (TLSA)', 'needs', 'DNS', f'TLSA records of the MX (tlsa-show, {STANDARDS_GUIDE})'))
        elif kind == 'tls_rpt':
            found.append(('TLS-RPT', 'fulfilled' if facts['tls_rpt'] else 'needs', 'on' if facts['tls_rpt'] else 'off',
                          f'a mailbox for the reports and the DNS record ({STANDARDS_GUIDE})'))
        elif kind == 'mta_sts':
            found.append(('MTA-STS', 'fulfilled' if facts['mta_sts'] else 'needs', 'on' if facts['mta_sts'] else 'off',
                          f'DNS records and a web server for the policy ({STANDARDS_GUIDE})'))
    return found


def standards_evaluate(data, facts):
    """Every standard against the settings in effect: its status and each finding with why it counts."""
    lists = {key: value for key, value in data.items() if isinstance(value, list)}
    lists['_equivalents'] = standards_equivalents(data)
    result = {}
    for sid, std in data['standards'].items():
        rows = []
        for rule in std['rules']:
            for setting, status, now, wanted in _std_rule(rule, facts, lists):
                if rule.get('level') == 'recommended' and status == 'not':
                    status = 'needs'
                rows.append({'setting': setting, 'status': status, 'now': now, 'wanted': wanted, 'why': rule['why']})
        states = {row['status'] for row in rows}
        status = 'not' if 'not' in states else 'needs' if 'needs' in states else 'alternative' if 'alternative' in states else \
            'over' if 'over' in states else 'fulfilled'
        result[sid] = {'title': std['title'], 'version': std['version'], 'verified': std['verified'], 'status': status,
                       'note': std.get('note', ''), 'rows': rows}
    return result


def tls_seconds(text):
    """Seconds of an nginx or Postfix time (300, 5m, 3600s, 1h, 2d); None when it cannot be read."""
    found = re.fullmatch(r'\s*(\d+)\s*([smhdw]?)\s*', text or '')
    return int(found.group(1)) * {'': 1, 's': 1, 'm': 60, 'h': 3600, 'd': 86400, 'w': 604800}[found.group(2)] if found else None


def _standards_facts():
    f = _hardening_facts()
    names = ('smtpd_tls_protocols', 'smtpd_tls_mandatory_protocols', 'smtp_tls_protocols', 'tls_high_cipherlist', 'tls_eecdh_auto_curves',
             'smtpd_tls_security_level')
    pc = {name: _postconf(name) for name in names}
    nginx = subprocess.run(['nginx', '-T'], capture_output=True, text=True).stdout
    nginx_values = {name: value for _file, name, value in nginx_tls_directives(nginx)}
    curves = re.search(r'^\s*ssl_ecdh_curve\s+([^;]+);', nginx, re.M)
    hsts = re.search(r'Strict-Transport-Security\s+"max-age=(\d+)', nginx)
    session = re.search(r'^\s*ssl_session_timeout\s+([^;]+);', nginx, re.M)
    early = re.search(r'^\s*ssl_early_data\s+on\s*;', nginx, re.M)
    mail_ciphers = pc['tls_high_cipherlist'].split(':') if pc['tls_high_cipherlist'] else []
    mail_groups = pc['tls_eecdh_auto_curves'].split()
    sysctl = dict(f['sysctl'])
    for rule in (rule for std in standards_data()['standards'].values() for rule in std['rules'] if rule['kind'] == 'sysctl'):
        for name in rule['values']:
            if name not in sysctl:
                done = subprocess.run(['sysctl', '-n', name], capture_output=True, text=True)
                sysctl[name] = done.stdout.strip() if done.returncode == 0 else ''
    policy = subprocess.run(['update-crypto-policies', '--show'], capture_output=True, text=True)
    return {'versions': {'web': tls_versions(nginx_values.get('ssl_protocols', '')), 'submission': tls_versions(pc['smtpd_tls_mandatory_protocols']),
                         'mail_in': tls_versions(pc['smtpd_tls_protocols']), 'mail_out': tls_versions(pc['smtp_tls_protocols'])},
            'ciphers': {'web': [c for c in nginx_values.get('ssl_ciphers', '').split(':') if c], 'submission': mail_ciphers, 'mail_in': mail_ciphers,
                        'mail_out': mail_ciphers},
            'groups': {'web': curves.group(1).strip().split(':') if curves else [], 'submission': mail_groups, 'mail_in': mail_groups, 'mail_out': mail_groups},
            'cert_keys': {name: key for name, key in f.get('cert_keys', {}).items()}, 'dkim_rsa_bits': f.get('dkim_rsa_bits', []),
            'sshd': f['sshd'], 'sysctl': sysctl, 'crypto_policy': policy.stdout.strip() if policy.returncode == 0 else '',
            'session_seconds': {'web': tls_seconds(session.group(1)) if session else 300,
                                'mail': tls_seconds(_postconf('smtpd_tls_session_cache_timeout') or '3600s')},
            'early_data': bool(early),
            'hsts': int(hsts.group(1)) if hsts else 0, 'starttls_in': pc['smtpd_tls_security_level'] in ('may', 'encrypt'),
            'dnssec': bool(f.get('dnssec')), 'dane': bool(f.get('dane')), 'tls_rpt': bool(f.get('tls_rpt')), 'mta_sts': bool(f.get('mta_sts'))}


def standards_check(_args):
    """Every standard (chosen or not) against the settings in effect, with the reason of each finding. Kept for the page and the
    dashboard; nothing is changed."""
    result = {'checked': time.strftime('%Y-%m-%d %H:%M:%S'), 'selected': standards_state()['selected'],
              'standards': standards_evaluate(standards_data(), _standards_facts())}
    _json_write(STANDARDS_CHECK, result, mode=0o644)
    return result


def standards_show(_args):
    """The last check, for the page (fast: from the last run of standards-check)."""
    found = _json_read(STANDARDS_CHECK, {})
    if not found:
        return {'checked': 'not yet', 'note': 'Check now (standards-check) reads the settings in effect.', 'standards': {}}
    found['summary'] = {status: sum(1 for item in found['standards'].values() if item['status'] == status)
                        for status in ('fulfilled', 'over', 'alternative', 'needs', 'not')}
    return found


def standards_state():
    return {'selected': [], 'port25_tls': False, **_json_read(STANDARDS_FILE, {})}


def standards_status(_args):
    data, state = standards_data(), standards_state()
    tls25 = _safe(tls25_status, {})
    return {'selected': state['selected'], 'port25_tls': 'on' if state['port25_tls'] else 'off',
            'port25_mode': tls25.get('port25_mode', ''), 'port25_without_tls_7d': tls25.get('port25_without_tls_7d', 0),
            'port25_sessions_7d': tls25.get('port25_sessions_7d', 0),
            'standards': [{'id': sid, 'title': item['title'], 'version': item['version'], 'verified': item['verified'], 'note': item.get('note', '')}
                          for sid, item in data['standards'].items()],
            'rollback': os.path.exists(STANDARDS_ROLLBACK)}


def standards_plan(selected, port25, now, os_items=None):
    """What applying the chosen standards changes: [(setting, now, then, because)] and the warnings, from now (the state of each
    setting). Only ever stricter than now for what a chosen standard asks; port 25 only as asked. os_items (the hardening wizard,
    the setup): the SSH profile and the kernel settings only when listed there, even if a standard asks for them."""
    changes, warnings = [], []
    chosen = set(selected)
    tls = dict(now['tls'])
    if chosen & {'bsi-02102-2', 'bsi-03116-4', 'bsi-03108', 'rfc9325', 'moz-modern', 'moz-inter', 'nist-80052'}:
        tls = {'profile': 'bsi' if chosen & set(STANDARDS_BSI_TLS) else 'rfc9325', 'custom': '', 'web13': 'moz-modern' in chosen}
        if now['tls'].get('profile') == 'bsi' and not chosen & set(STANDARDS_BSI_TLS):
            tls['profile'] = 'bsi'  # never weaker than now
        tls['web13'] = tls['web13'] or bool(now['tls'].get('web13'))
    if tls != now['tls']:
        changes.append(('TLS profile', f"{now['tls'].get('profile')}{' (web TLS 1.3 only)' if now['tls'].get('web13') else ''}",
                        f"{tls['profile']}{' (web TLS 1.3 only)' if tls['web13'] else ''}", 'the cipher suites and TLS versions of the chosen standards'))
    if tls.get('web13') and not now['tls'].get('web13'):
        warnings.append('The web interface then needs TLS 1.3: a very old browser cannot open it. Port 587 stays at TLS 1.2 (intermediate).')
    ssh = 'bsi' if (chosen & {'bsi-02102-4', 'cis-el'} if os_items is None else 'ssh-profile' in os_items) else now['ssh']
    if ssh != now['ssh']:
        changes.append(('SSH profile', 'outdated' if now.get('ssh_outdated') else now['ssh'], ssh, 'BSI TR-02102-4 / CIS: the SSH algorithms'))
        warnings.append('The SSH profile goes back after 10 minutes unless a new login confirms it (ssh-profile-confirm): keep a session open.')
        warnings.append('BSI TR-02102-4 allows ECDSA host keys only: a client that knows only the Ed25519 or RSA key of this host '
                        'asks about the ECDSA key on the next login. Check its fingerprint: ssh-keygen -lf /etc/ssh/ssh_host_ecdsa_key.pub')
    elif now.get('ssh_outdated'):
        warnings.append('The SSH profile is outdated (written by an older version): choose the SSH profile to write it anew.')
    kernel = True if ('cis-el' in chosen if os_items is None else 'kernel' in os_items) else now['kernel']
    if kernel != now['kernel']:
        changes.append(('Kernel settings', 'outdated' if now.get('kernel_outdated') else 'off' if not now['kernel'] else 'on', 'on',
                        'CIS: the network and kernel settings'))
        if KERNEL_SETTINGS.get('net.ipv4.conf.all.rp_filter') == '1':
            warnings.append('CIS sets rp_filter = 1 (strict): a host that answers over another interface than the one a packet came in '
                            '(own routes for an uplink) drops such packets. Check the routes first.')
    elif now.get('kernel_outdated'):
        warnings.append('The kernel settings are outdated (written by an older version): choose them to write them anew.')
    dane = True if 'bsi-03108' in chosen else now['dane']
    if dane and not now['dane'] and now.get('smtp_level') in DANE_STRICT_LEVELS:
        dane = False
        warnings.append(_text(DANE_STRICT_TEXT, level=now['smtp_level']))
    if dane != now['dane']:
        changes.append(('DANE outgoing', 'off', 'on', 'BSI TR-03108-06-M'))
        if not now['dnssec']:
            warnings.append('DANE needs a DNSSEC-validating resolver; the own one does not validate now: DANE is not switched on.')
    if port25 is not None and port25 != now['port25']:
        changes.append(('TLS required on port 25', 'on' if now['port25'] else 'off', 'on' if port25 else 'off', 'chosen on purpose (OV-2)'))
        if port25:
            warnings.append(f"Servers that send without TLS then fail: {now['port25_plain']} of {now['port25_sessions']} sessions on port 25 "
                            'came without TLS in the last 7 days.')
    if chosen & set(STANDARDS_BSI_TLS):
        warnings.append('eFa-next keeps the groups X25519 and the quantum-safe hybrid X25519MLKEM768 (security first): TR-02102-2 lists neither '
                        'yet, the check shows them as fulfilled through a stronger or equal standard, with the sources.')
    return {'tls': tls, 'ssh': ssh, 'kernel': kernel, 'dane': dane and now['dnssec'] if dane != now['dane'] else dane,
            'port25': now['port25'] if port25 is None else port25}, changes, warnings


def _standards_now():
    tls25 = tls25_status()
    # outdated counts as not set: choosing it writes it anew (on purpose, never by an update).
    ssh = ssh_profile_now()
    return {'tls': {'profile': 'bsi', 'custom': '', 'web13': False, **tls_profile_state()}, 'ssh': 'bsi' if ssh == 'bsi' else 'system',
            'ssh_outdated': ssh == 'outdated', 'kernel': kernel_state() == 'on', 'kernel_outdated': kernel_state() == 'outdated', 'dane': _postconf('smtp_tls_security_level') == 'dane', 'smtp_level': _postconf('smtp_tls_security_level'), 'dnssec': _resolver_validates(),
            'port25': tls25['port25_mode'] == 'on', 'port25_plain': tls25['port25_without_tls_7d'], 'port25_sessions': tls25['port25_sessions_7d']}


def standards_set(args):
    """Choose standards: without --apply yes a preview (old and new of each setting, the warnings); with it the change, a
    rollback point first and an entry in the audit log. Warnings do not block, they need --confirm yes. --os and --efa (the
    hardening wizard, the setup) add the items of efa_harden; they are switched one after another, the first error stops."""
    selected, (os_items, efa_items), now, wanted, changes, warnings, before = _standards_preview(args)
    preview = _preview_out(selected, changes, warnings)
    if (args.apply or '').strip() != 'yes':
        return {**preview, 'note': 'A preview: nothing changed. Apply with apply=yes' + (' and confirm=yes (warnings)' if warnings else '') + '.'}
    if warnings and (args.confirm or '').strip() != 'yes':
        raise EfaError('Read the warnings and confirm them with confirm=yes: ' + ' '.join(warnings))
    # 2026-11-15: the web certificate stopped a run after SSH and kernel had changed. What can be checked before is checked
    # before anything changes.
    blocked = standards_preflight(before)
    if blocked:
        raise EfaError('Stopped before any change: ' + ' '.join(blocked) + ' Nothing changed.')
    saved = {'state': standards_state(), 'now': now, 'items': before, 'when': time.strftime('%Y-%m-%d %H:%M:%S'), 'files': _standards_files()}
    _json_write(STANDARDS_ROLLBACK, saved, mode=0o600)
    done, skipped = [], []
    try:
        if (getattr(args, 'keep_ssh', '') or '') == 'yes':
            wanted = {**wanted, 'ssh': now['ssh']}  # cluster hardening: SSH only on the hosts ticked for it
        _standards_put(now, wanted)
        done += [a for a, _b, _c, _d in changes if a in ('TLS profile', 'SSH profile', 'Kernel settings', 'DANE outgoing', 'TLS required on port 25')]
        lib = _harden()
        for key in before['os']:
            if lib.OS_ITEMS[key]['via'] == 'command':
                _os_command_put(key, True)
            else:
                os_harden_set(argparse.Namespace(item=key, mode='on', confirm='yes'))
            done.append(lib.OS_ITEMS[key]['title'])
        for key in before['efa']:
            if not _efa_item_on(key):
                if key == 'web-ecdsa':
                    # Let's Encrypt is outside: its failure keeps the certificate and is a note, never a stop of the whole run.
                    try:
                        _efa_item_put(key, True)
                    except EfaError as err:
                        skipped.append(f"{lib.EFA_ITEMS[key]['title']}: {str(err)[:300]}")
                        _audit(f"security standards: {lib.EFA_ITEMS[key]['title']} not set by {_dmarc_who()}: {str(err)[:200]}")
                        continue
                else:
                    _efa_item_put(key, True)
            done.append(lib.EFA_ITEMS[key]['title'])
    except (EfaError, OSError, subprocess.CalledProcessError, KeyError) as err:
        _audit(f'security standards {", ".join(selected) or "none"} stopped by {_dmarc_who()}: {str(err)[:200]}; changed before: {", ".join(done) or "nothing"}')
        if not done:
            raise EfaError(f'Stopped: {str(err)[:300]} Nothing was changed.')
        # A stop halfway leaves no half hardened host: what this run changed goes back at once, as standards-rollback does.
        try:
            kept = _standards_undo(saved)
        except (EfaError, OSError, subprocess.CalledProcessError, KeyError) as undo_err:
            _audit(f'security standards: taking back after the stop failed: {str(undo_err)[:200]}')
            raise EfaError(f'Stopped: {str(err)[:300]} Already changed: {", ".join(done)}. Taking it back failed ({str(undo_err)[:200]}): '
                           'Security standards, back to the settings before (standards-rollback).')
        _audit(f'security standards: taken back after the stop by {_dmarc_who()}: {", ".join(done)}' + (f'; kept: {", ".join(kept)}' if kept else ''))
        raise EfaError(f'Stopped: {str(err)[:300]} Taken back: {", ".join(done)}.' + (f' Kept (no way back): {", ".join(kept)}.' if kept else '')
                       + ' The server is as before.')
    _json_write(STANDARDS_FILE, {'selected': selected, 'port25_tls': wanted['port25']}, mode=0o644)
    _audit(f'security standards {", ".join(selected) or "none"} applied by {_dmarc_who()}: '
           + ('; '.join(f'{a} {b} -> {c}' for a, b, c, _d in changes) or 'nothing to change'))
    check = standards_check(None)['standards']
    open_items = [{'standard': sid, 'status': check[sid]['status'],
                   'missing': [f"{row['setting']}: {row['now']} ({row['wanted']})" for row in check[sid].get('rows', []) if row.get('status') in ('not', 'needs')][:8]}
                  for sid in selected if sid in check and check[sid].get('status') not in ('fulfilled', 'over', 'alternative')]
    return {**preview, 'applied': True, 'changed': done, 'check': check, 'open': open_items, **({'not_set': skipped} if skipped else {}),
            **({'ssh_note': f'Log in again over SSH in a new window and confirm within {SSH_REVERT_MINUTES} minutes (ssh-profile-confirm); '
                            'otherwise the SSH profile goes back by itself.'} if wanted['ssh'] != now['ssh'] else {})}


def _standards_put(now, wanted):
    if wanted['tls'] != now['tls']:
        _tls_state_apply(wanted['tls'])
    if wanted['ssh'] != now['ssh']:
        ssh_profile_set(argparse.Namespace(mode=wanted['ssh']))
    if wanted['kernel'] != now['kernel']:
        kernel_hardening_set(argparse.Namespace(mode='on' if wanted['kernel'] else 'off'))
    if wanted['dane'] != now['dane']:
        dane_set(argparse.Namespace(mode='on' if wanted['dane'] else 'off'))
    if wanted['port25'] != now['port25']:
        tls_port25_set(argparse.Namespace(mode='on' if wanted['port25'] else 'off', confirm='yes'))


def standards_rollback(args):
    """Back to the settings before the last apply of standards: the eFa-next switches and the OS items it changed, then SEC-STD.
    What has no way back (port 587 without system accounts, TLS 1.0) is named."""
    _confirm(args)
    saved = _json_read(STANDARDS_ROLLBACK, {})
    if not saved:
        raise EfaError('No rollback point: no standards were applied.')
    kept = _standards_undo(saved)
    _audit(f"security standards: back to the settings of {saved['when']} by {_dmarc_who()}" + (f"; kept: {', '.join(kept)}" if kept else ''))
    return {**standards_status(None), **({'kept': kept, 'kept_note': 'These have no way back by design.'} if kept else {})}


def standards_preflight(before):
    """What would stop an apply halfway, found before anything changes: [reason]. Only checks that read."""
    blocked = []
    if 'web-ecdsa' in (before.get('efa') or {}) and not _safe(lambda: _efa_item_on('web-ecdsa'), True):
        try:
            with open(NGINX_CONF) as f:
                nginx_cert_rewrite(f.read(), '/check', '/check')
        except OSError as err:
            blocked.append(f'{NGINX_CONF}: {err.strerror}.')
        except EfaError as err:
            blocked.append(str(err).replace(' Nothing changed.', ''))
    return blocked


# The files of the SSH profile and the kernel settings as they were: an "outdated" one (of an older version) counts as off for the
# plan, so going back by on/off alone removed it instead of putting it back (2026-11-15). Going back writes them as they were.
KERNEL_FILE = ETC + '/sysctl.d/90-efa.conf'


def _standards_files():
    found = {}
    for path in (SSH_BSI_FILE, KERNEL_FILE):
        try:
            with open(path) as f:
                found[path] = f.read()
        except FileNotFoundError:
            found[path] = None
    return found


def _standards_files_restore(files, kept):
    """Puts the SSH profile and the kernel settings back as they were before the apply (files of _standards_files)."""
    ssh = files.get(SSH_BSI_FILE)
    if ssh is not None and _read_text(SSH_BSI_FILE) != ssh:
        _write(SSH_BSI_FILE, ssh)
        os.chmod(SSH_BSI_FILE, 0o600)
        if os.path.exists(SSH_BSI_FILE + '.pending'):
            os.remove(SSH_BSI_FILE + '.pending')
        _safe(lambda: _platform().service_stop('efa-ssh-revert.timer'), None)
        try:
            _sshd_apply()
        except EfaError:
            os.remove(SSH_BSI_FILE)
            _sshd_apply()
            kept.append('SSH profile of before (sshd refused it, the system setting applies)')
    if KERNEL_FILE in files:
        kernel = files[KERNEL_FILE]
        if kernel is not None and _read_text(KERNEL_FILE) != kernel:
            _write(KERNEL_FILE, kernel)
            subprocess.run(['sysctl', '-q', '-p', KERNEL_FILE], capture_output=True)


def _read_text(path):
    try:
        with open(path) as f:
            return f.read()
    except FileNotFoundError:
        return None


def _standards_undo(saved):
    """Puts back what the apply of saved changed: the eFa-next switches, the OS items, SSH, kernel, TLS, DANE, port 25; then the
    chosen standards of before. The names of what has no way back."""
    lib, items, kept = _harden(), saved.get('items') or {'os': [], 'efa': {}}, []
    for key, mode in reversed(list(items['efa'].items())):
        if not _efa_item_on(key):
            continue
        if lib.EFA_ITEMS[key].get('once'):
            kept.append(lib.EFA_ITEMS[key]['title'])
        else:
            _efa_item_put(key, False, mode)
    for key in reversed(items['os']):
        via = lib.OS_ITEMS[key]['via']
        if via == 'os-harden' and key in _json_read(OS_HARDEN_FILE, {}):
            os_harden_set(argparse.Namespace(item=key, mode='off'))
        elif via == 'command' and key == 'firewall-guard':
            _os_command_put(key, False)
        elif via == 'command':
            kept.append(lib.OS_ITEMS[key]['title'])
    _standards_put(_standards_now(), saved['now'])
    if saved.get('files'):
        _standards_files_restore(saved['files'], kept)
    _json_write(STANDARDS_FILE, saved['state'], mode=0o644)
    if os.path.exists(STANDARDS_ROLLBACK):
        os.remove(STANDARDS_ROLLBACK)
    return kept


def standards_notices():
    """The chosen standards that the last check found not fulfilled."""
    found = _json_read(STANDARDS_CHECK, {})
    bad = [item['title'] for sid, item in found.get('standards', {}).items() if sid in standards_state()['selected'] and item['status'] == 'not']
    return [_text('Chosen security standards not fulfilled: {names} (Security standards, check of {when}).', names=', '.join(bad),
                  when=found.get('checked', ''))] if bad else []


def standards_checks_for_report():
    """The last check as rows of the hardening report (PDF): one per standard and finding that does not hold."""
    found = _json_read(STANDARDS_CHECK, {}).get('standards', {})
    rows = []
    for sid, item in found.items():
        reference = f"{item['title']} {item['version']}" + ('' if item['verified'] else ' (not verified)')
        bad = [row for row in item['rows'] if row['status'] in ('not', 'needs', 'alternative')]
        rows.append({'reference': reference, 'title': f'Standard {sid}: {item["status"]}',
                     'result': 'pass' if item['status'] in ('fulfilled', 'over', 'alternative') else 'fail',
                     'detail': '; '.join(f"{row['setting']}: {row['now']} ({row['wanted']}; {row['why']})" for row in bad[:6]),
                     'fix': 'Security standards page' if bad else ''})
    return rows


# HARD-W: the hardening wizard and the setup apply the items of efa_harden around SEC-STD: the operating system (os-harden-set and
# the commands there are) and the switches of eFa-next. Only ever stricter; off puts back what was there before. PermitRootLogin
# is never touched (ssh-root-set), SELinux, OS updates and host keys are hints only, foreign services are only named.
OS_HARDEN_FILE = '/var/lib/eFa/os-harden.json'
SSHD_CIS_FILE = ETC + '/ssh/sshd_config.d/30-efa-cis.conf'
LOGIN_DEFS = ETC + '/login.defs'
SHADOW_FILE = ETC + '/shadow'
CRYPTO_POLICY_FILE = ETC + '/crypto-policies/config'
# The units of eFa-next and of the base system that may listen; any other is a foreign service (named, never stopped).
KNOWN_UNITS = ('postfix', 'nginx', 'rspamd', 'mariadb', 'mysqld', 'unbound', 'redis', 'valkey', 'chronyd', 'sshd', 'dovecot', 'fail2ban',
               'NetworkManager', 'auditd', 'rsyslog', 'crond', 'firewalld', 'init')


def _harden():
    return _lib('efa_harden')


def _service_on(name):
    try:
        return bool(_platform().service_is_active(name))
    except Exception:  # a unit the platform does not know
        return False


def _crypto_policy():
    lines = [line for line in _read_lines(CRYPTO_POLICY_FILE) if not line.startswith('#')]
    return lines[0] if lines else 'DEFAULT'


def _crypto_policy_set(name):
    subprocess.run(['update-crypto-policies', '--set', name], check=True, capture_output=True)


def _login_defs_method():
    for line in _read_lines(LOGIN_DEFS):
        parts = line.split()
        if len(parts) >= 2 and parts[0] == 'ENCRYPT_METHOD':
            return parts[1]
    return ''


def _login_defs_set(value):
    text = open(LOGIN_DEFS).read() if os.path.exists(LOGIN_DEFS) else ''
    if value:
        new, count = re.subn(r'(?m)^ENCRYPT_METHOD[ \t]+\S+[ \t]*$', f'ENCRYPT_METHOD {value}', text)
        new = new if count else text.rstrip('\n') + f'\nENCRYPT_METHOD {value}\n'
    else:
        new = re.sub(r'(?m)^ENCRYPT_METHOD[ \t]+\S+[ \t]*\n?', '', text)
    _write(LOGIN_DEFS, new, 0o644)


def _sshd_effective():
    return dict(line.split(None, 1) for line in subprocess.run(['sshd', '-T'], capture_output=True, text=True).stdout.splitlines() if ' ' in line)


def sshd_cis_wanted(sshd):
    """The CIS options sshd does not meet now (sshd -T), never weaker than now: a smaller number set already stays (the drop-in
    comes first, so a value written here would win); 0 of ClientAliveInterval or ClientAliveCountMax switches the check off."""
    found = []
    for key, value in _harden().SSHD_CIS:
        now = sshd.get(key.lower(), '')
        if value.isdigit() and now.isdigit():
            weaker = int(now) > int(value) or (key.startswith('ClientAlive') and int(now) == 0)
        else:
            weaker = now != value
        if weaker:
            found.append((key, value))
    return found


def sshd_cis_text(wanted):
    lines = ['# Written by efactl os-harden-set (CIS). efactl os-harden-set --item=sshd-cis --mode=off removes it.',
             '# Only what sshd did not meet yet. PermitRootLogin is not set here: it stays with ssh-root-set (00-efa-root.conf).']
    return '\n'.join(lines + [f'{key} {value}' for key, value in wanted]) + '\n'


def _os_item_on(item):
    platform_now = _platform()
    if item == 'ssh-profile':
        # On only with effect: the file alone (a list of before, or one overridden) is not the profile.
        return ssh_profile_now() == 'bsi'
    if item == 'kernel':
        return kernel_state() == 'on'
    if item == 'network-harden':
        path = getattr(platform_now, 'NO_AUTO_FILE', None)
        return bool(path) and os.path.exists(path)
    if item == 'firewall-guard':
        return bool(_firewall_state().get('guard'))
    if item == 'auditd':
        return _service_on('auditd')
    if item == 'chronyd':
        return _service_on(platform_now.service('time'))
    if item == 'sshd-cis':
        return os.path.exists(SSHD_CIS_FILE) or not sshd_cis_wanted(_sshd_effective())
    if item == 'encrypt-method':
        return _login_defs_method() in ('SHA512', 'YESCRYPT')
    if item == 'shadow-mode':
        try:
            return not os.stat(SHADOW_FILE).st_mode & 0o077
        except OSError:
            return False
    if item == 'crypto-policy':
        return _crypto_policy().split(':')[0] != 'LEGACY'
    if item == 'crypto-future':
        return _crypto_policy().split(':')[0] == 'FUTURE'
    raise KeyError(item)


def _os_unit(item):
    return 'auditd' if item == 'auditd' else _platform().service('time')


def _os_item_before(item):
    """What os-harden-set off puts back."""
    if item in ('auditd', 'chronyd'):
        platform_now, unit = _platform(), _os_unit(item)
        return {'enabled': bool(_safe(lambda: platform_now.service_is_enabled(unit), False)), 'active': _service_on(unit)}
    if item == 'encrypt-method':
        return _login_defs_method()
    if item == 'shadow-mode':
        return os.stat(SHADOW_FILE).st_mode & 0o777
    if item in ('crypto-policy', 'crypto-future'):
        return _crypto_policy()
    return None


def _os_item_put(item, on, before):
    platform_now = _platform()
    if item in ('auditd', 'chronyd'):
        unit = _os_unit(item)
        if on:
            platform_now.service_enable(unit, start=True)
            return
        if not before.get('enabled'):
            platform_now.service_disable(unit)
        if not before.get('active'):
            try:
                platform_now.service_stop(unit)
            except Exception:  # auditd refuses a stop by the service manager: it stays until the next boot
                pass
    elif item == 'sshd-cis':
        if on:
            _write(SSHD_CIS_FILE, sshd_cis_text(sshd_cis_wanted(_sshd_effective())), 0o600)
            try:
                _sshd_apply()
            except EfaError:
                os.remove(SSHD_CIS_FILE)
                raise
        elif os.path.exists(SSHD_CIS_FILE):
            text = open(SSHD_CIS_FILE).read()
            os.remove(SSHD_CIS_FILE)
            try:
                _sshd_apply()
            except EfaError:
                _write(SSHD_CIS_FILE, text, 0o600)
                raise
    elif item == 'encrypt-method':
        _login_defs_set('SHA512' if on else before)
    elif item == 'shadow-mode':
        os.chmod(SHADOW_FILE, 0 if on else before)
    elif item == 'crypto-policy':
        _crypto_policy_set('DEFAULT' if on else before)
    elif item == 'crypto-future':
        _crypto_policy_set('FUTURE' if on else before)


def os_harden_set(args):
    """One item of the operating system: on hardens it and keeps what was there before; off puts that back. Only the items of
    efa_harden.OS_HARDEN; one with a warning needs confirm=yes."""
    lib = _harden()
    item, mode = (args.item or '').strip(), (args.mode or '').strip()
    if item not in lib.OS_HARDEN:
        raise EfaError('Item: ' + ', '.join(lib.OS_HARDEN) + '.')
    if mode not in ('on', 'off'):
        raise EfaError('Mode: on or off.')
    warn = lib.OS_ITEMS[item].get('warn')
    if mode == 'on' and warn and (getattr(args, 'confirm', '') or '').strip() != 'yes':
        raise EfaError('Read the warning and confirm it with confirm=yes: ' + warn)
    saved = _json_read(OS_HARDEN_FILE, {})
    if mode == 'on':
        if _os_item_on(item):
            return {'item': item, 'on': True, 'changed': False}
        before = _os_item_before(item)
        _os_item_put(item, True, before)
        saved[item] = before
    else:
        if item not in saved:
            raise EfaError(f'{item}: eFa-next did not change it, there is nothing to put back.')
        _os_item_put(item, False, saved.pop(item))
    _json_write(OS_HARDEN_FILE, saved, mode=0o600)
    _audit(f'OS hardening {item} {mode} by {_dmarc_who()}')
    return {'item': item, 'on': _os_item_on(item), 'changed': True}


def _efa_item_on(item):
    """Whether a switch of eFa-next is hardened now (submission-pam: system accounts are off on 587)."""
    if item == 'service-harden':
        return service_harden_status(None).get('mode') == 'on'
    if item == 'tls-min':
        return all(_postconf(name) == TLS_MIN_NEW for name in TLS_PARAMETERS)
    if item == 'dane':
        return _postconf('smtp_tls_security_level') == 'dane'
    if item == 'submission-pam':
        return not _pam_on()
    if item == 'login-lockout':
        return _lockout_settings()['mode'] == 'on'
    if item == 'audit-mode':
        return bool(strict_settings()['on'])
    if item == 'security-oval':
        return bool(_json_read(SECURITY_SETTINGS, {}).get('oval'))
    if item == 'pwned-check':
        return bool(_json_read(SECURITY_SETTINGS, {}).get('pwned'))
    if item == 'autoupdate':
        return _update_state()['mode'] == 'auto'
    if item == 'web-ecdsa':
        key = cert_key(_certificates_in_use()['web'] or '/nonexistent')
        return bool(key and key[0] == 'ec')
    raise KeyError(item)


def _efa_item_put(item, on, before=None):
    """One switch of eFa-next through its own command, with the checks of that command."""
    switch = 'on' if on else 'off'
    if item == 'service-harden':
        service_harden(argparse.Namespace(mode=switch))
    elif item == 'tls-min':
        tls_min_set(argparse.Namespace(mode=switch))
    elif item == 'dane':
        dane_set(argparse.Namespace(mode=switch))
    elif item == 'submission-pam':
        submission_pam_set(argparse.Namespace(mode='off' if on else 'on'))
    elif item == 'login-lockout':
        login_lockout_set(argparse.Namespace(mode=switch, tries='', minutes='', hours='', repeat=''))
    elif item == 'audit-mode':
        audit_mode(argparse.Namespace(mode=switch, reason='security standards (hardening wizard)', days='', require_reason=''))
    elif item == 'security-oval':
        security_oval_set(argparse.Namespace(mode=switch))
    elif item == 'pwned-check':
        pwned_check_set(argparse.Namespace(mode=switch))
    elif item == 'autoupdate' and cluster_role() != 'client':  # a node takes the update policy of its master
        state = _update_state()
        autoupdate_set(argparse.Namespace(mode='auto' if on else (before or 'notify'), days=' '.join(state['days']), time=state['time'], os=''))
    elif item == 'web-ecdsa':
        web_cert_set(argparse.Namespace(mode='ecdsa' if on else 'mail'))


def _os_command_put(item, on):
    """The OS items that are commands of their own already."""
    if item == 'network-harden' and on:
        network_harden(None)
    elif item == 'firewall-guard':
        firewall_guard_set(argparse.Namespace(mode='on' if on else 'off'))


def _foreign_services():
    """Listening sockets of units that belong neither to eFa-next nor to the base system: named, never stopped."""
    try:
        found = _platform().listening(with_packages=False)
    except (NotImplementedError, AttributeError):
        return []
    managed, rows = None, set()
    for item in found:
        unit = re.sub(r'\.service$', '', item.get('unit') or '')
        if unit.lower().startswith('efa') or unit in KNOWN_UNITS or unit.startswith(('sshd@', 'clamd@', 'systemd-')):
            continue
        if unit.startswith('wazuh-agent'):
            managed = _safe(lambda: wazuh_status(None)['managed_by_efa'], False) if managed is None else managed
            if managed:
                continue
        rows.add(f"{item['proto']} {item['address']}:{item['port']} {unit or item.get('process') or 'unknown'}")
    return sorted(rows)


def os_harden_status(_args):
    """The items of the operating system and of eFa-next with their state now, the hints and the foreign services. Reads only."""
    lib = _harden()
    items = [{'id': key, 'title': item['title'], 'on': _safe(lambda key=key: _os_item_on(key), False), 'via': item['via'],
              'asks': sorted(item['asks']), 'why': item['why'], 'warn': item.get('warn', '')} for key, item in lib.OS_ITEMS.items()]
    efa = [{'id': key, 'title': item['title'], 'on': _safe(lambda key=key: _efa_item_on(key), False), 'asks': sorted(item['asks']),
            'why': item['why'], 'warn': item.get('warn', ''), 'once': bool(item.get('once'))} for key, item in lib.EFA_ITEMS.items()]
    selinux = subprocess.run(['getenforce'], capture_output=True, text=True).stdout.strip() or 'unknown'
    hints = [{'id': key, 'text': text, 'on': {'selinux': selinux == 'Enforcing', 'console-2fa': os.path.exists(CONSOLE_SSHD)}.get(key)}
             for key, text in lib.HINTS.items()]
    return {'items': items, 'efa': efa, 'hints': hints, 'selinux': selinux, 'foreign': _foreign_services(),
            'saved': sorted(_json_read(OS_HARDEN_FILE, {})),
            'note': 'eFa-next runs alone on its server: a foreign service is only named here, never stopped or removed.'}


def _harden_items(args, name, table):
    """The items of --os or --efa: None when the argument is empty (standards-set as before), [] for none."""
    text = (getattr(args, name, '') or '').strip()
    if not text:
        return None
    found = [] if text == 'none' else _harden().items(text, table)
    if found is None:
        raise EfaError(f'{name}: only ' + ', '.join(table) + ' or none.')
    return found


def _harden_rows(os_items, efa_items, chosen, skip=()):
    """The preview rows and warnings of the items around SEC-STD that change, and the state of each before."""
    lib, rows, warnings, before = _harden(), [], [], {'os': [], 'efa': {}}
    for key in os_items or []:
        item = lib.OS_ITEMS[key]
        if item['via'] == 'standards' or _os_item_on(key):
            continue
        before['os'].append(key)
        rows.append((item['title'], 'off', 'on', ', '.join(sorted(item['asks'] & chosen)) or 'chosen'))
        if item.get('warn'):
            warnings.append(item['warn'])
    for key in efa_items or []:
        item = lib.EFA_ITEMS[key]
        if key in skip or _efa_item_on(key):
            continue
        if key == 'dane' and _postconf('smtp_tls_security_level') in DANE_STRICT_LEVELS:
            warnings.append(_text(DANE_STRICT_TEXT, level=_postconf('smtp_tls_security_level')))
            continue
        before['efa'][key] = _update_state()['mode'] if key == 'autoupdate' else 'off'
        rows.append((item['title'], 'off', 'on', ', '.join(sorted(item['asks'] & chosen)) or 'chosen'))
        if item.get('warn'):
            warnings.append(item['warn'])
    return rows, warnings, before


def _standards_preview(args):
    """The preview of standards-set and standards-preview, nothing written: (selected, port25, items, now, wanted, rows, warnings,
    before)."""
    data = standards_data()
    selected = sorted(set((args.select or '').replace(',', ' ').split()))
    unknown = [sid for sid in selected if sid not in data['standards']]
    if unknown:
        raise EfaError(f'Unknown standard: {", ".join(unknown)}. Known: {", ".join(data["standards"])}.')
    if (args.port25_tls or '').strip() not in ('', 'on', 'off'):
        raise EfaError('Require TLS on port 25: on or off.')
    port25 = {'': None, 'on': True, 'off': False}[(args.port25_tls or '').strip()]
    os_items, efa_items = _harden_items(args, 'os', _harden().OS_ITEMS), _harden_items(args, 'efa', _harden().EFA_ITEMS)
    now = _standards_now()
    wanted, changes, warnings = standards_plan(selected, port25, now, os_items)
    # DANE that a standard switches on already is one row, not two.
    rows, more, before = _harden_rows(os_items, efa_items, set(selected), {'dane'} if wanted['dane'] and not now['dane'] else ())
    return selected, (os_items, efa_items), now, wanted, changes + rows, warnings + more + standards_gaps(selected, os_items, efa_items), before


def _item_on_now(is_os, key):
    return bool(_safe(lambda: _os_item_on(key) if is_os else _efa_item_on(key), False))


def standards_gaps(selected, os_items, efa_items):
    """Owner, 2026-11-12: never silently. Per chosen standard the items it asks for that are not chosen (it stays not fulfilled),
    and the conflict of Mozilla modern with BSI (BSI wins for the web: stricter)."""
    lib, chosen, found = _harden(), set(selected), []
    if os_items is not None or efa_items is not None:
        for sid in sorted(chosen):
            missing = [item['title'] for table, picked in ((lib.OS_ITEMS, os_items), (lib.EFA_ITEMS, efa_items)) if picked is not None
                       for key, item in table.items() if sid in item['asks'] and key not in picked and not _item_on_now(table is lib.OS_ITEMS, key)]
            if missing:
                found.append(_text('{standard} stays not fulfilled: not chosen: {items}.', standard=sid, items=', '.join(missing)))
    if 'moz-modern' in chosen and chosen & set(STANDARDS_BSI_TLS):
        found.append(_text('Mozilla modern and BSI ask for different cipher suites on the web: BSI wins (stricter), Mozilla modern stays not fulfilled.'))
    return found


def _preview_out(selected, changes, warnings):
    return {'selected': selected, 'changes': [{'setting': a, 'now': b, 'then': c, 'because': d} for a, b, c, d in changes], 'warnings': warnings}


def standards_preview(args):
    """What standards-set would change, with the same arguments. Reads only: no file, no reload, no restart."""
    selected, _items, _now, _wanted, changes, warnings, _before = _standards_preview(args)
    return {**_preview_out(selected, changes, warnings), 'note': 'A preview: nothing changed.'}


def _harden_self_test():
    """HARD-W: os-harden-set per item on, off and its way back; PermitRootLogin never touched; the foreign services; and
    standards-preview reads only (no file written, nothing reloaded or restarted) and equals the preview of standards-set."""
    lib, tmp = _harden(), tempfile.mkdtemp(prefix='efa-harden-test-')
    calls = []

    class Fake:
        NO_AUTO_FILE = tmp + '/no-auto.conf'

        def __init__(self):
            self.active, self.enabled = {'auditd': False, 'chronyd': False}, {'auditd': False, 'chronyd': True}

        def service(self, name):
            return {'time': 'chronyd'}[name]

        def service_is_active(self, name):
            calls.append('service_is_active')
            return self.active.get(name, False)

        def service_is_enabled(self, name):
            calls.append('service_is_enabled')
            return self.enabled.get(name, False)

        def service_enable(self, name, start=False):
            calls.append('service_enable')
            self.enabled[name], self.active[name] = True, self.active.get(name) or start

        def service_disable(self, name, stop=False):
            calls.append('service_disable')
            self.enabled[name] = False

        def service_stop(self, name):
            calls.append('service_stop')
            self.active[name] = False

        def kernel_settings_active(self):
            calls.append('kernel_settings_active')
            return False

        def listening(self, with_packages=True):
            calls.append('listening')
            return [{'proto': 'tcp', 'address': '0.0.0.0', 'port': 25, 'process': 'master', 'unit': 'postfix.service'},
                    {'proto': 'tcp', 'address': '127.0.0.1', 'port': 8080, 'process': 'python3', 'unit': 'efa-web.service'},
                    {'proto': 'tcp', 'address': '0.0.0.0', 'port': 36787, 'process': 'runner', 'unit': 'other-runner.service'},
                    {'proto': 'tcp', 'address': '0.0.0.0', 'port': 7000, 'process': 'python3', 'unit': 'session-4.scope'}]
    fake = Fake()
    names = ('_platform', 'SSHD_CIS_FILE', 'LOGIN_DEFS', 'SHADOW_FILE', 'CRYPTO_POLICY_FILE', 'OS_HARDEN_FILE', '_sshd_apply', '_crypto_policy_set',
             '_audit', 'SSH_BSI_FILE', '_sshd_effective')
    saved = {name: globals()[name] for name in names}
    # sshd -T of the test: stricter already for LoginGraceTime, weaker for the rest.
    sshd_now = {'x11forwarding': 'yes', 'maxauthtries': '6', 'permitemptypasswords': 'no', 'logingracetime': '30', 'clientaliveinterval': '0',
                'clientalivecountmax': '3', 'permitrootlogin': 'yes'}
    sshd_seen, sshd_bad = [], []

    def sshd_apply():
        sshd_seen.append(open(SSHD_CIS_FILE).read() if os.path.exists(SSHD_CIS_FILE) else '')
        if sshd_bad:
            raise EfaError('sshd rejected the configuration: test')
    main_config = 'Include /etc/ssh/sshd_config.d/*.conf\nPermitRootLogin yes\n'
    try:
        globals().update(_platform=lambda: fake, SSHD_CIS_FILE=tmp + '/ssh/sshd_config.d/30-efa-cis.conf', LOGIN_DEFS=tmp + '/login.defs',
                         SHADOW_FILE=tmp + '/shadow', CRYPTO_POLICY_FILE=tmp + '/crypto-policies/config', OS_HARDEN_FILE=tmp + '/os-harden.json',
                         _sshd_apply=sshd_apply, _crypto_policy_set=lambda name: _write(CRYPTO_POLICY_FILE, name + '\n'), _audit=lambda text: None,
                         SSH_BSI_FILE=tmp + '/ssh/sshd_config.d/40-efa-bsi.conf',
                         _sshd_effective=lambda: {} if os.path.exists(SSHD_CIS_FILE) else dict(sshd_now))
        _write(tmp + '/ssh/sshd_config', main_config)
        _write(LOGIN_DEFS, 'PASS_MAX_DAYS 99999\nENCRYPT_METHOD MD5\nUMASK 022\n')
        _write(SHADOW_FILE, 'root:!::0:99999:7:::\n', 0o640)
        _write(CRYPTO_POLICY_FILE, 'LEGACY\n')
        for item in lib.OS_HARDEN:
            if item == 'crypto-future':
                continue
            assert not _os_item_on(item), item
            assert os_harden_set(argparse.Namespace(item=item, mode='on', confirm=''))['on'], item
            assert item in _json_read(OS_HARDEN_FILE, {}) and _os_item_on(item), item
            assert os_harden_set(argparse.Namespace(item=item, mode='on', confirm=''))['changed'] is False, 'on twice changes nothing'
            os_harden_set(argparse.Namespace(item=item, mode='off', confirm=''))
            assert not _os_item_on(item) and item not in _json_read(OS_HARDEN_FILE, {}), f'{item}: back to what was there'
            try:
                os_harden_set(argparse.Namespace(item=item, mode='off', confirm=''))
                raise AssertionError(f'{item}: off without a change of eFa-next')
            except EfaError:
                pass
        assert open(LOGIN_DEFS).read() == 'PASS_MAX_DAYS 99999\nENCRYPT_METHOD MD5\nUMASK 022\n', 'login.defs as before'
        assert os.stat(SHADOW_FILE).st_mode & 0o777 == 0o640 and _crypto_policy() == 'LEGACY'
        assert fake.active == {'auditd': False, 'chronyd': False} and fake.enabled == {'auditd': False, 'chronyd': True}, (fake.active, fake.enabled)
        os_harden_set(argparse.Namespace(item='sshd-cis', mode='on', confirm=''))
        text = open(SSHD_CIS_FILE).read()
        assert 'MaxAuthTries 4' in text and 'X11Forwarding no' in text and 'ClientAliveInterval 15' in text, text
        assert 'LoginGraceTime' not in text and 'ClientAliveCountMax' not in text and 'PermitEmptyPasswords' not in text, 'never weaker than now'
        assert not re.search(r'(?im)^\s*permitrootlogin', text) and open(tmp + '/ssh/sshd_config').read() == main_config, 'PermitRootLogin untouched'
        os_harden_set(argparse.Namespace(item='sshd-cis', mode='off', confirm=''))
        sshd_bad.append(True)
        try:
            os_harden_set(argparse.Namespace(item='sshd-cis', mode='on', confirm=''))
            raise AssertionError('sshd -t refused it')
        except EfaError:
            assert not os.path.exists(SSHD_CIS_FILE) and 'sshd-cis' not in _json_read(OS_HARDEN_FILE, {}), 'a refused drop-in goes again'
        sshd_bad.clear()
        for bad in (argparse.Namespace(item='crypto-future', mode='on', confirm=''), argparse.Namespace(item='permitrootlogin', mode='on', confirm=''),
                    argparse.Namespace(item='auditd', mode='maybe', confirm='')):
            try:
                os_harden_set(bad)
                raise AssertionError(bad)
            except EfaError:
                pass
        assert os_harden_set(argparse.Namespace(item='crypto-future', mode='on', confirm='yes'))['on'] and _crypto_policy() == 'FUTURE'
        os_harden_set(argparse.Namespace(item='crypto-future', mode='off', confirm=''))
        assert _crypto_policy() == 'LEGACY'
        assert _foreign_services() == ['tcp 0.0.0.0:36787 other-runner', 'tcp 0.0.0.0:7000 session-4.scope'], _foreign_services()
    finally:
        globals().update(saved)
    # standards-preview reads only: every way to write a file, run a command or change a service is watched while it runs.
    writes, runs, done = [], [], []
    real = {'run': subprocess.run, 'replace': os.replace, 'remove': os.remove, 'chmod': os.chmod, 'rename': os.rename, 'makedirs': os.makedirs,
            'os_open': os.open, 'mkstemp': tempfile.mkstemp, 'copy2': shutil.copy2}
    real_open = open

    def guard_open(file, mode='r', *args, **kwargs):
        if any(flag in mode for flag in 'wax+'):
            writes.append(file)
            raise PermissionError(f'write {file}')
        return real_open(file, mode, *args, **kwargs)

    def guard_os_open(path, flags, *args, **kwargs):
        if flags & (os.O_WRONLY | os.O_RDWR | os.O_CREAT | os.O_TRUNC | os.O_APPEND):
            writes.append(path)
            raise PermissionError(f'write {path}')
        return real['os_open'](path, flags, *args, **kwargs)

    def watched(name):
        def call(*args, **kwargs):
            writes.append((name, args[:1]))
            raise PermissionError(name)
        return call

    def run(command, *args, **kwargs):
        runs.append(list(command))
        return subprocess.CompletedProcess(command, 0, stdout='', stderr='')
    preview_args = dict(select='bsi-02102-2 rfc9325 moz-modern bsi-03108 cis-el', port25_tls='on', os=','.join(lib.OS_ITEMS), efa=','.join(lib.EFA_ITEMS))
    saved = {name: globals()[name] for name in ('_platform', '_audit')}
    try:
        calls.clear()
        globals().update(_platform=lambda: fake, _audit=lambda text: done.append(text), open=guard_open)
        subprocess.run, os.open, tempfile.mkstemp = run, guard_os_open, watched('mkstemp')
        os.replace, os.remove, os.chmod, os.rename, os.makedirs, shutil.copy2 = (watched(name) for name in ('replace', 'remove', 'chmod', 'rename', 'makedirs', 'copy2'))
        shown = standards_preview(argparse.Namespace(**preview_args))
        planned = standards_set(argparse.Namespace(**preview_args, apply='', confirm=''))
    finally:
        subprocess.run, os.replace, os.remove, os.chmod, os.rename, os.makedirs = real['run'], real['replace'], real['remove'], real['chmod'], real['rename'], real['makedirs']
        os.open, tempfile.mkstemp, shutil.copy2 = real['os_open'], real['mkstemp'], real['copy2']
        globals().pop('open', None)
        globals().update(saved)
    assert writes == [] and done == [], f'standards-preview wrote: {writes} {done}'
    # Only reads: no command with a word that changes something (reload, restart, start, stop, enable, --set of the crypto policy,
    # postconf -e or -P, nginx -s), whatever the tool.
    changing = [command for command in runs if set(command[1:]) & {'reload', 'restart', 'try-restart', 'start', 'stop', 'enable', 'disable', 'mask',
                                                                    '--set', '-e', '-P', '-PX', '-X', '-s', '--now', 'set-default'}]
    assert changing == [], f'standards-preview ran: {changing}'
    assert set(calls) <= {'service_is_active', 'service_is_enabled', 'kernel_settings_active'}, set(calls)
    assert shown['changes'] == planned['changes'] and shown['warnings'] == planned['warnings'], 'the preview of standards-set'
    assert any(row['setting'] == 'auditd runs' for row in shown['changes']) and any('FUTURE' in text for text in shown['warnings'])
    assert COMMANDS['standards-preview']['writes'] is False and COMMANDS['os-harden-status']['writes'] is False
    assert command_permission('standards-preview', False) == command_permission('standards-status', False), 'the rights of standards-status'
    assert 'os-harden-set' in SUPER_COMMANDS
    # The setup or Re-Setup with no standard chosen: no standards-set at all, the defaults of eFa-next stay.
    kept = globals()['standards_set']
    try:
        globals()['standards_set'] = lambda _args: (_ for _ in ()).throw(AssertionError('standards-set without a standard'))
        assert _setup_standards('', apply=True) == {} and _setup_standards(' , bogus', apply=True) == {}
    finally:
        globals()['standards_set'] = kept


def tls_profile_upgrade(_args):
    """Package update: every eFa-next keeps the limit. Without a profile yet, BSI is set and the dashboard says so once."""
    if os.path.exists(TLS_PROFILE_FILE):
        state = tls_profile_state()
    else:
        state = {'profile': 'bsi', 'custom': ''}
        _json_write(TLS_PROFILE_FILE, state)
    changed = _tls_postfix(state)
    if changed:
        _write(TLS_RAISED, ' '.join(changed) + '\n')
    return {'profile': state['profile'], 'postfix_changed': changed}


# 6.0.0.5: the guard of the security minimum (docs/security-model.md). The limit is the one of 5t above (_tls12, tls_cipher_problem,
# key_ok); the guard looks after changes by hand: a path unit on the files (efa-floor-guard.path), a check before each start of
# postfix, nginx and dovecot (drop-ins), efa-apply and the daily job. A value under the limit goes back to the TLS profile, the rest
# of the file stays; if that fails the service stays stopped (fail closed). Each finding with its evidence into the audit log and the
# events, a copy of the file for root only, and a mail to the admin. Whoever is root can switch the guard off: it protects against
# mistakes, bad instructions and attackers without root, not against a malicious root.
FLOOR_STATE = '/var/lib/eFa/floor-guard.json'
TAMPER_DIR = '/var/lib/eFa/tamper'
FLOOR_SERVICES = ('postfix', 'nginx', 'dovecot')
FLOOR_GRADES = ('smtpd_tls_ciphers', 'smtpd_tls_mandatory_ciphers', 'smtp_tls_ciphers', 'smtp_tls_mandatory_ciphers')
FLOOR_POSTFIX = TLS_PARAMETERS + FLOOR_GRADES + ('tls_high_cipherlist', 'smtpd_tls_auth_only', 'smtpd_tls_cert_file')
DOVECOT_FLOOR = ETC + '/dovecot/conf.d/99-efa-tls-floor.conf'
FLOOR_PORTS = {8460: 'cluster', 8463: 'DKIM API'}
NGINX_OLD_TLS = re.compile(r'(?<![\w.])(SSLv2|SSLv3|TLSv1|TLSv1\.1)(?![\w.])')


def floor_cipher_problem(ciphers):
    done = subprocess.run(['openssl', 'ciphers', '-v', '-tls1_2', ciphers], capture_output=True, text=True)
    return tls_cipher_problem(done.stdout.splitlines() if done.returncode == 0 else [])


def floor_postfix_findings(values, overrides, cipher_problem=floor_cipher_problem):
    """[(where, parameter, now, back to)] of Postfix: main.cf (postconf) and the -o of master.cf (postconf -P, back to None: removed)."""
    wanted, found = _tls_postfix_values(tls_profile_state()), []

    def low(name, value):
        if name in TLS_PARAMETERS:
            return not _tls12(value)
        if name in FLOOR_GRADES:
            return value != 'high'
        if name == 'tls_high_cipherlist':
            return bool(cipher_problem(value))
        return name == 'smtpd_tls_auth_only' and value != 'yes'
    for name in FLOOR_POSTFIX[:-1]:
        if low(name, values.get(name, '')):
            found.append(('main.cf', name, values.get(name, ''), wanted.get(name, 'yes')))
    for service, name, value in overrides:
        if name in FLOOR_POSTFIX and low(name, value):
            found.append((f'master.cf {service}', name, value, None))
    return found


def nginx_tls_directives(text):
    """(file, directive, value) of ssl_protocols, ssl_ciphers and ssl_certificate in the output of nginx -T, comments left out."""
    found, current = [], ''
    for line in text.splitlines():
        head = re.match(r'# configuration file (\S+):$', line)
        if head:
            current = head.group(1)
            continue
        for name, value in re.findall(r'\b(ssl_protocols|ssl_ciphers|ssl_certificate)\s+([^;#]+);', line.split('#', 1)[0]):
            found.append((current, name, value.strip().strip('"\'')))
    return found


def floor_nginx_findings(directives, cipher_problem=floor_cipher_problem, key_check=None):
    """[(file, directive, now, back to)]; a weak key has no way back here (None) and is only reported."""
    protocols, ciphers, _out, _in = tls_wanted(tls_profile_state())
    key_check = key_check or (lambda path: key_ok(cert_key(path)))
    found = []
    for path, name, value in directives:
        if name == 'ssl_protocols' and NGINX_OLD_TLS.search(value):
            found.append((path, name, value, protocols))
        elif name == 'ssl_ciphers' and cipher_problem(value):
            found.append((path, name, value, ciphers))
        elif name == 'ssl_certificate' and '$' not in value and not key_check(value):
            found.append((path, 'key length', value, None))
    return found


def floor_dovecot_findings(values, cipher_problem=floor_cipher_problem):
    _protocols, ciphers, _out, _in = tls_wanted(tls_profile_state())
    found = []
    if values.get('ssl_min_protocol') not in ('TLSv1.2', 'TLSv1.3'):
        found.append((DOVECOT_FLOOR, 'ssl_min_protocol', values.get('ssl_min_protocol', ''), 'TLSv1.2'))
    if cipher_problem(values.get('ssl_cipher_list', '')):
        found.append((DOVECOT_FLOOR, 'ssl_cipher_list', values.get('ssl_cipher_list', ''), ciphers))
    return found


def nginx_floor_text(text, findings):
    """The file with only the low directives set back to the limit; everything else stays as it is."""
    for _path, name, value, back in findings:
        if back is not None:
            text = re.sub(rf'(\b{name}\s+)["\']?{re.escape(value)}["\']?(\s*;)', lambda m, back=back: m.group(1) + back + m.group(2), text)
    return text


def _floor_findings(service):
    if service == 'postfix':
        values = _postconf_many(FLOOR_POSTFIX)
        overrides = []
        for line in subprocess.run(['postconf', '-P'], capture_output=True, text=True, check=True).stdout.splitlines():
            match = re.match(r'^(\S+/\S+)/(\S+) = (.*)$', line)
            if match:
                overrides.append(match.groups())
        found = floor_postfix_findings(values, overrides)
        if values.get('smtpd_tls_cert_file') and not key_ok(cert_key(values['smtpd_tls_cert_file'])):
            found.append(('main.cf', 'key length', values['smtpd_tls_cert_file'], None))
        return found
    if service == 'nginx':
        done = subprocess.run(['nginx', '-T'], capture_output=True, text=True)
        if done.returncode != 0:
            raise EfaError('nginx -T failed: ' + done.stderr.strip()[-200:])
        return floor_nginx_findings(nginx_tls_directives(done.stdout))
    lines = subprocess.run(['doveconf', '-h', 'ssl_min_protocol', 'ssl_cipher_list'], capture_output=True, text=True, check=True).stdout.splitlines()
    return floor_dovecot_findings(dict(zip(('ssl_min_protocol', 'ssl_cipher_list'), (line.strip() for line in lines))))


def _floor_restore(service, findings):
    """Only the low values back to the limit, checked before it counts. Raises when that does not work."""
    if service == 'postfix':
        main = [f'{name} = {back}' for where, name, _now, back in findings if where == 'main.cf' and back is not None]
        drop = [f'{where.split(" ", 1)[1]}/{name}' for where, name, _now, back in findings if where != 'main.cf' and back is None]
        if main:
            subprocess.run(['postconf', '-e'] + main, check=True, capture_output=True)
        if drop:
            subprocess.run(['postconf', '-P', '-X'] + drop, check=True, capture_output=True)
        done = subprocess.run(['postfix', 'check'], capture_output=True, text=True)
        if done.returncode != 0:
            raise EfaError('postfix check failed after the restore: ' + done.stderr.strip()[-200:])
    elif service == 'nginx':
        before = {}
        for path in {path for path, _name, _now, back in findings if back is not None}:
            with open(path) as f:
                before[path] = f.read()
            _write(path, nginx_floor_text(before[path], [item for item in findings if item[0] == path]))
        done = subprocess.run(['nginx', '-t'], capture_output=True, text=True)
        if done.returncode != 0:
            for path, text in before.items():
                _write(path, text)
            raise EfaError('nginx -t failed after the restore: ' + done.stderr.strip()[-200:])
    else:
        _protocols, ciphers, _out, _in = tls_wanted(tls_profile_state())
        _write(DOVECOT_FLOOR, f'# eFa-next: the security minimum (efactl floor-check); written again when lower.\nssl_min_protocol = TLSv1.2\n'
                              f'ssl_cipher_list = {ciphers}\nssl_prefer_server_ciphers = yes\n')
    left = [item for item in _floor_findings(service) if item[1] != 'key length']
    if left and all(_floor_same(now, back) for _where, _name, now, back in left):
        raise FloorGuardError(f'{service}: the value eFa-next wrote still counts as under the limit')
    if left:
        raise EfaError(f'{service}: still under the security minimum after the restore (a later file sets it again).')


def _floor_evidence(path, now=None):
    """What an investigation needs of a changed file: digest, time, owner, mode, the check of its package, the logins and sudo calls
    of the journal around its time; and a copy for root only."""
    now = time.time() if now is None else now
    found = {'file': path}
    try:
        info = os.stat(path)
        with open(path, 'rb') as f:
            data = f.read()
    except OSError as err:
        return {**found, 'error': str(err)}
    import pwd as pwd_db
    owner = _safe(lambda: pwd_db.getpwuid(info.st_uid).pw_name, str(info.st_uid))
    found.update(sha256=hashlib.sha256(data).hexdigest(), mtime=time.strftime('%Y-%m-%d %H:%M:%S', time.localtime(info.st_mtime)),
                 owner=owner, mode=oct(info.st_mode & 0o7777))
    os.makedirs(TAMPER_DIR, mode=0o700, exist_ok=True)
    copy = f'{TAMPER_DIR}/{time.strftime("%Y%m%d-%H%M%S", time.localtime(now))}-{os.path.basename(path)}'
    fd = os.open(copy, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, 'wb') as f:
        f.write(data)
    platform_now = _platform()
    found['copy'] = copy
    found['package_check'] = _safe(lambda: platform_now.package_verify(path), '')
    found['logins'] = _safe(lambda: platform_now.journal_window(info.st_mtime - 900, max(now, info.st_mtime + 300), ('sshd', 'sudo', 'su', 'login')), [])[-40:]
    return found


def _floor_report(service, findings, ok, mode):
    if service == 'dovecot':
        files = [path for path in (ETC + '/dovecot/dovecot.conf', ETC + '/dovecot/conf.d/10-ssl.conf', DOVECOT_FLOOR) if os.path.exists(path)]
    else:
        files = sorted({item[0] if item[0].startswith('/') else _postconf('config_directory') + '/' + item[0].split(' ')[0]
                        for item in findings if item[1] not in ('check', 'restore')})
    evidence = [_floor_evidence(path) for path in files]
    for where, name, now, back in findings:
        if name in ('key length', 'check', 'restore'):
            outcome = 'reported'
        elif not ok:
            outcome = 'NOT set back, service stopped'
        else:
            outcome = f'set back to "{back[:200]}"' if back is not None else 'override removed'
        _audit(f'security minimum ({mode}): {service} {where} {name} was "{now[:200]}", {outcome}')
    for item in evidence:
        _audit(f"security minimum evidence: {item['file']} sha256 {item.get('sha256', '')} mtime {item.get('mtime', '')} owner {item.get('owner', '')} "
               f"copy {item.get('copy', '')} rpm -V {item.get('package_check', '')!r}; {len(item.get('logins', []))} journal lines")
    rows = [{'file': where, 'parameter': name, 'old': now[:200], 'new': (back or '')[:200]} for where, name, now, back in findings]
    strict_record('security_floor', service, 'ok' if ok else 'failed', findings=rows, evidence=evidence)
    _event('security_floor_violation', 'error' if ok else 'critical', service=service, restored=ok, findings=rows, evidence=evidence)
    _admin_notify(f'eFa-next: security minimum {"restored" if ok else "violated, service stopped"}: {service}',
                  '\n'.join(f'{row["file"]} {row["parameter"]}: "{row["old"]}" -> "{row["new"]}"' for row in rows) + '\n\n'
                  + json.dumps(evidence, indent=1, default=str)[:20000])


class FloorGuardError(EfaError):
    """The guard contradicts itself: what eFa-next writes counts as under the limit, or the check failed. A bug of eFa-next, no
    tampering: alarm, never a stop."""


def _floor_same(now, back):
    return back is not None and ' '.join(str(now).strip('"\'').split()) == ' '.join(str(back).split())


def floor_check(args):
    """Checks the security minimum of postfix, nginx and dovecot; a low value goes back to the limit, a service that cannot be
    set back stays stopped. Mode check (path unit, daily, by hand), prestart (before a start, then exit 1 stops the start), apply
    (setup and update: sets the limit without a finding). Fail closed only for a real violation: when the check fails or calls the
    value of eFa-next itself low, the service keeps running and the alarm says it is a fault of the guard."""
    mode, only = (args.mode or 'check').strip(), (getattr(args, 'service', '') or '').strip()
    if mode not in ('check', 'prestart', 'apply') or (only and only not in FLOOR_SERVICES):
        raise EfaError('Mode check, prestart or apply; service postfix, nginx or dovecot.')
    # Before the first run (a new install, the update to this version) the limit is set without a finding, like apply.
    quiet = mode == 'apply' or not os.path.exists(FLOOR_STATE)
    platform_now, state = _platform(), _json_read(FLOOR_STATE, {})
    result = {'mode': mode, 'findings': [], 'restored': [], 'failed': [], 'guard_errors': [], 'reported': []}
    reasons, guard = {}, {}
    for service in [only] if only else FLOOR_SERVICES:
        if not platform_now.service_exists(service) or (service == 'dovecot' and not shutil.which('doveconf')):
            continue
        try:
            findings = _floor_findings(service)
        except (EfaError, OSError, subprocess.CalledProcessError) as err:
            findings = [(service, 'check', str(err)[:200], None)]
        fixable = [item for item in findings if item[1] not in ('key length', 'check')]
        own = [item for item in findings if item[1] == 'check' or _floor_same(item[2], item[3])]
        ok = True
        if fixable and not own:
            try:
                _floor_restore(service, fixable)
            except FloorGuardError as err:
                own = [(service, 'restore', str(err)[:200], None)]
            except (EfaError, OSError, subprocess.CalledProcessError) as err:
                ok = False
                findings.append((service, 'restore', str(err)[:200], None))
        result['findings'] += [list(item) for item in findings + (own if own and own[0] not in findings else [])]
        if own:
            result['guard_errors'].append(service)
            guard[service] = '; '.join(f'{where} {name}: {now}' for where, name, now, _back in own)[:300]
            _floor_guard_alarm(service, guard[service])
            continue
        if not ok:
            result['failed'].append(service)
            if mode != 'prestart':
                platform_now.service_stop(service)
            # Why it stays stopped, for the banner and efactl status: the values that could not be set back, or the error.
            reasons[service] = '; '.join(f'{where} {name}: {now}' for where, name, now, _back in findings if name != 'key length')[:300]
        elif fixable:
            result['restored'].append(service)
            if mode != 'prestart':
                platform_now.service_reload_if_active(service)
        # A service that stays stopped always raises the alarm, also on the first run that otherwise sets the limit quietly.
        if findings and (not quiet or not ok):
            _floor_report(service, findings, ok, mode)
        elif findings:
            _audit(f'security minimum set for {service} ({len(fixable)} values)')
    if mode == 'check' and not only:
        try:
            result['reported'] = _floor_ports()
        except (OSError, subprocess.SubprocessError) as err:
            result['reported'] = [f'ports not checked: {err}']
    keep = lambda name: {item for item in state.get(name, []) if only and item != only}
    state.update(checked=time.strftime('%Y-%m-%d %H:%M:%S'), failed=sorted(set(result['failed']) | keep('failed')),
                 guard_errors=sorted(set(result['guard_errors']) | keep('guard_errors')), last=result['findings'][:50] or state.get('last', []))
    state['reasons'] = {service: reasons.get(service) or state.get('reasons', {}).get(service, '') for service in state['failed']}
    state['guard_reasons'] = {service: guard.get(service) or state.get('guard_reasons', {}).get(service, '') for service in state['guard_errors']}
    if result['restored'] or result['failed']:
        state['when'] = time.time()
    _json_write(FLOOR_STATE, state, mode=0o644)
    if result['failed'] and mode in ('prestart', 'apply'):
        raise EfaError('Security minimum: ' + ', '.join(result['failed']) + ' stays stopped, see the audit log and /var/lib/eFa/tamper.')
    if result['guard_errors'] and mode == 'apply':
        # The setup and the update stop here (CI fails hard), the services keep running.
        raise EfaError('Security minimum: the check of ' + ', '.join(result['guard_errors']) + ' contradicts itself, nothing was stopped: '
                       + '; '.join(guard.values()))
    return result


def _floor_guard_alarm(service, reason):
    _audit(f'security minimum: the check of {service} failed or calls the own value of eFa-next low ({reason}); {service} keeps running')
    _event('security_floor_guard_error', 'critical', service=service, reason=reason)
    _admin_notify(f'eFa-next: security minimum guard fault: {service}', f'The check of {service} contradicts itself: {reason}\n'
                  f'{service} keeps running; this is a fault of eFa-next, not a change of the files. Please report it.')


def _floor_ports():
    """The cluster (8460) and the DKIM API (8463) have the limit in their code: a handshake with TLS 1.1 must fail."""
    found = []
    for port, name in FLOOR_PORTS.items():
        with contextlib.closing(socket.socket()) as probe:
            probe.settimeout(2)
            if probe.connect_ex(('127.0.0.1', port)) != 0:
                continue
        done = subprocess.run(['openssl', 's_client', '-connect', f'127.0.0.1:{port}', '-tls1_1', '-cipher', 'DEFAULT@SECLEVEL=0'],
                              input='', capture_output=True, text=True, timeout=15)
        if done.returncode == 0 and 'Cipher is (NONE)' not in done.stdout:
            found.append(f'{name} ({port}) accepts TLS 1.1')
            _audit(f'security minimum: {name} on port {port} accepts TLS 1.1 (the limit is in its code: reinstall eFa-next, rpm -V eFa-next)')
            _event('security_floor_violation', 'critical', service=name, port=port, restored=False)
    return found


def floor_status(_args):
    """The guard of the security minimum: last check, services stopped by it, the last findings."""
    return {'checked': None, 'failed': [], 'last': [], **_json_read(FLOOR_STATE, {}), 'tamper_copies': TAMPER_DIR,
            'note': 'Checks after each change of the files, before each start of postfix, nginx and dovecot and once a day.'}


# PKG-2: after every change of the installed packages (efa-os-check.path on the rpm database) the configuration tests of the
# services and their state; a failure is red on the dashboard. PKG-4: .rpmnew and .rpmsave files beside the files eFa-next
# manages, which a package update leaves when the admin or eFa-next changed the original.
OS_CHECK_FILE = '/var/lib/eFa/os-check.json'
OS_CHECK_TESTS = (('postfix', ['postfix', 'check']), ('nginx', ['nginx', '-t']), ('rspamd', ['rspamadm', 'configtest']),
                  ('unbound', ['unbound-checkconf']), ('fail2ban', ['fail2ban-client', '-t']))
OS_CHECK_SERVICES = ('postfix', 'rspamd', 'redis', 'clamd@scan', 'nginx', 'mariadb', 'unbound', 'fail2ban', 'firewalld',
                     'efa-web', 'efactl-runner', 'efa-milter-health', 'efa-maillog')
OS_CHECK_DIRS = ('/etc/postfix', '/etc/nginx', '/etc/clamd.d', '/etc/unbound', '/etc/fail2ban', '/etc/redis', '/etc/valkey',
                 '/etc/rspamd', '/etc/dovecot', '/etc/my.cnf.d', '/etc/freshclam.conf', '/etc/chrony.conf', '/etc/ssh', '/etc/pam.d')


def os_check_findings(tests, inactive, leftovers):
    """The texts of a failed check: tests {name: output of a failed test}, inactive services, .rpmnew/.rpmsave files."""
    found = [f'{name}: configuration test failed: {text.strip()[-200:]}' for name, text in sorted(tests.items())]
    found += [f'{name} is not running' for name in inactive]
    found += [f'{path}: the package brought a new version beside the changed file; compare and merge' for path in leftovers]
    return found


OS_CHECK_RPMDB = '/var/lib/rpm/rpmdb.sqlite'
OS_CHECK_QUIET = 30
OS_CHECK_MAX_WAIT = 600


def _os_check_wait():
    """From efa-os-check.service: until the package database has not changed for OS_CHECK_QUIET seconds (at most 10 minutes)."""
    until = time.time() + OS_CHECK_MAX_WAIT
    while time.time() < until:
        try:
            if time.time() - os.stat(OS_CHECK_RPMDB).st_mtime >= OS_CHECK_QUIET:
                return
        except OSError:
            return
        time.sleep(5)


# 2026-11-18: the nginx releases of the vendor that fix CVE-2026-123007 and -123633 (HTTP/2), -123634 (resolver), -113425 (mail
# proxy) and -121810 (HTTP/3), by (distribution, major, branch): (epoch, version, release). Only releases the vendor named: an
# rpm Requires on an AlmaLinux release string (.alma.N) would refuse RHEL and Rocky, whose fixed releases are named otherwise
# and may sort lower; there the check says so and the CVE watch of the vendor errata counts.
NGINX_FIXED = {('almalinux', '9', '1.26'): ('2', '1.26.3', '10.module_el9.9.0+357+ccfac862.1.alma.2'),
               ('almalinux', '9', '1.20'): ('2', '1.20.1', '32.el9_9.1.alma.4'),
               ('almalinux', '10', '1.26'): ('2', '1.26.3', '16.el10_3.1.alma.3')}
NGINX_CVES = 'CVE-2026-123007, -123633, -123634, -113425, -121810'


def _os_release_id(path='/etc/os-release'):
    """(ID, major of VERSION_ID) of the distribution: ('almalinux', '10')."""
    values = {}
    for line in _read_lines(path):
        key, _sep, value = line.strip().partition('=')
        values[key] = value.strip('"')
    return values.get('ID', ''), values.get('VERSION_ID', '').split('.')[0]


def nginx_fixed_finding(distro, installed, older):
    """A finding when the installed nginx (epoch, version, release) is below the fixed release of the vendor, else ''."""
    if not installed:
        return ''
    fixed = NGINX_FIXED.get((*distro, '.'.join(installed[1].split('.')[:2])))
    if fixed is None:
        return ''  # no release named by this vendor for this branch: the CVE watch of its errata counts
    if older(installed, fixed):
        return (f'nginx {installed[1]}-{installed[2]} lacks the fixes of {NGINX_CVES} (vendor release {fixed[1]}-{fixed[2]}): '
                f'install the system updates (Maintenance & update)')
    return ''


def _newest_installed(platform_now, package):
    """(epoch, version, release) of the newest installed package of that name, None when there is none."""
    newest = None
    for evr in platform_now.package_versions().get(package, []):
        if newest is None or platform_now.version_older(newest, evr):
            newest = evr
    return newest


def nginx_after_update(platform_now):
    """nginx updated after it started: a restart, never a reload (the old binary keeps running with a reload), after nginx -t.
    Returns a finding when nginx refuses its config, else ''."""
    if not platform_now.service_is_active('nginx'):
        return ''
    installed = max(platform_now.package_install_time('nginx-core'), platform_now.package_install_time('nginx'))
    started = platform_now.service_started_at('nginx')
    if not installed or not started or started >= installed:
        return ''
    done = subprocess.run(['nginx', '-t'], capture_output=True, text=True, timeout=60)
    if done.returncode != 0:
        return 'nginx was updated but nginx -t refuses its settings: it still runs the old program, not restarted'
    platform_now.service_restart('nginx', check=False)
    _audit('nginx restarted after its package update (a reload keeps the old program running)')
    return ''


def os_check_run(_args=None):
    """The checks after a package change; the result for the dashboard, an event and a mail when it turns bad."""
    if os.environ.get('EFA_OS_CHECK_WAIT'):
        _os_check_wait()
    if _setup_running():
        # The packages the setup installs: their services start at its end; a check now found them stopped (2026-11-16).
        return {'skipped': 'the setup wizard runs; the check follows the next package change'}
    # The services that still run a replaced file restart first; the checks below see them as they run from now on.
    restarted = _safe(lambda: restart_stale_services(_platform()), [])
    tests = {}
    for name, cmd in OS_CHECK_TESTS:
        if shutil.which(cmd[0]) is None:
            continue
        try:
            done = subprocess.run(cmd, capture_output=True, text=True, timeout=120)
        except subprocess.TimeoutExpired:
            tests[name] = 'no answer within 120 seconds'
            continue
        if done.returncode != 0:
            tests[name] = done.stderr or done.stdout
    platform_now = _platform()
    inactive = [name for name in OS_CHECK_SERVICES if platform_now.service_exists(name) and not platform_now.service_is_active(name)]
    leftovers = sorted(path for top in OS_CHECK_DIRS for path in ([top + '.rpmnew', top + '.rpmsave'] if not os.path.isdir(top) else
                       [os.path.join(root, name) for root, _dirs, names in os.walk(top) for name in names])
                       if path.endswith(('.rpmnew', '.rpmsave')) and os.path.exists(path))
    findings = os_check_findings(tests, inactive, leftovers)
    # T-3: a package change of rspamd can leave an own module unloaded (a changed Lua API).
    modules = (_safe(lua_check_run, {}) or {}).get('missing') or []
    findings += [f'rspamd has not loaded the switched-on module {mark}' for mark in modules]
    # Every package change comes here (efa-os-check.path: dnf-automatic, the update of eFa-next, its hooks, dnf by hand).
    nginx_problems = [item for item in (_safe(lambda: nginx_after_update(platform_now), ''),
                                        _safe(lambda: nginx_fixed_finding(_os_release_id(), _newest_installed(platform_now, 'nginx'),
                                                                          platform_now.version_older), '')) if item]
    findings += nginx_problems
    # 2026-11-20: leftovers of eFa 5 that fail on their own schedule; reported, they do not make the check red.
    findings += _safe(letsencrypt_heal_findings, []) + _safe(lambda: cron_findings(_cron_lines()), [])
    before = _json_read(OS_CHECK_FILE, {})
    result = {'checked': time.strftime('%Y-%m-%d %H:%M:%S'), 'ok': not (tests or inactive or modules or nginx_problems), 'findings': findings,
              'rpmnew': leftovers, 'restarted': restarted}
    os.makedirs(os.path.dirname(OS_CHECK_FILE), exist_ok=True)
    _safe(lambda: breakglass_heal(None), None)  # a package may have put back a PAM or SSH file of the break-glass admin
    _json_write(OS_CHECK_FILE, result, mode=0o644)
    if findings and findings != before.get('findings'):
        _event('os_check_failed', 'critical' if not result['ok'] else 'warning', count=len(findings))
        _admin_notify('eFa-next: check after a package update', '\n'.join(findings))
    return result


def os_check_status(_args):
    return _json_read(OS_CHECK_FILE, {'checked': None, 'ok': None, 'findings': [], 'rpmnew': []})


def os_check_banner():
    """Red on the dashboard while the last check after a package change failed."""
    state = _json_read(OS_CHECK_FILE, {})
    return [_text('After a package update: {finding}', finding=item) for item in state.get('findings', [])] if state.get('ok') is False else []


# T-3: the own Lua modules of rspamd load through pcall: one that fails to load (or finds no settings) is otherwise only a line in
# the rspamd log and its function is off without a sign. A module is on while its line (by the mark at its end) is in
# rspamd.local.lua; once loaded it has registered this symbol, which rspamd then lists in its counters.
LUA_MODULE_SYMBOLS = {'efa-quarantine': 'EFA_USER_QUARANTINE', 'efa-bec': 'EFA_BEC_VIP_NAME', 'efa-attachments': 'EFA_EXECUTABLE',
                      'efa-ml': 'EFA_ML', 'efa-scan': 'EFA_SCAN_FAIL', 'efa-own-hash': 'EFA_AV_REJECT', 'efa-graymail': 'EFA_GRAYMAIL',
                      'efa-feeds': 'EFA_FEED', 'efa-qr': 'EFA_QR', 'efa-applications': 'EFA_APPLICATION', 'efa-unlock': 'EFA_ARCHIVE',
                      'efa-outbreak': 'EFA_OUTBREAK', 'efa-trap': 'EFA_TRAP_IP', 'efa-sandbox': 'EFA_SANDBOX',
                      'efa-lookalike': 'EFA_LOOKALIKE_CT', 'efa-ole': 'EFA_OLE', 'efa-pyzor': 'EFA_PYZOR_CHECK',
                      'efa-content-rules': 'EFA_STRIP_OWN_HEADERS'}
LUA_CHECK_FILE = '/var/lib/eFa/rspamd-modules.json'


def _rspamd_symbols_now():
    """The symbols rspamd has registered now (its symbol cache), or None when rspamd does not answer."""
    try:
        done = subprocess.run(['rspamc', 'counters', '-j'], capture_output=True, text=True, timeout=30)
        return {item['symbol'] for item in json.loads(done.stdout)} if done.returncode == 0 else None
    except (OSError, subprocess.TimeoutExpired, ValueError, TypeError, KeyError):
        return None


def lua_modules_missing(local_lua=None, symbols=None):
    """The own modules that are switched on but not loaded: [mark]. None when rspamd does not answer (its own check says so)."""
    if local_lua is None:
        try:
            with open(RSPAMD_LOCAL_LUA) as f:
                local_lua = f.read()
        except OSError:
            local_lua = ''
    on = [mark for mark in LUA_MODULE_SYMBOLS if re.search(r'-- ' + re.escape(mark) + r'\s*$', local_lua, re.M)]
    if not on:
        return []
    symbols = _rspamd_symbols_now() if symbols is None else symbols
    if symbols is None:
        return None
    return [mark for mark in on if LUA_MODULE_SYMBOLS[mark] not in symbols]


def lua_check_run(_args=None):
    """Hourly and after each package change: which switched-on modules rspamd did not load; red on the dashboard, a mail on a
    change."""
    missing = lua_modules_missing()
    if missing is None:
        return {'checked': time.strftime('%Y-%m-%d %H:%M:%S'), 'missing': None}
    before = _json_read(LUA_CHECK_FILE, {})
    result = {'checked': time.strftime('%Y-%m-%d %H:%M:%S'), 'missing': missing}
    os.makedirs(os.path.dirname(LUA_CHECK_FILE), exist_ok=True)
    _json_write(LUA_CHECK_FILE, result, mode=0o644)
    if missing and missing != before.get('missing'):
        _event('rspamd_module_failed', 'critical', modules=','.join(missing))
        _admin_notify('eFa-next: a protection module of rspamd is not loaded',
                      'Switched on, but rspamd has not loaded: ' + ', '.join(missing) + '. Its function is off until this is fixed. '
                      'The log of the rspamd service shows the reason (lines efa-...: ...).')
    return result


def lua_banner():
    """Red on the dashboard while a switched-on own module of rspamd is not loaded."""
    missing = _json_read(LUA_CHECK_FILE, {}).get('missing') or []
    return [_text('rspamd has not loaded the switched-on module {module}: its protection is off. The reason is in the log of the '
                  'rspamd service; after the fix restart rspamd.', module=mark) for mark in missing]


def floor_banner():
    """Red on the dashboard while the guard keeps a service stopped, one line per service with the reason; also a fault of the guard."""
    state = _json_read(FLOOR_STATE, {})
    return [_text('Security minimum: the check of {service} contradicts itself ({reason}); {service} keeps running. Report it, then '
                  'efactl floor-check.', service=service, reason=state.get('guard_reasons', {}).get(service) or 'see the audit log')
            for service in state.get('guard_errors', [])] + [_text('Security minimum: {service} stays stopped, a setting under the limit could not be set back ({reason}). Fix the file, '
                  'then efactl floor-check (Security, Security minimum).', service=service, reason=state.get('reasons', {}).get(service) or 'see the audit log')
            for service in state.get('failed', [])]


def floor_notices():
    state = _json_read(FLOOR_STATE, {})
    if not state.get('failed') and state.get('when') and time.time() - state['when'] < 7 * 86400:
        return [_text('Security minimum: settings under the limit were set back on {when}, see the audit log (Security, Security minimum).',
                      when=time.strftime('%Y-%m-%d %H:%M', time.localtime(state['when'])))]
    return []


# 5t-b: SSH after BSI TR-02102-4. The hardening report checks what sshd offers; ssh-profile-set writes a drop-in that comes
# before the crypto policy of the system (sshd keeps the first value) and takes itself back after 10 minutes unless confirmed.
SSH_BSI_FILE = ETC + '/ssh/sshd_config.d/40-efa-bsi.conf'
# The SSH profile: the allowlists of BSI TR-02102-4 in standards.json, the one source of the check and of the profile (until
# 6.0.0.6-alpha2 a list of its own here allowed curve25519, sntrup, ML-KEM, ChaCha20, Ed25519 and RSA keys, which BSI does not).
SSH_QUERY = {'kexalgorithms': 'kex', 'ciphers': 'cipher', 'macs': 'mac', 'hostkeyalgorithms': 'HostKeyAlgorithms'}
SSH_NAMES = {'kexalgorithms': 'KexAlgorithms', 'ciphers': 'Ciphers', 'macs': 'MACs', 'hostkeyalgorithms': 'HostKeyAlgorithms'}


def ssh_bsi_lists(data=None):
    """{sshd -T field: [allowed names or patterns]} of BSI TR-02102-4 (standards.json)."""
    data = data or standards_data()
    soft = [name for name, entry in standards_equivalents(data).items() if entry.get('ssh') and entry['relation'] == 'stronger']
    return {rule['field']: [name for name in soft if standards_equivalents(data)[name]['ssh'] == rule['field']] + list(rule['list'])
            for rule in data['standards']['bsi-02102-4']['rules'] if rule.get('kind') == 'ssh_allowed'}


class _SshBsi(dict):
    """SSH_BSI as before (the allowlists by field), read once from standards.json when first used."""
    def _load(self):
        if not dict.__len__(self):
            self.update(ssh_bsi_lists())

    def items(self):
        self._load()
        return dict.items(self)

    def __getitem__(self, key):
        self._load()
        return dict.__getitem__(self, key)


SSH_BSI = _SshBsi()
SSH_REVERT_MINUTES = 10


def ssh_crypto_problems(sshd):
    """What sshd -T offers outside the lists of BSI TR-02102-4 (standards.json, with the stronger values of its equivalents)."""
    found = []
    for key, allowed in SSH_BSI.items():
        offered = [item for item in sshd.get(key, '').split(',') if item]
        extra = [item for item in offered if not _wild(item, allowed)]
        if extra:
            found.append(f"{key}: {', '.join(extra)}")
    return found


def ssh_profile_text(offered):
    """The drop-in: of what this sshd knows (ssh -Q per field, {field: [names]}), only the names the BSI lists allow, in their
    order, so sshd -t passes on every version."""
    lines = ['# Written by efactl ssh-profile-set (BSI TR-02102-4). efactl ssh-profile-set --mode system removes it.']
    for key, name in SSH_NAMES.items():
        wanted = list(dict.fromkeys(item for pattern in SSH_BSI[key] for item in offered.get(key) or [] if fnmatch.fnmatch(item, pattern)))
        if not wanted:
            raise EfaError(f'This sshd offers none of the {name} BSI TR-02102-4 allows; the SSH profile stays as it is.')
        lines.append(f"{name} {','.join(wanted)}")
    return '\n'.join(lines) + '\n'


def _sshd_t():
    return dict(line.split(None, 1) for line in subprocess.run(['sshd', '-T'], capture_output=True, text=True).stdout.splitlines() if ' ' in line)


def ssh_profile_now(sshd=None):
    """system (no profile file), bsi (the file, and sshd offers only what BSI allows) or outdated (the file of an older
    version, or overridden): an update does not rewrite it, the admin applies it again."""
    if not os.path.exists(SSH_BSI_FILE):
        return 'system'
    return 'outdated' if ssh_crypto_problems(_sshd_t() if sshd is None else sshd) else 'bsi'


def ssh_profile_status(_args):
    sshd = _sshd_t()
    profile = ssh_profile_now(sshd)
    # profile stays bsi or system (the form of ssh-profile-set shows it); outdated is said apart.
    return {'profile': 'system' if profile == 'system' else 'bsi', 'outdated': profile == 'outdated', 'problems': ssh_crypto_problems(sshd),
            **({'note': 'The SSH profile is outdated (written by an older version): apply it again, efactl ssh-profile-set --mode bsi.'}
               if profile == 'outdated' else {}),
            'kexalgorithms': sshd.get('kexalgorithms', '').split(','), 'ciphers': sshd.get('ciphers', '').split(','),
            'macs': sshd.get('macs', '').split(','), 'confirmed': os.path.exists(SSH_BSI_FILE) and not os.path.exists(SSH_BSI_FILE + '.pending')}


def ssh_profile_set(args):
    """bsi: SSH after BSI TR-02102-4, back to the system setting after 10 minutes unless ssh-profile-confirm follows from a new
    login; system: the crypto policy of the operating system again. Running sessions stay, sshd checks the file first."""
    mode = (args.mode or '').strip()
    if mode not in ('bsi', 'system'):
        raise EfaError('Mode: bsi or system.')
    old = open(SSH_BSI_FILE).read() if os.path.exists(SSH_BSI_FILE) else None
    if mode == 'system':
        for path in (SSH_BSI_FILE, SSH_BSI_FILE + '.pending'):
            if os.path.exists(path):
                os.remove(path)
        _safe(lambda: _platform().service_stop('efa-ssh-revert.timer'), None)  # gone after a confirm
    else:
        offered = {key: subprocess.run(['ssh', '-Q', query], capture_output=True, text=True).stdout.split() for key, query in SSH_QUERY.items()}
        # BSI allows ECDSA host keys only: without one, no client could log in any more.
        if not glob.glob(ETC + '/ssh/ssh_host_ecdsa_key'):
            raise EfaError('No ECDSA host key (/etc/ssh/ssh_host_ecdsa_key): BSI TR-02102-4 allows ECDSA host keys only. '
                           'Make one by hand (ssh-keygen -t ecdsa -b 384 -f /etc/ssh/ssh_host_ecdsa_key); every client then sees a new key.')
        _write(SSH_BSI_FILE, ssh_profile_text(offered))
        os.chmod(SSH_BSI_FILE, 0o600)
        _write(SSH_BSI_FILE + '.pending', time.strftime('%Y-%m-%d %H:%M:%S\n'))
    try:
        _sshd_apply()
    except EfaError:
        if old is None:
            os.remove(SSH_BSI_FILE)
        else:
            _write(SSH_BSI_FILE, old)
        raise
    if mode == 'bsi':
        _platform().run_later('efa-ssh-revert', SSH_REVERT_MINUTES * 60, ['/usr/sbin/efactl', 'ssh-profile-revert'])
    _audit(f'SSH profile {mode} set by {_dmarc_who()}')
    return {**ssh_profile_status(None), 'note': f'Log in again over SSH in a new window, then confirm within {SSH_REVERT_MINUTES} minutes '
                                                '(efactl ssh-profile-confirm); otherwise the setting goes back by itself.' if mode == 'bsi' else ''}


def ssh_profile_confirm(_args):
    if not os.path.exists(SSH_BSI_FILE + '.pending'):
        raise EfaError('Nothing to confirm.')
    os.remove(SSH_BSI_FILE + '.pending')
    _safe(lambda: _platform().service_stop('efa-ssh-revert.timer'), None)
    _audit(f'SSH profile bsi confirmed by {_dmarc_who()}')
    return ssh_profile_status(None)


def ssh_profile_revert(_args):
    """The job of ssh-profile-set: back to the system setting when the BSI profile was not confirmed."""
    if os.path.exists(SSH_BSI_FILE + '.pending'):
        return ssh_profile_set(argparse.Namespace(mode='system'))
    return ssh_profile_status(None)


def cert_key(path):
    """(algorithm, bits) of the key of a certificate file: ('rsa', 2048), ('ec', 256), or None."""
    done = subprocess.run(['openssl', 'x509', '-in', path, '-noout', '-text'], capture_output=True, text=True)
    bits = re.search(r'Public-Key: \((\d+) bit\)', done.stdout)
    if done.returncode != 0 or not bits:
        return None
    return ('ec' if 'id-ecPublicKey' in done.stdout else 'ed25519' if 'ED25519' in done.stdout else 'rsa', int(bits.group(1)))


def cert_key_result(keys):
    """HR-1: (passed, detail) of the keys of the certificates in use, {'web': (alg, bits), 'mail': ...}; both shown when they differ."""
    found = {name: key for name, key in keys.items() if key}
    if not found:
        return None, 'no certificate'
    text = {name: '%s %s bits' % key for name, key in found.items()}
    detail = next(iter(text.values())) if len(set(text.values())) == 1 else ', '.join(f'{name}: {value}' for name, value in text.items())
    return all(key_ok(key) for key in found.values()), detail


def certificate_end_detail(end, now=None):
    """HR-2: the end of a certificate as a date and the days left, not as a number of seconds."""
    if end is None:
        return 'no certificate'
    days = int((end - (now or time.time())) // 86400)
    return f"until {time.strftime('%Y-%m-%d', time.localtime(end))}, {days} days"


def _certificates_in_use():
    """HR-1: the certificate files nginx and Postfix use now: nginx -T, then smtpd_tls_chain_files or smtpd_tls_cert_file."""
    done = subprocess.run(['nginx', '-T'], capture_output=True, text=True)
    web = next((value for _file, name, value in nginx_tls_directives(done.stdout) if name == 'ssl_certificate' and '$' not in value), None)
    chain = [item for item in re.split(r'[\s,]+', _postconf('smtpd_tls_chain_files') or '') if item]
    mail = next((item for item in chain if os.path.exists(item) and b'BEGIN CERTIFICATE' in open(item, 'rb').read()), None) \
        or _postconf('smtpd_tls_cert_file') or None
    return {'web': web, 'mail': mail}


def key_ok(found):
    """BSI TR-02102-1: RSA from 3000 bits, ECC from 250 bits (P-256, P-384, Ed25519)."""
    return found is not None and (found[1] >= 3000 if found[0] == 'rsa' else found[1] >= 250)


def pqc_available():
    """(available, OpenSSL version): whether this OpenSSL offers the hybrid group X25519MLKEM768."""
    version = subprocess.run(['openssl', 'version'], capture_output=True, text=True).stdout.split()[:2]
    groups = subprocess.run(['openssl', 'list', '-tls-groups'], capture_output=True, text=True)
    return 'X25519MLKEM768' in groups.stdout, ' '.join(version)


def web_curves():
    """The groups of nginx: the hybrid X25519MLKEM768 first where OpenSSL has it (3.5 on EL9), then the classic ones. Postfix 3.5
    does not know the name, so mail keeps the classic groups."""
    groups = subprocess.run(['openssl', 'list', '-tls-groups'], capture_output=True, text=True).stdout.split(':')
    return (('X25519MLKEM768',) if pqc_available()[0] else ()) + TLS_CURVES + tuple(name for name in ('brainpoolP256r1tls13',) if name in
                                                                                     [item.strip() for item in groups])


def kernel_state():
    """off (no file of eFa-next), on (the file, and every value of KERNEL_SETTINGS is live) or outdated (the file of an
    older version or a value overridden): an update only reports it, kernel-hardening-set --mode on writes it anew."""
    try:
        if not _platform().kernel_settings_active():
            return 'off'
        live = _platform().kernel_values(list(KERNEL_SETTINGS))
    except NotImplementedError:
        return 'off'
    return 'on' if all((live.get(name) or '').split() == value.split() for name, value in KERNEL_SETTINGS.items()) else 'outdated'


def kernel_hardening_set(args):
    """The kernel settings of the hardening report for every boot: no ICMP redirects, no core dumps of SUID programs."""
    on = _on_off(args.mode)
    try:
        _platform().kernel_settings(KERNEL_SETTINGS if on else None)
    except Exception as err:  # the StepError of the platform layer
        raise EfaError(str(err))
    return {'kernel_hardening': on, 'note': '' if on else 'The system defaults apply from the next boot.'}


def hardening_checks(f):
    """The checks from the gathered facts: (reference, title, passed or None for not applicable, detail, fix)."""
    ssh = f['sshd']
    checks = [
        ('CIS AlmaLinux 9: mandatory access control', 'SELinux enforces', f['selinux'] == 'Enforcing', f['selinux'], 'setenforce 1, SELINUX=enforcing'),
        ('CIS AlmaLinux 9: host firewall', 'The firewall runs', f['firewall'], '', 'Security: Firewall guard.'),
        ('CIS AlmaLinux 9: logging and auditing', 'auditd runs', f['auditd'], '', 'Enable and start the service auditd.'),
        ('CIS AlmaLinux 9: time synchronisation', 'chronyd runs', f['time'], '', 'Enable and start the time service (chronyd).'),
        ('CIS AlmaLinux 9: software updates', 'Operating system updates are installed automatically', f['os_updates'], f['os_updates_detail'],
         'Maintenance & update: Update system.'),
        ('CIS AlmaLinux 9: SSH server', 'Root cannot log in with a password', ssh.get('permitrootlogin') in ('no', 'prohibit-password', 'without-password'),
         f"PermitRootLogin {ssh.get('permitrootlogin', '?')}" + ''.join(f'; {item}' for item in _safe(ssh_root_overridden, [])),
         'Security: Root login through SSH.'),
        ('CIS AlmaLinux 9: SSH server', 'No empty passwords over SSH', ssh.get('permitemptypasswords') == 'no', '', 'PermitEmptyPasswords no'),
        ('CIS AlmaLinux 9: SSH server', 'No X11 forwarding', ssh.get('x11forwarding') == 'no', f"X11Forwarding {ssh.get('x11forwarding', '?')}", 'X11Forwarding no'),
        ('CIS AlmaLinux 9: SSH server', 'At most 4 login attempts per connection', ssh.get('maxauthtries', '6').isdigit() and int(ssh.get('maxauthtries', '6')) <= 4,
         f"MaxAuthTries {ssh.get('maxauthtries', '?')}", 'MaxAuthTries 4'),
        ('CIS AlmaLinux 9: user accounts', 'Passwords are stored with SHA-512 or yescrypt', f['encrypt_method'] in ('SHA512', 'YESCRYPT'),
         f"ENCRYPT_METHOD {f['encrypt_method'] or '?'}", 'ENCRYPT_METHOD SHA512 in /etc/login.defs'),
        ('CIS AlmaLinux 9: file permissions', '/etc/shadow is readable by root only', f['shadow_mode'] is not None and not f['shadow_mode'] & 0o077,
         oct(f['shadow_mode'] or 0), 'chmod 0000 /etc/shadow'),
    ]
    plain, sessions = f['tls25']
    checks.append(('BSI TR-03108, RFC 9325: opportunistic TLS', 'Incoming mail on port 25 without TLS: under 5 % (7 days)',
                   None if not sessions else plain * 20 < sessions, f'{plain} of {sessions} sessions' if sessions else 'no sessions counted',
                   'Ask the senders without TLS (security standards, port 25) to offer STARTTLS; TLS required for partners: TLS with partners.'))
    checks.append(('PCI DSS 11.5.2, NIST SP 800-53 SI-7: change detection', 'No configuration file changed outside efactl',
                   f['fim'][0], f['fim'][1], 'efactl fim-set --mode on; changes outside efactl: fim-status, then fim-accept (Privacy & Compliance)'))
    checks.append(('NIST SP 800-53 CP-9, ISO/IEC 27001 A.8.13: backup', 'A restore test of a backup passed in the last 35 days',
                   f['restore_test'][0], f['restore_test'][1], 'efactl backup-restore-test, or monthly: backup-restore-test-set --monthly on (Backup & restore)'))
    checks.append(('NIST SP 800-53 SC-28, PCI DSS 3.5: data at rest', 'The file systems of the mail data are encrypted (LUKS)',
                   f['fs_encrypted'][0], f['fs_encrypted'][1], 'Encryption of the disks is the operator\'s: LUKS at install, or on the virtualisation layer (docs/install.md).'))
    checks.append(('NIST SP 800-53 AC-8: system use notification', 'A login banner is shown before the admin login',
                   f['login_banner'], 'set' if f['login_banner'] else 'none', 'efactl login-banner-set --text "..." (Security, Admin access)'))
    checks.append(('PCI DSS 8.4, NIST SP 800-53 IA-2: multi-factor authentication', '2FA required for every admin role',
                   f['admin_2fa'][0], f['admin_2fa'][1], 'The rule counts from the day shown; a development host (dev flag) has none.'))
    checks.append(('PCI DSS 8.2.8, NIST SP 800-53 AC-11: session lock', 'Admin sessions end after at most 15 minutes idle',
                   f['admin_idle'] <= 15, f"{f['admin_idle']} minutes", 'efactl admin-idle-set --minutes 15 (Security, Admin access)'))
    checks.append(('BSI IT-Grundschutz OPS.1.1.5: logging', 'The strict audit log has a valid signed anchor of the last two days',
                   f['audit_anchor'][0], f['audit_anchor'][1], 'Users: Strict audit mode; then Strict audit log: check the signed daily anchors.'))
    for name, wanted in SYSCTL_WANTED.items():
        fix = 'efactl kernel-hardening-set --mode on' if name in KERNEL_SETTINGS else f'sysctl -w {name}={wanted} and a file in /etc/sysctl.d'
        checks.append(('CIS AlmaLinux 9: kernel network and memory settings', f'{name} = {wanted}', f['sysctl'].get(name) == wanted,
                       f"now {f['sysctl'].get(name, '?')}", fix))
    pf = f['postconf']
    checks += [
        ('BSI TR-03108: TLS versions', 'Incoming SMTP offers TLS 1.2 or newer only', _tls12(pf['smtpd_tls_protocols']), pf['smtpd_tls_protocols'],
         'efactl tls-min-set --mode on (a very old server then sends unencrypted)'),
        ('BSI TR-03108: TLS versions', 'Port 587 requires TLS 1.2 or newer', _tls12(pf['smtpd_tls_mandatory_protocols']), pf['smtpd_tls_mandatory_protocols'],
         'efactl tls-min-set --mode on (a very old server then sends unencrypted)'),
        ('BSI TR-03108: TLS versions', 'Outgoing SMTP uses TLS 1.2 or newer only', _tls12(pf['smtp_tls_protocols']), pf['smtp_tls_protocols'],
         'efactl tls-min-set --mode on (a very old server then sends unencrypted)'),
        ('BSI TR-03108: cipher suites', 'Cipher settings are valid grades', not f['cipher_problems'], '; '.join(f['cipher_problems']),
         'Security self check: cipher finding.'),
        ('BSI TR-03108: authentication', 'SMTP-AUTH only over TLS', pf['smtpd_tls_auth_only'] == 'yes', pf['smtpd_tls_auth_only'], 'postconf smtpd_tls_auth_only=yes'),
        ('BSI TR-02102-1: key lengths', 'Certificate of web and mail: RSA from 3000 bits or ECC (P-256, P-384)',
         *cert_key_result(f.get('cert_keys') or {'web': f.get('cert_key')}),
         'efactl letsencrypt-set (ECDSA P-256), or a certificate with RSA 3072 or ECC'),
        ('BSI TR-02102-1: key lengths', 'SSH host key RSA from 3000 bits', None if f.get('ssh_rsa_bits') is None else f['ssh_rsa_bits'] >= 3000,
         f"RSA {f.get('ssh_rsa_bits')} bits" if f.get('ssh_rsa_bits') else 'no RSA host key',
         'ssh-keygen -t rsa -b 3072 -f /etc/ssh/ssh_host_rsa_key (clients then see a new host key), or Ed25519 only'),
        ('BSI TR-02102-1: key lengths', 'DKIM RSA keys from 3000 bits (Ed25519 next to them)',
         None if not f.get('dkim_rsa_bits') else all(bits >= 3000 for bits in f['dkim_rsa_bits']),
         f"{sum(1 for bits in f.get('dkim_rsa_bits') or [] if bits < 3000)} of {len(f.get('dkim_rsa_bits') or [])} RSA keys below 3000 bits",
         'DKIM: new keys with RSA 3072 and Ed25519 (the TXT record gets longer, check that your DNS takes it)'),
        ('BSI TR-02102-4: SSH', 'SSH offers only BSI key exchange, ciphers, MACs and host key algorithms', not ssh_crypto_problems(ssh),
         '; '.join(ssh_crypto_problems(ssh))[:300], 'efactl ssh-profile-set --mode bsi (goes back by itself unless confirmed)'),
        ('CIS AlmaLinux 9: network configuration', 'No interface with a profile the network service made by itself (DHCP from any network)',
         None if f.get('auto_profiles') is None else not f['auto_profiles'], ', '.join(f.get('auto_profiles') or []),
         'Give the interface a role (Network, More interfaces) or remove the profile: nmcli connection delete "<name>"'),
        ('BSI TR-02102-2: post-quantum', 'Hybrid key exchange X25519MLKEM768 offered', True if f.get('pqc') else None,
         f"available ({f.get('openssl', '')})" if f.get('pqc') else f"not available on this platform ({f.get('openssl', 'OpenSSL')}), planned for EL10/FreeBSD",
         ''),
        ('BSI TR-03108: authentication', 'Port 587 does not take system accounts', not f['pam_587'], '', 'efactl submission-pam-set --mode off'),
        ('BSI TR-03108: DNSSEC', 'The own resolver validates DNSSEC', f['dnssec'], '', 'Unbound with a trust anchor (eFa-next default).'),
        ('BSI TR-03108: DANE', 'Outgoing mail uses DANE', f['dane'], '', 'efactl dane-set --mode on'),
        ('BSI TR-03108: MTA-STS', 'Own domains publish MTA-STS', f['mta_sts'] if f['domains'] else None, f"{f['mta_sts_count']} of {f['domains']} domains",
         'Protection: MTA-STS.'),
        ('BSI TR-03108: reporting', 'TLS reports (TLS-RPT) are read', f['tls_rpt'], '', 'efactl reports-in-set'),
        ('BSI TR-03108: certificates', 'The server certificate is valid for more than 14 days', f['certificate_ok'], f['certificate_detail'],
         'Network: Let\'s Encrypt.'),
        ('BSI TR-03108: TLS versions', 'The web interface offers TLS 1.2 or newer only', f['nginx_tls12'], '', 'ssl_protocols TLSv1.2 TLSv1.3;'),
    ]
    return [{'reference': ref, 'title': title, 'result': 'n/a' if ok is None else 'pass' if ok else 'fail', 'detail': detail, 'fix': '' if ok else fix}
            for ref, title, ok, detail, fix in checks]


def fs_encrypted(paths=('/var', '/'), run=subprocess.run):
    """(True/False, detail) whether the file systems of the mail data lie on dm-crypt (LUKS); (None, why) when it cannot be told.
    Only reports: the encryption of the disks is the operator's (docs/install.md)."""
    found = []
    for path in paths:
        source = run(['findmnt', '-n', '-o', 'SOURCE', '--target', path], capture_output=True, text=True, timeout=10)
        if source.returncode != 0 or not source.stdout.strip():
            return None, f'{path}: unknown'
        types = run(['lsblk', '-s', '-n', '-o', 'TYPE', source.stdout.strip().split('[')[0]], capture_output=True, text=True, timeout=10)
        if types.returncode != 0:
            return None, f'{path}: unknown'
        found.append((path, 'crypt' in types.stdout.split()))
    return all(on for _path, on in found), ', '.join(f"{path} {'encrypted' if on else 'not encrypted'}" for path, on in found)


def os_updates_automatic(timer, policy_os):
    """CIS 1.9: dnf-automatic, or the update policy of eFa-next with the operating system (security or all)."""
    return timer == 'enabled' or policy_os in ('security', 'all')


def _hardening_facts():
    platform_now = _platform()

    def active(name):
        try:
            return platform_now.service_is_active(name)
        except Exception:  # a unit the platform does not know
            return False
    sysctl = {}
    for name in SYSCTL_WANTED:
        done = subprocess.run(['sysctl', '-n', name], capture_output=True, text=True)
        if done.returncode == 0:
            sysctl[name] = done.stdout.strip()
    login_defs = dict(line.split(None, 1) for line in _read_lines('/etc/login.defs') if not line.startswith('#') and ' ' in line.replace('\t', ' '))
    try:
        shadow_mode = os.stat('/etc/shadow').st_mode & 0o777
    except OSError:
        shadow_mode = None
    names = ('smtpd_tls_protocols', 'smtpd_tls_mandatory_protocols', 'smtp_tls_protocols', 'smtpd_tls_auth_only',
             'smtpd_tls_ciphers', 'smtpd_tls_mandatory_ciphers', 'smtp_tls_ciphers', 'smtp_tls_mandatory_ciphers')
    postconf = {name: _postconf(name) for name in names}
    nginx = open('/etc/nginx/conf.d/efa.conf').read() if os.path.exists('/etc/nginx/conf.d/efa.conf') else ''
    try:
        end = _certificate_end()
        certificate = certificate_findings(end)
        certificate_ok, certificate_detail = not certificate, certificate_end_detail(end)
    except (OSError, ValueError) as err:
        certificate_ok, certificate_detail = False, str(err)[:100]
    mta = _json_read(MTA_STS_FILE, {})
    rsa_dkim = [bits for bits in (_key_bits(key['path']) for key in _dkim_keys() if key['state'] == 'active' and key['public']
                                  and key['public'][0] == 'rsa') if bits]
    host_rsa = subprocess.run(['ssh-keygen', '-lf', ETC + '/ssh/ssh_host_rsa_key.pub'], capture_output=True, text=True).stdout.split()[:1]
    pqc, openssl_version = pqc_available()
    try:
        auto = [f"{item['name']} ({item['device'] or 'no device'})" for item in _platform().auto_profiles()]
    except (NotImplementedError, AttributeError):
        auto = None
    try:
        os_updates = 'enabled' if platform_now.service_is_enabled('dnf-automatic.timer') else 'not enabled'
    except Exception:  # the StepError of the platform layer
        os_updates = 'unknown'
    # 6.0.0.6.7: the update policy of eFa-next installs the updates of the operating system itself (security or all).
    os_policy = _safe(lambda: _update_policy(save=False).get('os'), '')
    tls25 = _safe(tls25_status, {})
    return {'fim': _safe(fim_fact, (None, 'unknown')), 'restore_test': _safe(restore_test_fact, (None, 'unknown')), 'tls25': (tls25.get('port25_without_tls_7d', 0), tls25.get('port25_sessions_7d', 0)), 'fs_encrypted': _safe(fs_encrypted, (None, 'unknown')), 'audit_anchor': _anchor_fact(), 'admin_idle': admin_idle_minutes(), 'login_banner': bool(_safe(lambda: login_banner_status(None)['web'], False)),
            'admin_2fa': (admin_2fa_due(), 'development host (dev flag): not required' if admin_2fa_exempt() else f'from {admin_2fa_from().isoformat()}'), 'selinux': subprocess.run(['getenforce'], capture_output=True, text=True).stdout.strip() or 'unknown',
            'firewall': active(platform_now.service('firewall')), 'auditd': active('auditd'), 'time': active(platform_now.service('time')),
            'os_updates': os_updates_automatic(os_updates, os_policy),
            'os_updates_detail': f'dnf-automatic.timer {os_updates or "missing"}; eFa-next update policy: operating system {os_policy or "?"}',
            'sshd': dict(line.split(None, 1) for line in subprocess.run(['sshd', '-T'], capture_output=True, text=True).stdout.splitlines() if ' ' in line),
            'encrypt_method': login_defs.get('ENCRYPT_METHOD', '').strip(), 'shadow_mode': shadow_mode, 'sysctl': sysctl, 'postconf': postconf,
            'cipher_problems': [item['detail'] for item in cipher_findings({name: postconf[name] for name in names if 'ciphers' in name})],
            'pam_587': bool(pam_findings(_pam_on(), _submission_active())), 'dnssec': _resolver_validates(),
            'dane': _postconf('smtp_tls_security_level') == 'dane', 'domains': len(_local_domains()), 'mta_sts': bool(mta),
            'mta_sts_count': len(mta), 'tls_rpt': bool(_json_read(REPORTS_FILE_IN, {}).get('enabled')),
            'certificate_ok': certificate_ok, 'certificate_detail': certificate_detail,
            'cert_keys': {name: cert_key(path) if path and os.path.exists(path) else None for name, path in _certificates_in_use().items()},
            'dkim_rsa_bits': rsa_dkim,
            'ssh_rsa_bits': int(host_rsa[0]) if host_rsa and host_rsa[0].isdigit() else None, 'pqc': pqc, 'openssl': openssl_version, 'auto_profiles': auto,
            'nginx_tls12': not any('nginx' in item['title'] for item in tls_findings('>=TLSv1.2', nginx, ''))}



def _anchor_fact():
    """(passed or None when the strict audit mode is off, detail) for the hardening report."""
    if not strict_settings()['on']:
        return None, 'strict audit mode is off'
    try:
        result = audit_anchor_verify(None)
    except (OSError, ValueError, ImportError) as err:
        return False, str(err)[:100]
    recent = (datetime.date.today() - datetime.timedelta(days=1)).isoformat()
    fresh = (result.get('last') or '') >= recent
    return result['ok'] and fresh, f"{result.get('anchors', 0)} anchors, last {result.get('last') or 'none'}" + (
        '; ' + '; '.join(result['problems'][:2]) if result.get('problems') else '')

def hardening_markdown(checks, version):
    lines = [f'# Hardening report eFa-next {version}', '',
             'Own checks against the CIS benchmark for AlmaLinux 9 (system part) and BSI TR-03108 (secure mail transport). '
             'The references name the topic; this is no certification.', '',
             '| Result | Reference | Check | Now | Fix |', '| --- | --- | --- | --- | --- |']
    for item in checks:
        cells = [item['result'].upper(), item['reference'], item['title'], item['detail'], item['fix']]
        lines.append('| ' + ' | '.join(str(cell).replace('|', '/') for cell in cells) + ' |')
    counts = {result: sum(1 for item in checks if item['result'] == result) for result in ('pass', 'fail', 'n/a')}
    lines += ['', f"{counts['pass']} passed, {counts['fail']} failed, {counts['n/a']} not applicable."]
    return '\n'.join(lines) + '\n'


HARDENING_STATUS = {'pass': 'ok', 'fail': 'error', 'n/a': 'na'}

# The compliance file of the release (scripts/compliance_build.py) names the evidence of each claim. compliance-verify checks on
# this host what can be checked here: hardening checks, security standards, read-only commands with their expected value, the
# installed files and Wazuh rules. Tests and self-tests were checked by the CI of the release: "release" here.
COMPLIANCE_FILE = '/usr/share/eFa/compliance/controls.json'
# Commands named as evidence that are not run again here: this one, and the report whose checks are run one by one.
COMPLIANCE_NOT_RUN = {'compliance-verify', 'compliance-verify-check', 'hardening-report', 'standards-check'}
COMPLIANCE_PASSING_STANDARD = ('fulfilled', 'over', 'alternative')


def _compliance_command(ref, cache):
    """(result, value) of a read-only command named as evidence; 'release' when it needs arguments."""
    spec = COMMANDS.get(ref)
    if spec is None or spec.get('writes') or ref in COMPLIANCE_NOT_RUN or any(arg.get('required') for arg in spec.get('args', [])):
        return 'release', None
    if ref not in cache:
        values = {arg['name']: (False if arg.get('flag') else '') for arg in spec.get('args', [])}
        try:
            cache[ref] = ('ok', spec['func'](argparse.Namespace(command=ref, **values)))
        except Exception as err:  # the check of one command must not stop the others; its error is the result
            cache[ref] = ('error', str(err)[:200])
    return cache[ref]


def compliance_evaluate(doc, facts, wanted=''):
    """The results per control. facts: hardening {title: pass/fail/n/a}, standards {id: status}, run(ref) -> (state, value),
    exists(path) -> bool, rules {id}."""
    results, summary = [], {}
    for standard in doc['standards']:
        if wanted and standard['id'] != wanted:
            continue
        counts = summary.setdefault(standard['id'], {'pass': 0, 'fail': 0, 'not-applicable': 0, 'operator': 0})
        for control in standard['controls']:
            checks = []
            for item in control['evidence']:
                kind, ref = item['type'], item['ref']
                if kind == 'hardening':
                    found = facts['hardening'].get(ref)
                    result = {'pass': 'pass', 'fail': 'fail'}.get(found, 'not-applicable' if found == 'n/a' else 'missing')
                    detail = found or 'not in this release'
                elif kind == 'standard':
                    found = facts['standards'].get(ref)
                    result = 'pass' if found in COMPLIANCE_PASSING_STANDARD else 'fail' if found else 'missing'
                    detail = found or 'not in this release'
                elif kind == 'command':
                    state, value = facts['run'](ref)
                    if state == 'release':
                        result, detail = 'release', 'checked by the CI of the release'
                    elif state == 'error':
                        result, detail = 'fail', value
                    elif 'key' in item:
                        now = value.get(item['key']) if isinstance(value, dict) else None
                        result, detail = ('pass' if now == item['equals'] else 'fail'), f"{item['key']} = {json.dumps(now)[:80]}"
                    else:
                        result, detail = 'pass', 'ran'
                elif kind == 'file' and ref.startswith('next/'):
                    result = 'pass' if facts['exists'](ref[len('next'):]) else 'fail'
                    detail = ref[len('next'):]
                elif kind == 'wazuh-rule':
                    result, detail = ('pass' if ref in facts['rules'] else 'fail'), 'installed rule file'
                else:
                    result, detail = 'release', 'checked by the CI of the release'
                checks.append({'type': kind, 'ref': ref, 'result': result, 'detail': detail})
            live = [check['result'] for check in checks if check['result'] in ('pass', 'fail', 'missing')]
            if control['status'] == 'out-of-scope' or (control['owner'] == 'operator' and not live):
                result = 'operator'
            elif 'fail' in live or 'missing' in live:
                result = 'fail'
            elif live:
                result = 'pass'
            else:
                result = 'not-applicable'
            counts[result] += 1
            results.append({'standard': standard['id'], 'control': control['id'], 'title': control['title'], 'claimed': control['status'],
                            'result': result, 'checks': checks})
    return results, summary


def compliance_verify(args):
    """What the compliance file of this release claims, checked on this installation: per control the claimed coverage and the
    result here (pass, fail, not-applicable, operator). Read only."""
    wanted = (getattr(args, 'standard', '') or '').strip().lower()
    if getattr(args, 'signed', False) and identity_now is not None and identity_now['grants'].get('audit.view', {'tenants': ()}) is not None:
        # The result is about the whole host: a login whose audit right is limited to tenants or domains does not get it signed.
        raise EfaError('The signed result is for a super admin or an auditor of the whole system.')
    doc = _json_read(COMPLIANCE_FILE, None)
    if not doc:
        raise EfaError(f'{COMPLIANCE_FILE} is missing or unreadable: reinstall the eFa-next package.')
    if wanted and wanted not in {standard['id'] for standard in doc['standards']}:
        raise EfaError('Standard: one of ' + ', '.join(standard['id'] for standard in doc['standards']) + '.')
    hardening = {item['title']: item['result'] for item in hardening_checks(_hardening_facts())}
    try:
        standards = {sid: item['status'] for sid, item in standards_evaluate(standards_data(), _standards_facts()).items()}
    except (OSError, ValueError, KeyError, subprocess.SubprocessError) as err:
        print(f'compliance-verify: security standards not checked: {err}', file=sys.stderr)
        standards = {}
    try:
        with open('/usr/share/eFa/wazuh/efa-next_rules.xml') as f:
            rules = set(re.findall(r'<rule id="(\d+)"', f.read()))
    except OSError:
        rules = set()
    cache = {}
    facts = {'hardening': hardening, 'standards': standards, 'run': lambda ref: _compliance_command(ref, cache),
             'exists': os.path.exists, 'rules': rules}
    results, summary = compliance_evaluate(doc, facts, wanted)
    with open(COMPLIANCE_FILE, 'rb') as f:
        source_sha256 = hashlib.sha256(f.read()).hexdigest()
    result = {'format': 'efa-next-compliance-result', 'version': _efa_version(), 'host': own_hostname(),
              'checked': datetime.datetime.now(datetime.timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ'), 'source': COMPLIANCE_FILE,
              'source_sha256': source_sha256, 'standard': wanted or 'all',
              'note': 'Not a legally binding statement; see the notice of the compliance file of the release and DISCLAIMER.md.',
              'summary': summary, 'results': results}
    if not getattr(args, 'signed', False):
        return result
    key = _backup_sign_key()
    found = compliance_result_zip(result, key)
    _audit(f"compliance-verify: signed result {found['name']} ({result['standard']}) for {_dmarc_who()}, key {found['fingerprint']}")
    return found


def compliance_result_zip(result, key):
    """The result as an auditor can check it with openssl alone: result.json, its raw Ed25519 signature and the public key (PEM).
    The fingerprint of the key is in the result too, to compare with efactl backup-key-show of the host."""
    from cryptography.hazmat.primitives import serialization
    public = key.public_key()
    raw = public.public_bytes(serialization.Encoding.Raw, serialization.PublicFormat.Raw)
    result = {**result, 'signer': {'algorithm': 'Ed25519', 'key': 'backup signing key of the host (efactl backup-key-show)',
                                   'fingerprint': key_fingerprint(raw)}}
    body = json.dumps(result, indent=1, sort_keys=True, ensure_ascii=False).encode() + b'\n'
    pem = public.public_bytes(serialization.Encoding.PEM, serialization.PublicFormat.SubjectPublicKeyInfo)
    stamp = result['checked'].replace('-', '').replace(':', '')
    name = f"efa-next-compliance-result-{re.sub(r'[^A-Za-z0-9.-]', '_', result['host'])}-{stamp}.zip"
    buffer = io.BytesIO()
    with zipfile.ZipFile(buffer, 'w', zipfile.ZIP_DEFLATED) as archive:
        archive.writestr('result.json', body)
        archive.writestr('result.json.sig', key.sign(body))
        archive.writestr('signer.pub.pem', pem)
        archive.writestr('README.txt', COMPLIANCE_RESULT_README.format(fingerprint=result['signer']['fingerprint']))
    return {'name': name, 'zip': base64.b64encode(buffer.getvalue()).decode(), 'fingerprint': result['signer']['fingerprint'],
            'summary': result['summary']}


COMPLIANCE_RESULT_README = """eFa-next compliance check of one host, signed by that host. Not a legally binding statement (DISCLAIMER.md).

Check the signature (OpenSSL 3):
  openssl pkeyutl -verify -pubin -inkey signer.pub.pem -rawin -in result.json -sigfile result.json.sig
Then compare the key: on the host, efactl backup-key-show must show the fingerprint {fingerprint}.
Or on any eFa-next host: efactl compliance-verify-check --file <this zip> --fingerprint "{fingerprint}"
source_sha256 in result.json is the SHA-256 of the compliance controls of the release (source_sha256 of its compliance file).
"""


def compliance_result_check(data, fingerprint=''):
    """(result, fingerprint) of a signed result zip, or EfaError: the signature over result.json with the key in the zip, the key
    the one named in the result, and, when given, the expected fingerprint."""
    from cryptography.exceptions import InvalidSignature
    from cryptography.hazmat.primitives import serialization
    try:
        with zipfile.ZipFile(io.BytesIO(data)) as archive:
            body, signature, pem = (archive.read(name) for name in ('result.json', 'result.json.sig', 'signer.pub.pem'))
        public = serialization.load_pem_public_key(pem)
        public.verify(signature, body)
        result = json.loads(body)
    except (zipfile.BadZipFile, KeyError, ValueError, TypeError, AttributeError, InvalidSignature):
        raise EfaError('Not a valid signed result: the signature does not match (changed after signing, or not a result zip).')
    found = key_fingerprint(public.public_bytes(serialization.Encoding.Raw, serialization.PublicFormat.Raw))
    if (result.get('signer') or {}).get('fingerprint') != found:
        raise EfaError('The key in the zip is not the one the result names.')
    if fingerprint and ''.join(fingerprint.upper().split()) != found.replace(' ', ''):
        raise EfaError(f'Signed by another key ({found}), not by {fingerprint}.')
    return result, found


def compliance_verify_check(args):
    """A signed result of compliance-verify, checked offline: signature, key, and the expected fingerprint. Console only."""
    if _web_call():
        raise EfaError('Only on the console: it reads a file of this host.')
    try:
        with open(args.file, 'rb') as f:
            data = f.read(16 * 1024 * 1024)
    except OSError as err:
        raise EfaError(f'{args.file}: {err.strerror}')
    result, found = compliance_result_check(data, (getattr(args, 'fingerprint', '') or '').strip())
    return {'valid': True, 'fingerprint': found, 'fingerprint_checked': bool((getattr(args, 'fingerprint', '') or '').strip()),
            'host': result.get('host'), 'version': result.get('version'), 'checked': result.get('checked'),
            'source_sha256': result.get('source_sha256'), 'summary': result.get('summary')}


def hardening_pdf(checks, version, host, when, mode='single'):
    """Q5b: the report as PDF for audits, from the same checks as the table: the failed ones first. Only results, no secrets."""
    version = re.sub(r'^eFa-', '', version or '')
    counts = {result: sum(1 for item in checks if item['result'] == result) for result in ('pass', 'fail', 'n/a')}
    order = sorted(checks, key=lambda item: ({'fail': 0, 'n/a': 2}.get(item['result'], 1), item['reference']))
    rows = [(item['reference'], item['title'], item['result'].upper(),
             item['detail'] + (f" Fix: {item['fix']}" if item['fix'] and item['result'] == 'fail' else ''), HARDENING_STATUS.get(item['result'], 'na'))
            for item in order]
    blocks = [('h', f'Hardening report {host}'),
              ('p', f'Date: {when}. Host: {host}. eFa-next {version}. Mode: {mode}.'),
              ('p', f"Result: {counts['pass']} passed, {counts['fail']} failed, {counts['n/a']} not applicable."),
              ('p', 'Own checks against the CIS benchmark for AlmaLinux 9 (system part) and BSI TR-03108 (secure mail transport). '
                    'The references name the topic; this is no certification.'),
              ('table', [('Reference', 120), ('Check', 150), ('Result', 45), ('Now / fix', 180)], rows)]
    return _lib('efa_pdf').report(f'eFa-next hardening report {host}', blocks, footer=f'eFa-next {version} - {when}',
                                  info={'Title': f'Hardening report {host}', 'Producer': 'eFa-next', 'Creator': 'eFa-next',
                                        'CreationDate': 'D:' + re.sub(r'\D', '', when)})


def hardening_report(args):
    """The hardening of this host against CIS AlmaLinux 9 and BSI TR-03108; as JSON, Markdown for the release, or PDF
    (--format pdf for the web, --pdf FILE or --pdf - on the command line)."""
    checks = hardening_checks(_hardening_facts()) + standards_checks_for_report()
    version = _update_installed()
    if (getattr(args, 'format', '') or '').strip() == 'markdown':
        return {'markdown': hardening_markdown(checks, version)}
    target = (getattr(args, 'pdf', '') or '').strip()
    if (getattr(args, 'format', '') or '').strip() == 'pdf' or target:
        host, now = own_hostname(), time.localtime()
        pdf = hardening_pdf(checks, version, host, time.strftime('%Y-%m-%d %H:%M:%S', now), cluster_mode() or 'single')
        name = f"efa-hardening-{re.sub(r'[^A-Za-z0-9.-]', '_', host)}-{time.strftime('%Y%m%d-%H%M', now)}.pdf"
        if target == '-':
            sys.stdout.buffer.write(pdf)
            return None
        if target:
            # Command line only (the web has no such argument).
            _write_bytes(target, pdf)
            return {'file': target, 'bytes': len(pdf)}
        return {'pdf': base64.b64encode(pdf).decode(), 'name': name}
    return {'version': version, 'passed': sum(1 for item in checks if item['result'] == 'pass'),
            'failed': sum(1 for item in checks if item['result'] == 'fail'), 'checks': checks}


def switches_status(_args):
    """The switches whose state no other status shows, so their forms show what is set now."""
    security = _json_read(SECURITY_SETTINGS, {})
    queue = {**QUEUE_DEFAULTS, **_json_read(QUEUE_FILE, {})}
    reports = _json_read(REPORTS_FILE_IN, {})
    try:
        kernel = _platform().kernel_settings_active()
    except NotImplementedError:
        kernel = None
    milters = [item.rsplit(':', 1)[-1] for item in _postconf('smtpd_milters').replace(',', ' ').split() if item.startswith('inet:')]
    return {'tls_min': all(_tls12(_postconf(name)) for name in TLS_PARAMETERS), 'kernel_hardening': kernel,
            'pwned': bool(security.get('pwned')), 'oval': bool(security.get('oval')), 'submission_pam': _pam_on(),
            'alarm_size': queue['alarm_size'], 'alarm_hours': queue['alarm_hours'], 'reports_in': bool(reports.get('enabled')),
            'reports_in_address': reports.get('address', ''), 'milter_ports': ' '.join(milters)}


def form_check(_args):
    """For CI on an installed host: every form takes its values from a read command that has them, and a pulldown gets one of its choices."""
    nav = _lib('efa_nav')
    problems, outputs = [], {}
    for name, (status, keys) in sorted(nav.FORM_SOURCE.items()):
        if status not in outputs:
            try:
                outputs[status] = COMMANDS[status]['func'](argparse.Namespace())
            except Exception as err:  # noqa: BLE001 - one broken status is a finding, the others go on
                outputs[status] = None
                problems.append(f'{status}: {err}')
        for arg in COMMANDS[name]['args']:
            key = keys.get(arg['name'])
            value = nav.form_value(outputs[status], key)
            if key and value is None and not key.startswith('?'):
                problems.append(f'{name} --{arg["name"]}: {status} has no {key}')
            options = [item['value'] for item in arg.get('choices', [])]
            # A field with many choices ('many', tick boxes) is a comma list: each part is one of the options.
            given = [part.strip() for part in str(value).split(',')] if arg.get('many') and value not in (None, '') else [value]
            if options and value not in (None, '') and any(part not in options for part in given):
                problems.append(f'{name} --{arg["name"]}: {value!r} is none of {options}')
    if problems:
        raise EfaError('Forms without their current value: ' + '; '.join(problems))
    return {'forms': len(nav.FORM_SOURCE), 'status_commands': len(outputs), 'ok': True}


def security_status(_args):
    """The last result of the security self check."""
    status = {**_json_read(SECURITY_FILE, {'checked': None, 'level': 'not checked yet', 'findings': []}),
              'daily': _json_read(SECURITY_SETTINGS, {}).get('daily', False)}
    bg = _safe(lambda: breakglass_status(None), {})
    if bg.get('user'):
        # A documented exception to MFA, not a finding: one-time codes only, every use raises the alarm.
        status['exceptions'] = [f"break-glass admin {bg['user']}: one-time codes ({bg['codes_left']} left, last use {bg['last_use'] or 'never'}), "
                                f"SSH {bg['ssh']}, web {bg['web']}, faillock {bg['faillock']['deny']} tries / {bg['faillock']['unlock_time'] // 60} min"]
    return status


# CVEs from the open OVAL data of the distribution (Q12): loaded only when switched on, once a day with ETag, offline with the
# last copy. Complements dnf updateinfo, which needs the repositories.
OVAL_FILE = '/var/lib/eFa/oval.xml.bz2'
OVAL_STATE = '/var/lib/eFa/oval.json'
OVAL_NS = '{http://oval.mitre.org/XMLSchema/oval-definitions-5}'
OVAL_LINUX = '{http://oval.mitre.org/XMLSchema/oval-definitions-5#linux}'


def oval_parse(stream):
    """The patch definitions of an OVAL file: [{'id', 'title', 'severity', 'cves', 'tests'}] and the package tests
    {test id: (package, (epoch, version, release))} for 'installed version less than fixed'. Read piece by piece, little memory."""
    from xml.etree.ElementTree import iterparse
    definitions, tests, objects, states = [], {}, {}, {}
    for _event, node in iterparse(stream):
        tag = node.tag
        if tag == OVAL_NS + 'definition':
            if node.get('class') == 'patch':
                meta = node.find(OVAL_NS + 'metadata')
                severity = meta.find(f'{OVAL_NS}advisory/{OVAL_NS}severity') if meta is not None else None
                definitions.append({'id': node.get('id'), 'title': (meta.findtext(OVAL_NS + 'title') or '')[:200] if meta is not None else '',
                                    'severity': (severity.text or '').strip() if severity is not None else '',
                                    'cves': sorted({ref.get('ref_id') for ref in node.iter(OVAL_NS + 'reference') if ref.get('source') == 'CVE'}),
                                    'tests': [item.get('test_ref') for item in node.iter(OVAL_NS + 'criterion')],
                                    'details': {(cve.text or '').strip(): (cve.get('cvss3', ''), cve.get('cwe', ''), cve.get('href', ''))
                                                for cve in (meta.iter(OVAL_NS + 'cve') if meta is not None else []) if cve.text}})
            node.clear()
        elif tag == OVAL_LINUX + 'rpminfo_test':
            obj, state = node.find(OVAL_LINUX + 'object'), node.find(OVAL_LINUX + 'state')
            if obj is not None and state is not None:
                tests[node.get('id')] = (obj.get('object_ref'), state.get('state_ref'))
            node.clear()
        elif tag == OVAL_LINUX + 'rpminfo_object':
            objects[node.get('id')] = node.findtext(OVAL_LINUX + 'name') or ''
            node.clear()
        elif tag == OVAL_LINUX + 'rpminfo_state':
            evr = node.find(OVAL_LINUX + 'evr')
            if evr is not None and evr.get('operation') == 'less than' and evr.text:
                epoch, _, rest = evr.text.partition(':')
                version, _, release = rest.rpartition('-')
                states[node.get('id')] = (epoch, version, release)
            node.clear()
    package_tests = {test: (objects[obj], states[state]) for test, (obj, state) in tests.items() if obj in objects and state in states}
    return definitions, package_tests


def oval_same_stream(installed, fixed):
    """Whether a fix is for the stream that is installed: a module stream (mariadb:11.8) only for the same module stream, the
    normal package only for the normal package. The OVAL criteria name the module; this short form looks at the release."""
    module_have, module_fix = 'module' in installed[2], 'module' in fixed[2]
    if module_have != module_fix:
        return False
    return not module_have or installed[1].split('.')[:2] == fixed[1].split('.')[:2]


def oval_findings(definitions, package_tests, installed, older, exposed=()):
    """One finding per installed package that is older than the fix of a definition, with its CVEs."""
    per_package = {}
    for item in definitions:
        for test in item['tests']:
            if test not in package_tests:
                continue
            name, fixed = package_tests[test]
            versions = installed.get(name, [])
            # Several kernels stay installed side by side: only the newest one counts.
            newest = versions[0] if versions else None
            for have in versions[1:]:
                if older(newest, have):
                    newest = have
            if newest is not None and oval_same_stream(newest, fixed) and older(newest, fixed):
                entry = per_package.setdefault(name, {'cves': set(), 'severity': set(), 'advisories': set()})
                entry['cves'] |= set(item['cves'])
                entry['severity'].add(item['severity'])
                entry['advisories'].add(item['title'].split(':')[0])
    found = []
    for name, entry in sorted(per_package.items(), key=lambda pair: (pair[0] not in exposed, pair[0])):
        serious = bool(entry['severity'] & {'Critical', 'Important'})
        cves = sorted(entry['cves'])
        found.append(finding('problem' if serious and name in exposed else 'warning',
                             f'OVAL: {name} has known vulnerabilities' + (' (listens on the network)' if name in exposed else ''),
                             f"{', '.join(sorted(item for item in entry['severity'] if item))}: {', '.join(cves[:8])}" + (' ...' if len(cves) > 8 else ''),
                             'Maintenance & update: Update system.'))
    return found


def _oval_fetch():
    """Loads the OVAL file when it changed (ETag). Offline the last copy stays."""
    import urllib.request
    url = _platform().oval_source()
    if not url:
        return 'no OVAL data for this system'
    state = _json_read(OVAL_STATE, {})
    request = urllib.request.Request(url, headers={'User-Agent': 'eFa-next'})
    if state.get('etag') and os.path.exists(OVAL_FILE):
        request.add_header('If-None-Match', state['etag'])
    try:
        with urllib.request.urlopen(request, timeout=60) as answer:
            data = answer.read(64 * 1024 * 1024)
            etag = answer.headers.get('ETag', '')
    except urllib.error.HTTPError as err:
        return 'unchanged' if err.code == 304 else f'not loaded: HTTP {err.code}'
    except OSError as err:
        return f'not loaded, the last copy is used: {err}'
    _write_bytes(OVAL_FILE, data)
    _json_write(OVAL_STATE, {'etag': etag, 'loaded': time.strftime('%Y-%m-%d %H:%M'), 'url': url})
    return 'loaded'


def _write_bytes(path, data):
    with open(path + '.new', 'wb') as f:
        f.write(data)
    os.replace(path + '.new', path)


def oval_check(listening):
    """The OVAL findings of this host, when the OVAL check is on."""
    if not _json_read(SECURITY_SETTINGS, {}).get('oval'):
        return [], None
    status = _oval_fetch()
    if not os.path.exists(OVAL_FILE):
        return [finding('warning', 'OVAL data not loaded', status, 'Check the access to the OVAL source over HTTPS.')], status
    import bz2
    with bz2.open(OVAL_FILE) as stream:
        definitions, package_tests = oval_parse(stream)
    platform_now = _platform()
    exposed = {item['package'] for item in listening if item['package'] and item['address'] not in ('127.0.0.1', '::1')}
    found = oval_findings(definitions, package_tests, platform_now.package_versions(), platform_now.version_older, exposed)
    if status not in ('loaded', 'unchanged'):  # R7-1: the last copy is checked, but say that it is not current
        found.append(finding('warning', 'OVAL data not current', status, 'Check the access to the OVAL source over HTTPS.'))
    return found, status


def security_oval_set(args):
    """Also check the installed packages against the open OVAL data of the distribution (CVEs), loaded once a day. Off by default."""
    on = _on_off(args.mode)
    _json_write(SECURITY_SETTINGS, {**_json_read(SECURITY_SETTINGS, {}), 'oval': on})
    return {'oval_check': on, 'source': _platform().oval_source() or 'none for this system'}


def security_check_set(args):
    """Run the security self check every day. Off by default."""
    enabled = _on_off(args.mode)
    _json_write(SECURITY_SETTINGS, {**_json_read(SECURITY_SETTINGS, {}), 'daily': enabled})
    return security_status(None)


def password_problem(password, username=''):
    """Why a new password is weak, or None: short, all one character, the user name, or on the list that ships with eFa-next."""
    if len(password) < 12:
        return 'Password: at least 12 characters.'
    if len(set(password)) < 4:
        return 'Password: too few different characters.'
    if username and username.split('@')[0].lower() in password.lower():
        return 'Password: it contains the user name.'
    try:
        with open(COMMON_PASSWORDS, encoding='utf-8') as f:
            common = {line.strip().lower() for line in f if line.strip()}
    except OSError:
        common = set()
    # As typed, without trailing punctuation, and as the base word without trailing digits.
    if {password.lower(), re.sub(r'[!?.]+$', '', password.lower()), re.sub(r'[\d!?.]+$', '', password.lower())} & common:
        return 'Password: it is on the list of common passwords.'
    if _json_read(SECURITY_SETTINGS, {}).get('pwned') and pwned_count(password):
        return 'Password: it is in known data breaches (Have I Been Pwned).'
    return None


PWNED_URL = 'https://api.pwnedpasswords.com/range/'


def pwned_count(password, fetch=None):
    """How often a password is in known data breaches, by k-anonymity: only the first 5 characters of its SHA-1 leave this
    host. 0 when the service cannot be reached: then only the own checks count."""
    digest = hashlib.sha1(password.encode('utf-8')).hexdigest().upper()

    def online(prefix):
        import urllib.request
        request = urllib.request.Request(PWNED_URL + prefix, headers={'User-Agent': 'eFa-next', 'Add-Padding': 'true'})
        with urllib.request.urlopen(request, timeout=5) as answer:
            return answer.read().decode('ascii', 'replace')
    try:
        text = (fetch or online)(digest[:5])
    except OSError:
        return 0
    for line in text.splitlines():
        suffix, _, count = line.strip().partition(':')
        if suffix == digest[5:] and count.isdigit():
            return int(count)
    return 0


def pwned_check_set(args):
    """New passwords are also checked against known data breaches (Have I Been Pwned, k-anonymity). Off by default."""
    on = _on_off(args.mode)
    _json_write(SECURITY_SETTINGS, {**_json_read(SECURITY_SETTINGS, {}), 'pwned': on})
    return {'pwned_check': on, 'note': 'Only the first 5 characters of the SHA-1 of a new password go to api.pwnedpasswords.com.'}


INTERFACES_FILE = ETC + '/eFa/interfaces.json'
INTERFACE_ROLES = ('unused', 'uplink', 'internal', 'management')
INTERFACE_REVERT = 'efa-interface-revert'
# The firewall zone of each role, and what an internal or management network may reach.
ROLE_ZONES = {'uplink': 'public', 'internal': 'internal', 'management': 'internal', 'unused': 'drop'}
INTERNAL_SERVICES = ('smtp', 'smtp-submission', 'smtps', 'ssh', 'https')
# Each extra uplink gets its own routing table, so its answers leave where the request came in.
UPLINK_TABLE_BASE = 100


def interfaces_state():
    return {'interfaces': {}, 'pending': None, **_json_read(INTERFACES_FILE, {})}


def interface_settings(role, method, address, gateway, dns, metric, table):
    """The NetworkManager settings of one interface from its role. Uplinks besides the main one route their own answers by their own table."""
    if role == 'unused':
        # The own routing table and its rule of a former uplink go too.
        return {'ipv4.method': 'disabled', 'ipv4.addresses': '', 'ipv4.gateway': '', 'connection.zone': ROLE_ZONES['unused'],
                'ipv4.route-table': '0', 'ipv4.routing-rules': ''}
    found = {'ipv4.method': method, 'connection.zone': ROLE_ZONES[role], 'ipv4.dns': dns or ''}
    if method == 'manual':
        found.update({'ipv4.addresses': address, 'ipv4.gateway': gateway if role == 'uplink' else ''})
    else:
        found.update({'ipv4.addresses': '', 'ipv4.gateway': ''})
    if role == 'uplink':
        found['ipv4.route-metric'] = str(metric)
        if method == 'manual' and table:
            ip = address.split('/')[0]
            found.update({'ipv4.route-table': str(table), 'ipv4.routing-rules': f'priority {table} from {ip} table {table}'})
    else:
        # An internal network never becomes the way out.
        found.update({'ipv4.never-default': 'yes', 'ipv4.route-table': '0', 'ipv4.routing-rules': ''})
    return found


def interfaces_list(_args):
    """All ethernet interfaces with their role, address and state. The interface of the default route is shown, never changed here."""
    platform_now, state = _platform(), interfaces_state()
    try:
        main, found = platform_now.main_interface(), platform_now.interfaces()
    except Exception as err:  # the StepError of the platform layer
        raise EfaError(str(err))
    rows = []
    for item in found:
        settings = platform_now.connection_settings(item['connection']) if item['connection'] else {}
        rows.append({**item, 'main': item['device'] == main, 'role': 'main uplink' if item['device'] == main else state['interfaces'].get(item['device'], {}).get('role', 'unused'),
                     'address': settings.get('ipv4.addresses', ''), 'gateway': settings.get('ipv4.gateway', ''), 'zone': settings.get('connection.zone', '')})
    return {'interfaces': rows, 'waiting_for_confirmation': state['pending']['device'] if state['pending'] else None}


def interface_set(args):
    """Role and address of an extra interface. Reverts after 5 minutes unless confirmed; the zone changes only between minute 20 and 50."""
    _confirm(args)
    device, role = args.device.strip(), args.role.strip()
    vlan = (args.vlan or '').strip()
    if not re.fullmatch(r'[A-Za-z0-9._-]{1,15}', device) or role not in INTERFACE_ROLES or (vlan and not (vlan.isdigit() and 1 <= int(vlan) <= 4094)):
        raise EfaError('Device, role (' + ', '.join(INTERFACE_ROLES) + ') and VLAN 1 to 4094.')
    state, platform_now = interfaces_state(), _platform()
    if state['pending']:
        raise EfaError('Another interface change waits for confirmation.')
    try:
        main, known = platform_now.main_interface(), {item['device'] for item in platform_now.interfaces()}
    except Exception as err:
        raise EfaError(str(err))
    if device == main:
        raise EfaError('This is the interface of the default route: it is set on the page Network, DNS & certificate, not here.')
    if device not in known:
        raise EfaError('No such ethernet interface.')
    method = (args.method or '').strip() or 'manual'
    address, gateway, dns = (args.address or '').strip(), (args.gateway or '').strip(), (args.dns or '').strip()
    if role != 'unused' and method == 'manual':
        try:
            network = ipaddress.IPv4Interface(address)
            if gateway and ipaddress.IPv4Address(gateway) not in network.network:
                raise EfaError('The gateway is not in the network of the address.')
        except ValueError:
            raise EfaError('Address like 192.0.2.10/24, gateway like 192.0.2.1.')
        if role == 'uplink' and not gateway:
            raise EfaError('An uplink needs a gateway.')
    try:
        dns = ' '.join(str(ipaddress.ip_address(item)) for item in dns.replace(',', ' ').split())
    except ValueError:
        raise EfaError('DNS servers: IP addresses.')
    zone_change = role != state['interfaces'].get(device, {}).get('role', 'unused')
    if zone_change and not UPDATE_WINDOW[0] <= datetime.datetime.now().minute <= UPDATE_WINDOW[1]:
        raise EfaError(f'A firewall zone changes only between minute {UPDATE_WINDOW[0]} and {UPDATE_WINDOW[1]}.')
    uplinks = sorted(name for name, item in state['interfaces'].items() if item.get('role') == 'uplink' and name != device)
    table = UPLINK_TABLE_BASE + len(uplinks) + 1 if role == 'uplink' else None
    try:
        connection, made = platform_now.connection_ensure(device, int(vlan) if vlan else None)
        previous = platform_now.connection_settings(connection)
        restore_zone = zone_restore_due(state, device, role)
        services = platform_now.zone_service_list('internal') if role in ('internal', 'management') or restore_zone else None
        state['pending'] = {'device': device, 'connection': connection, 'made': made, 'previous': previous, 'internal_services': services,
                            'zone_original': dict(state.get('zone_original') or {}),
                            'old': state['interfaces'].get(device), 'until': time.strftime('%Y-%m-%d %H:%M:%S', time.localtime(time.time() + 300))}
        # 5l-b: the services the internal zone had before eFa-next set them first, for when no interface uses the zone any more.
        if role in ('internal', 'management') and 'internal' not in state.setdefault('zone_original', {}):
            state['zone_original']['internal'] = services
        # The way back first, as for the firewall.
        platform_now.schedule(INTERFACE_REVERT, 300, ['/usr/sbin/efactl', 'interface-revert'])
        _json_write(INTERFACES_FILE, state)
        if role in ('internal', 'management'):
            platform_now.zone_services('internal', INTERNAL_SERVICES if role == 'internal' else ('ssh', 'https'))
        elif restore_zone:
            platform_now.zone_services('internal', state['zone_original'].pop('internal'))
            _json_write(INTERFACES_FILE, state)
        platform_now.connection_apply(connection, interface_settings(role, method, address, gateway, dns, 50 + 10 * (len(uplinks) + 1), table))
    except Exception as err:
        raise EfaError(f'The interface was not changed fully, it is taken back within 5 minutes: {err}')
    state['interfaces'][device] = {'role': role, 'method': method, 'address': address, 'gateway': gateway, 'dns': dns, 'vlan': vlan, 'table': table}
    _json_write(INTERFACES_FILE, state)
    hints = []
    if role == 'uplink' and method == 'manual':
        hints.append(f'Mail sent over this uplink needs a PTR record for {address.split("/")[0]}, the same name as HELO, and the address in the SPF record.')
    if role == 'internal':
        hints.append(f'Add {ipaddress.IPv4Interface(address).network if method == "manual" else "its network"} to the relay networks if its mail servers send through eFa-next.')
    return {'device': device, 'role': role, 'confirm_until': state['pending']['until'], 'hints': hints,
            'note': 'Check that you still have access, then confirm with interface-confirm. Otherwise this reverts by itself after 5 minutes.'}


def zone_restore_due(state, device, role):
    """5l-b: the device leaves the internal zone, no other interface stays in it, and the services it had before are known."""
    leaving = state['interfaces'].get(device, {}).get('role') in ('internal', 'management') and role not in ('internal', 'management')
    others = any(item.get('role') in ('internal', 'management') for name, item in state['interfaces'].items() if name != device)
    return leaving and not others and (state.get('zone_original') or {}).get('internal') is not None


# 5l: mail of a sender domain leaves over an extra uplink: an own smtp transport bound to the address of that uplink, chosen by
# sender_dependent_default_transport_maps. Its answers come back the same way through the routing table of the uplink.
UPLINK_ROUTES = ETC + '/postfix/efa-sender-transport'
UPLINK_SERVICE = 'efa-out-'


def uplink_route_plan(routes, interfaces):
    """({transport: bind address}, map lines) for {sender domain: device}; a device must be an uplink with a fixed address."""
    services, lines = {}, []
    for domain, device in sorted(routes.items()):
        item = interfaces.get(device) or {}
        if item.get('role') != 'uplink' or item.get('method') != 'manual' or not item.get('address'):
            raise EfaError(f'{device} is no uplink with a fixed address (interface-set).')
        name = UPLINK_SERVICE + re.sub(r'[^a-z0-9]', '-', device.lower())
        services[name] = item['address'].split('/')[0]
        lines.append(f'@{domain} {name}:')
    return services, lines


def uplink_services_in(master):
    """The uplink services of `postconf -M`, which prints "name unix ..." (older Postfix "name/unix ...")."""
    return [line.split()[0].split('/')[0] for line in master.splitlines() if line.startswith(UPLINK_SERVICE)]


def _uplink_routes_apply(routes, interfaces):
    services, lines = uplink_route_plan(routes, interfaces)
    have = uplink_services_in(subprocess.run(['postconf', '-M'], capture_output=True, text=True).stdout)
    for name, address in services.items():
        subprocess.run(['postconf', '-M', f'{name}/unix={name} unix - - n - - smtp'], check=True, capture_output=True)
        subprocess.run(['postconf', '-P', f'{name}/unix/smtp_bind_address={address}', f'{name}/unix/syslog_name=postfix/{name}'],
                       check=True, capture_output=True)
    for name in set(have) - set(services):
        subprocess.run(['postconf', '-MX', f'{name}/unix'], check=False, capture_output=True)
    current = _postconf('sender_dependent_default_transport_maps')
    if lines:
        if current not in ('', _map(UPLINK_ROUTES)):
            raise EfaError(f'sender_dependent_default_transport_maps is already used ({current}), nothing changed.')
        _map_write(UPLINK_ROUTES, lines)
        _postconf_set('sender_dependent_default_transport_maps', _map(UPLINK_ROUTES))
    elif current == _map(UPLINK_ROUTES):
        _postconf_remove(['sender_dependent_default_transport_maps'])
        subprocess.run(['postfix', 'reload'], check=False, capture_output=True)


def uplink_route_set(args):
    """Outgoing mail of one of the own sender domains over an extra uplink, or back over the main one (--device main)."""
    domain, device = args.domain.strip().lower(), args.device.strip()
    if not DOMAIN_RE.match(domain) or domain not in _local_domains():
        raise EfaError('Domain: one of the own domains.')
    state = interfaces_state()
    routes = dict(state.get('routes') or {})
    if device == 'main':
        routes.pop(domain, None)
    else:
        routes[domain] = device
    _uplink_routes_apply(routes, state['interfaces'])
    state['routes'] = routes
    _json_write(INTERFACES_FILE, state)
    _audit(f'outgoing mail of {domain} over {device} set by {_dmarc_who()}')
    hint = '' if device == 'main' else (f'The address of {device} needs a PTR record with the HELO name and a place in the SPF record of {domain}.')
    return {'routes': routes, 'note': hint}


# G7-19 (5l part 2): failover of outgoing mail to a second uplink. efa-uplink-watch.timer asks every minute whether the main
# uplink still reaches the probe (TCP from the address of the main uplink); after three misses in a row outgoing mail leaves
# over the backup uplink (default_transport an own smtp bound to its address; its own routing table takes the answers back),
# but only when the backup is fit to send (P7-9): its address has a PTR, that name points back to the address, the HELO name
# of the transport is that name, and the SPF record of each own domain lets the address send. Otherwise nothing switches and
# the mail waits in the queue; the dashboard says why. Five good answers of the main uplink in a row switch back. The firewall
# is not touched (never a reload).
UPLINK_FAILOVER_FILE = ETC + '/eFa/uplink-failover.json'
UPLINK_FAIL_AFTER, UPLINK_BACK_AFTER = 3, 5
# Security review 2026-11-24 (F8): no third party by default. Empty: the default gateway of the main uplink answers a ping.
# Otherwise three host:port probes the admin chose, and two of them must answer.
UPLINK_PROBE_DEFAULT = ''


def uplink_failover_state():
    return {'enabled': False, 'backup': '', 'probe': UPLINK_PROBE_DEFAULT, 'active': 'main', 'misses': 0, 'goods': 0, 'since': '', 'ready': None,
            'reason': '', **_json_read(UPLINK_FAILOVER_FILE, {})}


def spf_allows(domain, address, lookup=None, depth=0, seen=None):
    """Whether the SPF record of the domain lets this address send: ip4/ip6, a, mx and include, as far as 10 lookups go. The
    first mechanism that matches decides; -all, ~all and no record count as no."""
    lookup = lookup or (lambda name, rtype: _dig(name, rtype)[0])
    seen = seen if seen is not None else set()
    if depth > 10 or domain in seen:
        return False
    seen.add(domain)
    ip = ipaddress.ip_address(address)
    records = [''.join(re.findall(r'"([^"]*)"', item)) or item for item in lookup(domain, 'TXT')]
    spf = next((item for item in records if item.lower().startswith('v=spf1')), '')
    for term in spf.split()[1:]:
        qualifier = term[0] if term[0] in '+-~?' else '+'
        mechanism = term.lstrip('+-~?').lower()
        hit = False
        if mechanism.startswith(('ip4:', 'ip6:')):
            hit = _safe(lambda: ip in ipaddress.ip_network(mechanism[4:], strict=False), False)
        elif mechanism in ('a', 'mx') or mechanism.startswith(('a:', 'mx:')):
            name = mechanism.split(':', 1)[1] if ':' in mechanism else domain
            hosts = [name] if mechanism.startswith('a') else [item.split()[-1].rstrip('.') for item in lookup(name, 'MX')]
            hit = any(str(ip) in lookup(host, 'AAAA' if ip.version == 6 else 'A') for host in hosts[:10])
        elif mechanism.startswith('include:'):
            hit = spf_allows(mechanism[8:], address, lookup, depth + 1, seen)
        elif mechanism == 'all':
            hit = True
        if hit:
            return qualifier == '+'
    redirect = re.search(r'\bredirect=(\S+)', spf)
    return spf_allows(redirect.group(1), address, lookup, depth + 1, seen) if redirect else False


def uplink_backup_ready(address, helo, domains, lookup=None):
    """'' when the backup address may send mail for these domains (P7-9), else what is missing."""
    lookup = lookup or (lambda name, rtype: _dig(name, rtype)[0])
    ip = ipaddress.ip_address(address)
    ptr = [item.rstrip('.').lower() for item in lookup(ip.reverse_pointer, 'PTR')]
    if not ptr:
        return f'{address} has no PTR record'
    if helo.lower().rstrip('.') not in ptr:
        return f'the PTR of {address} is {ptr[0]}, not the HELO name {helo}'
    if str(ip) not in lookup(helo, 'AAAA' if ip.version == 6 else 'A'):
        return f'{helo} does not point back to {address}'
    blocked = [domain for domain in sorted(domains) if not spf_allows(domain, address, lookup)]
    if blocked:
        return f'the SPF record of {", ".join(blocked[:5])} does not let {address} send'
    return ''


def _uplink_gateway(routes=None):
    """The gateway of the default route with the lowest metric (the main uplink), or ''."""
    if routes is None:
        routes = subprocess.run(['ip', '-4', 'route', 'show', 'default'], capture_output=True, text=True, timeout=15).stdout
    found = sorted((int((re.search(r'\bmetric (\d+)', line) or [0, 0])[1]), match[1])
                   for line in routes.splitlines() for match in [re.search(r'\bvia (\S+)', line)] if match)
    return found[0][1] if found else ''


def uplink_probes(text):
    """The probes of the failover: [] for the gateway of the main uplink, or exactly three host:port; ValueError otherwise."""
    items = [item.strip() for item in (text or '').split(',') if item.strip()]
    if not items:
        return []
    if len(items) != 3 or len(set(items)) != 3:
        raise ValueError('three different host:port probes, comma separated, or empty for the gateway of the main uplink')
    for item in items:
        host, _sep, port = item.rpartition(':')
        if not port.isdigit() or not 0 < int(port) < 65536 or not (HOST_RE.match(host) or _safe(lambda: ipaddress.ip_address(host.strip('[]')), None)):
            raise ValueError(f'{item} is no host:port')
    return items


def _uplink_connect(probe, timeout=3):
    host, _sep, port = probe.rpartition(':')
    try:
        with socket.create_connection((host.strip('[]'), int(port)), timeout=timeout):
            return True
    except (OSError, ValueError):
        return False


def _uplink_ping(address, timeout=3):
    return subprocess.run(['ping', '-n', '-c', '1', '-W', str(timeout), address], capture_output=True, timeout=timeout + 5).returncode == 0


def _uplink_probe(probe, timeout=3, connect=None, ping=None, gateway=None):
    """True when the main uplink works: its gateway answers a ping (no probe set), or two of the three probes answer over the
    default route, which is the main uplink (its metric is the lowest)."""
    probes = _safe(lambda: uplink_probes(probe), None)
    if probes is None:
        return False
    if not probes:
        address = (gateway or _uplink_gateway)()
        return bool(address) and _safe(lambda: (ping or _uplink_ping)(address, timeout), False)
    return sum(1 for item in probes if (connect or _uplink_connect)(item, timeout)) >= 2


def _uplink_switch(state, to):
    """default_transport to the transport of the backup uplink, or back to smtp."""
    if to == 'backup':
        services, _lines = uplink_route_plan({'failover.invalid': state['backup']}, interfaces_state()['interfaces'])
        name, address = next(iter(services.items()))
        subprocess.run(['postconf', '-M', f'{name}/unix={name} unix - - n - - smtp'], check=True, capture_output=True)
        subprocess.run(['postconf', '-P', f'{name}/unix/smtp_bind_address={address}', f'{name}/unix/syslog_name=postfix/{name}'],
                       check=True, capture_output=True)
        _postconf_set('default_transport', f'{name}:')
    else:
        _postconf_set('default_transport', 'smtp')
    subprocess.run(['postfix', 'reload'], check=False, capture_output=True)
    state.update(active=to, since=time.strftime('%Y-%m-%d %H:%M'))
    _audit(f'outgoing mail over the {to} uplink ({state["backup"] if to == "backup" else "main"}): failover watch')
    _admin_notify('eFa-next: uplink ' + ('failover' if to == 'backup' else 'back on the main uplink'),
                  f'Outgoing mail leaves over the {"backup uplink " + state["backup"] if to == "backup" else "main uplink"} since {state["since"]}.')


def uplink_watch_run(_args, probe=None, ready=None):
    """Every minute (efa-uplink-watch.timer): the main uplink asked, switched over after 3 misses (when the backup is fit), back
    after 5 good answers."""
    state = uplink_failover_state()
    if not state['enabled']:
        return state
    good = (probe or _uplink_probe)(state['probe'])
    state['misses'], state['goods'] = (0, state['goods'] + 1) if good else (state['misses'] + 1, 0)
    if state['active'] == 'main' and state['misses'] >= UPLINK_FAIL_AFTER:
        item = interfaces_state()['interfaces'].get(state['backup'], {})
        address = (item.get('address') or '').split('/')[0]
        problem = (ready or uplink_backup_ready)(address, own_hostname(), _local_domains()) if address else 'the backup uplink has no fixed address'
        state['ready'], state['reason'] = not problem, problem
        if not problem:
            _uplink_switch(state, 'backup')
    elif state['active'] == 'backup' and state['goods'] >= UPLINK_BACK_AFTER:
        _uplink_switch(state, 'main')
    _json_write(UPLINK_FAILOVER_FILE, state)
    return state


def uplink_failover_status(_args):
    """G7-19: the failover of outgoing mail: on or off, the backup uplink, which one sends now, and why it did not switch."""
    return uplink_failover_state()


def uplink_failover_set(args):
    """G7-19: switch the failover of outgoing mail to a backup uplink on or off; on checks at once whether the backup is fit."""
    state = uplink_failover_state()
    on = _on_off(args.mode)
    if on:
        backup = (args.backup or '').strip() or state['backup']
        item = interfaces_state()['interfaces'].get(backup, {})
        if item.get('role') != 'uplink' or item.get('method') != 'manual' or not item.get('address'):
            raise EfaError(f'{backup or "The backup"} is no uplink with a fixed address (interface-set).')
        probe = (getattr(args, 'probe', '') or '').strip()
        probe = '' if probe == '-' else (probe or state['probe'])
        try:
            probe = ','.join(uplink_probes(probe))
        except ValueError as err:
            raise EfaError(f'Probe: {err}.')
        state.update(backup=backup, probe=probe)
        problem = uplink_backup_ready(item['address'].split('/')[0], own_hostname(), _local_domains())
        state['ready'], state['reason'] = not problem, problem
    elif state['active'] == 'backup':
        _uplink_switch(state, 'main')
    state['enabled'] = on
    _json_write(UPLINK_FAILOVER_FILE, state)
    _safe(lambda: _platform().service_enable('efa-uplink-watch.timer', start=True) if on else _platform().service_disable('efa-uplink-watch.timer', stop=True), None)
    _audit(f"uplink failover {'on' if on else 'off'} (backup {state['backup']}, probe {state['probe'] or 'gateway'}) by {_dmarc_who()}")
    return {**state, 'note': state['reason'] and f'Not fit to send yet: {state["reason"]}. The watch runs, but switches only once this is fixed.'}


def uplink_notices():
    state = uplink_failover_state()
    if not state['enabled']:
        return []
    if state['active'] == 'backup':
        return [_text('Outgoing mail leaves over the backup uplink {backup} since {since}: the main uplink did not answer.', backup=state['backup'], since=state['since'])]
    if state.get('ready') is False:
        return [_text('The backup uplink {backup} is not fit to send mail: {reason}. A failover would not switch.', backup=state['backup'], reason=state['reason'])]
    return []


def network_harden(_args):
    """Package setup: a new interface gets no automatic DHCP profile (it could take an address or a default route from an unknown
    network); it stays unused until it has a role. Profiles that exist stay."""
    try:
        return {'no_auto_profiles': _platform().no_auto_profiles()}
    except (NotImplementedError, AttributeError):
        return {'no_auto_profiles': None}


def new_interfaces(found=None):
    """Network devices that are neither the interface of the default route nor have a role in eFa-next. No program is started:
    the dashboard asks on every load."""
    try:
        devices, main = found if found is not None else _platform().ethernet_devices()
    except (NotImplementedError, AttributeError):  # a platform without it (the plain one of the tests)
        return []
    known = set(interfaces_state()['interfaces'])
    return [name for name in devices if name not in main and name not in known]


def interface_confirm(_args):
    state = interfaces_state()
    if not state['pending']:
        raise EfaError('No interface change waits for confirmation.')
    _platform().unschedule(INTERFACE_REVERT)
    state['pending'] = None
    _json_write(INTERFACES_FILE, state)
    return {'confirmed': True}


def interface_revert(_args):
    """Takes an unconfirmed interface change back: the old settings, or the connection eFa-next made goes again."""
    state = interfaces_state()
    pending = state['pending']
    if not pending:
        return {'reverted': False}
    platform_now = _platform()
    try:
        if pending['made']:
            platform_now.connection_delete(pending['connection'])
        else:
            platform_now.connection_apply(pending['connection'], pending['previous'])
        # The services of the internal zone as they were, if this change set them.
        if pending.get('internal_services') is not None:
            platform_now.zone_services('internal', pending['internal_services'])
    finally:
        if 'zone_original' in pending:
            state['zone_original'] = pending['zone_original']
        if pending['old'] is None:
            state['interfaces'].pop(pending['device'], None)
        else:
            state['interfaces'][pending['device']] = pending['old']
        state['pending'] = None
        _json_write(INTERFACES_FILE, state)
    _admin_notify('eFa-next: interface change taken back', f"The change of {pending['device']} was not confirmed within 5 minutes and was taken back.")
    return {'reverted': True}


def tui(_args):
    """The text interface, efa-tui, with the same commands and checks as the web interface."""
    os.execv('/usr/local/sbin/efa-tui', ['/usr/local/sbin/efa-tui', *sys.argv[2:]])


# 6.0.0.6.7: maintenance mode has a marker of its own (who and when). The cron file of the service monitor follows it: on means
# no cron file and the marker, off the cron file and no marker. A cron file missing without the marker was lost (leapp removed
# the package that owns it as %ghost, the cleanup of an eFa 5 migration) and comes back (monitor_cron_heal, every 5 minutes).
MAINTENANCE_FILE = ETC + '/eFa/maintenance.json'
MONITOR_CRON_TEXT = '* * * * * root /usr/sbin/efa-monitor >/dev/null 2>&1\n'
MONITOR_SKIP = '/var/eFa/skipmonitor'  # efa-migrate keeps the monitor off until its reboot


def maintenance_set(args):
    """Maintenance mode stops the service monitor from restarting services."""
    if _on_off(args.mode):
        _json_write(MAINTENANCE_FILE, {'by': _dmarc_who(), 'at': int(time.time())}, mode=0o644)
        if os.path.exists(MONITOR_CRON):
            os.remove(MONITOR_CRON)
    else:
        _write(MONITOR_CRON, MONITOR_CRON_TEXT)
        if os.path.exists(MAINTENANCE_FILE):
            os.remove(MAINTENANCE_FILE)
    return {'maintenance_mode': not os.path.exists(MONITOR_CRON), **maintenance_marker()}


def maintenance_marker():
    """Who switched maintenance mode on and when ({} while it is off)."""
    if os.path.exists(MONITOR_CRON):
        return {}
    marker = _json_read(MAINTENANCE_FILE, {})
    return {'maintenance_by': marker.get('by', ''), 'maintenance_since': marker.get('at', 0),
            **({'maintenance_note': marker['note']} if marker.get('note') else {})}


def monitor_cron_heal(args=None):
    """The cron file of the service monitor as maintenance mode says. first (the update to 6.0.0.6.7): a host without the cron
    file and without a marker keeps maintenance mode on, now with a marker that says so; the admin decides. After that a cron
    file missing without the marker is written again, with an audit entry and an event."""
    if not os.path.isdir(os.path.dirname(MONITOR_CRON)) or os.path.exists(FIRSTBOOT_PENDING) or os.path.exists(MONITOR_SKIP):
        return {'monitor_cron': 'not now (setup, first boot or migration)'}
    if os.path.exists(MONITOR_CRON):
        if os.path.exists(MAINTENANCE_FILE):
            os.remove(MAINTENANCE_FILE)  # the cron file is there: maintenance is off, the marker is left from before
        return {'monitor_cron': 'ok'}
    if os.path.exists(MAINTENANCE_FILE):
        return {'monitor_cron': 'maintenance mode', **maintenance_marker()}
    if (getattr(args, 'first', '') or '').strip() == 'yes':
        _json_write(MAINTENANCE_FILE, {'by': 'update to 6.0.0.6.7', 'at': int(time.time()),
                                       'note': 'the cron file of the service monitor was missing before the update: maintenance mode stays on '
                                               'until an admin switches it off'}, mode=0o644)
        _audit('service monitor: no cron file before the update to 6.0.0.6.7, maintenance mode kept on and marked')
        return {'monitor_cron': 'maintenance mode kept on (marked)'}
    _write(MONITOR_CRON, MONITOR_CRON_TEXT)
    _audit('service monitor: its cron file was missing without maintenance mode, written again')
    _event('monitor_cron_restored', 'warning')
    return {'monitor_cron': 'written again'}


# The environment of this host, as other products name it: production (no mark), test (amber) or development (red). The web
# interface shows the host name with it on every page, the login page too, so nobody takes a development host for production. The dev
# flag of efa-init (efa_setup.DEV_FLAG) forces development while it counts.
ENVIRONMENT_FILE = ETC + '/eFa/environment.json'
ENVIRONMENTS = ('prod', 'test', 'dev')


def environment_status(_args=None):
    stored = _json_read(ENVIRONMENT_FILE, {}).get('env')
    stored = stored if stored in ENVIRONMENTS else 'prod'
    forced = _lib('efa_setup').dev_flag_problem() is None
    return {'environment': 'dev' if forced else stored, 'set': stored, 'forced_by': _lib('efa_setup').DEV_FLAG if forced else ''}


def environment_set(args):
    """prod, test or dev; a super admin, audited. Only this host (not handed on in a cluster)."""
    env = (args.env or '').strip()
    if env not in ENVIRONMENTS:
        raise EfaError('Environment: prod, test or dev.')
    if identity_now is not None and identity_now.get('role') != 'super':
        raise EfaError('Only a super admin sets the environment.')
    before = environment_status()['set']
    if env != 'dev' and _lib('efa_setup').dev_flag_problem() is None:
        raise EfaError(f'{_lib("efa_setup").DEV_FLAG} makes this host a development host: remove it first, then set {env}.')
    _json_write(ENVIRONMENT_FILE, {'env': env}, mode=0o644)
    _audit(f'environment {before} -> {env} by {_dmarc_who()}')
    return environment_status()


# Hans 2026-11-17: on a development host the hint "Your login has no 2FA" can be confirmed, per user and only by that user;
# it is void as soon as the host is no longer development. Elsewhere there is no button and the command refuses.
DEV_2FA_FILE = ETC + '/eFa/dev-2fa-hint.json'


def dev_2fa_hint_confirm(_args):
    if environment_status()['environment'] != 'dev':
        raise EfaError('Only on a development host (Environment); elsewhere the 2FA hint stays.')
    user = _totp_self()
    confirmed = {**_json_read(DEV_2FA_FILE, {}), user: time.strftime('%Y-%m-%d %H:%M:%S')}
    _json_write(DEV_2FA_FILE, confirmed, mode=0o644)
    _audit(f'2FA hint confirmed for {user} in dev mode')
    return {'confirmed': user}


def relay_networks_set(args):
    """Networks allowed to relay; rspamd treats them as internal."""
    nets = []
    for item in args.networks.replace(',', ' ').split():
        try:
            net = ipaddress.ip_network(item.replace('[', '').replace(']', ''), strict=False)
        except ValueError:
            raise EfaError(f'Invalid network: {item}')
        if net.prefixlen == 0:
            raise EfaError(f'Refusing open relay network: {item}')
        if str(net) not in RELAY_SYSTEM:
            nets.append(str(net))
    state = _json_read(RELAY_FILE, {})
    state.pop('draft', None)
    _json_write(RELAY_FILE, state)
    return _relay_write(nets)


def _relay_write(nets):
    postfix_nets = ['127.0.0.0/8', '[::1]/128'] + [f'[{n.split("/")[0]}]/{n.split("/")[1]}' if ':' in n else n
                                                  for n in nets]
    _postconf_set('mynetworks', ' '.join(postfix_nets))
    quoted = ','.join(f'"{n}"' for n in ['127.0.0.0/8', '::1/128'] + nets)
    _write(OPTIONS_INC, f'local_addrs = [{quoted}];\n')
    _reload_rspamd()
    if os.path.exists(OUTBOUND_FILE):
        state = _json_read(OUTBOUND_FILE, {})
        state['networks'] = _outbound_networks()
        _write(OUTBOUND_FILE, json.dumps(state, indent=1))
    if os.path.exists(CONTENT_FILE):
        # G7-25: efa-cdr leaves the mail of the relay networks alone (rspamd signed it already).
        state = _json_read(CONTENT_FILE, {})
        state['internal'] = _outbound_networks()
        _write(CONTENT_FILE, json.dumps(state, indent=1))
    return {'relay_networks': postfix_nets}


def _relay_active():
    nets, unknown = [], []
    for item in _postconf('mynetworks').replace(',', ' ').split():
        try:
            net = str(ipaddress.ip_network(item.replace('[', '').replace(']', ''), strict=False))
        except ValueError:
            unknown.append(item)
            continue
        if net not in RELAY_SYSTEM:
            nets.append(net)
    return nets, unknown


def _relay_warnings(net, others):
    warnings = []
    if net.is_global and net.prefixlen <= (8 if net.version == 4 else 32):
        warnings.append(f'{net} is very broad and public: everyone in it may relay through this server.')
    for other in others:
        other = ipaddress.ip_network(other)
        if other != net and other.version == net.version and other.overlaps(net):
            warnings.append(f'{net} overlaps {other}.')
    return warnings


def relay_networks_list(_args):
    """Relay networks with the changes that wait for Apply."""
    active, unknown = _relay_active()
    state = _json_read(RELAY_FILE, {})
    draft = state.get('draft', active)
    descriptions = state.get('descriptions', {})
    rows = [{'network': net, 'family': 'IPv6' if ':' in net else 'IPv4', 'description': 'system', 'state': 'active', 'locked': True}
            for net in RELAY_SYSTEM]
    warnings = []
    for net in list(active) + [item for item in draft if item not in active]:
        state_name = 'to add' if net not in active else 'to remove' if net not in draft else 'active'
        rows.append({'network': net, 'family': 'IPv6' if ':' in net else 'IPv4', 'description': descriptions.get(net, ''),
                     'state': state_name, 'locked': False})
        if net in draft:
            warnings += _relay_warnings(ipaddress.ip_network(net), draft)
    added, removed = [n for n in draft if n not in active], [n for n in active if n not in draft]
    return {'networks': rows, 'added': added, 'removed': removed, 'pending': bool(added or removed),
            'warnings': warnings, 'unknown': unknown}


def relay_networks_add(args):
    """Adds networks to the changes that wait for Apply. Several at once, separated by spaces or commas."""
    active, _unknown = _relay_active()
    state = _json_read(RELAY_FILE, {})
    draft = state.get('draft', active)
    description = (args.description or '').strip()
    if len(description) > 200:
        raise EfaError('Description: up to 200 characters.')
    items, warnings, added = args.networks.replace(',', ' ').split(), [], []
    if not items:
        raise EfaError('Enter at least one network.')
    for item in items:
        try:
            net = ipaddress.ip_network(item.replace('[', '').replace(']', ''))
        except ValueError as err:
            raise EfaError(f'Invalid network, nothing was added: {item}: {err}')
        if net.prefixlen == 0:
            raise EfaError(f'Refusing open relay network, nothing was added: {item}')
        if str(net) in RELAY_SYSTEM or str(net) in draft:
            raise EfaError(f'{net} is already in the list, nothing was added.')
        warnings += _relay_warnings(net, draft)
        draft.append(str(net))
        added.append(str(net))
    if description:
        state.setdefault('descriptions', {}).update({net: description for net in added})
    state['draft'] = draft
    _json_write(RELAY_FILE, state)
    return {'added': added, 'warnings': warnings, 'note': 'Not active yet, use Apply.'}


def relay_networks_remove(args):
    """Marks a network for removal. It stays active until Apply."""
    item = args.network.strip()
    if item in RELAY_SYSTEM or item == '[::1]/128':
        raise EfaError(f'{item} is a system entry and stays.')
    active, _unknown = _relay_active()
    state = _json_read(RELAY_FILE, {})
    draft = state.get('draft', active)
    if item not in draft:
        raise EfaError(f'{item} is not in the list.')
    draft.remove(item)
    state['draft'] = draft
    _json_write(RELAY_FILE, state)
    return {'to_remove': item, 'note': 'Still active, use Apply.'}


def relay_networks_apply(args):
    """Writes the waiting changes to postfix and rspamd."""
    _confirm(args)
    active, unknown = _relay_active()
    if unknown:
        raise EfaError(f'mynetworks holds entries eFa-next cannot read, nothing changed: {" ".join(unknown)}')
    state = _json_read(RELAY_FILE, {})
    draft = state.pop('draft', active)
    state['descriptions'] = {net: text for net, text in state.get('descriptions', {}).items() if net in draft}
    _json_write(RELAY_FILE, state)
    return _relay_write(draft)


# Submitters (8g): internal mail systems that send through this server. Postfix itself binds each one to its own sender domains,
# so the binding holds also when a milter is down. Without a submitter nothing changes.
SUBMITTERS_FILE = ETC + '/eFa/submitters.json'
SUBMITTER_KINDS = ('ip', 'auth', 'cert')
SUBMITTER_NAME_RE = re.compile(r'^[a-z0-9][a-z0-9_]{0,31}$')
SUBMITTER_LOGIN_RE = re.compile(r'^[a-z0-9][a-z0-9._@-]{0,63}$')
FINGERPRINT_RE = re.compile(r'^([0-9A-F]{2}:){31}[0-9A-F]{2}$')
SUB_CIDR = ETC + '/postfix/efa-submitters.cidr'
SUB_SASL = ETC + '/postfix/efa-submitters-sasl'
SUB_CCERT = ETC + '/postfix/efa-submitters-ccert'
SUB_PASSWD = ETC + '/dovecot/efa-submitters.passwd'
SUB_DOVECOT = ETC + '/dovecot/conf.d/90-efa-submitters.conf'
# 5u: the logins for efa-sasl, which replaces Dovecot; Dovecot stays only where system accounts (PAM) still log in on 587.
SASL_LOGINS = ETC + '/efa-sasl/logins'
SASL_UNITS = ('efa-sasl.socket', 'efa-sasl.service')
SASL_SOCKET = '/run/efa-sasl/auth'
def sub_checks():
    return [f'check_client_access cidr:{SUB_CIDR}', f'check_sasl_access {_map(SUB_SASL)}', f'check_ccert_access {_map(SUB_CCERT)}']
SUB_CLASS = 'efa_sub_'


def submitter_restrictions(current, on):
    """A restriction list with the submitter checks first (before permit_mynetworks), or without them."""
    checks = sub_checks()
    items = [item.strip() for item in current.split(',') if item.strip() and item.strip() not in checks]
    return ', '.join((checks if on else []) + items)


def submitter_maps(submitters):
    """The lines of the Postfix tables: client, login and certificate to the class of the submitter; per class its domains."""
    tables = {SUB_CIDR: [], SUB_SASL: [], SUB_CCERT: []}
    classes = {}
    for item in submitters:
        name = SUB_CLASS + item['name']
        tables[{'ip': SUB_CIDR, 'auth': SUB_SASL, 'cert': SUB_CCERT}[item['kind']]].append(f'{item["value"]} {name}')
        # The null sender: bounces and out of office replies of the internal system.
        classes[name] = [f'{domain} OK' for domain in item['domains']] + ['<> OK']
    return tables, classes


# Postfix lookup tables: hash (Berkeley DB) on EL9, lmdb on EL10, as the platform layer says (efa_platform map_type).
MAP_FILE_SUFFIXES = ('.db', '.lmdb')
_MAP_TYPE = []


def _map_type():
    if not _MAP_TYPE:
        platform_now = _platform()
        # An eFa-next-base of before (no map_type yet, during an update): what Postfix says, as the platform would.
        _MAP_TYPE.append(platform_now.map_type() if hasattr(platform_now, 'map_type') else _postconf('default_database_type') or 'hash')
    return _MAP_TYPE[0]


def _map(path):
    """path as a Postfix lookup table of the type of this platform."""
    return f'{_map_type()}:{path}'


def _cache_map(path):
    """A Postfix cache (postscreen, TLS sessions): btree beside hash, else the table type of the platform."""
    return f"{'btree' if _map_type() == 'hash' else _map_type()}:{path}"


def _map_files(path):
    """The table and its compiled forms, for removal."""
    return [path] + [path + suffix for suffix in MAP_FILE_SUFFIXES]


def _map_compiled(path):
    return any(os.path.exists(path + suffix) for suffix in MAP_FILE_SUFFIXES)


def _map_write(path, lines, kind='table'):
    """kind table: compiled with postmap as the platform's type; cidr: read by Postfix as text."""
    _write(path, ''.join(line + '\n' for line in lines))
    os.chmod(path, 0o644)
    if kind == 'table' and subprocess.run(['postmap', _map(path)], capture_output=True).returncode != 0:
        raise EfaError(f'postmap {path} failed.')


def _postconf_explicit():
    return {line.split('=')[0].strip() for line in subprocess.run(['postconf', '-n'], capture_output=True, text=True).stdout.splitlines()}


def _postconf_remove(names):
    if names:
        subprocess.run(['postconf', '-X'] + names, check=True, capture_output=True)


def _submitters():
    return _json_read(SUBMITTERS_FILE, {'submitters': []})['submitters']


def _submitters_apply(submitters):
    """Writes the tables, the classes and the restriction lists, and the logins for Dovecot."""
    tables, classes = submitter_maps(submitters)
    on = bool(submitters)
    if on:
        for path, lines in tables.items():
            _map_write(path, lines, 'cidr' if path == SUB_CIDR else 'table')
    for name, lines in classes.items():
        path = f'{ETC}/postfix/{name.replace("_", "-")}'
        _map_write(path, lines)
        _postconf_set(name, f'check_sender_access {_map(path)}, reject')
    listed = _postconf('smtpd_restriction_classes').replace(',', ' ').split()
    # Taken from the list before it changes: a class that is out of the list is an unused parameter postconf -n no longer shows.
    gone = [item for item in listed if item.startswith(SUB_CLASS) and item not in classes]
    others = [item for item in listed if not item.startswith(SUB_CLASS)]
    if others or classes:
        _postconf_set('smtpd_restriction_classes', ' '.join(others + sorted(classes)))
    for name in ('smtpd_relay_restrictions', 'smtpd_recipient_restrictions'):
        _postconf_set(name, submitter_restrictions(_postconf(name), on))
    _postconf_set('efa_submission_restrictions', ', '.join((sub_checks() if on else []) + ['permit_sasl_authenticated', 'reject']))
    # Port 587 reads the same list; set here too, an upgrade does not touch master.cf.
    if _submission_active():
        subprocess.run(['postconf', '-P'] + [f'submission/inet/{name}=$efa_submission_restrictions'
                                             for name in ('smtpd_relay_restrictions', 'smtpd_recipient_restrictions')], check=True, capture_output=True)
    if any(item['kind'] == 'cert' for item in submitters):
        _postconf_set('smtpd_tls_ask_ccert', 'yes')
        _postconf_set('smtpd_tls_fingerprint_digest', 'sha256')
    elif _postconf('smtpd_tls_ask_ccert') == 'yes' and _postconf('smtpd_tls_fingerprint_digest') == 'sha256':
        _postconf_remove(['smtpd_tls_ask_ccert', 'smtpd_tls_fingerprint_digest'])
    # Classes that are gone, and without submitters the tables and the empty class list: their parameters and files.
    _postconf_remove(gone + ([] if others or classes or 'smtpd_restriction_classes' not in _postconf_explicit() else ['smtpd_restriction_classes']))
    files = [f'{ETC}/postfix/{name.replace("_", "-")}' for name in gone] + ([] if on else list(tables))
    for path in [item for name in files for item in _map_files(name)]:
        if os.path.exists(path):
            os.remove(path)
    _dovecot_logins_write(submitters, _pam_on())
    if os.path.exists(OUTBOUND_FILE):
        _outbound_strict_apply(_json_read(OUTBOUND_FILE, {}))


DOVECOT_AUTH = ETC + '/dovecot/conf.d/10-auth.conf'
PAM_INCLUDE = '!include auth-system.conf.ext'
PAM_OFF_MARK = '  # eFa: system accounts off (efactl submission-pam-set)'


# F3: the choice "system accounts off" kept by eFa-next itself: the OS upgrade (leapp) may put the 10-auth.conf of the package back.
PAM_OFF_FILE = ETC + '/eFa/submission-pam-off'


def _pam_on():
    """Whether Dovecot also checks logins on port 587 against the system accounts (PAM), as the package sets it up."""
    return not os.path.exists(PAM_OFF_FILE) and any(line.strip() == PAM_INCLUDE for line in _read_lines(DOVECOT_AUTH))


def _pam_keep():
    """F3: the stored choice holds, whatever a package did to 10-auth.conf. A host that switched the system accounts off before
    this mark existed has it from its 10-auth.conf; a 10-auth.conf put back with the include active is switched off again."""
    text = '\n'.join(_read_lines(DOVECOT_AUTH))
    if not os.path.exists(PAM_OFF_FILE) and PAM_OFF_MARK.strip() in text:
        _write(PAM_OFF_FILE, 'off\n')
    if os.path.exists(PAM_OFF_FILE) and os.path.exists(DOVECOT_AUTH):
        with open(DOVECOT_AUTH) as f:
            text = f.read()
        changed = pam_toggled(text, False)
        if changed != text:
            _write(DOVECOT_AUTH, changed)
            _audit('system accounts on port 587 switched off again: a package had put back 10-auth.conf')


def pam_toggled(text, on):
    """10-auth.conf with the include of the system accounts on or commented out."""
    lines = []
    for line in text.splitlines():
        if line.strip() == PAM_INCLUDE and not on:
            line = '#' + PAM_INCLUDE + PAM_OFF_MARK
        elif line.strip() == '#' + PAM_INCLUDE + PAM_OFF_MARK.rstrip() or line == '#' + PAM_INCLUDE + PAM_OFF_MARK:
            line = PAM_INCLUDE if on else line
        lines.append(line)
    return '\n'.join(lines) + '\n'


def login_hash(password, sha512_crypt=False):
    """The stored form of a submitter login: scrypt for efa-sasl; SHA512-CRYPT only while Dovecot checks the logins (PAM on),
    made by efa_shacrypt (PY-1: the crypt module of Python is gone from 3.13 on)."""
    if sha512_crypt:
        return '{SHA512-CRYPT}' + _lib('efa_shacrypt').make(password)
    salt = secrets.token_bytes(16)
    digest = hashlib.scrypt(password.encode(), salt=salt, n=2 ** 15, r=8, p=1, dklen=32, maxmem=128 * 1024 * 1024)
    return '{SCRYPT}%d$%d$%d$%s$%s' % (2 ** 15, 8, 1, base64.b64encode(salt).decode(), base64.b64encode(digest).decode())


def _sasl_logins_write(submitters):
    logins = [item for item in submitters if item['kind'] == 'auth']
    os.makedirs(os.path.dirname(SASL_LOGINS), exist_ok=True)
    fd = os.open(SASL_LOGINS + '.new', os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o640)
    os.fchmod(fd, 0o640)  # the umask must not take the group read away
    with os.fdopen(fd, 'w') as f:
        f.write(''.join(f'{item["value"]}:{item["hash"]}\n' for item in logins))
    shutil.chown(SASL_LOGINS + '.new', 'root', 'efa-sasl')
    os.replace(SASL_LOGINS + '.new', SASL_LOGINS)
    return logins


def _dovecot_logins_write(submitters, pam_on):
    if not pam_on:
        # efa-sasl checks the logins; the files of Dovecot stay as they were, for the way back.
        logins = _sasl_logins_write(submitters)
        try:
            _sasl_apply(bool(logins), restart=True)
        except Exception as err:  # the StepError of the platform layer
            raise EfaError(f'Saved, but the login service did not follow: {err}')
        return
    """The logins of the submitters for Dovecot. Without PAM the file is there, maybe empty, so Dovecot has a password database."""
    logins = [item for item in submitters if item['kind'] == 'auth']
    had = os.path.exists(SUB_DOVECOT)
    if logins or not pam_on:
        fd = os.open(SUB_PASSWD + '.new', os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o640)
        os.fchmod(fd, 0o640)  # the umask must not take the group read away
        with os.fdopen(fd, 'w') as f:
            f.write(''.join(f'{item["value"]}:{item["hash"]}\n' for item in logins))
        shutil.chown(SUB_PASSWD + '.new', 'root', 'dovecot')
        os.replace(SUB_PASSWD + '.new', SUB_PASSWD)
        # Without the system accounts there is no user database either: SASL needs none, Dovecot wants one.
        userdb = '' if pam_on else 'userdb {\n  driver = static\n  args = uid=dovecot gid=dovecot home=/nonexistent\n}\n'
        _write(SUB_DOVECOT, '# eFa-next: logins of the submitters (efactl submitter-set), before the other password databases.\n'
                            f'passdb {{\n  driver = passwd-file\n  args = scheme=SHA512-CRYPT {SUB_PASSWD}\n}}\n' + userdb)
    else:
        for path in (SUB_DOVECOT, SUB_PASSWD):
            if os.path.exists(path):
                os.remove(path)
    try:
        _sasl_apply(bool(logins) or pam_on, restart=bool(logins or had or not pam_on))
    except Exception as err:  # the StepError of the platform layer
        raise EfaError(f'Saved, but Dovecot did not follow: {err}')


DOVECOT_LISTEN = ETC + '/dovecot/conf.d/98-efa-listen.conf'
DOVECOT_LISTEN_TEXT = '# eFa-next: this host has no IPv6 (NET-IPV6): Dovecot listens on IPv4 only.\nlisten = *\n'


def _dovecot_listen(platform_now):
    """F5: without IPv6 in the kernel Dovecot fails at listen(::) of its default (*, ::): then IPv4 only. True when changed."""
    if platform_now.ipv6_available():
        if os.path.exists(DOVECOT_LISTEN):
            os.remove(DOVECOT_LISTEN)
            return True
        return False
    if os.path.exists(DOVECOT_LISTEN) and open(DOVECOT_LISTEN).read() == DOVECOT_LISTEN_TEXT:
        return False
    _write(DOVECOT_LISTEN, DOVECOT_LISTEN_TEXT)
    return True


def _sasl_apply(needed, restart=True, pam_on=None):
    """Who checks the SMTP-AUTH logins of port 587: efa-sasl, or Dovecot while system accounts (PAM) still log in there.
    Without a login on 587 neither runs, and 587 offers no AUTH; submitters known by network or certificate still send there."""
    platform_now = _platform()
    dovecot = platform_now.service('sasl')
    pam_on = _pam_on() if pam_on is None else pam_on
    subprocess.run(['postconf', '-P', f"submission/inet/smtpd_sasl_auth_enable={'yes' if needed else 'no'}"], check=True, capture_output=True)
    # Port 587 asks efa-sasl on its own socket, Dovecot on the socket in the private folder of Postfix (the default).
    if needed and not pam_on:
        subprocess.run(['postconf', '-P', f'submission/inet/smtpd_sasl_path={SASL_SOCKET}'], check=True, capture_output=True)
    else:
        subprocess.run(['postconf', '-PX', 'submission/inet/smtpd_sasl_path'], check=False, capture_output=True)
    if not (needed and pam_on) and platform_now.service_exists(dovecot):
        platform_now.service_disable(dovecot, stop=True)
    if needed and pam_on:
        for unit in reversed(SASL_UNITS):
            platform_now.service_disable(unit, stop=True)
        _dovecot_listen(platform_now)
        platform_now.service_enable(dovecot, start=True)
        if restart:
            platform_now.service_try_restart(dovecot)
    elif needed:
        platform_now.service_enable(SASL_UNITS[0], start=True)
        if restart:
            platform_now.service_try_restart(SASL_UNITS[1])
    else:
        for unit in reversed(SASL_UNITS):
            platform_now.service_disable(unit, stop=True)
    platform_now.service_reload_if_active(platform_now.service('mta'))


def _submission_auth():
    """The SMTP-AUTH switch of port 587 as Postfix has it: its own -o in master.cf, else the one of main.cf."""
    name = 'submission/inet/smtpd_sasl_auth_enable'
    value = next((line.partition('=')[2].strip() for line in _ru_postconf('-P').splitlines() if line.partition('=')[0].strip() == name), '')
    return value or _postconf('smtpd_sasl_auth_enable') or 'no'


def submission_record():
    """F3: before leapp runs, the state of port 587 as it is (AUTH on or off, system accounts on or off), with the mark of a
    choice "off" written now: a host whose last sasl-apply ran on an older build has no mark yet."""
    _pam_keep()
    pam_on = _pam_on()
    if not pam_on:
        _write(PAM_OFF_FILE, 'off\n')
    effective, overrides = _submission_effective()
    return {'auth': _submission_auth(), 'pam_on': pam_on, 'effective': effective, 'overrides': overrides, 'units': _submission_units()}


def _submission_effective():
    """(the values port 587 uses, its own -o in master.cf) for efa_release_upgrade.SUBMISSION_KEYS."""
    lib = _ru_lib()
    overrides = lib.submission_overrides(_ru_postconf('-P'))
    return lib.submission_effective(overrides, _postconf), overrides


def _submission_units():
    """{unit: enabled} of the login services of port 587: efa-sasl and Dovecot."""
    platform_now = _platform()
    units = [SASL_UNITS[0], _safe(lambda: platform_now.service('sasl'), '')]
    return {unit: bool(_safe(lambda unit=unit: platform_now.service_is_enabled(unit), False)) for unit in units if isinstance(unit, str) and unit}


def submission_restore(recorded):
    """F3: after the upgrade, exactly the recorded state of port 587, whatever a package put back. (changed, what).
    2026-11-18: by what 587 uses (AUTH, the SASL backend and its socket, from master.cf or main.cf) and the login services as
    they were enabled: the recorded -o and units come back, never a choice of eFa-next; AUTH that was off stays off."""
    if not recorded:
        return False, 'nothing recorded before the upgrade'
    if not recorded['pam_on']:
        _write(PAM_OFF_FILE, 'off\n')
    _pam_keep()
    if 'effective' not in recorded:
        # A record of 6.0.0.6.5 (AUTH and the system accounts only): with AUTH as before, the backend of 587 stays as it is.
        if _submission_auth() == recorded['auth']:
            return False, f"AUTH {recorded['auth']} as before (the login service of 587 left as it is)"
        _sasl_apply(recorded['auth'] == 'yes', pam_on=recorded['pam_on'])
        return True, f"back to AUTH {recorded['auth']}, system accounts {'on' if recorded['pam_on'] else 'off'}"
    effective, overrides = _submission_effective()
    units = _submission_units()
    if effective == recorded['effective'] and units == recorded['units']:
        return False, f"AUTH {effective['smtpd_sasl_auth_enable']} with {effective['smtpd_sasl_type']} {effective['smtpd_sasl_path']}, as before"
    for key in _ru_lib().SUBMISSION_KEYS:
        if key in recorded['overrides']:
            subprocess.run(['postconf', '-P', f"submission/inet/{key}={recorded['overrides'][key]}"], check=True, capture_output=True)
        elif key in overrides:
            subprocess.run(['postconf', '-PX', f'submission/inet/{key}'], check=False, capture_output=True)
    platform_now = _platform()
    for unit, enabled in sorted(recorded['units'].items()):
        if _safe(lambda unit=unit: platform_now.service_exists(unit), True) and units.get(unit) != enabled:
            (platform_now.service_enable(unit, start=True) if enabled else platform_now.service_disable(unit, stop=True))
    platform_now.service_reload_if_active(platform_now.service('mta'))
    after = _submission_effective()[0]
    if after['smtpd_sasl_auth_enable'] != recorded['effective']['smtpd_sasl_auth_enable']:
        raise EfaError(f"port 587: AUTH is {after['smtpd_sasl_auth_enable']}, before the upgrade it was {recorded['effective']['smtpd_sasl_auth_enable']}")
    return True, (f"back as before: AUTH {after['smtpd_sasl_auth_enable']} with {after['smtpd_sasl_type']} {after['smtpd_sasl_path']}, "
                  + ', '.join(f"{unit} {'on' if on else 'off'}" for unit, on in sorted(recorded['units'].items())))


def sasl_apply(_args):
    """The login service of port 587 as the submitters and the PAM setting want it; run by the upgrade. It keeps the stored
    choice and never sets a default again (F3): with no login and the system accounts off, 587 stays without AUTH."""
    _pam_keep()
    pam_on = _pam_on()
    if not pam_on:
        _sasl_logins_write(_submitters())
    needed = pam_on or any(item['kind'] == 'auth' for item in _submitters())
    _sasl_apply(needed, pam_on=pam_on)
    return {'logins_on_587': needed, 'checked_by': ('Dovecot (system accounts, PAM)' if pam_on else 'efa-sasl') if needed else 'nobody: no AUTH on 587'}


def submission_pam_set(args):
    """Whether system accounts (PAM) may log in on port 587 too. Off: only the logins of the submitters."""
    on = _on_off(args.mode)
    if on and not _pam_on():
        raise EfaError('System accounts no longer log in on port 587: make a submitter with a login for each mail system (efactl submitter-set).')
    if os.path.exists(DOVECOT_AUTH):
        with open(DOVECOT_AUTH) as f:
            text = f.read()
        changed = pam_toggled(text, on)
        if changed != text:
            _write(DOVECOT_AUTH, changed)
    if not on:
        _write(PAM_OFF_FILE, 'off\n')
    _dovecot_logins_write(_submitters(), on)
    return {'system_accounts_on_587': _pam_on()}


def submitter_list(_args):
    """The submitters: internal systems that send through this server, each only for its own domains."""
    rows = [{key: value for key, value in item.items() if key != 'hash'} for item in _submitters()]
    if identity_now and identity_now['domains'] is not None:
        rows = [row for row in rows if set(row['domains']) <= set(identity_now['domains'])]
    return {'submitters': rows, 'limits': {**OUTBOUND_LIMIT_DEFAULTS, **_json_read(OUTBOUND_FILE, {}).get('limits', {})}}


def _submitter_domains(text, tenant, others):
    domains = sorted({item.strip().lower() for item in re.split(r'[\s,;]+', text or '') if item.strip()})
    if not domains:
        raise EfaError('Name at least one sender domain.')
    tenant_of = {domain: tenant_id for tenant_id, items in _tenant_domains().items() for domain in items}
    tenant_id = _tenant_id(tenant) if tenant else None
    own = _own_domains()
    for domain in domains:
        if not DOMAIN_RE.match(domain) or domain not in own:
            raise EfaError(f'{domain} is not a domain of this server.')
        if tenant_of.get(domain) != tenant_id:
            raise EfaError(f'{domain} belongs to {"another tenant" if tenant_of.get(domain) else "no tenant"}: name its tenant.')
        if identity_now and identity_now['domains'] is not None and domain not in identity_now['domains']:
            raise EfaError(f'Not allowed: {domain} is not one of your domains.')
        clash = [item['name'] for item in others if domain in item['domains'] and item.get('tenant') != tenant]
        if clash:
            raise EfaError(f'{domain} is bound to the submitter {clash[0]} of another tenant.')
    return domains


def submitter_set(args):
    """Adds or changes a submitter: by network, by login (SMTP-AUTH on port 587) or by its TLS client certificate."""
    name = args.name.strip().lower()
    if not SUBMITTER_NAME_RE.match(name):
        raise EfaError('Name: up to 32 small letters, digits or _.')
    kind, value = (args.kind or '').strip(), (args.value or '').strip()
    if kind not in SUBMITTER_KINDS:
        raise EfaError('Kind: ip, auth or cert.')
    submitters = _submitters()
    old = next((item for item in submitters if item['name'] == name), None)
    others = [item for item in submitters if item['name'] != name]
    tenant = (args.tenant or '').strip()
    item = {'name': name, 'tenant': tenant, 'kind': kind, 'domains': _submitter_domains(args.domains, tenant, others)}
    if kind == 'ip':
        try:
            net = ipaddress.ip_network(value, strict=False)
        except ValueError:
            raise EfaError('Value: a network such as 192.0.2.10/32 or 2001:db8::/64.')
        if net.prefixlen < (16 if net.version == 4 else 32):
            raise EfaError('Network: at most a /16 (IPv4) or /32 (IPv6).')
        item['value'] = str(net)
    elif kind == 'auth':
        value = value.lower()
        if not SUBMITTER_LOGIN_RE.match(value):
            raise EfaError('Value: the login, letters, digits and . _ @ -')
        first, second = _secrets(2, 'Password, then again')
        if first != second:
            raise EfaError(PASSWORD_DIFFER + ' Nothing was changed.')
        if not first and not (old and old['kind'] == 'auth' and old['value'] == value):
            raise EfaError('A new login needs a password.')
        if first and len(first) < 12:
            raise EfaError('Password: at least 12 characters.')
        item['value'] = value
        item['hash'] = login_hash(first, _pam_on()) if first else old['hash']
    else:
        value = value.upper()
        if not FINGERPRINT_RE.match(value):
            raise EfaError('Value: the SHA-256 fingerprint of the client certificate, 32 pairs such as AB:12:… (openssl x509 -fingerprint -sha256).')
        item['value'] = value
    if any(other['kind'] == kind and other['value'] == item['value'] for other in others):
        raise EfaError('Another submitter has this value already.')
    submitters = sorted(others + [item], key=lambda entry: entry['name'])
    _submitters_apply(submitters)
    _json_write(SUBMITTERS_FILE, {'submitters': submitters})
    os.chmod(SUBMITTERS_FILE, 0o600)
    result = submitter_list(None)
    if kind == 'auth' and _pam_on():
        result['notes'] = ['System accounts can log in on port 587 too. Recommended: efactl submission-pam-set --mode off, '
                           'then only the logins of the submitters count.']
    return result


def submitter_remove(args):
    """Removes a submitter: its mail is treated like any other client again."""
    _confirm(args)
    submitters = _submitters()
    if not any(item['name'] == args.name.strip().lower() for item in submitters):
        raise EfaError('No such submitter.')
    submitters = [item for item in submitters if item['name'] != args.name.strip().lower()]
    _submitters_apply(submitters)
    _json_write(SUBMITTERS_FILE, {'submitters': submitters})
    return submitter_list(None)


OUTBOUND_LIMIT_ACTIONS = ('off', 'log', 'throttle', 'hold', 'reject')


# Shown before the first change too, so the form has its current values on a fresh host.
OUTBOUND_LIMIT_DEFAULTS = {'recipients_hour': 500, 'domains_hour': 100, 'domain_recipients_hour': 0, 'tenant_recipients_hour': 0, 'action': 'off',
                           'auto_hold': False}
# A1: written by efa-outbound, the accounts it holds; their release goes back through the settings of the milter.
HELD_SENDERS = '/var/lib/efa-outbound/held-senders.json'


def outbound_limits_set(args):
    """Limits per sender and hour against taken over accounts: recipients and target domains of outgoing mail."""
    state = _json_read(OUTBOUND_FILE, {})
    limits = {**OUTBOUND_LIMIT_DEFAULTS, **state.get('limits', {})}
    for key in ('recipients_hour', 'domains_hour', 'domain_recipients_hour', 'tenant_recipients_hour'):
        value = (getattr(args, key, '') or '').strip()
        if value:
            if not value.isdigit() or not 0 <= int(value) <= 100000:
                raise EfaError('Limits: a number from 0 (no limit) to 100000.')
            limits[key] = int(value)
    hold = (getattr(args, 'auto_hold', '') or '').strip()
    if hold:
        limits['auto_hold'] = _on_off(hold)
    action = (args.action or '').strip()
    if action:
        if action not in OUTBOUND_LIMIT_ACTIONS:
            raise EfaError('Action: off, log, throttle, hold or reject.')
        limits['action'] = action
    state['limits'] = limits
    _outbound_write(state)
    return submitter_list(None)



def hijack_list(_args):
    """A1: the accounts the outbound check holds as possibly taken over, since when and why."""
    held = _json_read(HELD_SENDERS, {})
    released = _json_read(OUTBOUND_FILE, {}).get('released', {})
    return {'held': [{'who': who, 'since': time.strftime('%Y-%m-%d %H:%M', time.localtime(item['since'])), 'reason': item['reason']}
                     for who, item in sorted(held.items()) if float(released.get(who, 0)) < item['since']],
            'auto_hold': {**OUTBOUND_LIMIT_DEFAULTS, **_json_read(OUTBOUND_FILE, {}).get('limits', {})}['auto_hold']}


def hijack_release(args):
    """A1: lets a held account send again (after the password was changed); its held mail stays in the queue for a decision."""
    who = (args.who or '').strip()
    if who not in _json_read(HELD_SENDERS, {}):
        raise EfaError('This account is not held.')
    state = _json_read(OUTBOUND_FILE, {})
    state.setdefault('released', {})[who] = time.time()
    _outbound_write(state)
    _audit(f'held account {who} released by {_dmarc_who()}')
    return {**hijack_list(None), 'note': 'Its held mail waits in the queue (Mail queue, Held): release or delete it there.'}

def relay_networks_discard(_args):
    """Drops the waiting changes."""
    state = _json_read(RELAY_FILE, {})
    state.pop('draft', None)
    _json_write(RELAY_FILE, state)
    return {'discarded': True}


def _sender_type(entry):
    if '*' in entry:
        return 'pattern'
    try:
        ipaddress.ip_network(entry)
        return 'IP'
    except ValueError:
        return 'address' if '@' in entry else 'domain' if DOMAIN_RE.match(entry) else 'pattern'


def _sender_is_map_entry(entry):
    return bool(SENDER_RE.match(entry) or DOMAIN_RE.match(entry))


def _sender_rules():
    return [line.split('|') for line in _read_lines(SENDER_RULES) if line.count('|') == 2]


def _sender_rows(meta, which, entries):
    return [{'entry': entry, 'type': _sender_type(entry), 'comment': meta.get(entry, {}).get('comment', ''),
             'added': meta.get(entry, {}).get('added', '')} for entry in entries]


# MIG-ALLOW (owner, 2026-11-11: "A: Immer, überall"): an allowed address or domain always gets past the checks of Postfix that
# could reject it (RBL, HELO, DNS of the sender): OK right after permit_mynetworks/permit_sasl_authenticated in the client,
# helo, sender and data lists. Never before the relay check: in the recipient and relay lists only after
# reject_unauth_destination. A sender can be faked: each pass is logged (WARN efa-allow) and goes to the audit log. Postscreen
# and the TLS policy stay; a virus of an allowed sender is cut out by efa-cdr (the mail goes on), see EFA_AV_REJECT.
ALLOW_MAP = ETC + '/postfix/efa-sender-allow'
ALLOW_LOG_MAP = ETC + '/postfix/efa-sender-allow-log'
ALLOW_BEFORE_LISTS = ('smtpd_client_restrictions', 'smtpd_helo_restrictions', 'smtpd_sender_restrictions', 'smtpd_data_restrictions')
ALLOW_AFTER_LISTS = ('smtpd_recipient_restrictions', 'smtpd_relay_restrictions')
ALLOW_LEADING = ('permit_mynetworks', 'permit_sasl_authenticated')
# 6.0.0.6 first version: allowed entries marked "skip the sender domain check" had their own table; it goes on the update.
SKIP_DOMAINCHECK_MAP = ETC + '/postfix/efa-sender-skip-domaincheck'
ALLOW_TABLES = ('efa-sender-allow', 'efa-sender-allow-log', 'efa-sender-skip-domaincheck')
# Restrictions that take one argument: a table, a list server or a service.
RESTRICTION_WITH_ARGUMENT = ('check_', 'reject_rbl_client', 'reject_rhsbl_', 'permit_dnswl_client', 'permit_rhswl_client', 'reject_dnsbl')


def restriction_items(value):
    """The items of a Postfix restriction list; a restriction keeps its argument ("check_sender_access <type>:/x",
    "reject_rbl_client zen.spamhaus.org")."""
    items = []
    for word in (word for word in re.split(r'[\s,]+', value or '') if word):
        if items and ' ' not in items[-1] and items[-1].startswith(RESTRICTION_WITH_ARGUMENT) and ('.' in word or ':' in word or '/' in word):
            items[-1] += ' ' + word
        else:
            items.append(word)
    return items


def _ru_item(item):
    """The lookup of the maintenance map of the release upgrade (new mail gets 421)."""
    return item.startswith('check_client_access ') and item.endswith('/efa-release-upgrade.cidr')


def maintenance_first(items):
    """S36: the maintenance map always first. Behind an OK of the allow list (an allowed sender) the 421 was never reached:
    a package update during the upgrade put the allow lookups before it, and mail was taken during maintenance."""
    return [item for item in items if _ru_item(item)] + [item for item in items if not _ru_item(item)]


def maintenance_removed(value):
    """The restriction list without the maintenance map, the rest in its order."""
    return ', '.join(item for item in restriction_items(value) if not _ru_item(item))


def _allow_item(item):
    return item.startswith('check_sender_access ') and item.rsplit('/', 1)[-1] in ALLOW_TABLES


def allow_lists(values, ref, log_ref, wanted):
    """{list: value}: the lookups of the allow tables where they belong, every older one (also of the first version) out.
    The first list that gets the lookup logs each pass (WARN) once."""
    found, logged = {}, False
    for name in ALLOW_BEFORE_LISTS + ALLOW_AFTER_LISTS:
        items = [item for item in restriction_items(values.get(name, '')) if not _allow_item(item)]
        # S36: a list that holds only the maintenance map counts as empty: the heal during the upgrade places what it placed before.
        if wanted and [item for item in items if not _ru_item(item)]:
            if name in ALLOW_BEFORE_LISTS:
                at = 0
                while at < len(items) and (items[at] in ALLOW_LEADING or _ru_item(items[at])):
                    at += 1
                insert = ([f'check_sender_access {log_ref}'] if not logged else []) + [f'check_sender_access {ref}']
                items[at:at] = insert
                logged = True
            elif 'reject_unauth_destination' in items:
                # Never before the relay check: an allowed sender must not turn this server into an open relay.
                at = items.index('reject_unauth_destination') + 1
                items[at:at] = [f'check_sender_access {ref}']
        found[name] = ', '.join(maintenance_first(items))
    return found


def _allow_entries():
    return sorted(entry for entry in _read_lines(SENDER_MAPS['allow']) if _sender_is_map_entry(entry))


def _allow_postfix_apply():
    """The allow tables of Postfix from the allow list and their place in the restriction lists; no entry: neither."""
    entries = _allow_entries()
    if entries:
        _map_write(ALLOW_MAP, [f'{entry} OK' for entry in entries])
        _map_write(ALLOW_LOG_MAP, [f'{entry} WARN efa-allow {entry}' for entry in entries])
    names = ALLOW_BEFORE_LISTS + ALLOW_AFTER_LISTS
    now = {name: _postconf(name) or '' for name in names}
    wanted = allow_lists(now, _map(ALLOW_MAP), _map(ALLOW_LOG_MAP), bool(entries))
    changed = [name for name in names if restriction_items(wanted[name]) != restriction_items(now[name])]
    for name in changed:
        _postconf_set(name, wanted[name]) if wanted[name] else _postconf_remove([name])
    for path in ([] if entries else _map_files(ALLOW_MAP) + _map_files(ALLOW_LOG_MAP)) + _map_files(SKIP_DOMAINCHECK_MAP):
        if os.path.exists(path):
            os.remove(path)
    if changed:
        _platform().service_reload_if_active('postfix')
    return entries


def sender_skip_heal(_args):
    """The update: a table efa-sender-skip-domaincheck (made by hand, or of the first version) becomes allow entries (audited);
    the allow tables of Postfix as eFa-next places them, the old table goes."""
    meta = _json_read(SENDER_META, {})
    by_hand = [line.split()[0].lower() for line in _read_lines(SKIP_DOMAINCHECK_MAP) if line.split()[1:2] == ['OK']] \
        if os.path.exists(SKIP_DOMAINCHECK_MAP) else []
    allow = _read_lines(SENDER_MAPS['allow'])
    taken = [entry for entry in by_hand if _sender_is_map_entry(entry) and entry not in allow]
    if taken:
        _write(SENDER_MAPS['allow'], ''.join(item + '\n' for item in allow + taken))
        for entry in taken:
            meta[entry] = meta.get(entry, {'comment': 'taken over from ' + SKIP_DOMAINCHECK_MAP, 'added': _today().isoformat()})
        _reload_rspamd()
    for entry in meta.values():
        entry.pop('skip_domain_check', None)
    _json_write(SENDER_META, meta)
    old_table = os.path.exists(SKIP_DOMAINCHECK_MAP)
    entries = _allow_postfix_apply()
    if taken or old_table:
        _audit(f'allow list: the table {SKIP_DOMAINCHECK_MAP} went' + (f', its entries {", ".join(taken)} are on the allow list' if taken else '')
               + '; every allowed sender passes the checks of Postfix')
    return {'allow_entries': entries, 'taken_over': taken}


ALLOW_PASS_RE = re.compile(r'from ([^\s\[]*)\[([0-9a-fA-F.:]+)\]: .*?WARN action: efa-allow (\S+); from=<([^>]*)> to=<([^>]*)>')
CDR_VIRUS_RE = re.compile(r'virus (removed|held) from=<([^>]*)> to=(\S+) found=(\S+) parts=(\S*) original=(\S+)')
ALLOW_AUDIT_STATE = '/var/lib/eFa/allow-audit.json'


def allow_audit_lines(lines):
    """Audit texts of the journal lines of Postfix and efa-cdr: each pass of an allowed sender, each virus cut out or held."""
    found = []
    for line in lines:
        passed = ALLOW_PASS_RE.search(line)
        if passed:
            host, ip, entry, sender, rcpt = passed.groups()
            found.append(f'allow list: {entry} let {sender or "<>"} from {ip} ({host or "unknown"}) to {rcpt} past the RBL, HELO and DNS '
                         'checks of Postfix')
            continue
        virus = CDR_VIRUS_RE.search(line)
        if virus:
            how, sender, rcpts, name, parts, key = virus.groups()
            found.append(f'allow list: virus {name} of {sender} to {rcpts} ' + (f'cut out ({parts}), the mail went on' if how == 'removed'
                         else 'could not be cut out, the mail is held') + f'; the original is kept ({key})')
    return found


def _allow_audit_collect():
    """Every minute (events-run): the passes of allowed senders and the viruses cut out, into the audit log."""
    state = _json_read(ALLOW_AUDIT_STATE, {})
    lines = _journal_since(state, ('postfix', 'efa-cdr'), 'efa-allow|virus (removed|held)')
    for text in allow_audit_lines(lines)[:500]:
        _audit(text)
    _json_write(ALLOW_AUDIT_STATE, state)


def sender_list(_args):
    """All sender entries with type, comment and date. The date is empty for entries older than this feature."""
    meta = _json_read(SENDER_META, {})
    rules = [{**_sender_rows(meta, 'rules', [sender])[0], 'list': which, 'recipient': recipient}
             for which, sender, recipient in _sender_rules()]
    return {'allow': _sender_rows(meta, 'allow', _read_lines(SENDER_MAPS['allow'])),
            'block': _sender_rows(meta, 'block', _read_lines(SENDER_MAPS['block'])), 'rules': rules}


def sender_add(args):
    """Adds addresses and domains to a list, IPs and patterns as rules. Entries already there are reported."""
    which, comment = args.list.strip(), (args.comment or '').strip()
    if which not in SENDER_MAPS:
        raise EfaError("List must be 'allow' or 'block'.")
    if len(comment) > 200 or '\n' in comment:
        raise EfaError('Comment: one line, up to 200 characters.')
    items = [item.lower() for item in args.entries.replace(',', ' ').split()]
    if not items:
        raise EfaError('Enter at least one sender.')
    for item in items:
        if not _sender_is_map_entry(item) and (not RULE_FROM_RE.match(item) or item.strip('*') == ''):
            raise EfaError(f'Invalid sender, nothing was added: {item}')
    entries = _read_lines(SENDER_MAPS[which])
    rules = _read_lines(SENDER_RULES)
    meta = _json_read(SENDER_META, {})
    added, skipped = [], []
    for item in items:
        target, line = (entries, item) if _sender_is_map_entry(item) else (rules, f'{which}|{item}|default')
        if line in target:
            skipped.append(item)
            continue
        target.append(line)
        added.append(item)
        meta[item] = {'comment': comment, 'added': _today().isoformat()}
    _write(SENDER_MAPS[which], ''.join(e + '\n' for e in entries))
    _write(SENDER_RULES, ''.join(e + '\n' for e in rules))
    _json_write(SENDER_META, meta)
    _reload_rspamd()
    if which == 'allow':
        _allow_postfix_apply()
    return {'added': added, 'skipped': skipped}


def sender_remove(args):
    """Removes entries from every list and rule that holds them."""
    _confirm(args)
    items = [item.lower() for item in args.entries.replace(',', ' ').split()]
    known = sender_list(args)
    present = {row['entry'] for name in ('allow', 'block', 'rules') for row in known[name]}
    missing = [item for item in items if item not in present]
    if not items or missing:
        raise EfaError(f'Not in the lists, nothing was removed: {" ".join(missing)}')
    for which in SENDER_MAPS:
        _write(SENDER_MAPS[which], ''.join(e + '\n' for e in _read_lines(SENDER_MAPS[which]) if e not in items))
    _write(SENDER_RULES, ''.join(e + '\n' for e in _read_lines(SENDER_RULES)
                                 if e.count('|') != 2 or e.split('|')[1] not in items))
    meta = _json_read(SENDER_META, {})
    for item in items:
        meta.pop(item, None)
    _json_write(SENDER_META, meta)
    _reload_rspamd()
    _allow_postfix_apply()
    return {'removed': items}


def sender_move(args):
    """Moves one entry to the other list and keeps its comment."""
    entry, target = args.entry.strip().lower(), args.to.strip()
    if target not in SENDER_MAPS:
        raise EfaError("Target must be 'allow' or 'block'.")
    other = 'block' if target == 'allow' else 'allow'
    entries = _read_lines(SENDER_MAPS[other])
    if entry in entries:
        entries.remove(entry)
        _write(SENDER_MAPS[other], ''.join(e + '\n' for e in entries))
        wanted = _read_lines(SENDER_MAPS[target])
        if entry not in wanted:
            wanted.append(entry)
        _write(SENDER_MAPS[target], ''.join(e + '\n' for e in wanted))
    else:
        rules = _read_lines(SENDER_RULES)
        changed = [f'{target}|{entry}|{line.split("|")[2]}' if line.startswith(f'{other}|{entry}|') else line for line in rules]
        if changed == rules:
            raise EfaError(f'{entry} is not in the {other} list.')
        _write(SENDER_RULES, ''.join(e + '\n' for e in changed))
    _reload_rspamd()
    _allow_postfix_apply()
    return {'moved': entry, 'to': target}


# 6.0.0.6: allow or block the sender of one mail from the mail log, the live log or the quarantine. Writes only through
# sender-add, sender-rule-set, sender-list-set and blocklist-entry; global entries and IP addresses only for super admins,
# the others get a rule for one of their own recipient domains.
# One text per list, so a translation names the list in its own words.
def _sender_list_text(which):
    return _text('the global allow list') if which == 'allow' else _text('the global block list')


def _sender_rule_text(which, domain):
    return _text('a rule of the allow list for mail to {domain}', domain=domain) if which == 'allow' else         _text('a rule of the block list for mail to {domain}', domain=domain)


def _sender_action_value(value):
    try:
        return 'ip', ipaddress.ip_address(value)
    except ValueError:
        pass
    if SENDER_RE.match(value):
        return 'address', None
    if DOMAIN_RE.match(value):
        return 'domain', None
    raise EfaError('Sender: an address, a domain or an IP address.')


def _sender_action_plan(args, identity, undo=False):
    """The entry, where it goes and what to confirm. Refuses what the caller may not do, and an add of an entry already
    there (undo: of one not there)."""
    value, which = (args.value or '').strip().lower(), (args.list or '').strip()
    if which not in SENDER_MAPS:
        raise EfaError("List must be 'allow' or 'block'.")
    kind, ip = _sender_action_value(value)
    qid = (getattr(args, 'qid', '') or '').strip()
    if qid and not QUEUE_ID_RE.match(qid):
        raise EfaError('Invalid queue ID.')
    other = 'block' if which == 'allow' else 'allow'
    super_admin = identity is None or identity.get('role') == 'super'
    rules = [tuple(rule) for rule in _sender_rules()]
    plan = {'entry': value, 'kind': kind, 'list': which, 'qid': qid, 'warnings': []}
    if not super_admin:
        if kind == 'ip':
            raise EfaError('IP addresses: only super admins.')
        if identity['domains'] is None:
            raise EfaError('Global entries: only super admins.')
        wanted = [item.rsplit('@', 1)[1].lower() for item in re.split(r'[\s,;<>]+', getattr(args, 'recipients', '') or '') if '@' in item]
        own = [domain for domain in wanted if domain in identity['domains']]
        if not own:
            raise EfaError('Only for mail to your own domains.')
        plan.update(target='rule', recipient=own[0], already=(which, value, own[0]) in rules,
                    target_text=_sender_rule_text(which, own[0]))
        scopes = ('default', own[0])
    elif kind == 'ip' and which == 'block':
        lib = _lib('efa_blocklist')
        state = _blocklist_state()
        names = sorted(name for name, entry in state['lists'].items()
                       if entry.get('kind', 'feed' if name in lib.FEEDS else 'own') == 'own' and entry.get('enabled'))
        if not names:
            raise EfaError('No own IP blocklist is on: add one under IP blocklists first.')
        until = state['entries'].get(names[0], {}).get(str(ipaddress.ip_network(value)))
        plan.update(target='ip', ip_list=names[0], already=until is not None and (until == 0 or until > time.time()),
                    target_text=_text('the IP blocklist {name} (firewall, for good)', name=names[0]))
        scopes = ('default',)
    else:
        already = (which, value, 'default') in rules if kind == 'ip' else value in _read_lines(SENDER_MAPS[which])
        plan.update(target='list', already=already, target_text=_sender_list_text(which))
        scopes = ('default',)
    if undo:
        if not plan['already']:
            raise EfaError(f'{value} is not there, nothing to undo.')
        return plan
    if plan['already']:
        raise EfaError(f'{value} is there already, nothing changed.')
    # Clashes: the same sender, or the domain of the address, on the other side.
    for name in [value] + ([value.rsplit('@', 1)[1]] if kind == 'address' else []):
        if name in _read_lines(SENDER_MAPS[other]) or any(rule[:2] == (other, name) and rule[2] in scopes for rule in rules):
            plan['warnings'].append(_text('{entry} is on the allow list: the new entry clashes with it.', entry=name) if other == 'allow'
                                    else _text('{entry} is on the block list: the new entry clashes with it.', entry=name))
    if kind != 'ip':
        domain = value.rsplit('@', 1)[-1]
        mine = [own for own in _local_domains() if domain == own or domain.endswith('.' + own)]
        if mine:
            plan['warnings'].append(_text('{domain} is an own domain of this server: a faked sender of it would get the same treatment.', domain=mine[0]))
        return plan
    if not ip.is_global:
        plan['warnings'].append(_text('{ip} is a private or reserved address, not a server on the internet.', ip=value))
    if any(ipaddress.ip_network(value).overlaps(net) for net in _blocklist_allow()):
        if which == 'block':
            raise EfaError(f'Never blocked, this is a relay network, an allowed admin, a cluster node or an own address: {value}')
        plan['warnings'].append(_text('{ip} is a relay network, an allowed admin, a cluster node or an own address.', ip=value))
    return plan


def sender_action_check(args):
    """What Allow or Block for this sender would do, before it is done: the entry, the list and the warnings."""
    plan = _sender_action_plan(args, identity_now)
    return {key: plan[key] for key in ('entry', 'kind', 'list', 'target_text', 'warnings')}


def sender_action(args):
    """Allow or block the sender, the domain or the IP of one mail. Warnings need confirm=yes; action remove is the undo."""
    action = (args.action or 'add').strip()
    if action not in ('add', 'remove'):
        raise EfaError("Action must be 'add' or 'remove'.")
    scope = (getattr(args, 'scope', '') or '').strip()
    if os.environ.get('EFA_CLUSTER_REPLAY') and scope:
        # A node runs what the master decided, without the login of the admin: the target comes from the master.
        plan = _sender_action_replayed(args, scope)
    else:
        plan = _sender_action_plan(args, identity_now, undo=action == 'remove')
        if plan['warnings'] and (args.confirm or '').strip() != 'yes':
            raise EfaError('Confirm first: ' + ' '.join(plan['warnings']))
        # Handed to the nodes with the journal of the cluster (cluster_entries reads the arguments after the run).
        args.scope = {'rule': f'rule:{plan.get("recipient")}', 'ip': f'ip:{plan.get("ip_list")}'}.get(plan['target'], 'list')
    ns, value, which = argparse.Namespace, plan['entry'], plan['list']
    if plan['target'] == 'rule':
        sender_rule_set(ns(list=which, action=action, sender=value, recipient=plan['recipient']))
    elif plan['target'] == 'ip':
        blocklist_entry(ns(name=plan['ip_list'], action=action, addresses=value, hours=''))
    elif action == 'add':
        before = _json_read(SENDER_META, {}).get(value)
        sender_add(ns(list=which, entries=value, comment=f'mail log, queue ID {plan["qid"]}' if plan['qid'] else 'mail log'))
        if before:
            # sender-add writes a new comment; the undo puts the one of the entry on the other list back.
            meta = _json_read(SENDER_META, {})
            meta[value] = {**meta.get(value, {}), 'previous': before}
            _json_write(SENDER_META, meta)
    else:
        if plan['kind'] == 'ip':
            sender_rule_set(ns(list=which, action='remove', sender=value, recipient=''))
        else:
            sender_list_set(ns(list=which, action='remove', address=value))
        meta = _json_read(SENDER_META, {})
        if value in meta:
            previous = meta.pop(value).get('previous')
            if previous:
                meta[value] = previous
            _json_write(SENDER_META, meta)
    done = 'added to' if action == 'add' else 'taken out of (undo)'
    _audit(f'sender action by {_dmarc_who()}: {value} {done} {plan["target_text"]}' + (f', source queue ID {plan["qid"]}' if plan['qid'] else '')
           + (', confirmed: ' + ' '.join(plan['warnings']) if plan['warnings'] else ''))
    return {'action': action, 'entry': value, 'list': which, 'target_text': plan['target_text'], 'qid': plan['qid'],
            'recipients': getattr(args, 'recipients', '') or ''}


def _sender_action_replayed(args, scope):
    """The plan on a node of the cluster from the target the master chose. Each write there is safe to run twice."""
    value, which = (args.value or '').strip().lower(), (args.list or '').strip()
    if which not in SENDER_MAPS:
        raise EfaError("List must be 'allow' or 'block'.")
    kind = _sender_action_value(value)[0]
    kind_of_scope, _, name = scope.partition(':')
    plan = {'entry': value, 'kind': kind, 'list': which, 'qid': (getattr(args, 'qid', '') or '').strip(), 'warnings': [], 'target': kind_of_scope}
    if kind_of_scope == 'rule' and (SENDER_RE.match(name) or DOMAIN_RE.match(name)):
        plan.update(recipient=name, target_text=_sender_rule_text(which, name))
    elif kind_of_scope == 'ip' and kind == 'ip' and name:
        plan.update(ip_list=name, target_text=_text('the IP blocklist {name} (firewall, for good)', name=name))
    elif scope == 'list':
        plan['target_text'] = _sender_list_text(which)
    else:
        raise EfaError(f'Unknown target from the master: {scope}')
    return plan


def smarthost_set(args):
    """Outbound smarthost, for example [mail.example.org]:587; empty sends directly."""
    host = args.host.strip()
    if host and not SMARTHOST_RE.match(host):
        raise EfaError('Invalid smarthost.')
    _postconf_set('relayhost', host)
    return {'smarthost': host}


def message_size_set(args):
    """Largest accepted message in MB."""
    try:
        size = int(args.megabytes)
    except ValueError:
        raise EfaError('Size must be a number.')
    if not 1 <= size <= 1024:
        raise EfaError('Size must be 1 to 1024 MB.')
    _postconf_set('message_size_limit', str(size * 1024 * 1024))
    return {'message_size_limit_mb': size}


def spam_scores_set(args):
    """Scores for greylisting, spam marking and rejecting; each must be higher than the one before."""
    try:
        values = [float(args.greylist), float(args.mark), float(args.reject)]
    except ValueError:
        raise EfaError('Scores must be numbers.')
    if not 0 < values[0] < values[1] < values[2]:
        raise EfaError('Scores must rise: greylist < mark < reject.')
    _write(ACTIONS_CONF, f'greylist = {values[0]:g};\nrewrite_subject = {values[1]:g};\nreject = {values[2]:g};\n'
                         'subject = "{Spam?} %s";\n' + ACTION_DISCARD)
    _reload_rspamd()
    return {'spam_scores': _actions()}


GREYLIST_CHOICES = {'minutes': (1, 2, 5, 10, 15), 'days': (1, 3, 7)}


def greylist_values(text):
    """Delay in minutes and expiry in days as set in greylist.conf; the defaults of rspamd (5 minutes, 1 day) when missing."""
    minutes = re.search(r'^timeout\s*=\s*(\d+)min;', text, re.M)
    days = re.search(r'^expire\s*=\s*(\d+)d;', text, re.M)
    return int(minutes.group(1)) if minutes else 5, int(days.group(1)) if days else 1


def greylisting_set(args):
    """Turn rspamd greylisting on or off; 9j: how long a new sender waits and how long a sender that came back is known."""
    enabled = _on_off(args.mode)
    minutes, days = greylist_values(open(GREYLIST_CONF).read() if os.path.exists(GREYLIST_CONF) else '')
    for key, current in (('minutes', minutes), ('days', days)):
        value = (getattr(args, key, '') or '').strip()
        if value and (not value.isdigit() or int(value) not in GREYLIST_CHOICES[key]):
            raise EfaError(f'{key}: one of ' + ', '.join(map(str, GREYLIST_CHOICES[key])))
    minutes = int((getattr(args, 'minutes', '') or '').strip() or minutes)
    days = int((getattr(args, 'days', '') or '').strip() or days)
    _greylist_conf_write(enabled, minutes, days)
    _reload_rspamd()
    return {'greylisting': enabled, 'minutes': minutes, 'days': days}


def _greylist_conf_write(enabled, minutes, days):
    if not os.path.exists(GREYLIST_IP_MAP):
        _write(GREYLIST_IP_MAP, '')
    _write(GREYLIST_CONF, f'enabled = {"true" if enabled else "false"};\ntimeout = {minutes}min;\nexpire = {days}d;\n'
                          f'whitelisted_ip = "file://{GREYLIST_IP_MAP}";\n')


def _greylist_exception(value):
    """('ip', '192.0.2.0/24') or ('domain', 'example.org'). A network wider than /16 (IPv4) or /32 (IPv6) is refused: an exception
    that big would switch greylisting off for a good part of the internet."""
    value = (value or '').strip().lower().rstrip('.')
    try:
        net = ipaddress.ip_network(value, strict=False)
    except ValueError:
        if DOMAIN_RE.match(value) and len(value) <= 253:
            return 'domain', value
        raise EfaError('An IP address, a network such as 192.0.2.0/24, or the domain of a sending server such as example.org.')
    if net.prefixlen < (16 if net.version == 4 else 32):
        raise EfaError('That network is too wide: at most /16 for IPv4 and /32 for IPv6.')
    return 'ip', str(net) if net.num_addresses > 1 else str(net.network_address)


def greylisting_status(_args):
    """Greylisting with its own exceptions."""
    minutes, days = greylist_values(open(GREYLIST_CONF).read() if os.path.exists(GREYLIST_CONF) else '')
    return {'greylisting': 'enabled = false;' not in _read_lines(GREYLIST_CONF), 'minutes': minutes, 'days': days,
            'exceptions_ip': [line for line in _read_lines(GREYLIST_IP_MAP) if not line.startswith('#')],
            'exceptions_domain': [line for line in _read_lines(GREYLIST_DOMAIN_MAP) if not line.startswith('#')],
            'note': 'Exceptions never wait. A domain matches the name of the sending server (its reverse DNS name), not the sender address.'}


def greylisting_exception_set(args):
    """G7-2: add or remove a network or the domain of sending servers that greylisting never delays."""
    action = (args.action or '').strip()
    if action not in ('add', 'remove'):
        raise EfaError("Action 'add' or 'remove'.")
    kind, value = _greylist_exception(args.value)
    path = GREYLIST_IP_MAP if kind == 'ip' else GREYLIST_DOMAIN_MAP
    entries = _read_lines(path)
    if action == 'add' and value not in entries:
        if len([line for line in entries if not line.startswith('#')]) >= GREYLIST_EXCEPTIONS_MAX:
            raise EfaError(f'At most {GREYLIST_EXCEPTIONS_MAX} exceptions of a kind.')
        entries.append(value)
    elif action == 'remove':
        entries = [line for line in entries if line != value]
    _write(path, ''.join(line + '\n' for line in entries))
    current = greylisting_status(None)
    if 'whitelisted_ip' not in ''.join(_read_lines(GREYLIST_CONF)):
        _greylist_conf_write(current['greylisting'], current['minutes'], current['days'])
    _reload_rspamd()
    _audit(f'greylisting exception {kind} {value} {action} by {_dmarc_who()}')
    return greylisting_status(None)


def sender_list_set(args):
    """Add or remove a sender. Allow only lowers the score; DMARC and virus checks still apply."""
    which, action, address = args.list.strip(), args.action.strip(), args.address.strip().lower()
    if which not in SENDER_MAPS or action not in ('add', 'remove'):
        raise EfaError("List must be 'allow' or 'block', action 'add' or 'remove'.")
    if not SENDER_RE.match(address) and not DOMAIN_RE.match(address):
        raise EfaError('Invalid sender address or domain.')
    entries = _read_lines(SENDER_MAPS[which])
    if action == 'add' and address not in entries:
        entries.append(address)
    elif action == 'remove' and address in entries:
        entries.remove(address)
    _write(SENDER_MAPS[which], ''.join(e + '\n' for e in entries))
    _reload_rspamd()
    if which == 'allow':
        _allow_postfix_apply()
    return {f'sender_{which}': entries}


def _read_transports():
    entries = {}
    for line in _read_lines(TRANSPORT):
        match = re.match(r'^(\S+)\s+smtp:\[?([^\]\s]+)\]?(:\d+)?$', line)
        if match:
            entries[match.group(1)] = match.group(2) + (match.group(3) or '')
    return entries


def sender_rule_set(args):
    """Rules beyond the lists: IP addresses, patterns with *, or only for one recipient or domain. A word without . @ : matches anywhere."""
    which, action = args.list.strip(), args.action.strip()
    sender, recipient = args.sender.strip().lower(), (args.recipient.strip().lower() or 'default')
    if which not in SENDER_MAPS or action not in ('add', 'remove'):
        raise EfaError("List must be 'allow' or 'block', action 'add' or 'remove'.")
    if not RULE_FROM_RE.match(sender) or sender.strip('*') == '':
        raise EfaError('Invalid sender, IP address or pattern.')
    if recipient != 'default' and not SENDER_RE.match(recipient) and not DOMAIN_RE.match(recipient):
        raise EfaError('Recipient must be an address, a domain or empty.')
    line = f'{which}|{sender}|{recipient}'
    entries = [e for e in _read_lines(SENDER_RULES) if e != line]
    if action == 'add':
        entries.append(line)
    _write(SENDER_RULES, ''.join(e + '\n' for e in entries))
    _reload_rspamd()
    return {'sender_rules': entries}


def transport_set(args):
    """Inbound mail route: which internal server receives mail for a domain."""
    domain, action, dest = args.domain.strip().lower(), args.action.strip(), args.destination.strip()
    if not DOMAIN_RE.match(domain):
        raise EfaError('Invalid domain.')
    if action not in ('add', 'remove'):
        raise EfaError("Action must be 'add' or 'remove'.")
    if action == 'add' and not HOST_RE.match(dest):
        raise EfaError('Invalid destination host.')
    backup = open(TRANSPORT).read() if os.path.exists(TRANSPORT) else ''
    lines = [line for line in backup.splitlines() if line.split()[:1] != [domain]]
    if action == 'add':
        host, _, port = dest.partition(':')
        lines.append(f'{domain}  smtp:[{host}]' + (f':{port}' if port else ''))
    _write(TRANSPORT, '\n'.join(lines) + '\n')
    try:
        subprocess.run(['postmap', _map(TRANSPORT)], check=True, capture_output=True)
    except subprocess.CalledProcessError:
        _write(TRANSPORT, backup)
        subprocess.run(['postmap', _map(TRANSPORT)], check=False, capture_output=True)
        raise EfaError('postmap failed, nothing changed.')
    subprocess.run(['systemctl', 'reload', 'postfix'], check=False, capture_output=True)
    if os.path.exists(ARCHIVE_FILE):
        _archive_apply(_json_read(ARCHIVE_FILE, {'targets': []})['targets'])
    if os.path.exists(OUTBOUND_FILE):
        _write(OUTBOUND_FILE, json.dumps({**_json_read(OUTBOUND_FILE, {}), 'local_domains': _local_domains()}, indent=1))
    _bec_refresh()
    return {'transports': _read_transports()}


def _admin_email():
    for line in _read_lines(EFA_CONFIG):
        if line.startswith('ADMINEMAIL:'):
            return line.split(':', 1)[1]
    return ''


def admin_email_set(args):
    """Address for system alerts; root mail goes there too."""
    email = args.email.strip().lower()
    if not SENDER_RE.match(email):
        raise EfaError('Invalid email address.')
    lines = [line for line in _read_lines(EFA_CONFIG) if not line.startswith('ADMINEMAIL:')]
    _write(EFA_CONFIG, '\n'.join(lines + [f'ADMINEMAIL:{email}']) + '\n')
    if os.path.exists(OUTBOUND_FILE):
        _write(OUTBOUND_FILE, json.dumps({**_json_read(OUTBOUND_FILE, {}), 'admin': email}, indent=1))
    # Keep the raw lines: alias continuation lines depend on their leading whitespace.
    with open(ALIASES) as f:
        aliases = [line for line in f if not line.startswith('root:')]
    _write(ALIASES, ''.join(aliases) + f'root: {email}\n')
    subprocess.run(['newaliases'], check=True, capture_output=True)
    return {'admin_email': email}


def recipient_verification_set(args):
    """Ask the internal mail server if a recipient exists before accepting mail."""
    enabled = _on_off(args.mode)
    items = [i.strip() for i in _postconf('smtpd_recipient_restrictions').split(',') if i.strip()]
    items = [i for i in items if i != 'reject_unverified_recipient']
    if enabled:
        items.append('reject_unverified_recipient')
        _postconf_set('unverified_recipient_reject_reason', 'No user at this address')
        _postconf_set('unverified_recipient_reject_code', '550')
    _postconf_set('smtpd_recipient_restrictions', ', '.join(items))
    return {'recipient_verification': enabled}


# CVE-2026-109786: the sshd filter of fail2ban up to 1.1.0 takes the address out of a crafted user name ("x 192.0.2.1 on" bans
# 192.0.2.1). The upstream fix (fail2ban commit ddd879d) as a .local, read after sshd.conf. Only a file eFa-next wrote is
# changed or removed; an own sshd.local of the admin stays.
FAIL2BAN_SSHD_FIX = ETC + '/fail2ban/filter.d/sshd.local'
FAIL2BAN_SSHD_FIX_MARK = '# Written by efactl: fail2ban CVE-2026-109786 (upstream commit ddd879d). Do not edit.\n'
FAIL2BAN_SSHD_FIX_TEXT = (FAIL2BAN_SSHD_FIX_MARK + '[DEFAULT]\n__on_port_opt = (?: port \\d+)?\n'
                          '__suff = %(__on_port_opt)s(?: \\[preauth\\])?\\s*\n')


def _fail2ban_sshd_fix(on):
    """Writes or removes the fix. True when the file changed: fail2ban reads filters only at its start."""
    try:
        with open(FAIL2BAN_SSHD_FIX) as f:
            now = f.read()
    except FileNotFoundError:
        now = None
    ours = now is not None and now.startswith(FAIL2BAN_SSHD_FIX_MARK)
    if on and (now is None or ours) and now != FAIL2BAN_SSHD_FIX_TEXT:
        _write(FAIL2BAN_SSHD_FIX, FAIL2BAN_SSHD_FIX_TEXT)
        return True
    if not on and ours:
        os.remove(FAIL2BAN_SSHD_FIX)
        return True
    return False


def fail2ban_set(args):
    """Ban addresses after failed SSH and SMTP logins."""
    enabled = _on_off(args.mode)
    if shutil.which('fail2ban-client') is None:
        raise EfaError('fail2ban is not installed.')
    if enabled:
        # The jails of eFa-next that other steps added (efa-web, efa-dkim-api) stay.
        old = open(FAIL2BAN_JAIL).read() if os.path.exists(FAIL2BAN_JAIL) else ''
        kept = ''.join('\n' + part.strip() + '\n' for part in re.findall(r'^\[efa-[a-z0-9-]+\][^\[]*', old, re.M))
        _fail2ban_sshd_fix(True)
        _write(FAIL2BAN_JAIL, '[sshd]\nenabled = true\n\n[postfix-sasl]\nenabled = true\nfilter = postfix[mode=auth]\n' + kept)
        subprocess.run(['systemctl', 'enable', '--now', 'fail2ban'], check=True, capture_output=True)
        subprocess.run(['systemctl', 'restart', 'fail2ban'], check=True, capture_output=True)
    else:
        if os.path.exists(FAIL2BAN_JAIL):
            os.remove(FAIL2BAN_JAIL)
        _fail2ban_sshd_fix(False)
        subprocess.run(['systemctl', 'disable', '--now', 'fail2ban'], check=True, capture_output=True)
    return {'fail2ban': enabled}


# 9i: one address that tries many unknown recipients (address harvesting, flooding with guessed addresses) is banned by
# Fail2Ban, on all nodes of a cluster (9d). Never the own networks, the allowlist of the firewall or the cluster nodes.
HARVEST_FILE = ETC + '/eFa/harvest.json'
HARVEST_JAIL = ETC + '/fail2ban/jail.d/efa-harvest.local'
HARVEST_FILTER = ETC + '/fail2ban/filter.d/efa-harvest.conf'
HARVEST_REGEX = r'NOQUEUE: reject: RCPT from \S+\[<HOST>\]: 550 5\.1\.1 '


def _harvest_settings():
    return {'mode': 'off', 'tries': 10, 'minutes': 10, 'hours': 1, 'allow': [], **_json_read(HARVEST_FILE, {})}


def harvest_ignore(settings_now):
    """The addresses Fail2Ban never bans for this: localhost, relay networks, the firewall allowlist, cluster nodes, own list."""
    found = ['127.0.0.1/8', '::1']
    found += _json_read(OUTBOUND_FILE, {}).get('networks', [])
    found += _json_read(ETC + '/eFa/firewall.json', {}).get('allowlist', [])
    if os.path.exists(os.path.join(ETC, 'eFa', 'cluster')):
        state = _lib('efa_cluster').read_state(ETC)
        found += [node.get('host', '') for node in state.get('nodes', {}).values()] + [state.get('master', {}).get('host', '')]
    found += settings_now['allow']
    return sorted({item for item in found if item})


# Hans 2026-11-18: the admin networks of the web allowlist (only while it is on) are never banned by the jails of the admin
# ways in (efa_cluster.ADMIN_EXEMPT_JAILS: web, SSH, recidive, the cluster), on no host and not through the cluster: a ban
# there locked the admin out of every node. The mail jails (postfix-sasl, efa-harvest) and postscreen keep harvest_ignore.
FAIL2BAN_NEVER_JAIL = ETC + '/fail2ban/jail.d/efa.never.local'


def admin_networks():
    return _lib('efa_cluster').admin_exempt_networks(_web_allow_state())


def fail2ban_never(settings_now):
    """Never banned by the jails of the admin ways in: harvest_ignore and the admin networks of the web allowlist."""
    return sorted(set(harvest_ignore(settings_now)) | set(admin_networks()))


def never_jail(admin_never):
    """jail.d/efa.never.local: the list of the admin ways in, per jail. No [DEFAULT]: that would reach the mail jails too.
    It sorts after efa.local and efa.lockout.local, so its ignoreip is the one these jails use."""
    line = 'ignoreip = ' + ' '.join(admin_never) + '\n'
    return '# Written by efactl. Do not edit.\n' + '\n'.join(f'[{jail}]\n{line}' for jail in ('sshd', 'efa-web', 'recidive'))


def fail2ban_never_refresh(restart=True):
    """Writes the never-banned list into every jail of eFa-next (DEFAULT covers sshd and the jails without their own list),
    lifts the bans of addresses on it, and restarts Fail2Ban when something changed. Returns True if it changed anything."""
    if shutil.which('fail2ban-client') is None or not os.path.isdir(ETC + '/fail2ban/jail.d'):
        return False
    never = fail2ban_never(_harvest_settings())
    wanted = {FAIL2BAN_NEVER_JAIL: never_jail(never)}
    if _lockout_settings()['mode'] == 'on':
        wanted[LOCKOUT_JAIL] = lockout_jail(_lockout_settings(), harvest_ignore(_harvest_settings()), never)
    if _harvest_settings()['mode'] == 'on':
        wanted[HARVEST_JAIL] = harvest_jail(_harvest_settings())
    changed = False
    for path, text in wanted.items():
        old = open(path).read() if os.path.exists(path) else None
        if old != text:
            _write(path, text)
            changed = True
    if changed and restart and _safe(lambda: _platform().service_is_active('fail2ban'), False):
        _platform().service_try_restart('fail2ban')
    cluster = _lib('efa_cluster')
    networks = [ipaddress.ip_network(item, strict=False) for item in admin_networks()]
    # Only the bans of the admin ways in are lifted; a ban of a mail jail stays.
    for jail, address in sorted(cluster.f2b_banned()) if networks else []:
        try:
            if jail in cluster.ADMIN_EXEMPT_JAILS and any(ipaddress.ip_address(address) in network for network in networks):
                cluster.f2b_unban(address, jail=jail)
                changed = True
        except ValueError:
            continue
    return changed


def harvest_jail(settings_now):
    return ('[efa-harvest]\nenabled = true\nfilter = efa-harvest\nlogpath = /var/log/maillog\nport = smtp,submission,submissions\n'
            f"maxretry = {settings_now['tries']}\nfindtime = {settings_now['minutes'] * 60}\nbantime = {settings_now['hours'] * 3600}\n"
            f"ignoreip = {' '.join(harvest_ignore(settings_now))}\n")


def harvest_set(args):
    """On or off, how many unknown recipients in how many minutes, how long the ban lasts, and addresses never banned for it."""
    settings_now = _harvest_settings()
    mode = 'on' if _on_off(args.mode) else 'off'
    for key, low, high in (('tries', 3, 100), ('minutes', 1, 1440), ('hours', 1, 720)):
        value = (getattr(args, key) or '').strip()
        if value:
            if not value.isdigit() or not low <= int(value) <= high:
                raise EfaError(f'{key}: {low} to {high}.')
            settings_now[key] = int(value)
    if getattr(args, 'allow', None) is not None and args.allow.strip() != '':
        allow = [item.strip() for item in args.allow.replace(',', ' ').split() if item.strip() and item.strip() != '-']
        for item in allow:
            try:
                ipaddress.ip_network(item, strict=False)
            except ValueError:
                raise EfaError(f'{item} is no address or network.')
        settings_now['allow'] = allow
    settings_now['mode'] = mode
    _json_write(HARVEST_FILE, settings_now)
    if mode == 'on':
        _write(HARVEST_FILTER, f'[Definition]\nfailregex = {HARVEST_REGEX}\nignoreregex =\n')
        _write(HARVEST_JAIL, harvest_jail(settings_now))
    elif os.path.exists(HARVEST_JAIL):
        os.remove(HARVEST_JAIL)
    _safe(lambda: fail2ban_never_refresh(restart=False), False)  # its own list is part of the one of the admin ways in
    if shutil.which('fail2ban-client'):
        _platform().service_try_restart('fail2ban')
    return harvest_status(None)


# B6: one lockout for failed logins of the web interface, the user portal, the API (all log "efa-web login failed from") and
# the logins of port 587 (Postfix logs the SASL failures), by Fail2Ban per address. Repeat offenders are banned for a week.
# No lockout per account: anybody could then lock the admin out by guessing wrong on purpose.
# fail2ban reads jail.d/*.local in name order: "efa.lockout.local" comes after "efa.local", so these values win.
LOCKOUT_FILE = ETC + '/eFa/login-lockout.json'
LOCKOUT_JAIL = ETC + '/fail2ban/jail.d/efa.lockout.local'
LOCKOUT_DEFAULTS = {'mode': 'off', 'tries': 5, 'minutes': 10, 'hours': 1, 'repeat': True}
LOCKOUT_CHOICES = {'tries': (3, 5, 10, 20), 'minutes': (5, 10, 30, 60), 'hours': (1, 6, 24, 168)}


def _lockout_settings():
    return {**LOCKOUT_DEFAULTS, **_json_read(LOCKOUT_FILE, {})}


def lockout_jail(settings_now, never, admin_never=None):
    """never: for the mail jail (postfix-sasl); admin_never (default never): for the web and recidive, with the admin networks."""
    # shortcut: the never-banned list is taken when this is saved; save again after changing relay networks or the allowlist.
    admin_never = never if admin_never is None else admin_never
    limits = f"maxretry = {settings_now['tries']}\nfindtime = {settings_now['minutes'] * 60}\nbantime = {settings_now['hours'] * 3600}\n"
    text = ('# Written by efactl login-lockout-set. Do not edit.\n'
            '[efa-web]\nenabled = true\nbackend = systemd\nfilter = efa-web\nport = http,https\n' + limits + f"ignoreip = {' '.join(admin_never)}\n" +
            '\n[postfix-sasl]\nenabled = true\nbackend = systemd\nfilter = postfix[mode=auth]\nport = smtp,submission,submissions\n' + limits +
            f"ignoreip = {' '.join(never)}\n")
    if settings_now['repeat']:
        # Three bans within a day: a week, on every port.
        text += f"\n[recidive]\nenabled = true\nlogpath = /var/log/fail2ban.log\nfindtime = 86400\nmaxretry = 3\nbantime = 604800\nignoreip = {' '.join(admin_never)}\n"
    return text


def login_lockout_status(_args):
    """Lockout after failed logins of web, portal, API and port 587, and the addresses banned for it now."""
    settings_now = _lockout_settings()
    banned = {}
    if settings_now['mode'] == 'on' and shutil.which('fail2ban-client'):
        for jail in ('efa-web', 'postfix-sasl', 'recidive'):
            done = subprocess.run(['fail2ban-client', 'status', jail], capture_output=True, text=True)
            match = re.search(r'Banned IP list:\s*(.*)', done.stdout) if done.returncode == 0 else None
            banned[jail] = match.group(1).split() if match else []
    return {**settings_now, 'never_banned': harvest_ignore(_harvest_settings()), 'never_banned_web_ssh': fail2ban_never(_harvest_settings()),
            'banned_now': banned}


def login_lockout_set(args):
    """After how many failed logins in how many minutes an address is banned, for how long, and a week for repeat offenders."""
    settings_now = _lockout_settings()
    mode = 'on' if _on_off(args.mode) else 'off'
    for key, allowed in LOCKOUT_CHOICES.items():
        value = (getattr(args, key, '') or '').strip()
        if value:
            if not value.isdigit() or int(value) not in allowed:
                raise EfaError(f'{key}: one of ' + ', '.join(map(str, allowed)))
            settings_now[key] = int(value)
    repeat = (getattr(args, 'repeat', '') or '').strip()
    if repeat:
        settings_now['repeat'] = _on_off(repeat)
    if mode == 'on' and shutil.which('fail2ban-client') is None:
        raise EfaError('fail2ban is not installed.')
    settings_now['mode'] = mode
    if mode == 'on':
        if not os.path.exists(FAIL2BAN_JAIL):
            fail2ban_set(argparse.Namespace(mode='on'))
        _fail2ban_sshd_fix(True)
        if not os.path.exists(FAIL2BAN_FILTER):
            web_harden(None)
        _write(LOCKOUT_JAIL, lockout_jail(settings_now, harvest_ignore(_harvest_settings()), fail2ban_never(_harvest_settings())))
    elif os.path.exists(LOCKOUT_JAIL):
        os.remove(LOCKOUT_JAIL)
    _json_write(LOCKOUT_FILE, settings_now)
    _safe(lambda: fail2ban_never_refresh(restart=False), False)  # the restart below loads it
    if shutil.which('fail2ban-client'):
        _platform().service_try_restart('fail2ban')
    return login_lockout_status(None)


# NIST SP 800-53 AC-8: a text of the operator before the admin login of the web interface, and if wanted before the SSH login
# (/etc/issue.net, the original kept, and a drop-in of sshd). Off by default; one text for the cluster (the master hands it on).
LOGIN_BANNER_FILE = ETC + '/eFa/login-banner.json'
ISSUE_NET = ETC + '/issue.net'
BANNER_SSHD = ETC + '/ssh/sshd_config.d/45-efa-banner.conf'
BANNER_MAX = 1000


def login_banner_status(_args):
    """The login banner: its text, shown before the admin login, and whether SSH shows it too."""
    state = _json_read(LOGIN_BANNER_FILE, {})
    text = str(state.get('text', ''))
    return {'text': text, 'web': bool(text), 'ssh': bool(text and state.get('ssh'))}


def login_banner_set(args):
    """The text before the admin login (empty: no banner); with ssh on also before the SSH login."""
    if identity_now and identity_now.get('role') != 'super':
        raise EfaError('Only a super admin sets the login banner.')
    text = (args.text or '').replace('\r\n', '\n').strip()
    if len(text) > BANNER_MAX or re.search(r'[\x00-\x08\x0b-\x1f\x7f]', text):
        raise EfaError(f'Banner: at most {BANNER_MAX} characters, plain text and line breaks only.')
    before = login_banner_status(None)
    ssh = (_on_off(args.ssh) if (getattr(args, 'ssh', '') or '').strip() else before['ssh']) and bool(text)
    _json_write(LOGIN_BANNER_FILE, {'text': text, 'ssh': ssh})  # efa-web reads it: 0640 root:efa-conf (CONF_READERS)
    if ssh:
        if os.path.exists(ISSUE_NET) and not os.path.exists(ISSUE_NET + '.efa-orig'):
            shutil.copy2(ISSUE_NET, ISSUE_NET + '.efa-orig')
        _write(ISSUE_NET, text + '\n')
    elif os.path.exists(ISSUE_NET + '.efa-orig'):
        os.replace(ISSUE_NET + '.efa-orig', ISSUE_NET)
    wanted = '# eFa-next: the login banner (efactl login-banner-set).\nBanner /etc/issue.net\n' if ssh else None
    if wanted != (open(BANNER_SSHD).read() if os.path.exists(BANNER_SSHD) else None):
        if wanted:
            _write(BANNER_SSHD, wanted)
        else:
            os.remove(BANNER_SSHD)
        _sshd_apply()
    _audit(f"login banner {'set' if text else 'off'} (SSH {'on' if ssh else 'off'}) by {_dmarc_who()}")
    return login_banner_status(None)


# PCI DSS 8.2.8, NIST SP 800-53 AC-11: the admin web interface ends a session after so many idle minutes. One value for the whole
# cluster (the master hands the command and the file on); efa-web reads the file again when it changed. The user portal keeps 60.
ADMIN_IDLE_FILE = ETC + '/eFa/admin-idle.json'
ADMIN_IDLE_CHOICES = (5, 10, 15, 30, 60)
ADMIN_IDLE_DEFAULT = 60


def admin_idle_minutes():
    """The idle timeout in effect, as efa-web reads it: 5 to 60 minutes, 60 without the file."""
    value = _json_read(ADMIN_IDLE_FILE, {}).get('minutes', ADMIN_IDLE_DEFAULT)
    return min(60, max(5, value)) if isinstance(value, int) and not isinstance(value, bool) else ADMIN_IDLE_DEFAULT


def admin_idle_status(_args):
    """Idle timeout of the admin web interface; the user portal stays at 60 minutes."""
    minutes = admin_idle_minutes()
    return {'minutes': minutes, 'choices': list(ADMIN_IDLE_CHOICES), 'portal_minutes': 60, 'at_most_15': minutes <= 15}


def _admin_idle_write(minutes):
    _json_write(ADMIN_IDLE_FILE, {'minutes': minutes})  # efa-web reads it: 0640 root:efa-conf (CONF_READERS)


def admin_idle_set(args):
    """Idle timeout of the admin web interface in minutes. Longer is weaker: a fresh password (and 2FA) and, while on, four eyes."""
    if identity_now and identity_now.get('role') != 'super':
        raise EfaError('Only a super admin sets the idle timeout of the admin interface.')
    value = (args.minutes or '').strip()
    if not value.isdigit() or int(value) not in ADMIN_IDLE_CHOICES:
        raise EfaError('Minutes: one of ' + ', '.join(map(str, ADMIN_IDLE_CHOICES)) + '.')
    old, new = admin_idle_minutes(), int(value)
    if new > old and not os.environ.get('EFA_FOUR_EYES'):
        # The run a second admin confirmed (four eyes) asks nobody again; four_eyes_needed checked that request.
        _reauth(_totp_self())
    _admin_idle_write(new)
    _audit(f'admin interface idle timeout {old} -> {new} minutes by {_dmarc_who()}')
    return {**admin_idle_status(None), 'old_minutes': old}

# 5v (d): postscreen in front of smtpd on port 25. It drops clients that talk before their turn (pregreet) and those that the
# active IP blocklists of eFa-next (with their terms confirmed) list with enough weight, before a smtpd process starts. Own
# networks, cluster nodes and the never-banned list pass. Deep protocol tests stay off (they delay every new sender).
POSTSCREEN_FILE = ETC + '/eFa/postscreen.json'
POSTSCREEN_ACCESS = ETC + '/postfix/efa-postscreen-access.cidr'
POSTSCREEN_THRESHOLDS = (2, 3, 4, 5)


def postscreen_sites(rbl_state):
    """postscreen_dnsbl_sites: zone*weight of the active IP blocklists with a zone and confirmed terms; the weight from the score."""
    sites = []
    for preset in RBL_PRESETS:
        saved = rbl_state['lists'].get(preset['id'], {})
        if preset['type'] == 'ip' and preset.get('zone') and _rbl_on(rbl_state, preset) and rbl_accepted(rbl_state, preset['id']):
            sites.append(f"{preset['zone']}*{max(1, round(float(saved.get('score', preset.get('score', 2))) / 2))}")
    for name, item in rbl_state['custom'].items():
        if item.get('type') == 'ip' and item.get('enabled', True) and rbl_accepted(rbl_state, name):
            sites.append(f"{item['zone']}*{max(1, round(float(item.get('score', 2)) / 2))}")
    return sorted(set(sites))


def postscreen_names(version):
    """The names of Postfix 3.5 (EL9: blacklist, whitelist) or of 3.6 and newer (denylist, allowlist)."""
    major, minor = (int(part) for part in (re.findall(r'\d+', version) + ['0', '0'])[:2])
    new = (major, minor) >= (3, 6)
    return {'deny_action': 'postscreen_denylist_action' if new else 'postscreen_blacklist_action',
            'allow_threshold': 'postscreen_dnsbl_allowlist_threshold' if new else 'postscreen_dnsbl_whitelist_threshold'}


def postscreen_main(sites, threshold, version):
    names = postscreen_names(version)
    return {'postscreen_access_list': f'permit_mynetworks, cidr:{POSTSCREEN_ACCESS}', names['deny_action']: 'drop',
            'postscreen_greet_action': 'enforce', 'postscreen_dnsbl_action': 'enforce', 'postscreen_dnsbl_sites': ', '.join(sites),
            'postscreen_dnsbl_threshold': str(threshold), names['allow_threshold']: '-2',
            'postscreen_cache_map': _cache_map('$data_directory/postscreen_cache'), 'postscreen_bare_newline_enable': 'no',
            'postscreen_non_smtp_command_enable': 'no', 'postscreen_pipelining_enable': 'no'}


def postscreen_status(_args):
    state = {'mode': 'off', 'threshold': 3, **_json_read(POSTSCREEN_FILE, {})}
    return {**state, 'lists': postscreen_sites(_rbl_state()), 'active': 'postscreen' in subprocess.run(['postconf', '-M', 'smtp/inet'],
                                                                                                        capture_output=True, text=True).stdout}


def _master_lines():
    return subprocess.run(['postconf', '-M'], capture_output=True, text=True, check=True).stdout


def postscreen_set(args):
    """postscreen in front of port 25: on or off, and how much weight of blocklists drops a client."""
    mode = 'on' if _on_off(args.mode) else 'off'
    state = {'mode': 'off', 'threshold': 3, **_json_read(POSTSCREEN_FILE, {})}
    value = (getattr(args, 'threshold', '') or '').strip()
    if value:
        if not value.isdigit() or int(value) not in POSTSCREEN_THRESHOLDS:
            raise EfaError('Threshold: ' + ', '.join(map(str, POSTSCREEN_THRESHOLDS)))
        state['threshold'] = int(value)
    folder = _postconf('config_directory')
    backup = {name: open(f'{folder}/{name}').read() for name in ('main.cf', 'master.cf')}
    try:
        if mode == 'on':
            never = harvest_ignore(_harvest_settings())
            _write(POSTSCREEN_ACCESS, ''.join(f'{item} permit\n' for item in never if '/' in item or re.fullmatch(r'[0-9a-fA-F.:]+', item)))
            smtp = subprocess.run(['postconf', '-P', 'smtp/inet'], capture_output=True, text=True).stdout.splitlines()
            options = [line.split('smtp/inet/', 1)[1] for line in smtp if line.startswith('smtp/inet/')]
            subprocess.run(['postconf', '-M', 'smtp/inet=smtp inet n - n - 1 postscreen', 'smtpd/pass=smtpd pass - - n - - smtpd',
                            'dnsblog/unix=dnsblog unix - - n - 0 dnsblog', 'tlsproxy/unix=tlsproxy unix - - n - 0 tlsproxy'], check=True, capture_output=True)
            if options:
                # The smtpd options of port 25 move to the smtpd behind postscreen.
                subprocess.run(['postconf', '-P'] + [f'smtpd/pass/{item}' for item in options], check=True, capture_output=True)
                subprocess.run(['postconf', '-PX'] + [f"smtp/inet/{item.split('=', 1)[0]}" for item in options], check=True, capture_output=True)
            for name, value in postscreen_main(postscreen_sites(_rbl_state()), state['threshold'], _postconf('mail_version')).items():
                subprocess.run(['postconf', '-e', f'{name} = {value}'], check=True, capture_output=True)
        elif 'postscreen' in _master_lines():
            passed = subprocess.run(['postconf', '-P', 'smtpd/pass'], capture_output=True, text=True).stdout.splitlines()
            options = [line.split('smtpd/pass/', 1)[1] for line in passed if line.startswith('smtpd/pass/')]
            subprocess.run(['postconf', '-M', 'smtp/inet=smtp inet n - n - - smtpd'], check=True, capture_output=True)
            if options:
                subprocess.run(['postconf', '-P'] + [f'smtp/inet/{item}' for item in options], check=True, capture_output=True)
            subprocess.run(['postconf', '-MX', 'smtpd/pass', 'dnsblog/unix', 'tlsproxy/unix'], check=False, capture_output=True)
        done = subprocess.run(['postfix', 'check'], capture_output=True, text=True)
        if done.returncode != 0:
            raise EfaError('postfix check failed: ' + done.stderr.strip()[:300])
    except (EfaError, subprocess.CalledProcessError) as err:
        for name, text in backup.items():
            _write(f'{folder}/{name}', text)
        raise EfaError(f'postscreen not changed, the old setup is back: {err}')
    state['mode'] = mode
    _json_write(POSTSCREEN_FILE, state, mode=0o644)
    # A reload is not enough for a new service on port 25.
    _platform().service_restart('postfix')
    _audit(f'postscreen {mode} (threshold {state["threshold"]}) by {_dmarc_who()}')
    return postscreen_status(None)

def _harvest_banned():
    done = subprocess.run(['fail2ban-client', 'status', 'efa-harvest'], capture_output=True, text=True) if shutil.which('fail2ban-client') else None
    match = re.search(r'Banned IP list:\s*(.*)', done.stdout) if done and done.returncode == 0 else None
    return match.group(1).split() if match else []


def harvest_top(lines, limit=10):
    """The addresses with the most unknown recipients in these mail log lines."""
    counts = {}
    pattern = re.compile(HARVEST_REGEX.replace('<HOST>', r'([0-9A-Fa-f:.]+)'))
    for line in lines:
        match = pattern.search(line)
        if match:
            counts[match.group(1)] = counts.get(match.group(1), 0) + 1
    return [{'address': address, 'unknown_recipients': count} for address, count in sorted(counts.items(), key=lambda item: -item[1])[:limit]]


def harvest_status(_args):
    settings_now = _harvest_settings()
    lines = []
    if os.path.exists('/var/log/maillog'):
        with open('/var/log/maillog', errors='replace') as f:
            lines = f.readlines()[-200000:]
    values = _postconf_many(['smtpd_recipient_restrictions', 'relay_recipient_maps', 'relay_domains'])
    warnings = harvest_warnings(values['smtpd_recipient_restrictions'], values['relay_recipient_maps'], values['relay_domains'])
    return {**{key: settings_now[key] for key in ('mode', 'tries', 'minutes', 'hours', 'allow')}, 'never_banned': harvest_ignore(settings_now),
            'banned_now': _harvest_banned() if settings_now['mode'] == 'on' else [], 'top_sources': harvest_top(lines), 'warnings': warnings}


def harvest_warnings(restrictions, recipient_maps, relay_domains):
    """Without a check of the recipients Postfix takes every address of the relay domains: no 550 5.1.1, nothing to ban."""
    if relay_domains.strip() and not recipient_maps.strip() and 'reject_unverified_recipient' not in restrictions:
        return ['No recipient check: every address of the own domains is accepted, so address harvesting is not seen. '
                'Switch on recipient verification (recipient-verification-set) or list the recipients.']
    return []


# 9l: what the start page draws. The setup only (mode, nodes with their own key, delivery targets, relay senders), never a mail.
FLOW_FILE = ETC + '/eFa/flow.json'
CLOUD_HOSTS = ('outlook.com', 'office365.com', 'google.com', 'googlemail.com', 'gmail.com')


def flow_targets(transport, relayhost=''):
    """The next hops of delivery from the transport table: name and whether it is a cloud service."""
    hosts = []
    for line in transport.splitlines():
        parts = line.split()
        if len(parts) >= 2 and not line.lstrip().startswith('#') and ':' in parts[1]:
            host = parts[1].split(':', 1)[1].strip('[]').split(']')[0].split(':')[0]
            if host and host not in hosts:
                hosts.append(host)
    if relayhost:
        host = relayhost.strip('[]').split(']')[0].split(':')[0]
        if host and host not in hosts:
            hosts.append(host)
    return [{'name': host, 'kind': 'cloud' if host.lower().endswith(CLOUD_HOSTS) else 'server'} for host in hosts]


def flow_status(_args):
    cluster_dir = os.path.join(ETC, 'eFa', 'cluster')
    nodes, mode = [], 'single'
    if os.path.exists(cluster_dir):
        cluster, base, state = _cluster_parts()
        if state:
            mode = state.get('mode', 'master-client')
            with open(os.path.join(base, 'node.crt')) as f:
                own = f.read()
            until = cluster.cert_end(own)
            nodes.append({'name': state['name'], 'self': True, 'role': state['role'], 'state': 'ok',
                          'fingerprint': cluster.fingerprint_pem(own)[:23], 'until': time.strftime('%Y-%m-%d', time.localtime(until)),
                          'expiring': until - time.time() < 30 * 86400})
            peers = sorted(cluster.active_nodes(state).items()) if state['role'] == 'master' else [(state['master'].get('name', 'master'), state['master'])]
            for name, peer in peers:
                try:
                    cluster.call(base, peer['host'], peer['port'], '/v1/status', timeout=2)
                    reached = 'ok'
                except (OSError, ValueError):
                    reached = 'down'
                nodes.append({'name': name, 'self': False, 'role': 'master' if state['role'] == 'client' else 'client', 'state': reached,
                              'fingerprint': (peer.get('fingerprint') or '')[:23]})
    if not nodes:
        nodes = [{'name': own_hostname(), 'self': True, 'role': 'single', 'state': 'ok'}]
    transport = open(ETC + '/postfix/transport').read() if os.path.exists(ETC + '/postfix/transport') else ''
    relays = [item for item in _json_read(OUTBOUND_FILE, {}).get('networks', [])
              if not item.startswith(('127.', '::1', '[::1]'))]
    stored = _json_read(FLOW_FILE, {})
    # G7-21: the switches of the optional stages (dashed while off) and the theme of the icons.
    flags = {'cdr': _safe(lambda: content_state()['cdr'], False), 'outbound': _safe(lambda: OUTBOUND_PORT in _milter_ports_now(), False),
             'uq': _safe(lambda: uq_state()['enabled'], False),
             'hold': _safe(lambda: QUARANTINE_RULES in _postconf('milter_header_checks') and os.path.exists(QUARANTINE_RULES), False)}
    themes = _lib('efa_flow').themes()
    return {'mode': mode, 'nodes': nodes, 'targets': flow_targets(transport, _postconf('relayhost'))[:8], 'relay_networks': len(relays),
            'animation': stored.get('animation', 'on'), 'flags': flags, 'themes': themes,
            'theme': stored.get('theme') if stored.get('theme') in themes else 'default'}


def flow_set(args):
    """The mail flow picture of the start page: the theme of its icons (a folder under /usr/share/eFa/flow). The moving letters of
    the picture before 6.0.0.7 are gone; the switch stays readable for older settings."""
    state = _json_read(FLOW_FILE, {})
    animation, theme = (getattr(args, 'animation', '') or '').strip(), (getattr(args, 'theme', '') or '').strip()
    if animation:
        state['animation'] = 'on' if _on_off(animation) else 'off'
    if theme:
        if theme not in _lib('efa_flow').themes():
            raise EfaError('Theme: one of ' + ', '.join(_lib('efa_flow').themes()) + ' (a complete folder under /usr/share/eFa/flow).')
        state['theme'] = theme
    _json_write(FLOW_FILE, state)
    return {key: state[key] for key in ('animation', 'theme') if key in state}


def backup_set(args):
    """Turn the automatic daily backup on or off."""
    enabled = _on_off(args.mode)
    if enabled:
        if os.path.exists(BACKUP_DISABLED):
            os.remove(BACKUP_DISABLED)
    else:
        _write(BACKUP_DISABLED, '')
    return {'auto_backup': enabled}


def _confirm(args):
    if (args.confirm or '').strip() != 'yes':
        # The web interface has a field for it; on the console it is the option.
        raise EfaError("Type 'yes' to confirm." if os.environ.get('SUDO_USER') in ('efa-web', 'efa-portal') else 'Add --confirm yes to confirm.')


def update_now(args):
    """Install all available updates, the same way as update-system without a reboot: backup, script check, time window."""
    _confirm(args)
    return update_system(argparse.Namespace(confirm='yes', reboot='off', reboot_confirm='', dry_run=''))


def reboot_host(args):
    """Restart the host in one minute."""
    _confirm(args)
    subprocess.run(['shutdown', '-r', '+1'], check=True, capture_output=True)
    return {'reboot': 'in one minute', 'cancel': 'shutdown -c'}


def halt_host(args):
    """Shut the host down in one minute."""
    _confirm(args)
    subprocess.run(['shutdown', '-h', '+1'], check=True, capture_output=True)
    return {'halt': 'in one minute', 'cancel': 'shutdown -c'}


# SQL from a backup or a snapshot: the client in sandbox mode (MariaDB 10.5.25 and later) runs no commands of its own.
MYSQL_RESTORE = ['mysql', '--user=root', '--sandbox']


def _mysql_env():
    env = dict(os.environ)
    for line in _read_lines(MYSQL_CONFIG):
        if line.startswith('MYSQLROOTPWD:'):
            env['MYSQL_PWD'] = line.split(':', 1)[1]
    return env


SECRETS_SEEN = []


def _secrets(count, prompt):
    """Reads passwords from a prompt, or from stdin when the web interface calls. Never from an argument."""
    if sys.stdin.isatty():
        try:
            values = [getpass.getpass(f'{prompt}: ') for _ in range(count)]
        except (KeyboardInterrupt, EOFError):
            # Every caller asks before it writes anything.
            print(json.dumps({'error': 'aborted, nothing changed'}))
            sys.exit(130)
    else:
        values = [sys.stdin.readline().rstrip('\n') for _ in range(count)]
    SECRETS_SEEN.extend(values)
    return values


PASSWORD_ATTEMPTS = 3
PASSWORD_DIFFER = 'The two entries are not the same.'


def password_twice(prompt):
    """A new password, asked twice. On a terminal up to three attempts, otherwise two lines from stdin. Differing entries change nothing."""
    if not sys.stdin.isatty():
        first, second = _secrets(2, prompt)
        if first != second:
            raise EfaError(PASSWORD_DIFFER + ' Nothing was changed.')
        return first
    for _attempt in range(PASSWORD_ATTEMPTS):
        first, second = getpass.getpass(f'{prompt}: '), getpass.getpass('Repeat it: ')
        if first == second:
            return first
        print(PASSWORD_DIFFER, file=sys.stderr)
    raise EfaError(f'{PASSWORD_DIFFER} Stopped after {PASSWORD_ATTEMPTS} attempts, nothing was changed.')


def _new_password():
    first, second = _secrets(2, 'Password, then again')
    if first != second:
        raise EfaError('The two passwords are not the same.')
    if len(first) < 12:
        raise EfaError('Backup password: at least 12 characters.')
    return first


def _gpg(password, *args):
    # A temp home keeps gpg away from any keyring. --passphrase-fd keeps the password out of the process list.
    with tempfile.TemporaryDirectory() as home:
        os.chmod(home, 0o700)
        return subprocess.run(['gpg', '--homedir', home, '--batch', '--yes', '--pinentry-mode', 'loopback',
                               '--passphrase-fd', '0'] + list(args), input=password + '\n', text=True, capture_output=True)


def _backup_new_name():
    os.makedirs(BACKUP_DIR, mode=0o700, exist_ok=True)
    os.chmod(BACKUP_DIR, 0o700)
    # A name used twice would overwrite a backup, for example the one about to be restored.
    while True:
        name = time.strftime('efa-backup-%Y%m%d-%H%M%S.tar.gz')
        if not (os.path.exists(f'{BACKUP_DIR}/{name}') or os.path.exists(f'{BACKUP_DIR}/{name}.gpg')):
            return name
        time.sleep(1)


def backup_password_set(args):
    """Stored password for automatic backups. Losing it makes those backups unusable. It is never shown again."""
    if args.mode.strip() == 'remove':
        if os.path.exists(BACKUP_PASSWORD):
            os.remove(BACKUP_PASSWORD)
        return {'backup_password': 'removed'}
    password = _new_password()
    os.makedirs(os.path.dirname(BACKUP_PASSWORD), exist_ok=True)
    fd = os.open(BACKUP_PASSWORD + '.tmp', os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, 'w') as f:
        f.write(password + '\n')
    os.replace(BACKUP_PASSWORD + '.tmp', BACKUP_PASSWORD)
    return {'backup_password': 'set'}


def _backup_stored_password():
    if os.path.exists(BACKUP_PASSWORD):
        with open(BACKUP_PASSWORD) as f:
            return f.read().rstrip('\n')
    return None


# External backup targets: only encrypted backups leave the host, right after a backup, with a bandwidth limit. Off by default.
BACKUP_TARGETS = ETC + '/eFa/backup-targets.json'
BACKUP_TARGET_DIR = ETC + '/eFa/backup-targets'
BACKUP_TARGET_RE = re.compile(r'^[a-z0-9][a-z0-9-]{0,31}$')
# 5z: backups only to providers in European hands, or to an own server in the EU (confirmed). The endpoint has to belong to the
# chosen provider; known providers outside the EU are refused by the host name and by every CNAME of it. Stand 2026-11-08.
EU_BACKUP_PROVIDERS = {
    'hetzner': ('Hetzner Object Storage or Storage Box (Germany, Finland)', ('.your-objectstorage.com', '.your-storagebox.de')),
    'scaleway': ('Scaleway (France)', ('.scw.cloud',)),
    'ionos': ('IONOS (Germany)', ('.ionoscloud.com',)),
    'stackit': ('STACKIT (Germany, Schwarz group)', ('.onstackit.cloud',)),
    'own': ('own server in the EU, operator in EU hands (confirmed)', ()),
}
NON_EU_STORAGE = ('amazonaws.com', 'amazonaws.com.cn', 'googleapis.com', 'googleusercontent.com', 'windows.net', 'azure.com', 'cloudflarestorage.com',
                  'r2.dev', 'backblazeb2.com', 'backblaze.com', 'wasabisys.com', 'digitaloceanspaces.com', 'oraclecloud.com', 'appdomain.cloud',
                  'aliyuncs.com', 'linodeobjects.com', 'vultrobjects.com', 'idrivee2.com', 'storjshare.io', 'dropboxapi.com')


def non_eu_host(host):
    """The known provider outside the EU this host name belongs to, or ''."""
    host = host.lower().rstrip('.')
    return next((suffix for suffix in NON_EU_STORAGE if host == suffix or host.endswith('.' + suffix)), '')


def _cname_chain(host):
    names, seen = [], {host}
    for _ in range(8):
        done = subprocess.run(['dig', '+short', '+time=3', '+tries=1', host, 'CNAME'], capture_output=True, text=True, timeout=15)
        target = done.stdout.strip().split('\n')[0].rstrip('.').lower() if done.stdout.strip() else ''
        if not target or target in seen:
            break
        names.append(target)
        seen.add(target)
        host = target
    return names


def eu_target_problem(provider, host, cnames=()):
    """Why a backup target may not be used (5z), or ''."""
    if provider not in EU_BACKUP_PROVIDERS:
        return 'choose a provider: ' + ', '.join(EU_BACKUP_PROVIDERS)
    for name in [host] + list(cnames):
        outside = non_eu_host(name)
        if outside:
            return f'{name} belongs to {outside}, a provider outside the EU: backups may only go to providers in European hands'
    suffixes = EU_BACKUP_PROVIDERS[provider][1]
    if suffixes and not any(host.lower().endswith(suffix) for suffix in suffixes):
        return f'the address is not one of {EU_BACKUP_PROVIDERS[provider][0]} (' + ', '.join(suffixes) + ')'
    return ''


def backup_targets_eu_lock(_args):
    """Package update: targets at providers outside the EU are locked, with a notice; nothing goes there any more."""
    targets, locked = _json_read(BACKUP_TARGETS, {}), []
    for key, target in targets.items():
        host = urllib.parse.urlsplit(target['endpoint']).hostname if target['kind'] == 's3' else target.get('host', '')
        outside = non_eu_host(host or '')
        if outside and not target.get('locked'):
            target['locked'] = f'{host} belongs to {outside}, outside the EU (5z)'
            locked.append(key)
    if locked:
        _backup_targets_write(targets)
        _admin_notify('eFa-next: backup targets locked', 'These backup targets are at a provider outside the EU and get no backups any more: ' + ', '.join(locked))
    return {'locked': locked}


# EU: whether the domains belong to persons or companies in the EU, and where data may go. external_service() is the one
# check of an external address for backups (5z), DMARC rua, TLS-RPT and later services. With EU relation no failure reports
# (ruf: they carry whole mails); a service outside the EU or of unknown seat only after a typed confirmation, strictly audited.
EU_FILE = ETC + '/eFa/eu-relation.json'
EU_REPORT_SERVICES = ('uriports.com', 'dmarcadvisor.com', 'dmarc-analyzer.com', 'mailhardener.com')
NON_EU_SERVICES = NON_EU_STORAGE + ('dmarcian.com', 'valimail.com', 'agari.com', 'postmarkapp.com', 'easydmarc.com', 'mxtoolbox.com', 'redsift.cloud',
                                    'ondmarc.com', 'proofpoint.com', 'mimecast.com', 'sendgrid.net', 'google.com', 'gmail.com', 'microsoft.com',
                                    'outlook.com', 'yahoo.com', 'fraudmarc.com', 'dmarcly.com', 'powerdmarc.com', 'cloudflare.net', 'cloudflare.com')
EU_CONFIRM = 'I accept the transfer outside the EU'


def eu_state():
    return {'global': None, 'domains': {}, **_json_read(EU_FILE, {})}


def eu_relation(domain, state=None):
    """True, False, or None when nobody answered yet; None counts as True wherever data could leave."""
    state = state or eu_state()
    domain = (domain or '').lower()
    for item in sorted(state['domains'], key=len, reverse=True):
        if domain == item or domain.endswith('.' + item):
            return state['domains'][item] == 'yes'
    return None if state['global'] is None else state['global'] == 'yes'


def external_service(host):
    """'eu', 'non-eu' or 'unknown' for the host of an external service."""
    host = (host or '').lower().rstrip('.')
    if any(host == item or host.endswith('.' + item) for item in NON_EU_SERVICES):
        return 'non-eu'
    if any(host == item or host.endswith('.' + item) for item in EU_REPORT_SERVICES) or any(
            host.endswith(suffix) for _, suffixes in EU_BACKUP_PROVIDERS.values() for suffix in suffixes):
        return 'eu'
    return 'unknown'


def eu_transfer_check(domain, hosts, confirm, what):
    """Raises unless every host outside the own domains is in the EU or the typed confirmation is given; logs the confirmation."""
    doubtful = sorted({host for host in hosts if external_service(host) != 'eu'})
    if not doubtful:
        return []
    if eu_hard():
        raise EfaError(f'{what} would go to {", ".join(doubtful)}: with the EU link of the setup only services in the EU are allowed '
                       '(Security, Setup variant).')
    if (confirm or '').strip() != EU_CONFIRM:
        seat = ', '.join(f'{host} ({external_service(host)})' for host in doubtful)
        raise EfaError(f'{what} would go to {seat}: not shown to be in the EU. Type "{EU_CONFIRM}" to send them anyway, on your own '
                       'responsibility; it is kept in the audit log.')
    who = _dmarc_who()
    _audit(f'EU transfer confirmed for {domain} ({what}) to {", ".join(doubtful)} by {who}')
    strict_record('eu_transfer_confirmed', domain, new={'what': what, 'to': doubtful})
    _event('eu_transfer_confirmed', 'warning', user=who, domain=domain, target=', '.join(doubtful))
    return doubtful


def eu_relation_status(_args):
    """EU relation: the answer for all domains and the domains that differ."""
    state = eu_state()
    # global is the text to show, choice the value of the form: empty while nobody answered (no answer is preselected).
    return {'global': {'yes': 'yes', 'no': 'no'}.get(state['global'], 'not answered'), 'choice': state['global'] or '', 'domains': state['domains'],
            'note': 'With EU relation no failure reports (ruf), backups only in the EU, reports to services outside the EU only after a '
                    'typed confirmation. Not answered counts as EU relation.'}


def eu_relation_set(args):
    """Do the domains belong to persons or companies in the EU, or does this server run in the EU? For all, or one domain."""
    mode, domain = (args.mode or '').strip(), (args.domain or '').strip().lower()
    if mode not in ('yes', 'no', 'inherit') or (mode == 'inherit' and not domain):
        raise EfaError("EU relation: 'yes' or 'no', for one domain also 'inherit'.")
    state = eu_state()
    if domain:
        if not DOMAIN_RE.match(domain) or domain not in _own_domains():
            raise EfaError('Domain: one of the own domains.')
        if identity_now and identity_now.get('domains') is not None and domain not in identity_now['domains']:
            raise EfaError('Not allowed: name one of your own domains.')
        if mode == 'inherit':
            state['domains'].pop(domain, None)
        else:
            state['domains'][domain] = mode
    else:
        if identity_now and identity_now.get('role') != 'super':
            raise EfaError('Only a super admin answers for all domains.')
        state['global'] = mode
    if mode == 'no' and eu_hard():
        raise EfaError('The setup confirmed an EU link: change it with Re-Setup (Security, Setup variant), with the typed confirmation.')
    _json_write(EU_FILE, state, mode=0o644)
    _audit(f'EU relation of {domain or "all domains"} set to {mode} by {_dmarc_who()}')
    strict_record('eu_relation_set', domain or 'all', new={'mode': mode})
    findings = eu_findings(state)
    if findings:
        _admin_notify('eFa-next: EU relation, things to change', '\n'.join(findings))
    setup_eu_autolock()
    return {**eu_relation_status(None), 'to_change': findings}


def eu_findings(state=None):
    """What goes against the EU relation now: failure reports and report addresses outside the EU in the DMARC records."""
    state, found = state or eu_state(), []
    for domain, item in sorted(_json_read(DMARC_RECORDS, {}).items()):
        current = item.get('current') or {}
        if eu_relation(domain, state) is False:
            continue
        if (current.get('fields') or {}).get('ruf'):
            found.append(_text('DMARC record of {domain} asks for failure reports (ruf): with EU relation remove them (DKIM, ARC & DMARC).', domain=domain))
        outside = [host for host in current.get('external', []) if external_service(host) == 'non-eu']
        if outside:
            found.append(_text('DMARC reports of {domain} go outside the EU: {hosts}.', domain=domain, hosts=', '.join(outside)))
    return found

def sigv4_headers(method, host, path, query, headers, payload_hash, region, service, access, secret, amz_date):
    """AWS Signature Version 4: the Authorization header for one request, over the given headers."""
    names = sorted(name.lower() for name in headers)
    canonical_headers = ''.join(f'{name}:{str(headers[next(k for k in headers if k.lower() == name)]).strip()}\n' for name in names)
    signed = ';'.join(names)
    canonical_query = '&'.join(f'{urllib.parse.quote(k, safe="-_.~")}={urllib.parse.quote(v, safe="-_.~")}' for k, v in sorted(query))
    request = '\n'.join([method, path, canonical_query, canonical_headers, signed, payload_hash])
    scope = f'{amz_date[:8]}/{region}/{service}/aws4_request'
    to_sign = '\n'.join(['AWS4-HMAC-SHA256', amz_date, scope, hashlib.sha256(request.encode()).hexdigest()])
    key = ('AWS4' + secret).encode()
    for part in (amz_date[:8], region, service, 'aws4_request'):
        key = hmac.new(key, part.encode(), hashlib.sha256).digest()
    signature = hmac.new(key, to_sign.encode(), hashlib.sha256).hexdigest()
    return f'AWS4-HMAC-SHA256 Credential={access}/{scope}, SignedHeaders={signed}, Signature={signature}'


def _s3_call(target, method, key='', query=(), body_path=None, payload_hash=None):
    """One signed request to an S3 bucket, path style. A file body is streamed with the bandwidth limit of the target."""
    import http.client
    parts = urllib.parse.urlsplit(target['endpoint'])
    path = '/' + urllib.parse.quote(target['bucket']) + ('/' + urllib.parse.quote(key) if key else '')
    amz_date = datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%dT%H%M%SZ')
    payload_hash = payload_hash or hashlib.sha256(b'').hexdigest()
    headers = {'host': parts.netloc, 'x-amz-date': amz_date, 'x-amz-content-sha256': payload_hash}
    headers['Authorization'] = sigv4_headers(method, parts.netloc, path, list(query), {k: v for k, v in headers.items()}, payload_hash,
                                             target['region'], 's3', target['access_key'], target['secret_key'], amz_date)
    body = None
    if body_path:
        size = os.path.getsize(body_path)
        headers['Content-Length'] = str(size)
        limit = target.get('limit_kbps', 0) * 1024 // 8

        def chunks():
            with open(body_path, 'rb') as f:
                while True:
                    started = time.time()
                    chunk = f.read(65536)
                    if not chunk:
                        return
                    yield chunk
                    if limit:
                        time.sleep(max(0.0, len(chunk) / limit - (time.time() - started)))
        body = chunks()
    connection = http.client.HTTPSConnection(parts.netloc, timeout=120, context=ssl.create_default_context())
    try:
        connection.request(method, path + ('?' + urllib.parse.urlencode(list(query)) if query else ''), body=body, headers=headers)
        reply = connection.getresponse()
        data = reply.read()
    finally:
        connection.close()
    if reply.status >= 300:
        raise EfaError(f'S3 answered {reply.status}: {data[:200].decode("utf-8", "replace")}')
    return data


def _sftp_call(target, commands):
    """Runs sftp commands as a batch, with the key, the known host key and the bandwidth limit of the target."""
    argv = ['sftp', '-b', '-', '-i', target['key_file'], '-P', str(target.get('port', 22)), '-o', 'BatchMode=yes', '-o', 'StrictHostKeyChecking=yes',
            '-o', f'UserKnownHostsFile={BACKUP_TARGET_DIR}/{target["name"]}.known_hosts']
    if target.get('limit_kbps'):
        argv += ['-l', str(target['limit_kbps'])]
    done = subprocess.run(argv + [f"{target['user']}@{target['host']}"], input='\n'.join(commands) + '\n', capture_output=True, text=True, timeout=3600)
    if done.returncode != 0:
        raise EfaError('sftp failed: ' + done.stderr[-200:].strip())
    return done.stdout


def backup_old_names(names, keep_days, now):
    """Backup names past the days of a target, from the date in the name."""
    old = []
    for name in names:
        found = re.search(r'efa-backup-(?:upload-|config-)?(\d{8})-\d{6}', name)
        if found and (now - datetime.datetime.strptime(found.group(1), '%Y%m%d')).days > keep_days:
            old.append(name)
    return old


def _target_upload(target, path):
    """One encrypted backup to one target, its checksum checked, and backups past the days of the target removed there."""
    name = os.path.basename(path)
    with open(path, 'rb') as f:
        checksum = hashlib.sha256(f.read()).hexdigest()
    now = datetime.datetime.now()
    if target['kind'] == 's3':
        prefix = target.get('prefix', '').strip('/')
        key = (prefix + '/' if prefix else '') + name
        # S3 refuses the upload if the data does not match this checksum.
        _s3_call(target, 'PUT', key, body_path=path, payload_hash=checksum)
        listing = _s3_call(target, 'GET', query=[('list-type', '2'), ('prefix', prefix + '/' if prefix else '')]).decode('utf-8', 'replace')
        keys = re.findall(r'<Key>([^<]+)</Key>', listing)
        for old in backup_old_names(keys, target['keep_days'], now):
            _s3_call(target, 'DELETE', old)
    else:
        folder = target.get('path', '.').rstrip('/') or '.'
        with tempfile.NamedTemporaryFile('w', suffix='.sha256', delete=False) as side:
            side.write(f'{checksum}  {name}\n')
        try:
            _sftp_call(target, [f'put {path} {folder}/{name}', f'put {side.name} {folder}/{name}.sha256'])
        finally:
            os.remove(side.name)
        names = [line.strip().rsplit('/', 1)[-1] for line in _sftp_call(target, [f'ls -1 {folder}']).splitlines() if 'efa-backup-' in line]
        old = backup_old_names(names, target['keep_days'], now)
        if old:
            _sftp_call(target, [f'-rm {folder}/{item}' for item in old])
    return checksum


def _backup_upload(name):
    """After a backup: the encrypted file to each target. A failed target mails the admin and sends an event; the others go on."""
    targets = _json_read(BACKUP_TARGETS, {})
    if not targets:
        return []
    if not name.endswith('.gpg'):
        _admin_notify('eFa-next: backup not uploaded', f'{name} is not encrypted and stays on this host. Set a backup password.')
        # The status of each target shows it too, not only the mail.
        for key, target in targets.items():
            target.update(last=time.strftime('%Y-%m-%d %H:%M:%S'), last_result='not encrypted, not uploaded: set a backup password')
            _event('backup_upload_failed', 'warning', target=key)
        _backup_targets_write(targets)
        return [{'target': key, 'result': target['last_result']} for key, target in sorted(targets.items())]
    results = []
    for key, target in sorted(targets.items()):
        if target.get('locked'):
            results.append({'target': key, 'result': 'locked: ' + target['locked']})
            continue
        try:
            checksum = _target_upload({**target, 'name': key}, f'{BACKUP_DIR}/{name}')
            target.update(last=time.strftime('%Y-%m-%d %H:%M:%S'), last_result='ok', last_sha256=checksum)
        except (EfaError, OSError, ssl.SSLError, ValueError) as err:
            target.update(last=time.strftime('%Y-%m-%d %H:%M:%S'), last_result=str(err)[:300])
            _admin_notify('eFa-next: backup upload failed', f'The backup {name} did not reach the target {key}: {err}')
            _event('backup_upload_failed', 'warning', target=key)
        results.append({'target': key, 'result': target['last_result']})
    _backup_targets_write(targets)
    return results


def _backup_targets_write(targets):
    fd = os.open(BACKUP_TARGETS + '.tmp', os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, 'w') as f:
        json.dump(targets, f, indent=1)
    os.replace(BACKUP_TARGETS + '.tmp', BACKUP_TARGETS)


def backup_target_list(_args):
    """The external backup targets and their last upload. Keys and passwords are never shown."""
    rows = []
    for key, target in sorted(_json_read(BACKUP_TARGETS, {}).items()):
        where = f"{target['endpoint']}/{target['bucket']}/{target.get('prefix', '')}" if target['kind'] == 's3' else \
            f"sftp://{target['user']}@{target['host']}:{target.get('port', 22)}/{target.get('path', '')}"
        rows.append({'name': key, 'kind': target['kind'], 'where': where, 'keep_days': target['keep_days'], 'limit_kbps': target.get('limit_kbps', 0),
                     'provider': EU_BACKUP_PROVIDERS.get(target.get('provider', ''), ('not chosen (before 6.0.0.5)',))[0],
                     'locked': target.get('locked', ''), 'last': target.get('last'), 'last_result': target.get('last_result'),
                     # An S3 target cannot work without its secret key: it goes with the target (remove the target).
                     'secret_key': secret_cell(target.get('secret_key'), '', True) if target['kind'] == 's3' else None})
    return {'targets': rows}


def backup_target_set(args):
    """Add or remove an external backup target, S3 or SFTP. The secret of S3 comes twice on stdin, never as an argument."""
    name, action = args.name.strip().lower(), args.action.strip()
    if not BACKUP_TARGET_RE.match(name) or action not in ('add', 'remove'):
        raise EfaError("A name of small letters, digits and dashes, and the action 'add' or 'remove'.")
    targets = _json_read(BACKUP_TARGETS, {})
    if action == 'remove':
        if targets.pop(name, None) is None:
            raise EfaError('No such target.')
        _backup_targets_write(targets)
        # Its host key goes with it: a new target of the same name takes the key of its server anew.
        if os.path.exists(f'{BACKUP_TARGET_DIR}/{name}.known_hosts'):
            os.remove(f'{BACKUP_TARGET_DIR}/{name}.known_hosts')
        return backup_target_list(None)
    kind = (args.kind or '').strip()
    keep = (args.keep_days or '').strip() or '30'
    limit = (args.limit_kbps or '').strip() or '0'
    if not keep.isdigit() or not 1 <= int(keep) <= 3650 or not limit.isdigit():
        raise EfaError('Keep for 1 to 3650 days; the limit in kbit/s, 0 for none.')
    provider = (getattr(args, 'provider', '') or '').strip()
    if provider == 'own' and (getattr(args, 'eu_confirm', '') or '').strip() != 'yes':
        raise EfaError('An own server: type yes to confirm that it stands in the EU and its operator is in European hands.')
    if not os.path.exists(BACKUP_PASSWORD):
        raise EfaError('Set a backup password first: only encrypted backups leave this host.')
    target = {'kind': kind, 'keep_days': int(keep), 'limit_kbps': int(limit), 'provider': provider}
    if kind == 's3':
        endpoint = https_url((args.endpoint or '').strip().rstrip('/'))
        bucket, region, access = (args.bucket or '').strip(), (args.region or '').strip() or 'us-east-1', (args.access_key or '').strip()
        if not endpoint or not re.fullmatch(r'[a-z0-9][a-z0-9.-]{1,62}', bucket) or not re.fullmatch(r'[\w-]{1,32}', region) or not re.fullmatch(r'[\w]{8,128}', access):
            raise EfaError('S3: an https endpoint, a bucket, a region and an access key.')
        secret = password_twice('Secret key')
        if not 8 <= len(secret) <= 256:
            raise EfaError('The secret key looks wrong.')
        target.update(endpoint=endpoint, bucket=bucket, region=region, access_key=access, secret_key=secret,
                      prefix=re.sub(r'[^\w./-]', '', (args.path or '').strip('/')))
    elif kind == 'sftp':
        host, user, key_file = (args.host or '').strip().lower(), (args.user or '').strip(), (args.key_file or '').strip()
        port = (args.port or '').strip() or '22'
        if not DOMAIN_RE.match(host) and not re.fullmatch(r'[0-9a-f.:]+', host) or not USER_RE.match(user) or not port.isdigit():
            raise EfaError('SFTP: a host, a user and a port.')
        if not key_file.startswith('/') or not os.path.exists(key_file) or oct(os.stat(key_file).st_mode)[-2:] != '00':
            raise EfaError('SFTP: the path of a private key that only root can read.')
        os.makedirs(BACKUP_TARGET_DIR, mode=0o700, exist_ok=True)
        # The host key is taken now and shown: compare it with the one of the server before the first backup goes there.
        keys = subprocess.run(['ssh-keyscan', '-p', port, '-T', '10', host], capture_output=True, text=True, timeout=30).stdout
        if not keys.strip():
            raise EfaError('The SFTP server does not answer.')
        _write(f'{BACKUP_TARGET_DIR}/{name}.known_hosts', keys)
        os.chmod(f'{BACKUP_TARGET_DIR}/{name}.known_hosts', 0o600)
        target.update(host=host, user=user, port=int(port), key_file=key_file, path=re.sub(r'[^\w./-]', '', (args.path or '').strip()) or '.')
        fingerprints = subprocess.run(['ssh-keygen', '-lf', f'{BACKUP_TARGET_DIR}/{name}.known_hosts'], capture_output=True, text=True).stdout
        target['host_keys'] = fingerprints.strip().splitlines()
    else:
        raise EfaError("Kind 's3' or 'sftp'.")
    host = urllib.parse.urlsplit(target['endpoint']).hostname if kind == 's3' else target['host']
    problem = eu_target_problem(provider, host or '', _cname_chain(host or ''))
    if problem:
        raise EfaError(f'Not added: {problem}.')
    targets[name] = target
    _backup_targets_write(targets)
    _audit(f'backup target {name} ({provider}, {host}) added by {_dmarc_who()}')
    return {**backup_target_list(None), 'host_keys': target.get('host_keys', [])}


def backup_target_test(args):
    """Upload the newest encrypted backup to one target now."""
    targets = _json_read(BACKUP_TARGETS, {})
    name = args.name.strip().lower()
    if name not in targets:
        raise EfaError('No such target.')
    newest = sorted(glob.glob(f'{BACKUP_DIR}/efa-backup-*.gpg'), key=os.path.getmtime)
    if not newest:
        raise EfaError('No encrypted backup yet: make one with a backup password.')
    return {'target': name, 'backup': os.path.basename(newest[-1]), 'sha256': _target_upload({**targets[name], 'name': name}, newest[-1])}


def backup_now_command(args):
    """Back up now, then the encrypted file goes to the external targets."""
    result = backup_now(args)
    uploads = _backup_upload(result['backup'])
    return {**result, 'uploads': uploads} if uploads else result


def backup_now(args):
    """Back up eFa-next settings, DKIM keys and the database; backups older than 5 days are removed."""
    mode = (getattr(args, 'encrypt', '') or '').strip()
    if mode not in ('', 'on', 'off'):
        raise EfaError("Encrypt must be 'on' or 'off'.")
    password = None
    if mode == 'on':
        lines = _secrets(2, 'Password, then again')
        if lines[0] or lines[1]:
            if lines[0] != lines[1]:
                raise EfaError('The two passwords are not the same.')
            if len(lines[0]) < 12:
                raise EfaError('Backup password: at least 12 characters.')
            password = lines[0]
        elif not os.path.exists(BACKUP_PASSWORD):
            raise EfaError('Enter a password, no backup password is stored.')
    if mode != 'off' and password is None:
        password = _backup_stored_password()
    return _backup_make(password)


def _backup_make(password, database=True, prefix=''):
    name = _backup_new_name().replace('efa-backup-', 'efa-backup-' + prefix)
    with tempfile.TemporaryDirectory(dir=BACKUP_DIR) as tmp:
        dump = None
        if database and shutil.which('mysqldump'):
            dump = tmp + '/backup.sql'
            with open(dump, 'w') as f:
                subprocess.run(['mysqldump', '--user=root', '--all-databases', '--events', '--single-transaction'],
                               stdout=f, env=_mysql_env(), check=True, stderr=subprocess.PIPE)
        path = f'{BACKUP_DIR}/{name}'
        files = {}
        with tarfile.open(path + '.tmp', 'w:gz') as tar:
            os.chmod(path + '.tmp', 0o600)
            for item in BACKUP_PATHS + BACKUP_DATA_PATHS:
                if os.path.lexists(item):
                    _tar_add_hashed(tar, item, files)
            if dump:
                _tar_add_hashed(tar, dump, files, 'backup.sql')
            # C2: the signed list of every file, last in the archive.
            manifest = json.dumps(backup_manifest(files, _backup_sign_key(), own_hostname()), sort_keys=True).encode()
            info = tarfile.TarInfo(BACKUP_MANIFEST)
            info.size, info.mtime, info.mode = len(manifest), int(time.time()), 0o600
            tar.addfile(info, io.BytesIO(manifest))
        if password is not None:
            done = _gpg(password, '--symmetric', '--cipher-algo', 'AES256', '--output', path + '.gpg.tmp', path + '.tmp')
            os.remove(path + '.tmp')
            if done.returncode != 0:
                raise EfaError('Encryption failed, no backup was kept.')
            os.chmod(path + '.gpg.tmp', 0o600)
            os.replace(path + '.gpg.tmp', path + '.gpg')
            name, path = name + '.gpg', path + '.gpg'
        else:
            os.replace(path + '.tmp', path)
    cutoff = time.time() - BACKUP_KEEP_DAYS * 86400
    for old in glob.glob(f'{BACKUP_DIR}/efa-backup-*'):
        if os.path.getmtime(old) < cutoff and os.path.isfile(old):
            os.remove(old)
    return {'backup': name, 'size': os.path.getsize(path), 'database': bool(dump), 'encrypted': password is not None}


# C2: every backup carries a manifest with the SHA-256 of each file, signed with the Ed25519 key of this host. A restore checks
# signature, signer and every file before anything changes. Another signer counts only with its fingerprint typed in.
BACKUP_SIGN_KEY = ETC + '/eFa/backup-sign.key'
BACKUP_MANIFEST = 'efa-manifest.json'


def _backup_sign_key():
    from cryptography.hazmat.primitives import serialization
    from cryptography.hazmat.primitives.asymmetric import ed25519
    if os.path.exists(BACKUP_HSM):
        # P3: the key in a hardware module.
        return Pkcs11Ed25519(_backup_hsm_spec())
    if not os.path.exists(BACKUP_SIGN_KEY):
        os.makedirs(os.path.dirname(BACKUP_SIGN_KEY), exist_ok=True)
        fd = os.open(BACKUP_SIGN_KEY, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, 'wb') as f:
            f.write(ed25519.Ed25519PrivateKey.generate().private_bytes(serialization.Encoding.PEM, serialization.PrivateFormat.PKCS8,
                                                                        serialization.NoEncryption()))
    with open(BACKUP_SIGN_KEY, 'rb') as f:
        return serialization.load_pem_private_key(f.read(), None)


def _raw_public(key):
    from cryptography.hazmat.primitives import serialization
    return key.public_bytes(serialization.Encoding.Raw, serialization.PublicFormat.Raw)


def key_fingerprint(raw):
    digest = hashlib.sha256(raw).hexdigest()[:32].upper()
    return ' '.join(digest[i:i + 4] for i in range(0, 32, 4))


def backup_file_hashes(paths, base=''):
    """name in the archive -> sha256 of a file, or link:<target> of a symlink, for every file under these paths."""
    found = {}
    for item in paths:
        source = base + item
        walk = [(os.path.dirname(source), [], [os.path.basename(source)])] if not os.path.isdir(source) or os.path.islink(source) else os.walk(source)
        for folder, _dirs, names in walk:
            for name in names:
                path = os.path.join(folder, name)
                arc = path[len(base):].lstrip('/') if base else path.lstrip('/')
                if os.path.islink(path):
                    found[arc] = 'link:' + os.readlink(path)
                elif os.path.isfile(path):
                    with open(path, 'rb') as f:
                        found[arc] = hashlib.sha256(f.read()).hexdigest()
    return found


def manifest_body(manifest):
    return json.dumps({name: value for name, value in manifest.items() if name != 'signature'}, sort_keys=True, separators=(',', ':')).encode()


def backup_manifest(files, private_key, host):
    manifest = {'version': 1, 'host': host, 'created': time.strftime('%Y-%m-%d %H:%M:%S'), 'files': files,
                'public_key': base64.b64encode(_raw_public(private_key.public_key())).decode()}
    manifest['signature'] = base64.b64encode(private_key.sign(manifest_body(manifest))).decode()
    return manifest


def backup_manifest_check(tar, own_raw, signer=''):
    """None when the archive is signed by this host (or by the typed signer) and every file matches, else the problem."""
    from cryptography.exceptions import InvalidSignature
    from cryptography.hazmat.primitives.asymmetric import ed25519
    try:
        member = tar.getmember(BACKUP_MANIFEST)
        manifest = json.loads(tar.extractfile(member).read(1024 * 1024 * 16))
        raw = base64.b64decode(manifest['public_key'])
        ed25519.Ed25519PublicKey.from_public_bytes(raw).verify(base64.b64decode(manifest['signature']), manifest_body(manifest))
    except KeyError:
        return 'unsigned'
    except (InvalidSignature, ValueError, TypeError):
        return 'the signature of this backup is not valid'
    fingerprint = key_fingerprint(raw)
    if raw != own_raw and ''.join(signer.upper().split()) != fingerprint.replace(' ', ''):
        return f'signed by another host ({manifest.get("host", "?")}), key {fingerprint}: type this fingerprint to accept it'
    files = manifest.get('files', {})
    for item in tar.getmembers():
        if item.name == BACKUP_MANIFEST or item.isdir():
            continue
        if item.name not in files:
            return f'{item.name} is not in the signed list'
        if item.issym():
            if files[item.name] != 'link:' + item.linkname:
                return f'{item.name} was changed after the backup'
        elif item.isreg() and hashlib.sha256(tar.extractfile(item).read()).hexdigest() != files[item.name]:
            return f'{item.name} was changed after the backup'
    return None


def backup_key_show(_args):
    """C2: the fingerprint of the key this host signs its backups with; another host restores them only with it."""
    return {'fingerprint': key_fingerprint(_raw_public(_backup_sign_key().public_key()))}


# Package 12 (Hans 2026-11-19): a restore test of a backup of this host. Signature and manifest as a restore checks them, then the
# database into a throwaway MariaDB (its own data folder and socket, no network, no events); the running host is never touched.
# Monthly only when switched on (off by default); always in the background, at the lowest CPU and disk priority.
RESTORE_TEST_FILE = ETC + '/eFa/restore-test.json'
RESTORE_TEST_STATE = '/var/lib/eFa/restore-test.json'
RESTORE_TEST_UNIT = 'efa-restore-test'
RESTORE_TEST_PARENT = '/var/lib'
RESTORE_TEST_DAYS = 35
RESTORE_TEST_RESERVE = 1024 * 1048576
RESTORE_TEST_OWN_RE = re.compile(r'^efa-backup-\d{8}-\d{6}\.tar\.gz(\.gpg)?$')
DUMP_USE_RE = re.compile(rb'^USE `((?:[^`]|``)+)`;')
DUMP_TABLE_RE = re.compile(rb'^CREATE TABLE (?:IF NOT EXISTS )?`((?:[^`]|``)+)`')


def dump_tables(lines, sink=None):
    """The (database, table) pairs a mysqldump of all databases creates, from its USE and CREATE TABLE lines; every line also
    goes to sink, so the dump is read once."""
    found, database = set(), None
    for line in lines:
        if line.startswith(b'USE `'):
            match = DUMP_USE_RE.match(line)
            database = match.group(1).replace(b'``', b'`').decode('utf8', 'replace') if match else database
        elif line.startswith(b'CREATE TABLE') and database:
            match = DUMP_TABLE_RE.match(line)
            if match:
                found.add((database, match.group(1).replace(b'``', b'`').decode('utf8', 'replace')))
        if sink:
            sink(line)
    return found


def restore_test_monthly():
    return bool(_safe(lambda: _json_read(RESTORE_TEST_FILE, {}), {}).get('monthly'))


def _restore_test_load():
    load, cpus = os.getloadavg()[0], os.cpu_count() or 1
    if load > cpus:
        raise EfaError(f'The load is high ({load:.1f} on {cpus} CPUs): start the restore test later.')


def _restore_test_space(folder, need, what):
    free = shutil.disk_usage(folder).free
    if free - need < RESTORE_TEST_RESERVE:
        raise EfaError(f'Not enough disk space in {folder} for {what}: {need // 1048576} MB needed and 1024 MB kept free, '
                       f'{free // 1048576} MB free.')


def _restore_test_pick(name):
    """The backup named, or the newest of this host (no upload, no settings-only backup)."""
    if name:
        return _backup_path(name)
    own = sorted(path for path in glob.glob(BACKUP_DIR + '/efa-backup-*') if RESTORE_TEST_OWN_RE.match(os.path.basename(path)))
    if not own:
        raise EfaError('No backup of this host yet: Back up now first.')
    return own[-1]


def _restore_test_import(dump):
    """Imports the dump into a throwaway MariaDB and returns the number of tables; every table the dump creates must be there.
    The check runs in the session of the import: the grants of the dump never matter."""
    daemon = shutil.which('mariadbd', path='/usr/libexec:/usr/sbin:/usr/bin') or shutil.which('mysqld', path='/usr/libexec:/usr/sbin:/usr/bin')
    install = shutil.which('mariadb-install-db') or shutil.which('mysql_install_db')
    if not daemon or not install:
        raise EfaError('MariaDB is not installed on this host.')
    data = tempfile.mkdtemp(prefix='efa-restore-test-', dir=RESTORE_TEST_PARENT)
    sock, server = data + '/mysql.sock', None
    try:
        shutil.chown(data, 'mysql', 'mysql')
        _platform().database_folder(data)
        done = subprocess.run([install, '--no-defaults', '--user=mysql', f'--datadir={data}'], capture_output=True, text=True)
        if done.returncode:
            raise EfaError('The throwaway database could not be set up: ' + (done.stderr or done.stdout).strip()[-200:])
        server = subprocess.Popen([daemon, '--no-defaults', '--user=mysql', f'--datadir={data}', f'--socket={sock}', f'--pid-file={data}/mysqld.pid',
                                   f'--log-error={data}/error.log', '--skip-networking', '--event-scheduler=DISABLED', '--skip-log-bin',
                                   '--innodb-buffer-pool-size=64M', '--performance-schema=OFF', '--max-connections=5'],
                                  stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        for _ in range(240):
            if os.path.exists(sock) or server.poll() is not None:
                break
            time.sleep(0.5)
        if server.poll() is not None or not os.path.exists(sock):
            log = _read_lines(data + '/error.log')
            raise EfaError('The throwaway database did not start: ' + (log[-1] if log else 'no log'))
        with tempfile.TemporaryFile() as out, tempfile.TemporaryFile() as err, open(dump, 'rb') as f:
            client = subprocess.Popen(['mysql', '--no-defaults', f'--socket={sock}', '--user=root', '--sandbox', '--batch', '--skip-column-names'],
                                      stdin=subprocess.PIPE, stdout=out, stderr=err)
            created = set()
            try:
                created = dump_tables(f, client.stdin.write)
                # Two columns: --batch puts a tab between them and escapes any tab inside a value.
                client.stdin.write(b"\nSELECT table_schema, table_name FROM information_schema.tables WHERE table_type <> 'VIEW';\n")
                client.stdin.close()
            except BrokenPipeError:
                pass
            client.wait()
            out.seek(0)
            err.seek(0)
            if client.returncode:
                raise EfaError('The import of the database failed: ' + err.read().decode('utf8', 'replace').strip()[-300:])
            restored = {tuple(line.split('\t', 1)) for line in out.read().decode('utf8', 'replace').splitlines() if '\t' in line}
        missing = sorted(created - restored)
        if missing:
            raise EfaError(f'{len(missing)} tables of the dump are missing after the import, the first: {".".join(missing[0])}.')
        return len(created)
    finally:
        if server is not None and server.poll() is None:
            server.terminate()
            try:
                server.wait(120)
            except subprocess.TimeoutExpired:
                server.kill()
                server.wait()
        shutil.rmtree(data, ignore_errors=True)


def _restore_test(path):
    with tempfile.TemporaryDirectory(dir=BACKUP_DIR) as tmp:
        plain = path
        if path.endswith('.gpg'):
            password = _backup_stored_password()
            if password is None:
                raise EfaError('The backup is encrypted and no backup password is stored (Automatic backup: password).')
            _restore_test_space(BACKUP_DIR, os.path.getsize(path), 'the decrypted backup')
            plain = tmp + '/backup.tar.gz'
            if _gpg(password, '--decrypt', '--output', plain, path).returncode != 0:
                raise EfaError('The stored backup password does not open this backup, or the backup is damaged.')
        try:
            with tarfile.open(plain) as tar:
                problem = backup_manifest_check(tar, _raw_public(_backup_sign_key().public_key()))
                if problem:
                    raise EfaError(f'Signature and manifest: {problem}.')
                files = len([item for item in tar.getmembers() if not item.isdir()]) - 1
                try:
                    member = tar.getmember('backup.sql')
                except KeyError:
                    raise EfaError('This backup holds no database.')
                if not member.isreg():
                    raise EfaError('Damaged backup: backup.sql is no file.')
                _restore_test_space(BACKUP_DIR, member.size, 'the database dump')
                _restore_test_space(RESTORE_TEST_PARENT, member.size * 2, 'the throwaway database')
                with tar.extractfile(member) as source, open(tmp + '/backup.sql', 'wb') as target:
                    shutil.copyfileobj(source, target, 1048576)
        except tarfile.TarError:
            raise EfaError('Damaged backup.')
        tables = _restore_test_import(tmp + '/backup.sql')
    return {'backup': os.path.basename(path), 'files': files, 'tables': tables}


def backup_restore_test_run(args):
    """The restore test itself, the background job of backup-restore-test: result, event and audit line."""
    name = (getattr(args, 'name', '') or '').strip()
    os.nice(19)
    subprocess.run(['ionice', '-c', '3', '-p', str(os.getpid())], capture_output=True)
    os.makedirs(os.path.dirname(RESTORE_TEST_STATE), exist_ok=True)
    with open(RESTORE_TEST_STATE + '.lock', 'w') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            raise EfaError('A restore test is running already.')
        # What a test that was stopped hard left behind.
        for old in glob.glob(RESTORE_TEST_PARENT + '/efa-restore-test-*'):
            shutil.rmtree(old, ignore_errors=True)
        started = time.time()
        result = {'at': int(started), 'when': time.strftime('%Y-%m-%d %H:%M'), 'backup': name, 'ok': False}
        try:
            path = _restore_test_pick(name)
            result['backup'] = os.path.basename(path)
            result.update(_restore_test(path), ok=True)
        except (EfaError, OSError, subprocess.SubprocessError) as err:
            result['problem'] = str(err)[:400]
        result['seconds'] = int(time.time() - started)
        _json_write(RESTORE_TEST_STATE, result, mode=0o644)
    if result['ok']:
        _event('restore_test_ok', 'info', target=result['backup'], tables=result['tables'])
        _audit(f"restore test of {result['backup']} passed: signature, {result['files']} files, {result['tables']} tables")
    else:
        _event('restore_test_failed', 'warning', target=result['backup'] or 'newest backup', problem=result['problem'])
        _audit(f"restore test of {result['backup'] or 'the newest backup'} failed: {result['problem']}")
    return result


def backup_restore_test(args):
    """Starts the restore test of the newest backup of this host (or the one named) in the background; the result shows under
    Restore test: status."""
    name = (getattr(args, 'name', '') or '').strip()
    if name:
        _backup_path(name)
    _restore_test_load()
    if not _platform().job_start(RESTORE_TEST_UNIT, ['/usr/sbin/efactl', 'backup-restore-test-run'] + (['--name', name] if name else [])):
        raise EfaError('The restore test did not start: one runs already (Restore test: status).')
    _audit(f'restore test of {name or "the newest backup"} started by {_dmarc_who()}')
    return {'started': name or 'the newest backup', 'result': 'Restore test: status (efactl backup-restore-test-status)'}


def backup_restore_test_status(_args):
    """The last restore test, whether one runs now, and the monthly test."""
    running = _safe(lambda: _platform().service_is_active(RESTORE_TEST_UNIT), False)
    last =_safe(lambda: _json_read(RESTORE_TEST_STATE, {}), {})
    return {'monthly': 'on' if restore_test_monthly() else 'off', 'running': running,
            'last': {key: value for key, value in last.items() if key != 'at'} or 'never'}


def backup_restore_test_set(args):
    """The monthly restore test on or off (off by default)."""
    on = _on_off(args.monthly)
    _json_write(RESTORE_TEST_FILE, {'monthly': on}, mode=0o644)
    _audit(f'monthly restore test {"on" if on else "off"} by {_dmarc_who()}')
    return backup_restore_test_status(None)


def _restore_test_job(state, now=None):
    """Hourly: once a month, from 04:00 and when the load allows, the restore test starts in the background."""
    now = now or datetime.datetime.now()
    month = now.strftime('%Y-%m')
    if not restore_test_monthly() or state.get('restore_test_month') == month or now.hour < 4:
        return
    try:
        _restore_test_load()
    except EfaError:
        return  # the next hour tries again
    backup_restore_test(argparse.Namespace(name=''))
    state['restore_test_month'] = month


def restore_test_fact():
    """(passed in the last 35 days, text) for the hardening report; None while it never ran and the monthly test is off."""
    last = _safe(lambda: _json_read(RESTORE_TEST_STATE, {}), {})
    if not last:
        return (False if restore_test_monthly() else None), 'never'
    fresh = time.time() - last.get('at', 0) <= RESTORE_TEST_DAYS * 86400
    return bool(last.get('ok') and fresh), f"{last.get('when', '?')}: {'passed' if last.get('ok') else 'failed'}"


# After a restore without the ID of SecuriteInfo while the source is on: the dashboard asks for it until it is entered again.
SI_ID_RESTORE_MARK = '/var/lib/eFa/securiteinfo-id-restore'


def _tar_add_hashed(tar, path, files, arc=None):
    """Adds a file, link or folder tree and notes the SHA-256 of exactly what went in. The writers of eFa-next replace their
    files atomically (_json_write: a .tmp of their own, then rename): their .tmp files stay out, and a file is opened first and
    described from what was opened, so a replace in between gives the old or the new file, never a mix."""
    arc = arc or path.lstrip('/')
    if os.path.islink(path):
        tar.add(path, arcname=arc, recursive=False)
        files[arc] = 'link:' + os.readlink(path)
    elif os.path.isdir(path):
        tar.add(path, arcname=arc, recursive=False)
        for name in sorted(os.listdir(path)):
            if not name.endswith('.tmp'):
                _tar_add_hashed(tar, os.path.join(path, name), files, arc + '/' + name)
    elif path == SI_URLS_FILE:
        return  # the URL lines of SecuriteInfo hold its key (c26a860)
    elif path == SANE_FILE:
        # The account ID of SecuriteInfo never goes into a backup (c26a860): the settings without it; a restore asks for it again.
        with open(path, 'rb') as f:
            info = tar.gettarinfo(arcname=arc, fileobj=f)
            try:
                data = json.dumps(sane_without_secrets(json.loads(f.read())), indent=2, sort_keys=True).encode()
            except ValueError:
                data = b'{}'
        info.size = len(data)
        tar.addfile(info, io.BytesIO(data))
        files[arc] = hashlib.sha256(data).hexdigest()
    elif os.path.isfile(path):
        digest = hashlib.sha256()
        with open(path, 'rb') as f:
            info = tar.gettarinfo(arcname=arc, fileobj=f)
            for block in iter(lambda: f.read(1048576), b''):
                digest.update(block)
            f.seek(0)
            tar.addfile(info, f)
        files[arc] = digest.hexdigest()

def backup_list(_args):
    """List available backups."""
    rows = []
    for path in sorted(glob.glob(f'{BACKUP_DIR}/efa-backup-*.tar.gz') + glob.glob(f'{BACKUP_DIR}/efa-backup-*.tar.gz.gpg')):
        name = os.path.basename(path)
        rows.append({'name': name, 'size_mb': round(os.path.getsize(path) / 1048576, 1),
                     'date': time.strftime('%Y-%m-%d %H:%M', time.localtime(os.path.getmtime(path))),
                     'encrypted': name.endswith('.gpg')})
    rows.sort(key=lambda row: row['name'].replace('upload-', ''))
    return {'backups': rows, 'backup_password_stored': os.path.exists(BACKUP_PASSWORD)}


def _backup_path(name):
    name = name.strip()
    if not BACKUP_NAME_RE.match(name) or not os.path.exists(f'{BACKUP_DIR}/{name}'):
        raise EfaError('Unknown backup.')
    return f'{BACKUP_DIR}/{name}'


def _backup_web_check(path):
    """Through the web interface a backup leaves this host only encrypted: it holds the database and private keys."""
    if os.environ.get('SUDO_USER') == 'efa-web' and not path.endswith('.gpg'):
        raise EfaError('Only encrypted backups can be downloaded. Set a backup password, then make a new backup.')


def backup_download(args):
    """Where a backup is, with size and checksum, to fetch it from the console."""
    path = _backup_path(args.name)
    _backup_web_check(path)
    with open(path, 'rb') as f:
        checksum = hashlib.sha256(f.read()).hexdigest()
    return {'path': path, 'size': os.path.getsize(path), 'sha256': checksum}


def backup_read(args):
    """Writes the raw backup to stdout for the web download, and logs it."""
    path = _backup_path(args.name)
    _backup_web_check(path)
    _audit(f'backup {os.path.basename(path)} downloaded by {_dmarc_who()}')
    with open(path, 'rb') as f:
        shutil.copyfileobj(f, sys.stdout.buffer)
    sys.stdout.buffer.flush()


def backup_import(args):
    """Stores an uploaded backup from stdin in the backup folder. It can then be restored from the list."""
    os.makedirs(BACKUP_DIR, mode=0o700, exist_ok=True)
    if args.file and os.environ.get('SUDO_USER') == 'efa-web':
        raise EfaError('Not allowed from the web interface, upload the file instead.')
    data = sys.stdin.buffer.read() if not args.file else open(args.file, 'rb').read()
    return {'imported': _backup_store(data)}


def _backup_store(data):
    if data[:2] == b'\x1f\x8b':
        suffix = '.tar.gz'
    elif data[:1] in (b'\x8c', b'\xc3') or data[:5] == b'-----':
        suffix = '.tar.gz.gpg'
    else:
        raise EfaError('This is no eFa-next backup: neither .tar.gz nor .tar.gz.gpg.')
    name = time.strftime('efa-backup-upload-%Y%m%d-%H%M%S') + suffix
    fd = os.open(f'{BACKUP_DIR}/{name}', os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, 'wb') as f:
        f.write(data)
    if suffix == '.tar.gz':
        try:
            with tarfile.open(f'{BACKUP_DIR}/{name}') as tar:
                tar.getmembers()
        except tarfile.TarError:
            os.remove(f'{BACKUP_DIR}/{name}')
            raise EfaError('This file is damaged or no backup, it was not kept.')
    return name


def _restore_unsafe(members, allowed):
    """A backup may come from an upload: no way out of the allowed folders, and no device files. Returns the first bad name."""
    symlinks = {os.path.normpath(member.name) for member in members if member.issym()}
    # A hard link to a symlink entry is extracted as that symlink (tarfile, CVE-2026-11940 pattern): hard link names count as links too.
    links = {member.name for member in members if member.issym() or member.islnk()}
    seen = set()
    for member in members:
        # A second entry of the same name (a link first, then a file) would write through the link.
        if member.name.rstrip('/') in seen:
            return member.name
        seen.add(member.name.rstrip('/'))
        parts = member.name.split('/')
        if '..' in parts or member.name.startswith('/'):
            return member.name
        if not (member.isreg() or member.isdir() or member.issym() or member.islnk()):
            return member.name
        # Links may point anywhere, real configs do. But nothing may be written through one.
        if any('/'.join(parts[:i]) in links for i in range(1, len(parts))):
            return member.name
        if member.islnk():
            target = os.path.normpath(member.linkname)
            if target in symlinks or not any(target == x or target.startswith(x + '/') for x in allowed):
                return member.name
    return None


# Written by efa5-export into a backup: the settings of an eFa 5.0, applied once by the restore.
EFA5_IMPORT = ETC + '/eFa/efa5-import'


def _lib(name):
    """A library of eFa-next: the copy next to this file in the source tree first, then the installed one."""
    import importlib
    for folder in ('/usr/lib/eFa/python', os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', 'lib', 'eFa', 'python')):
        if folder not in sys.path:
            sys.path.insert(0, folder)
    return importlib.import_module(name)


def _efa5_convert():
    return _lib('efa5_convert')


def efa5_apply(run_efactl=None):
    """Applies the eFa 5.0 settings of a restored efa5-export file, through the same commands as the in-place migration.
    Returns what was taken over, adjusted and not taken over; the plan is renamed so a later restore does not apply it again."""
    convert = _efa5_convert()
    # The restore creates folders world-readable; the keys and SASL passwords in here are for root only.
    for folder, _dirs, _files in os.walk(EFA5_IMPORT):
        os.chmod(folder, 0o700)
    with open(EFA5_IMPORT + '/plan.json') as f:
        plan = json.load(f)
    failed = []
    if run_efactl is None:
        def run_efactl(*step):
            # As root, like the migration: the web user started the restore, and that was allowed and logged.
            env = {k: v for k, v in os.environ.items() if k != 'SUDO_USER'}
            done = subprocess.run([sys.executable, os.path.abspath(sys.argv[0]), *step], capture_output=True, text=True, env=env)
            return done.returncode == 0, (done.stdout + done.stderr)[-200:].strip()
    for table in plan['tables']:
        source = f'{EFA5_IMPORT}/postfix/{table}'
        if os.path.exists(source):
            shutil.copyfile(source, f'{ETC}/postfix/{table}')
            os.chmod(f'{ETC}/postfix/{table}', 0o600 if table == 'sasl_passwd' else 0o644)
            if subprocess.run(['postmap', _map(f'{ETC}/postfix/{table}')], capture_output=True).returncode != 0:
                failed.append(f'postmap {table}')
    own = set(_postconf_names())
    taken, _left = convert.fresh_postconf(plan['old_postconf'], own=own)
    for name, value in taken.items():
        if subprocess.run(['postconf', '-e', f'{name} = {value}'], capture_output=True).returncode != 0:
            failed.append(f'postconf {name}')
    for step in convert.settings_steps(plan, EFA5_IMPORT, fresh=True):
        ok, text = run_efactl(*step)
        if not ok:
            failed.append(f'{step[0]}: {text}')
    report = convert.fresh_report(plan, own=own)
    report['failed'] = failed
    _write(EFA5_IMPORT + '/report.txt', convert.report_text(report) + ''.join(f'Failed: {item}\n' for item in failed))
    os.replace(EFA5_IMPORT + '/plan.json', EFA5_IMPORT + '/plan.applied.json')
    _audit(f'eFa 5.0 settings applied by {_dmarc_who()}: {len(report["taken"])} taken over, {len(failed)} failed')
    return report


def _postconf_names():
    """The names this host sets in main.cf, before anything of the old host is applied."""
    out = subprocess.run(['postconf', '-n'], capture_output=True, text=True).stdout
    return [line.split('=', 1)[0].strip() for line in out.splitlines() if '=' in line]


def restore(args):
    """Restore a backup. It is checked first, then a backup of the current state is made.
    A file from efa5-export also applies the eFa 5.0 settings in it, once."""
    _confirm(args)
    file = (getattr(args, 'file', '') or '').strip()
    if file and os.environ.get('SUDO_USER') == 'efa-web':
        # Would let a web session read any file on the system through the backup list.
        raise EfaError('Not allowed from the web interface, upload the file instead.')
    if file:
        with open(file, 'rb') as f:
            name = _backup_store(f.read())
    else:
        name = args.name.strip()
    path = _backup_path(name)
    with tempfile.TemporaryDirectory(dir=BACKUP_DIR) as tmp:
        plain = path
        if name.endswith('.gpg'):
            password = _secrets(1, 'Backup password')[0]
            plain = tmp + '/backup.tar.gz'
            if _gpg(password, '--decrypt', '--output', plain, path).returncode != 0:
                raise EfaError('Wrong password or damaged backup, nothing was changed.')
        allowed = tuple(item.lstrip('/') for item in BACKUP_PATHS)
        own_si_id = _sane_state().get('extra', {}).get('securiteinfo', {}).get('id', '')
        try:
            with tarfile.open(plain) as tar:
                problem = backup_manifest_check(tar, _raw_public(_backup_sign_key().public_key()), (getattr(args, 'signer', '') or '').strip())
                if problem == 'unsigned':
                    # Backups of 6.0.0.4 and older and the files of efa5-export carry no signature yet. Their files replace the
                    # settings of Postfix and nginx: only the main admin (or root on the console) may restore one.
                    if identity_now is not None:
                        raise EfaError('This backup is not signed: only the main admin may restore it, nothing was changed.')
                    if (getattr(args, 'unsigned', '') or '').strip() != 'yes':
                        raise EfaError('This backup is not signed (made by 6.0.0.4 or older, or by efa5-export), nothing was changed. '
                                       'Restore it only if you know where it comes from: then type yes under "Restore an unsigned backup".')
                    _audit(f'unsigned backup {name} accepted for restore by {_dmarc_who()}')
                elif problem:
                    raise EfaError(f'Nothing was changed: {problem}.')
                members = [m for m in tar.getmembers()
                           if m.name == 'backup.sql' or any(m.name == x or m.name.startswith(x + '/') for x in allowed)]
                unsafe = _restore_unsafe(members, allowed)
                if unsafe:
                    raise EfaError(f'Unsafe entry in this backup, nothing was changed: {unsafe}')
                if not members:
                    raise EfaError('This file holds no eFa-next settings, nothing was changed.')
                safety = backup_now(None)['backup']
                _write(RESTORE_RUNNING, f'restore pid={os.getpid()}\n')
                tar.extractall(tmp, members=members, filter='tar')
        except tarfile.TarError:
            raise EfaError('Damaged backup, nothing was changed.')
        try:
            for member in members:
                if member.name == 'backup.sql' or member.isdir():
                    continue
                target = '/' + member.name
                os.makedirs(os.path.dirname(target), exist_ok=True)
                # Never written through a link already on the host: copy2 follows a link at the target. A link of the backup
                # replaces what is there (copying a symlink fails when the target already exists).
                if os.path.islink(target) or member.issym() and os.path.lexists(target):
                    os.remove(target)
                shutil.copy2(f'{tmp}/{member.name}', target, follow_symlinks=False)
                os.chown(target, member.uid, member.gid, follow_symlinks=False)
            dump = tmp + '/backup.sql'
            if os.path.exists(dump):
                with open(dump) as f:
                    # --sandbox: the client refuses its own commands (system, source, tee): a dump holds only SQL.
                    subprocess.run(MYSQL_RESTORE, stdin=f, env=_mysql_env(), check=True, capture_output=True)
            si_id_after_restore(own_si_id)
        finally:
            os.remove(RESTORE_RUNNING)
    # Copied files keep the label of the temp directory, and SELinux would lock services out of them.
    subprocess.run(['restorecon', '-R'] + [item for item in BACKUP_PATHS if os.path.exists(item)], check=False,
                   capture_output=True)
    result = {'restored': name, 'safety_backup': safety, 'files': len(members)}
    # Package 15: what was erased after that backup is erased again.
    try:
        result['gdpr_erased_again'] = gdpr_reapply()
    except Exception as err:  # pymysql errors have no common base here; the restore itself is done
        result['gdpr_erased_again'] = f'failed: {str(err)[:120]}'
        _audit(f'GDPR erasure after the restore failed: {str(err)[:120]}; run it again: efactl gdpr-reapply')
    if os.path.exists(EFA5_IMPORT + '/plan.json'):
        result['efa5_import'] = efa5_apply()
    # A backup of before the HTTP/2 setting brings efa.conf as it was: the setting of this host holds (taken back if nginx refuses).
    _safe(lambda: web_http2_enforce(reload=False), False)
    # /etc/hosts is not in the backup: its block of own host names as the restored settings say (unbound follows below).
    _safe(lambda: hosts_apply(None), None)
    for service in ('postfix', 'rspamd', 'nginx', 'unbound'):
        subprocess.run(['systemctl', 'reload-or-restart', service], check=False, capture_output=True)
    return result


def si_id_after_restore(own_id):
    """A backup holds no account ID of SecuriteInfo: the one of this host stays; without one, the source (if on) waits for it,
    with a hint on the dashboard and an audit line."""
    state = _sane_state()
    item = state.get('extra', {}).get('securiteinfo', {})
    if not item.get('enabled') or item.get('id') or cluster_role() == 'client':
        return
    if own_id:
        item['id'] = own_id
        _json_write(SANE_FILE, state)
        return
    _write(SI_ID_RESTORE_MARK, time.strftime('%Y-%m-%d %H:%M:%S') + '\n')
    _audit('restore: SecuriteInfo is on without its account ID (backups leave it out): enter it again under More ClamAV signatures')


def si_id_notices():
    """The hint after a restore without the ID of SecuriteInfo, until the ID or its URL lines are there again."""
    if not os.path.exists(SI_ID_RESTORE_MARK):
        return []
    item = _sane_state().get('extra', {}).get('securiteinfo', {})
    if not item.get('enabled') or item.get('id') or _si_urls():
        os.remove(SI_ID_RESTORE_MARK)
        return []
    return [_text('Enter the SecuriteInfo ID again after the restore: backups leave it out.')]


# Every character that ends a line for a reader of the log (str.splitlines, a terminal), and the other control characters.
AUDIT_LINE_BREAKS = re.compile('[\x00-\x1f\x7f\x85\u2028\u2029]')


def audit_line(text):
    """One line of the audit file: a value given by an admin (a reason, an id, a name) cannot forge a line of its own."""
    return AUDIT_LINE_BREAKS.sub(' ', str(text))


def _audit(text):
    os.makedirs(os.path.dirname(AUDIT_LOG), exist_ok=True)
    with open(AUDIT_LOG, 'a') as log:
        log.write(f'{time.strftime("%Y-%m-%d %H:%M:%S")} {audit_line(text)}\n')
    os.chmod(AUDIT_LOG, 0o640)


# 9n: the rspamd web interface only for reading and only for a while; writing goes through eFa-next (rights, audit, cluster).
RSPAMD_SSO_MINUTES = (60, 15, 240)
RSPAMD_SSO_UPGRADED = '/var/lib/eFa/rspamd-sso-upgraded'


def _rspamd_sso_until():
    """When the read access ends (seconds since 1970), 0 when it is off. The file holds "read-only <until>"."""
    parts = (_read_lines(RSPAMD_SSO_FILE) or [''])[0].split()
    if len(parts) == 2 and parts[0] == 'read-only' and parts[1].isdigit() and int(parts[1]) > time.time():
        return int(parts[1])
    return 0


def _rspamd_sso_mode():
    return 'read-only' if _rspamd_sso_until() else 'off'


def _rspamd_sso_inc(mode):
    if mode == 'off':
        return 'location /rspamd/ { return 404; }\n'
    # rspamd trusts connections from this host without its password, unless a forwarded address names another
    # client. So no password is needed here, and the browser sends none. The headers are cleared to keep that trust.
    # Only reading: changes go through eFa-next (9n). An old full mode reads too.
    limit = '        limit_except GET HEAD { deny all; }\n'
    return f"""location = /_efa_rspamd_auth {{
    internal;
    proxy_pass http://127.0.0.1:8080/rspamd-auth;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
}}
location @efa_login {{ return 302 /login; }}
location /rspamd/ {{
    auth_request /_efa_rspamd_auth;
    error_page 401 = @efa_login;
{limit}    proxy_pass http://127.0.0.1:11334/;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For "";
    proxy_set_header X-Real-IP "";
    proxy_set_header Password "";
    proxy_set_header Cookie "";
    add_header X-Frame-Options DENY always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
}}
"""


def _proxy_key_write():
    """One random key for nginx and the two web programs, made once; the nginx include is readable only for root."""
    key = None
    for path, _group in PROXY_KEY_FILES:
        if os.path.exists(path):
            with open(path) as f:
                key = f.read().strip() or key
    key = key if key and re.fullmatch(r'[A-Za-z0-9_-]{32,}', key) else secrets.token_urlsafe(32)
    for path, group in PROXY_KEY_FILES:
        if os.path.isdir(os.path.dirname(path)):
            fd = os.open(path + '.tmp', os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o640)
            os.fchmod(fd, 0o640)
            with os.fdopen(fd, 'w') as f:
                f.write(key + '\n')
            with contextlib.suppress(KeyError, LookupError):
                shutil.chown(path + '.tmp', 'root', group)
            os.chmod(path + '.tmp', 0o640)
            os.replace(path + '.tmp', path)
    fd = os.open(NGINX_PROXY_KEY + '.tmp', os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    os.fchmod(fd, 0o600)
    with os.fdopen(fd, 'w') as f:
        f.write(f'proxy_set_header X-Efa-Proxy "{key}";\n')
    os.chmod(NGINX_PROXY_KEY + '.tmp', 0o600)
    os.replace(NGINX_PROXY_KEY + '.tmp', NGINX_PROXY_KEY)


# 6.0.0.6.6.1: HTTP/2 of the web interface is a setting, off by default, as a precaution against issues of the HTTP/2 module
# of nginx. Every writer of efa.conf (setup, web-harden, the certificates, a restore) brings it to this setting, so nothing
# switches HTTP/2 on again.
WEB_HTTP2_FILE = ETC + '/eFa/web-http2.json'


def web_http2_on():
    return _json_read(WEB_HTTP2_FILE, {}).get('mode') == 'on'


def nginx_version():
    """(1, 26, 3) of the installed nginx, None when there is none."""
    try:
        text = subprocess.run(['nginx', '-v'], capture_output=True, text=True, timeout=10).stderr
    except (OSError, subprocess.TimeoutExpired):
        return None
    found = re.search(r'nginx/(\d+)\.(\d+)\.(\d+)', text)
    return tuple(int(part) for part in found.groups()) if found else None


def nginx_http2_text(conf, on, version):
    """efa.conf with HTTP/2 as set: off removes "http2 on;" and the http2 flag of listen; on adds the form this nginx knows
    ("http2 on;" from 1.25.1, the flag of listen before)."""
    conf = re.sub(r'^[ \t]*http2[ \t]+on;[ \t]*\n', '', conf, flags=re.M)
    conf = re.sub(r'^([ \t]*listen[^;\n]*?)[ \t]+http2\b', r'\1', conf, flags=re.M)
    if on:
        if version and version >= (1, 25, 1):
            conf = re.sub(r'^([ \t]*)(listen[ \t]+(?:\[::\]:)?443[^;\n]*;[ \t]*\n)', r'\1\2\1http2 on;\n', conf, count=1, flags=re.M)
        else:
            conf = re.sub(r'^([ \t]*listen[ \t]+(?:\[::\]:)?443[ \t]+ssl)\b', r'\1 http2', conf, flags=re.M)
    return conf


def web_http2_enforce(reload=True):
    """efa.conf as the setting says; nginx -t before a reload, a config nginx rejects is taken back. True when it changed."""
    if not os.path.exists(NGINX_CONF):
        return False
    with open(NGINX_CONF) as f:
        conf = f.read()
    new = nginx_http2_text(conf, web_http2_on(), nginx_version())
    if new == conf:
        return False
    _write(NGINX_CONF, new)
    done = subprocess.run(['nginx', '-t'], capture_output=True, text=True)
    if done.returncode != 0:
        _write(NGINX_CONF, conf)
        raise EfaError('nginx rejected the HTTP/2 setting, it was taken back: ' + done.stderr[-300:])
    if reload:
        _platform().service_reload_if_active('nginx')
    return True


def web_http2(args):
    """HTTP/2 of the web interface: on, off or status (with the installed nginx version)."""
    mode = (args.mode or 'status').strip()
    if mode not in ('on', 'off', 'status'):
        raise EfaError('Mode: on, off or status.')
    if mode != 'status':
        before = 'on' if web_http2_on() else 'off'
        _json_write(WEB_HTTP2_FILE, {'mode': mode}, mode=0o644)
        try:
            changed = web_http2_enforce()
        except EfaError:
            _json_write(WEB_HTTP2_FILE, {'mode': before}, mode=0o644)
            raise
        _audit(f'web interface HTTP/2 set to {mode} (was {before}) by {_dmarc_who()}' + ('' if changed else ', nginx already so'))
    version = nginx_version()
    return {'http2': 'on' if web_http2_on() else 'off', 'nginx': '.'.join(map(str, version)) if version else None,
            'in_config': bool(os.path.exists(NGINX_CONF) and re.search(r'\bhttp2\b', open(NGINX_CONF).read()))}


def web_http2_status(_args):
    return web_http2(argparse.Namespace(mode='status'))


def _nginx_apply():
    """Writes the eFa-next include files and loads them; a config nginx rejects is taken back."""
    include = f'    include {NGINX_HARDENING};\n'
    _proxy_key_write()
    with open(NGINX_CONF) as f:
        conf = f.read()
    # The key of nginx next to the address it sends (once; the line of 6.0.0.5 and older gets it on the update).
    real_ip = '        proxy_set_header X-Real-IP $remote_addr;\n'
    if real_ip in conf and f'include {NGINX_PROXY_KEY};' not in conf:
        conf = conf.replace(real_ip, real_ip + f'        include {NGINX_PROXY_KEY};\n', 1)
    if include not in conf:
        marker = '    client_max_body_size 64m;\n'
        if marker not in conf:
            raise EfaError(f'{NGINX_CONF} has an unknown form, nothing was changed.')
        new_conf = conf.replace(marker, marker + include, 1)
    else:
        new_conf = conf
    backups = {}
    for path in (NGINX_HARDENING, NGINX_RSPAMD, NGINX_PORTAL, NGINX_ADMIN_ALLOW):
        backups[path] = open(path).read() if os.path.exists(path) else None
    protocols, ciphers, _out, _in = tls_wanted(tls_profile_state())
    new_conf = re.sub(r'ssl_protocols [^;]+;', f'ssl_protocols {protocols};', new_conf)
    new_conf = nginx_http2_text(new_conf, web_http2_on(), nginx_version())
    _write(NGINX_HARDENING, f"""ssl_ciphers {ciphers};
ssl_ecdh_curve {':'.join(web_curves())};
ssl_prefer_server_ciphers on;""" + """
ssl_session_tickets off;
server_tokens off;
add_header Strict-Transport-Security "max-age=63072000" always;
include """ + NGINX_RSPAMD + """;
include """ + NGINX_PORTAL + """;
""")
    _write(NGINX_RSPAMD, _rspamd_sso_inc(_rspamd_sso_mode()))
    _write(NGINX_PORTAL, NGINX_PORTAL_INC)
    _write(NGINX_ADMIN_ALLOW, admin_allow_conf(_web_allow_state()))
    with open(NGINX_CONF, 'w') as f:
        f.write(new_conf)
    done = subprocess.run(['nginx', '-t'], capture_output=True, text=True)
    if done.returncode != 0:
        with open(NGINX_CONF, 'w') as f:
            f.write(conf)
        for path, text in backups.items():
            if text is None:
                os.remove(path)
            else:
                _write(path, text)
        raise EfaError('nginx rejected the config, it was taken back: ' + done.stderr[-200:])
    subprocess.run(['systemctl', 'reload', 'nginx'], check=False, capture_output=True)


NGINX_PORTAL_INC = ''.join(f"""location ^~ /{path} {{
    proxy_pass http://127.0.0.1:8081;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    include {NGINX_PROXY_KEY};
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Cookie $http_cookie;
}}
""" for path in PORTAL_PATHS[:3]) + """# 13: the static task pane of the Outlook add-in, framed by Outlook on the web; Office.js comes from Microsoft.
location ^~ /outlook/ {
    alias /usr/share/eFa/outlook/;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://appsforoffice.microsoft.com; connect-src 'self'; img-src 'self'; frame-ancestors 'self' https://*.office.com https://*.office365.com https://*.outlook.com https://*.officeapps.live.com" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Strict-Transport-Security "max-age=63072000" always;
}
# 5p: only the allowed addresses reach the admin interface; the portal stays open to all.
if ($efa_admin_refused) { return 403; }
"""


def _web_allow_state():
    return {'mode': 'all', 'entries': [], **_json_read(WEB_ALLOW_FILE, {})}


LOOPBACK_NETS = (ipaddress.ip_network('127.0.0.1/32'), ipaddress.ip_network('::1/128'))


def admin_allow_conf(state, portal_open=True):
    """The nginx variables of the admin allowlist (http level): refused is 1 for an address outside the list, except on the portal paths
    (with portal_open False, during the self-lockdown of 9o-b, the portal too)."""
    allowed = state['mode'] == 'allowed' and state['entries']
    # The host itself always: the health check of the updater (also of 6.0.0.5.x) asks https://127.0.0.1/login after an
    # update, and a refusal there rolls the update back. Addresses from outside stay refused.
    # An entry for the host itself (made by hand before this) would only repeat it: nginx warns of a duplicate network.
    own = [item for item in state['entries'] if ipaddress.ip_network(item['network'], strict=False) not in LOOPBACK_NETS]
    lines = ["    127.0.0.1 1;\n", "    ::1 1;\n"] + [f"    {item['network']} 1;\n" for item in own] if allowed else []
    skip = '/(?!' + ('|'.join(re.escape(path) for path in PORTAL_PATHS) if portal_open else re.escape('.well-known/acme-challenge/')) + ')'
    return (f'# eFa-next: efactl web-allowlist-set, do not edit.\ngeo $efa_admin_ip_ok {{\n    default {0 if allowed else 1};\n' + ''.join(lines) + '}\n'
            f'map "$efa_admin_ip_ok:$uri" $efa_admin_refused {{\n    default 0;\n    "~^0:{skip}" 1;\n}}\n')


def web_allow_entries(text):
    """Networks with a comment each, one per line or comma separated: 192.0.2.0/24 office."""
    entries = []
    for item in re.split(r'[,\n]+', text or ''):
        parts = item.strip().split(None, 1)
        if not parts:
            continue
        try:
            network = str(ipaddress.ip_network(parts[0], strict=False))
        except ValueError:
            raise EfaError(f'{parts[0]} is no IP address or network, such as 192.0.2.0/24 or 2001:db8::/32.')
        entries.append({'network': network, 'comment': (parts[1] if len(parts) > 1 else '')[:80].replace(';', ' ')})
    return entries


def web_allow_refusal(state, client):
    """Why switching to allowed addresses would lock out: an empty list, or the address of this admin is not in it."""
    if state['mode'] != 'allowed':
        return None
    if not state['entries']:
        raise EfaError('The list is empty: add the admin networks first.')
    try:
        address = ipaddress.ip_address(client)
    except ValueError:
        return None  # the console or a node of the cluster: no address of a browser to lock out
    if not any(address in ipaddress.ip_network(item['network']) for item in state['entries']):
        raise EfaError(f'Refused: your own address {client} is not in the list, you would lock yourself out. Add it first.')
    return None


def web_allowlist_show(_args):
    state = _web_allow_state()
    return {'mode': state['mode'], 'networks': ', '.join(f"{item['network']} {item['comment']}".strip() for item in state['entries']),
            'your_address': acting_client if acting_client and acting_client[0].isdigit() or ':' in acting_client else ''}


def web_allowlist_set(args):
    """5p: the admin interface only from these networks; the user portal stays open. The list can be kept while it is off."""
    state = _web_allow_state()
    if args.networks is not None and args.networks.strip() != '':
        state['entries'] = [] if args.networks.strip() == '-' else web_allow_entries(args.networks)
    mode = (args.mode or state['mode']).strip()
    if mode not in ('all', 'allowed', 'off'):
        raise EfaError('Mode: all or allowed.')
    state['mode'] = 'all' if mode == 'off' else mode
    if state['mode'] == 'allowed':
        _confirm(args)
        web_allow_refusal(state, acting_client)
    _json_write(WEB_ALLOW_FILE, state)
    os.chmod(WEB_ALLOW_FILE, 0o640)
    shutil.chown(WEB_ALLOW_FILE, 'root', 'efa-web')
    _nginx_apply()
    _safe(fail2ban_never_refresh, False)
    _audit(f'admin web allowlist set to {state["mode"]} with {len(state["entries"])} networks by {_dmarc_who()}')
    if _breakglass().read_state().get('user'):
        _safe(lambda: _breakglass_sshd(_breakglass().read_state()), None)  # SSH of the break-glass admin: the same admin networks
    return web_allowlist_show(None)


# The break-glass admin (Hans 2026-11-18): a local user with ten one-time codes, never replicated (its state is under
# /var/lib, not /etc), SSH with a code from the admin networks only, the console with a code, sudo with a fresh code.
BREAKGLASS_PAM = {'sshd': False, 'sudo': False, 'login': True}  # service -> the faillock counter of the console


def _breakglass():
    return _lib('efa_breakglass')


def _breakglass_networks():
    """The admin networks: those of the admin web access when it is limited; none (no SSH for the user) otherwise."""
    state = _web_allow_state()
    return [item['network'] for item in state['entries']] if state['mode'] == 'allowed' else []


def _breakglass_sshd(state):
    lib = _breakglass()
    state = {**state, 'networks': _breakglass_networks()}
    lib.write_state(state)
    previous = open(lib.SSHD_FILE).read() if os.path.exists(lib.SSHD_FILE) else None
    _write(lib.SSHD_FILE, lib.sshd_text(state['user'], state['networks']))
    try:
        _sshd_apply()
    except EfaError:
        if previous is None:
            os.remove(lib.SSHD_FILE)
        else:
            _write(lib.SSHD_FILE, previous)
        raise
    return state


def _breakglass_install(user):
    """The user, its PAM stacks, the guards in sshd, sudo and login, and its sudo rule; each checked before it counts."""
    lib = _breakglass()
    if subprocess.run(['id', user], capture_output=True).returncode != 0:
        subprocess.run(['useradd', '--create-home', '--shell', lib.SHELL, '--comment', 'eFa-next break-glass admin', user], check=True, capture_output=True)
    subprocess.run(['usermod', '--lock', user], check=True, capture_output=True)  # no password, ever
    for service, tty in BREAKGLASS_PAM.items():
        path = f'/etc/pam.d/{service}'
        with open(path) as f:
            text = f.read()
        _write(path, lib.with_guard(text, user, tty))
    fd = os.open(lib.SUDOERS + '.new', os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o440)
    with os.fdopen(fd, 'w') as f:
        f.write(lib.sudoers_text(user))
    if subprocess.run(['visudo', '-cqf', lib.SUDOERS + '.new'], capture_output=True).returncode != 0:
        os.remove(lib.SUDOERS + '.new')
        raise EfaError('visudo refused the rule of the break-glass admin, nothing was changed.')
    os.replace(lib.SUDOERS + '.new', lib.SUDOERS)


def breakglass_pdf(host, user, codes, when):
    lines = [('h', 'Notfall - sicher verwahren / Emergency - keep safe'),
             ('p', f'Host: {host}'), ('p', f'Break-glass admin / Notfall-Admin: {user}'), ('p', f'Issued / Ausgestellt: {when}'),
             ('table', [('No.', 40), ('One-time code / Einmalcode', 360)], [[str(n), code] for n, code in enumerate(codes, 1)]),
             ('h', 'How to / So geht es'),
             ('p', 'SSH from an admin network: ssh ' + user + '@' + host + ' - at the prompt (Password:) type one code. Local console: the user '
                   'name, then one code. sudo (sudo -i) asks a fresh code each time.'),
             ('p', 'Each code works once. Every try, right or wrong, raises an alarm. After 5 wrong codes in 15 minutes the user is locked '
                   'for 15 minutes; the local console has a counter of its own.'),
             ('p', 'Lost this sheet? Make new codes (Security, break-glass admin): the old ones stop working at once. Keep it offline, '
                   'like a key.')]
    return _lib('efa_pdf').report(f'eFa-next break-glass {host}', lines, footer=f'eFa-next {_efa_version()} - {when}')


# authselect writes these: the lines of the break-glass admin never go there, only into the files of the services.
BREAKGLASS_NEVER_IN = ('/etc/pam.d/system-auth', '/etc/pam.d/password-auth')


def _read_text(path):
    try:
        with open(path) as f:
            return f.read()
    except OSError:
        return None


def breakglass_problems():
    """What a package update (openssh, sudo, util-linux, authselect) may have done to the files of the break-glass admin:
    its lines gone or changed (the jump must still fit the lines), a .rpmnew waiting, the SSH or sudo file changed."""
    lib = _breakglass()
    state = lib.read_state()
    user = state.get('user')
    if not user:
        return []
    problems = []
    for service, tty in BREAKGLASS_PAM.items():
        path = f'/etc/pam.d/{service}'
        text = _read_text(path)
        if text is None or lib.with_guard(text, user, tty) != text:
            problems.append(f'{path}: the lines of the break-glass admin are missing or changed (efactl breakglass-heal)')
        if os.path.exists(path + '.rpmnew'):
            problems.append(f'{path}.rpmnew: a package brought a new version; merge it, then efactl breakglass-heal')
    for path in BREAKGLASS_NEVER_IN:
        if lib.GUARD_MARK in (_read_text(path) or ''):
            problems.append(f'{path}: lines of the break-glass admin in a file of authselect')
    if _read_text(lib.SSHD_FILE) != lib.sshd_text(user, state.get('networks', [])):
        problems.append(f'{lib.SSHD_FILE}: missing or changed (efactl breakglass-heal)')
    if _read_text(lib.SUDOERS) != lib.sudoers_text(user):
        problems.append(f'{lib.SUDOERS}: missing or changed (efactl breakglass-heal)')
    return problems


def breakglass_heal(_args):
    """Puts the files of the break-glass admin back as they must be; a file that is right stays untouched, so a second run
    changes nothing. After every package change (os-check) and every update of eFa-next."""
    lib = _breakglass()
    state = lib.read_state()
    user = state.get('user')
    if not user:
        return {'healed': []}
    healed = []
    for service, tty in BREAKGLASS_PAM.items():
        path = f'/etc/pam.d/{service}'
        text = _read_text(path)
        if text is not None and lib.with_guard(text, user, tty) != text:
            _write(path, lib.with_guard(text, user, tty))
            healed.append(path)
    wanted = lib.sshd_text(user, state.get('networks', []))  # as set last (web-allowlist-set keeps it up to date)
    if _read_text(lib.SSHD_FILE) != wanted:
        previous = _read_text(lib.SSHD_FILE)
        _write(lib.SSHD_FILE, wanted)
        try:
            _sshd_apply()
        except EfaError:
            if previous is None:
                os.remove(lib.SSHD_FILE)
            else:
                _write(lib.SSHD_FILE, previous)
            raise
        healed.append(lib.SSHD_FILE)
    if _read_text(lib.SUDOERS) != lib.sudoers_text(user):
        _breakglass_install(user)
        healed.append(lib.SUDOERS)
    if healed:
        _audit(f'break-glass admin {user}: files put back after a change: {", ".join(healed)}')
    return {'healed': healed, 'problems': breakglass_problems()}


def breakglass_status(_args):
    lib = _breakglass()
    state = lib.read_state()
    if not state.get('user'):
        return {'user': '', 'state': 'none'}
    nets = state.get('networks', [])
    stamp = lambda value: time.strftime('%Y-%m-%d %H:%M', time.localtime(value)) if value else ''
    return {'user': state['user'], 'state': 'ready', 'codes_left': len(state.get('codes', [])), 'issued': stamp(state.get('issued')),
            'last_use': stamp(state.get('last_use')), 'ssh': ('from ' + ', '.join(nets)) if nets else 'off: no admin networks (Security, admin access)',
            'web': ('from ' + ', '.join(nets)) if nets else 'off: no admin networks; the local console stays the way in',
            'refused_from_outside': int(state.get('refused_count', 0)),
            'faillock': dict(lib.FAILLOCK), 'exception': 'documented break-glass exception to MFA: one-time codes only, every use raises an alarm',
            'problems': breakglass_problems()}


def breakglass_issue(args):
    """Makes the break-glass admin (once) and ten new codes; the old ones stop working. The codes exist in clear only in
    this answer: in the PDF, never in a file, a log or the audit."""
    _confirm(args)
    lib = _breakglass()
    state = lib.read_state()
    user = state.get('user') or lib.new_name()
    _breakglass_install(user)
    codes, state = lib.issue(state, user)
    state = _breakglass_sshd(state)
    host = socket.getfqdn()
    when = time.strftime('%Y-%m-%d %H:%M', time.localtime(state['issued']))
    pdf = breakglass_pdf(host, user, codes, when)
    del codes
    _audit(f'break-glass admin {user}: new codes issued by {_dmarc_who()} (PDF, {lib.CODES} codes)')
    return {'user': user, 'codes_left': lib.CODES, 'pdf': base64.b64encode(pdf).decode(), 'name': f'breakglass-{host}.pdf'}


def breakglass_remove(args):
    _confirm(args)
    lib = _breakglass()
    state = lib.read_state()
    user = state.get('user')
    if not user:
        raise EfaError('There is no break-glass admin.')
    for service in BREAKGLASS_PAM:
        path = f'/etc/pam.d/{service}'
        with open(path) as f:
            text = f.read()
        _write(path, lib.without_guard(text))
    for path in (lib.SUDOERS, lib.SSHD_FILE):
        _safe(lambda path=path: os.remove(path), None)
    _safe(_sshd_apply, None)
    subprocess.run(['userdel', '--remove', user], capture_output=True)
    shutil.rmtree(lib.STATE_DIR, ignore_errors=True)
    _audit(f'break-glass admin {user} removed by {_dmarc_who()}')
    return {'user': '', 'state': 'none', 'removed': user}


BREAKGLASS_EVENTS = {'login-ok': 'logged in', 'login-failed': 'a wrong code', 'refused-network': 'refused: not from an admin network',
                     'locked-out': 'locked out after wrong codes', 'web-ok': 'logged in to the web interface', 'web-failed': 'a wrong code (web)'}


def breakglass_alarm(args):
    """Every try of the break-glass admin, right or wrong: audit, syslog, the event for SIEM, OpenTelemetry and Wazuh, a mail to
    every admin, a notice on the dashboard. Called as root by its PAM check (and efa-web); it cannot be switched off."""
    if os.environ.get('SUDO_USER'):
        raise EfaError('Only the check of the break-glass admin raises this alarm.')
    event = (args.event or '').strip()
    if event not in BREAKGLASS_EVENTS:
        raise EfaError('Unknown event.')
    return _breakglass_raise(event, args.source, args.service)


BREAKGLASS_WEB_TRIES = 5  # wrong codes in 15 minutes over the web, as faillock counts them for SSH


def breakglass_login(args):
    """efa-web: a login of the break-glass admin with a code (no TOTP for this user only). Every try raises the alarm; 5 wrong
    codes in 15 minutes lock the web login for 15 minutes."""
    lib = _breakglass()
    code = _secrets(1, 'Code')[0]
    user = (args.user or '').strip()
    source = (args.source or '')[:64]
    state = lib.read_state()
    if not state.get('user') or user != state['user']:
        raise EfaError('Wrong password or 2FA code.')
    now = time.time()
    # Only from the admin networks, as SSH; none set: the web login is off (the console stays the way in). Refused before
    # anything is counted, so nobody from outside can lock the account; its alarm at most once per source in 10 minutes.
    if not lib.in_networks(source, state.get('networks', [])):
        _breakglass_refused(lib, source, now)
        raise EfaError('Wrong password or 2FA code.')
    tries = [at for at in state.get('web_failures', []) if now - at < lib.FAILLOCK['fail_interval']]
    if len(tries) >= BREAKGLASS_WEB_TRIES:
        _breakglass_raise('locked-out', source, 'web')
        raise EfaError('Wrong password or 2FA code.')
    if lib.use_code(code):
        _breakglass_raise('web-ok', source, 'web')
        return {'ok': True, 'user': user, 'codes_left': len(lib.read_state().get('codes', []))}
    with open(os.path.join(lib.STATE_DIR, 'state.lock'), 'w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        state = lib.read_state()
        state['web_failures'] = tries + [now]
        lib.write_state(state)
    _breakglass_raise('web-failed', source, 'web')
    raise EfaError('Wrong password or 2FA code.')


BREAKGLASS_REFUSED_QUIET = 600  # one alarm per source in this time for tries from outside the admin networks


def _breakglass_refused(lib, source, now):
    with open(os.path.join(lib.STATE_DIR, 'state.lock'), 'w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        state = lib.read_state()
        seen = {key: at for key, at in state.get('refused', {}).items() if now - at < BREAKGLASS_REFUSED_QUIET}
        quiet = source in seen
        if not quiet:
            seen[source] = now
        state['refused'], state['refused_count'] = seen, int(state.get('refused_count', 0)) + 1
        lib.write_state(state)
    if not quiet:
        _breakglass_raise('refused-network', source, 'web')


def _breakglass_raise(event, source, service):
    source = re.sub(r'[^A-Za-z0-9.:/_-]', '', source or '')[:64] or 'unknown'
    service = re.sub(r'[^a-z-]', '', service or '')[:16]
    user = _breakglass().read_state().get('user', '?')
    text = f'break-glass admin {user} on {socket.getfqdn()}: {BREAKGLASS_EVENTS[event]} ({service} from {source})'
    _audit(text)
    import syslog
    syslog.openlog('efa-breakglass', 0, syslog.LOG_AUTHPRIV)
    syslog.syslog(syslog.LOG_ALERT, text)
    _event('breakglass', 'critical' if event in ('login-ok', 'web-ok', 'locked-out') else 'warning', action=event, source=source, service=service)
    _admins_notify(f'eFa-next ALARM: break-glass admin on {socket.getfqdn()}', text)
    breakglass_record(text)
    _safe(lambda: _breakglass_tell_master(event, source, service), None)
    return {'alarm': event}


def breakglass_node_alarm(_args):
    """The master: a node's alarm, from the cluster service (as root, the line on stdin): for the dashboard and the audit."""
    if os.environ.get('SUDO_USER'):
        raise EfaError('Only the cluster service notes this.')
    text = re.sub(r'[^A-Za-z0-9 .:/_()-]', '', sys.stdin.read(400)).strip()[:300]
    _audit('cluster ' + text)
    breakglass_record(text)
    return {'noted': True}


def breakglass_record(text):
    alarms = _json_read(BREAKGLASS_ALARMS, [])
    alarms = (alarms if isinstance(alarms, list) else [])[-49:] + [{'at': int(time.time()), 'text': str(text)[:300]}]
    _json_write(BREAKGLASS_ALARMS, alarms, mode=0o600)


def _breakglass_tell_master(event, source, service):
    """A node of a cluster: the alarm to its master too, for the dashboard there (a job with id and expiry, its cert)."""
    cluster, base, state = _cluster_parts()
    if state.get('role') != 'client' or state.get('pending'):
        return
    master = state['master']
    cluster.call(base, master['host'], master['port'], '/v1/alarm',
                 cluster.job_envelope('alarm', event=event, source=source, service=service), timeout=5)


def web_harden(_args):
    """TLS settings, security headers and the ban on failed web logins. Safe to run again."""
    _nginx_apply()
    _write(FAIL2BAN_FILTER, '[Definition]\nfailregex = efa-web login failed from <HOST>\n            efa-web admin address refused from <HOST>\n'
                            'journalmatch = _SYSTEMD_UNIT=efa-web.service + _SYSTEMD_UNIT=efa-portal.service\n')
    if os.path.exists(FAIL2BAN_JAIL):
        # Hosts with fail2ban on from an older release get the sshd filter fix here: web-harden runs on every update.
        if _fail2ban_sshd_fix(True):
            _platform().service_try_restart('fail2ban')
        with open(FAIL2BAN_JAIL) as f:
            jail = f.read()
        if '[efa-web]' not in jail:
            _write(FAIL2BAN_JAIL, jail.rstrip('\n') + '\n\n' + FAIL2BAN_WEB_JAIL)
            subprocess.run(['systemctl', 'try-restart', 'fail2ban'], check=False, capture_output=True)
        elif shutil.which('fail2ban-client') and _safe(lambda: _platform().service_is_active('fail2ban'), False) and \
                subprocess.run(['fail2ban-client', 'status', 'efa-cluster'], capture_output=True).returncode != 0:
            # CL-RECIDIVE, the update: the jail of the cluster and the filter of recidive came with the package; fail2ban loads them once.
            _platform().service_try_restart('fail2ban')
    # web-harden runs on every update: existing hosts get the never-banned admin networks here.
    _safe(fail2ban_never_refresh, False)
    return {'web_harden': 'done'}


def rspamd_sso_set(args):
    """Opens the rspamd web interface through the eFa-next login for reading, for 15, 60 or 240 minutes; then it closes by itself.
    Only the main admin: it shows the mail of every domain."""
    mode = args.mode.strip()
    if mode not in ('off', 'read-only'):
        raise EfaError("Mode must be 'off' or 'read-only'. Changes go through eFa-next, so they keep rights, audit and cluster.")
    if identity_now and identity_now.get('role') != 'super':
        raise EfaError('Only the main admin opens the rspamd web interface: it shows the mail of all domains.')
    minutes = int((getattr(args, 'minutes', '') or '60').strip() or 60) if str(getattr(args, 'minutes', '') or '60').strip().isdigit() else 0
    if mode == 'read-only' and minutes not in RSPAMD_SSO_MINUTES:
        raise EfaError('Minutes: 15, 60 or 240.')
    previous = (_read_lines(RSPAMD_SSO_FILE) or ['off'])[0]
    until = int(time.time()) + minutes * 60 if mode == 'read-only' else 0
    _write(RSPAMD_SSO_FILE, (f'read-only {until}' if until else 'off') + '\n')
    try:
        _nginx_apply()
    except EfaError:
        _write(RSPAMD_SSO_FILE, previous + '\n')
        raise
    # The way out: at the end a timer closes it again; the check of the web login refuses it after that time anyway.
    if until:
        _platform().run_later('efa-rspamd-close', minutes * 60, ['/usr/sbin/efactl', 'rspamd-sso-set', '--mode', 'off'])
    else:
        _platform().service_stop('efa-rspamd-close.timer')
    _audit(f'rspamd access set to {mode}{f" for {minutes} minutes" if until else ""} by {_dmarc_who()}')
    return {'rspamd_sso': mode, 'until': time.strftime('%Y-%m-%d %H:%M', time.localtime(until)) if until else ''}


def rspamd_sso_upgrade(_args):
    """Package update: full access is no longer offered. Open access becomes read-only for an hour, with a notice."""
    old = (_read_lines(RSPAMD_SSO_FILE) or [''])[0].split()
    if old[:1] in (['full'], ['read-only']) and len(old) == 1:
        until = int(time.time()) + 3600
        _write(RSPAMD_SSO_FILE, f'read-only {until}\n')
        _nginx_apply()
        _write(RSPAMD_SSO_UPGRADED, old[0] + '\n')
        _platform().run_later('efa-rspamd-close', 3600, ['/usr/sbin/efactl', 'rspamd-sso-set', '--mode', 'off'])
        return {'rspamd_sso': 'read-only', 'was': old[0]}
    return {'rspamd_sso': _rspamd_sso_mode()}


def audit_rspamd(args):
    """Notes that an admin opened the rspamd web interface."""
    client = args.client.strip()
    ipaddress.ip_address(client)
    _audit(f'rspamd opened, mode {_rspamd_sso_mode()}, admin from {client}')
    return {'logged': True}


def _firewall_state():
    state = _json_read(FIREWALL_FILE, {})
    state.setdefault('allowlist', [])
    state.setdefault('submission', _submission_active())
    # On by default only where the admin uses firewalld: an upgrade must not start a firewall that was off on purpose.
    if 'guard' not in state:
        state['guard'] = subprocess.run(['systemctl', 'is-enabled', 'firewalld'], capture_output=True, text=True).stdout.strip() == 'enabled'
    state.setdefault('pending', None)
    state.setdefault('owned_ports', {})
    state.setdefault('probe_url', '')
    return state


def _submission_active():
    return subprocess.run(['postconf', '-M', 'submission/inet'], capture_output=True, text=True).stdout.strip() != ''


def _ssh_port():
    done = subprocess.run(['sshd', '-T'], capture_output=True, text=True)
    match = re.search(r'^port (\d+)$', done.stdout, re.M)
    return match.group(1) if match else '22'


def _firewall_ports(state):
    """Ports eFa-next needs open. SSH and web are limited separately by the allowlist."""
    ports = ['25', '80', '443', _ssh_port()]
    if state['submission']:
        ports += [port for port, name in (('587', 'submission'), ('465', 'smtps'))
                  if subprocess.run(['postconf', '-M', f'{name}/inet'], capture_output=True, text=True).stdout.strip()]
    return ports


def _firewall_table(state, ssh_port):
    """Our own nftables table. It only limits SSH and web to the allowlist; firewalld and other tables stay as they are."""
    if not state['allowlist']:
        return f'table inet {FIREWALL_TABLE}\ndelete table inet {FIREWALL_TABLE}\n'
    ipv4 = [net for net in state['allowlist'] if ':' not in net]
    ipv6 = [net for net in state['allowlist'] if ':' in net]
    ports = f'{{ {ssh_port}, 443 }}'
    lines = [f'table inet {FIREWALL_TABLE}', f'delete table inet {FIREWALL_TABLE}', f'table inet {FIREWALL_TABLE} {{',
             '  chain input {', '    type filter hook input priority -10; policy accept;',
             '    ct state established,related accept', '    iif "lo" accept']
    if ipv4:
        lines.append(f'    ip saddr {{ {", ".join(ipv4)} }} tcp dport {ports} accept')
    if ipv6:
        lines.append(f'    ip6 saddr {{ {", ".join(ipv6)} }} tcp dport {ports} accept')
    lines += [f'    tcp dport {ports} reject with tcp reset', '  }', '}']
    return '\n'.join(lines) + '\n'


def _firewall_load(state):
    """One nft transaction: it replaces only our table, or leaves everything as it was. Does not need firewalld."""
    done = subprocess.run(['nft', '-f', '-'], input=_firewall_table(state, _ssh_port()), capture_output=True, text=True, timeout=30)
    if done.returncode != 0:
        raise EfaError(f'nft refused the rules, nothing was changed: {done.stderr[-200:]}')


def _firewall_table_ok(state):
    done = subprocess.run(['nft', 'list', 'table', 'inet', FIREWALL_TABLE], capture_output=True, text=True, timeout=30)
    if not state['allowlist']:
        return done.returncode != 0
    return done.returncode == 0 and all(net.split('/')[0] in done.stdout for net in state['allowlist'])


def _fw(*args):
    return subprocess.run(['firewall-cmd'] + list(args), capture_output=True, text=True, timeout=60)


def active_zone_names(text):
    """The zone names in the list of active zones; firewalld 2 (EL10) adds " (default)" to the line of the default zone."""
    return [line.split()[0] for line in text.splitlines() if line.strip() and not line[0].isspace()]


def _firewall_open_zones():
    """Active zones that do not let everything in anyway. Never adds a zone or moves an interface."""
    zones = active_zone_names(_fw('--get-active-zones').stdout)
    return [zone for zone in zones if _fw(f'--zone={zone}', '--get-target').stdout.strip() != 'ACCEPT'
            and _fw('--permanent', f'--zone={zone}', '--get-target').stdout.strip() != 'ACCEPT']


def _firewall_add_ports(state):
    """Adds missing eFa-next ports to the active zones, runtime and permanent, and remembers them. There is never a reload."""
    added = []
    for zone in _firewall_open_zones():
        for port in _firewall_ports(state):
            spec = f'{port}/tcp'
            if _fw(f'--zone={zone}', f'--query-port={spec}').returncode != 0 and not _firewall_service_has(zone, port):
                _fw(f'--zone={zone}', f'--add-port={spec}')
                added.append(f'{zone} {spec}')
                state['owned_ports'].setdefault(zone, [])
                if spec not in state['owned_ports'][zone]:
                    state['owned_ports'][zone].append(spec)
            if _fw('--permanent', f'--zone={zone}', f'--query-port={spec}').returncode != 0 and spec in state['owned_ports'].get(zone, []):
                _fw('--permanent', f'--zone={zone}', f'--add-port={spec}')
    return added


def _firewall_service_has(zone, port):
    names = {'25': 'smtp', '80': 'http', '443': 'https', '22': 'ssh', '587': 'smtp-submission', '465': 'smtps'}
    return port in names and _fw(f'--zone={zone}', f'--query-service={names[port]}').returncode == 0


def _firewall_log(text):
    os.makedirs(os.path.dirname(FIREWALL_LOG), exist_ok=True)
    with open(FIREWALL_LOG, 'a') as log:
        log.write(f'{time.strftime("%Y-%m-%d %H:%M:%S")} {text}\n')


def firewall_set(args):
    """Applies the admin allowlist. It reverts by itself after 5 minutes unless confirmed."""
    state = _firewall_state()
    if state['pending']:
        raise EfaError('A change waits for confirmation: confirm it or let it revert first.')
    nets = []
    for item in args.allowlist.replace(',', ' ').split():
        try:
            net = ipaddress.ip_network(item, strict=False)
        except ValueError:
            raise EfaError(f'Invalid network: {item}')
        if net.prefixlen == 0:
            raise EfaError('An allowlist for the whole internet is the same as an empty list: leave it empty.')
        nets.append(str(net))
    previous = {'allowlist': state['allowlist'], 'submission': state['submission']}
    state['allowlist'] = nets
    if (args.submission or '').strip():
        state['submission'] = _on_off(args.submission)
    state['pending'] = {'previous': previous, 'until': time.strftime('%Y-%m-%d %H:%M:%S', time.localtime(time.time() + 300))}
    # The timer comes first: if applying breaks access, the way back is already armed.
    _firewall_schedule_revert()
    _json_write(FIREWALL_FILE, state)
    _firewall_load(state)
    _firewall_add_ports(state)
    _json_write(FIREWALL_FILE, state)
    _firewall_log(f'changed by {_dmarc_who()}: allowlist {" ".join(nets) or "none"}')
    return {'allowlist': nets, 'confirm_until': state['pending']['until'],
            'note': 'Check that you still have access, then confirm. Otherwise this reverts by itself after 5 minutes.'}


def _firewall_schedule_revert():
    # A fixed time, not --on-active: a daemon-reload, as by a package update, would start a relative timer again.
    when = time.strftime('%Y-%m-%d %H:%M:%S', time.localtime(time.time() + 300))
    done = subprocess.run(['systemd-run', f'--unit={FIREWALL_REVERT_UNIT}', '--collect', f'--on-calendar={when}', '--timer-property=AccuracySec=1s',
                           '/usr/sbin/efactl', 'firewall-revert'], capture_output=True, text=True)
    if done.returncode != 0:
        raise EfaError(f'The safety timer could not start, nothing was changed: {done.stderr[-200:]}')


def firewall_pending_seconds():
    """Seconds until an unconfirmed firewall change is taken back, or None: every page of the web interface shows it."""
    try:
        pending = _firewall_state()['pending']
    except (OSError, ValueError, KeyError):
        return None
    if not pending:
        return None
    left = time.mktime(time.strptime(pending['until'], '%Y-%m-%d %H:%M:%S')) - time.time()
    return max(0, int(left))


def firewall_confirm(_args):
    """Keeps the change and stops the automatic revert."""
    state = _firewall_state()
    if not state['pending']:
        raise EfaError('No change waits for confirmation.')
    subprocess.run(['systemctl', 'stop', f'{FIREWALL_REVERT_UNIT}.timer'], check=False, capture_output=True)
    state['pending'] = None
    _json_write(FIREWALL_FILE, state)
    _firewall_log(f'confirmed by {_dmarc_who()}')
    return {'confirmed': True}


def firewall_revert(_args):
    """Takes back a change that was not confirmed. Works without firewalld, it only replaces our nftables table."""
    state = _firewall_state()
    if not state['pending']:
        return {'reverted': False}
    state.update(state['pending']['previous'])
    state['pending'] = None
    _firewall_load(state)
    _json_write(FIREWALL_FILE, state)
    _firewall_log('not confirmed, reverted')
    _admin_notify('eFa-next: firewall change reverted', 'A firewall change was not confirmed within 5 minutes and was taken back.')
    return {'reverted': True}


def firewall_show(_args):
    """eFa-next firewall rules, zones and warnings."""
    state = _firewall_state()
    if shutil.which('firewall-cmd') is None:
        raise EfaError('firewalld is not installed.')
    # systemd says whether firewalld runs: firewall-cmd --state starts a whole Python client (about 250 ms) for it.
    platform_now = _platform()
    running = platform_now.service_is_active(platform_now.service('firewall'))
    zones = _fw('--get-active-zones').stdout if running else ''
    notes = []
    if 'trusted' in active_zone_names(zones):
        notes.append('An interface is in the zone trusted: all ports stay open there, except SSH and web if an allowlist is set.')
    return {'firewall_allowlist': ' '.join(state['allowlist']), 'firewall_submission': state['submission'], 'running': running,
            'guard': state['guard'], 'waiting_for_confirmation_until': state['pending']['until'] if state['pending'] else None,
            'ports_added_by_efa': state['owned_ports'], 'allowlist_active': _firewall_table_ok(state) and bool(state['allowlist']),
            'notes': notes, 'firewall_probe_url': state['probe_url']}


def firewall_guard_set(args):
    """The guard restores the eFa-next rules every 5 minutes. It never changes anything else."""
    state = _firewall_state()
    state['guard'] = _on_off(args.mode)
    _json_write(FIREWALL_FILE, state)
    return {'guard': state['guard']}


def firewall_guard_status(_args):
    state = _firewall_state()
    return {'guard': state['guard'], 'recent': _read_lines(FIREWALL_LOG)[-10:]}


def _firewall_restart_allowed(now):
    # Jobs that add firewall rules usually run around the full hour, and firewalld failed when restarted during one.
    return 20 <= now.minute <= 50


# Hans 2026-11-18: an admin network is never banned (fail2ban_never), so guessing passwords from inside it is not slowed down;
# instead it is logged and alarmed on every channel there is: syslog auth.crit (journal, rsyslog, remote syslog, Wazuh), the
# audit log, a critical event (events.json: Wazuh, SIEM, OTLP, when on) and a mail to the admin address (ticket systems).
# The firewall guard runs every five minutes on every host (also with the guard off), so the alarm comes within five minutes.
ADMIN_ALARM_STATE = '/var/lib/eFa/admin-net-alarm.json'


def admin_net_failures(lines, networks):
    """The failed logins from the admin networks in these journal lines: [address]."""
    found = []
    for line in lines:
        login = LOGIN_RE.search(line)
        if not login or login.group(1) != 'failed':
            continue
        try:
            if any(ipaddress.ip_address(login.group(3)) in network for network in networks):
                found.append(login.group(3))
        except ValueError:
            continue
    return found


def admin_net_alarms(state, failures, now, tries, window, quiet):
    """The addresses to alarm now: at least `tries` failures within `window` seconds, at most once per `quiet` seconds each.
    state holds {'seen': {address: [times]}, 'alarmed': {address: until}} and is changed in place."""
    seen = {address: [stamp for stamp in times if stamp > now - window] for address, times in state.get('seen', {}).items()}
    for address in failures:
        seen.setdefault(address, []).append(now)
    alarmed = {address: until for address, until in state.get('alarmed', {}).items() if until > now}
    due = []
    for address, times in sorted(seen.items()):
        if len(times) >= tries and address not in alarmed:
            due.append((address, len(times)))
            alarmed[address] = now + quiet
    state['seen'] = {address: times for address, times in seen.items() if times}
    state['alarmed'] = alarmed
    return due


def admin_net_watch():
    networks = [ipaddress.ip_network(item, strict=False) for item in admin_networks()]
    state = _json_read(ADMIN_ALARM_STATE, {})
    lines = _journal_since(state, ('efa-web', 'efa-portal'), grep='login failed from')
    if not networks:
        _json_write(ADMIN_ALARM_STATE, {'cursor': state.get('cursor', '')}, mode=0o600)
        return []
    lockout = _lockout_settings()
    due = admin_net_alarms(state, admin_net_failures(lines, networks), time.time(), lockout['tries'], lockout['minutes'] * 60,
                           lockout['hours'] * 3600)
    _json_write(ADMIN_ALARM_STATE, state, mode=0o600)
    for address, count in due:
        text = (f'{count} failed logins in {lockout["minutes"]} minutes from {address}, an admin network of the web allowlist '
                f'(never banned there): possible password guessing from inside')
        import syslog
        syslog.openlog('efa-security', 0, syslog.LOG_AUTH)
        syslog.syslog(syslog.LOG_CRIT, f'eFa-next ALARM admin network brute force: {text}')
        _audit(f'ALARM: {text}')
        _event('admin_network_bruteforce', 'critical', src_ip=address, count=count, minutes=lockout['minutes'])
        _admin_notify(f'eFa-next ALARM on {own_hostname()}: failed logins from admin network {address}',
                      f'{text}.\n\nHost: {own_hostname()}\nThe address is not banned, because it is in the admin web allowlist. '
                      f'Check who works from {address}; the audit log and the journal of efa-web have the details.')
    return due


def firewall_guard_run(_args):
    """Timer job: starts firewalld if it is down, adds back missing eFa-next ports and restores our table."""
    _safe(admin_net_watch, [])
    _safe(monitor_cron_heal, None)
    state = _firewall_state()
    if not state['guard']:
        return {'guard': 'off'}
    repairs = []
    if not _firewall_table_ok(state):
        _firewall_load(state)
        repairs.append('allowlist table')
    if shutil.which('firewall-cmd') is not None:
        if _fw('--state').returncode != 0:
            subprocess.run(['systemctl', 'start', 'firewalld'], check=False, capture_output=True, timeout=120)
            if _fw('--state').returncode != 0:
                text = 'firewalld does not start. The allowlist still works, opening ports does not.'
                _firewall_log(text)
                _admin_notify('eFa-next: firewall problem', text)
                return {'repaired': repairs, 'problem': text}
            repairs.append('firewalld started')
        elif not _fw('--get-active-zones').stdout.strip():
            # firewalld can run with no zones after an internal error, and then cuts the host off completely.
            if not _firewall_restart_allowed(datetime.datetime.now()):
                text = 'firewalld has no active zones. It restarts in the next safe slot, from minute 20 to 50.'
                _firewall_log(text)
                return {'repaired': repairs, 'waiting': text}
            subprocess.run(['systemctl', 'restart', 'firewalld'], check=False, capture_output=True, timeout=180)
            repairs.append('firewalld restarted, it had no active zones')
        # Fail2Ban stops together with firewalld and does not come back by itself.
        if repairs and subprocess.run(['systemctl', 'is-enabled', '--quiet', 'fail2ban']).returncode == 0:
            subprocess.run(['systemctl', 'start', 'fail2ban'], check=False, capture_output=True, timeout=60)
        repairs += _firewall_add_ports(state)
    if repairs:
        _event('firewall_guard_repair', 'warning', repairs=repairs)
        _json_write(FIREWALL_FILE, state)
        for item in repairs:
            _firewall_log(f'guard repaired: {item}')
        _admin_notify('eFa-next: firewall rules repaired', '\n'.join(repairs))
    return {'repaired': repairs}


# 9m: IP blocklists, feeds and own lists, in the nftables table efa_block (efa_blocklist.py). Settings and own entries in /etc
# (they go to every cluster node), what a feed sent below /var/lib on each node, which fetches it itself.
BLOCKLIST_FILE = ETC + '/eFa/blocklists.json'
BLOCKLIST_DIR = '/var/lib/eFa/blocklists'
# Shared with the package updates of eFa: no list is loaded while dnf runs.
FIREWALL_LOCK = '/run/lock/efa-firewall.lock'
BLOCKLIST_MAX_HOURS = 8760


@contextlib.contextmanager
def _firewall_lock(wait=600):
    """The lock of firewall changes of eFa-next: blocklist runs, and package updates while they run."""
    os.makedirs(os.path.dirname(FIREWALL_LOCK), exist_ok=True)
    with open(FIREWALL_LOCK, 'a') as handle:
        until = time.time() + wait
        while True:
            try:
                fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.time() >= until:
                    raise EfaError('Another firewall change or a package update is running, try again later.')
                time.sleep(1)
        try:
            yield
        finally:
            fcntl.flock(handle, fcntl.LOCK_UN)


def _blocklist_state():
    state = _json_read(BLOCKLIST_FILE, {})
    state.setdefault('lists', {})
    state.setdefault('entries', {})
    return state


def _blocklist_feed_file(name):
    return os.path.join(BLOCKLIST_DIR, name + '.txt')


def _blocklist_allow():
    """Addresses that are never blocked: relay networks, the admin allowlist, the cluster nodes and the own addresses."""
    lib = _lib('efa_blocklist')
    text = ' '.join(_postconf('mynetworks').replace(',', ' ').replace('[', '').replace(']', '').split())
    text += ' ' + ' '.join(_firewall_state()['allowlist'])
    hosts = []

    def walk(value):
        if isinstance(value, dict):
            for key, item in value.items():
                if key in ('host', 'address') and isinstance(item, str):
                    hosts.append(item)
                else:
                    walk(item)
        elif isinstance(value, list):
            for item in value:
                walk(item)
    walk(_lib('efa_cluster').read_state(ETC))
    for host in hosts:
        try:
            text += ' ' + ' '.join({info[4][0] for info in socket.getaddrinfo(host, None, proto=socket.IPPROTO_TCP)})
        except OSError:
            pass
    done = subprocess.run(['ip', '-j', 'addr'], capture_output=True, text=True, timeout=15)
    try:
        text += ' ' + ' '.join(item['local'] for link in json.loads(done.stdout or '[]') for item in link.get('addr_info', []))
    except (ValueError, KeyError, TypeError):
        pass
    return lib.parse_entries(text, allow_private=True)[0]


def _blocklist_tables(state):
    """The lists that are on, as efa_blocklist.nft_script takes them."""
    lib = _lib('efa_blocklist')
    lists = {}
    for name, entry in state['lists'].items():
        if not entry.get('enabled'):
            continue
        feed = []
        if entry.get('kind') == 'feed' and os.path.exists(_blocklist_feed_file(name)):
            with open(_blocklist_feed_file(name)) as f:
                feed = lib.parse_entries(f.read())[0]
        lists[name] = {'ports': entry['ports'], 'feed': feed, 'own': state['entries'].get(name, {})}
    return lists


def _blocklist_load(state):
    """The table efa_block in one nft transaction; without a list that is on, no table at all."""
    lib = _lib('efa_blocklist')
    lists = _blocklist_tables(state)
    script = lib.nft_script(lists, _blocklist_allow(), time.time()) if lists else f'table inet {lib.TABLE}\ndelete table inet {lib.TABLE}\n'
    ok, error = _platform().nft_apply(script)
    if not ok:
        raise EfaError(f'nft refused the blocklists, the loaded ones stay: {error}')


def _blocklist_fetch(name, entry, now):
    """One feed: https only, at most MAX_FEED_BYTES, with ETag and If-Modified-Since; 429 and 503 set when to ask again."""
    lib = _lib('efa_blocklist')
    headers = {'User-Agent': f'eFa-next/{_efa_version()} (blocklist)'}
    if entry.get('etag') and os.path.exists(_blocklist_feed_file(name)):
        headers['If-None-Match'] = entry['etag']
    if entry.get('modified') and os.path.exists(_blocklist_feed_file(name)):
        headers['If-Modified-Since'] = entry['modified']
    request = urllib.request.Request(entry['url'], headers=headers)
    try:
        with urllib.request.urlopen(request, timeout=60, context=ssl.create_default_context()) as answer:
            data = answer.read(lib.MAX_FEED_BYTES + 1)
            if len(data) > lib.MAX_FEED_BYTES:
                raise EfaError(f'larger than {lib.MAX_FEED_BYTES // 1024 // 1024} MB')
            nets, skipped = lib.parse_entries(data.decode('utf-8', 'replace'))
            if not nets:
                raise EfaError('no address in the answer, the list stays as it was')
            os.makedirs(BLOCKLIST_DIR, mode=0o750, exist_ok=True)
            _write(_blocklist_feed_file(name), '\n'.join(str(net) for net in nets) + '\n')
            entry.update(etag=answer.headers.get('ETag', ''), modified=answer.headers.get('Last-Modified', ''), count=len(nets),
                         skipped=skipped, error='')
    except urllib.error.HTTPError as err:
        if err.code == 304:
            entry['error'] = ''
        elif err.code in (429, 503):
            entry['retry_at'] = lib.retry_at(err.headers.get('Retry-After'), now)
            entry['error'] = f'HTTP {err.code}: the feed asks to wait until {time.strftime("%Y-%m-%d %H:%M", time.localtime(entry["retry_at"]))}'
        else:
            entry['error'] = f'HTTP {err.code}'
    except (urllib.error.URLError, OSError, EfaError, ValueError) as err:
        entry['error'] = str(getattr(err, 'reason', err))[:200]
    entry['fetched_at'] = now


def blocklist_show(_args):
    """The IP blocklists: what each one holds, when its feed answered last, and whether the table is loaded."""
    lib = _lib('efa_blocklist')
    state = _blocklist_state()
    now = time.time()
    lists = []
    for name, entry in sorted(state['lists'].items()):
        own = lib.live_entries(state['entries'].get(name, {}), now)
        lists.append({'name': name, 'kind': entry.get('kind'), 'enabled': bool(entry.get('enabled')), 'ports': ','.join(map(str, entry['ports'])) or 'all',
                      'url': entry.get('url', ''), 'interval': entry.get('interval', ''), 'terms_accepted': bool(entry.get('terms_accepted')),
                      'feed_addresses': entry.get('count', 0) if entry.get('kind') == 'feed' else 0, 'own_addresses': len(own),
                      'fetched': time.strftime('%Y-%m-%d %H:%M', time.localtime(entry['fetched_at'])) if entry.get('fetched_at') else '',
                      'error': entry.get('error', '')})
    loaded = _platform().nft_has_table('inet', lib.TABLE)
    known = [{'name': name, 'title': feed['title'], 'url': feed['url'], 'terms': feed['terms']} for name, feed in lib.FEEDS.items()]
    return {**sync_card('blocklists'), 'blocklists': lists, 'loaded': loaded, 'known_feeds': known,
            'warnings': [f'{item["name"]}: {item["error"]}' for item in lists if item['enabled'] and item['error']]}


def blocklist_set(args):
    """Add or change a list: a feed (URL, interval, terms accepted once) or an own list, its ports, on or off."""
    lib = _lib('efa_blocklist')
    name = (args.name or '').strip().lower()
    if lib.name_problem(name):
        raise EfaError(lib.name_problem(name))
    state = _blocklist_state()
    entry = dict(state['lists'].get(name, {}))
    kind = (args.kind or entry.get('kind') or ('feed' if name in lib.FEEDS else 'own')).strip()
    if kind not in ('feed', 'own'):
        raise EfaError('Kind: feed or own.')
    try:
        ports = lib.parse_ports(args.ports or (','.join(map(str, entry['ports'])) or 'all' if 'ports' in entry else '25'))
    except ValueError as err:
        raise EfaError(str(err))
    entry.update(kind=kind, ports=ports, enabled=_on_off(args.mode))
    if kind == 'feed':
        url = (args.url or '').strip() or entry.get('url') or lib.FEEDS.get(name, {}).get('url', '')
        if not url.startswith('https://') or len(url) > 500 or re.search(r'\s', url):
            raise EfaError('Feed address: an https:// address.')
        interval = int(args.interval or entry.get('interval') or 120) if str(args.interval or entry.get('interval') or 120).isdigit() else 0
        if interval not in lib.INTERVALS:
            raise EfaError('Interval in minutes: ' + ', '.join(map(str, lib.INTERVALS)) + '.')
        if url != entry.get('url'):
            entry.update(etag='', modified='', retry_at=0, fetched_at=0)
        entry.update(url=url, interval=interval)
        if (args.accept_terms or '').strip() == 'yes':
            entry['terms_accepted'] = True
        if entry['enabled'] and not entry.get('terms_accepted'):
            raise EfaError('Read the terms of the feed and accept them, then switch it on.')
    state['lists'][name] = entry
    with _firewall_lock(60):
        _json_write(BLOCKLIST_FILE, state)
        _blocklist_load(state)
    return {'name': name, 'enabled': entry['enabled'], 'note': 'A feed is fetched by the next run, within 5 minutes.' if kind == 'feed' else ''}


def blocklist_entry(args):
    """Own entries: add addresses or networks to a list, for some hours or for good, or take them out."""
    lib = _lib('efa_blocklist')
    name = (args.name or '').strip().lower()
    state = _blocklist_state()
    if name not in state['lists']:
        raise EfaError(f'No list {name}. Add it first (blocklist-set).')
    action = (args.action or '').strip()
    nets, skipped = lib.parse_entries(args.addresses, allow_private=True)
    if not nets or skipped:
        raise EfaError('Addresses: IPv4 or IPv6 addresses or networks, separated by spaces or commas.')
    hours = (args.hours or '').strip()
    if hours and (not hours.isdigit() or not 1 <= int(hours) <= BLOCKLIST_MAX_HOURS):
        raise EfaError(f'Hours: 1 to {BLOCKLIST_MAX_HOURS}, or empty for good.')
    allow = _blocklist_allow()
    entries = state['entries'].setdefault(name, {})
    if action == 'add':
        kept = [net for net in nets if any(net.overlaps(other) for other in allow)]
        if kept:
            raise EfaError('Never blocked, these are relay networks, allowed admins, cluster nodes or own addresses: ' + ', '.join(map(str, kept)))
        for net in nets:
            entries[str(net)] = time.time() + int(hours) * 3600 if hours else 0
    elif action == 'remove':
        for net in nets:
            entries.pop(str(net), None)
    else:
        raise EfaError('Action: add or remove.')
    with _firewall_lock(60):
        _json_write(BLOCKLIST_FILE, state)
        _blocklist_load(state)
    return {'name': name, 'own_addresses': len(lib.live_entries(entries, time.time()))}


def blocklist_import(args):
    """Command line only, for efa-migrate: the addresses of a file into an own list, made when it is missing. Addresses that
    are never blocked are left out and counted instead of stopping the import."""
    lib = _lib('efa_blocklist')
    name = (args.name or '').strip().lower()
    if lib.name_problem(name):
        raise EfaError(lib.name_problem(name))
    try:
        ports = lib.parse_ports(args.ports or '25')
    except ValueError as err:
        raise EfaError(str(err))
    hours = (args.hours or '').strip()
    if hours and (not hours.isdigit() or not 1 <= int(hours) <= BLOCKLIST_MAX_HOURS):
        raise EfaError(f'Hours: 1 to {BLOCKLIST_MAX_HOURS}, or empty for good.')
    with open(args.file) as f:
        nets, skipped = lib.parse_entries(f.read(), allow_private=True)
    allow = _blocklist_allow()
    kept = [net for net in nets if not any(net.overlaps(other) for other in allow)]
    state = _blocklist_state()
    entry = state['lists'].setdefault(name, {'kind': 'own', 'enabled': True})
    entry['ports'] = ports
    entries = state['entries'].setdefault(name, {})
    for net in kept:
        entries[str(net)] = time.time() + int(hours) * 3600 if hours else 0
    with _firewall_lock(120):
        _json_write(BLOCKLIST_FILE, state)
        _blocklist_load(state)
    # Command line only: not in the table of the web, so the audit line is written here.
    _audit(f'blocklist-import {name}: {len(kept)} addresses by {_dmarc_who()}')
    return {'name': name, 'imported': len(kept), 'never_blocked': len(nets) - len(kept), 'not_addresses': skipped}


def blocklist_remove(args):
    """Remove a list with its own entries; its addresses are let through again at once."""
    _confirm(args)
    name = (args.name or '').strip().lower()
    state = _blocklist_state()
    if name not in state['lists']:
        raise EfaError(f'No list {name}.')
    state['lists'].pop(name)
    state['entries'].pop(name, None)
    with _firewall_lock(60):
        _json_write(BLOCKLIST_FILE, state)
        _blocklist_load(state)
    if os.path.exists(_blocklist_feed_file(name)):
        os.remove(_blocklist_feed_file(name))
    return {'removed': name}


def blocklist_run(_args):
    """Timer job, every 5 minutes: fetches the feeds that are due, lets run-out own entries go, and loads the table again
    when it is missing (after a boot) or a list changed. Waits for a running package update instead of racing it."""
    lib = _lib('efa_blocklist')
    state = _blocklist_state()
    if not state['lists']:
        return {'lists': 0}
    now, mode = time.time(), sync_mode('blocklists')
    # 6.0.0.6: a cluster node does not fetch the feeds; the master hands on its lists (cluster-sync-apply loads them).
    fetched = [] if mode == 'node' else [name for name, entry in state['lists'].items() if lib.due(entry, now)]
    for name in fetched:
        _blocklist_fetch(name, state['lists'][name], now)
    expired = {name: [address for address, expiry in entries.items() if expiry and expiry <= now] for name, entries in state['entries'].items()}
    for name, addresses in expired.items():
        for address in addresses:
            state['entries'][name].pop(address)
    loaded = _platform().nft_has_table('inet', lib.TABLE)
    wanted = any(entry.get('enabled') for entry in state['lists'].values())
    try:
        with _firewall_lock(30):
            if fetched or any(expired.values()):
                _json_write(BLOCKLIST_FILE, state)
            if fetched or any(expired.values()) or loaded != wanted:
                _blocklist_load(state)
    except EfaError as err:
        return {'skipped': str(err)}
    for name in fetched:
        if state['lists'][name].get('error'):
            _event('blocklist_feed_failed', 'warning', blocklist=name, error=state['lists'][name]['error'])
    if mode == 'master' and fetched:
        _safe(lambda: sync_publish('blocklists', False), None)
    return {'fetched': fetched, 'expired': sum(len(items) for items in expired.values()), 'reloaded': not loaded and wanted}


def _test_blocked(port):
    """A local rule of eFa-next or the admin, so the hint can name it instead of a plain failure."""
    done = subprocess.run(['iptables', '-S', 'OUTPUT'], capture_output=True, text=True, timeout=15)
    return bool(re.search(rf'--dport {port}\b.*-j (REJECT|DROP)', done.stdout))


def _test_tcp(name, host, port, hint):
    start = time.time()
    try:
        with socket.create_connection((host, port), timeout=8):
            return {'test': name, 'result': 'ok', 'ms': int((time.time() - start) * 1000), 'hint': ''}
    except OSError as err:
        blocked = _test_blocked(port)
        return {'test': name, 'result': 'blocked by eFa-next test mode or firewall' if blocked else 'failed',
                'ms': int((time.time() - start) * 1000), 'hint': '' if blocked else f'{err}. {hint}'}


def _test_smtp(name, host, port):
    start = time.time()
    try:
        # Only says hello and leaves, it never sends mail.
        with smtplib.SMTP(host, port, timeout=8, local_hostname=own_hostname()) as smtp:
            code, _reply = smtp.ehlo()
            return {'test': name, 'result': 'ok' if code == 250 else f'answered {code}', 'ms': int((time.time() - start) * 1000), 'hint': ''}
    except (OSError, smtplib.SMTPException) as err:
        blocked = _test_blocked(port)
        return {'test': name, 'result': 'blocked by eFa-next test mode or firewall' if blocked else 'failed',
                'ms': int((time.time() - start) * 1000), 'hint': '' if blocked else f'{err}. Check outbound port {port}.'}


def _test_dns(name, resolver, tcp):
    start = time.time()
    try:
        done = subprocess.run(['dig', '+time=4', '+tries=1', '+tcp' if tcp else '+notcp', '+short', 'SOA', 'example.org', f'@{resolver}'],
                              capture_output=True, text=True, timeout=8)
        ok = done.returncode == 0 and done.stdout.strip()
    except subprocess.TimeoutExpired:
        ok = False
    return {'test': name, 'result': 'ok' if ok else 'failed', 'ms': int((time.time() - start) * 1000),
            'hint': '' if ok else f'{"TCP" if tcp else "UDP"} port 53 to {resolver} does not answer.'}


def _test_ntp(name, host):
    start = time.time()
    try:
        with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as sock:
            sock.settimeout(5)
            sock.sendto(b'\x1b' + 47 * b'\0', (host, 123))
            sock.recv(48)
        return {'test': name, 'result': 'ok', 'ms': int((time.time() - start) * 1000), 'hint': ''}
    except OSError as err:
        return {'test': name, 'result': 'failed', 'ms': int((time.time() - start) * 1000), 'hint': f'{err}. Check outbound UDP 123.'}


def _test_listening(port):
    done = subprocess.run(['ss', '-ltnH', f'sport = :{port}'], capture_output=True, text=True, timeout=10)
    return bool(done.stdout.strip())


def _test_probe(url, port):
    start = time.time()
    try:
        with urllib.request.urlopen(f'{url}?port={port}', timeout=15) as reply:
            result = json.load(reply)
        ok = bool(result.get('open'))
        return {'test': f'From outside: port {port}', 'result': 'ok' if ok else 'failed', 'ms': int((time.time() - start) * 1000),
                'hint': '' if ok else 'The probe could not connect. Check the firewall in front of this server.'}
    except (OSError, ValueError) as err:
        return {'test': f'From outside: port {port}', 'result': 'failed', 'ms': int((time.time() - start) * 1000), 'hint': f'Probe: {err}'}


def firewall_test(args):
    """Checks outbound and inbound connectivity. Every check has a time limit, and no mail is sent."""
    only = (args.only or 'all').strip()
    if only not in ('all', 'dns', 'smtp', 'https', 'http', 'ntp', 'inbound'):
        raise EfaError('Choose all, dns, smtp, https, http, ntp or inbound.')
    state, jobs = _firewall_state(), []
    resolvers = [value for value in _rotation_state()['resolvers'].values() if value] or ['1.1.1.1', '2606:4700:4700::1111']
    if only in ('all', 'dns'):
        for resolver in resolvers:
            jobs += [lambda r=resolver: _test_dns(f'DNS UDP to {r}', r, False), lambda r=resolver: _test_dns(f'DNS TCP to {r}', r, True)]
    if only in ('all', 'smtp'):
        domain = (args.domain or '').strip().lower() or 'example.org'
        lines = subprocess.run(['dig', '+time=4', '+tries=1', '+short', 'MX', domain], capture_output=True, text=True, timeout=10).stdout.split('\n')
        mx = lines[0].split()[-1].rstrip('.') if lines and lines[0].strip() else ''
        if mx:
            jobs.append(lambda: _test_smtp(f'SMTP 25 to MX of {domain}', mx, 25))
        else:
            jobs.append(lambda: {'test': f'SMTP 25 to MX of {domain}', 'result': 'skipped', 'ms': 0, 'hint': 'No MX found.'})
        relay = _postconf('relayhost').replace('[', '').replace(']', '')
        if relay:
            host = relay.split(':')[0]
            jobs += [lambda: _test_tcp(f'Smarthost {host}:{port}', host, port, 'Check the smarthost.') for port in (587, 465)]
    if only in ('all', 'https'):
        jobs += [lambda h=host: _test_tcp(f'HTTPS to {h}', h, 443, 'Updates need this.') for host in UPDATE_TEST_HTTPS]
    if only in ('all', 'http'):
        jobs += [lambda h=host: _test_tcp(f'HTTP to {h}', h, 80, 'Certificates and OS repos need this.') for host in UPDATE_TEST_HTTP]
    if only in ('all', 'ntp'):
        jobs.append(lambda: _test_ntp('NTP to pool.ntp.org', 'pool.ntp.org'))
    rows = []
    if only in ('all', 'inbound'):
        running = _fw('--state').returncode == 0 if shutil.which('firewall-cmd') else False
        rows.append({'test': 'firewalld running', 'result': 'ok' if running else 'failed', 'ms': 0, 'hint': ''})
        rows.append({'test': 'Firewall guard', 'result': 'on' if state['guard'] else 'off', 'ms': 0, 'hint': ''})
        for port in _firewall_ports(state):
            rows.append({'test': f'Listening on port {port}', 'result': 'ok' if _test_listening(port) else 'failed', 'ms': 0,
                         'hint': '' if _test_listening(port) else 'No service listens on this port.'})
        if state['probe_url']:
            jobs += [lambda p=port: _test_probe(state['probe_url'], p) for port in ('25', '443', '80', _ssh_port())]
    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
        rows += list(pool.map(lambda job: job(), jobs))
    outside = None
    if only in ('all', 'inbound') and not state['probe_url']:
        outside = ('No probe is set. From another machine run, with your server address: nc -vz SERVER 25; nc -vz SERVER 443; '
                   'nc -vz SERVER 80; or run efa-probe on a server of yours and set its address here.')
    when = time.strftime('%Y-%m-%d %H:%M:%S')
    text = '\n'.join([f'eFa-next firewall test {when}'] + [f'{row["test"]}: {row["result"]} ({row["ms"]} ms) {row["hint"]}'.rstrip() for row in rows]) + '\n'
    return {'when': when, 'tests': rows, 'outside_check': outside, 'text': text}


def firewall_probe_set(args):
    """Address of your own efa-probe, which checks from outside whether this server answers."""
    url = args.url.strip()
    if url and not re.match(r'^https?://[A-Za-z0-9.:\[\]-]+(/[A-Za-z0-9._/-]*)?$', url):
        raise EfaError('Invalid probe address.')
    state = _firewall_state()
    state['probe_url'] = url
    _json_write(FIREWALL_FILE, state)
    return {'probe_url': url}


def _system_state():
    state = _json_read(UPDATE_SYSTEM_FILE, {})
    for key in ('state', 'started', 'finished', 'result', 'backup', 'config_export'):
        state.setdefault(key, None)
    return state


def _system_log(text):
    os.makedirs(os.path.dirname(UPDATE_SYSTEM_LOG), exist_ok=True)
    with open(UPDATE_SYSTEM_LOG, 'a') as log:
        log.write(f'{time.strftime("%Y-%m-%d %H:%M:%S")} {text}\n')


def _progress_lib():
    return _lib('efa_update_progress')


def _progress_write(record):
    os.makedirs(os.path.dirname(UPDATE_PROGRESS), exist_ok=True)
    _json_write(UPDATE_PROGRESS, record, mode=0o644)


def _progress_begin(kind, efa_update=True, reboot=False, dry_run=False, to=None):
    """A new progress record of the Update card: system (update-system) or efa (install of an eFa-next release)."""
    now = time.time()
    steps = _progress_lib().steps_of(kind, efa_update=efa_update and not dry_run, reboot=reboot and not dry_run)
    # A dry run installs nothing: backup, check and the health check.
    steps = [step for step in steps if not dry_run or step != 'os']
    record = {'kind': kind, 'state': 'running', 'steps': steps,
              'step': None, 'step_started': now, 'started': now, 'started_text': time.strftime('%Y-%m-%d %H:%M:%S'), 'finished': None,
              'from': _update_installed(), 'to': to, 'packages': None, 'line': None, 'result': None, 'took': {}, 'pid': os.getpid(),
              'dry_run': dry_run, 'reboot': reboot}
    _progress_write(record)
    return record


def _progress_step(record, step, **changes):
    """The next step of a run: the one before gets its seconds (for the time left of the next run)."""
    if not record:
        return
    now = time.time()
    if record.get('step'):
        record['took'][record['step']] = round(now - record['step_started'])
    if step not in record['steps']:
        record['steps'] = [name for name in _progress_lib().KINDS[record['kind']] if name in record['steps'] or name == step]
    record.update(step=step, step_started=now, packages=None, line=None, verifying=False, **changes)
    _progress_write(record)


def _progress_end(record, ok, result, state=None):
    """The end of a run: done or failed with its result; a good run keeps the seconds of its steps."""
    if not record:
        return
    now = time.time()
    if record.get('step') and state != 'rebooting':
        record['took'][record['step']] = round(now - record['step_started'])
    record.update(state=state or ('done' if ok else 'failed'), result=result)
    if state != 'rebooting':
        record.update(finished=now, finished_text=time.strftime('%Y-%m-%d %H:%M:%S'), pid=None)
        if ok:
            record['step'] = None
            durations = _json_read(UPDATE_DURATIONS, {})
            durations[record['kind']] = {**durations.get(record['kind'], {}), **_progress_lib().durations_after(record)}
            _json_write(UPDATE_DURATIONS, durations, mode=0o644)
    _progress_write(record)


def _dnf_with_progress(command, record, timeout, pass_fds=()):
    """dnf with its output read line by line: the package counter of the transaction goes into the progress record (at
    most once a second). Returns (returncode, stdout tail, stderr tail); raises subprocess.TimeoutExpired like run()."""
    import collections
    import threading
    lib = _progress_lib()
    process = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, bufsize=1, pass_fds=pass_fds)
    # A dnf that hangs without a line is stopped too: the timer kills it, the loop below then ends.
    expired = threading.Event()
    timer = threading.Timer(timeout, lambda: (expired.set(), process.kill()))
    timer.daemon = True
    timer.start()
    errors = []
    reader = threading.Thread(target=lambda: errors.append(process.stderr.read()), daemon=True)
    reader.start()
    tail, written = collections.deque(maxlen=400), 0.0
    try:
        for line in process.stdout:
            tail.append(line)
            found = lib.dnf_line(line)
            if found and record:
                record.update(packages=[found[0], found[1]], verifying=found[3], line=line.strip()[:200])
                if time.time() - written >= 1 or found[0] == found[1]:
                    _progress_write(record)
                    written = time.time()
        process.wait()
    finally:
        timer.cancel()
    reader.join(5)
    process.stdout.close()
    process.stderr.close()
    if expired.is_set():
        raise subprocess.TimeoutExpired(command, timeout)
    return process.returncode, ''.join(tail), ''.join(errors)


def update_progress(_args):
    """For the Update card: the versions, what is pending, the running or last update with its step, percentage and time left.
    Reads only small files, no dnf and no network: the card asks for it every few seconds while an update runs."""
    lib = _progress_lib()
    record = _json_read(UPDATE_PROGRESS, {})
    # A run of a version before this card (the update to it, while its old efactl still runs) writes no record: its state in
    # update-system.json still shows that something runs, for up to 3 hours after its start.
    system = _system_state()
    if record.get('state') not in lib.ACTIVE and system['state'] in ('running', 'rebooting') and system['started'] and \
            (record.get('started_text') or '') < system['started'] and \
            time.time() - time.mktime(time.strptime(system['started'], '%Y-%m-%d %H:%M:%S')) < 3 * 3600:
        record = {'kind': 'system', 'state': system['state'], 'steps': lib.steps_of('system'), 'step': None, 'started_text': system['started'],
                  'from': _update_installed(), 'backup': system.get('backup')}
    # A run whose process is gone (a crash, a kill) is not running any more; a reboot is the post-boot check's to end.
    if record.get('state') == 'running' and record.get('pid') and not _pid_alive(record['pid']):
        record.update(state='failed', result=record.get('result') or 'The update stopped without a result. See efactl update-status.')
    if record.get('state') == 'waiting' and record.get('at') and time.time() > record['at'] + 900:
        record.update(state='failed', result='The planned update did not start. See efactl update-status.')
    shown = lib.view(record, _json_read(UPDATE_DURATIONS, {}).get(record.get('kind'), {}), time.time())
    state = _update_state()
    pending = _json_read(UPDATE_PENDING_FILE, {})
    latest = state['latest'] or ''
    return {'progress': shown, 'installed': _update_installed(), 'latest': latest + (' (pre-release)' if latest and state.get('prerelease') else ''),
            'efa_update': _update_available(state), 'security_update': bool(state.get('security')) and _update_available(state),
            'last_check': state['last_check'], 'mode': state['mode'], 'days': ' '.join(state['days']), 'time': state['time'],
            'os_pending': pending.get('count'), 'os_checked': pending.get('at'), 'reboot_required': pending.get('reboot_required'),
            'os_held': pending.get('held') or [],
            'window': list(UPDATE_WINDOW), 'rollback': bool(_json_read(UPDATE_PREVIOUS, None))}


def _pending_note(packages, reboot=None, held=None):
    """What the last check found, for the Update card (update-progress reads it without calling dnf). held: the packages the
    last system update left out because dnf could not resolve them (None keeps the list of before)."""
    try:
        os.makedirs(os.path.dirname(UPDATE_PENDING_FILE), exist_ok=True)
        if held is None:
            held = _json_read(UPDATE_PENDING_FILE, {}).get('held', [])
        _json_write(UPDATE_PENDING_FILE, {'count': len(packages), 'at': time.strftime('%Y-%m-%d %H:%M'), 'reboot_required': reboot, 'held': held},
                    mode=0o644)
    except OSError:
        pass


# 2026-11-17 (an EPEL upgrade that needs a newer python3-cryptography than the distribution has): one upgrade dnf cannot
# resolve stopped the whole system update. dnf leaves such upgrades out and updates the rest; it never removes or downgrades
# for it (no --allowerasing). dnf 4 (EL9) and dnf 5 (EL10) both take these options.
DNF_SKIP = ('--setopt=best=False', '--skip-broken')
UPDATE_DOWNLOADED = None


def dnf_problem(stderr, limit=600):
    """The lines of a dnf error that say why: the problem lines whole (never cut inside a word), else the last lines."""
    lines = [line.strip() for line in (stderr or '').splitlines() if line.strip()]
    wanted = [line for line in lines if re.match(r'(Problem|Error|- |nothing provides|package |cannot install|conflicting)', line, re.I)] or lines[-4:]
    text = ''
    for line in wanted:
        if len(text) + len(line) + 2 > limit:
            break
        text += ('; ' if text else '') + line
    return text or (lines[-1][:limit] if lines else '')


def held_back(pending, downloaded, security=(), required=lambda name: []):
    """The pending upgrades the download of the check left out: [{'package', 'version', 'repository', 'security', 'efa'}].
    security: names with a security advisory; required(name): installed packages that need it (eFa-next marks it)."""
    got = set(downloaded)
    held = []
    for item in pending:
        name = item['package'].rsplit('.', 1)[0]
        if name in got:
            continue
        held.append({'package': name, 'version': item.get('version', ''), 'repository': item.get('repository', ''),
                     'security': name in security, 'efa': any(pkg.startswith('eFa') for pkg in required(name))})
    return sorted(held, key=lambda item: (not item['security'], not item['efa'], item['package']))


def _held_now(pending, risky):
    """held_back of this run: what the download of the check left out (and not left out on purpose for firewalld)."""
    if UPDATE_DOWNLOADED is None or not pending:
        return []
    platform_now = _platform()
    security = {item['package'] for item in _safe(platform_now.security_updates, [])}
    return [item for item in held_back(pending, UPDATE_DOWNLOADED, security, lambda name: _safe(lambda: platform_now.package_required_by(name), []))
            if item['package'] not in risky]


def held_text(held):
    """One line for the result, the log and the notice."""
    return ', '.join(item['package'] + (' (security update)' if item['security'] else '') + (' (needed by eFa-next)' if item['efa'] else '')
                     for item in held)


# Package scripts that reload or restart firewalld can take the firewall down while other tools change it
# (some run at the full hour). Those packages are left out of a system update, and the update starts only in this window.
UPDATE_WINDOW = (20, 50)
FIREWALL_SCRIPT_RE = re.compile(r'firewall-cmd\b[^\n]*--(complete-)?reload|systemctl\b[^\n]*\b(restart|reload|try-restart|reload-or-restart|start)\b[^\n]*\bfirewalld'
                                r'|systemd-update-helper\b[^\n]*\bmark-restart-system-units\b[^\n]*\bfirewalld|%systemd_postun_with_restart[^\n]*firewalld', re.I)


def firewall_script_lines(scripts):
    """Lines of package scripts that would reload or restart firewalld."""
    return [line.strip() for line in scripts.splitlines() if FIREWALL_SCRIPT_RE.search(line)]


def update_window_wait(now):
    """None inside the window, else the next start time as a datetime."""
    if UPDATE_WINDOW[0] <= now.minute <= UPDATE_WINDOW[1]:
        return None
    start = now.replace(minute=UPDATE_WINDOW[0], second=0, microsecond=0)
    return start if now.minute < UPDATE_WINDOW[0] else start + datetime.timedelta(hours=1)


def _firewall_risky_updates():
    """{package: script line} for pending updates whose scripts or triggers touch firewalld. Downloads them, installs nothing."""
    global UPDATE_DOWNLOADED
    folder = tempfile.mkdtemp(prefix='efa-upd-check-', dir='/var/tmp')
    try:
        done = subprocess.run(['dnf', '-y', '-q', 'upgrade', '--downloadonly', f'--downloaddir={folder}', *DNF_SKIP, '--exclude=eFa-next', '--exclude=eFa-next-base', '--exclude=eFa', '--exclude=eFa-base'],
                              capture_output=True, text=True, timeout=1800)
        if done.returncode != 0:
            raise EfaError(f'Downloading the updates for the check failed: {dnf_problem(done.stderr)}')
        risky, UPDATE_DOWNLOADED = {}, []
        for path in sorted(glob.glob(folder + '/*.rpm')):
            info = subprocess.run(['rpm', '-qp', '--qf', '%{NAME}', path], capture_output=True, text=True).stdout.strip()
            UPDATE_DOWNLOADED.append(info)
            scripts = subprocess.run(['rpm', '-qp', '--scripts', '--triggers', path], capture_output=True, text=True).stdout
            lines = firewall_script_lines(scripts)
            if info and lines:
                risky[info] = lines[0][:160]
        return risky
    finally:
        shutil.rmtree(folder, ignore_errors=True)


def _pending_os_updates():
    done = subprocess.run(['dnf', '-q', 'check-update'], capture_output=True, text=True, timeout=300)
    # 100 means updates exist, 0 none, anything else is an error.
    if done.returncode not in (0, 100):
        raise EfaError(f'dnf check-update failed: {dnf_problem(done.stderr)}')
    packages = []
    for line in done.stdout.splitlines():
        parts = line.split()
        if len(parts) == 3 and '.' in parts[0] and not line.startswith(' '):
            packages.append({'package': parts[0], 'version': parts[1], 'repository': parts[2]})
    return packages


def _reboot_required():
    if shutil.which('needs-restarting') is None:
        return None
    return subprocess.run(['needs-restarting', '-r'], capture_output=True, timeout=120).returncode == 1


# Hans 2026-11-20 (criterion 3 of 6.0.0.6): the base system (ClamAV, Redis/Valkey, nginx, Python, Fail2Ban ...) updates with a
# plain dnf in its branch. A package script restarts its own service, but nothing restarts a service after a library it loads
# changed (openssl, glibc, the Python modules of efa-web and the milters): after every package change the services of
# eFa-next that still run a replaced file restart here, the base first, then those of eFa-next.
RESTART_FIRST = ('mariadb', 'redis', 'valkey', 'unbound', 'clamd@scan', 'clamav-freshclam', 'rspamd', 'fail2ban', 'postfix', 'dovecot')
# Never: firewalld (a restart drops its runtime rules), nginx (nginx_after_update, after nginx -t) and the units that run this
# check, an update or another job of efactl (their restart would end it); those take the new files with their next start.
RESTART_NEVER = ('firewalld', 'nginx', 'efactl-runner', 'efa-os-check', 'efa-update', 'efa-autoupdate', 'efa-release-upgrade',
                 'efa-cluster-harden', 'efa-cluster-activate')


def services_to_restart(stale):
    """Of the units needs-restarting -s names, the services of eFa-next to restart, in their order."""
    names = [name[:-len('.service')] if name.endswith('.service') else name for name in stale]
    names = [name for name in names if not name.startswith(RESTART_NEVER)]
    return [name for name in RESTART_FIRST if name in names] + sorted(name for name in names if name.startswith('efa') and name not in RESTART_FIRST)


# needs-restarting sees replaced libraries (.so), not Python modules read once at the start: a service of eFa-next started
# before one of these packages was installed runs old Python code.
PYTHON_PACKAGES = ('python3', 'python3-libs', 'python3-flask', 'python3-werkzeug', 'python3-jinja2', 'python3-markupsafe',
                   'python3-itsdangerous', 'python3-click', 'python3-waitress', 'python3-PyMySQL', 'python3-pymilter',
                   'python3-cryptography', 'python3-cffi')
EFA_UNIT_DIR = '/usr/lib/systemd/system'


def _python_stale_services(platform_now):
    """The running services of eFa-next started before the newest of PYTHON_PACKAGES was installed."""
    newest = max((platform_now.package_install_time(name) for name in PYTHON_PACKAGES), default=0)
    if not newest:
        return []
    units = sorted(os.path.basename(path) for path in glob.glob(EFA_UNIT_DIR + '/efa*.service') if '@' not in os.path.basename(path))
    return [unit for unit in units if platform_now.service_is_active(unit[:-len('.service')])
            and 0 < platform_now.service_started_at(unit[:-len('.service')]) < newest]


def restart_stale_services(platform_now):
    """Restarts the services of eFa-next that still run a file a package update replaced; returns their names."""
    stale = list(_safe(lambda: _python_stale_services(platform_now), []))
    if shutil.which('needs-restarting'):
        done = subprocess.run(['needs-restarting', '-s'], capture_output=True, text=True, timeout=120)
        stale += [line.strip() for line in done.stdout.splitlines() if line.strip()]
    names = services_to_restart(dict.fromkeys(stale))
    for name in names:
        platform_now.service_restart(name, check=False)
    if names:
        _audit(f'restarted after a package update, they still ran replaced files: {", ".join(names)}')
    return names


def update_pending(_args):
    """What an update of the system would install, and whether a reboot is due."""
    update = _update_state()
    # UPD-ALPHA-DISP: the testing channel names a pre-release with the tag of its numbers (v6.0.0.6); shown as such, and never
    # offered over the same pre-release (_update_available).
    latest = update['latest'] + (' (pre-release)' if update['latest'] and update.get('prerelease') else '')
    packages, reboot = _pending_os_updates(), _reboot_required()
    _pending_note(packages, reboot)
    return {'os_updates': packages, 'efa_installed': _update_installed(), 'efa_latest': latest,
            'efa_update': _update_available(update), 'reboot_required': reboot}


def update_status(_args):
    """State of the last system update, with its log."""
    state = _system_state()
    lines = _read_lines(UPDATE_SYSTEM_LOG)
    return {**state, 'log': lines[-40:]}


def _managed_update_text():
    master = _safe(lambda: _lib('efa_cluster').read_state(ETC).get('master', {}).get('name'), None) or 'the master'
    return (f'Managed by {master}: a node of a cluster installs updates only in the staged rollout, one node after the other. '
            f'Start it or change the update settings on {master}.')


def update_system(args):
    """Backup and config export first, then OS and eFa-next updates in the background, optionally with a reboot. In a
    cluster (6.0.0.6.7) the master starts the staged rollout instead; a node refuses it."""
    _confirm(args)
    reboot = (args.reboot or 'off').strip() == 'on'
    if reboot and (args.reboot_confirm or '').strip() != 'yes':
        raise EfaError('The automatic reboot is at your own risk and mail is not accepted during it. '
                       "Type 'yes' in the reboot field to accept that.")
    dry = (args.dry_run or '').strip() == 'yes'
    role = cluster_role()
    if role == 'client' and not dry:
        raise EfaError(_managed_update_text())
    if role == 'master' and not dry:
        policy = _update_policy()
        return cluster_update_start({'os': policy['os'] if policy['os'] != 'off' else 'all', 'efa': True})
    return _system_start('on' if reboot else 'off', dry)


def update_staged_run(args):
    """6.0.0.6.7: one step of the staged rollout on this node, sent by the master: the system update with the policy of the
    cluster (os off, security or all; eFa-next yes or no), a reboot when the packages need one, under a lease."""
    if acting_client != 'cluster-master':
        raise EfaError('Only the master of the cluster starts a step of its rollout.')
    job, os_policy, efa = (args.job or '').strip(), (args.os or '').strip(), (args.efa or '').strip()
    if not re.fullmatch(r'[a-z0-9-]{4,60}', job) or os_policy not in UPDATE_OS or efa not in ('yes', 'no'):
        raise EfaError('A step of the rollout needs its job, os (off, security, all) and efa (yes, no).')
    _update_lease_take(job)
    try:
        return _system_start('auto', False, os_policy, efa, job)
    except EfaError:
        _update_lease_drop(job)
        raise


def _system_start(reboot_arg, dry, os_policy='all', efa='yes', job=''):
    """update-system-run in the background, in the minutes of the window (UPDATE_WINDOW)."""
    reboot = reboot_arg == 'on'
    blocker = _update_blocker()
    if blocker:
        raise EfaError(blocker)
    start = update_window_wait(datetime.datetime.now())
    timer = ['--on-calendar=' + start.strftime('%Y-%m-%d %H:%M:00'), '--timer-property=AccuracySec=1s'] if start and not dry else []
    done = subprocess.run(['systemd-run', '--unit=efa-update-system', '--collect', *timer, '/usr/sbin/efactl', 'update-system-run',
                           f'--reboot={reboot_arg}', f'--dry_run={"yes" if dry else "no"}', f'--os={os_policy}', f'--efa={efa}',
                           *([f'--job={job}'] if job else [])],
                          capture_output=True, text=True)
    if done.returncode != 0:
        raise EfaError(f'Could not start: {done.stderr[-200:]}')
    if timer:
        # The Update card shows the planned start until the run takes over the record.
        lib = _progress_lib()
        _progress_write({'kind': 'system', 'state': 'waiting', 'steps': lib.steps_of('system', efa_update=efa == 'yes' and _update_available(_update_state()), reboot=reboot),
                         'step': None, 'at': start.timestamp(), 'at_text': start.strftime('%Y-%m-%d %H:%M'), 'from': _update_installed(),
                         'to': _update_state()['latest'] if _update_available(_update_state()) else None, 'reboot': reboot, 'dry_run': dry})
        return {'update': f"will run at {start.strftime('%H:%M')}", 'why': f'System updates start only between minute {UPDATE_WINDOW[0]} and {UPDATE_WINDOW[1]}.',
                'dry_run': dry, 'reboot': reboot, 'progress': 'efactl update-status'}
    return {'update': 'started', 'dry_run': dry, 'reboot': reboot, 'progress': 'efactl update-status'}


# 6.0.0.6.7 (c): a node holds a lease while a step of the rollout (or its fallback) runs; a second job is refused until it
# ends or expires. The bound is longer than the master waits for a node (the health window of at most 4 h, 1 h more for the
# reboot), so a node that dies with it never blocks the cluster: the master stops the rollout first, the lease then expires.
UPDATE_LEASE = '/var/lib/eFa/update-lease.json'
UPDATE_LEASE_SECONDS = 6 * 3600


def _update_lease_valid(now=None):
    lease = _json_read(UPDATE_LEASE, {})
    return lease if isinstance(lease, dict) and lease.get('until', 0) > (time.time() if now is None else now) else None


def _update_lease_take(job, now=None):
    now = time.time() if now is None else now
    held = _update_lease_valid(now)
    if held and held.get('job') != job:
        raise EfaError(f"Another update holds this node until {time.strftime('%Y-%m-%d %H:%M', time.localtime(held['until']))} ({held.get('job')}).")
    os.makedirs(os.path.dirname(UPDATE_LEASE), exist_ok=True)
    _json_write(UPDATE_LEASE, {'job': job, 'since': int(now), 'until': int(now + UPDATE_LEASE_SECONDS)}, mode=0o644)


def _update_lease_drop(job):
    if job and _json_read(UPDATE_LEASE, {}).get('job') == job:
        _safe(lambda: os.remove(UPDATE_LEASE), None)


# 6.0.0.6.7: hooks of the admin around the system update and a wrapper for its dnf transaction (efa_update_hooks).
UPDATE_HOOKS_DIR = ETC + '/eFa/update-hooks.d'


def _hook_alarm(text):
    _audit(f'update hook: {text}')
    _event('update_hook_refused', 'warning', reason=text[:200])
    _admins_notify('eFa-next: update hook refused / Update-Hook abgelehnt', f'{text}\n\nA hook runs only when it and every folder above it '
                   'belong to root and are not writable by group or others, and it is a regular file (no symlink). See the manual, Updates.')


# EVERY dnf transaction eFa-next starts goes through _dnf_transaction (tests/test_update_policy.DnfCallSites lists them):
# the update, the install of a release, the way back, the rollout step, the fallback, the packages of a feature, Wazuh, the
# offline bundle, the tool of the release upgrade. The outermost one runs the pre hooks (a veto stops it) and the post hooks;
# every dnf inside runs through the wrapper when one is set. leapp's own transaction (in its upgrade environment after the
# reboot) cannot be wrapped: the pre hooks of the release upgrade run before it, a veto stops it there.
_HOOKS_NOW = {'depth': 0, 'wrapper': None}


@contextlib.contextmanager
def _update_hooks(kind, job='', os_policy='', dry=False):
    if _HOOKS_NOW['depth']:
        _HOOKS_NOW['depth'] += 1
        try:
            yield
        finally:
            _HOOKS_NOW['depth'] -= 1
        return
    lib = _lib('efa_update_hooks')
    found, fd = lib.wrapper(UPDATE_HOOKS_DIR), None
    if found is not None:
        fd, problem = found
        if problem:
            _hook_alarm(f'wrapper refused, {kind} does not run: {problem}')
            raise EfaError(f'Not done: the update wrapper failed its check ({problem}).')
    env = {**os.environ, 'EFA_UPDATE_KIND': kind, 'EFA_UPDATE_JOB': job, 'EFA_UPDATE_OS': os_policy, 'EFA_UPDATE_DRY_RUN': 'yes' if dry else 'no'}
    try:
        pre = lib.run_phase(UPDATE_HOOKS_DIR, 'pre', env)
        for name, problem in pre['refused']:
            _hook_alarm(f'pre hook {name} left out: {problem}')
        if not pre['ok']:
            raise EfaError('Not done: a pre hook said no: ' + '; '.join(f'{name} ({why})' for name, why in pre['failed']))
        _HOOKS_NOW.update(depth=1, wrapper=fd)
        try:
            yield
        finally:
            _HOOKS_NOW.update(depth=0, wrapper=None)
            post = lib.run_phase(UPDATE_HOOKS_DIR, 'post', env)
            for name, problem in post['refused']:
                _hook_alarm(f'post hook {name} left out: {problem}')
            for name, why in post['failed']:
                _hook_alarm(f'post hook {name} failed: {why}')
    finally:
        if fd is not None:
            os.close(fd)


def _dnf_command(argv):
    """(command, extra arguments of subprocess): the dnf command line through the wrapper while one is set."""
    fd = _HOOKS_NOW['wrapper']
    return ([f'/proc/self/fd/{fd}', *argv], {'pass_fds': (fd,)}) if fd is not None else (list(argv), {})


def _dnf_transaction(argv, kind, **kwargs):
    """One dnf transaction, inside the hooks (see above). Returns the CompletedProcess."""
    with _update_hooks(kind):
        command, extra = _dnf_command(argv)
        return subprocess.run(command, **kwargs, **extra)


def _dnf_install(packages, kind):
    """dnf install of packages or local files, inside the hooks; an error says why."""
    done = _dnf_transaction(['dnf', '-y', 'install', *packages], kind, capture_output=True, text=True)
    if done.returncode != 0:
        raise EfaError(f"dnf install {' '.join(os.path.basename(str(name)) for name in packages)[:120]} failed: {dnf_problem(done.stderr or done.stdout)}")
    return done


def _dnf_run_for(kind):
    """The runner the platform layer takes for its dnf calls (release upgrade): a CompletedProcess, never raising."""
    return lambda argv: _dnf_transaction([str(part) for part in argv], kind, capture_output=True, text=True)


def update_system_run(args):
    """The background part of update-system."""
    lock = open(UPDATE_LOCK, 'w')
    try:
        import fcntl
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        raise EfaError('Another update is running.')
    job = (getattr(args, 'job', '') or '').strip()
    os_policy = (getattr(args, 'os', '') or 'all').strip()
    efa_wanted = (getattr(args, 'efa', '') or 'yes').strip() == 'yes'
    state = _system_state()
    state.update(state='running', started=time.strftime('%Y-%m-%d %H:%M:%S'), finished=None, result=None, job=job or None)
    dry = args.dry_run.strip() == 'yes'
    reboot_arg = args.reboot.strip()
    reboot = reboot_arg == 'on'
    update = _update_state()
    progress = _progress_begin('system', efa_update=efa_wanted and _update_available(update), reboot=reboot_arg != 'off', dry_run=dry,
                               to=update['latest'] if efa_wanted and _update_available(update) else None)
    hooks_lib = _lib('efa_update_hooks')
    hook_env = {**os.environ, 'EFA_UPDATE_JOB': job, 'EFA_UPDATE_OS': os_policy, 'EFA_UPDATE_DRY_RUN': 'yes' if dry else 'no'}
    wrapper_fd = None

    def finish(result, ok):
        state.update(state='done' if ok else 'failed', finished=time.strftime('%Y-%m-%d %H:%M:%S'), result=result)
        _json_write(UPDATE_SYSTEM_FILE, state)
        _system_log(result)
        _progress_end(progress, ok, result)
        _admin_notify(f'eFa-next: system update {"finished" if ok else "failed"}', result)
        _update_lease_drop(job)
        _HOOKS_NOW.update(depth=0, wrapper=None)
        if wrapper_fd is not None:
            os.close(wrapper_fd)
        return {'result': result}
    _json_write(UPDATE_SYSTEM_FILE, state)
    _system_log(f'started, dry run {dry}, reboot {reboot_arg}, operating system {os_policy}, eFa-next {efa_wanted}' + (f', job {job}' if job else ''))
    # The wrapper first: one that fails its check refuses the whole update, never plain dnf in its place.
    found = hooks_lib.wrapper(UPDATE_HOOKS_DIR)
    if found is not None:
        wrapper_fd, problem = found
        if problem:
            _hook_alarm(f'wrapper refused, the update does not run: {problem}')
            return finish(f'Not updated: the update wrapper failed its check ({problem}).', False)
    pre = hooks_lib.run_phase(UPDATE_HOOKS_DIR, 'pre', hook_env)
    for name, problem in pre['refused']:
        _hook_alarm(f'pre hook {name} left out: {problem}')
    if not pre['ok']:
        return finish('Not updated: a pre hook said no: ' + '; '.join(f'{name} ({why})' for name, why in pre['failed']), False)
    if pre['ran']:
        _system_log('pre hooks: ' + ', '.join(pre['ran']))
    _HOOKS_NOW.update(depth=1, wrapper=wrapper_fd)  # the dnf inside (eFa-next, the system) through the wrapper, no second hook run
    _progress_step(progress, 'backup')
    try:
        state['backup'] = backup_now(None)['backup']
        state['config_export'] = _backup_make(_backup_stored_password(), database=False, prefix='config-')['backup']
    except (OSError, EfaError, subprocess.CalledProcessError) as err:
        return finish(f'Backup failed, nothing was updated: {err}', False)
    _json_write(UPDATE_SYSTEM_FILE, state)
    _system_log(f'backup {state["backup"]}, config export {state["config_export"]}')
    progress['backup'] = state['backup']
    _progress_step(progress, 'check')
    try:
        pending = _pending_os_updates() if os_policy != 'off' else []
    except (EfaError, subprocess.TimeoutExpired) as err:
        return finish(f'{err}', False)
    _system_log(f'{len(pending)} operating system updates pending')
    _pending_note(pending)
    try:
        risky = _firewall_risky_updates() if pending else {}
    except (EfaError, subprocess.TimeoutExpired) as err:
        return finish(f'The check of the package scripts failed, nothing was updated: {err}', False)
    skipped = (f'Left out, their scripts reload or restart firewalld: {", ".join(sorted(risky))}. '
               f'Install them by hand between minute {UPDATE_WINDOW[0]} and {UPDATE_WINDOW[1]}, then run efactl firewall-guard-run. ') if risky else ''
    for name, line in sorted(risky.items()):
        _system_log(f'left out {name}: {line}')
    held = _held_now(pending, risky)
    if held:
        state['held'] = progress['held'] = held
        _progress_write(progress)
        _system_log(f'held back, dnf cannot resolve them now: {held_text(held)}')
    _pending_note(pending, held=held)
    skipped += (f'Held back, they cannot be installed now (dnf cannot resolve their dependencies; the next update tries again): '
                f'{held_text(held)}. ') if held else ''
    update = _update_state()
    if dry:
        _progress_step(progress, 'health')
        _maintenance('on')
        problems = _update_health()
        _maintenance('off')
        return finish(f'Dry run: nothing installed. Pending: {len(pending)}. {skipped}eFa-next update: {_update_available(update)}. '
                      f'Health check: {"; ".join(problems) or "ok"}.', not problems)
    notes = []
    if efa_wanted and _update_available(update):
        _progress_step(progress, 'efa')
        result = _update_install(update)
        notes.append(result)
        _system_log(result)
        if not result.startswith('Installed'):
            return finish(result, False)
    _progress_step(progress, 'os')
    _maintenance('on')
    if os_policy != 'off':
        command, extra = _dnf_command(['dnf', '-y', 'upgrade', *(['--security'] if os_policy == 'security' else []), *DNF_SKIP, '--exclude=eFa-next',
                                       '--exclude=eFa-next-base', '--exclude=eFa', '--exclude=eFa-base', *[f'--exclude={name}' for name in sorted(risky)]])
        if extra:  # the wrapper runs the transaction: it gets the dnf command line as its arguments
            _system_log('the dnf transaction runs through the update wrapper')
        try:
            # No blocklist run while the packages change (9m); the table of eFa-next survives any firewalld reload of a package.
            with _firewall_lock(900):
                returncode, stdout, stderr = _dnf_with_progress(command, progress, 3600, **extra)
        except subprocess.TimeoutExpired:
            _maintenance('off')
            return finish(f'Operating system update did not finish within an hour. Backup: {state["backup"]}', False)
        with open(UPDATE_SYSTEM_LOG, 'a') as log:
            log.write(stdout[-8000:])
        if returncode != 0:
            _maintenance('off')
            return finish(f'Operating system update failed: {dnf_problem(stderr)}. Backup: {state["backup"]}', False)
        _pending_note([], _reboot_required())
        if reboot_arg == 'auto':  # a step of the rollout: the reboot the packages need, in this step (b)
            reboot = bool(_reboot_required())
    # Package scripts can run firewall-cmd --reload, and firewalld can lose its zones on that. Do not wait for the timer.
    _progress_step(progress, 'health')
    firewall_guard_run(None)
    restarted = _safe(lambda: restart_stale_services(_platform()), [])
    if restarted:
        notes.append(f'Restarted, they still ran replaced files: {", ".join(restarted)}.')
    problems = _update_health()
    _HOOKS_NOW.update(depth=0, wrapper=None)
    post = hooks_lib.run_phase(UPDATE_HOOKS_DIR, 'post', hook_env)
    for name, problem in post['refused']:
        _hook_alarm(f'post hook {name} left out: {problem}')
    for name, why in post['failed']:
        _hook_alarm(f'post hook {name} failed: {why}')
        notes.append(f'Post hook {name} failed: {why}.')
    if problems or not reboot:
        _maintenance('off')
    if problems:
        return finish(f'Health check after the update: {"; ".join(problems)}. No reboot. Backup: {state["backup"]}', False)
    if not reboot:
        return finish(f'Updated, health check ok. {skipped}Reboot required: {_reboot_required()}. {" ".join(notes)}', True)
    _system_log('rebooting: mail intake stops now')
    if wrapper_fd is not None:
        os.close(wrapper_fd)
    _write(POST_BOOT_MARK, _update_installed() + '\n')
    subprocess.run(['systemctl', 'stop', 'postfix'], check=False, capture_output=True)
    time.sleep(10)
    state.update(state='rebooting', finished=None)
    _json_write(UPDATE_SYSTEM_FILE, state)
    _progress_step(progress, 'reboot')
    _progress_end(progress, True, 'rebooting', state='rebooting')
    subprocess.run(['systemctl', 'reboot'], check=False, capture_output=True)
    return {'result': 'rebooting'}


def update_post_boot(_args):
    """After a reboot from update-system: health check, result on the dashboard and to the admin."""
    if not os.path.exists(POST_BOOT_MARK):
        return {'post_boot': 'nothing to do'}
    os.remove(POST_BOOT_MARK)
    _maintenance('off')
    problems = _update_health()
    state = _system_state()
    text = 'Reboot finished, health check ok.' if not problems else f'After the reboot: {"; ".join(problems)}'
    if state.get('held'):
        text += f' Held back, they cannot be installed now: {held_text(state["held"])}.'
    state.update(state='done' if not problems else 'failed', finished=time.strftime('%Y-%m-%d %H:%M:%S'), result=text)
    _json_write(UPDATE_SYSTEM_FILE, state)
    _update_lease_drop(state.get('job'))
    _system_log(text)
    progress = _json_read(UPDATE_PROGRESS, {})
    if progress.get('state') == 'rebooting':
        _progress_end(progress, not problems, text)
    _admin_notify('eFa-next: system update and reboot', text)
    return {'post_boot': text}


# Release upgrade EL9 to EL10 with ELevate (leapp). The decisions are in efa_release_upgrade, the steps here; the long ones run in
# efa-release-upgrade.service, the checks after the first EL10 boot in efa-release-upgrade-finish.service. Super admins only.
RU_UNIT = 'efa-release-upgrade.service'
RU_FINISH_UNIT = 'efa-release-upgrade-finish.service'
RU_DIR = os.environ.get('EFA_RU_DIR', '/var/lib/eFa/release-upgrade')
RU_STATE = RU_DIR + '/state.json'
RU_FINISH_MARK = RU_DIR + '/finish-pending'
RU_LOG = os.environ.get('EFA_RU_LOG', '/var/log/eFa/release-upgrade.log')
# New mail gets 421 during the upgrade; the host itself may still hand mail to Postfix (the checks after the upgrade).
RU_MAINTENANCE_MAP = ETC + '/postfix/efa-release-upgrade.cidr'
RU_MAINTENANCE_TEXT = '421 4.3.2 Service in maintenance: system upgrade, try again later'
RU_DRAIN_SECONDS = 900
# The checks after the first EL10 boot: tries and the wait between them (services and the clock need some minutes).
RU_FINISH_TRIES = 10
RU_LEAPP_WAIT = 1800
RU_FINISH_WAIT = 30
# Security standards and extra ClamAV sources (terms of a third party) change the whole host: super admins only too.
SUPER_COMMANDS = {'settings-export', 'settings-import', 'pyzor-set', 'geoip-set', 'geoip-import', 'release-upgrade', 'release-upgrade-status', 'standards-set', 'standards-rollback', 'os-harden-set', 'clam-source-set', 'clam-securiteinfo-set', 'threat-set', 'environment-set'}
# 2026-11-18 (cluster wizard): what makes, joins, changes or ends a cluster is for super admins only, whatever else a group grants.
SUPER_COMMANDS |= {'cluster-init', 'cluster-token', 'cluster-join', 'cluster-mode-set', 'cluster-leave', 'cluster-promote', 'cluster-node-remove'}
SUPER_COMMANDS |= {'cluster-join-check', 'cluster-join-preview', 'cluster-join-status', 'cluster-activate', 'cluster-activate-run', 'cluster-user-exists'}
SUPER_COMMANDS |= {'breakglass-status', 'breakglass-issue', 'breakglass-remove', 'breakglass-alarm', 'breakglass-heal'}
SUPER_COMMANDS |= {'cluster-harden', 'cluster-harden-run', 'cluster-harden-status', 'cluster-harden-apply'}


def _ru_lib():
    return _lib('efa_release_upgrade')


def _ru_config(facts):
    """The settings export compared before and after the upgrade (EL10-5): postconf, the text files of the settings, the
    enabled eFa-next units."""
    lib, files = _ru_lib(), {}
    for top in lib.CONFIG_DIRS:
        paths = [top] if os.path.isfile(top) else [os.path.join(root, name) for root, _dirs, names in os.walk(top) for name in names]
        for path in paths:
            if os.path.isfile(path) and path not in lib.CONFIG_SKIP and not path.endswith(lib.CONFIG_SKIP_ENDINGS):
                files[path] = _file_sha256(path)
    for path in _platform().release_package_unchanged(sorted(files)):
        files[path] = lib.PACKAGE_FILE
    return {'postconf_n': lib.config_postconf(_ru_postconf('-n')), 'postconf_p': lib.config_postconf(_ru_postconf('-P')),
            'files': files, 'units': facts.get('enabled_units', []), 'submission': _submission_effective()[0]}


def _file_sha256(path):
    digest = hashlib.sha256()
    with open(path, 'rb') as f:
        for block in iter(lambda: f.read(1 << 20), b''):
            digest.update(block)
    return digest.hexdigest()


def _ru_state():
    return _json_read(RU_STATE, {})


def _ru_save(record, /, **changes):
    """The state file with these changes. record is positional only: the callers pass state=... as one of the changes."""
    record.update(changes, updated=time.strftime('%Y-%m-%d %H:%M:%S'))
    os.makedirs(RU_DIR, mode=0o700, exist_ok=True)
    _json_write(RU_STATE, record, mode=0o600)
    return record


def _ru_log(text):
    os.makedirs(os.path.dirname(RU_LOG), exist_ok=True)
    with open(RU_LOG, 'a') as log:
        log.write(f'{time.strftime("%Y-%m-%d %H:%M:%S")} {text}\n')


def _ru_facts():
    """What the preflight needs; dnf and the repository answer as text when they fail, never as an exception."""
    facts = _platform().release_facts()
    facts['efa_version'] = _update_installed()
    facts['cluster_role'] = cluster_role()
    facts['repos_enabled'] = _safe(lambda: _platform().repos_enabled(), [])
    try:
        facts['pending'] = _pending_os_updates()
    except (EfaError, OSError, subprocess.TimeoutExpired) as err:
        facts['pending'] = str(err)[:200]
    try:
        facts['queue'] = len(_queue_rows())
    except (EfaError, OSError, ValueError, subprocess.TimeoutExpired):
        facts['queue'] = -1
    try:
        with urllib.request.urlopen(_ru_lib().EL10_PROBE, timeout=15) as reply:
            facts['el10_repo'] = reply.status == 200 or f'HTTP {reply.status}'
    except (OSError, ValueError) as err:
        facts['el10_repo'] = str(err)[:200]
    facts['ifcfg'] = _ru_lib().ifcfg_files(facts.get('ifcfg', []))
    # main.cf and the service options of master.cf: both can name Berkeley DB tables.
    facts['postconf_n'] = _ru_postconf('-n') + _ru_postconf('-P')
    facts['rhel_registered'] = _ru_rhel_registered() if _ru_lib().os_id(facts.get('os_release', '')) == 'rhel' else None
    return facts


def _ru_postconf(option):
    done = subprocess.run(['postconf', option], capture_output=True, text=True)
    return done.stdout if done.returncode == 0 else ''


RU_REDIS_DUMP = '/var/lib/redis/dump.rdb'


def _ru_valkey():
    """Valkey replaces Redis on EL10: the data of Redis (BEC relations, fuzzy hashes, greylisting, outbreak counters) moves
    over once, then Valkey runs. A step of the checks: (name, ok, detail)."""
    platform_now = _platform()
    data = platform_now.path('redis_dir')
    target = os.path.join(data, 'dump.rdb')
    try:
        if os.path.dirname(RU_REDIS_DUMP) != data and os.path.exists(RU_REDIS_DUMP) and not os.path.exists(target):
            platform_now.service_stop('redis')
            shutil.copy2(RU_REDIS_DUMP, target)
            shutil.chown(target, platform_now.account('redis_user'), platform_now.account('redis_user'))
            detail = f'{RU_REDIS_DUMP} copied to {target}'
        else:
            detail = 'nothing to move'
        platform_now.service_enable('redis', start=True)
        return ('Redis data in Valkey', platform_now.service_is_active('redis'), detail)
    except Exception as err:  # OSError, or the StepError of the platform layer: a failed check, not a crash of the finish
        return ('Redis data in Valkey', False, str(err)[:200])


def _ru_repo_keys():
    """Steps: the keys of the repositories of eFa-next and rspamd, checked by fingerprint and kept as local files, then fresh
    metadata of each enabled one without a question. A key with another fingerprint is not taken: that step fails."""
    lib, steps, keys = _ru_lib(), [], {}
    for path in lib.REPO_FILES:
        if not os.path.exists(path):
            continue
        text = open(path).read()
        sections = lib.repo_key_sections(text)
        for _repo, url, _on in sections:
            if url in keys:
                continue
            fingerprint, local = lib.REPO_KEYS[url]
            try:
                with urllib.request.urlopen(url, timeout=30, context=ssl.create_default_context()) as reply:
                    key = reply.read(256 * 1024)
                shown = subprocess.run(['gpg', '--show-keys', '--with-colons'], input=key, capture_output=True, check=False).stdout.decode()
                if fingerprint not in lib.key_fingerprints(shown):
                    raise EfaError(f'unexpected fingerprint, the key is not taken (expected {fingerprint})')
                with open(local + '.new', 'wb') as f:
                    f.write(key)
                os.chmod(local + '.new', 0o644)
                os.replace(local + '.new', local)
                _platform().repo_key_import(local)
                keys[url] = True
                steps.append((f'key {fingerprint[-16:]} of {url}', True, local))
            except Exception as err:  # urllib, gpg, rpm, the fingerprint: the step names the cause
                keys[url] = False
                steps.append((f'key of {url}', False, str(err)[:200]))
        local_text = lib.repo_keys_local(text)
        if any(keys.get(url) for _repo, url, _on in sections) and local_text != text:
            _write(path, local_text)
        for repo, url, on in sections:
            if on and keys.get(url):
                ok, said = _platform().repo_refresh(repo)
                steps.append((f'dnf makecache --repo {repo}', ok, '' if ok else said))
    return steps


def repo_keys_install(leapp=False, fetch=False):
    """VMAP-3/4: the signing keys of the repositories of eFa-next and rspamd, each only with its pinned fingerprint: from a
    copy on the host (the package of eFa-next ships its key, efa_release_upgrade.REPO_KEY_COPIES) or the file in
    /etc/pki/rpm-gpg, with fetch also from its address, to /etc/pki/rpm-gpg and into the package database; with leapp also into
    leapp's trusted folder. A file with another fingerprint is never taken. Steps (name, ok, detail)."""
    lib, steps = _ru_lib(), []
    for url, (fingerprint, local) in lib.REPO_KEYS.items():
        name = f'key {fingerprint[-16:]}'
        key, refused = None, []
        for source in (*lib.REPO_KEY_COPIES.get(url, ()), local, *([url] if fetch else [])):
            try:
                if source.startswith('https://'):
                    with urllib.request.urlopen(source, timeout=30, context=ssl.create_default_context()) as reply:
                        data = reply.read(256 * 1024)
                elif os.path.exists(source):
                    with open(source, 'rb') as f:
                        data = f.read(256 * 1024)
                else:
                    continue
            except OSError as err:
                refused.append(f'{source}: {err}'[:120])
                continue
            shown = subprocess.run(['gpg', '--show-keys', '--with-colons'], input=data, capture_output=True, check=False).stdout.decode()
            if fingerprint in lib.key_fingerprints(shown):
                key = data
                break
            refused.append(f'{source}: another fingerprint, not taken')
        if key is None and not refused and not fetch:
            # No copy on the host at all (rspamd ships none): the release upgrade fetches it with fetch, checked as here.
            steps.append((name, True, 'no copy on this host; the release upgrade takes it from its address, checked'))
            continue
        if key is None:
            steps.append((name, False, f'no copy with the fingerprint {fingerprint}' + (f" ({'; '.join(refused)})" if refused else '')))
            continue
        try:
            for path in [local] + ([f'{lib.LEAPP_KEY_DIR}/{os.path.basename(local).replace("RPM-GPG-KEY-", "")}.gpg'] if leapp else []):
                os.makedirs(os.path.dirname(path), exist_ok=True)
                if not os.path.exists(path) or open(path, 'rb').read() != key:
                    with open(path + '.new', 'wb') as f:
                        f.write(key)
                    os.chmod(path + '.new', 0o644)
                    os.replace(path + '.new', path)
            _platform().repo_key_import(local)
            steps.append((name, True, local + (' and leapp' if leapp else '')))
        except Exception as err:  # the file system or rpm: the step names the cause
            steps.append((name, False, str(err)[:200]))
    return steps


def repo_keys_heal(_args):
    """VMAP-4: after an install, an upgrade or the migration from eFa 5: the signing keys of the repositories as files and in
    the package database, from the copies on the host only (no network)."""
    steps = repo_keys_install()
    for name, ok, detail in steps:
        if ok:
            _audit(f'repository signing {name} in place ({detail})')
    return {'keys': [{'key': name, 'ok': ok, 'detail': detail} for name, ok, detail in steps]}


def _ru_repo_answers():
    """{repository: (ok, text)}: fresh metadata of each enabled repository of eFa-next and rspamd, without a question."""
    lib, found = _ru_lib(), {}
    for path in lib.REPO_FILES:
        if os.path.exists(path):
            for repo, _url, on in lib.repo_key_sections(open(path).read()):
                if on:
                    found[repo] = _safe(lambda repo=repo: _platform().repo_refresh(repo), (False, 'dnf did not answer'))
    return found


def _ru_after_upgrade(state):
    """The first EL10 boot, before the checks: MariaDB data, Postfix maps to lmdb:, SELinux enforcing, ELevate removed."""
    lib, steps = _ru_lib(), []
    done = subprocess.run(['mariadb-upgrade', '--user=root'], capture_output=True, text=True, env=_mysql_env(), timeout=1800)
    steps.append(('mariadb-upgrade', done.returncode == 0, (done.stdout + done.stderr)[-300:]))
    change = lib.lmdb_changes(_ru_postconf('-n'), _ru_postconf('-P'))
    if change['parameters'] or change['service_parameters']:
        if 'lmdb' not in subprocess.run(['postconf', '-m'], capture_output=True, text=True).stdout.split():
            _dnf_install(['postfix-lmdb'], 'release-upgrade')
        for path in change['postmap']:
            if os.path.exists(path):
                done = subprocess.run(['postmap', f'lmdb:{path}'], capture_output=True, text=True)
                steps.append((f'postmap {path}', done.returncode == 0, done.stderr[-200:]))
        for path in change['postalias']:
            done = subprocess.run(['postalias', f'lmdb:{path}'], capture_output=True, text=True)
            steps.append((f'postalias {path}', done.returncode == 0, done.stderr[-200:]))
        for name, value in [('default_database_type', 'lmdb'), *sorted(change['parameters'].items())]:
            try:
                _postconf_set(name, value)
                steps.append((f'{name} = {value}', True, ''))
            except (EfaError, subprocess.SubprocessError) as err:
                steps.append((f'{name} = {value}', False, str(err)[:200]))
        for name, value in sorted(change['service_parameters'].items()):
            done = subprocess.run(['postconf', '-P', f'{name}={value}'], capture_output=True, text=True)
            steps.append((f'master.cf {name} = {value}', done.returncode == 0, done.stderr[-200:]))
        subprocess.run(['postfix', 'reload'], check=False, capture_output=True)
    # The restrictions kept before leapp (main.cf and each smtpd service) go back once the checks passed or on abort/accept:
    # with lmdb: too, or Postfix answers every mail with 451 (unsupported dictionary type: hash), as on a production host.
    saved = {'client_restrictions': state.get('client_restrictions'), **{f'service {name}': value for name, value in
                                                                         (state.get('service_client_restrictions') or {}).items()}}
    found = lib.bdb_maps(''.join(f'{key} = {value}\n' for key, value in saved.items() if value))
    if found:
        for path in sorted({item.split(':', 1)[1] for maps in found.values() for item in maps}):
            if '$' not in path and path.startswith('/') and os.path.exists(path) and not os.path.exists(path + '.lmdb'):
                done = subprocess.run(['postmap', f'lmdb:{path}'], capture_output=True, text=True)
                steps.append((f'postmap {path} (kept restriction)', done.returncode == 0, done.stderr[-200:]))
        if state.get('client_restrictions'):
            state['client_restrictions'] = lib.to_lmdb(state['client_restrictions'])
        state['service_client_restrictions'] = {name: lib.to_lmdb(value) for name, value in (state.get('service_client_restrictions') or {}).items()}
        _ru_save(state)
        steps.append(('kept client restrictions to lmdb:', True, ''))
    steps.append(_ru_valkey())
    # F3: port 587 exactly as recorded before leapp (AUTH, system accounts), never a default of the packages.
    try:
        changed, what = submission_restore(state.get('submission'))
        steps.append(('Port 587 as before the upgrade', True, what))
        if changed:
            _ru_log(f'port 587 put back as before the upgrade: {what}')
    except (EfaError, OSError, subprocess.SubprocessError) as err:
        steps.append(('Port 587 as before the upgrade', False, str(err)[:200]))
    # F5: Dovecot (system accounts on 587) on a host without IPv6: IPv4 only, as on the first boot leapp may have seen it otherwise.
    dovecot = _platform().service('sasl')
    if _platform().service_exists(dovecot) and _platform().service_is_enabled(dovecot):
        if _dovecot_listen(_platform()):
            _platform().service_try_restart(dovecot)
        steps.append(('Dovecot listens as the network of this host allows', True, 'IPv4 only' if os.path.exists(DOVECOT_LISTEN) else 'IPv4 and IPv6'))
    taken = wazuh_take_over()
    steps.append(('Wazuh agent', taken['wazuh'] != 'not taken over', taken.get('report') or taken['wazuh']))
    _ru_source_repo(False)
    for path in lib.REPO_FILES:
        if os.path.exists(path):
            with open(path) as f:
                text = f.read()
            if lib.repo_el10(text) != text:
                _write(path, lib.repo_el10(text))
            steps.append((f'{path} for EL10', True, ''))
    steps += _ru_repo_keys()
    steps.append(_ru_rpmnew())
    # leapp ends its own phase after the reboot (leapp_resume.service): SELinux and the removal of leapp only after it.
    until = time.time() + RU_LEAPP_WAIT
    while _platform().release_leapp_busy() and time.time() < until:
        time.sleep(10)
    if _platform().release_leapp_busy():
        steps.append(('leapp ended its own phase', False, f'leapp_resume still runs after {RU_LEAPP_WAIT} s: SELinux and the '
                                                          'removal of leapp are left; the checks run again at the next boot'))
    else:
        steps.append(('leapp ended its own phase', True, ''))
        mode = _platform().release_enforce()
        steps.append(('SELinux enforcing', mode == 'Enforcing', mode))
        steps.append(_ru_policy())
        steps.append(_ru_dnf_excludes())
        facts = _platform().release_facts()
        ok, output = _platform().release_cleanup(lib.CLEANUP_PACKAGES + tuple(lib.old_kernels(facts['packages'], facts['kernel'])), run=_dnf_run_for('release-upgrade'))
        steps.append(('ELevate, leapp and the EL9 kernels removed', ok, output))
        steps.append(_ru_leftovers(state))
    for name, ok, detail in steps:
        _ru_log(f"after upgrade {'ok' if ok else 'FAILED'}: {name} {detail}".rstrip())
    return _ru_save(state, after_upgrade=[{'step': name, 'ok': ok, 'detail': detail} for name, ok, detail in steps])


def _ru_leftovers(state):
    """F4: EL9 builds without an EL10 one (iprutils, unzoo) and Perl that came new with the upgrade (SBOM-2) go, when no package
    needs them and the admin did not install them; the others stay with a hint in the checks."""
    lib, facts = _ru_lib(), _platform().release_facts()
    before_perl = set((state.get('baseline') or {}).get('perl', []))
    names = {item.rsplit('-', 2)[0] for item in lib.el9_leftovers(facts['packages'])}
    new_perl = {item.rsplit('-', 2)[0] for item in facts['packages'] if item.startswith('perl')} - before_perl - set(lib.PERL_ALLOWED)
    needed, users = _platform().release_leftover_facts(names | new_perl)
    remove, kept = lib.leftover_plan(names | new_perl, needed, users, new_perl)
    with _update_hooks('release-upgrade'):  # rpm -e, not dnf: the hooks around it, no wrapper
        ok, output = _platform().release_remove_packages(remove)
    _ru_save(state, leftovers_kept=kept)
    for name, why in sorted(kept.items()):
        _ru_log(f'kept {name}: {why}')
    return (f"Leftover packages removed: {', '.join(remove) or 'none'}" + (f"; kept: {', '.join(sorted(kept))}" if kept else ''), ok, output)


def _ru_policy():
    """The SELinux module of eFa-next of the EL10 package: the hook of the package ran inside leapp, where SELinux was off and the
    module was skipped. Loaded once enforcing; it also gives /run/nginx.pid the type of nginx (NGINX-PID)."""
    try:
        loaded = _platform().apply_policy_module(_platform().PATHS['policy_module'])
        return ('SELinux module efa of eFa-next', True, 'loaded' if loaded else 'already loaded')
    except Exception as err:  # the StepError of the platform layer, or semodule
        return ('SELinux module efa of eFa-next', False, str(err)[:200])


def _ru_dnf_excludes():
    """leapp's names off the exclude= line of dnf.conf, logged; the pins of eFa-next stay."""
    lib = _ru_lib()
    try:
        with open(lib.DNF_CONF) as f:
            text = f.read()
    except OSError as err:
        return ('dnf.conf without the exclusions of leapp', False, str(err)[:200])
    new, taken = lib.dnf_exclude_without_leapp(text)
    if taken:
        _write(lib.DNF_CONF, new)
        _ru_log(f"dnf.conf exclude=: taken off {', '.join(taken)}")
    return ('dnf.conf without the exclusions of leapp', True, ', '.join(taken))


def _ru_rpmnew():
    """The .rpmnew and .rpmsave beside the files eFa-next writes itself, moved to RPMNEW_DIR/<time>/ (root, 0700)."""
    lib = _ru_lib()
    moved, target = [], f"{lib.RPMNEW_DIR}/{time.strftime('%Y%m%d-%H%M%S')}"
    for path in lib.RPMNEW_MANAGED:
        for side in (path + '.rpmnew', path + '.rpmsave'):
            if os.path.isfile(side):
                os.makedirs(target + os.path.dirname(side), mode=0o700, exist_ok=True)
                os.chmod(lib.RPMNEW_DIR, 0o700)
                shutil.move(side, target + side)
                moved.append(side)
    for side in moved:
        _ru_log(f'moved {side} to {target}{side}')
    return ('.rpmnew/.rpmsave of managed files moved', True, f"{len(moved)} to {target}" if moved else 'none')


def _ru_baseline(facts):
    """What must be the same after the upgrade: network, firewall, other nft tables, counts, DKIM keys, Perl packages."""
    lib = _ru_lib()
    counts = {'domains': len(_own_domains())}
    for name, table in (('users', 'users'), ('quarantine', 'quarantine_mail'), ('tenant_domains', 'tenant_domains')):
        try:
            counts[name] = _admin_query(f'SELECT COUNT(*) AS n FROM {table}')[0]['n']
        except Exception as err:  # pymysql errors have no common base here; the count then shows the error on both sides
            counts[name] = f'error: {str(err)[:80]}'
    counts['totp_active'] = totp_active_count()  # S38: no second factor lost on the way
    dkim = sorted(_file_sha256(path) for path in glob.glob(DKIM_DIR + '/*') if os.path.isfile(path))
    return {'os_id': lib.os_id(facts.get('os_release', '')), 'addresses': facts['addresses'], 'routes': facts['routes'], 'firewall': facts['firewall'],
            'wazuh': facts.get('wazuh', {}),
            'mail_block': {name: lib.strip_counters(text) for name, text in facts['nft_tables'].items()}, 'counts': counts, 'dkim': dkim,
            'perl': sorted({item.rsplit('-', 2)[0] for item in facts['packages'] if item.startswith('perl')}),
            'services': sorted(facts.get('active') or [])}


RU_QUEUED = re.compile(r'queued as ([0-9A-Za-z]+)')


def ru_queue_id(reply):
    """The queue id in the answer of Postfix to the end of DATA, None when there is none."""
    match = RU_QUEUED.search(reply.decode(errors='replace') if isinstance(reply, bytes) else str(reply))
    return match.group(1) if match else None


def ru_delivery_transports(master_text):
    """The services of master.cf that deliver mail away (smtp and lmtp clients): held back while the test mails are queued."""
    names = set()
    for line in master_text.splitlines():
        fields = line.split()
        if len(fields) >= 8 and not line.startswith(('#', ' ', '\t')) and fields[1] == 'unix' and fields[7] in ('smtp', 'lmtp'):
            names.add(fields[0])
    return sorted(names)


def _ru_mail_test():
    """A clean mail, GTUBE and EICAR to the local Postfix: accepted, rejected or deferred, as Postfix answered. The mails never
    leave the host: the delivering transports are deferred while they are sent, and an accepted one is deleted from the queue
    by its queue id before the transports are free again."""
    host = own_hostname()
    domains = _own_domains() or {host}
    found, queued = {}, []
    recipient = _ru_test_recipient(host, domains)
    if not recipient[0]:
        # F2: no address this host takes (a relay that checks its recipients in LDAP and has no clean mail logged yet): Postfix
        # answered, but GTUBE and EICAR cannot be tried without a recipient, so they fail with the reason.
        why = f'no recipient accepted ({recipient[1]})'
        return {'clean': why, 'gtube': 'not run: ' + why, 'eicar': 'not run: ' + why}
    to = recipient[0]
    before = _postconf('defer_transports')
    held = ru_delivery_transports(_master_lines())
    _postconf_set('defer_transports', ' '.join(sorted(set(before.split()) | set(held))))
    subprocess.run(['postfix', 'reload'], check=False, capture_output=True)
    try:
        for name, body in (('clean', 'eFa-next release upgrade check.'), ('gtube', _ru_lib().GTUBE), ('eicar', _ru_lib().EICAR)):
            message = email.message.EmailMessage()
            message['From'], message['To'] = f'postmaster@{host}', to
            message['Subject'], message['Message-ID'] = f'eFa-next release upgrade check: {name}', email.utils.make_msgid(domain=host)
            message.set_content(body)
            try:
                with smtplib.SMTP('127.0.0.1', 25, timeout=60) as smtp:
                    smtp.ehlo(host)
                    # A setup that demands TLS on port 25 (smtpd_tls_security_level = encrypt) answers 530 without it.
                    if smtp.has_extn('starttls'):
                        smtp.starttls(context=ssl._create_unverified_context())
                        smtp.ehlo(host)
                    code, _reply = smtp.mail(f'postmaster@{host}')
                    if code < 300:
                        code, _reply = smtp.rcpt(to)
                    if code >= 300:
                        # Refused before the content: no verdict of the filters, so never "rejected".
                        found[name] = f'refused before the content: {code}'
                        continue
                    code, reply = smtp.data(message.as_bytes())
                    queue_id = ru_queue_id(reply) if code < 300 else None
                    if queue_id:
                        queued.append(queue_id)
                    found[name] = 'accepted' if code < 300 else 'rejected' if code >= 500 else f'deferred {code}'
            except smtplib.SMTPResponseException as err:
                found[name] = 'rejected' if err.smtp_code >= 500 else f'deferred {err.smtp_code}'
            except (OSError, smtplib.SMTPException) as err:
                found[name] = f'error: {str(err)[:100]}'
    finally:
        for queue_id in queued:
            subprocess.run(['postsuper', '-d', queue_id], check=False, capture_output=True)
        if before:
            _postconf_set('defer_transports', before)
        else:
            _postconf_remove(['defer_transports'])
        subprocess.run(['postfix', 'reload'], check=False, capture_output=True)
    if len(queued) < sum(1 for value in found.values() if value == 'accepted'):
        _ru_log('test mail: an accepted test mail without queue id stays held in the deferred queue; delete it with postsuper')
    return found


def _ru_test_recipient(host, domains):
    """F2: (an address of an own domain that Postfix takes as recipient, last refusal). Tried in one SMTP session with RCPT only,
    no mail is sent: recent recipients of clean mail first, then the plain relay recipient tables, then postmaster@ and abuse@."""
    lib, logged, listed = _ru_lib(), [], []
    try:
        db = _maillog_db()
        try:
            with db.cursor() as cur:
                cur.execute("SELECT rcpt FROM maillog WHERE action = 'no action' ORDER BY id DESC LIMIT 50")
                logged = [row['rcpt'] for row in cur.fetchall()]
        finally:
            db.close()
    except Exception as err:  # pymysql errors have no common base here; then the other sources
        _ru_log(f'test mail: no recipients from the mail log ({str(err)[:100]})')
    for item in re.split(r'[\s,]+', _postconf('relay_recipient_maps') or ''):
        kind, _sep, path = item.partition(':')
        if kind in ('hash', 'btree', 'lmdb', 'cdb', 'texthash') and path.startswith('/') and os.path.isfile(path):
            with open(path, errors='replace') as f:
                listed += lib.table_addresses(f.read())
    last = 'no candidate'
    try:
        with smtplib.SMTP('127.0.0.1', 25, timeout=60) as smtp:
            smtp.ehlo(host)
            if smtp.has_extn('starttls'):
                smtp.starttls(context=ssl._create_unverified_context())
                smtp.ehlo(host)
            for address in lib.mail_recipients(domains, logged, listed):
                code, reply = smtp.mail(f'postmaster@{host}')
                if code < 300:
                    code, reply = smtp.rcpt(address)
                smtp.rset()
                if code < 300:
                    return address, ''
                last = f'{code} {reply.decode(errors="replace")[:120]}'
    except (OSError, smtplib.SMTPException) as err:
        last = f'error: {str(err)[:100]}'
    return None, last


def ru_client_overrides(postconf_p):
    """{service/type: value} of the smtpd services in master.cf with their own smtpd_client_restrictions (postconf -P)."""
    found = {}
    for line in (postconf_p or '').splitlines():
        name, sep, value = line.partition('=')
        parts = name.strip().split('/')
        if sep and len(parts) == 3 and parts[2] == 'smtpd_client_restrictions':
            found[f'{parts[0]}/{parts[1]}'] = value.strip()
    return found


def ru_blocked(rule, old):
    """The restriction list with the maintenance map in front."""
    return rule + (f', {old}' if old else '')


def _ru_mail_stop(state):
    """New mail gets 421, except from this host; the old restrictions are kept in the state for the way back. Also the smtpd
    services of master.cf with a list of their own (-o smtpd_client_restrictions), which main.cf does not reach."""
    if 'client_restrictions' not in state:
        overrides = ru_client_overrides(subprocess.run(['postconf', '-P'], capture_output=True, text=True).stdout)
        _ru_save(state, client_restrictions=_postconf('smtpd_client_restrictions'), service_client_restrictions=overrides)
    _write(RU_MAINTENANCE_MAP, f'127.0.0.0/8 DUNNO\n::1/128 DUNNO\n0.0.0.0/0 {RU_MAINTENANCE_TEXT}\n::/0 {RU_MAINTENANCE_TEXT}\n')
    rule = f'check_client_access cidr:{RU_MAINTENANCE_MAP}'
    _postconf_set('smtpd_client_restrictions', ru_blocked(rule, state['client_restrictions']))
    for service, old in state.get('service_client_restrictions', {}).items():
        subprocess.run(['postconf', '-P', f'{service}/smtpd_client_restrictions={ru_blocked(rule, old)}'], check=True, capture_output=True)
    subprocess.run(['postfix', 'reload'], check=False, capture_output=True)
    _maintenance('on')


def _ru_mail_start(state):
    """The way back: the restrictions of before (main.cf and the smtpd services with their own), the service monitor on again.
    Only what the upgrade set: a maintenance mode the admin had on before stays."""
    ours = 'client_restrictions' in state or os.path.exists(RU_MAINTENANCE_MAP)
    if 'client_restrictions' in state:
        # S36: only the own entry goes; what was changed meanwhile (an update placed the allow lookups, lmdb: after EL10) stays.
        # The value of now, never the cache: the heal of an update may just have written it.
        now = subprocess.run(['postconf', '-h', 'smtpd_client_restrictions'], capture_output=True, text=True, check=True).stdout.strip()
        if any(_ru_item(item) for item in restriction_items(now)):
            if maintenance_removed(now):
                _postconf_set('smtpd_client_restrictions', maintenance_removed(now))
            else:
                _postconf_remove(['smtpd_client_restrictions'])
        for service, value in ru_client_overrides(subprocess.run(['postconf', '-P'], capture_output=True, text=True).stdout).items():
            if any(_ru_item(item) for item in restriction_items(value)):
                subprocess.run(['postconf', '-P', f'{service}/smtpd_client_restrictions={maintenance_removed(value)}'], check=False, capture_output=True)
        state.pop('client_restrictions')
        state.pop('service_client_restrictions', None)
        subprocess.run(['postfix', 'reload'], check=False, capture_output=True)
        _ru_save(state)
    if os.path.exists(RU_MAINTENANCE_MAP):
        os.remove(RU_MAINTENANCE_MAP)
    if ours:
        _maintenance('off')


def _ru_backup():
    """An encrypted backup, uploaded to every external target, its checksum compared and a test extract. Any failure stops."""
    password = _backup_stored_password()
    if password is None:
        raise EfaError('Set a backup password first: the upgrade starts only after an encrypted backup.')
    targets = _json_read(BACKUP_TARGETS, {})
    if not [key for key, target in targets.items() if not target.get('locked')]:
        raise EfaError('Set up an external backup target first: the backup must leave this host before the upgrade.')
    made = _backup_make(password)
    path = f"{BACKUP_DIR}/{made['backup']}"
    local = _file_sha256(path)
    results = _backup_upload(made['backup'])
    targets = _json_read(BACKUP_TARGETS, {})
    bad = [item for item in results if item['result'] != 'ok' or targets.get(item['target'], {}).get('last_sha256') != local]
    if not results or bad:
        raise EfaError('Backup upload failed: ' + '; '.join(f"{item['target']}: {item['result']}" for item in bad or results))
    with tempfile.TemporaryDirectory(dir=BACKUP_DIR) as tmp:
        if _gpg(password, '--decrypt', '--output', tmp + '/test.tar.gz', path).returncode != 0:
            raise EfaError('Backup test: decryption failed.')
        with tarfile.open(tmp + '/test.tar.gz') as tar:
            names = tar.getnames()
        if BACKUP_MANIFEST not in names:
            raise EfaError('Backup test: the archive has no manifest.')
    return {'backup': made['backup'], 'sha256': local, 'targets': [item['target'] for item in results], 'files': len(names)}


def _ru_queue(action):
    state = _ru_state()
    # 6.0.0.6.6: also a step that waits for its run (a second tab, the console beside the web interface): queued once only.
    if state.get('state') == 'queued':
        raise EfaError(f"A step waits for its run already: {state.get('request') or 'unknown'}. Its progress: efactl release-upgrade-status.")
    if state.get('state') in ('preflight', 'preupgrade', 'starting', 'rechecking', *_ru_lib().POINT_OF_NO_RETURN):
        raise EfaError(f"A step runs already: {state['state']}.")
    _ru_save(state, request=action, state='queued', error=None)
    _platform().service_start_background(RU_UNIT)
    return {'release_upgrade': f'{action} started', 'progress': 'efactl release-upgrade-status'}


def release_upgrade_status(_args):
    """State, last preflight and preupgrade, and the end of the log: read only."""
    state = {key: value for key, value in _ru_state().items() if key not in ('baseline', 'client_restrictions')}
    state.setdefault('state', 'idle')
    warnings = list((state.get('preflight') or {}).get('reasons', [])) + list((state.get('preflight') or {}).get('warnings', []))
    warnings += [f"leapp inhibitor: {item['title']}" for item in (state.get('preupgrade') or {}).get('unknown_inhibitors', [])]
    warnings += list((state.get('preupgrade') or {}).get('removal', []))
    if (state.get('preupgrade') or {}).get('exit') not in (None, 0):
        warnings.append(f"leapp preupgrade ended with exit {state['preupgrade']['exit']}: "
                        + '; '.join(item['title'] for item in state['preupgrade'].get('high_risk', [])[:3]))
    if state.get('error'):
        warnings.append(state['error'])
    return {**state, 'warnings': warnings, 'log': _read_lines(RU_LOG)[-60:]}


def release_upgrade(args):
    """The fixed steps of the release upgrade: status, preflight, preupgrade, start, abort. Nothing else is taken."""
    lib = _ru_lib()
    action = (args.action or '').strip()
    if action not in lib.ACTIONS:
        raise EfaError('Step: one of ' + ', '.join(lib.ACTIONS))
    if action == 'status':
        return release_upgrade_status(args)
    if action == 'abort':
        state = _ru_state()
        problem = lib.abort_problem(state)
        if problem:
            raise EfaError(problem)
        _platform().service_stop(RU_UNIT)
        # Read again once the step stopped: it may have saved the Postfix restriction of before in the meantime.
        state = _ru_state()
        _ru_mail_start(state)
        if os.path.exists(RU_FINISH_MARK):
            os.remove(RU_FINISH_MARK)
        _platform().service_disable(RU_FINISH_UNIT)
        _ru_save(state, state='aborted', request=None)
        _ru_log(f'aborted by {_dmarc_who()}')
        return {'release_upgrade': 'aborted'}
    if action == 'accept':
        # After checks_failed: the admin takes the host as it is (reason in the audit log); mail is taken again, EL10 stays.
        state = _ru_state()
        problem = lib.accept_problem(state, getattr(args, 'reason', ''))
        if problem:
            raise EfaError(problem)
        _ru_mail_start(state)
        if os.path.exists(RU_FINISH_MARK):
            os.remove(RU_FINISH_MARK)
        _platform().service_disable(RU_FINISH_UNIT)
        failed = '; '.join((state.get('result') or {}).get('failed', []))[:500]
        _audit(f'release upgrade accepted with failed checks by {_dmarc_who()}: {args.reason.strip()[:300]}; failed: {failed}')
        _ru_save(state, state='accepted', request=None)
        _ru_log(f'accepted by {_dmarc_who()} with failed checks ({failed}): {args.reason.strip()[:300]}')
        return {'release_upgrade': 'accepted: mail is taken again', 'failed_checks': failed}
    if action == 'recheck':
        state = _ru_state()
        problem = lib.recheck_problem(state)
        if problem:
            raise EfaError(problem)
        _ru_save(state, recheck_by=_dmarc_who())
        _ru_save(_ru_state(), request='recheck', state='rechecking', error=None)
        _platform().service_start_background(RU_UNIT)
        return {'release_upgrade': 'recheck started: mail is taken again only when all checks pass', 'progress': 'efactl release-upgrade-status'}
    if action == 'start':
        problem = lib.start_problem(args.snapshot, args.hostname, own_hostname(), _ru_state(), time.time())
        snapshot_only, typed_problem = lib.snapshot_only_choice(getattr(args, 'no_backup', ''))
        if problem or typed_problem:
            raise EfaError(problem or typed_problem)
        # Set on every start: a start with the sentence never carries over to a later one without it.
        _ru_save(_ru_state(), snapshot_only=snapshot_only)
        if snapshot_only:
            _audit(f'release upgrade start WITHOUT backup, the VM snapshot is the only way back: confirmed by {_dmarc_who()} on {own_hostname()}')
        _ru_log(f'start confirmed by {_dmarc_who()}: VM snapshot confirmed, host name typed'
                + (', without backup (VM snapshot only)' if snapshot_only else ''))
    return _ru_queue(action)


def _ru_preflight(state):
    _ru_save(state, state='preflight')
    lib = _ru_lib()
    found = lib.preflight(_ru_facts())
    if lib.EL10_TEST_REPO or lib.EL10_TEST_IGNORED:
        _ru_log(lib.EL10_TEST_IGNORED or f'TEST repository of unsigned builds: {lib.EL10_TEST_REPO}')
    _ru_log('preflight: ' + ('ready' if found['ready'] else 'not ready: ' + '; '.join(found['reasons'])))
    return _ru_save(state, preflight={**found, 'time': time.time()}, state='ready' if found['ready'] else 'blocked')


def _ru_rhel_registered():
    """RHEL only: whether subscription-manager says the system is registered (None elsewhere)."""
    if not shutil.which('subscription-manager'):
        return None
    done = subprocess.run(['subscription-manager', 'status'], capture_output=True, text=True, timeout=120)
    return done.returncode == 0


def _ru_release_package(url, folder):
    """S22: the release package of ELevate over https, used only when it is signed by the pinned ELevate key."""
    lib, platform_now = _ru_lib(), _platform()
    if lib.ELEVATE_FINGERPRINT not in platform_now.release_key_fingerprints(lib.ELEVATE_KEY):
        raise EfaError(f'{lib.ELEVATE_KEY} is not the ELevate key {lib.ELEVATE_FINGERPRINT}: nothing installed.')
    path = os.path.join(folder, os.path.basename(urllib.parse.urlparse(url).path))
    with urllib.request.urlopen(url, timeout=120) as reply, open(path, 'wb') as f:
        shutil.copyfileobj(reply, f)
    problem = lib.rpm_signature_problem(*platform_now.release_signature(path, lib.ELEVATE_KEY))
    if problem:
        raise EfaError(f'{os.path.basename(path)} refused: {problem}')
    return path


def _ru_source_repo(on):
    """The EL9 repository of eFa-next on while leapp runs (it takes the vendor efa-next only then), off again after; a host
    without the file gets it as docs/install.md writes it."""
    lib = _ru_lib()
    path = lib.REPO_FILES[0]
    text = ''
    if os.path.exists(path):
        with open(path) as f:
            text = f.read()
    if lib.repo_enabled(text, on) != text:
        _write(path, lib.repo_enabled(text, on))


def _ru_leapp_files(on):
    """leapp's customisation for eFa-next (efa_release_upgrade.LEAPP_TO_KEEP and _TO_INSTALL, the EPEL of the target
    release) for one leapp run, then the files as leapp shipped them."""
    lib = _ru_lib()
    to_install = lib.leapp_to_install(_safe(lambda: _platform().repos_enabled(), [])) if on else lib.LEAPP_TO_INSTALL
    for name, names in (('to_install', to_install), ('to_keep', lib.LEAPP_TO_KEEP)):
        path, text = f'{lib.LEAPP_TRANSACTION_DIR}/{name}', ''
        if os.path.exists(path):
            with open(path) as f:
                text = f.read()
        new = lib.transaction_with(text, names) if on else lib.transaction_without(text)
        if new != text and (on or os.path.exists(path)):
            _write(path, new)
    if os.path.exists(lib.LEAPP_EPEL_REPO):
        target = ''
        if on:
            target = lib.leapp_target(_json_read(lib.LEAPP_UPGRADE_PATHS, {}), lib.os_id(_platform().release_facts()['os_release']),
                                      _ru_version_id())
        with open(lib.LEAPP_EPEL_REPO) as f:
            text = f.read()
        if lib.epel_pinned(text, target) != text:
            _write(lib.LEAPP_EPEL_REPO, lib.epel_pinned(text, target))
        if on:
            _ru_log(f'leapp EPEL repository: EPEL {target or "10 (newest)"}')


def _ru_version_id():
    """VERSION_ID of /etc/os-release (9.8), as leapp chooses its target by it."""
    found = re.search(r'^VERSION_ID="?([0-9.]+)', _platform().release_facts()['os_release'], flags=re.M)
    return found.group(1) if found else ''


def _ru_leapp(step):
    """leapp preupgrade or upgrade with the source repository on and the customisation of _ru_leapp_files; (exit code, why
    it must not go on)."""
    lib = _ru_lib()
    _ru_source_repo(True)
    try:
        _ru_leapp_files(True)
        code = _platform().release_leapp([step], RU_LOG)
    finally:
        _ru_source_repo(False)
        _ru_leapp_files(False)
    try:
        with open(lib.LEAPP_LOG.format(step), errors='replace') as f:
            text = f.read()
    except OSError:
        text = ''
    problems = lib.removal_problems(text, _json_read(lib.LEAPP_REPORT, {}), bool(lib.EL10_TEST_REPO))
    for problem in problems:
        _ru_log(f'leapp {step}: {problem}')
    return code, problems


def _ru_recover(on):
    """The safety net outside the packages (efa_release_upgrade.recover_files): set up right before leapp upgrade, removed
    once the checks after the upgrade ran or leapp stopped before the reboot."""
    lib = _ru_lib()
    if on:
        script = _platform().release_recover_script(RU_LOG, RU_FINISH_MARK, lib.RECOVER_DIR + '/repos', lib.RECOVER_MOTD)
        for path, text in lib.recover_files(script, RU_FINISH_MARK).items():
            _write(path, text, 0o700 if path.endswith('.sh') else 0o644)
        _platform().service_manager_reload()
        _platform().service_enable(lib.RECOVER_UNIT)
        return
    if os.path.exists(lib.RECOVER_UNIT_FILE):
        _platform().service_disable(lib.RECOVER_UNIT)
        os.remove(lib.RECOVER_UNIT_FILE)
    shutil.rmtree(lib.RECOVER_DIR, ignore_errors=True)
    if os.path.exists(lib.RECOVER_MOTD):
        os.remove(lib.RECOVER_MOTD)


def _ru_preupgrade(state):
    lib = _ru_lib()
    if not _ru_preflight(state)['preflight']['ready']:
        return state
    _ru_save(state, state='preupgrade')
    source = lib.os_id(_platform().release_facts()['os_release'])
    problem = lib.distribution_problem(source, _ru_rhel_registered())
    if problem:
        raise EfaError(problem)
    release, packages = lib.upgrade_packages(source)
    with tempfile.TemporaryDirectory() as tmp:
        local = _ru_release_package(release, tmp) if release else None
        ok, output = _platform().release_prepare(local, packages, run=_dnf_run_for('release-upgrade'))
    if not ok:
        raise EfaError(f'The upgrade tool could not be installed: {output}')
    map_format = lib.leapp_map_format(_json_read(lib.LEAPP_REPOMAP, {}))
    if map_format[1] is None:
        raise EfaError(f'leapp takes vendor maps of format {map_format[0]}, which this eFa-next does not write yet: update eFa-next first.')
    _ru_log(f'leapp vendor maps: format {map_format[0]}, data stream {map_format[1]}')
    # VMAP-3: leapp 0.25 stops at keys of target repositories it does not trust (package database or its trusted folder): the
    # checked keys first, else nothing of leapp runs.
    for name, ok, detail in repo_keys_install(leapp=True, fetch=True):
        _ru_log(f"signing {name}: {'in place' if ok else 'missing'} ({detail})")
        if not ok:
            raise EfaError(f'Signing {name} of a repository of eFa-next is not in place: {detail}. Nothing of leapp ran.')
    for name, text in lib.vendor_files(source, map_format).items():
        _write(f'{lib.VENDORS_DIR}/{name}', text)
    _ru_log('leapp preupgrade')
    code, removal = _ru_leapp('preupgrade')
    found = lib.leapp_report(_json_read(lib.LEAPP_REPORT, {}))
    # leapp ends with an error when its own check could not run (a broken vendor map): that never counts as passed. Nor does
    # an upgrade that would remove eFa-next or a package it needs (the first rehearsal).
    found['ok'] = found['ok'] and code == 0 and not removal
    found['removal'] = removal
    _ru_log(f"leapp preupgrade exit {code}: {len(found['inhibitors'])} inhibitors, {len(found['high_risk'])} high risks")
    return _ru_save(state, preupgrade={**found, 'exit': code, 'time': time.time()}, state='ready' if found['ok'] else 'inhibited')


def _ru_start(state):
    lib = _ru_lib()
    report = state.get('preupgrade') or {}
    if not report.get('ok') or time.time() - report.get('time', 0) > lib.REPORT_HOURS * 3600:
        raise EfaError('Run preupgrade first; it must finish without an unknown inhibitor.')
    # S23: once more right before anything changes: the target is the same distribution, or nothing happens.
    problem = lib.distribution_problem(lib.os_id(_platform().release_facts()['os_release']), _ru_rhel_registered())
    if problem:
        raise EfaError(problem)
    _ru_save(state, state='starting')
    if state.get('snapshot_only'):
        backup = {'backup': None, 'snapshot_only': True}
        _ru_log('no backup before the upgrade, as confirmed at the start: the VM snapshot is the only way back')
    else:
        backup = _ru_backup()
        _ru_log(f"backup {backup['backup']} sha256 {backup['sha256']} uploaded to {', '.join(backup['targets'])}, test extract ok")
    _ru_mail_stop(state)
    _ru_log('maintenance: new mail gets 421, waiting for the queue')
    until = time.time() + RU_DRAIN_SECONDS
    while time.time() < until and [row for row in _queue_rows() if row['queue'] in lib.DRAIN_QUEUES]:
        time.sleep(15)
    rows = _queue_rows()
    deferred = len([row for row in rows if row['queue'] == 'deferred'])
    _ru_log(f'{len(rows)} mails stay in the queue over the upgrade ({deferred} deferred: they go out on their next try after it)')
    if _ru_state().get('state') == 'aborted':
        return state
    taken = wazuh_take_over()
    if taken.get('report'):
        _ru_log(taken['report'])
    facts = _platform().release_facts()
    _ru_save(state, backup=backup, baseline={**_ru_baseline(facts), 'config': _ru_config(facts)}, submission=submission_record(), state='upgrading')
    _write(RU_FINISH_MARK, time.strftime('%Y-%m-%d %H:%M:%S') + '\n', 0o600)
    _platform().service_enable(RU_FINISH_UNIT)
    _ru_recover(True)
    _ru_log('leapp upgrade')
    code, removal = _ru_leapp('upgrade')
    if code == 0 and removal:
        # leapp has set up the upgrade for the next boot, but would remove eFa-next: no reboot. Maintenance stays on, and the
        # safety net stays for a reboot by hand.
        _admin_notify('eFa-next: release upgrade stopped', 'leapp upgrade would remove eFa-next: ' + '; '.join(removal) +
                      f' Do not reboot: go back to the VM snapshot. Maintenance stays on (new mail gets 421). See {RU_LOG}.')
        raise EfaError('leapp upgrade would remove eFa-next, no reboot: ' + '; '.join(removal) +
                       ' Do not reboot: go back to the VM snapshot. Maintenance stays on (new mail gets 421).')
    if code != 0:
        os.remove(RU_FINISH_MARK)
        _platform().service_disable(RU_FINISH_UNIT)
        _ru_recover(False)
        _ru_mail_start(state)
        _admin_notify('eFa-next: release upgrade failed', f'leapp upgrade ended with {code}; see {RU_LOG}. Mail is accepted again.')
        raise EfaError(f'leapp upgrade ended with {code}, nothing rebooted; mail is accepted again. See {RU_LOG}.')
    _ru_save(state, state='rebooting')
    _ru_log('reboot into the upgrade')
    _platform().reboot()
    return state


def release_upgrade_run(_args):
    """The background part (efa-release-upgrade.service): the step asked for, under a lock, logged."""
    os.makedirs(RU_DIR, mode=0o700, exist_ok=True)
    with open(RU_DIR + '/lock', 'w') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            raise EfaError('Another release upgrade step is running.')
        return _ru_run_step()


def _ru_run_step():
    state = _ru_state()
    action = state.get('request')
    steps = {'preflight': _ru_preflight, 'preupgrade': _ru_preupgrade, 'start': _ru_start, 'recheck': _ru_recheck}
    if action not in steps:
        return {'release_upgrade': 'nothing to do'}
    _ru_save(state, request=None)
    try:
        steps[action](state)
    except Exception as err:  # any fault ends in the state failed: a step that stays "running" would block every next one
        if state.get('state') in ('starting',):
            _ru_mail_start(state)
        _ru_log(f'{action} failed: {err}')
        # A recheck that broke off leaves the host as before: checks failed, the 421 on, accept and recheck still open.
        _ru_save(state, state='checks_failed' if action == 'recheck' else 'failed', error=f'{action}: {str(err)[:500]}')
        raise EfaError(f'{action} failed: {err}')
    return {'release_upgrade': state.get('state')}


def _ru_leapp_leftovers():
    """leapp's data, upgrade container and resume copy, once the checks passed (efa_release_upgrade.LEAPP_LEFTOVERS)."""
    lib = _ru_lib()
    for path in lib.LEAPP_LEFTOVERS:
        if os.path.isdir(path) and not os.path.islink(path):
            shutil.rmtree(path, ignore_errors=True)
            _ru_log(f'removed {path} (leapp left it)')
    try:
        os.rmdir(lib.LEAPP_ETC)
    except OSError:
        pass


def _ru_finish_done():
    """The checks after the first EL10 boot ran to their end: no run at the next boot."""
    if os.path.exists(RU_FINISH_MARK):
        os.remove(RU_FINISH_MARK)
    _platform().service_disable(RU_FINISH_UNIT)
    _ru_recover(False)


def release_upgrade_finish(_args):
    """After the first boot into EL10 (efa-release-upgrade-finish.service): the checks; mail is accepted again only when all pass."""
    if not os.path.exists(RU_FINISH_MARK):
        return {'release_upgrade': 'nothing to do'}
    # The mark and the unit stay until the checks are done: a crash or a power cut in between runs them again at the next
    # boot (every step below can run twice), and the mail block (421) stays on meanwhile.
    state = _ru_save(_ru_state(), state='finishing')
    before = state.get('baseline') or {}
    _ru_after_upgrade(state)
    found = _ru_checks(state, before)
    if found['ok']:
        _ru_mail_start(state)
        _ru_leapp_leftovers()
        text = 'Release upgrade to EL10 finished, all checks passed, mail is accepted again.'
    else:
        text = 'Release upgrade: checks failed, maintenance mode stays on (new mail gets 421): ' + '; '.join(found['failed'])
    _ru_save(state, state='done' if found['ok'] else 'checks_failed', result={**found, 'time': time.time()}, error=None if found['ok'] else text)
    _ru_finish_done()
    _ru_log(text)
    _event('release_upgrade', 'info' if found['ok'] else 'critical', ok=found['ok'])
    _admin_notify('eFa-next: release upgrade', text)
    return {'release_upgrade': text}


def _ru_recheck(state):
    """The checks after the upgrade again (action recheck, after checks_failed): mail is taken again only when every required
    check passes; otherwise the 421 stays. Nothing else is changed."""
    found = _ru_checks(state, state.get('baseline') or {})
    if found['ok']:
        _ru_mail_start(state)
        text = 'Release upgrade: checks run again and all passed, mail is accepted again.'
    else:
        text = 'Release upgrade: checks run again and failed, maintenance mode stays on (new mail gets 421): ' + '; '.join(found['failed'])
    _ru_save(state, state='done' if found['ok'] else 'checks_failed', result={**found, 'time': time.time()}, error=None if found['ok'] else text)
    _audit(f"release upgrade checks run again by {state.get('recheck_by') or 'admin'}: {'all passed, mail taken again' if found['ok'] else 'failed: ' + '; '.join(found['failed'])[:300]}")
    _ru_log(text)
    _admin_notify('eFa-next: release upgrade', text)


def _ru_checks(state, before):
    """The checks after the first EL10 boot, with some tries while services come up: {ok, checks, failed}."""
    lib = _ru_lib()
    # Denials of the first boot in permissive mode (before the relabel ended) do not count, only those once enforcing.
    since = time.strftime('%m/%d/%Y %H:%M:%S').split()
    found, mail = {}, None
    for _attempt in range(RU_FINISH_TRIES):
        facts = _platform().release_facts(avc_since=since)
        now = _ru_baseline(facts)
        db = subprocess.run(['mysqlcheck', '--user=root', '--all-databases', '--check', '--silent'], capture_output=True, text=True,
                            env=_mysql_env())
        facts.update({key: now[key] for key in ('addresses', 'routes', 'firewall', 'mail_block', 'counts', 'dkim', 'wazuh')},
                     perl_extra=sorted(set(now['perl']) - set(before.get('perl', []))), mail=mail or _ru_mail_test(),
                     db_check=(db.stdout + db.stderr).strip() if db.returncode == 0 else f'exit {db.returncode}: {db.stderr[-200:]}',
                     config_diff=lib.config_diff(before.get('config', {}), _ru_config(facts)))
        # A postconf value eFa-next itself set during the finish (the TLS profile: its groups differ with Postfix of EL10) is no
        # change of the settings; named in the log and the audit, every other change still counts.
        facts['config_diff'], own = lib.own_settings_filtered(facts['config_diff'], _safe(lambda: _tls_postfix_values(tls_profile_state()), {}))
        if own:
            _ru_log(f"settings set by eFa-next on purpose, not counted as a change: {', '.join(own)}")
            _audit(f"release upgrade: {', '.join(own)} set by eFa-next (TLS profile) during the finish, not counted as a change")
        nginx = subprocess.run(['nginx', '-t'], capture_output=True, text=True)
        facts['nginx_test'] = '' if nginx.returncode == 0 else nginx.stderr.strip()[-300:]
        facts['postfix_compatibility'] = _postconf('compatibility_level')
        facts['repo_refresh'] = _ru_repo_answers()
        facts['leftovers_kept'] = state.get('leftovers_kept') or {}
        facts['service_states'] = {unit: kind for unit, kind in _platform().release_service_states(lib.MANAGED_SERVICES, 'efa-').items()
                                   if unit + '.service' not in lib.RU_OWN_UNITS}
        try:
            _backup_make(_backup_stored_password())
            facts['backup'] = True
        except (EfaError, OSError, subprocess.SubprocessError) as err:
            facts['backup'] = str(err)[:200]
        found = lib.post_checks(facts, before)
        if found['ok']:
            break
        # A test mail that went as it should is not sent again on the next try.
        if facts['mail'] == {'clean': 'accepted', 'gtube': 'rejected', 'eicar': 'rejected'}:
            mail = facts['mail']
        # Services and the clock may need some minutes after the first boot.
        time.sleep(RU_FINISH_WAIT)
    for item in found['checks']:
        # A check that is no condition (leftover packages kept on purpose) is a warning, not a failure.
        _ru_log(f"check {'ok' if item['ok'] else 'FAILED' if item['required'] else 'warning'}: {item['name']}: {item['detail']}")
    return found


def load_set(args):
    """Limits of the load warning. The file holds no secret, efa-web reads it directly."""
    if not (args.percent.isdigit() and 1 <= int(args.percent) <= 100 and args.minutes.isdigit() and 1 <= int(args.minutes) <= 1440):
        raise EfaError('Percent must be from 1 to 100, minutes from 1 to 1440.')
    data = {'percent': int(args.percent), 'minutes': int(args.minutes)}
    _write(LOAD_FILE, json.dumps(data) + '\n')
    return data


def load_notify(args):
    # Called once a day per resource by efa-web. The text is shown only to the admin, as the body of the mail.
    text = re.sub(r'[^A-Za-z0-9 %.,:/-]', '', args.text)[:300]
    _admin_notify('eFa-next: sustained load', text)
    return {'mailed': True}


def _version_tuple(text):
    # Four parts or more: 6.0.0.4.1 is newer than 6.0.0.4; the RPM release after the dash does not count.
    match = re.search(r'\d+(?:\.\d+){3,}', text or '')
    return tuple(int(part) for part in match.group().split('.')) if match else None


def _update_state():
    state = _json_read(UPDATE_FILE, {})
    # 6.0.0.6.7: mode, days and time come from the update policy (one file a cluster shares); the rest is of this host.
    state.update({key: value for key, value in _update_policy().items() if key in ('mode', 'days', 'time')})
    for key in ('last_check', 'latest', 'notes', 'notified', 'last_result'):
        state.setdefault(key, None)
    return state


# 6.0.0.6.7 (Hans): the update policy, set on the master of a cluster and the same on every node: eFa-next releases (off,
# notify, auto), the maintenance days and time, and the operating system (off, security, all). The runtime state (the
# newest release, the last check) stays in autoupdate.json of each host; this file goes with the snapshot and the journal.
UPDATE_POLICY_FILE = ETC + '/eFa/update-policy.json'
UPDATE_OS = ('off', 'security', 'all')
UPDATE_POLICY_PUBLISHED = '/var/lib/eFa/update-policy-published.json'
DNF_AUTOMATIC_TIMERS = ('dnf-automatic.timer', 'dnf5-automatic.timer')


def _update_policy(save=True):
    """{'mode', 'days', 'time', 'os'}. The first read takes the values of before: mode, days and time of autoupdate.json,
    the operating system 'security' when dnf-automatic was on (what the setup turns on), else 'off'."""
    policy = _json_read(UPDATE_POLICY_FILE, None)
    if not isinstance(policy, dict):
        old = _json_read(UPDATE_FILE, {})
        timer_on = _safe(lambda: any(_platform().service_is_enabled(name) for name in DNF_AUTOMATIC_TIMERS), False)
        policy = {'mode': old.get('mode', 'notify'), 'days': old.get('days', ['sun']), 'time': old.get('time', '03:00'),
                  'os': 'security' if timer_on else 'off'}
        if save:
            _safe(lambda: _json_write(UPDATE_POLICY_FILE, policy, mode=0o644), None)
    days = [day for day in policy.get('days') or [] if day in UPDATE_DAYS] if isinstance(policy.get('days'), list) else []
    return {'mode': policy.get('mode') if policy.get('mode') in ('off', 'notify', 'auto') else 'notify', 'days': days or ['sun'],
            'time': policy.get('time') if re.match(r'^([01]\d|2[0-3]):[0-5]\d$', str(policy.get('time', ''))) else '03:00',
            'os': policy.get('os') if policy.get('os') in UPDATE_OS else 'off'}


def _policy_digest(policy):
    return hashlib.sha256(json.dumps(policy, sort_keys=True).encode()).hexdigest()


def _policy_publish():
    """The master: its policy into the journal once after the update to 6.0.0.6.7 (and whenever it differs from what it
    handed on last), so the nodes of a cluster of before take it: the master wins."""
    policy = _update_policy()
    digest = _policy_digest(policy)
    if _json_read(UPDATE_POLICY_PUBLISHED, {}).get('sha256') == digest:
        return False
    cluster, base, _state = _cluster_parts()
    cluster.journal_append(base, [{'type': 'command', 'command': 'autoupdate-set', 'secrets': [],
                                   'args': {'mode': policy['mode'], 'days': ' '.join(policy['days']), 'time': policy['time'], 'os': policy['os']}}])
    _json_write(UPDATE_POLICY_PUBLISHED, {'sha256': digest, 'at': int(time.time())}, mode=0o644)
    _audit('cluster: the update policy of the master handed on to the nodes')
    return True


def _os_update_apply():
    """The operating system part of the policy on this host. A host alone: dnf-automatic as the policy says (off, security
    or all). A member of a cluster: dnf-automatic off, always; its packages come only in the staged rollout of the master."""
    policy, platform_now = _update_policy(), _platform()
    want = policy['os'] != 'off' and cluster_role() == 'none'
    changed = []
    if want:
        if not os.path.exists('/etc/dnf/automatic.conf'):
            return changed
        before = _safe(lambda: platform_now.service_is_enabled('dnf-automatic.timer'), False)
        if platform_now.configure_auto_updates(upgrade_type='security' if policy['os'] == 'security' else 'default') or not before:
            changed.append(f"dnf-automatic {policy['os']}")
    else:
        for name in DNF_AUTOMATIC_TIMERS:
            if _safe(lambda name=name: platform_now.service_is_enabled(name), False):
                platform_now.service_disable(name, stop=True)
                changed.append(f'{name} off')
    if changed:
        _audit('update policy applied: ' + ', '.join(changed))
    return changed


def _policy_pending_check(policy):
    """Once a day: how many packages the policy would install here (for the master, which starts a rollout only then)."""
    pending = _pending_os_updates()
    count = len(_safe(_platform().security_updates, [])) if policy['os'] == 'security' else len(pending)
    _pending_note(pending)
    data = _json_read(UPDATE_PENDING_FILE, {})
    data['policy_count'] = count
    _json_write(UPDATE_PENDING_FILE, data, mode=0o644)
    return count


def _version_file():
    """The version file: /etc/eFa-next-Version, else the name of 6.0.0.5.x and older (on 6.0.0.6 a symlink to it)."""
    new = ETC + '/eFa-next-Version'
    return new if os.path.exists(new) else ETC + '/eFa-Version'


def _version_file_after_downgrade():
    """Back to a version of 6.0.0.5.x or older: its packages write /etc/eFa-Version as a file of its own again, and the newer
    /etc/eFa-next-Version would hold the version left, which the readers take first. Then it goes."""
    new, old = ETC + '/eFa-next-Version', ETC + '/eFa-Version'
    if os.path.exists(new) and os.path.exists(old) and not os.path.islink(old):
        os.remove(new)
        _audit(f'{new} removed after the way back to {_read_lines(old)[0] if _read_lines(old) else "an older version"}')
        return True
    return False


def _update_installed():
    lines = _read_lines(_version_file())
    return lines[0] if lines else ''


# A pre-release installed (eFa-6.0.0.6-alpha2) has the numbers of its release; until 6.0.0.6 only the release branches knew it.
PRERELEASE_RE = re.compile(r'\d-(alpha|beta|rc)\d*$')


def _installed_tag():
    """The tag of the installed version: v6.0.0.6, or v6.0.0.6-alpha2 for a pre-release (its packages are in that release)."""
    installed = _update_installed()
    numbers = _version_tuple(installed)
    if not numbers:
        return ''
    found = PRERELEASE_RE.search(installed)
    return 'v' + '.'.join(map(str, numbers)) + (installed[found.start() + 1:] if found else '')


def _update_available(state, verified_only=True):
    latest, installed = _version_tuple(state['latest']), _version_tuple(_update_installed())
    newer = bool(latest and installed and latest > installed)
    # A pre-release installed: the release of the same numbers counts as newer, only from an answer that says it is no
    # pre-release (a kept answer without the flag, from a check through the testing mirror, is not).
    if latest and latest == installed and PRERELEASE_RE.search(_update_installed()) and state.get('prerelease') is False:
        newer = True
    # Before the packages were checked, the dashboard does not call it available.
    return newer and (not verified_only or state.get('verified') == state['latest'])


SECURITY_RE = re.compile(r'\bsecurity\b|\bCVE-\d{4}-\d+', re.I)


def release_info(release):
    """What the dashboard shows of a release: version, date, a part of the notes, and whether it fixes security issues."""
    notes = (release.get('body') or '')[:4000]
    return {'latest': release['tag_name'], 'notes': notes, 'published': (release.get('published_at') or '')[:10],
            'security': bool(SECURITY_RE.search(notes) or SECURITY_RE.search(release.get('name') or '')),
            'prerelease': bool(release.get('prerelease'))}


def _update_fetch_latest(state, opener=urllib.request.urlopen):
    """Asks the release source once, with the ETag of the last answer: an unchanged release costs no download.
    No telemetry: the request carries no version, host name or ID. A source that is not there (a private repository) is a state, not an error."""
    state['last_check'] = time.strftime('%Y-%m-%d %H:%M:%S')
    # The notes are shown only; what gets installed is checked against the signed SHA256SUMS in _update_download.
    for source in _update_apis():
        headers = {'Accept': 'application/vnd.github+json', 'User-Agent': 'eFa-next'}
        if state.get('etag') and source == UPDATE_API:
            headers['If-None-Match'] = state['etag']
        try:
            with opener(urllib.request.Request(source, headers=headers), timeout=30) as reply:
                release = json.load(reply)
                etag = reply.headers.get('ETag') if source == UPDATE_API else None
        except urllib.error.HTTPError as err:
            if err.code == 304:
                state['source'], state['last_result'] = 'reachable', 'The release source answered: no new release.'
                return False
            state['last_result'] = f'Release source not reachable (HTTP {err.code}); the repository may be private. Nothing changed.'
            continue
        except (OSError, ValueError) as err:
            state['last_result'] = f'Release source not reachable: {str(err)[:120]}. Nothing changed.'
            continue
        state.update(release_info(release), source='reachable' if source == UPDATE_API else 'mirror', etag=etag,
                     last_result='The release source answered.')
        return True
    state['source'] = 'not reachable'
    return False


def _update_verify(state, fetch=None):
    """An update counts as available only when its two packages are there and match the checksums of the release."""
    if not _update_available(state, verified_only=False) or state.get('verified') == state['latest']:
        return
    folder = f"{UPDATE_DIR}/{state['latest']}"
    try:
        (fetch or _update_download)(state['latest'], folder)
    except (EfaError, OSError, ValueError) as err:
        state['verified'] = None
        state['last_result'] = f"Release {state['latest']} is not complete or does not match its checksums: {str(err)[:150]}"
        return
    state['verified'] = state['latest']
    state['first_seen'] = state.get('first_seen') if state.get('first_seen_version') == state['latest'] else time.strftime('%Y-%m-%d')
    state['first_seen_version'] = state['latest']


def _update_note(state):
    if _update_available(state) and state['notified'] != state['latest']:
        state['notified'] = state['latest']
        kind = 'security update' if state.get('security') else 'update'
        _event('update_available', 'warning' if state.get('security') else 'notice', version=state['latest'], security=bool(state.get('security')))
        _admin_notify(f'eFa-next: {kind} {state["latest"]} is available', f'Installed: {_update_installed()}\nPublished: {state.get("published") or "unknown"}\n\n{state["notes"]}')


def update_check(_args):
    """Asks GitHub for the newest release and mails the admin once per new version."""
    state = _update_state()
    _update_fetch_latest(state)
    _update_verify(state)
    _update_note(state)
    _json_write(UPDATE_FILE, state)
    return autoupdate_status(None)


def autoupdate_set(args):
    """Off, notify only, or install eFa-next updates by itself inside the maintenance window; and the operating system
    updates (off, security only, all). In a cluster only on the master: the nodes take it (6.0.0.6.7)."""
    if cluster_role() == 'client' and not os.environ.get('EFA_CLUSTER_REPLAY'):
        raise EfaError(_managed_update_text())
    mode = args.mode.strip()
    if mode not in ('off', 'notify', 'auto'):
        raise EfaError("Mode must be 'off', 'notify' or 'auto'.")
    days = [day for day in args.days.replace(',', ' ').lower().split()]
    if not days or [day for day in days if day not in UPDATE_DAYS]:
        raise EfaError(f'Days must be from: {" ".join(UPDATE_DAYS)}.')
    if not re.match(r'^([01]\d|2[0-3]):[0-5]\d$', args.time.strip()):
        raise EfaError('Time must look like 03:00.')
    policy = _update_policy()
    os_policy = (getattr(args, 'os', '') or '').strip() or policy['os']
    if os_policy not in UPDATE_OS:
        raise EfaError("Operating system updates must be 'off', 'security' or 'all'.")
    policy.update(mode=mode, days=days, time=args.time.strip(), os=os_policy)
    _json_write(UPDATE_POLICY_FILE, policy, mode=0o644)
    if cluster_role() == 'master':  # the journal hands this very change on; no second entry from the hourly job
        _safe(lambda: _json_write(UPDATE_POLICY_PUBLISHED, {'sha256': _policy_digest(policy), 'at': int(time.time())}, mode=0o644), None)
    _safe(_os_update_apply, None)
    return autoupdate_status(None)


def autoupdate_status(_args):
    """State of eFa-next updates. Operating system updates are handled by dnf-automatic."""
    state = _update_state()
    done = subprocess.run(['systemctl', 'is-enabled', 'dnf-automatic.timer'], capture_output=True, text=True)
    return {'installed': _update_installed(), 'latest': state['latest'], 'update_available': _update_available(state),
            'security_update': bool(state.get('security')) and _update_available(state), 'published': state.get('published'),
            'source': state.get('source') or 'not checked yet',
            'release_notes': state['notes'], 'mode': state['mode'], 'days': ' '.join(state['days']), 'time': state['time'],
            'last_check': state['last_check'], 'last_result': state['last_result'],
            'os_updates': 'dnf-automatic ' + (done.stdout.strip() or 'not installed'), 'os': _update_policy()['os'],
            'managed_by': _safe(lambda: _lib('efa_cluster').read_state(ETC).get('master', {}).get('name'), None) if cluster_role() == 'client' else None,
            'trust_note': UPDATE_TRUST_NOTE}


def _update_in_window(state, now):
    """Inside for the hour after the set time, because the job runs hourly."""
    hour, minute = map(int, state['time'].split(':'))
    start = now.replace(hour=hour, minute=minute, second=0, microsecond=0)
    return UPDATE_DAYS[now.weekday()] in state['days'] and start <= now < start + datetime.timedelta(hours=1)


# A marker without a process id (6.0.0.6 and older) counts as running for this long; a restore takes minutes.
RESTORE_MARKER_HOURS = 2


def _pid_alive(pid):
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def restore_marker_state(path=None, now=None, alive=_pid_alive):
    """None without a marker, 'running' while its restore runs, else 'stale': a restore that was killed (no finally) left it,
    and it would hold every update back for good."""
    path = path or RESTORE_RUNNING
    try:
        with open(path) as f:
            text = f.read(200)
        age = (now or time.time()) - os.stat(path).st_mtime
    except FileNotFoundError:
        return None
    match = re.search(r'\bpid=(\d+)', text)
    if match:
        return 'running' if alive(int(match.group(1))) else 'stale'
    return 'running' if age < RESTORE_MARKER_HOURS * 3600 else 'stale'


def _update_blocker():
    if os.path.exists('/etc/MailScanner/MailScanner.conf'):
        return 'MailScanner is installed, use efa-migrate.'
    if not os.path.exists(MONITOR_CRON):
        return 'Maintenance mode is on.'
    marker = restore_marker_state()
    if marker == 'running':
        return 'A restore is running.'
    if marker == 'stale':
        stamp = time.strftime('%Y-%m-%d %H:%M', time.localtime(os.stat(RESTORE_RUNNING).st_mtime))
        os.remove(RESTORE_RUNNING)
        _audit(f'left-over restore marker of {stamp} removed (no restore runs); updates go on')
    return None


UPDATE_PREVIOUS = '/var/lib/eFa/update-previous.json'


def _signed_sums(version, fetch=None):
    """SHA256SUMS of a release with its base address, from the repository or the mirror, only with a valid signature of the pinned key."""
    sign = _lib('efa_sign')
    with open(sign.KEY_FILE, 'rb') as f:
        key = f.read()
    fetch = fetch or (lambda url: urllib.request.urlopen(url, timeout=60).read())
    problems = []
    for base in _update_bases(version):
        try:
            data, signature = fetch(f'{base}/SHA256SUMS'), fetch(f'{base}/SHA256SUMS.asc')
        except (OSError, ValueError) as err:
            problems.append(f'{base}: {str(err)[:80]}')
            continue
        if sign.verify(data, signature, key):
            return base, dict(reversed(line.split()) for line in data.decode().splitlines() if line.strip())
        problems.append(f'{base}: signature not valid')
    raise EfaError(f'Release {version} has no SHA256SUMS signed by the eFa-next key ({"; ".join(problems)}), nothing was installed.')


def _update_download(version, folder):
    """Fetches the two packages of a release and checks them against its signed SHA256SUMS."""
    os.makedirs(folder, mode=0o700, exist_ok=True)
    # The numbers only: the packages of v6.0.0.6-alpha2 are eFa-next-6.0.0.6-0.2.alpha2.el9.noarch.rpm.
    plain = '.'.join(map(str, _version_tuple(version) or ())) or version.lstrip('v')
    base, sums = _signed_sums(version)
    # The release part of the file names differs between versions.
    # Only the names from 6.0.0.4.1 on: dnf cannot go back from eFa-next to the packages eFa and eFa-base it replaced.
    names = [n for n in sums if n.startswith((f'eFa-next-{plain}-', f'eFa-next-base-{plain}-')) and n.endswith('.rpm')]
    if len(names) != 2:
        raise EfaError(f'Release {version} does not list two packages, nothing was installed.')
    paths = []
    for name in names:
        with urllib.request.urlopen(f'{base}/{name}', timeout=300) as reply:
            data = reply.read()
        if name not in sums or hashlib.sha256(data).hexdigest() != sums[name]:
            raise EfaError(f'Checksum of {name} does not match, nothing was installed.')
        path = f'{folder}/{name}'
        with open(path, 'wb') as f:
            f.write(data)
        paths.append(path)
    return paths


def _update_health():
    """Services, rspamd config, status and the web interface, with some time to come up."""
    problems = []
    for _attempt in range(6):
        problems = [f'{unit} is not active' for unit in UPDATE_UNITS
                    if subprocess.run(['systemctl', 'is-active', '--quiet', unit]).returncode != 0]
        if not _rspamd_config_ok():
            problems.append('rspamd config test failed')
        try:
            context = ssl._create_unverified_context()
            with urllib.request.urlopen('https://127.0.0.1/login', timeout=10, context=context) as reply:
                if reply.status != 200:
                    problems.append(f'web interface answered {reply.status}')
        except OSError as err:
            problems.append(f'web interface: {err}')
        try:
            if status(None)['status'] != 'ok':
                problems.append('efactl status is not ok')
        except EfaError as err:
            problems.append(str(err))
        if not problems:
            return []
        time.sleep(10)
    return problems


def _maintenance(mode):
    maintenance_set(argparse.Namespace(mode=mode))


def _update_install(state, progress=None):
    """Runs the install in maintenance mode, so the service monitor does not interfere."""
    blocker = _update_blocker()
    if blocker:
        return f'Not installed: {blocker}'
    _maintenance('on')
    try:
        with _update_hooks('efa'):
            return _update_install_steps(state, progress)
    except EfaError as err:  # a pre hook said no, or the wrapper failed its check
        return f'Not installed: {err}'
    finally:
        _maintenance('off')


def _update_install_steps(state, progress=None):
    """Backup, install from verified local files, health check, and back to the old packages if it fails. progress: the
    record of the Update card when this install is the whole run (efactl update-install), not a step of update-system."""
    if not _update_available(state):
        return 'Not installed: no newer version known.'
    # The way back is the installed version itself: for a pre-release its own packages, never those of the release.
    current = _installed_tag()
    new = state['latest']
    try:
        _progress_step(progress, 'download')
        rollback = _update_download(current, f'{UPDATE_DIR}/rollback-{current}')
        packages = _update_download(new, f'{UPDATE_DIR}/{new}')
        _progress_step(progress, 'backup')
        backup = backup_now(None)['backup']
    except (OSError, ValueError, EfaError, subprocess.CalledProcessError) as err:
        return f'Not installed: {err}'
    if progress:
        progress['backup'] = backup
    _progress_step(progress, 'efa')
    totp_before = totp_active_count()
    with _firewall_lock(900):
        done = _dnf_transaction(['dnf', '-y', 'upgrade'] + packages, 'efa', capture_output=True, text=True)
    version_ok = _version_tuple(_update_installed()) == _version_tuple(new)
    problems = [] if done.returncode == 0 and version_ok else [f'dnf failed: {(done.stderr or done.stdout)[-300:]}']
    _progress_step(progress, 'health')
    problems = problems or _update_health()
    # S38: an update never takes a second factor away (the setup of the package ran in between).
    totp_after = totp_active_count()
    if not problems and totp_after != totp_before:
        problems = [f'second factors switched on: {totp_before} before, {totp_after} after']
    if not problems:
        # The way back for update-rollback: the verified packages of the version before, and the backup taken right before.
        _json_write(UPDATE_PREVIOUS, {'version': current, 'packages': rollback, 'backup': backup, 'installed': new,
                                      'at': time.strftime('%Y-%m-%d %H:%M:%S')})
        return f'Installed {new}, backup {backup}.'
    undo = _dnf_transaction(['dnf', '-y', 'downgrade'] + rollback, 'efa', capture_output=True, text=True)
    _version_file_after_downgrade()
    for unit in ('efa-web', 'efa-maillog', 'efa-milter-health'):
        subprocess.run(['systemctl', 'restart', unit], check=False, capture_output=True)
    undone = undo.returncode == 0 and _version_tuple(_update_installed()) == _version_tuple(current)
    text = (f'Update to {new} failed: {"; ".join(problems)}. '
            + (f'Rolled back to {current}.' if undone else f'ROLLBACK FAILED, check the system. Backup: {backup}.'))
    _admin_notify('eFa-next: automatic update failed', text)
    return text


def rollback_plan(previous, installed, exists=os.path.exists):
    """What update-rollback would do, or why it cannot."""
    if not previous:
        return None, 'No update of eFa-next was installed by this server, so there is no version to go back to.'
    if _version_tuple(installed) != _version_tuple(previous['installed']):
        return None, f"The installed version is {installed}, not {previous['installed']}: it changed since, roll back by hand."
    missing = [path for path in previous['packages'] if not exists(path)]
    if missing:
        return None, 'The packages of the version before are gone: ' + ', '.join(missing)
    return {'from': installed, 'to': previous['version'], 'packages': previous['packages'], 'backup': previous['backup']}, None


def update_rollback(args):
    """Back to the version before the last eFa-next update: its verified packages, then the backup taken right before the update.
    --dry_run yes only shows it. Settings changed since the update are lost with the backup; --backup off keeps them."""
    plan, problem = rollback_plan(_json_read(UPDATE_PREVIOUS, None), _update_installed())
    if problem:
        raise EfaError(problem)
    keep = (args.backup or 'on').strip() == 'off'
    if (args.dry_run or '').strip() == 'yes':
        return {**plan, 'restore_backup': not keep, 'dry_run': True}
    _confirm(args)
    blocker = _update_blocker()
    if blocker:
        raise EfaError(blocker)
    _maintenance('on')
    try:
        done = _dnf_transaction(['dnf', '-y', 'downgrade', *plan['packages']], 'rollback', capture_output=True, text=True)
        ok, output = done.returncode == 0, (done.stderr or done.stdout or '')[-300:]
        _version_file_after_downgrade()
        if not ok or _version_tuple(_update_installed()) != _version_tuple(plan['to']):
            raise EfaError(f"The downgrade failed, still {_update_installed()}: {output}")
        restored = None
        if not keep:
            # The backup the update itself made before; one of an update from 6.0.0.4 or older has no signature yet.
            restored = restore(argparse.Namespace(name=plan['backup'], confirm='yes', file='', signer='', unsigned='yes'))['restored']
    finally:
        _maintenance('off')
    for unit in ('efa-web', 'efa-maillog', 'efa-milter-health'):
        try:
            _platform().service_restart(unit)
        except Exception as err:  # the StepError of the platform layer; the rollback itself is done
            print(f'restart {unit}: {err}', file=sys.stderr)
    os.remove(UPDATE_PREVIOUS)
    _admin_notify('eFa-next: rolled back', f"eFa-next went back from {plan['from']} to {plan['to']}" + (f', backup {restored} restored.' if restored else '.'))
    return {'rolled_back_to': plan['to'], 'backup_restored': restored}


def update_run(args):
    """Hourly job: checks GitHub once a day, installs only in auto mode inside the window."""
    # The hourly job and an install button must not run at the same time.
    lock = open(UPDATE_LOCK, 'w')
    try:
        import fcntl
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return {'update': 'already running'}
    state, policy, role = _update_state(), _update_policy(), cluster_role()
    force = (getattr(args, 'install', '') or '').strip() == 'yes'
    # 6.0.0.6.7: the policy of the operating system on this host, and once a day what it would install.
    _safe(_os_update_apply, None)
    if policy['os'] != 'off' and (_json_read(UPDATE_PENDING_FILE, {}).get('at') or '')[:10] != time.strftime('%Y-%m-%d'):
        _safe(lambda: _policy_pending_check(policy), None)
    if role == 'master' and not force:
        _safe(_policy_publish, None)
    if state['mode'] != 'off' or force:
        if force or not state['last_check'] or state['last_check'][:10] != time.strftime('%Y-%m-%d'):
            _update_fetch_latest(state)
            _update_verify(state)
        _update_note(state)
        _json_write(UPDATE_FILE, state)
    # O2: in a cluster every install is staged (6.0.0.6.7): the master leads the rollout, a node waits for it (or, without
    # its master for long, installs security updates alone: update_fallback_step).
    if not force and role == 'master':
        _safe(cluster_update_step, None)
        return autoupdate_status(None)
    if not force and (role == 'client' or update_staged()):
        _safe(update_fallback_step, None)
        return autoupdate_status(None)
    if state['mode'] == 'off' and not force:
        return {'update': 'off'}
    if _update_available(state) and (force or (state['mode'] == 'auto' and _update_in_window(state, datetime.datetime.now()))):
        progress = _progress_begin('efa', to=state['latest'])
        result = _update_install(state, progress)
        _progress_end(progress, result.startswith('Installed'), result)
        state['last_result'] = f'{time.strftime("%Y-%m-%d %H:%M")} {result}'
        _json_write(UPDATE_FILE, state)
    return autoupdate_status(None)


def update_install(args):
    """Installs the newest eFa-next release now, in the background; the web interface restarts on the way."""
    _confirm(args)
    role = cluster_role()
    if role == 'client' and acting_client != 'cluster-master':  # the master of 6.0.0.6.6 still sends this in its rollout
        raise EfaError(_managed_update_text())
    if role == 'master':
        return cluster_update_start({'os': 'off', 'efa': True})
    blocker = _update_blocker()
    if blocker:
        raise EfaError(blocker)
    subprocess.run(['systemd-run', '--unit=efa-autoupdate-now', '--collect', '/usr/sbin/efactl', 'update-run', '--install=yes'],
                   check=True, capture_output=True)
    return {'update': 'started', 'log': 'journalctl -u efa-autoupdate-now', 'result': 'efactl autoupdate-status'}


def mariadb_repair(args):
    """Repair and optimize all databases. Mail stays queued meanwhile."""
    _confirm(args)
    env = _mysql_env()
    subprocess.run(['systemctl', 'stop', 'postfix'], check=False, capture_output=True)
    try:
        for mode in ('--repair', '--optimize'):
            done = subprocess.run(['mysqlcheck', '--user=root', mode, '--all-databases'], env=env,
                                  capture_output=True, text=True, check=True)
    finally:
        subprocess.run(['systemctl', 'start', 'postfix'], check=False, capture_output=True)
    return {'mariadb_repair': 'done', 'output': done.stdout[-500:]}


IPV6_METHODS = ('auto', 'manual', 'ignore', 'disabled')
IPV6_KERNEL_OFF = 'IPv6 is switched off in the kernel'


def ipv6_effective(connection_method, kernel_ipv6):
    """The IPv6 method that is in effect: disabled when the kernel has IPv6 off, else the one of the connection."""
    return ('disabled', IPV6_KERNEL_OFF) if not kernel_ipv6 else ((connection_method or '').strip(), '')


def network_show(_args):
    """Current hostname and network settings, IPv6 as it is in effect (the kernel decides when it has IPv6 off)."""
    device = _network_device()
    done = subprocess.run(['nmcli', '-t', '-f', 'ipv4.method,ipv4.addresses,ipv4.gateway,ipv4.dns,ipv6.method,ipv6.addresses,ipv6.gateway',
                           'connection', 'show', device], capture_output=True, text=True, check=True)
    shown = dict(line.split(':', 1) for line in done.stdout.splitlines())
    shown['ipv6.method'], note = ipv6_effective(shown.get('ipv6.method'), _platform().ipv6_available())
    return shown | ({'ipv6_note': note} if note else {}) | {
        'connection': device, 'hostname': subprocess.run(['hostname', '-f'], capture_output=True, text=True).stdout.strip()}


def _network_device():
    done = subprocess.run(['nmcli', '-t', '-f', 'NAME,TYPE', 'connection', 'show', '--active'],
                          capture_output=True, text=True, check=True)
    for line in done.stdout.splitlines():
        name, _, kind = line.rpartition(':')
        if kind == '802-3-ethernet':
            return name
    raise EfaError('No active ethernet connection.')


def network_set(args):
    """Set hostname and IPv4 address. Takes effect after the next reboot so a typo cannot cut the session."""
    _confirm(args)
    fqdn = args.hostname.strip().lower()
    if not DOMAIN_RE.match(fqdn):
        raise EfaError('Hostname must be a full name, for example mx1.example.org.')
    method = args.method.strip()
    if method not in ('auto', 'manual'):
        raise EfaError("Method must be 'auto' or 'manual'.")
    # Validate everything first: nmcli only runs once all input is known to be good.
    if method == 'manual':
        try:
            iface = ipaddress.IPv4Interface(args.address.strip())
            gateway = ipaddress.IPv4Address(args.gateway.strip())
        except ValueError:
            raise EfaError('Address must look like 192.0.2.10/24 and the gateway like 192.0.2.1.')
        if gateway not in iface.network:
            raise EfaError('Gateway is not in the network of the address.')
        ipv4 = ['ipv4.method', 'manual', 'ipv4.addresses', str(iface), 'ipv4.gateway', str(gateway)]
        address = str(iface.ip)
    else:
        ipv4 = ['ipv4.method', 'auto', 'ipv4.addresses', '', 'ipv4.gateway', '']
        address = None
    method6 = (args.ipv6_method or '').strip()
    if method6 and method6 not in IPV6_METHODS:
        raise EfaError("IPv6 method must be 'auto', 'manual', 'ignore' or 'disabled'.")
    # Unchanged (the form shows what is in effect) or empty: IPv6 stays as it is, never a quiet switch to another method.
    keep6 = not method6 or (method6 != 'manual' and method6 == network_show(None).get('ipv6.method'))
    address6 = None
    if keep6:
        ipv6 = []
    elif method6 == 'manual':
        try:
            iface6 = ipaddress.IPv6Interface(args.ipv6_address.strip())
            gateway6 = ipaddress.IPv6Address(args.ipv6_gateway.strip())
        except ValueError:
            raise EfaError('IPv6 address must look like 2001:db8::10/64 and the gateway like 2001:db8::1.')
        ipv6 = ['ipv6.method', 'manual', 'ipv6.addresses', str(iface6), 'ipv6.gateway', str(gateway6), 'ipv6.dns', '::1']
        address6 = str(iface6.ip)
    else:
        ipv6 = ['ipv6.method', method6, 'ipv6.addresses', '', 'ipv6.gateway', '']
    device = _network_device()
    subprocess.run(['nmcli', 'connection', 'modify', device] + ipv4 + ['ipv4.dns', '127.0.0.1'] + ipv6, check=True,
                   capture_output=True)
    short = fqdn.split('.')[0]
    shutil.copy2(HOSTS, HOSTS + '.bak')
    lines = ['127.0.0.1   localhost localhost.localdomain localhost4 localhost4.localdomain4',
             '::1         localhost localhost.localdomain localhost6 localhost6.localdomain6']
    if address:
        lines.append(f'{address}    {fqdn}   {short}')
    if address6:
        lines.append(f'{address6}    {fqdn}   {short}')
    _write(HOSTS, '\n'.join(lines) + '\n')
    _write(ETC + '/hostname', fqdn + '\n')
    _postconf_set('myhostname', fqdn)
    return {'hostname': fqdn, 'method': method, 'address': args.address.strip(), 'ipv6_method': 'unchanged' if keep6 else method6,
            'ipv6_address': args.ipv6_address.strip(), 'effective': 'after reboot'}


# The files of eFa-next that name the host. Others (logs, copies, the history of a migration) keep the old name.
HOSTNAME_MAPS = ('helo_access', 'sender_canonical', 'recipient_canonical', 'canonical', 'generic', 'virtual', 'transport', 'relocated')


def renamed_text(text, old, new):
    """Every whole occurrence of the old host name (full and short, any case) as the new one: full for full, short for short."""
    old_short, new_short = old.split('.')[0], new.split('.')[0]
    text = re.sub(r'(?<![\w.-])' + re.escape(old) + r'(?![\w-])', new, text, flags=re.I)
    return re.sub(r'(?<![\w.-])' + re.escape(old_short) + r'(?![\w.-])', new_short, text, flags=re.I)


# S29: a host cloned from another one keeps the secrets of its origin. clone-reset makes new what belongs to one host only; what
# encrypts or names data that exists (or is meant to be the same, such as the keys of the domains) stays and is named.
BOOT_DIR = os.environ.get('EFA_BOOT', '/boot')
CLONE_WEB_SECRETS = ((ETC + '/efa-web/secret.key', 'efa-websecret'), (ETC + '/efa-portal/secret.key', 'efa-portal'))
CLONE_KEPT = (
    (ETC + '/eFa/totp.key', 'encrypts the 2FA secrets in the database'),
    (ETC + '/eFa/audit-strict.key', 'checks the chain of the strict audit log written so far'),
    (ETC + '/eFa/audit-anchor.key', 'signs the daily audit anchors; the anchors before name its public key'),
    (ETC + '/eFa/pseudonymise.key', 'the pseudonyms in the mail log; a new key would make them unfindable'),
    (ETC + '/eFa/eve-export.key', 'the pseudonyms of the SIEM export, the same reason'),
    (ETC + '/eFa/quarantine-keys', 'decrypt held mail and the emergency copies of the tenants'),
    (ETC + '/eFa/crypto', 'S/MIME and PGP keys of the own addresses and domains, the same for every host of them'),
    (ETC + '/rspamd/dkim', 'DKIM and ARC keys of the domains, published in DNS'),
    (ETC + '/eFa/dkim-api', 'server certificate of the provisioning API, pinned by its sources'),
    (ETC + '/eFa/MySQL-Config', 'passwords of the local database, used only on this host'),
    (ETC + '/eFa/backup-targets', 'access to the backup targets: point this host at an own folder or bucket'),
    (ETC + '/letsencrypt', 'certificates for the old host name: request new ones after a new name'),
    ('/var/ossec/etc/client.keys', 'Wazuh agent identity: enroll this host again'))


def bls_entry_files(text):
    """The linux and initrd paths of a BLS entry, relative to /boot."""
    return [line.split(None, 1)[1].strip() for line in text.splitlines() if line.split(None, 1)[0:1] in (['linux'], ['initrd']) and
            len(line.split(None, 1)) > 1]


def clone_boot_entries(boot, old_id, new_id, running=''):
    """The boot loader entries and rescue images of the machine id of the origin: the rescue of the old id goes (a new one comes
    with the next kernel), every other entry of the old id takes the new id (name and content); entries whose kernel or initrd is
    gone are dropped, never the one of the running kernel. [(what, path)]."""
    done = []
    if not old_id or old_id == new_id:
        return done
    # The leading dot: the .hmac of the rescue kernel (glob's * skips hidden names).
    for path in sorted(glob.glob(f'{boot}/*-rescue-{old_id}*') + glob.glob(f'{boot}/.*-rescue-{old_id}*')):
        os.remove(path)
        done.append(('removed', path))
    for path in sorted(glob.glob(f'{boot}/loader/entries/{old_id}-*.conf')):
        name = os.path.basename(path)
        if '-rescue' in name.split(old_id, 1)[1]:
            os.remove(path)
            done.append(('removed', path))
            continue
        with open(path) as f:
            text = f.read()
        target = os.path.join(os.path.dirname(path), new_id + name[len(old_id):])
        with open(target + '.tmp', 'w') as f:
            f.write(text.replace(old_id, new_id))
        os.chmod(target + '.tmp', os.stat(path).st_mode & 0o7777)
        os.replace(target + '.tmp', target)
        os.remove(path)
        done.append(('renamed', target))
    for path in sorted(glob.glob(f'{boot}/loader/entries/*.conf')):
        with open(path) as f:
            files = bls_entry_files(f.read())
        if running and running in os.path.basename(path):
            continue
        if files and not all(os.path.exists(boot + '/' + item.lstrip('/')) for item in files):
            os.remove(path)
            done.append(('removed', path))
    return done


def _clone_boot(old_id, new_id):
    """clone_boot_entries on /boot, taken back when grubby no longer names the running kernel as the default afterwards."""
    entries = BOOT_DIR + '/loader/entries'
    before = {}
    for path in glob.glob(entries + '/*.conf'):
        with open(path) as f:
            before[path] = f.read()
    running = os.uname().release
    kernel = f'{BOOT_DIR}/vmlinuz-{running}'
    done = clone_boot_entries(BOOT_DIR, old_id, new_id, running)
    default = subprocess.run(['grubby', '--default-kernel'], capture_output=True, text=True)
    listed = subprocess.run(['grubby', '--info=ALL'], capture_output=True, text=True)
    if default.returncode == 0 and default.stdout.strip() == kernel and kernel in listed.stdout:
        return done
    for path in glob.glob(entries + '/*.conf'):
        if path not in before:
            os.remove(path)
    for path, text in before.items():
        with open(path, 'w') as f:
            f.write(text)
    raise EfaError(f'grubby no longer names {kernel} as the default after the boot entries took the new machine id; they are back as '
                   'they were. Check them with grubby --info=ALL.')


def _clone_secret(path, group):
    """64 random bytes, root:group 0640, as the package setup makes it."""
    fd = os.open(path + '.tmp', os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o640)
    os.fchmod(fd, 0o640)
    with os.fdopen(fd, 'wb') as f:
        f.write(os.urandom(64))
    with contextlib.suppress(KeyError, LookupError, PermissionError):
        shutil.chown(path + '.tmp', 'root', group)
    os.replace(path + '.tmp', path)
    _safe(lambda: _platform().restore_context(path), None)


def _clone_ed25519_fingerprint(path):
    from cryptography.hazmat.primitives import serialization
    with open(path, 'rb') as f:
        return key_fingerprint(_raw_public(serialization.load_pem_private_key(f.read(), None).public_key()))


def clone_reset(args):
    """S29: new per-host secrets on a cloned host: SSH host keys, machine id, host name, the keys of the web interface and the
    portal, the backup and offline signing keys, SRS and link keys. Only root on the console, never in a cluster."""
    _confirm(args)
    if identity_now is not None or os.geteuid() != 0:
        raise EfaError('Only root on the console.')
    if cluster_role() != 'none':
        raise EfaError('This host is in a cluster: take it out first (efactl cluster-leave), then reset it.')
    platform_now, done, notes = _platform(), [], []
    # 1. SSH host keys, made as the setup does; sshd is restarted only when it takes its settings.
    for path in glob.glob(ETC + '/ssh/ssh_host_*_key*'):
        os.remove(path)
    subprocess.run(['ssh-keygen', '-A'], check=True, capture_output=True)
    for path in glob.glob(ETC + '/ssh/ssh_host_*'):
        _safe(lambda path=path: platform_now.restore_context(path), None)
    if subprocess.run(['sshd', '-t'], capture_output=True).returncode != 0:
        raise EfaError('sshd -t refuses the settings with the new host keys; sshd was not restarted. Check them before the next login.')
    platform_now.service_restart('sshd')
    done.append('SSH host keys new')
    notes.append('Keep this session open and test a new SSH login: clients see a new host key.')
    # 2. machine id, and the boot entries named after the old one.
    machine_id = ETC + '/machine-id'
    old_id = _read_lines(machine_id)[0].strip() if _read_lines(machine_id) else ''
    if os.path.exists(machine_id):
        os.remove(machine_id)
    subprocess.run(['systemd-machine-id-setup'], check=True, capture_output=True)
    new_id = _read_lines(machine_id)[0].strip() if _read_lines(machine_id) else ''
    boot = _clone_boot(old_id, new_id) if old_id and old_id != new_id else []
    done.append(f'machine id new ({len(boot)} boot files of the old one adjusted)')
    # 3. host name, everywhere eFa-next writes it (also the self-signed certificate).
    if (args.hostname or '').strip():
        hostname_set(argparse.Namespace(hostname=args.hostname, confirm='yes'))
        done.append(f'host name {args.hostname.strip().lower()}')
    # 4. the keys of the web interface and the portal (sessions, forms, single sign-on), and the key between nginx and them.
    for path, group in CLONE_WEB_SECRETS:
        if os.path.isdir(os.path.dirname(path)):
            _clone_secret(path, group)
    for path, _group in PROXY_KEY_FILES:
        if os.path.exists(path):
            os.remove(path)
    _proxy_key_write()
    _safe(lambda: _admin_query('DELETE FROM web_sessions'), None)
    platform_now.service_reload_if_active('nginx')
    for unit in ('efa-web', 'efa-portal'):
        _safe(lambda unit=unit: platform_now.service_try_restart(unit), None)
    done.append('keys of the web interface, the portal and nginx new; all logins end')
    # 5. signing keys of this host: made again on first use; backups and bundles of before name the old key.
    for path, what in ((BACKUP_SIGN_KEY, 'backup signing key'), (OFFLINE_KEY, 'offline bundle key')):
        if os.path.exists(path) and not (path == BACKUP_SIGN_KEY and os.path.exists(BACKUP_HSM)):
            fingerprint = _safe(lambda path=path: _clone_ed25519_fingerprint(path), '')
            os.remove(path)
            done.append(f'{what} removed (a new one on first use)')
            if fingerprint:
                notes.append(f'Fingerprint of the old {what}: {fingerprint} (backups and bundles of before need it).')
    if os.path.exists(SRS_KEY):
        _write(SRS_KEY, secrets.token_hex(32) + '\n', mode=0o640)
        done.append('SRS key new')
    state = _safe(content_state, None)
    if state and state.get('links', {}).get('key'):
        state['links']['key'] = secrets.token_hex(32)
        _content_apply(state)
        done.append('key of the link check new')
    tokens = _safe(lambda: _admin_query('SELECT COUNT(*) AS n FROM api_tokens')[0]['n'], 0)
    if tokens:
        notes.append(f'{tokens} API tokens of the origin work here too: revoke those this host does not need (efactl token-revoke).')
    kept = [f'{path}: {why}' for path, why in CLONE_KEPT if os.path.exists(path)]
    down = [unit for unit in ('sshd', 'postfix', 'nginx', 'efa-web') if not _safe(lambda unit=unit: platform_now.service_is_active(unit), False)]
    if down:
        notes.append('Not running: ' + ', '.join(down))
    notes.append('Mail leaves this host as before: keep the outbound block on until the clone has its own name and addresses.')
    _audit(f"clone reset by {_dmarc_who()}: {'; '.join(done)}")
    return {'done': done, 'kept': kept, 'notes': notes}


def hostname_set(args):
    """The host name everywhere eFa-next writes it: the system, /etc/hosts, Postfix and its tables, the eFa-next settings, the address
    of the checked links and the self-signed certificate. A certificate of Let's Encrypt or an own one stays: request a new one."""
    _confirm(args)
    new = args.hostname.strip().lower().rstrip('.')
    if not DOMAIN_RE.match(new) or '.' not in new:
        raise EfaError('Host name: a full name, such as mx2.example.org.')
    old = (own_hostname()).strip().lower()
    changed = []
    # The same name again only puts the own address into /etc/hosts (a clone has the address of its origin there).
    if old != new:
        subprocess.run(['hostnamectl', 'set-hostname', new], check=False, capture_output=True)
        _write(ETC + '/hostname', new + '\n')
        changed.append('/etc/hostname')
    paths = [HOSTS, ETC + '/eFa/eFa-Config'] + [f'{ETC}/postfix/{name}' for name in HOSTNAME_MAPS] if old != new else []
    for path in paths:
        if not os.path.exists(path):
            continue
        with open(path) as f:
            text = f.read()
        fixed = renamed_text(text, old, new)
        if fixed != text:
            shutil.copy2(path, path + '.before-rename')
            _write(path, fixed)
            changed.append(_etc_relative(path))
            if path.startswith(ETC + '/postfix/') and _map_compiled(path):
                subprocess.run(['postmap', _map(path)], check=False, capture_output=True)
    # The block of eFa-next in /etc/hosts names this host by its own address now; a clone keeps the address of its origin otherwise.
    own = _own_address(socket.AF_INET, '192.0.2.1')
    if own and os.path.exists(HOSTS):
        sys.path.insert(0, '/usr/lib/eFa/python')
        import efa_common
        with open(HOSTS) as f:
            text = f.read()
        fixed = efa_common.replace_block(text, [f'{own} {new} {new.split(".")[0]}'])
        if fixed != text:
            _write(HOSTS, fixed)
            changed.append(f'/etc/hosts: {new} at {own}')
    _postconf_set('myhostname', new)
    changed.append('postfix myhostname')
    content = _json_read(CONTENT_FILE, {})
    base = content.get('links', {}).get('base', '')
    if base and renamed_text(base, old, new) != base:
        content['links']['base'] = renamed_text(base, old, new)
        _write(CONTENT_FILE, json.dumps(content, indent=1))
        _content_apply(content)
        changed.append('address of the checked links')
    cert = _platform().path('cert_file') if hasattr(_platform(), 'path') else '/etc/pki/tls/certs/efa.crt'
    subject = subprocess.run(['openssl', 'x509', '-noout', '-subject', '-issuer', '-nameopt', 'RFC2253', '-in', cert], capture_output=True, text=True).stdout.split('\n')
    if len(subject) >= 2 and subject[0].replace('subject=', '') == subject[1].replace('issuer=', ''):
        sys.path.insert(0, '/usr/lib/eFa/python')
        import efa_common
        efa_common.ensure_certificate(new, force=True)
        changed.append('self-signed certificate')
    for unit in ('mta', 'web'):
        try:
            _platform().service_reload_if_active(_platform().service(unit))
        except Exception:  # noqa: S110 - a service this host does not have
            pass
    _audit(f'host name changed from {old} to {new} by {_dmarc_who()}')
    left = subprocess.run(['grep', '-rli', '--exclude=*.before-rename', '--exclude=*.bak*', '--exclude-dir=efa5-import', old, ETC + '/eFa', ETC + '/postfix',
                           ETC + '/efa-web', ETC + '/rspamd', ETC + '/nginx', HOSTS], capture_output=True, text=True).stdout.split()
    return {'hostname': new, 'was': old, 'changed': changed, 'still_naming_the_old_name': left,
            'note': 'DNS (A, PTR, MX), SPF and a certificate of Let\'s Encrypt are outside this host: change them too.'}


def letsencrypt_set(args):
    """Request a Let's Encrypt certificate for nginx and postfix. Port 80 must be reachable from outside. certbot only gets the
    certificate through the webroot of nginx; eFa-next writes its paths into its own nginx and Postfix settings, as the
    takeover of an eFa 5 certificate does (MIG-LE). With an own ECDSA certificate for the web (web-cert-set ecdsa) nginx keeps
    it: only Postfix gets the new one."""
    domain = args.domain.strip().lower()
    email = args.email.strip().lower()
    if not DOMAIN_RE.match(domain):
        raise EfaError('Invalid domain.')
    if not SENDER_RE.match(email):
        raise EfaError('Invalid email address.')
    if args.accept_tos.strip() != 'yes':
        raise EfaError("Type 'yes' to accept the Let's Encrypt terms of service.")
    # 5t-b: ECDSA P-256 (BSI TR-02102-1), not RSA 2048.
    # P8: the renewals keep the key, so a published TLSA 3 1 1 record stays right (DANE); a new key: letsencrypt-rollover.
    notes = _acme_request(['certbot', 'certonly', '--webroot', '-w', ACME_WEBROOT, '--non-interactive', '--agree-tos', '--key-type', 'ecdsa',
                           '--elliptic-curve', 'secp256r1', '--reuse-key', '--cert-name', domain, '-m', email, '--domains', domain],
                          [domain], force=(getattr(args, 'force', '') or '').strip() == 'yes')
    live = f'{ETC}/letsencrypt/live/{domain}'
    web_own = web_cert_own()
    if not web_own:
        # nginx first: if it rejects the certificate, Postfix keeps its own too.
        _nginx_certificate(f'{live}/fullchain.pem', f'{live}/privkey.pem')
    _json_write(ACME_FILE, {**_json_read(ACME_FILE, {}), 'domain': domain, 'lineage': domain, 'email': email}, mode=0o644)
    _postconf_set('smtpd_tls_key_file', f'{live}/privkey.pem')
    _postconf_set('smtpd_tls_cert_file', f'{live}/fullchain.pem')
    _write(ETC + '/cron.d/certbotrenew', CERTBOT_RENEW_CRON)
    _platform().file_labels(ETC + '/letsencrypt')
    for unit in ('postfix',) if web_own else ('nginx', 'postfix'):
        _platform().service_reload_if_active(unit)
    _audit(f"Let's Encrypt certificate for {domain} set by {_dmarc_who()}" + (' (the web keeps its own ECDSA certificate)' if web_own else ''))
    return {'letsencrypt': domain, 'web': 'own ECDSA certificate kept' if web_own else 'this certificate', **({'hint': ' '.join(notes)} if notes else {})}


def web_cert_own():
    """Whether nginx uses the own ECDSA lineage of the web (web-cert-set ecdsa), read from its settings file."""
    try:
        with open(NGINX_CONF) as f:
            found = re.search(r'^\s*ssl_certificate\s+([^;]+);', f.read(), re.M)
    except OSError:
        return False
    return bool(found) and f'/letsencrypt/live/{WEB_LINEAGE}/' in found.group(1)


def _maillog_db():
    import pymysql
    with open(MAILLOG_PW) as f:
        password = f.read().strip()
    try:
        return _maillog_connect(pymysql, password)
    except pymysql.MySQLError as err:
        raise EfaError(f'The mail log database does not answer: {err}')


def _maillog_connect(pymysql, password):
    return pymysql.connect(unix_socket='/var/lib/mysql/mysql.sock', user='efa_log', password=password, database='efa',
                           charset='utf8mb4', autocommit=True, cursorclass=pymysql.cursors.DictCursor)


def maillog_live(args):
    """The newest mails, or only those after a known entry. The live log filters them in the browser."""
    after = (args.after_id or '').strip()
    if after and not after.isdigit():
        raise EfaError('after_id must be a number.')
    db = _maillog_db()
    try:
        with db.cursor() as cur:
            cur.execute('SELECT id, CAST(ts AS CHAR) AS ts, qid, message_id, sender, rcpt, ip, action, score, subject, '
                        'spf, dkim, dmarc FROM maillog WHERE id > %s ORDER BY id DESC LIMIT 1000', (int(after or 0),))
            return {'mails': cur.fetchall()}
    finally:
        db.close()


def maillog_setup(_args):
    """Create the mail log database and its restricted user. Safe to run again."""
    os.makedirs(WEB_DIR, mode=0o750, exist_ok=True)
    if os.path.exists(MAILLOG_PW):
        with open(MAILLOG_PW) as f:
            password = f.read().strip()
    else:
        password = secrets.token_urlsafe(32)
        fd = os.open(MAILLOG_PW, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o640)
        os.fchmod(fd, 0o640)  # the umask must not take the group read away
        with os.fdopen(fd, 'w') as f:
            f.write(password + '\n')
    shutil.chown(MAILLOG_PW, 'root', 'efa-web')
    sql = f"""CREATE DATABASE IF NOT EXISTS efa CHARACTER SET utf8mb4;
CREATE TABLE IF NOT EXISTS efa.maillog (
  id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
  ts DATETIME NOT NULL, qid VARCHAR(64), message_id VARCHAR(255), sender VARCHAR(255), rcpt VARCHAR(1000),
  ip VARCHAR(64), action VARCHAR(32), score FLOAT, subject VARCHAR(500),
  KEY ts (ts), KEY sender (sender), KEY qid (qid));
ALTER TABLE efa.maillog ADD COLUMN IF NOT EXISTS spf VARCHAR(16), ADD COLUMN IF NOT EXISTS dkim VARCHAR(16),
  ADD COLUMN IF NOT EXISTS dmarc VARCHAR(16), ADD COLUMN IF NOT EXISTS arc VARCHAR(16), ADD COLUMN IF NOT EXISTS threat VARCHAR(255),
  ADD COLUMN IF NOT EXISTS size INT UNSIGNED, ADD COLUMN IF NOT EXISTS symbols TEXT;
CREATE USER IF NOT EXISTS 'efa_log'@'localhost' IDENTIFIED BY '{password}';
ALTER USER 'efa_log'@'localhost' IDENTIFIED BY '{password}';
GRANT SELECT, INSERT, DELETE ON efa.maillog TO 'efa_log'@'localhost';
ALTER TABLE efa.maillog ADD COLUMN IF NOT EXISTS header_from VARCHAR(255), ADD COLUMN IF NOT EXISTS reply_to VARCHAR(255),
  ADD COLUMN IF NOT EXISTS return_path VARCHAR(255), ADD COLUMN IF NOT EXISTS x_mailer VARCHAR(255);
ALTER TABLE efa.maillog ADD KEY IF NOT EXISTS message_id (message_id(191)), ADD KEY IF NOT EXISTS header_from (header_from(191)),
  ADD KEY IF NOT EXISTS reply_to (reply_to(191)), ADD KEY IF NOT EXISTS return_path (return_path(191)), ADD KEY IF NOT EXISTS x_mailer (x_mailer(191));
CREATE TABLE IF NOT EXISTS efa.mail_headers (
  maillog_id BIGINT UNSIGNED PRIMARY KEY, ts DATETIME NOT NULL, domain VARCHAR(253) NOT NULL DEFAULT '', raw_size INT UNSIGNED NOT NULL,
  truncated TINYINT NOT NULL DEFAULT 0, data MEDIUMBLOB NOT NULL, KEY ts (ts), KEY domain (domain));
GRANT SELECT, INSERT ON efa.mail_headers TO 'efa_log'@'localhost';
CREATE TABLE IF NOT EXISTS efa.dns_records (
  sha256 CHAR(64) PRIMARY KEY, name VARCHAR(255) NOT NULL, type VARCHAR(8) NOT NULL, data BLOB NOT NULL, first_seen DATETIME NOT NULL,
  last_seen DATETIME NOT NULL, KEY last_seen (last_seen));
CREATE TABLE IF NOT EXISTS efa.mail_evidence (
  maillog_id BIGINT UNSIGNED PRIMARY KEY, ts DATETIME NOT NULL, domain VARCHAR(253) NOT NULL DEFAULT '', data MEDIUMBLOB NOT NULL, KEY ts (ts), KEY domain (domain));
GRANT SELECT, INSERT, UPDATE ON efa.dns_records TO 'efa_log'@'localhost';
GRANT SELECT, INSERT ON efa.mail_evidence TO 'efa_log'@'localhost';
ALTER TABLE efa.maillog ADD KEY IF NOT EXISTS rcpt (rcpt(191)), ADD KEY IF NOT EXISTS ip (ip), ADD KEY IF NOT EXISTS action (action),
  ADD FULLTEXT KEY IF NOT EXISTS subject_text (subject);
ALTER TABLE efa.maillog ADD COLUMN IF NOT EXISTS pseudo TINYINT NOT NULL DEFAULT 0;
CREATE TABLE IF NOT EXISTS efa.sign_daily (
  day DATE NOT NULL, kind VARCHAR(16) NOT NULL, domain VARCHAR(253) NOT NULL, selector VARCHAR(64) NOT NULL DEFAULT '', n INT UNSIGNED NOT NULL,
  PRIMARY KEY (day, kind, domain, selector), KEY domain (domain));
CREATE TABLE IF NOT EXISTS efa.dmarc_rua (
  id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY, report_id VARCHAR(255) NOT NULL, org VARCHAR(255) NOT NULL, domain VARCHAR(253) NOT NULL,
  begin_ts DATETIME NOT NULL, end_ts DATETIME NOT NULL, source_ip VARCHAR(64) NOT NULL, n INT UNSIGNED NOT NULL, disposition VARCHAR(16) NOT NULL,
  dkim VARCHAR(16) NOT NULL, spf VARCHAR(16) NOT NULL, header_from VARCHAR(253) NOT NULL DEFAULT '',
  UNIQUE KEY report_row (org(100), report_id(100), source_ip, header_from(40)), KEY domain_day (domain, begin_ts));
CREATE TABLE IF NOT EXISTS efa.tls_rpt (
  id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY, report_id VARCHAR(255) NOT NULL, org VARCHAR(255) NOT NULL, domain VARCHAR(253) NOT NULL,
  begin_ts DATETIME NOT NULL, end_ts DATETIME NOT NULL, policy VARCHAR(16) NOT NULL, success INT UNSIGNED NOT NULL, failure INT UNSIGNED NOT NULL,
  failures JSON, UNIQUE KEY report_policy (org(100), report_id(100), policy), KEY domain_day (domain, begin_ts));
CREATE TABLE IF NOT EXISTS efa.dkim_selectors (
  domain VARCHAR(253) NOT NULL, selector VARCHAR(64) NOT NULL, alg VARCHAR(16) NOT NULL DEFAULT '', direction VARCHAR(3) NOT NULL,
  first_seen DATETIME NOT NULL, last_seen DATETIME NOT NULL, n_pass BIGINT UNSIGNED NOT NULL DEFAULT 0, n_fail BIGINT UNSIGNED NOT NULL DEFAULT 0,
  last_result VARCHAR(12) NOT NULL DEFAULT '', key_bits INT NULL, key_checked DATETIME NULL, PRIMARY KEY (domain, selector, alg, direction), KEY last_seen (last_seen));
CREATE TABLE IF NOT EXISTS efa.dkim_selector_daily (
  day DATE NOT NULL, domain VARCHAR(253) NOT NULL, selector VARCHAR(64) NOT NULL, alg VARCHAR(16) NOT NULL DEFAULT '', direction VARCHAR(3) NOT NULL,
  n_pass INT UNSIGNED NOT NULL DEFAULT 0, n_fail INT UNSIGNED NOT NULL DEFAULT 0, PRIMARY KEY (day, domain, selector, alg, direction));
GRANT SELECT, INSERT, UPDATE ON efa.dkim_selectors TO 'efa_log'@'localhost';
GRANT SELECT, INSERT, UPDATE ON efa.dkim_selector_daily TO 'efa_log'@'localhost';
GRANT INSERT ON efa.dmarc_rua TO 'efa_log'@'localhost';
GRANT INSERT ON efa.tls_rpt TO 'efa_log'@'localhost';
CREATE TABLE IF NOT EXISTS efa.maillog_daily (
  day DATE NOT NULL, domain VARCHAR(253) NOT NULL DEFAULT '', total INT UNSIGNED NOT NULL DEFAULT 0, clean INT UNSIGNED NOT NULL DEFAULT 0,
  spam INT UNSIGNED NOT NULL DEFAULT 0, rejected INT UNSIGNED NOT NULL DEFAULT 0, viruses INT UNSIGNED NOT NULL DEFAULT 0,
  PRIMARY KEY (day, domain), KEY domain (domain));
GRANT SELECT, INSERT, DELETE ON efa.maillog_daily TO 'efa_log'@'localhost';
CREATE TABLE IF NOT EXISTS efa.delivered_iocs (
  maillog_id BIGINT UNSIGNED NOT NULL, ts DATETIME NOT NULL, kind VARCHAR(8) NOT NULL, h CHAR(64) NOT NULL, KEY ts (ts), KEY h (h));
GRANT INSERT ON efa.delivered_iocs TO 'efa_log'@'localhost';
""" + ADMIN_SQL
    subprocess.run(['mysql', '--user=root'], input=sql, text=True, env=_mysql_env(), check=True, capture_output=True)
    _exporter_write()
    _headers_policy_write()
    # S31: what removed logins of 6.0.0.6 and older left behind (2FA secrets, passkeys, tokens, groups); S38: the names first,
    # never an account with @ (the main admin), and each name in the audit.
    names = sorted({row['username'] for sql in orphan_selects() for row in _admin_query(sql)})
    orphans = _admin_transaction(orphan_statements(names)) if names else [0] * len(USER_ROWS)
    if any(orphans):
        _audit(f"left-over rows of removed users deleted ({', '.join(names)[:600]}): "
               + ', '.join(f'{table} {count}' for table, count in zip(USER_ROWS, orphans)))
    return {'maillog_setup': 'done', 'orphans_removed': dict(zip(USER_ROWS, orphans))}


# MIG-587: a migration from eFa 5 kept its submission line in master.cf: SASL through dovecot (gone), its own client and
# recipient checks (also a placeholder blocklist with [YOUR_API_KEY]), no TLS to relays, a login map of eFa 5. The checks of
# eFa-next ($efa_submission_restrictions) were never used.
EFA5_SMTPS_MARKS = ('[YOUR_API_KEY]',)
# Set on 587 by efactl itself (sasl-apply, submission milters): never foreign, kept as they are when they hold its values.
SUBMISSION_MANAGED = {'smtpd_sasl_auth_enable': None, 'smtpd_sasl_path': SASL_SOCKET, 'smtpd_milters': '$efa_submission_milters'}
# MIG-587 (owner, 2026-11-12): AUTH of the eFa 5 block (Dovecot) is not taken over. eFa-next offers AUTH on 587 only for its own
# logins (submitters) or the system accounts switched on by the admin; the dashboard says so while 587 is without AUTH.
SUBMISSION_EFA5_AUTH = '/var/lib/eFa/submission-efa5-auth'


def submission_problems(options, wanted):
    """The options of the submission service that are not those of eFa-next (others, or other values); the ones efactl sets
    itself later (SASL, milters) count as its own while they hold its values."""
    foreign = sorted(name for name in options if name not in wanted and not (
        name in SUBMISSION_MANAGED and SUBMISSION_MANAGED[name] in (None, options[name])))
    differ = sorted(name for name, value in wanted.items() if options.get(name) != value and name != 'smtpd_sasl_auth_enable')
    return foreign, differ


def submission_entry_same(now, line):
    """The 8 fields of master.cf of the submission service as wanted. postconf -M prints the -o options of the entry inline
    after them; those are compared on their own (submission_problems)."""
    return now[:8] == line.split()


def _postconf_service_options(service):
    done = subprocess.run(['postconf', '-P'], capture_output=True, text=True)
    found = {}
    for line in done.stdout.splitlines():
        key, sep, value = line.partition(' = ')
        if sep and key.startswith(service + '/'):
            found[key[len(service) + 1:]] = value.strip()
    return found


def postfix_unused(text):
    """The names postconf warns about as unused parameters (main.cf sets them, nothing refers to them)."""
    return sorted(set(re.findall(r'unused parameter: ([A-Za-z0-9_]+)=', text)))


def _postfix_unused():
    return postfix_unused(subprocess.run(['postconf', '-n'], capture_output=True, text=True).stderr)


def postfix_submission_heal(_args):
    """The submission service of eFa-next in master.cf (port 587), in place of one of eFa 5, and no smtps of eFa 5 that needs
    dovecot. master.cf is kept as master.cf.efa-submission-<time>.bak first. Safe to run again: nothing to do, nothing changes."""
    services = _lib('efa_services')
    entry, wanted = services.SUBMISSION, services.SUBMISSION_OPTIONS
    master = ETC + '/postfix/master.cf'
    now = subprocess.run(['postconf', '-M', entry[0]], capture_output=True, text=True).stdout.split()
    options = _postconf_service_options(entry[0])
    foreign, differ = submission_problems(options, wanted)
    smtps = _postconf_service_options('smtps/inet')
    smtps_old = any(mark in f'{name}={value}' for name, value in smtps.items() for mark in EFA5_SMTPS_MARKS)
    if submission_entry_same(now, entry[1]) and not foreign and not differ and not smtps_old:
        return {'submission': 'eFa-next', 'unused_parameters': _postfix_unused()}
    backup = f"{master}.efa-submission-{time.strftime('%Y%m%d-%H%M%S')}.bak"
    shutil.copy2(master, backup)
    efa5_auth = options.get('smtpd_sasl_auth_enable') == 'yes' and options.get('smtpd_sasl_type') == 'dovecot'
    if now:
        subprocess.run(['postconf', '-MX', entry[0]], check=True, capture_output=True)
    subprocess.run(['postconf', '-M', f'{entry[0]}={entry[1]}'], check=True, capture_output=True)
    keep = {name: options[name] for name, value in SUBMISSION_MANAGED.items() if name in options and value in (None, options[name])}
    for name, value in {**wanted, **keep}.items():
        subprocess.run(['postconf', '-P', f'{entry[0]}/{name}={value}'], check=True, capture_output=True)
    if smtps_old:
        subprocess.run(['postconf', '-MX', 'smtps/inet'], check=True, capture_output=True)
    check = subprocess.run(['postfix', 'check'], capture_output=True, text=True)
    if check.returncode != 0:
        shutil.copy2(backup, master)
        raise EfaError(f'postfix check refused the new submission service, master.cf is back as it was: {check.stderr[-300:]}')
    _platform().service_reload_if_active('postfix')
    removed = ', '.join(foreign) or 'none'
    _audit(f'Postfix submission (587) of eFa 5 replaced by the one of eFa-next; removed options: {removed}'
           + ('; smtps (465) of eFa 5 with its placeholder blocklist removed' if smtps_old else '') + f'; before: {backup}')
    if efa5_auth:
        dovecot = _platform().service_is_active(_platform().service('sasl'))
        _write(SUBMISSION_EFA5_AUTH, json.dumps({'at': time.strftime('%Y-%m-%d %H:%M:%S'), 'dovecot_active': dovecot, 'backup': backup}) + '\n')
        _audit(f"SMTP AUTH on 587 of eFa 5 (Dovecot, {'running' if dovecot else 'not running'}) not taken over: 587 offers AUTH again "
               'once submitters with a login exist or the system accounts are switched on (efactl submission-pam-set)')
    # MIG-587: afterwards nothing of main.cf is unused, above all efa_submission_restrictions (submission refers to it again).
    unused = _postfix_unused()
    return {'submission': 'replaced', 'removed_options': foreign, 'smtps_removed': smtps_old, 'backup': backup, 'unused_parameters': unused}


# The verdicts the mail log stores (efa-maillog.py), for result: in the search.
MAILLOG_ACTIONS = ('no action', 'add header', 'rewrite subject', 'greylist', 'soft reject', 'reject', 'virus')


def _like(text):
    return text.replace('\\', '\\\\').replace('%', '\\%').replace('_', '\\_')


MAILLOG_TOKEN_RE = re.compile(r'(?:^|\s)(domain|from|ip|result):(\S+)', re.I)


def maillog_filter(text, domain, ip):
    """The WHERE of the mail log search: the text anywhere, the domain of the sender or of a recipient, the IP exactly.
    The text may hold filters too: domain:example.com from:a@example.com ip:192.0.2.1 result:reject (no_action for no action)."""
    tokens = {key.lower(): value for key, value in MAILLOG_TOKEN_RE.findall(text)}
    text = MAILLOG_TOKEN_RE.sub(' ', text)
    domain, ip = (domain.strip() or tokens.get('domain', '')).lower().lstrip('@'), ip.strip() or tokens.get('ip', '')
    sender, result = tokens.get('from', '').lower(), tokens.get('result', '').lower().replace('_', ' ')
    if result and result not in MAILLOG_ACTIONS:
        raise EfaError('result: one of ' + ', '.join(item.replace(' ', '_') for item in MAILLOG_ACTIONS) + '.')
    if domain and not DOMAIN_RE.match(domain):
        raise EfaError('Domain: a domain such as example.com.')
    if ip:
        try:
            ip = str(ipaddress.ip_address(ip))
        except ValueError:
            raise EfaError('IP: an IPv4 or IPv6 address.')
    needle = '%' + _like(text.strip()) + '%'
    where, params = ['(sender LIKE %s OR rcpt LIKE %s OR subject LIKE %s OR qid LIKE %s OR ip LIKE %s)'], [needle] * 5
    if domain:
        # rcpt holds the recipients separated by ", ".
        at = '%@' + _like(domain)
        where.append('(sender LIKE %s OR rcpt LIKE %s OR rcpt LIKE %s)')
        params += [at, at, at + ',%']
    if ip:
        where.append('ip = %s')
        params.append(ip)
    if sender:
        where.append('sender LIKE %s')
        params.append('%' + _like(sender) + '%')
    if result:
        where.append('action = %s')
        params.append(result)
    return ' AND '.join(where), params


def maillog_search(args):
    """Search the mail log by sender, recipient, subject, queue ID or IP, and by domain and sending IP."""
    try:
        limit = int(args.limit)
    except ValueError:
        raise EfaError('Limit must be a number.')
    if not 1 <= limit <= 1000:
        raise EfaError('Limit must be 1 to 1000.')
    where, params = maillog_filter(args.text or '', getattr(args, 'domain', '') or '', getattr(args, 'ip', '') or '')
    db = _maillog_db()
    try:
        with db.cursor() as cur:
            cur.execute('SELECT id, CAST(ts AS CHAR) AS ts, qid, sender, rcpt, ip, action, score, subject, spf, dkim, dmarc '
                        f'FROM maillog WHERE {where} ORDER BY ts DESC, id DESC LIMIT %s', (*params, limit))
            mails = cur.fetchall()
    finally:
        db.close()
    filters = [f'{key}:{value}' for key, value in MAILLOG_TOKEN_RE.findall(args.text or '')]
    filters += [f'{key}:{value.strip()}' for key, value in (('domain', getattr(args, 'domain', '') or ''), ('ip', getattr(args, 'ip', '') or '')) if value.strip()]
    mails = geo_rows(mails)
    return {'mails': mails, 'query': (args.text or '').strip(), 'filters': filters, **({'geo_credit': GEOIP_CREDIT} if any('origin' in row for row in mails) else {})}


def _maillog_days():
    for line in _read_lines(MAILLOG_DAYS_FILE):
        if line.isdigit():
            return int(line)
    return MAILLOG_DEFAULT_DAYS


def maillog_retention_set(args):
    """Days to keep the mail log. It holds personal data, so keep it as short as you can."""
    try:
        days = int(args.days)
    except ValueError:
        raise EfaError('Days must be a number.')
    if not 1 <= days <= 3650:
        raise EfaError('Days must be 1 to 3650.')
    _write(MAILLOG_DAYS_FILE, f'{days}\n')
    return {'maillog_days': days}


def _maillog_max_mb():
    for line in _read_lines(MAILLOG_SIZE_FILE):
        if line.isdigit():
            return int(line)
    return 0


def maillog_size_set(args):
    """Largest size of the mail log in MB; the oldest entries go first. 0 turns the limit off."""
    try:
        megabytes = int(args.megabytes)
    except ValueError:
        raise EfaError('Size must be a number.')
    if not 0 <= megabytes <= 10485760:
        raise EfaError('Size must be 0 to 10485760 MB.')
    _write(MAILLOG_SIZE_FILE, f'{megabytes}\n')
    return {'maillog_max_mb': megabytes}


def maillog_purge(_args):
    """Delete entries older than the retention period and, if set, the oldest ones above the size limit."""
    days, max_mb = _maillog_days(), _maillog_max_mb()
    db = _maillog_db()
    try:
        with db.cursor() as cur:
            deleted = 0
            for where, params in retention_deletes(days, retention_tenants(), _tenant_domains_or_none(), 'maillog', ('sender', 'rcpt')):
                deleted += cur.execute(f'DELETE FROM maillog WHERE {where}', params)
            deleted_size = 0
            if max_mb:
                cur.execute("SELECT data_length + index_length AS size FROM information_schema.tables "
                            "WHERE table_schema = 'efa' AND table_name = 'maillog'")
                size = cur.fetchone()['size'] or 0
                cur.execute('SELECT COUNT(*) AS n FROM maillog')
                rows = cur.fetchone()['n']
                limit = max_mb * 1024 * 1024
                if size > limit and rows:
                    # shortcut: row sizes are averaged, so the result is close to the limit, not exact.
                    keep = int(rows * limit / size)
                    cur.execute('SELECT id FROM maillog ORDER BY id DESC LIMIT 1 OFFSET %s', (keep,))
                    found = cur.fetchone()
                    if found:
                        deleted_size = cur.execute('DELETE FROM maillog WHERE id <= %s', (found['id'],))
    finally:
        db.close()
    if deleted or deleted_size:
        # InnoDB keeps freed space in its file until the table is rebuilt.
        subprocess.run(['mysqlcheck', '--user=root', '--optimize', 'efa', 'maillog'], env=_mysql_env(),
                       check=True, capture_output=True)
    if deleted or deleted_size:
        _audit(f'retention: {deleted} mail log entries older than their days and {deleted_size} above the size limit deleted')
    pseudonymised = 0
    if pseudo_days():
        db = _admin_db()
        try:
            pseudonymised = _maillog_pseudonymise(db, pseudo_days())
        finally:
            db.close()
        if pseudonymised:
            _audit(f'pseudonyms: {pseudonymised} mail log entries older than {pseudo_days()} days')
    return {'deleted_by_age': deleted, 'deleted_by_size': deleted_size, 'pseudonymised': pseudonymised, 'maillog_days': days, 'maillog_max_mb': max_mb}


# D2: after the set days the addresses in the mail log keep their domain, the part before the @ becomes an HMAC pseudonym, and
# the subject goes. The key is for root only. Searching one exact address still finds its old rows, but only for logins that may
# read headers (the admins); everybody else sees the pseudonyms. Off after an upgrade; a new install pseudonymises after 14 days.
PSEUDO_FILE = ETC + '/eFa/pseudonymise.json'
PSEUDO_KEY = ETC + '/eFa/pseudonymise.key'
PSEUDO_COLUMNS = ('sender', 'header_from', 'reply_to', 'return_path')
PSEUDO_CHOICES = (0, 7, 14, 30, 90)
PSEUDO_RE = re.compile(r'^p[0-9a-f]{16}@')


def _pseudo_key():
    if not os.path.exists(PSEUDO_KEY):
        fd = os.open(PSEUDO_KEY, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, 'w') as f:
            f.write(secrets.token_hex(32) + '\n')
    with open(PSEUDO_KEY) as f:
        return bytes.fromhex(f.read().strip())


def pseudonym(key, address):
    """p<16 hex>@domain for an address; a pseudonym or a text without @ stays as it is."""
    address = (address or '').strip()
    if '@' not in address or PSEUDO_RE.match(address):
        return address
    local, _, domain = address.rpartition('@')
    return 'p' + hmac.new(key, local.lower().encode(), hashlib.sha256).hexdigest()[:16] + '@' + domain.lower()


def pseudo_row(key, row):
    """The columns of one mail log row with pseudonyms; rcpt holds several addresses."""
    changed = {column: pseudonym(key, row.get(column)) if row.get(column) else row.get(column) for column in PSEUDO_COLUMNS}
    changed['rcpt'] = ', '.join(pseudonym(key, item) for item in (row.get('rcpt') or '').split(', ') if item) or row.get('rcpt')
    changed['subject'] = None
    return changed


def pseudo_days():
    return int(_json_read(PSEUDO_FILE, {}).get('days', 0))


def _maillog_pseudonymise(db, days, batch=5000):
    """Rows older than days get their pseudonyms; at most 40 batches a night, the next night goes on."""
    if not days:
        return 0
    key, done = _pseudo_key(), 0
    with db.cursor() as cur:
        for _ in range(40):
            cur.execute('SELECT id, ' + ', '.join(PSEUDO_COLUMNS) + ', rcpt FROM maillog WHERE pseudo = 0 AND ts < NOW() - INTERVAL %s DAY '
                        'ORDER BY id LIMIT %s', (days, batch))
            rows = cur.fetchall()
            for row in rows:
                changed = pseudo_row(key, row)
                cur.execute('UPDATE maillog SET ' + ', '.join(f'{column} = %s' for column in changed) + ', pseudo = 1 WHERE id = %s',
                            [*changed.values(), row['id']])
            done += len(rows)
            if len(rows) < batch:
                break
    return done


def pseudonymise_status(_args):
    """D2: after how many days the addresses in the mail log become pseudonyms."""
    days = pseudo_days()
    return {'days': days, 'enabled': bool(days), 'headers_days': headers_policy()['days'] if headers_policy()['store'] else 0,
            'note': 'Stored headers have their own days (headers-store-set); keep them as short as these.'}


def pseudonymise_set(args):
    """After 7, 14, 30 or 90 days the part before the @ of every address in the mail log becomes a pseudonym, 0 is off."""
    days = (args.days or '').strip()
    if not days.isdigit() or int(days) not in PSEUDO_CHOICES:
        raise EfaError('Days: ' + ', '.join(map(str, PSEUDO_CHOICES)) + ' (0 is off).')
    _json_write(PSEUDO_FILE, {'days': int(days)}, mode=0o644)
    if int(days):
        _pseudo_key()
    _audit(f'mail log pseudonyms after {days} days set by {_dmarc_who()}')
    return pseudonymise_status(None)

# D1: the data of one mail address, for the right of access (GDPR Art. 15) and of erasure (Art. 17). Both are in the audit log with
# the pseudonym of the address (D2) and the reason, never the address itself.
GDPR_LIMIT = 10000


def _gdpr_address(args):
    address = (args.address or '').strip().lower()
    if not SENDER_RE.match(address) or '@' not in address:
        raise EfaError('A full mail address, such as anna@example.com.')
    domain = address.rpartition('@')[2]
    if identity_now and identity_now.get('domains') is not None and domain not in identity_now['domains']:
        raise EfaError('Not allowed: name an address of your own domains.')
    return address


def gdpr_maillog_where(address, key=None):
    """WHERE of the mail log rows of an address, as sender, recipient or in From, Reply-To and Return-Path; with its pseudonym too."""
    forms = [address] + ([pseudonym(key, address)] if key else [])
    parts, params = [], []
    for form in forms:
        pattern = search_pattern(form)
        parts += ['sender = %s', 'header_from = %s', 'reply_to = %s', 'return_path = %s', 'rcpt = %s', 'rcpt LIKE %s', 'rcpt LIKE %s', 'rcpt LIKE %s']
        params += [form, form, form, form, form, pattern + ',%', '%, ' + pattern, '%, ' + pattern + ',%']
    return '(' + ' OR '.join(parts) + ')', params


def _gdpr_redis(address, delete=False):
    """The BEC relations and the writing profile of the address in Redis (4): their keys, deleted if asked."""
    keys = []
    for pattern in (f'efa:bec:rel:{address}|*', f'efa:bec:rel:*|{address}', f'efa:bec:style:{address}', f'efa:bec:pat:{address}',
                    f'efa:bec:day:{address}:*'):
        done = subprocess.run([_redis_cli(), '--raw', '--scan', '--pattern', pattern], capture_output=True, text=True, timeout=60)
        keys += [line for line in done.stdout.splitlines() if line]
    if delete:
        for start in range(0, len(keys), 500):
            subprocess.run([_redis_cli(), 'DEL', *keys[start:start + 500]], capture_output=True, timeout=60)
    return keys


def gdpr_export(args):
    """Right of access (GDPR Art. 15): everything eFa-next keeps about one mail address."""
    address = _gdpr_address(args)
    key = _pseudo_key() if pseudo_days() else None
    where, params = gdpr_maillog_where(address, key)
    db = _admin_db()
    try:
        with db.cursor() as cur:
            cur.execute(f'SELECT id, CAST(ts AS CHAR) AS ts, qid, message_id, sender, rcpt, ip, action, score, subject, header_from, reply_to, return_path '
                        f'FROM maillog WHERE {where} ORDER BY id LIMIT {GDPR_LIMIT}', params)
            mails = cur.fetchall()
            ids = [row['id'] for row in mails]
            headers = []
            if ids:
                cur.execute('SELECT maillog_id, CAST(ts AS CHAR) AS ts, data FROM mail_headers WHERE maillog_id IN (' + ', '.join(['%s'] * len(ids)) + ')', ids)
                headers = [{'maillog_id': row['maillog_id'], 'ts': row['ts'], 'headers': _headers_text(row['data'])} for row in cur.fetchall()]
            cur.execute('SELECT r.id, r.state, CAST(m.ts AS CHAR) AS ts, m.sender, m.subject, r.rcpt FROM quarantine_rcpt r JOIN quarantine_mail m '
                        'ON m.id = r.mail_id WHERE r.rcpt = %s OR m.sender = %s LIMIT %s', (address, address, GDPR_LIMIT))
            quarantine = cur.fetchall()
            cur.execute('SELECT id, CAST(ts AS CHAR) AS ts, username, source, sender, subject, verdict, state FROM train_requests '
                        'WHERE sender = %s OR username = %s LIMIT %s', (address, address, GDPR_LIMIT))
            reports = cur.fetchall()
            cur.execute('SELECT username, email, CAST(created AS CHAR) AS created, CAST(last_login AS CHAR) AS last_login, source FROM users '
                        'WHERE username = %s OR email = %s', (address, address))
            accounts = cur.fetchall()
    finally:
        db.close()
    relations = _gdpr_redis(address)
    _audit(f'GDPR access for {pseudonym(_pseudo_key(), address)} by {_dmarc_who()}: {len(mails)} mail log rows')
    strict_record('gdpr_access', pseudonym(_pseudo_key(), address))
    return {'address': address, 'mail_log': mails, 'stored_headers': headers, 'quarantine': quarantine, 'spam_reports': reports,
            'accounts': accounts, 'mail_relations': len(relations),
            'note': 'Not in here: backups (kept 5 days, then gone), the logs of the operating system (journal, /var/log/maillog, rotated), '
                    'and mail already delivered to the mailbox. An erasure (gdpr-delete) is done again after a restore.'}


def _headers_text(data):
    try:
        return zlib.decompress(data).decode('utf-8', 'replace')
    except (zlib.error, TypeError):
        return bytes(data or b'').decode('utf-8', 'replace')


# Package 15 (Hans 2026-11-19): erasure in full. Also the accounts of the address and its entries of the sender lists, when asked;
# and every erased address goes, as its pseudonym only, into a list outside the backups: a restore of an older backup erases it
# again. The backups themselves stay as they are (signed).
GDPR_ERASED = '/var/lib/eFa/gdpr-erased.json'


def _yes(args, name):
    value = (getattr(args, name, '') or '').strip().lower()
    if value not in ('', 'yes', 'no'):
        raise EfaError(f'{name.capitalize()}: yes or empty.')
    return value == 'yes'


def gdpr_lists_erase(address):
    """The entries of the sender lists with the address: in the allow and block lists, and rules with it as sender or recipient."""
    removed = 0
    for which in SENDER_MAPS:
        lines = _read_lines(SENDER_MAPS[which])
        keep = [line for line in lines if line.strip().lower() != address]
        if len(keep) != len(lines):
            _write(SENDER_MAPS[which], ''.join(line + '\n' for line in keep))
            removed += len(lines) - len(keep)
    rules = _read_lines(SENDER_RULES)
    keep = [line for line in rules if line.count('|') != 2 or address not in [part.strip().lower() for part in line.split('|')[1:]]]
    if len(keep) != len(rules):
        _write(SENDER_RULES, ''.join(line + '\n' for line in keep))
        removed += len(rules) - len(keep)
    meta = _json_read(SENDER_META, {})
    if meta.pop(address, None) is not None:
        _json_write(SENDER_META, meta)
    if removed:
        _reload_rspamd()
        _allow_postfix_apply()
    return removed


def gdpr_accounts_erase(address):
    """The logins of the address (as user name or mail address) with their 2FA, passkeys, tokens and sessions, through the checks of
    a removal (never the last super admin, only in the scope of the admin)."""
    names = [row['username'] for row in _admin_query('SELECT username FROM users WHERE username = %s OR email = %s', (address, address))]
    for username in names:
        old = _load_identity(username, allow_disabled=True)
        _check_user_change(username, old['grants'] if old else {}, {}, True, [])
        _admin_transaction(user_remove_statements(username, _dmarc_who()))
    return len(names)


def gdpr_erased_add(alias, accounts, lists, path=None):
    """Notes an erased address by its pseudonym, never the address."""
    path = path or GDPR_ERASED
    erased = _safe(lambda: _json_read(path, {}), {}) or {}
    old = erased.get(alias, {})
    erased[alias] = {'date': _today().isoformat(), 'accounts': bool(accounts or old.get('accounts')), 'lists': bool(lists or old.get('lists'))}
    os.makedirs(os.path.dirname(path), exist_ok=True)
    _json_write(path, erased, mode=0o600)


def gdpr_candidates(values, key, erased):
    """Of the addresses found (plain or already pseudonymised), those whose pseudonym is in the erasure list."""
    found = set()
    for value in values:
        for item in (value or '').split(','):
            item = item.strip().strip('<>').lower()
            if '@' in item and pseudonym(key, item) in erased:
                found.add(item)
    return sorted(found)


def gdpr_reapply():
    """After a restore: the addresses erased since that backup are erased again, found by their pseudonym. Returns how many."""
    erased = _safe(lambda: _json_read(GDPR_ERASED, {}), {}) or {}
    if not erased:
        return 0
    key = _pseudo_key()
    rows = _admin_query('SELECT sender AS a FROM maillog UNION SELECT header_from FROM maillog UNION SELECT reply_to FROM maillog '
                        'UNION SELECT return_path FROM maillog UNION SELECT rcpt FROM maillog UNION SELECT rcpt FROM quarantine_rcpt '
                        'UNION SELECT sender FROM quarantine_mail UNION SELECT sender FROM train_requests UNION SELECT username FROM train_requests '
                        'UNION SELECT username FROM users UNION SELECT email FROM users')
    values = [row['a'] for row in rows] + _read_lines(SENDER_MAPS['allow']) + _read_lines(SENDER_MAPS['block']) + \
        [part for line in _read_lines(SENDER_RULES) if line.count('|') == 2 for part in line.split('|')[1:]]
    done = 0
    for address in gdpr_candidates(values, key, erased):
        flags = erased[pseudonym(key, address)]
        try:
            counts = _gdpr_erase(address, flags.get('accounts'), flags.get('lists'))
        except EfaError as err:
            _audit(f'GDPR erasure of {pseudonym(key, address)} after the restore failed: {err}')
            continue
        done += 1
        _audit(f'GDPR erasure of {pseudonym(key, address)} again after a restore: ' + ', '.join(f'{k} {v}' for k, v in counts.items()))
    return done


def gdpr_reapply_command(_args):
    """Erases again every address of the erasure list that is in the data (after a restore, which does it by itself)."""
    return {'erased_again': gdpr_reapply()}


def gdpr_delete(args):
    """Right of erasure (GDPR Art. 17): the mail log rows, stored headers, quarantine and spam reports of one mail address; its
    accounts and its entries of the sender lists when asked. A restore of an older backup erases it again."""
    _confirm(args)
    address = _gdpr_address(args)
    reason = ' '.join((args.reason or '').split())
    if len(reason) < 5:
        raise EfaError('Give the reason, such as the date and number of the request, at least 5 characters.')
    accounts, lists = _yes(args, 'accounts'), _yes(args, 'lists')
    counts = _gdpr_erase(address, accounts, lists)
    alias = pseudonym(_pseudo_key(), address)
    gdpr_erased_add(alias, accounts, lists)
    _audit(f'GDPR erasure for {alias} by {_dmarc_who()}, reason: {reason[:200]}: ' + ', '.join(f'{k} {v}' for k, v in counts.items()))
    strict_record('gdpr_erasure', alias, reason=reason[:200], new=counts)
    kept = [text for text, asked in (('accounts (Users)', accounts), ('entries of the sender lists', lists)) if not asked]
    return {'erased': counts, 'audit_name': alias,
            'note': (f'Kept as not asked: {" and ".join(kept)}. ' if kept else '') + 'Mail of this sender held for other recipients is theirs. '
                    'Backups keep the data for up to 5 days; a restore of one erases it again (erasure list with the pseudonym only).'}


def _gdpr_erase(address, accounts=False, lists=False):
    """The erasure itself: {what: count}."""
    key = _pseudo_key() if pseudo_days() else None
    where, params = gdpr_maillog_where(address, key)
    counts = {}
    db = _admin_db()
    try:
        with db.cursor() as cur:
            cur.execute(f'SELECT id FROM maillog WHERE {where}', params)
            ids = [row['id'] for row in cur.fetchall()]
            for start in range(0, len(ids), 1000):
                chunk = ids[start:start + 1000]
                marks = ', '.join(['%s'] * len(chunk))
                for table in ('mail_headers', 'mail_evidence'):
                    cur.execute(f'DELETE FROM {table} WHERE maillog_id IN ({marks})', chunk)
                cur.execute(f'DELETE FROM maillog WHERE id IN ({marks})', chunk)
            counts['mail_log'] = len(ids)
            cur.execute('SELECT DISTINCT mail_id FROM quarantine_rcpt WHERE rcpt = %s', (address,))
            mails = [row['mail_id'] for row in cur.fetchall()]
            counts['quarantine'] = cur.execute('DELETE FROM quarantine_rcpt WHERE rcpt = %s', (address,))
            cur.execute('DELETE FROM quarantine_links WHERE rcpt = %s', (address,))
            for mail_id in mails:
                cur.execute('SELECT 1 FROM quarantine_rcpt WHERE mail_id = %s LIMIT 1', (mail_id,))
                if not cur.fetchall():
                    cur.execute('DELETE FROM quarantine_mail WHERE id = %s', (mail_id,))
                    if os.path.exists(_uq_path(mail_id)):
                        os.remove(_uq_path(mail_id))
            counts['spam_reports'] = cur.execute('DELETE FROM train_requests WHERE sender = %s OR username = %s', (address, address))
    finally:
        db.close()
    counts['mail_relations'] = len(_gdpr_redis(address, delete=True))
    if accounts:
        counts['accounts'] = gdpr_accounts_erase(address)
    if lists:
        counts['sender_lists'] = gdpr_lists_erase(address)
    return counts

# O3: help for the reports of a significant incident under NIS2 Art. 23: the early warning within 24 hours, the notification
# within 72 hours and the final report within a month. eFa-next collects the timeline and the facts it knows; the operator
# answers the questions and sends the report to the CSIRT or authority (in Austria GovCERT/CERT.at), eFa-next sends nothing.
INCIDENT_DIR = ETC + '/eFa/incidents'
INCIDENT_STAGES = {'early': ('Early warning', 24), 'notification': ('Incident notification', 72), 'final': ('Final report', 24 * 30),
                   # GDPR Art. 33: to the supervisory authority within 72 hours of becoming aware of a personal data breach.
                   'gdpr': ('Personal data breach notification (GDPR Art. 33)', 72),
                   # DORA Art. 19 with the RTS/ITS on major ICT incidents: initial within 4 hours of the classification as major and at
                   # the latest 24 hours after becoming aware, intermediate within 72 hours, final within a month.
                   'dora-initial': ('DORA initial notification', 24), 'dora-intermediate': ('DORA intermediate report', 72),
                   'dora-final': ('DORA final report', 24 * 30)}
# DORA Art. 18 and the RTS on classification (Regulation (EU) 2024/1772): the criteria a financial entity assesses itself.
DORA_CRITERIA = ('Clients, financial counterparts and transactions affected', 'Reputational impact', 'Duration and service downtime',
                 'Geographical spread', 'Data losses (availability, authenticity, integrity, confidentiality)',
                 'Critical or important functions affected', 'Economic impact')
INCIDENT_ANSWERS = ('unknown', 'yes', 'no')
INCIDENT_ID_RE = re.compile(r'^\d{8}-\d{6}$')


def _incident(incident_id):
    if not INCIDENT_ID_RE.match(incident_id or ''):
        raise EfaError('Incident: the id from incident-list, such as 20261108-101500.')
    path = f'{INCIDENT_DIR}/{incident_id}.json'
    if not os.path.exists(path):
        raise EfaError('No such incident.')
    return _json_read(path, {})


def incident_open(args):
    """Opens an incident record: what happened, since when it is known, and the first answers of the NIS2 report."""
    title = ' '.join((args.title or '').split())[:200]
    detected = (args.detected or '').strip()
    if len(title) < 5:
        raise EfaError('A title of at least 5 characters.')
    try:
        when = datetime.datetime.strptime(detected, '%Y-%m-%d %H:%M')
    except ValueError:
        raise EfaError('Detected at: like 2026-11-08 10:15 (time of this server).')
    record = {'id': time.strftime('%Y%m%d-%H%M%S'), 'title': title, 'detected': when.strftime('%Y-%m-%d %H:%M'), 'opened_by': _dmarc_who(),
              'summary': ' '.join((args.summary or '').split())[:4000]}
    for field in ('malicious', 'cross_border', 'personal_data'):
        value = (getattr(args, field, '') or 'unknown').strip()
        if value not in INCIDENT_ANSWERS:
            raise EfaError(f'{field}: unknown, yes or no.')
        record[field] = value
    record['impact'] = ' '.join((args.impact or '').split())[:2000]
    record['subjects'] = ' '.join((getattr(args, 'subjects', '') or '').split())[:500]
    os.makedirs(INCIDENT_DIR, mode=0o700, exist_ok=True)
    _json_write(f'{INCIDENT_DIR}/{record["id"]}.json', record)
    _audit(f'incident {record["id"]} opened by {_dmarc_who()}: {title}')
    strict_record('incident_opened', record['id'])
    return {**record, 'deadlines': incident_deadlines(record['detected'])}


def incident_deadlines(detected):
    start = datetime.datetime.strptime(detected, '%Y-%m-%d %H:%M')
    return {stage: (start + datetime.timedelta(hours=hours)).strftime('%Y-%m-%d %H:%M') for stage, (_name, hours) in INCIDENT_STAGES.items()}


def incident_list(_args):
    """The incident records with their deadlines."""
    rows = []
    for path in sorted(glob.glob(INCIDENT_DIR + '/*.json'), reverse=True):
        item = _json_read(path, {})
        rows.append({'id': item.get('id'), 'title': item.get('title'), 'detected': item.get('detected'), 'deadlines': incident_deadlines(item['detected'])})
    return {'incidents': rows}


def incident_timeline(start, end, audit_lines, event_lines, limit=300):
    """What happened between start and end (datetime, local time of the server): audit entries and events of warning and above."""
    found = []
    for line in audit_lines:
        stamp = line[:19]
        try:
            when = datetime.datetime.strptime(stamp, '%Y-%m-%d %H:%M:%S')
        except ValueError:
            continue
        if start <= when <= end:
            found.append((when, 'audit', line[20:].strip()[:300]))
    for line in event_lines:
        try:
            record = json.loads(line)
            when = datetime.datetime.fromisoformat(record['timestamp'].replace('Z', '+00:00')).astimezone().replace(tzinfo=None)
        except (ValueError, KeyError, TypeError):
            continue
        if start <= when <= end and record.get('severity') in ('warning', 'error', 'critical'):
            what = ', '.join(f'{key}={value}' for key, value in sorted(record.items()) if key not in ('timestamp', 'host', 'efa_version', 'severity'))
            found.append((when, record['severity'], what[:300]))
    found.sort()
    return [(when.strftime('%Y-%m-%d %H:%M:%S'), kind, text) for when, kind, text in found][-limit:]


def incident_text(record, stage, timeline, facts):
    """The report as Markdown: the fields NIS2 Art. 23 asks for at this stage, the facts and the timeline."""
    name, hours = INCIDENT_STAGES[stage]
    deadline = incident_deadlines(record['detected'])[stage]
    lines = [f"# {name}: {record['title']}", '', f"NIS2 Art. 23. Detected {record['detected']}, due by {deadline} ({hours} h). "
             f"Incident {record['id']}, opened by {record['opened_by']}. Prepared by eFa-next; check and complete it before sending.", '',
             '## Answers', '', f"- Suspected unlawful or malicious act: {record['malicious']}", f"- Cross-border impact: {record['cross_border']}",
             f"- Impact on the service: {record.get('impact') or 'to be described'}", f"- Summary: {record.get('summary') or 'to be described'}"]
    if stage in ('notification', 'final'):
        lines += ['- Initial assessment: severity and impact, indicators of compromise (see facts and timeline)']
    if stage == 'final':
        lines += ['- Detailed description, type of threat or root cause, mitigation measures applied and ongoing, cross-border impact']
    if stage == 'gdpr':
        lines[2] = (f"GDPR Art. 33 (to the supervisory authority; Art. 34 when the people must be told too). Became aware {record['detected']}, "
                    f"due by {deadline} ({hours} h). Incident {record['id']}, opened by {record['opened_by']}. Prepared by eFa-next; check and "
                    'complete it before sending.')
        lines += [f"- Personal data concerned: {record.get('personal_data', 'unknown')}",
                  f"- Categories and approximate number of people and records: {record.get('subjects') or 'to be described'}",
                  '- Name and contact of the data protection officer: to be filled in',
                  '- Likely consequences of the breach: to be described',
                  '- Measures taken or proposed, also to mitigate adverse effects: to be described',
                  '- Reasons for a delay beyond 72 hours, if any: to be described']
    if stage.startswith('dora-'):
        lines[2] = (f"DORA Art. 19 (to the competent authority). Became aware {record['detected']}, due by {deadline} ({hours} h; the initial "
                    'notification within 4 hours of the classification as major). '
                    f"Incident {record['id']}, opened by {record['opened_by']}. Prepared by eFa-next; check and complete it before sending.")
        lines += ['', '## Classification (DORA Art. 18, assessed by the financial entity)', '']
        lines += [f'- {criterion}: to be assessed' for criterion in DORA_CRITERIA]
        if stage in ('dora-intermediate', 'dora-final'):
            lines += ['- Indicators of compromise and the state of recovery: see facts and timeline']
        if stage == 'dora-final':
            lines += ['- Root cause, measures to prevent it again, costs and losses: to be described']
    lines += ['', '## Facts from eFa-next', ''] + [f'- {key}: {value}' for key, value in facts.items()]
    lines += ['', '## Timeline', '', '| Time | Kind | What |', '| --- | --- | --- |']
    lines += [f'| {when} | {kind} | ' + text.replace('|', '/') + ' |' for when, kind, text in timeline] or ['| | | nothing logged |']
    return '\n'.join(lines) + '\n'


def incident_report(args):
    """The early warning, the notification or the final report of an incident, from its record and the logs of this server."""
    record, stage = _incident((args.id or '').strip()), (args.stage or 'early').strip()
    if stage not in INCIDENT_STAGES:
        raise EfaError('Stage: ' + ', '.join(INCIDENT_STAGES) + '.')
    start = datetime.datetime.strptime(record['detected'], '%Y-%m-%d %H:%M') - datetime.timedelta(hours=24)
    end = datetime.datetime.now()
    timeline = incident_timeline(start, end, log_tail(AUDIT_LOG, 20000), log_tail(EVENTS_LOG, 20000))
    facts = {'host': own_hostname(), 'eFa-next': _efa_version(), 'audit entries in the window': sum(1 for item in timeline if item[1] == 'audit'),
             'warnings and errors in the window': sum(1 for item in timeline if item[1] != 'audit')}
    try:
        check = _json_read(SECURITY_FILE, {})
        if check.get('findings'):
            facts['open findings of the security self check'] = sum(1 for item in check['findings'] if item.get('level') == 'problem')
    except (OSError, ValueError):
        pass
    text = incident_text(record, stage, timeline, facts)
    _audit(f'incident {record["id"]} {stage} report made by {_dmarc_who()}')
    if (args.format or '').strip() == 'pdf':
        blocks = [('h', INCIDENT_STAGES[stage][0] + ': ' + record['title'])] + [('p', line.lstrip('#- ')) for line in text.splitlines()[1:] if line.strip()
                                                                              and not line.startswith('|')]
        blocks.append(('table', [('Time', 110), ('Kind', 60), ('What', 325)], [list(item) for item in timeline] or [['', '', 'nothing logged']]))
        data = _lib('efa_pdf').report(f'NIS2 {stage} {record["id"]}', blocks, footer=f'eFa-next {_efa_version()}',
                                      info={'Title': f'NIS2 {stage} {record["id"]}', 'Producer': 'eFa-next', 'Creator': 'eFa-next'})
        return {'pdf': base64.b64encode(data).decode(), 'name': f'nis2-{stage}-{record["id"]}.pdf'}
    return {'markdown': text, 'due': incident_deadlines(record['detected'])[stage]}

# M3: the record of processing (GDPR Art. 30) and the technical and organisational measures (Art. 32) of this server, built
# from its real settings, for all or one tenant. A draft for the operator: it names what eFa-next does, not the purposes of the
# controller. Templates for the rest: docs/datenschutz.
def _safe(call, default):
    try:
        return call()
    except Exception:  # a part that is not set up on this host
        return default


def privacy_facts(tenant_id=None):
    """Everything the evidence names, read from the settings; no secrets."""
    retention_rows = _safe(lambda: retention_status(None), {'retention': [], 'tenants': []})
    targets = _safe(lambda: backup_target_list(None)['targets'], [])
    siem, otlp, wazuh = _json_read(SIEM_FILE, {}), _json_read(OTLP_FILE, {}), _json_read(WAZUH_FILE, {})
    domains = _local_domains()
    if tenant_id is not None:
        domains = sorted(set(domains) & set(_tenant_domains_or_none().get(tenant_id, [])))
    dmarc = _json_read(DMARC_RECORDS, {})
    external_reports = sorted({host for domain in domains for host in ((dmarc.get(domain) or {}).get('current') or {}).get('external', [])})
    flows = [('Backups', f"{item['name']}: {item['provider']} ({item['where'].split('/')[2] if '://' in item['where'] else item['where']})") for item in targets]
    if siem.get('siem'):
        flows.append(('SIEM export', f"{siem.get('target')}:{siem.get('port')} over {siem.get('protocol')}, format {siem.get('format')}"))
    if otlp.get('enabled'):
        flows.append(('OpenTelemetry export', urllib.parse.urlsplit(str(otlp.get('endpoint', ''))).hostname or ''))
    if wazuh.get('manager'):
        flows.append(('Wazuh manager', str(wazuh.get('manager'))))
    flows += [('DMARC reports', f'{host} ({external_service(host)})') for host in external_reports]
    flows.append(('DNS blocklists', 'IP addresses and domains of mail are asked through the own resolver (DNS)'))
    tls = _safe(lambda: tls_profile_status(None).get('profile'), 'unknown')
    return {'domains': domains, 'retention': retention_rows.get('retention', []), 'tenant_retention': retention_rows.get('tenants', []),
            'flows': flows, 'eu_relation': {'yes': 'yes', 'no': 'no'}.get(eu_state()['global'], 'not answered'),
            'measures': [
                ('Transport encryption', f'TLS profile {tls}; TLS 1.2 or newer on all services'),
                ('Held mail at rest', 'encrypted, one key per tenant (D3)' if uq_state().get('encrypt') else 'not encrypted (Held mail, Settings)'),
                ('Pseudonyms in the mail log', f'after {pseudo_days()} days' if pseudo_days() else 'off'),
                ('Backups', 'encrypted (gpg AES-256), signed (C2)' if os.path.exists(BACKUP_PASSWORD) else 'signed (C2), not encrypted: set a backup password'),
                ('Backup targets', 'only providers in European hands (5z)'),
                ('Access control', 'roles and scopes per tenant and domain, reason before mail content when set (5f, 5q)'),
                ('Failed logins', 'lockout by address (B6)' if _lockout_settings()['mode'] == 'on' else 'only the slow-down of the services'),
                ('Audit', 'strict audit with HMAC chain and signed daily anchors (B2)' if strict_settings()['on'] else 'audit log of all changes'),
                ('Updates', 'signed packages of the eFa-next repository; operating system updates by the platform'),
            ]}


def privacy_markdown(facts, who, when):
    lines = [f'# Privacy evidence: {who}', '', f'Built by eFa-next from the settings of {own_hostname()} on {when}. A draft for the record of '
             'processing (GDPR Art. 30) and the technical and organisational measures (Art. 32); complete it with the purposes, the legal '
             'basis and the contact data of the controller (templates in docs/datenschutz).', '',
             '## Record of processing (Art. 30)', '',
             '- Processing: filtering of incoming and outgoing mail for spam, malware and policy, quarantine, mail log, reports.',
             '- Data subjects: senders and recipients of mail, users of the web interface and the portal.',
             '- Kinds of data: mail addresses, IP addresses, host names, subjects (shown only to permitted roles), headers when stored, '
             'mail content only of held mail and quarantine.',
             f"- Domains: {', '.join(facts['domains']) or 'none'}", f"- EU relation: {facts['eu_relation']}", '',
             '### Retention', '', '| Data | Days |', '| --- | --- |']
    lines += [f"| {row['data']} | {row['days']} |" for row in facts['retention']]
    lines += [f"| own days of tenant {row.get('tenant')} | " + ', '.join(f'{key} {value}' for key, value in row.items() if key != 'tenant') + ' |'
              for row in facts['tenant_retention']]
    lines += ['', '### Recipients and data flows', '', '| Flow | Where |', '| --- | --- |'] + [f'| {kind} | {where} |' for kind, where in facts['flows']]
    lines += ['', '## Technical and organisational measures (Art. 32)', '', '| Measure | Now |', '| --- | --- |']
    lines += [f'| {name} | {value} |' for name, value in facts['measures']]
    return '\n'.join(lines) + '\n'


def privacy_evidence(args):
    """M3: a draft of the record of processing and of the TOM, from the real settings, for all or one tenant."""
    tenant = (args.tenant or '').strip()
    tenant_id = _tenant_id(tenant) if tenant else None
    if identity_now and identity_now.get('tenant_ids') is not None and (tenant_id is None or tenant_id not in identity_now['tenant_ids']):
        raise EfaError('Name your tenant.')
    when = time.strftime('%Y-%m-%d %H:%M')
    text = privacy_markdown(privacy_facts(tenant_id), tenant or 'all domains', when)
    _audit(f'privacy evidence for {tenant or "all domains"} made by {_dmarc_who()}')
    if (args.format or '').strip() == 'pdf':
        blocks, table = [('h', 'Privacy evidence: ' + (tenant or 'all domains'))], None
        for line in text.splitlines()[1:]:
            cells = [cell.strip() for cell in line.strip('|').split('|')] if line.startswith('| ') else None
            if cells and table is None:
                table = ('table', [(cells[0], 170), (cells[1], 325)], [])
                blocks.append(table)
            elif cells and not line.startswith('| ---'):
                table[2].append(cells[:2])
            elif not cells:
                table = None
                if line.startswith('#'):
                    blocks.append(('h', line.lstrip('# ')))
                elif line.strip():
                    blocks.append(('p', line.lstrip('- ')))
        data = _lib('efa_pdf').report('Privacy evidence', blocks, footer=f'eFa-next {_efa_version()} - {when}',
                                      info={'Title': 'Privacy evidence', 'Producer': 'eFa-next', 'Creator': 'eFa-next'})
        return {'pdf': base64.b64encode(data).decode(), 'name': f"privacy-evidence-{re.sub(r'[^A-Za-z0-9.-]', '_', tenant or 'all')}-{time.strftime('%Y%m%d')}.pdf"}
    return {'markdown': text}

def _port_listening(port):
    with socket.socket() as probe:
        probe.settimeout(2)
        return probe.connect_ex(('127.0.0.1', port)) == 0


def milter_chain_set(args):
    """Order of the milters by port, for site-specific milters. rspamd (11332) and the health milter must stay in."""
    try:
        ports = [int(item) for item in args.ports.replace(',', ' ').split()]
    except ValueError:
        raise EfaError('Ports must be numbers.')
    if not ports or len(set(ports)) != len(ports) or not all(1 <= port <= 65535 for port in ports):
        raise EfaError('Give each port once, 1 to 65535.')
    for required in REQUIRED_MILTERS:
        if required not in ports:
            raise EfaError(f'Port {required} must stay in the chain.')
    # A wrong port delays every mail until its timeout, so refuse what does not answer.
    closed = [port for port in ports if not _port_listening(port)]
    if closed:
        raise EfaError(f'Nothing listens on port {closed}, nothing changed.')
    chain = ', '.join(f'inet:127.0.0.1:{port}' for port in ports)
    _postconf_set('smtpd_milters', chain)
    if os.path.exists(OUTBOUND_FILE):
        _outbound_strict_apply(_json_read(OUTBOUND_FILE, {}))
    if _av_lua_loaded():
        # Whether efa-cdr may cut a virus of an allowed sender out: only while it is in the chain (MIG-ALLOW).
        _safe(lambda: _own_apply(_own_blocks()), None)
    return {'smtpd_milters': chain}


# Internal DNS: the internal DNS servers once, and the domains they answer for (mail domains or not, such as the hosts of a git or
# update server eFa-next connects to). A domain may name its own servers instead. The settings are the source; the file of
# unbound is written from them.
DNS_INTERNAL = ETC + '/eFa/dns-internal.json'


def _dns_internal():
    """The settings; before the first change they come from the file of unbound (6.0.0.4 and older: each zone with own servers)."""
    if os.path.exists(DNS_INTERNAL):
        return _json_read(DNS_INTERNAL, {'servers': [], 'tls': False, 'zones': {}})
    return {'servers': [], 'tls': False, 'zones': {name: {**item, 'note': ''} for name, item in _dns_zone_state().items()}}


def _dns_effective(settings):
    """Each zone with the servers it really goes to: its own, or the internal servers."""
    return {name: {'servers': item['servers'] or settings['servers'], 'dnssec': item['dnssec'],
                   'tls': item['tls'] if item['servers'] else settings['tls']} for name, item in settings['zones'].items()}


def _dns_apply(settings, what):
    """Writes the file of unbound, checks it and restarts unbound; unbound has to stay up, else everything goes back (fail closed:
    the host resolves through this unbound)."""
    previous = open(DNS_ZONES).read() if os.path.exists(DNS_ZONES) else None
    _write(DNS_ZONES, dns_zones_text(_dns_effective(settings)))
    platform_now = _platform()
    done = subprocess.run(['unbound-checkconf'], capture_output=True, text=True)
    if done.returncode == 0:
        platform_now.service_restart('unbound', check=False)
    if done.returncode != 0 or not _stays_active(platform_now, 'unbound', 3):
        if previous is None:
            os.remove(DNS_ZONES)
        else:
            _write(DNS_ZONES, previous)
        platform_now.service_restart('unbound', check=False)
        raise EfaError('unbound rejected the change, nothing changed: ' + (done.stdout + done.stderr).strip()[-200:])
    _json_write(DNS_INTERNAL, settings, mode=0o644)
    _audit(f'internal DNS: {what} by {_dmarc_who()}')
    return dns_zone_list(None)


def _dns_servers(text, tls):
    servers = [dns_server_spec(item, tls) for item in (text or '').replace(',', ' ').split()]
    if len(servers) > DNS_ZONE_SERVERS:
        raise EfaError(f'At most {DNS_ZONE_SERVERS} servers.')
    return servers


def dns_servers_set(args):
    """The internal DNS servers, for every domain without servers of its own."""
    settings = _dns_internal()
    tls = _on_off(getattr(args, 'tls', '') or 'off')
    servers = _dns_servers(args.servers, tls)
    using = sorted(name for name, item in settings['zones'].items() if not item['servers'])
    if not servers and using:
        raise EfaError(f"These domains use the internal DNS servers: {', '.join(using[:5])}. Remove them first or give them own servers.")
    settings.update(servers=servers, tls=tls)
    return _dns_apply(settings, f"servers {', '.join(servers) or 'none'} tls {'on' if tls else 'off'}")


def dns_zone_set(args):
    """One domain the internal DNS servers answer for (or its own servers). Everything else resolves directly."""
    zone, action = args.zone.strip().lower().rstrip('.'), args.action.strip()
    if not DOMAIN_RE.match(zone):
        raise EfaError('Invalid domain: such as example.internal (never "." for all names).')
    if action not in ('add', 'remove'):
        raise EfaError("Action must be 'add' or 'remove'.")
    settings = _dns_internal()
    if action == 'remove':
        if settings['zones'].pop(zone, None) is None:
            raise EfaError('Not an internal domain of this host.')
        return _dns_apply(settings, f'domain {zone} removed')
    tls = _on_off(getattr(args, 'tls', '') or 'off')
    servers = _dns_servers(args.servers, tls)
    if not servers and not settings['servers']:
        raise EfaError('Set the internal DNS servers first (dns-servers-set), or give this domain its own servers.')
    if zone not in settings['zones'] and len(settings['zones']) >= DNS_ZONE_MAX:
        raise EfaError(f'At most {DNS_ZONE_MAX} internal domains.')
    note = ' '.join((getattr(args, 'note', '') or '').split())[:100]
    # DNSSEC stays on unless the admin turns it off for this domain: an internal domain below a signed public domain is unsigned
    # and fails the validation, but turning it off also trusts forged answers for it.
    settings['zones'][zone] = {'servers': servers, 'dnssec': _on_off(getattr(args, 'dnssec', '') or 'on'), 'tls': tls and bool(servers), 'note': note}
    return _dns_apply(settings, f"domain {zone} servers {', '.join(servers) or 'internal'} dnssec {getattr(args, 'dnssec', '') or 'on'}")


DNS_ZONE_MAX, DNS_ZONE_SERVERS = 64, 8
DNS_SERVER_RE = re.compile(r'^([0-9A-Fa-f:.]+)(?:@([0-9]{1,5}))?(?:#([a-z0-9.-]+))?$')


def dns_server_spec(item, tls):
    """One server as unbound writes it: IP, @port, and with DNS over TLS #name for the check of its certificate."""
    found = DNS_SERVER_RE.match(item.strip().lower())
    try:
        address = str(ipaddress.ip_address(found.group(1))) if found else None
    except ValueError:
        address = None
    if address is None or (found.group(2) and not 1 <= int(found.group(2)) <= 65535):
        raise EfaError(f'Server {item[:60]!r}: an IP address, optionally @port, such as 192.0.2.53 or 192.0.2.53@5353.')
    if tls and not (found.group(3) and DOMAIN_RE.match(found.group(3))):
        raise EfaError(f'Server {item[:60]!r}: DNS over TLS needs the name in its certificate, such as 192.0.2.53@853#dns.example.internal.')
    if not tls and found.group(3):
        raise EfaError(f'Server {item[:60]!r}: a #name only with DNS over TLS.')
    return address + (f'@{found.group(2)}' if found.group(2) else '') + (f'#{found.group(3)}' if tls else '')


def dns_zones_text(state):
    lines = []
    if any(item['tls'] for item in state.values()):
        lines += ['server:', f'  tls-cert-bundle: "{SIEM_CA_DEFAULT}"']  # the CA bundle of the system
    for name, item in sorted(state.items()):
        if not item['dnssec']:
            lines += ['server:', f'  domain-insecure: "{name}"']
        lines += ['forward-zone:', f'  name: "{name}"'] + (['  forward-tls-upstream: yes'] if item['tls'] else [])
        lines += [f'  forward-addr: {server}' for server in item['servers']]
    return '\n'.join(lines) + '\n'


def _dns_zone_state():
    """The zones of the file. Zones of 6.0.0.4 and older were always written with domain-insecure: they keep it."""
    state, insecure, name = {}, set(), None
    for line in _read_lines(DNS_ZONES):
        if line.startswith('domain-insecure:'):
            insecure.add(line.split('"')[1])
        elif line.startswith('name:'):
            name = line.split('"')[1]
            state[name] = {'servers': [], 'dnssec': True, 'tls': False}
        elif line.startswith('forward-tls-upstream:') and name:
            state[name]['tls'] = line.split()[1] == 'yes'
        elif line.startswith('forward-addr:') and name:
            state[name]['servers'].append(line.split()[1])
    for name in state:
        state[name]['dnssec'] = name not in insecure
    return state


def _dns_zones():
    return {name: item['servers'] for name, item in _dns_effective(_dns_internal()).items()}


def dns_zone_list(_args):
    settings = _dns_internal()
    effective = _dns_effective(settings)
    return {'servers': settings['servers'], 'tls': settings['tls'], 'max': DNS_ZONE_MAX,
            'zones': {name: {**effective[name], 'own_servers': bool(item['servers']), 'note': item.get('note', '')}
                      for name, item in settings['zones'].items()}}


def dns_zone_test(args):
    """The SOA of an internal domain through the unbound of this host: does the forwarding work?"""
    zone = (args.zone or '').strip().lower().rstrip('.')
    if zone not in _dns_internal()['zones']:
        raise EfaError('Not an internal domain of this host.')
    done = subprocess.run(['dig', '+time=3', '+tries=1', '@127.0.0.1', zone, 'SOA'], capture_output=True, text=True, timeout=15)
    status = re.search(r'status: ([A-Z]+)', done.stdout)
    answer = [line for line in done.stdout.splitlines() if line and not line.startswith(';') and '\tSOA\t' in line]
    return {'zone': zone, 'status': status.group(1) if status else 'no answer', 'ok': bool(answer) and status and status.group(1) == 'NOERROR',
            'soa': answer[:1]}


# Own host names (Hans 2026-11-19): names and their addresses as /etc/hosts has them, for all of eFa-next. unbound answers them,
# because Postfix (smtp_host_lookup dns) and rspamd ask unbound and never read /etc/hosts; a block of /etc/hosts carries the same
# names for the programs that read only that file. HOSTS_SHARED: the settings of the cluster, the master hands them to every
# node (journal and snapshot). HOSTS_LOCAL (local.d, never handed on): this host only, a name there wins over the shared one.
HOSTS_SHARED = ETC + '/eFa/hosts.json'
HOSTS_LOCAL = ETC + '/eFa/local.d/hosts.json'
HOSTS_CONF = ETC + '/unbound/conf.d/efa-hosts.conf'
HOSTS_BLOCK = 'eFa-next host names'
HOSTS_MAX, HOSTS_ADDRESSES, HOSTS_TTL = 256, 4, 300
HOSTS_NAME_RE = re.compile(r'^(?=.{1,253}$)([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)*[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$')
# Names whose answers keep eFa-next safe and up to date: its updates and those of the system, the certificates, the signatures,
# the blocklists (also every zone of the list of blocklists), the reverse zones and localhost. A name below one of them is refused.
HOSTS_PROTECTED = ('localhost', 'localdomain', 'arpa', 'efa-next.eu', 'letsencrypt.org', 'almalinux.org', 'rockylinux.org', 'redhat.com',
                   'fedoraproject.org', 'rspamd.com', 'clamav.net', 'sanesecurity.net', 'securiteinfo.com', 'spamhaus.org', 'spamhaus.net',
                   'spamcop.net', 'surbl.org', 'uribl.com', 'dnswl.org', 'mailspike.net', 'barracudacentral.org', 'uceprotect.net',
                   'surriel.com', 'blocklist.de', 'spameatingmonkey.net', 'virusfree.cz', 'msbl.org')


def _hosts_protected():
    zones = set(HOSTS_PROTECTED)
    for preset in RBL_PRESETS:
        zones.add(preset.get('zone') or '')
        zones.update(zone for zone in (preset.get('rules') or {}).values() if zone)
    for item in _json_read(RBL_FILE, {}).get('custom', []) if os.path.exists(RBL_FILE) else []:
        zones.add(str(item.get('zone', '') if isinstance(item, dict) else '').lower())
    return {zone for zone in zones if zone}


def hosts_name(value, protected=None, own=''):
    """A host name as /etc/hosts takes it, in lower case: a short name (backup) or a full one (git.corp.example)."""
    name = (value or '').strip().lower().rstrip('.')
    if not HOSTS_NAME_RE.match(name) or name.replace('.', '').isdigit():
        raise EfaError('Host name: letters, digits and hyphens, such as backup or git.corp.example.')
    for zone in sorted(_hosts_protected() if protected is None else protected):
        if name == zone or name.endswith('.' + zone):
            raise EfaError(f'{name}: eFa-next needs the real answer for {zone} (updates, certificates, blocklists), it cannot be changed here.')
    if own and name in (own, own.split('.')[0]):
        raise EfaError(f'{name} is the name of this host: change it with hostname-set.')
    return name


def hosts_addresses(text):
    """The addresses of one name, at most HOSTS_ADDRESSES, IPv4 and IPv6: never loopback, link-local, multicast or unspecified."""
    found = []
    for item in (text or '').replace(',', ' ').split():
        try:
            address = ipaddress.ip_address(item)
        except ValueError:
            raise EfaError(f'Address {item[:60]!r}: an IPv4 or IPv6 address, such as 192.0.2.10 or 2001:db8::10.')
        if address.is_loopback or address.is_link_local or address.is_multicast or address.is_unspecified or address.is_reserved:
            raise EfaError(f'Address {address}: loopback, link-local, multicast and reserved addresses are not allowed.')
        if str(address) not in found:
            found.append(str(address))
    if not found:
        raise EfaError('At least one address.')
    if len(found) > HOSTS_ADDRESSES:
        raise EfaError(f'At most {HOSTS_ADDRESSES} addresses per name.')
    return found


def _hosts_entries(path):
    data = _json_read(path, {})
    entries = data.get('entries', {}) if isinstance(data, dict) else {}
    return entries if isinstance(entries, dict) else {}


def hosts_effective(shared, local):
    """Each name with its addresses: the entry of this host wins over the one of the cluster."""
    out = {name: {**item, 'scope': 'cluster'} for name, item in shared.items()}
    out.update({name: {**item, 'scope': 'host'} for name, item in local.items()})
    return dict(sorted(out.items()))


def hosts_unbound_text(entries):
    """The file of unbound: each name its own zone of type typetransparent, so only A and AAAA come from here and every other
    type (MX, TXT) of the name and every name below it is resolved as before. A PTR only for private addresses, from the first
    name that has it: a public address keeps its real reverse name, which checks of mail rely on."""
    lines, reverse = ['# eFa-next: own host names (efactl hosts-set). Written by eFa-next, changes here are overwritten.', 'server:'], set()
    for name, item in sorted(entries.items()):
        lines.append(f'  local-zone: "{name}." typetransparent')
        for address in item['addresses']:
            kind = 'AAAA' if ':' in address else 'A'
            lines.append(f'  local-data: "{name}. {HOSTS_TTL} IN {kind} {address}"')
            if ipaddress.ip_address(address).is_private and address not in reverse:
                reverse.add(address)
                lines.append(f'  local-data-ptr: "{address} {HOSTS_TTL} {name}."')
    return '\n'.join(lines) + '\n'


def hosts_file_text(text, entries):
    """/etc/hosts with the block of the own names at its end (lines of the admin before it win in programs that read the file);
    without names no block."""
    begin, end = f'# BEGIN {HOSTS_BLOCK} managed block', f'# END {HOSTS_BLOCK} managed block'
    out, inside = [], False
    for line in text.splitlines():
        if line.strip() == begin:
            inside = True
        elif line.strip() == end:
            inside = False
        elif not inside:
            out.append(line)
    while out and not out[-1].strip():
        out.pop()
    lines = [f'{address} {name}' for name, item in sorted(entries.items()) for address in item['addresses']]
    if lines:
        out += [begin] + lines + [end]
    return '\n'.join(out) + '\n'


def _hosts_by_hand(text):
    """Names of /etc/hosts outside the managed blocks: such a line wins over the own name for programs that read the file."""
    names, inside = set(), False
    for line in text.splitlines():
        if line.strip().startswith('# BEGIN ') and line.strip().endswith(' managed block'):
            inside = True
        elif line.strip().startswith('# END ') and line.strip().endswith(' managed block'):
            inside = False
        elif not inside:
            names.update(part.lower() for part in line.split('#')[0].split()[1:])
    return names


def _hosts_write(entries):
    """unbound first: its file checked and unbound running again, else the file of before goes back (fail closed: the host
    resolves through this unbound). Then the block of /etc/hosts. An unchanged file of unbound restarts nothing."""
    text = hosts_unbound_text(entries) if entries else ''
    try:
        with open(HOSTS_CONF) as f:
            previous = f.read()
    except FileNotFoundError:
        previous = ''
    if text != previous:
        if text:
            _write(HOSTS_CONF, text)
        elif os.path.exists(HOSTS_CONF):
            os.remove(HOSTS_CONF)
        platform_now = _platform()
        done = subprocess.run(['unbound-checkconf'], capture_output=True, text=True)
        if done.returncode == 0:
            platform_now.service_restart('unbound', check=False)
        if done.returncode != 0 or not _stays_active(platform_now, 'unbound', 3):
            if previous:
                _write(HOSTS_CONF, previous)
            elif os.path.exists(HOSTS_CONF):
                os.remove(HOSTS_CONF)
            platform_now.service_restart('unbound', check=False)
            raise EfaError('unbound rejected the change, nothing changed: ' + (done.stdout + done.stderr).strip()[-200:])
    if os.path.exists(HOSTS):
        with open(HOSTS) as f:
            current = f.read()
        fixed = hosts_file_text(current, entries)
        if fixed != current:
            _write(HOSTS, fixed)


def _hosts_change(path, args, where):
    """One name added or removed in the file of path; the files of unbound and /etc/hosts follow."""
    action = (args.action or '').strip()
    if action not in ('add', 'remove'):
        raise EfaError("Action must be 'add' or 'remove'.")
    shared, local = _hosts_entries(HOSTS_SHARED), _hosts_entries(HOSTS_LOCAL)
    entries = dict(shared if path == HOSTS_SHARED else local)
    if action == 'remove':
        name = (args.name or '').strip().lower().rstrip('.')
        if entries.pop(name, None) is None:
            raise EfaError(f'{name[:80]} is not an own host name {where}.')
        what = f'{name} removed'
    else:
        name = hosts_name(args.name, own=own_hostname().strip().lower())
        addresses = hosts_addresses(args.addresses)
        if name not in entries and len(hosts_effective(shared, local)) >= HOSTS_MAX:
            raise EfaError(f'At most {HOSTS_MAX} own host names.')
        note = ' '.join((getattr(args, 'note', '') or '').split())[:100]
        entries[name] = {'addresses': addresses, 'note': note}
        what = f'{name} = {" ".join(addresses)}'
    if path == HOSTS_SHARED:
        shared = entries
    else:
        local = entries
    _hosts_write(hosts_effective(shared, local))
    _json_write(path, {'entries': entries}, mode=0o640)
    _audit(f'own host names {where}: {what} by {_dmarc_who()}')
    return hosts_list(None)


def hosts_set(args):
    """An own host name for every host: on the master of a cluster for all its nodes, on a single host for that host."""
    return _hosts_change(HOSTS_SHARED, args, 'of the cluster' if cluster_role() != 'none' else 'of this host')


def hosts_local_set(args):
    """An own host name of this host alone, never handed on in a cluster; it wins over the same name of the cluster."""
    return _hosts_change(HOSTS_LOCAL, args, 'of this host only')


def hosts_apply(_args):
    """The update, a restore, the join of a cluster: unbound and /etc/hosts as the settings say."""
    _hosts_write(hosts_effective(_hosts_entries(HOSTS_SHARED), _hosts_entries(HOSTS_LOCAL)))
    return hosts_list(None)


def hosts_list(_args):
    entries = hosts_effective(_hosts_entries(HOSTS_SHARED), _hosts_entries(HOSTS_LOCAL))
    try:
        with open(HOSTS) as f:
            by_hand = _hosts_by_hand(f.read())
    except OSError:
        by_hand = set()
    return {'entries': entries, 'max': HOSTS_MAX, 'cluster': cluster_role() != 'none',
            'also_by_hand': sorted(name for name in entries if name in by_hand)}


def hosts_show(path):
    """One line per name for the tables of the web interface (with its Remove button)."""
    return {name: ', '.join(item.get('addresses', [])) + (f" ({item['note']})" if item.get('note') else '')
            for name, item in sorted(_hosts_entries(path).items())}


# MIG-DNS: eFa 5 left a forward-zone "." (all names to 8.8.8.8 or a router) in conf.d of unbound. Then the free blocklists
# refuse to answer and every mail domain goes to that resolver. eFa-next resolves itself, the forwarders stay for internal
# zones only. The root servers must answer first (UDP and TCP), else the forwarder stays: DNS must not break.
ROOT_SERVERS = ('198.41.0.4', '193.0.14.129', '199.7.83.42')  # a., k. and l.root-servers.net
DNS_FORWARD_BACKUP = '/var/lib/eFa/dns-forwarders'
# The forwarders of the setup (RECURSION NO): unbound.conf includes the file, so it stays, with full recursion in it.
SETUP_FORWARD = ETC + '/unbound/efa-forward.conf'
SETUP_FORWARD_EMPTY = '# eFa-next: full recursion, no forwarders.\n'
RESOLV_CONF = ETC + '/resolv.conf'
# The test entries of the lists: listed by design (RFC 5782).
RBL_TEST_NAMES = (('zen.spamhaus.org', '2.0.0.127.zen.spamhaus.org'), ('bl.spamcop.net', '2.0.0.127.bl.spamcop.net'))


def unbound_forward_zones(text):
    """[{'name', 'addrs', 'insecure'}] of the forward-zones of an unbound file, and whether the file has anything else."""
    zones, other, insecure = [], False, set(re.findall(r'^\s*domain-insecure:\s*"?([^"\s]+)"?', text, re.M))
    current = None
    for line in text.splitlines():
        stripped = line.split('#', 1)[0].strip()
        if not stripped:
            continue
        if stripped == 'forward-zone:':
            current = {'name': None, 'addrs': []}
            zones.append(current)
        elif stripped == 'server:':
            current = None
        elif current is not None and stripped.startswith('name:'):
            current['name'] = stripped.split(':', 1)[1].strip().strip('"').rstrip('.') or '.'
        elif current is not None and stripped.startswith(('forward-addr:', 'forward-host:')):
            current['addrs'].append(stripped.split(':', 1)[1].strip())
        elif current is None and stripped.startswith('domain-insecure:'):
            continue
        elif current is None or not stripped.startswith('forward-'):
            other = True
    for zone in zones:
        zone['insecure'] = zone['name'] in insecure
    return zones, other


def public_resolver(addrs):
    """True if one of the servers is a public resolver: any address that is not private (RFC 1918, ULA, loopback)."""
    for item in addrs:
        try:
            if ipaddress.ip_address(item.split('@')[0].split('#')[0]).is_global:
                return True
        except ValueError:
            return True  # a host name: not a known internal server
    return False


def root_reachable(answers):
    """answers: {(server, 'udp'|'tcp'): output of dig}. Both ways must reach one root server with the NS of the root."""
    found = {proto for (_server, proto), out in answers.items() if 'status: NOERROR' in out and re.search(r'\.\s+\d+\s+IN\s+NS\s', out)}
    return found >= {'udp', 'tcp'}


def _root_answers():
    found = {}
    for server in ROOT_SERVERS:
        for proto in ('udp', 'tcp'):
            done = subprocess.run(['dig', '+norecurse', '+time=3', '+tries=1', *(['+tcp'] if proto == 'tcp' else []), f'@{server}', '.', 'NS'],
                                  capture_output=True, text=True, timeout=15)
            found[(server, proto)] = done.stdout
        if root_reachable(found):
            break
    return found


def _root_forward_files():
    """The files of conf.d with a forward-zone "." (not the one eFa-next writes), and the forwarders of the setup:
    {path: (zones, other)}."""
    found = {}
    for path in sorted(glob.glob(ETC + '/unbound/conf.d/*.conf')) + ([SETUP_FORWARD] if os.path.exists(SETUP_FORWARD) else []):
        if path == DNS_ZONES:
            continue
        with open(path, errors='replace') as f:
            zones, other = unbound_forward_zones(f.read())
        if any(zone['name'] == '.' and zone['addrs'] for zone in zones):
            found[path] = (zones, other)
    return found


def _dig_short(name, kind):
    done = subprocess.run(['dig', '+short', '+time=3', '+tries=2', '@127.0.0.1', name, kind], capture_output=True, text=True, timeout=20)
    return [line for line in done.stdout.splitlines() if line.strip()]


def resolv_local(text):
    """True if the system asks only its own unbound (nameserver 127.0.0.1 or ::1)."""
    servers = [line.split()[1] for line in text.splitlines() if line.split()[:1] == ['nameserver'] and len(line.split()) > 1]
    return bool(servers) and all(server in ('127.0.0.1', '::1') for server in servers)


def _dig_listed(name, kind, good, tries=4):
    """True once an answer is good; right after unbound starts its cache is empty and the first answers can take longer."""
    for attempt in range(tries):
        if any(good(line) for line in _dig_short(name, kind)):
            return True
        time.sleep(2 * (attempt + 1))
    return False


def dns_forward_status(_args):
    """Whether unbound sends all names to forwarders (a forward-zone "." in conf.d or of the setup), to which, and whether the
    system itself asks its own unbound."""
    files = _root_forward_files()
    try:
        with open(RESOLV_CONF) as f:
            local = resolv_local(f.read())
    except OSError:
        local = False
    return {'forward_all': bool(files), 'files': {path: [zone for zone in zones if zone['name'] == '.'] for path, (zones, _o) in files.items()},
            'public': any(public_resolver(zone['addrs']) for zones, _o in files.values() for zone in zones if zone['name'] == '.'),
            'system_uses_unbound': local}


def dns_forward_fix(args):
    """unbound resolves itself again: the forward-zone "." goes (the file to a backup folder), its zones for internal names stay
    (internal DNS, dns-zone-list). Only when the root servers answer over UDP and TCP; else nothing changes."""
    files = _root_forward_files()
    if not files:
        try:
            with open(RESOLV_CONF) as f:
                local = resolv_local(f.read())
        except OSError:
            local = False
        if not local:
            # The system asks DHCP's resolvers: from now on its own unbound (NetworkManager dns=none, resolv.conf 127.0.0.1).
            _platform().use_local_resolver()
            _audit(f'DNS: the system asks its own unbound now (resolv.conf 127.0.0.1) by {_dmarc_who()}')
            return {'forward_all': False, 'system_uses_unbound': True}
        return {'forward_all': False, 'note': 'unbound resolves itself already.'}
    mixed = [path for path, (_zones, other) in files.items() if other]
    if mixed:
        raise EfaError(f'{", ".join(mixed)} holds more than forward-zones: change it by hand (only the forward-zone "." goes). Nothing changed.')
    if not root_reachable(_root_answers()):
        raise EfaError('The root servers do not answer over UDP and TCP port 53 (firewall upstream?): the forwarder stays, nothing changed. '
                       'Allow outgoing DNS to the internet, then try again.')
    settings = _dns_internal()
    carried = []
    for zones, _other in files.values():
        for zone in zones:
            if zone['name'] != '.' and zone['addrs'] and zone['name'] not in settings['zones'] and DOMAIN_RE.match(zone['name']):
                settings['zones'][zone['name']] = {'servers': [dns_server_spec(item, False) for item in zone['addrs']
                                                               if DNS_SERVER_RE.match(item)][:DNS_ZONE_SERVERS],
                                                   'dnssec': not zone['insecure'], 'tls': False, 'note': 'from the eFa 5 forwarders'}
                carried.append(zone['name'])
    backup = (getattr(args, 'backup', '') or '').strip() or f"{DNS_FORWARD_BACKUP}-{time.strftime('%Y%m%d-%H%M%S')}"
    os.makedirs(backup, mode=0o700, exist_ok=True)
    moved = []
    for path in files:
        target = os.path.join(backup, os.path.basename(path))
        shutil.move(path, target)
        moved.append((path, target))
        if path == SETUP_FORWARD:
            _write(SETUP_FORWARD, SETUP_FORWARD_EMPTY)  # unbound.conf includes it
    if SETUP_FORWARD in files:
        # The setup must not write the forwarders again (Re-Setup, efa-apply --dns).
        _write(EFA_CONFIG, ''.join(line + '\n' for line in _read_lines(EFA_CONFIG) if not line.startswith('RECURSION:')) + 'RECURSION:YES\n')
    try:
        _dns_apply(settings, 'forward-zone "." removed, unbound resolves itself' + (f'; internal zones kept: {", ".join(carried)}' if carried else ''))
    except EfaError:
        for path, target in moved:
            shutil.move(target, path)
        _platform().service_restart('unbound', check=False)
        raise
    check = {'mx': bool(_dig_listed('gmail.com', 'MX', lambda line: True)), 'internal': {name: bool(_dig_short(name, 'SOA')) for name in carried},
             'lists': {name: _dig_listed(query, 'A', lambda line: line.startswith('127.0.0.')) for name, query in RBL_TEST_NAMES},
             'forward_warning': bool(_rbl_warnings())}
    if not check['mx']:
        # Names do not resolve without the forwarder: back as it was, DNS must not break.
        for path, target in moved:
            shutil.move(target, path)
        if SETUP_FORWARD in files:
            _write(EFA_CONFIG, ''.join(line + '\n' for line in _read_lines(EFA_CONFIG) if not line.startswith('RECURSION:')) + 'RECURSION:NO\n')
        _platform().service_restart('unbound', check=False)
        _audit('internal DNS: forward-zone "." put back, names did not resolve without it')
        raise EfaError('Without the forwarder no name resolved: it is back as it was. Check outgoing DNS (UDP and TCP 53).')
    _platform().use_local_resolver()
    _audit(f'internal DNS: forward-zone "." of {", ".join(path for path, _t in moved)} moved to {backup} by {_dmarc_who()}')
    return {'forward_all': False, 'moved_to': backup, 'internal_zones_kept': carried, 'check': check}


def dns_forward_notices():
    state = dns_forward_status(None)
    if not state['forward_all']:
        return [] if state['system_uses_unbound'] else [
            _text('The system does not ask its own unbound (resolv.conf names other servers, such as those of DHCP): fix it with one '
                  'click: DNS and certificate, Internal DNS: resolve on this host (dns-forward-fix).')]
    return [_text('unbound sends all names to {servers}: the free blocklists do not answer then and every mail domain goes to that '
                  'resolver. Fix it with one click: DNS and certificate, Internal DNS: resolve on this host (dns-forward-fix).',
                  servers=', '.join(addr for zones in state['files'].values() for zone in zones for addr in zone['addrs']))] if state['public'] else \
           [_text('unbound sends all names to internal servers instead of resolving itself; if the blocklists do not filter: DNS and '
                  'certificate, Internal DNS: resolve on this host (dns-forward-fix).')]
# DNS-SHARE: the unbound of this host answers other networks too (a second MX, internal servers): each net once in unbound
# (access-control allow) and in the firewall (port 53 from that source only, runtime and permanent). Everything else stays
# refused: no open resolver. Rate limits on. A second resolver for this host itself (the cluster partner) is optional.
DNS_SHARE_FILE = ETC + '/eFa/dns-share.json'
DNS_SHARE_CONF = ETC + '/unbound/conf.d/efa-dns-share.conf'
DNS_SHARE_MAX = 64
DNS_SHARE_SHORTEST = {4: 8, 6: 32}


def dns_share_net(text):
    """The network of an entry (ip_network) or EfaError: never 0.0.0.0/0 or ::/0, nothing shorter than /8 (IPv4) or /32 (IPv6)."""
    try:
        net = ipaddress.ip_network(text.strip(), strict=False)
    except ValueError:
        raise EfaError(f'{text[:60]!r}: an IP address or network such as 192.0.2.10 or 10.0.0.0/16.')
    if net.prefixlen < DNS_SHARE_SHORTEST[net.version]:
        raise EfaError(f'{net}: at most /{DNS_SHARE_SHORTEST[net.version]} for IPv{net.version}: this server must never answer everyone.')
    if net.is_loopback or net.is_multicast or net.is_unspecified:
        raise EfaError(f'{net}: not a network of clients.')
    return net


def dns_share_conf(nets, addresses):
    """The unbound file: the addresses of this host to listen on, each net allowed, rate limits."""
    if not nets:
        return ''
    lines = ['# Written by efactl dns-share-add. Do not edit.', 'server:']
    lines += [f'  interface: {address}' for address in sorted(addresses)]
    lines += [f'  access-control: {net} allow' for net in nets]
    lines += ['  ratelimit: 1000', '  ip-ratelimit: 100']
    return '\n'.join(lines) + '\n'


def dns_share_rules(net):
    """The firewalld rich rules of one net: port 53 over UDP and TCP from that source only."""
    family = 'ipv6' if ':' in net else 'ipv4'
    return [f'rule family="{family}" source address="{net}" port port="53" protocol="{proto}" accept' for proto in ('udp', 'tcp')]


def _dns_share_state():
    state = {'entries': [], 'secondary': '', **_json_read(DNS_SHARE_FILE, {})}
    for entry in state['entries']:
        entry.setdefault('nodes', [DNS_SHARE_ALL])  # an entry of before 6.0.0.6.7 counts for every node
    return state


# Hans 2026-11-20: in a cluster each entry is for all nodes or for the nodes chosen. The list goes to every node through the
# journal of the master; each node answers only the nets of its own entries (unbound and firewall).
DNS_SHARE_ALL = 'all'


def _dns_share_cluster():
    """(own name, node names known here, the cluster address of each other node); ('', set(), {}) outside a cluster. The
    master knows its nodes, a client its master and the names in the manifest of the master."""
    if cluster_role() == 'none':
        return '', set(), {}
    state = _lib('efa_cluster').read_state(ETC)
    hosts = {name: node.get('host', '') for name, node in state.get('nodes', {}).items()}
    master = state.get('master') or {}
    if master.get('name'):
        hosts[master['name']] = master.get('host', '')
    own = state.get('name') or ''
    names = ({own} | set(hosts) | set(_json_read(SYNC_RECEIVED, {}).get('nodes') or [])) - {''}
    return own, names, hosts


def dns_share_nodes(text, role, known):
    """The nodes of an entry: ['all'] or the sorted names. Outside a cluster only all; a client takes the names of its master
    as they come (it may not know a node that just joined), the master only names of its cluster."""
    parts = sorted(set((text or '').replace(',', ' ').split()))
    if not parts or parts == [DNS_SHARE_ALL]:
        return [DNS_SHARE_ALL]
    if role == 'none':
        raise EfaError('Outside a cluster an entry is for this host: leave the nodes empty (all). Nothing changed.')
    if DNS_SHARE_ALL in parts:
        raise EfaError('Either all nodes or the names of nodes, not both. Nothing changed.')
    bad = [part[:40] for part in parts if not _lib('efa_cluster').valid_name(part)]
    if bad:
        raise EfaError(f'Not a node name: {", ".join(bad)}. Nothing changed.')
    unknown = [part for part in parts if part not in known]
    if role != 'client' and unknown:
        raise EfaError(f'Not a node of this cluster: {", ".join(unknown)}. Nothing changed.')
    return parts


def dns_share_mine(entry, own):
    """Whether this node answers the net of the entry."""
    nodes = entry.get('nodes') or [DNS_SHARE_ALL]
    return nodes == [DNS_SHARE_ALL] or own in nodes


def _dns_share_addresses(nets):
    """The global addresses of this host in the families of the nets: unbound listens there (and on 127.0.0.1 as before)."""
    families = {':' in net for net in nets}
    return {address for address in _own_addresses()
            if (':' in address) in families and not ipaddress.ip_address(address).is_loopback and not ipaddress.ip_address(address).is_link_local}


def _dns_share_apply(state, before):
    """unbound first (checked, back if it does not start), then the firewall rules: those of removed nets and of entries for
    other nodes go, those of this node come."""
    own = _dns_share_cluster()[0]
    nets = [entry['net'] for entry in state['entries'] if dns_share_mine(entry, own)]
    previous = open(DNS_SHARE_CONF).read() if os.path.exists(DNS_SHARE_CONF) else None
    text = dns_share_conf(nets, _dns_share_addresses(nets))
    if text:
        _write(DNS_SHARE_CONF, text)
    elif os.path.exists(DNS_SHARE_CONF):
        os.remove(DNS_SHARE_CONF)
    platform_now = _platform()
    done = subprocess.run(['unbound-checkconf'], capture_output=True, text=True)
    if done.returncode == 0:
        platform_now.service_restart('unbound', check=False)
    if done.returncode != 0 or not _stays_active(platform_now, 'unbound', 3):
        if previous is None:
            if os.path.exists(DNS_SHARE_CONF):
                os.remove(DNS_SHARE_CONF)
        else:
            _write(DNS_SHARE_CONF, previous)
        platform_now.service_restart('unbound', check=False)
        raise EfaError('unbound rejected the change, nothing changed: ' + (done.stdout + done.stderr).strip()[-200:])
    for net in sorted((set(before) | {entry['net'] for entry in state['entries']}) - set(nets)):
        for rule in dns_share_rules(net):
            platform_now.firewall_rich_rule(rule, False)
    for net in nets:
        for rule in dns_share_rules(net):
            platform_now.firewall_rich_rule(rule, True)
    _json_write(DNS_SHARE_FILE, state, mode=0o644)


def dns_share_list(_args):
    """The networks this server answers DNS for, besides itself, and the second resolver of this host. In a cluster each entry
    names its nodes (a node the cluster does not know is marked unknown) and the addresses are per node."""
    state = _dns_share_state()
    own, names, hosts = _dns_share_cluster()
    if not own:
        entries = [{key: value for key, value in entry.items() if key != 'nodes'} for entry in state['entries']]
        return {'entries': entries, 'secondary': state['secondary'], 'max': DNS_SHARE_MAX,
                'listens_on': sorted(_dns_share_addresses([entry['net'] for entry in state['entries']])) if state['entries'] else []}
    shown = lambda name: name if name in names else f'{name} ({_text("unknown")})'  # noqa: E731
    entries = [{**entry, 'nodes': _text('all nodes') if entry['nodes'] == [DNS_SHARE_ALL] else ', '.join(shown(name) for name in entry['nodes'])}
               for entry in state['entries']]
    listens = []
    for name in sorted(names):
        nets = [entry['net'] for entry in state['entries'] if dns_share_mine(entry, name)]
        if not nets:
            continue
        # shortcut: another node shows the address the cluster reaches it on; it answers on all its own addresses of that
        # family. Its exact list needs a field in /v1/status, later.
        addresses = sorted(_dns_share_addresses(nets)) if name == own else [hosts.get(name) or '?']
        listens += [f'{name}: {address}' for address in addresses]
    return {'entries': entries, 'secondary': state['secondary'], 'max': DNS_SHARE_MAX, 'listens_on': listens,
            'cluster_nodes': sorted(names)}


def dns_share_add(args):
    """Networks (IP or CIDR, IPv4 and IPv6) that may ask this server. A net outside the private ranges only after typing yes."""
    state = _dns_share_state()
    before = [entry['net'] for entry in state['entries']]
    nets = [dns_share_net(item) for item in (args.nets or '').replace(',', ' ').split()]
    if not nets:
        raise EfaError('Give at least one address or network.')
    public = [str(net) for net in nets if not net.is_private]
    if public and (args.confirm_public or '').strip() != 'yes':
        raise EfaError(f'{", ".join(public)} lies outside the private ranges: type yes to let it ask this server. Nothing changed.')
    note = ' '.join((args.note or '').split())[:100]
    role, (_own, known, _hosts) = cluster_role(), _dns_share_cluster()
    nodes = dns_share_nodes(getattr(args, 'nodes', ''), role, known)
    added = [str(net) for net in nets if str(net) not in before]
    if len(before) + len(added) > DNS_SHARE_MAX:
        raise EfaError(f'At most {DNS_SHARE_MAX} networks.')
    state['entries'] += [{'net': net, 'note': note, 'added': time.strftime('%Y-%m-%d %H:%M'), 'by': _dmarc_who(), 'nodes': nodes}
                         for net in added]
    _dns_share_apply(state, before)
    _audit(f'DNS for other networks: {", ".join(added) or "nothing new"} added by {_dmarc_who()}'
           + (f' for the nodes {", ".join(nodes)}' if role != 'none' and nodes != [DNS_SHARE_ALL] else '')
           + (f' (outside the private ranges, confirmed: {", ".join(public)})' if public else ''))
    return dns_share_list(None)


def dns_share_edit(args):
    """The nodes (and the note) of one entry; the net stays. On a client the entry of the master comes in even when this node
    did not have it (a list kept on the node itself before 6.0.0.6.7)."""
    state = _dns_share_state()
    before = [entry['net'] for entry in state['entries']]
    net = str(dns_share_net(args.net or ''))
    role, (_own, known, _hosts) = cluster_role(), _dns_share_cluster()
    nodes = dns_share_nodes(args.nodes, role, known)
    entry = next((item for item in state['entries'] if item['net'] == net), None)
    if entry is None:
        if role != 'client':
            raise EfaError(f'{net} is not in the list, nothing changed: add it first.')
        if len(before) >= DNS_SHARE_MAX:
            raise EfaError(f'At most {DNS_SHARE_MAX} networks.')
        entry = {'net': net, 'note': '', 'added': time.strftime('%Y-%m-%d %H:%M'), 'by': _dmarc_who()}
        state['entries'].append(entry)
    old = entry.get('nodes') or [DNS_SHARE_ALL]
    entry['nodes'] = nodes
    if (args.note or '').strip():
        entry['note'] = ' '.join(args.note.split())[:100]
    _dns_share_apply(state, before)
    _audit(f'DNS for other networks: {net} now for {", ".join(nodes)} (before {", ".join(old)}) by {_dmarc_who()}')
    return dns_share_list(None)


def dns_share_del(args):
    """Networks that may no longer ask this server: unbound and the firewall rules both."""
    state = _dns_share_state()
    before = [entry['net'] for entry in state['entries']]
    gone = {str(dns_share_net(item)) for item in (args.nets or '').replace(',', ' ').split()}
    # A client takes the removal of its master also for a net it never had (its own list of before 6.0.0.6.7 differed).
    missing = sorted(gone - set(before)) if cluster_role() != 'client' else []
    if not gone or missing:
        raise EfaError(f'Not in the list, nothing changed: {" ".join(missing)}')
    state['entries'] = [entry for entry in state['entries'] if entry['net'] not in gone]
    _dns_share_apply(state, before)
    _audit(f'DNS for other networks: {", ".join(sorted(gone))} removed by {_dmarc_who()}')
    return dns_share_list(None)


def dns_share_apply(_args):
    """The update: the file of unbound and the firewall rules as the list says (after a restore or a release upgrade)."""
    state = _dns_share_state()
    if state['entries']:
        _dns_share_apply(state, [entry['net'] for entry in state['entries']])
    if state['secondary']:
        _platform().use_local_resolver(state['secondary'])
    return dns_share_list(None)


def dns_share_secondary_set(args):
    """A second resolver for this host itself (the cluster partner): resolv.conf asks 127.0.0.1 first, then it. Empty: none."""
    value = (args.address or '').strip()
    if value:
        try:
            address = ipaddress.ip_address(value)
        except ValueError:
            raise EfaError(f'{value[:60]!r}: an IP address, such as the one of the other MX.')
        if address.is_loopback or address.is_unspecified or address.is_multicast or address.is_global:
            raise EfaError(f'{value}: an address of your own network (the other MX), not a public resolver.')
        value = str(address)
    state = _dns_share_state()
    state['secondary'] = value
    _json_write(DNS_SHARE_FILE, state, mode=0o644)
    _platform().use_local_resolver(value or None)
    _audit(f'DNS: second resolver of this host {value or "none"} by {_dmarc_who()}')
    return dns_share_list(None)


def extra_service_set(args):
    """Site-specific systemd services the health service also watches. They show in status, not in mail."""
    name, action = args.name.strip(), args.action.strip()
    if not SERVICE_RE.match(name):
        raise EfaError('Invalid service name.')
    if action not in ('add', 'remove'):
        raise EfaError("Action must be 'add' or 'remove'.")
    entries = [e for e in _read_lines(HEALTH_EXTRA) if e != name]
    if action == 'add':
        entries.append(name)
    _write(HEALTH_EXTRA, ''.join(e + '\n' for e in entries))
    return {'extra_services': entries}


def quarantine_set(args):
    """Hold mail rspamd marks as spam instead of delivering it. It waits in the mail server until released or deleted."""
    enabled = _on_off(args.mode)
    if enabled:
        _write(QUARANTINE_RULES, '/^X-Spam: Yes/ HOLD eFa quarantine\n/^X-Spam-Status: Yes/ HOLD eFa quarantine\n')
    _postconf_set('milter_header_checks', map_list_value(_postconf('milter_header_checks'), f'regexp:{QUARANTINE_RULES}', enabled))
    return {'quarantine': enabled}


def _held_mail():
    done = subprocess.run(['postqueue', '-j'], capture_output=True, text=True, check=True)
    mails = []
    for line in done.stdout.splitlines():
        item = json.loads(line)
        if item.get('queue_name') == 'hold':
            mails.append({'id': item['queue_id'], 'sender': item.get('sender', ''),
                          'recipients': [r['address'] for r in item.get('recipients', [])],
                          'arrived': item.get('arrival_time'), 'size': item.get('message_size')})
    return mails


# The mail queue: every mail Postfix holds, with actions that each need a yes and land in the audit log.
QUEUE_FILE = ETC + '/eFa/queue.json'
QUEUE_DEFAULTS = {'alarm_size': 200, 'alarm_hours': 24}
QUEUE_ACTIONS = {'hold': '-h', 'release': '-H', 'requeue': '-r', 'delete': '-d'}
DEST_FILE = '/var/lib/eFa/destinations.json'
SPOOL_DEFAULTS = {'maximal_queue_lifetime': '5d', 'bounce_queue_lifetime': '5d', 'initial_destination_concurrency': '2'}
QUEUE_RELAY_RE = re.compile(r'^(\w+): to=<[^>]*>, relay=([^\[,\s]+)(?:\[[^\]]*\](?::\d+)?)?,.* status=(sent|deferred|bounced) \((.*)\)\s*$')
QUEUE_DOWN_RE = re.compile(r'connect to |Connection refused|Connection timed out|No route to host|lost connection|Network is unreachable|Host not found', re.I)


def queue_entries(lines):
    """postqueue -j lines to rows: ID, queue, age, size, sender, recipients and why it waits."""
    rows, now = [], time.time()
    for line in lines:
        if not line.startswith('{'):
            continue
        item = json.loads(line)
        recipients = item.get('recipients') or []
        rows.append({'id': item.get('queue_id', ''), 'queue': item.get('queue_name', ''), 'age_hours': round((now - item.get('arrival_time', now)) / 3600, 1),
                     'size': item.get('message_size', 0), 'sender': item.get('sender', ''), 'rcpts': ', '.join(r.get('address', '') for r in recipients),
                     'reason': '; '.join(sorted({r.get('delay_reason', '') for r in recipients if r.get('delay_reason')}))[:300]})
    return rows


HOLD_LINE_RE = re.compile(r'\b([A-Za-z0-9]{6,32}): hold: (.*?)(?: from \S+)?; from=<[^>]*>(?: to=<[^>]*>)?.*?: ([^:]*)$')
HOLD_UNKNOWN = 'held: no hold line in the mail log (held by an admin, or older than the log)'


def hold_reasons(lines):
    """{queue ID: why Postfix holds it} from the hold lines of the mail log. postqueue -j has no reason for held mail
    (6.0.0.6: the queue page showed none): the reason is the action text and what matched, such as
    'eFa quarantine: header X-Spam-Status: Yes, score=14.47'."""
    found = {}
    for line in lines:
        match = HOLD_LINE_RE.search(line)
        if match:
            what = match.group(2).split(' tests=')[0].split(' required=')[0]
            found[match.group(1)] = f'{match.group(3).strip()}: {what}'[:300]
    return found


def _hold_log_lines():
    """The hold lines of the mail log and the one rotated before it (grep: fast also on a large log)."""
    files = [path for path in [REPORT_LOG] + sorted(glob.glob(REPORT_LOG + '-*'), reverse=True)[:1] if os.path.isfile(path)]
    if not files:
        return []
    done = subprocess.run(['grep', '-hF', ': hold: ', *files], capture_output=True, text=True, errors='replace', timeout=30)
    return done.stdout.splitlines()


def _queue_rows():
    done = subprocess.run(['postqueue', '-j'], capture_output=True, text=True, timeout=60)
    if done.returncode != 0:
        raise EfaError('postqueue failed: ' + done.stderr[-200:])
    rows = queue_entries(done.stdout.splitlines())
    if any(row['queue'] == 'hold' and not row['reason'] for row in rows):
        reasons = hold_reasons(_safe(_hold_log_lines, []))
        for row in rows:
            if row['queue'] == 'hold' and not row['reason']:
                row['reason'] = reasons.get(row['id'], HOLD_UNKNOWN)
    return rows


def queue_list(args):
    """The mail queue: active, waiting, held. Filter by queue and by text in sender, recipient or reason."""
    rows = _queue_rows()
    queue, text = (args.queue or '').strip(), (args.text or '').strip().lower()
    if queue:
        rows = [row for row in rows if row['queue'] == queue]
    if text:
        rows = [row for row in rows if text in (row['sender'] + ' ' + row['rcpts'] + ' ' + row['reason']).lower()]
    counts = {}
    for row in _queue_rows() if (queue or text) else rows:
        counts[row['queue']] = counts.get(row['queue'], 0) + 1
    return {'counts': counts, 'mails': sorted(rows, key=lambda row: -row['age_hours'])[:500]}


def queue_show(args):
    """The headers of one mail in the queue. The body stays closed."""
    queue_id = args.id.strip()
    if not QUEUE_ID_RE.match(queue_id) or queue_id not in {row['id'] for row in _queue_rows()}:
        raise EfaError('This mail is not in the queue.')
    done = subprocess.run(['postcat', '-hq', queue_id], capture_output=True, text=True, timeout=30)
    return {'id': queue_id, 'headers': done.stdout[:20000]}


def queue_action(args):
    """Hold, release, put back into the queue (a new try, a new arrival time) or delete one mail of the queue, or all waiting ones."""
    _confirm(args)
    action, queue_id = args.action.strip(), args.id.strip()
    if action not in QUEUE_ACTIONS:
        raise EfaError('Action: hold, release, requeue or delete.')
    if queue_id == 'ALL':
        if action == 'delete':
            raise EfaError('Delete only one mail at a time.')
        targets = [row['id'] for row in _queue_rows() if row['queue'] == ('hold' if action == 'release' else 'deferred')]
    elif QUEUE_ID_RE.match(queue_id) and queue_id in {row['id'] for row in _queue_rows()}:
        targets = [queue_id]
    else:
        raise EfaError('This mail is not in the queue.')
    for target in targets:
        subprocess.run(['postsuper', QUEUE_ACTIONS[action], target], capture_output=True, timeout=60)
    _audit(f'queue {action} {", ".join(targets[:50])} by {_dmarc_who()}')
    return {'action': action, 'mails': len(targets)}


def queue_flush(args):
    """Try all waiting mail now."""
    _confirm(args)
    subprocess.run(['postqueue', '-f'], capture_output=True, timeout=60)
    return {'flushed': True}


def queue_alarm_set(args):
    """Alarm by mail and event when the queue holds this many mails, or a mail waits this long."""
    state = {**QUEUE_DEFAULTS, **_json_read(QUEUE_FILE, {})}
    for key, low, high in (('alarm_size', 10, 1000000), ('alarm_hours', 1, 240)):
        value = (getattr(args, key, '') or '').strip()
        if value:
            if not value.isdigit() or not low <= int(value) <= high:
                raise EfaError(f'{key}: {low} to {high}.')
            state[key] = int(value)
    _json_write(QUEUE_FILE, state)
    return state


def queue_alarm(rows, state, now, last):
    """The alarm text, or None: at most every 6 hours."""
    if now - last < 6 * 3600:
        return None
    old = [row for row in rows if row['queue'] == 'deferred' and row['age_hours'] >= state['alarm_hours']]
    if len(rows) >= state['alarm_size']:
        return f'{len(rows)} mails in the queue, the limit is {state["alarm_size"]}.'
    if old:
        return f'{len(old)} mails wait longer than {state["alarm_hours"]} hours, the oldest {max(row["age_hours"] for row in old)} hours.'
    return None


def destination_update(state, lines, now):
    """Per receiving server: up or down, and since when, from the Postfix log. Returns the changes, (host, 'up'/'down')."""
    changes = []
    for line in lines:
        found = REPORT_LINE.match(line)
        if not found or not found.group(4).endswith('smtp'):
            continue
        done = QUEUE_RELAY_RE.match(found.group(5))
        if not done:
            continue
        _id, host, status, reason = done.groups()
        if host in ('none', 'local'):
            host = re.search(r'connect to ([^\[\s:]+)', reason).group(1) if re.search(r'connect to ([^\[\s:]+)', reason) else None
            if not host:
                continue
        wanted = 'up' if status == 'sent' else ('down' if status == 'deferred' and QUEUE_DOWN_RE.search(reason) else None)
        if not wanted:
            continue
        item = state.setdefault(host.lower(), {'state': wanted, 'since': now})
        if item['state'] != wanted:
            item.update(state=wanted, since=now)
            changes.append((host.lower(), wanted))
        item['last'] = now
    return changes


def spool_status(_args):
    """How long mail may wait, how fast it goes again after a pause, and each receiving server: up or down since when."""
    state = _json_read(DEST_FILE, {})
    return {**{key: _postconf(key) for key in SPOOL_DEFAULTS},
            'destinations': [{'host': host, 'state': item['state'], 'since': time.strftime('%Y-%m-%d %H:%M', time.localtime(item['since']))}
                             for host, item in sorted(state.items(), key=lambda pair: (pair[1]['state'] != 'down', pair[0]))][:200]}


def spool_set(args):
    """How long mail may wait in the queue (default 5 days), bounces too, and with how many connections a server starts again."""
    for key, pattern in (('maximal_queue_lifetime', r'\d{1,3}[hd]'), ('bounce_queue_lifetime', r'\d{1,3}[hd]'), ('initial_destination_concurrency', r'[1-9]|1\d|20')):
        value = (getattr(args, key, '') or '').strip()
        if value:
            if not re.fullmatch(pattern, value):
                raise EfaError(f'{key}: ' + ('like 5d or 12h.' if 'lifetime' in key else '1 to 20.'))
            _postconf_set(key, value)
    subprocess.run(['postfix', 'reload'], check=False, capture_output=True)
    return spool_status(None)


def _queue_job(lines):
    """Hourly with the mail report: the state of the receiving servers and the queue alarm."""
    now = time.time()
    state = _json_read(DEST_FILE, {})
    for host, wanted in destination_update(state, lines, now):
        text = f'The server {host} is ' + ('reachable again: the waiting mail goes out.' if wanted == 'up' else 'not reachable: mail to it waits in the queue.')
        _admin_notify(f'eFa-next: {host} {"is back" if wanted == "up" else "is down"}', text)
        _event('destination_up' if wanted == 'up' else 'destination_down', 'notice' if wanted == 'up' else 'warning', host=host)
    _json_write(DEST_FILE, state)
    settings_now = {**QUEUE_DEFAULTS, **_json_read(QUEUE_FILE, {})}
    alarm = queue_alarm(_queue_rows(), settings_now, now, settings_now.get('last_alarm', 0))
    if alarm:
        _admin_notify('eFa-next: the mail queue grows', alarm)
        _event('queue_alarm', 'warning', text=alarm)
        settings_now['last_alarm'] = now
        _json_write(QUEUE_FILE, settings_now)


def quarantine_list(_args):
    """List quarantined mail."""
    return {'quarantine': _held_mail(), 'quarantine_days': _quarantine_days()}


def _held_id(args):
    queue_id = args.id.strip()
    if not QUEUE_ID_RE.match(queue_id):
        raise EfaError('Invalid queue ID.')
    if queue_id not in [m['id'] for m in _held_mail()]:
        raise EfaError('This mail is not in quarantine.')
    return queue_id


def quarantine_show(args):
    """Show the headers of a quarantined mail."""
    queue_id = _held_id(args)
    done = subprocess.run(['postcat', '-hq', queue_id], capture_output=True, text=True, check=True)
    return {'id': queue_id, 'headers': done.stdout[:20000]}


def quarantine_release(args):
    """Deliver a quarantined mail."""
    queue_id = _held_id(args)
    # -r, not -H: released mail gets a new arrival time, so old mail does not bounce
    subprocess.run(['postsuper', '-r', queue_id], check=True, capture_output=True)
    return {'released': queue_id}


def quarantine_delete(args):
    """Delete a quarantined mail for good."""
    _confirm(args)
    queue_id = _held_id(args)
    subprocess.run(['postsuper', '-d', queue_id], check=True, capture_output=True)
    return {'deleted': queue_id}


def _quarantine_days():
    for line in _read_lines(QUARANTINE_DAYS_FILE):
        if line.isdigit():
            return int(line)
    return QUARANTINE_DEFAULT_DAYS


def quarantine_days_set(args):
    """Days until quarantined mail is deleted."""
    try:
        days = int(args.days)
    except ValueError:
        raise EfaError('Days must be a number.')
    if not 1 <= days <= 3650:
        raise EfaError('Days must be 1 to 3650.')
    _write(QUARANTINE_DAYS_FILE, f'{days}\n')
    return {'quarantine_days': days}


def quarantine_purge(_args):
    """Delete quarantined mail older than the set number of days."""
    tenants, tenant_domains, global_days = retention_tenants(), _tenant_domains_or_none(), _quarantine_days()
    now = time.time()
    deleted = [m['id'] for m in _held_mail()
               if (m['arrived'] or 0) < now - 86400 * retention_item_days('quarantine', {rcpt.rpartition('@')[2].lower() for rcpt in m['recipients']},
                                                                          tenants, tenant_domains, global_days)]
    for queue_id in deleted:
        subprocess.run(['postsuper', '-d', queue_id], check=True, capture_output=True)
    if deleted:
        _audit(f'retention: {len(deleted)} held mails past their days deleted')
    return {'deleted': len(deleted)}


# Reports that other servers send: one address goes to a pipe that reads DMARC aggregate and TLS reports.
REPORTS_FILE_IN = ETC + '/eFa/reports-in.json'
REPORTS_TRANSPORT = ETC + '/postfix/efa-reports-transport'
REPORTS_SERVICE = 'efa-reports'
REPORTS_MASTER = ('efa-reports unix - n n - 4 pipe flags=Rq user=efa-web argv=/usr/bin/python3 /usr/local/sbin/efa-reports.py')
DMARC_HINT_MIN = 10


def reports_in_set(args):
    """One address of yours receives the DMARC and TLS reports of other servers; eFa-next reads them instead of delivering them."""
    on = _on_off(args.mode)
    address = (args.address or '').strip().lower() or _json_read(REPORTS_FILE_IN, {}).get('address', '')
    if on and not SENDER_RE.match(address):
        raise EfaError('The address that receives the reports, such as dmarc-reports@example.org.')
    if on:
        subprocess.run(['postconf', '-M', f'{REPORTS_SERVICE}/unix={REPORTS_MASTER}'], check=True, capture_output=True)
        _rule_map(REPORTS_TRANSPORT, [f'{address} {REPORTS_SERVICE}:'])
    else:
        _rule_map(REPORTS_TRANSPORT, [])
        subprocess.run(['postconf', '-MX', f'{REPORTS_SERVICE}/unix'], check=False, capture_output=True)
    wanted = rule_map_value(_postconf('transport_maps'), REPORTS_TRANSPORT, on)
    if wanted != _postconf('transport_maps'):
        _postconf_set('transport_maps', wanted)
    subprocess.run(['postfix', 'reload'], check=False, capture_output=True)
    _json_write(REPORTS_FILE_IN, {'enabled': on, 'address': address})
    return {'enabled': on, 'address': address,
            'records': {'dmarc': f'rua=mailto:{address}', 'tls_rpt': f'v=TLSRPTv1; rua=mailto:{address}'} if address else {},
            'note': 'An address of another domain than the reported one needs its permission record, see dmarc-record-set.'}


def dmarc_hints(rows, own):
    """Sources that send for a domain and fail both checks: a missing SPF entry or DKIM key, or someone abusing the domain."""
    hints = []
    for row in rows:
        if row['n'] >= DMARC_HINT_MIN and row['dkim'] != 'pass' and row['spf'] != 'pass':
            known = row['source_ip'] in own
            hints.append(f"{row['source_ip']} sent {row['n']} mails for {row['domain']} that fail SPF and DKIM: "
                         + ('this server, check its DKIM key.' if known else 'if it is a service of yours, add it to SPF or let it sign with DKIM; '
                                                                              'if not, someone uses your domain.'))
    return hints


def dmarc_report_show(args):
    """DMARC aggregate reports received: per domain and sending address, with hints on senders that are not covered."""
    days = (args.days or '').strip() or '30'
    if not days.isdigit() or not 1 <= int(days) <= 400:
        raise EfaError('Days: 1 to 400.')
    domains = identity_now['domains'] if identity_now else None
    where, params = 'WHERE begin_ts >= NOW() - INTERVAL %s DAY', [int(days)]
    wanted = (args.domain or '').strip().lower()
    if wanted:
        where, params = where + ' AND domain = %s', params + [wanted]
    if domains is not None:
        where += ' AND domain IN (' + ', '.join(['%s'] * len(domains)) + ')' if domains else ' AND FALSE'
        params += list(domains)
    rows = _admin_query('SELECT domain, source_ip, SUM(n) AS n, MAX(dkim) AS dkim, MAX(spf) AS spf, MAX(disposition) AS disposition, '
                        'COUNT(DISTINCT org) AS reporters FROM dmarc_rua ' + where + ' GROUP BY domain, source_ip, dkim, spf ORDER BY n DESC LIMIT 500', params)
    rows = [{**row, 'n': int(row['n'])} for row in rows]
    own = set()
    try:
        own = set(re.findall(r'inet6? ([0-9a-f.:]+)/', subprocess.run(['ip', '-o', 'addr'], capture_output=True, text=True).stdout))
    except OSError:
        pass
    total = sum(row['n'] for row in rows)
    passed = sum(row['n'] for row in rows if row['dkim'] == 'pass' or row['spf'] == 'pass')
    return {'days': int(days), 'mails': total, 'pass_percent': round(100 * passed / total, 1) if total else None, 'sources': rows,
            'hints': dmarc_hints(rows, own)}


def tls_report_show(args):
    """TLS reports received: per domain and policy, successful and failed sessions, and why they failed."""
    days = (args.days or '').strip() or '30'
    if not days.isdigit() or not 1 <= int(days) <= 400:
        raise EfaError('Days: 1 to 400.')
    domains = identity_now['domains'] if identity_now else None
    where, params = 'WHERE begin_ts >= NOW() - INTERVAL %s DAY', [int(days)]
    if domains is not None:
        where += ' AND domain IN (' + ', '.join(['%s'] * len(domains)) + ')' if domains else ' AND FALSE'
        params += list(domains)
    rows = _admin_query('SELECT domain, policy, org, SUM(success) AS success, SUM(failure) AS failure, '
                        'GROUP_CONCAT(failures SEPARATOR \'\\n\') AS failures FROM tls_rpt ' + where + ' GROUP BY domain, policy, org ORDER BY domain', params)
    found = []
    for row in rows:
        reasons = {}
        for line in (row['failures'] or '').splitlines():
            try:
                for item in json.loads(line):
                    reasons[item['type']] = reasons.get(item['type'], 0) + int(item['count'])
            except (ValueError, KeyError, TypeError):
                continue
        found.append({'domain': row['domain'], 'policy': row['policy'], 'reporter': row['org'], 'success': int(row['success']), 'failure': int(row['failure']),
                      'reasons': ', '.join(f'{name} {count}' for name, count in sorted(reasons.items()))})
    return {'days': int(days), 'reports': found}


# DANE: outgoing mail checks the TLSA records of the receiving server, which needs answers the own resolver validated.
DANE_FILE = ETC + '/eFa/dane.json'
DNSSEC_PROBE = ('isc.org', 'dnssec-failed.org')


def _resolver_validates():
    """True if the own resolver validates DNSSEC: a signed answer has the ad flag, a broken signature fails."""
    good = subprocess.run(['dig', '+dnssec', '+time=3', '+tries=1', DNSSEC_PROBE[0], 'SOA', '@127.0.0.1'], capture_output=True, text=True, timeout=15).stdout
    bad = subprocess.run(['dig', '+dnssec', '+time=3', '+tries=1', DNSSEC_PROBE[1], 'A', '@127.0.0.1'], capture_output=True, text=True, timeout=15).stdout
    return bool(re.search(r'flags:[^;]*\bad\b', good)) and 'status: SERVFAIL' in bad


def dane_status(_args):
    """DANE for outgoing mail: on or off, and whether the own resolver validates DNSSEC."""
    level = _postconf('smtp_tls_security_level')
    return {'enabled': level == 'dane', 'tls_level': level, 'dns_support': _postconf('smtp_dns_support_level') or 'default',
            'resolver_validates': _resolver_validates()}


# SEC-STD-DANE: Postfix has no level "DANE where TLSA records exist, else encrypt": dane sends to a server without TLSA records
# with TLS only where it offers it. With encrypt (or stricter) for all mail, DANE is therefore a choice, never done by itself.
DANE_STRICT_LEVELS = ('encrypt', 'verify', 'secure', 'fingerprint', 'dane-only')
DANE_STRICT_TEXT = ('All outgoing mail needs TLS now (smtp_tls_security_level = {level}). Postfix has no "DANE where TLSA records exist, '
                    'else TLS required": with DANE, mail to a server without TLSA records goes with TLS only where that server offers it. '
                    'eFa-next keeps {level} (stricter); BSI TR-03108 (DANE outgoing) stays not fulfilled. To switch on purpose: '
                    'DANE for outgoing mail, on, with weaker yes (efactl dane-set --mode on --weaker yes).')


def dane_set(args):
    """Outgoing mail uses DANE: a receiver with TLSA records gets verified TLS, all others TLS where they offer it."""
    on = _on_off(args.mode)
    level = _postconf('smtp_tls_security_level')
    if on:
        if level in DANE_STRICT_LEVELS and (getattr(args, 'weaker', '') or '').strip() != 'yes':
            raise EfaError(_text(DANE_STRICT_TEXT, level=level))
        if level not in ('may', 'none', 'dane', '') and level not in DANE_STRICT_LEVELS:
            raise EfaError(f'Unknown TLS level for all mail: {level}; nothing changed.')
        if not _resolver_validates():
            raise EfaError('The own resolver does not validate DNSSEC, DANE would not be safe. Check Unbound and its trust anchor.')
        if level != 'dane':
            _json_write(DANE_FILE, {'previous': level or 'may', 'previous_dns': _postconf('smtp_dns_support_level')})
            if level in DANE_STRICT_LEVELS:
                _audit(f'DANE for outgoing mail on purpose instead of {level} (mail to servers without TLSA records may go without TLS) '
                       f'by {_dmarc_who()}')
        _postconf_set('smtp_dns_support_level', 'dnssec')
        _postconf_set('smtp_tls_security_level', 'dane')
    elif level == 'dane':
        before = _json_read(DANE_FILE, {})
        _postconf_set('smtp_tls_security_level', before.get('previous', 'may'))
        if before.get('previous_dns'):
            _postconf_set('smtp_dns_support_level', before['previous_dns'])
        else:
            subprocess.run(['postconf', '-X', 'smtp_dns_support_level'], check=False, capture_output=True)
    subprocess.run(['postfix', 'reload'], check=False, capture_output=True)
    return dane_status(None)


def tlsa_records(der_spki, host, issuer_spki=None):
    """TLSA records for the SMTP server: 3 1 1 for its own key, and 2 1 1 for the key of the issuer if it is known."""
    records = [f'_25._tcp.{host}. IN TLSA 3 1 1 {hashlib.sha256(der_spki).hexdigest()}']
    if issuer_spki:
        records.append(f'_25._tcp.{host}. IN TLSA 2 1 1 {hashlib.sha256(issuer_spki).hexdigest()}')
    return records


def _spki_of(pem):
    """The DER public key of a certificate, through openssl."""
    key = subprocess.run(['openssl', 'x509', '-noout', '-pubkey'], input=pem, capture_output=True, timeout=30)
    der = subprocess.run(['openssl', 'pkey', '-pubin', '-outform', 'DER'], input=key.stdout, capture_output=True, timeout=30)
    if key.returncode or der.returncode:
        raise EfaError('openssl could not read the certificate.')
    return der.stdout


def tlsa_show(args):
    """TLSA records to publish for the MX name of this server, from the certificate Postfix uses, and what DNS shows now."""
    host = (args.host or '').strip().lower().rstrip('.') or _postconf('myhostname').lower()
    if not DOMAIN_RE.match(host):
        raise EfaError('Host: the MX name of this server.')
    with open(_postconf('smtpd_tls_cert_file'), 'rb') as f:
        chain = re.findall(rb'-----BEGIN CERTIFICATE-----.*?-----END CERTIFICATE-----', f.read(), re.S)
    if not chain:
        raise EfaError('No certificate found.')
    issuer = _spki_of(chain[1]) if len(chain) > 1 else None
    wanted = tlsa_records(_spki_of(chain[0]), host, issuer)
    done = subprocess.run(['dig', '+short', '+time=3', '+tries=1', f'_25._tcp.{host}', 'TLSA', '@127.0.0.1'], capture_output=True, text=True, timeout=15)
    published = [line.lower().replace(' ', '') for line in done.stdout.splitlines() if line.strip()]
    matches = [record for record in wanted if record.split('TLSA ', 1)[1].lower().replace(' ', '') in published]
    return {'host': host, 'records': wanted, 'published': done.stdout.split('\n')[:-1], 'matching': matches,
            'note': 'A certificate with a new key needs a new 3 1 1 record before it is used: renew with the same key (certbot --reuse-key), '
                    'or publish the new record a day ahead. The 2 1 1 record follows the issuer and changes less often.'}


# P8: a new key for the certificate of the MX without breaking DANE. The renewals keep the key (--reuse-key), so the 3 1 1
# record stays right. For a new key: prepare makes a second certificate with its own key and shows its record; switch uses it
# only once DNS has that record next to the old one.
ACME_FILE = ETC + '/eFa/acme.json'
CERTBOT_RENEW_CRON = '0 0,12 * * * root certbot renew --quiet --deploy-hook "systemctl reload nginx postfix"\n'


def _tlsa_published(host):
    done = subprocess.run(['dig', '+short', '+time=3', '+tries=1', f'_25._tcp.{host}', 'TLSA', '@127.0.0.1'], capture_output=True, text=True, timeout=15)
    return {line.lower().replace(' ', '') for line in done.stdout.splitlines() if line.strip()}


def tlsa_ready(record, published):
    """Whether DNS shows this TLSA record (a line of tlsa_records)."""
    return record.split('TLSA ', 1)[1].lower().replace(' ', '') in published


def _lineage_spki(lineage):
    with open(f'{ETC}/letsencrypt/live/{lineage}/cert.pem', 'rb') as f:
        return _spki_of(f.read())


def letsencrypt_rollover(args):
    """A new key for the Let's Encrypt certificate, DANE-safe: prepare, publish the record it shows, then switch."""
    step = (args.step or '').strip()
    if step not in ('prepare', 'switch', 'keep'):
        raise EfaError("Step: 'prepare', 'switch' or 'keep'.")
    state = _json_read(ACME_FILE, {})
    domain = (state.get('domain') or _postconf('myhostname')).lower()
    current = state.get('lineage') or domain
    if not os.path.isdir(f'{ETC}/letsencrypt/live/{current}'):
        raise EfaError("No Let's Encrypt certificate of this host yet (Network, DNS & certificate, Let's Encrypt).")
    following = state.get('next') or (domain + '-next' if current == domain else domain)
    if step == 'prepare':
        # Through the webroot of nginx: certbot never touches the nginx settings of eFa-next.
        notes = _acme_request(['certbot', 'certonly', '--webroot', '-w', ACME_WEBROOT, '--non-interactive', '--agree-tos', '--key-type', 'ecdsa',
                               '--elliptic-curve', 'secp256r1', '--reuse-key', '--cert-name', following, '--domains', domain], [domain])
        _json_write(ACME_FILE, {**state, 'domain': domain, 'lineage': current, 'next': following}, mode=0o644)
        record = tlsa_records(_lineage_spki(following), domain)[0]
        return {'prepared': following, 'publish_now': record, 'keep': tlsa_records(_lineage_spki(current), domain)[0],
                'note': 'Publish the new record next to the old one, wait for the TTL of the record (a day is safe), then run the step switch.',
                **({'hint': ' '.join(notes)} if notes else {})}
    if step == 'switch':
        if not state.get('next') or not os.path.isdir(f'{ETC}/letsencrypt/live/{following}'):
            raise EfaError('Run the step prepare first.')
        record = tlsa_records(_lineage_spki(following), domain)[0]
        published = _tlsa_published(domain)
        if not tlsa_ready(record, published):
            raise EfaError(f'DNS does not show the new record yet, nothing changed: {record}')
        live = f'{ETC}/letsencrypt/live/{following}'
        # As letsencrypt-set: eFa-next writes the paths, nginx first (it may reject the certificate, then nothing changed); an own
        # ECDSA certificate of the web (web-cert-set ecdsa) stays in nginx, only Postfix switches.
        web_own = web_cert_own()
        if not web_own:
            _nginx_certificate(f'{live}/fullchain.pem', f'{live}/privkey.pem')
        _postconf_set('smtpd_tls_key_file', f'{live}/privkey.pem')
        _postconf_set('smtpd_tls_cert_file', f'{live}/fullchain.pem')
        for unit in ('postfix',) if web_own else ('nginx', 'postfix'):
            _platform().service_reload_if_active(unit)
        _json_write(ACME_FILE, {'domain': domain, 'lineage': following, 'next': current}, mode=0o644)
        _audit(f'certificate key of {domain} switched to {following} by {_dmarc_who()}')
        return {'switched_to': following, 'note': f'Remove the old record after a day: {tlsa_records(_lineage_spki(current), domain)[0]}'}
    # keep: a certificate of 6.0.0.4 or older: its renewals made a new key each time. From now on they keep it.
    path = f'{ETC}/letsencrypt/renewal/{current}.conf'
    text = open(path).read()
    if renewal_reuse_key(text) != text:
        _write(path, renewal_reuse_key(text))
    return {'renewals_keep_the_key': current}


def renewal_reuse_key(text):
    """The renewal settings of a lineage with reuse_key = True; everything else, the key type too, stays as it is."""
    if re.search(r'^reuse_key\s*=\s*True\s*$', text, re.M):
        return text
    if '[renewalparams]\n' not in text:
        raise EfaError('The renewal settings of the certificate have no [renewalparams].')
    text = re.sub(r'^reuse_key\s*=.*\n', '', text, flags=re.M)
    return text.replace('[renewalparams]\n', '[renewalparams]\nreuse_key = True\n', 1)


# MIG-LE: a certificate of Let's Encrypt that came over from eFa 5 is taken as it is: the same lineage, key and key type, so a
# published TLSA record (DANE) stays right. No request at Let's Encrypt. ECDSA only with letsencrypt-rollover (TLSA first).
# eFa-next writes the paths into its own nginx and Postfix settings; certbot only renews, through the webroot that nginx of
# eFa-next serves (/.well-known/acme-challenge/), never with its nginx or apache installer.
ACME_WEBROOT = '/usr/share/nginx/html'
RENEWAL_DROPPED = ('authenticator', 'installer', 'webroot_path', 'pre_hook', 'post_hook', 'renew_hook')


def renewal_takeover(text, names, webroot=ACME_WEBROOT):
    """The renewal settings of a lineage of eFa 5 for eFa-next: the key kept (reuse_key), the key type as it is, renewed through
    the webroot of nginx; the authenticator and installer of eFa 5 (apache, standalone) and their hooks go."""
    text = renewal_reuse_key(text)
    head, _sep, rest = text.partition('[renewalparams]\n')
    following = re.search(r'^\[', rest, re.M)
    params, tail = (rest[:following.start()], rest[following.start():]) if following else (rest, '')
    kept = [line for line in params.splitlines() if line.strip() and line.split('=', 1)[0].strip() not in RENEWAL_DROPPED]
    tail = re.sub(r'^\[\[webroot_map\]\]\n(?:[^\[\n].*\n?|\n)*', '', tail, flags=re.M)
    return (head + '[renewalparams]\n' + ''.join(line + '\n' for line in kept) + 'authenticator = webroot\n' + f'webroot_path = {webroot},\n'
            + '[[webroot_map]]\n' + ''.join(f'{name} = {webroot}\n' for name in names) + tail)


NGINX_CERT_RE = re.compile(r'^(\s*)ssl_certificate\s+([^;\s]+)\s*;[^\n]*', re.M)
NGINX_KEY_RE = re.compile(r'^(\s*)ssl_certificate_key\s+([^;\s]+)\s*;[^\n]*', re.M)
# The nginx settings before the web certificate of eFa-next first changed them: web-cert-set mail puts them back as they were.
NGINX_CERT_BEFORE = '/var/lib/eFa/nginx-efa.conf.before-web-cert'


def nginx_cert_rewrite(conf, cert, key):
    """The nginx settings of eFa-next with the web certificate cert/key in every HTTPS server block. A migrated host has more than
    one, each with its own pair (a migrated host: the default server with the self-signed one, a block of the certbot installer of
    eFa 5 with Let's Encrypt): all of them serve the web interface, all get it. Each ssl_certificate needs its ssl_certificate_key."""
    count, key_count = len(NGINX_CERT_RE.findall(conf)), len(NGINX_KEY_RE.findall(conf))
    if not count or count != key_count:
        raise EfaError(f'{NGINX_CONF} has an unknown form: {count} ssl_certificate and {key_count} ssl_certificate_key, '
                       'one of each per HTTPS server block expected. Nothing changed.')
    new = NGINX_CERT_RE.sub(lambda m: f'{m.group(1)}ssl_certificate {cert};', conf)
    return NGINX_KEY_RE.sub(lambda m: f'{m.group(1)}ssl_certificate_key {key};', new)


def _nginx_certificate(cert, key):
    """The certificate of the web interface in the nginx settings of eFa-next; a config nginx rejects is taken back."""
    with open(NGINX_CONF) as f:
        conf = f.read()
    new = nginx_http2_text(nginx_cert_rewrite(conf, cert, key), web_http2_on(), nginx_version())
    if new == conf:
        return
    if not os.path.exists(NGINX_CERT_BEFORE):
        _write(NGINX_CERT_BEFORE, conf)
    _write(NGINX_CONF, new)
    done = subprocess.run(['nginx', '-t'], capture_output=True, text=True)
    if done.returncode != 0:
        _write(NGINX_CONF, conf)
        raise EfaError('nginx rejected the certificate, nothing changed: ' + done.stderr[-300:])


# Mozilla modern wants an ECDSA certificate on the web (owner, 2026-11-12: the more secure wins). The web gets a lineage of its
# own with a P-384 key; Postfix keeps its certificate, so a TLSA record of the MX (DANE) stays right.
WEB_LINEAGE = 'efa-web-ecdsa'
# Hans 2026-11-16: Let's Encrypt locks out who overdoes it. Every request goes through _acme_request: never on a development host with the
# dev flag or for a name that is not public, first a dry run against the staging server, then one real request without retry,
# an existing lineage kept until it is due; after a failure no new request for an hour unless the admin forces it.
ACME_COOLDOWN = '/var/lib/eFa/acme-cooldown.json'
ACME_COOLDOWN_SECONDS = 3600
ACME_DEV_FLAG = ETC + '/eFa/dev-no-setup-code'


def acme_name_problem(name, resolve=None, public=None, notes=None):
    """'' when Let's Encrypt can check the name (a public DNS name with a public address), else why not.

    The local resolver may answer with an internal address (split horizon); Let's Encrypt asks the public DNS. So an internal
    answer is never the refusal: the public DNS decides, and when it cannot be asked from here, Let's Encrypt does."""
    name = (name or '').strip().lower().rstrip('.')
    if not DOMAIN_RE.match(name) or not _harden().public_name(name):
        return f'{name or "no name"} is not a public DNS name'
    is_global = lambda addr: ipaddress.ip_address(addr.split('%')[0]).is_global
    try:
        found = {item[4][0] for item in (resolve or socket.getaddrinfo)(name, 80, proto=socket.IPPROTO_TCP)}
    except (OSError, UnicodeError):
        found = set()
    if any(is_global(addr) for addr in found):
        return ''
    outside = (public or _lib('efa_evidence').public_addresses)(name)
    here = ', '.join(sorted(found))
    if outside is None:
        if not found:
            return f'{name} does not resolve'
        if notes is not None:
            notes.append(f'{name}: the public DNS cannot be asked from here; the internal address ({here}) is ignored, Let\'s Encrypt checks it.')
        return ''
    if any(is_global(addr) for addr in outside):
        if found and notes is not None:
            notes.append(f'{name}: the internal address ({here}) is ignored; the public DNS has {", ".join(sorted(a for a in outside if is_global(a)))}.')
        return ''
    if not found and not outside:
        return f'{name} does not resolve'
    return f'{name} resolves only to addresses that are not public ({", ".join(sorted(outside or found))})'


def acme_cooldown():
    """The pause after a failed request: {'until': epoch, 'reason': text} while it lasts, else {}."""
    state = _json_read(ACME_COOLDOWN, {})
    return state if isinstance(state, dict) and float(state.get('until') or 0) > time.time() else {}


def _acme_request(cmd, names, force=False, run=None, resolve=None, public=None):
    """One certbot certonly: the dry run on staging first, then the real request once. Raises EfaError, never retries.
    Returns the notes of the name check (an internal address it ignored)."""
    if os.path.lexists(ACME_DEV_FLAG):
        raise EfaError(f"Dev mode ({ACME_DEV_FLAG}): no Let's Encrypt on this host; the self-signed certificate stays.")
    notes = []
    problems = [problem for problem in (acme_name_problem(name, resolve, public, notes) for name in names) if problem]
    if problems:
        raise EfaError("Let's Encrypt cannot check this name, the certificate stays: " + '; '.join(problems) + '.')
    pause = acme_cooldown()
    if pause and not force:
        raise EfaError("Let's Encrypt paused after a failed request until "
                       + time.strftime('%Y-%m-%d %H:%M', time.localtime(float(pause['until'])))
                       + f" ({str(pause.get('reason', ''))[:200]}); force=yes asks again now.")
    for label, extra in (('dry run', ['--dry-run']), ('request', ['--keep-until-expiring'])):
        done = (run or subprocess.run)(cmd + extra, capture_output=True, text=True, timeout=300)
        if done.returncode != 0:
            reason = (done.stderr or done.stdout or '')[-400:]
            _json_write(ACME_COOLDOWN, {'until': time.time() + ACME_COOLDOWN_SECONDS, 'reason': f'{label}: {reason[-200:]}'}, mode=0o644)
            _audit(f"Let's Encrypt {label} for {', '.join(names)} failed, no new request for an hour: {reason[-200:]}")
            raise EfaError(f"certbot {label} failed, nothing changed: {reason}")
    try:
        os.unlink(ACME_COOLDOWN)
    except FileNotFoundError:
        pass
    for note in notes:
        _audit("Let's Encrypt name check: " + note)
    return notes


def acme_banner():
    """Yellow on the dashboard while Let's Encrypt is paused after a failed request."""
    pause = acme_cooldown()
    if not pause:
        return []
    return [_text("Let's Encrypt is paused until {until} after a failed request ({reason}). The certificate stays as it was.",
                  until=time.strftime('%Y-%m-%d %H:%M', time.localtime(float(pause['until']))), reason=str(pause.get('reason', ''))[:120])]


def web_cert_names(cert_pem, fallback):
    """The names of the web certificate now (a valid DNS name each), else the host name: the new certificate covers the same."""
    names = [name.lower() for name in certificate_names(cert_pem) if DOMAIN_RE.match(name.lower())] if cert_pem else []
    return list(dict.fromkeys(names)) or [fallback]


def nginx_cert_restore_text(before, now):
    """now with the certificate lines of before, block by block in their order; only the certificates, everything else of now
    stays. None when the number of blocks differs."""
    certs, keys = [m.group(0) for m in NGINX_CERT_RE.finditer(before)], [m.group(0) for m in NGINX_KEY_RE.finditer(before)]
    if not certs or len(certs) != len(keys) or len(NGINX_CERT_RE.findall(now)) != len(certs) or len(NGINX_KEY_RE.findall(now)) != len(keys):
        return None
    certs_left, keys_left = iter(certs), iter(keys)
    new = NGINX_CERT_RE.sub(lambda _m: next(certs_left), now)
    return NGINX_KEY_RE.sub(lambda _m: next(keys_left), new)


def _nginx_cert_restore():
    """The certificates nginx had before the first change (NGINX_CERT_BEFORE), when all their files are still there and nginx takes
    them; True when put back."""
    try:
        with open(NGINX_CERT_BEFORE) as f:
            before = f.read()
        with open(NGINX_CONF) as f:
            now = f.read()
    except OSError:
        return False
    new = nginx_cert_restore_text(before, now)
    # The copy of before may be older than the HTTP/2 setting: it never switches HTTP/2 back on.
    new = None if new is None else nginx_http2_text(new, web_http2_on(), nginx_version())
    if new is None or not all(os.path.exists(m.group(2)) for regex in (NGINX_CERT_RE, NGINX_KEY_RE) for m in regex.finditer(new)):
        return False
    _write(NGINX_CONF, new)
    if subprocess.run(['nginx', '-t'], capture_output=True, text=True).returncode != 0:
        _write(NGINX_CONF, now)
        return False
    os.remove(NGINX_CERT_BEFORE)
    return True


def web_cert_set(args):
    """ecdsa: a Let's Encrypt certificate with an ECDSA P-384 key for nginx only (renewed with the others, the key kept);
    mail: nginx uses the certificate of Postfix again."""
    mode = (args.mode or '').strip()
    if mode not in ('ecdsa', 'mail'):
        raise EfaError('Mode: ecdsa or mail.')
    notes = []
    if mode == 'mail' and _nginx_cert_restore():
        _platform().service_reload_if_active('nginx')
        _audit(f'web certificate set back to the nginx settings before by {_dmarc_who()}')
        current = _certificates_in_use()['web']
        return {'web_certificate': mode, 'file': current, 'key': cert_key(current) if current else None}
    if mode == 'mail':
        cert, key = _postconf('smtpd_tls_cert_file'), _postconf('smtpd_tls_key_file')
        if not (cert and key and os.path.exists(cert) and os.path.exists(key)):
            raise EfaError('Postfix has no certificate file to give back to nginx; nothing changed.')
    else:
        current = _certificates_in_use()['web']
        pem = open(current, 'rb').read() if current and os.path.exists(current) else b''
        names = web_cert_names(pem, _postconf('myhostname').lower())
        # The account: the e-mail and the accepted terms given now (setup wizard), else those of letsencrypt-set before.
        given = (getattr(args, 'email', '') or '').strip().lower()
        if given and (getattr(args, 'accept_tos', '') or '').strip() != 'yes':
            raise EfaError("Type 'yes' to accept the Let's Encrypt terms of service.")
        email = given or _json_read(ACME_FILE, {}).get('email', '')
        if not SENDER_RE.match(email or ''):
            raise EfaError("Let's Encrypt needs a contact e-mail and the accepted terms (Let's Encrypt certificate first); "
                           'nginx keeps its certificate.')
        try:
            notes = _acme_request(['certbot', 'certonly', '--webroot', '-w', ACME_WEBROOT, '--non-interactive', '--agree-tos', '-m', email,
                           '--key-type', 'ecdsa', '--elliptic-curve', 'secp384r1', '--reuse-key', '--cert-name', WEB_LINEAGE,
                           *[part for name in names for part in ('-d', name)]], names, force=(getattr(args, 'force', '') or '').strip() == 'yes')
        except EfaError as err:
            raise EfaError(f"nginx keeps its certificate ({', '.join(names)}): {err}")
        _json_write(ACME_FILE, {**_json_read(ACME_FILE, {}), 'email': email}, mode=0o644)
        live = f'{ETC}/letsencrypt/live/{WEB_LINEAGE}'
        cert, key = f'{live}/fullchain.pem', f'{live}/privkey.pem'
        _write(ETC + '/cron.d/certbotrenew', CERTBOT_RENEW_CRON)
    _nginx_certificate(cert, key)
    _platform().service_reload_if_active('nginx')
    _audit(f'web certificate set to {mode} by {_dmarc_who()}')
    return {'web_certificate': mode, 'file': cert, 'key': cert_key(cert), **({'hint': ' '.join(notes)} if notes else {})}


def certificate_names(cert_pem):
    """The DNS names of a certificate (subjectAltName)."""
    from cryptography import x509
    try:
        return x509.load_pem_x509_certificate(cert_pem).extensions.get_extension_for_class(x509.SubjectAlternativeName).value.get_values_for_type(x509.DNSName)
    except x509.ExtensionNotFound:
        return []


def certificate_problem(name, cert_pem, key_pem):
    """'' when the certificate is valid now, names this host and fits the key, else why not."""
    from cryptography.hazmat.primitives import serialization
    from cryptography import x509
    problem = certificate_for(name, cert_pem)
    if problem:
        return problem
    spki = serialization.Encoding.DER, serialization.PublicFormat.SubjectPublicKeyInfo
    try:
        key = serialization.load_pem_private_key(key_pem, None).public_key().public_bytes(*spki)
    except (ValueError, TypeError):
        return 'the key is not readable'
    return '' if x509.load_pem_x509_certificate(cert_pem).public_key().public_bytes(*spki) == key else 'the key does not fit the certificate'


def _letsencrypt_lineage(name):
    """The lineage for this host name: live/<name>, else the one Postfix uses (eFa 5 may have named it otherwise)."""
    if os.path.isdir(f'{ETC}/letsencrypt/live/{name}'):
        return name
    found = re.match(re.escape(ETC) + r'/letsencrypt/live/([^/]+)/', _postconf('smtpd_tls_cert_file') or '')
    return found.group(1) if found else name


def _letsencrypt_problem(name, lineage, chain=True):
    """'' when the lineage can serve this host as it is, else why not. chain: also verify the chain (openssl, slower)."""
    live = f'{ETC}/letsencrypt/live/{lineage}'
    try:
        with open(live + '/cert.pem', 'rb') as f:
            cert = f.read()
        with open(live + '/privkey.pem', 'rb') as f:
            key = f.read()
    except OSError:
        return f'no certificate in {live}'
    if not os.path.exists(f'{ETC}/letsencrypt/renewal/{lineage}.conf'):
        return f'no renewal settings for {lineage}'
    problem = certificate_problem(name, cert, key)
    if problem or not chain:
        return problem
    done = subprocess.run(['openssl', 'verify', '-untrusted', live + '/chain.pem', live + '/cert.pem'], capture_output=True, text=True, timeout=30)
    return '' if done.returncode == 0 else 'the chain does not verify: ' + (done.stdout + done.stderr).strip()[-200:]


def letsencrypt_takeover(args):
    """The Let's Encrypt certificate already on this host (after a migration from eFa 5) for nginx and Postfix, as it is: the
    same key and key type, no new request. Renewals keep the key, so a TLSA record stays right."""
    # DNS names are case-insensitive: an eFa 5 host may carry its name in capitals (hostname -f, myhostname).
    name = ((args.domain or '').strip() or _postconf('myhostname')).lower().rstrip('.')
    if not DOMAIN_RE.match(name):
        raise EfaError('Invalid domain.')
    lineage = _letsencrypt_lineage(name)
    problem = _letsencrypt_problem(name, lineage)
    if problem:
        raise EfaError(f"Let's Encrypt certificate {lineage} not taken over: {problem}. Nothing changed; a new one: efactl letsencrypt-set.")
    renewal, live = f'{ETC}/letsencrypt/renewal/{lineage}.conf', f'{ETC}/letsencrypt/live/{lineage}'
    with open(renewal) as f:
        before = f.read()
    with open(live + '/cert.pem', 'rb') as f:
        names = certificate_names(f.read())
    after = renewal_takeover(before, names)
    # nginx first: if it rejects the certificate, nothing else has changed.
    _nginx_certificate(f'{live}/fullchain.pem', f'{live}/privkey.pem')
    if after != before:
        shutil.copy2(renewal, renewal + '.efa-takeover.bak')
        _write(renewal, after)
    _postconf_set('smtpd_tls_key_file', f'{live}/privkey.pem')
    _postconf_set('smtpd_tls_cert_file', f'{live}/fullchain.pem')
    _write(ETC + '/cron.d/certbotrenew', CERTBOT_RENEW_CRON)
    _json_write(ACME_FILE, {'domain': name, 'lineage': lineage, 'taken_over': True}, mode=0o644)
    _platform().file_labels(ETC + '/letsencrypt')
    for unit in ('nginx', 'postfix'):
        _platform().service_reload_if_active(unit)
    _audit(f"Let's Encrypt certificate {lineage} taken over as it is (key kept, renewals keep it) by {_dmarc_who()}")
    return {'letsencrypt': name, 'lineage': lineage, 'key_kept': True}


def letsencrypt_takeover_notices():
    """A migrated host with a valid Let's Encrypt certificate that eFa-next does not use yet: nothing switches by itself."""
    if os.path.exists(ACME_FILE) or not os.path.isdir(ETC + '/letsencrypt/live'):
        return []
    name = _postconf('myhostname').lower()
    lineage = _letsencrypt_lineage(name)
    if _letsencrypt_problem(name, lineage, chain=False):
        return []
    return [_text("A Let's Encrypt certificate for {name} is on this host, nginx does not use it yet. Take it over as it is (same key, "
                  'a TLSA record stays right): efactl letsencrypt-takeover (DNS and certificate).', name=name)]


# 2026-11-20: efa-migrate brings all of /etc/letsencrypt over, the takeover rewrites one lineage. certbot renew runs the
# updaters of every lineage: one more of eFa 5 with "installer = apache" (its plugin went with eFa 5) failed every renewal run.
RENEWAL_FOREIGN = ('apache', 'nginx', 'standalone')


def renewal_foreign_plugin(text):
    """'authenticator = apache' or the like when renewal settings still name a plugin eFa-next does not renew with, else ''."""
    found = re.search(r'^((?:authenticator|installer)\s*=\s*(' + '|'.join(RENEWAL_FOREIGN) + r'))\s*$', text, re.M)
    return found.group(1) if found else ''


def letsencrypt_heal(_args=None):
    """Every lineage whose renewal settings name a plugin of eFa 5 renews through the webroot of nginx, its key kept (as the
    takeover); a copy of each changed file stays beside it (.efa-heal.bak)."""
    healed, skipped = [], []
    for path in sorted(glob.glob(f'{ETC}/letsencrypt/renewal/*.conf')):
        with open(path) as f:
            before = f.read()
        if not renewal_foreign_plugin(before):
            continue
        lineage = os.path.basename(path)[:-len('.conf')]
        try:
            with open(f'{ETC}/letsencrypt/live/{lineage}/cert.pem', 'rb') as f:
                names = certificate_names(f.read())
            after = renewal_takeover(before, names) if names else None
        except (OSError, ValueError, EfaError) as err:
            skipped.append(f'{lineage}: {str(err)[:100]}')
            continue
        if after is None:
            skipped.append(f'{lineage}: the certificate names no host')
            continue
        shutil.copy2(path, path + '.efa-heal.bak')
        _write(path, after)
        healed.append(lineage)
    if healed:
        _platform().file_labels(ETC + '/letsencrypt')
        _audit(f"Let's Encrypt renewal settings of eFa 5 healed (webroot of nginx, key kept): {', '.join(healed)} by {_dmarc_who()}")
    return {'healed': healed, 'skipped': skipped}


def letsencrypt_heal_findings():
    """The lineages whose renewal settings still name a plugin of eFa 5, for the check after a package change."""
    found = []
    for path in sorted(glob.glob(f'{ETC}/letsencrypt/renewal/*.conf')):
        with open(path) as f:
            plugin = renewal_foreign_plugin(f.read())
        if plugin:
            found.append(f"{path}: {plugin} of eFa 5, every certbot renew fails; fix: efactl letsencrypt-heal")
    return found


# cron has no continuation lines: a line ending in a backslash runs cut there (a clamscan of eFa 5 scanned a file named "\").
CRON_GONE = re.compile(r'\b(httpd|apachectl|MailScanner|mailwatch|sqlgrey)\b')


def cron_findings(lines, exists=os.path.exists):
    """Cron lines (source, line) that cannot run as meant: continued with a backslash, a program that is not there, or a
    program of eFa 5 that the migration removed. source 'crontab root' has no user field, a file of /etc/cron.d has one."""
    found = []
    for source, line in lines:
        text = line.strip()
        if not text or text.startswith('#') or re.match(r'^[A-Za-z_]\w*\s*=', text):
            continue
        fields = text.split()
        at = (1 if fields[0].startswith('@') else 5) + (0 if source == 'crontab root' else 1)
        command = fields[at] if len(fields) > at else ''
        if text.endswith('\\'):
            why = 'ends with a backslash; cron has no continuation lines and runs it cut there'
        elif command.startswith('/') and not exists(command):
            why = f'{command} does not exist'
        elif CRON_GONE.search(' '.join(fields[at:])):
            why = 'calls software of eFa 5 that is gone'
        else:
            continue
        found.append(f'{source}: cron line {why}: {text[:160]}')
    return found


def _cron_lines():
    """The lines of root's crontab and of /etc/cron.d, as (source, line)."""
    lines = []
    if shutil.which('crontab'):
        done = subprocess.run(['crontab', '-l'], capture_output=True, text=True, timeout=30)
        lines += [('crontab root', line) for line in done.stdout.splitlines()] if done.returncode == 0 else []
    for path in sorted(path for path in glob.glob(ETC + '/cron.d/*') if os.path.isfile(path)):
        lines += [(path, line) for line in _read_lines(path)]
    return lines


def tls_report_warnings(rows, minimum=10, share=1.0):
    """P8: own domains whose TLS reports of the last days show failed sessions: at least minimum, and share percent of all."""
    found = []
    for row in rows:
        success, failure = int(row['success'] or 0), int(row['failure'] or 0)
        if failure >= minimum and failure * 100.0 >= share * (success + failure):
            found.append(_text('TLS reports: {failure} of {total} sessions to {domain} failed in 7 days (TLS reports received).', failure=failure,
                               total=success + failure, domain=row['domain']))
    return found


def _tls_report_notices():
    if not _json_read(REPORTS_FILE_IN, {}).get('enabled'):
        return []
    try:
        return tls_report_warnings(_admin_query('SELECT domain, SUM(success) AS success, SUM(failure) AS failure FROM tls_rpt '
                                                'WHERE begin_ts >= NOW() - INTERVAL 7 DAY GROUP BY domain'))
    except Exception:  # no database yet
        return []

# 9p, MTA-STS: eFa-next only writes the policy of each domain and checks it; the domain serves it on its own web server at
# https://mta-sts.<domain>/.well-known/mta-sts.txt. Up to 6.0.0.4 nginx of eFa-next served it: mta-sts-unserve takes that away.
MTA_STS_FILE = ETC + '/eFa/mta-sts.json'
MTA_STS_STATE = '/var/lib/eFa/mta-sts-check.json'
MTA_STS_OLD_DIR = '/var/www/efa-mta-sts'
MTA_STS_OLD_NGINX = ETC + '/nginx/conf.d/efa-mta-sts.conf'
MTA_STS_MODES = ('testing', 'enforce', 'none')
MTA_STS_LIMIT = 65536
MTA_STS_UNSERVED = '/var/lib/eFa/mta-sts-unserved'


def mta_sts_policy(mode, mx, max_age):
    """The policy file of RFC 8461."""
    return 'version: STSv1\n' + f'mode: {mode}\n' + ''.join(f'mx: {host}\n' for host in mx) + f'max_age: {max_age}\n'


def mta_sts_records(domain, policy_id, report_address):
    """What to publish in DNS for one domain: the policy ID, and where TLS reports go. The policy host is the own web server."""
    records = [f'_mta-sts.{domain}. IN TXT "v=STSv1; id={policy_id}"']
    if report_address:
        records.append(f'_smtp._tls.{domain}. IN TXT "v=TLSRPTv1; rua=mailto:{report_address}"')
    return records


def mta_sts_parse(text):
    """{'version', 'mode', 'mx': [...], 'max_age'} of a policy, or ValueError: RFC 8461, 3.2."""
    found = {'mx': []}
    for line in text.splitlines():
        key, sep, value = line.partition(':')
        if not sep:
            if line.strip():
                raise ValueError(f'line without a key: {line[:60]}')
            continue
        key, value = key.strip(), value.strip()
        if key == 'mx':
            found['mx'].append(value.lower().rstrip('.'))
        elif key in ('version', 'mode', 'max_age') and key not in found:
            found[key] = value
    if found.get('version') != 'STSv1':
        raise ValueError('version is not STSv1')
    if found.get('mode') not in MTA_STS_MODES:
        raise ValueError('mode is not testing, enforce or none')
    if not str(found.get('max_age', '')).isdigit() or int(found['max_age']) > 31557600:
        raise ValueError('max_age is no number up to one year')
    if found['mode'] != 'none' and not found['mx']:
        raise ValueError('no mx line')
    found['max_age'] = int(found['max_age'])
    return found


def mta_sts_matches(pattern, host):
    """An mx pattern of a policy: the name itself, or *.example.org for exactly one label in front."""
    pattern, host = pattern.lower().rstrip('.'), host.lower().rstrip('.')
    if pattern.startswith('*.'):
        return host.endswith(pattern[1:]) and '.' not in host[:-len(pattern) + 1]
    return host == pattern


def mta_sts_problems(domain, item, fetched, txt_lines, real_mx, own_host):
    """What does not fit for a domain: the policy as served against the one written here, against the real MX and this host,
    and the TXT record with its id. fetched: the text, or the error of the fetch."""
    problems = []
    if not isinstance(fetched, str) or fetched.startswith('error: '):
        problems.append(f'{domain}: policy not reachable at https://mta-sts.{domain}/.well-known/mta-sts.txt ({str(fetched)[7:][:120]})')
        policy = None
    else:
        try:
            policy = mta_sts_parse(fetched)
        except ValueError as err:
            problems.append(f'{domain}: the policy served is not valid: {err}')
            policy = None
    wanted = mta_sts_policy(item['mode'], item['mx'], item['max_age'])
    if policy is not None:
        if fetched.replace('\r\n', '\n').strip() != wanted.strip():
            problems.append(f'{domain}: the policy served differs from the one written here (Protection, MTA-STS): publish it again and change the id')
        if policy['mode'] == 'enforce':
            missing = [host for host in real_mx if not any(mta_sts_matches(pattern, host) for pattern in policy['mx'])]
            if missing:
                problems.append(f"{domain}: enforce, but the MX {', '.join(missing)} is not in the policy: mail to it fails")
    if own_host and own_host in real_mx and not any(mta_sts_matches(pattern, own_host) for pattern in item['mx']):
        problems.append(f'{domain}: this server ({own_host}) is an MX but not in the policy')
    ids = [match.group(1) for line in txt_lines or [] for match in [re.search(r'v=STSv1;\s*id=([A-Za-z0-9]{1,32})', ''.join(re.findall(r'"([^"]*)"', line)) or line)] if match]
    if not ids:
        problems.append(f'{domain}: no TXT record _mta-sts.{domain} with v=STSv1 and an id')
    elif item['id'] not in ids:
        problems.append(f"{domain}: the TXT record _mta-sts.{domain} has the id {ids[0]}, the policy written here {item['id']}: publish the new id")
    return problems


def _mta_sts_fetch(domain):
    """The policy as a sending server would get it: HTTPS with a full certificate check, no redirect, 5 s, at most 64 KB."""
    host = f'mta-sts.{domain}'
    connection = http.client.HTTPSConnection(host, 443, timeout=5, context=ssl.create_default_context())
    try:
        connection.request('GET', '/.well-known/mta-sts.txt', headers={'User-Agent': 'eFa-next', 'Host': host})
        reply = connection.getresponse()
        if reply.status != 200:
            return f'error: HTTP {reply.status} (no redirects allowed)'
        if not reply.getheader('Content-Type', '').startswith('text/plain'):
            return 'error: Content-Type is not text/plain'
        data = reply.read(MTA_STS_LIMIT + 1)
        if len(data) > MTA_STS_LIMIT:
            return 'error: larger than 64 KB'
        return data.decode('utf-8', 'replace')
    except ssl.SSLCertVerificationError as err:
        return f"error: certificate: {'expired' if 'expired' in str(err) else err.verify_message or err}"
    except (OSError, http.client.HTTPException) as err:
        return f'error: {str(err)[:120]}'
    finally:
        connection.close()


def _dns_mx(name):
    try:
        done = subprocess.run(['dig', '+time=3', '+tries=1', '+short', 'MX', name, '@127.0.0.1'], capture_output=True, text=True, timeout=15)
    except subprocess.TimeoutExpired:
        return []
    return sorted({line.split()[-1].lower().rstrip('.') for line in done.stdout.splitlines() if len(line.split()) == 2})


def mta_sts_check(_args=None):
    """Checks each domain with a policy: fetched from its public address only, the MX and TXT from DNS. Daily and on demand."""
    state, own_host = _json_read(MTA_STS_FILE, {}), _postconf('myhostname').lower()
    results = {}
    for domain, item in sorted(state.items()):
        problems = mta_sts_problems(domain, item, _mta_sts_fetch(domain), _dns_txt('127.0.0.1', f'_mta-sts.{domain}'), _dns_mx(domain), own_host)
        results[domain] = problems
    _json_write(MTA_STS_STATE, {'checked': time.strftime('%Y-%m-%d %H:%M'), 'domains': results}, mode=0o644)
    return {'checked': len(results), 'problems': [problem for problems in results.values() for problem in problems]}


def mta_sts_notices():
    """The dashboard: what the last check found, and the note after the update that nginx serves the policy no more."""
    found = [_text('MTA-STS: {problem}', problem=problem) for problems in _json_read(MTA_STS_STATE, {}).get('domains', {}).values()
             for problem in problems][:5]
    if os.path.exists(MTA_STS_UNSERVED) and time.time() - os.stat(MTA_STS_UNSERVED).st_mtime < 30 * 86400:
        found.append(_text('eFa-next no longer serves the MTA-STS policy. Put the text from Protection, MTA-STS on your own web server at '
                           'https://mta-sts.<domain>/.well-known/mta-sts.txt before the policy cached by senders runs out (max_age).'))
    return found


def mta_sts_unserve(_args=None):
    """Update from 6.0.0.4: the nginx server of the policies and their files go; the policies stay and are shown to copy."""
    if not os.path.exists(MTA_STS_OLD_NGINX) and not os.path.isdir(MTA_STS_OLD_DIR):
        return {'removed': False}
    before = open(MTA_STS_OLD_NGINX).read() if os.path.exists(MTA_STS_OLD_NGINX) else None
    if before is not None:
        os.remove(MTA_STS_OLD_NGINX)
        if subprocess.run(['nginx', '-t'], capture_output=True).returncode != 0:
            _write(MTA_STS_OLD_NGINX, before)
            raise EfaError('nginx refused the config without the MTA-STS server, it stays as it was.')
        _platform().service_reload_if_active('nginx')
    shutil.rmtree(MTA_STS_OLD_DIR, ignore_errors=True)
    _write(MTA_STS_UNSERVED, time.strftime('%Y-%m-%d %H:%M\n'))
    _audit('MTA-STS: the policies are no longer served by nginx of eFa-next (9p); they stay to copy')
    return {'removed': True}


def mta_sts_show(_args):
    """MTA-STS of each domain: the policy to put on the own web server, the DNS records, and the result of the last check."""
    state, checked = _json_read(MTA_STS_FILE, {}), _json_read(MTA_STS_STATE, {})
    own_reports = _json_read(REPORTS_FILE_IN, {})
    reports = own_reports.get('address', '') if own_reports.get('enabled') else ''
    rows = []
    for domain, item in sorted(state.items()):
        if identity_now and identity_now['domains'] is not None and domain not in identity_now['domains']:
            continue
        rows.append({'domain': domain, 'mode': item['mode'], 'mx': ' '.join(item['mx']), 'max_age': item['max_age'], 'id': item['id'],
                     'policy': mta_sts_policy(item['mode'], item['mx'], item['max_age']), 'url': f'https://mta-sts.{domain}/.well-known/mta-sts.txt',
                     'records': mta_sts_records(domain, item['id'], reports), 'problems': checked.get('domains', {}).get(domain, ['not checked yet'])})
    return {'domains': rows, 'checked': checked.get('checked', 'never'),
            'note': 'Serve each policy as text/plain with a valid certificate for mta-sts.<domain>, without redirects. Change the id in DNS '
                    'whenever the policy changes.'}


def mta_sts_text(args):
    """The policy of one domain as the file mta-sts.txt, to download."""
    domain = (args.domain or '').strip().lower()
    item = _json_read(MTA_STS_FILE, {}).get(domain)
    if item is None or identity_now and identity_now['domains'] is not None and domain not in identity_now['domains']:
        raise EfaError('No MTA-STS policy for this domain.')
    return {'text': mta_sts_policy(item['mode'], item['mx'], item['max_age']), 'name': 'mta-sts.txt'}


def mta_sts_set(args):
    """The MTA-STS policy of a domain: testing first, then enforce. remove takes it away. The MX are those of the domain."""
    domain = args.domain.strip().lower()
    if not DOMAIN_RE.match(domain):
        raise EfaError('Invalid domain.')
    if identity_now and identity_now['domains'] is not None and domain not in identity_now['domains']:
        raise EfaError('Not allowed: name one of your own domains.')
    state = _json_read(MTA_STS_FILE, {})
    mode = args.mode.strip()
    if mode == 'remove':
        state.pop(domain, None)
    else:
        if mode not in MTA_STS_MODES:
            raise EfaError('Mode: testing, enforce, none or remove.')
        mx = [item.strip().lower().rstrip('.') for item in (args.mx or '').replace(',', ' ').split()] or _dns_mx(domain) or [_postconf('myhostname').lower()]
        if any(not re.fullmatch(r'(\*\.)?([a-z0-9-]+\.)+[a-z]{2,}', item) for item in mx):
            raise EfaError('MX names like mx.example.org, or *.example.org.')
        max_age = (args.max_age or '').strip() or '604800'
        if not max_age.isdigit() or not 86400 <= int(max_age) <= 31557600:
            raise EfaError('max_age: one day (86400) to one year (31557600) in seconds.')
        old = state.get(domain)
        item = {'mode': mode, 'mx': mx, 'max_age': int(max_age)}
        # A new id only when the policy changes: senders fetch it again only then.
        same = old and {key: old[key] for key in item} == item
        state[domain] = {**item, 'id': old['id'] if same else time.strftime('%Y%m%d%H%M%S')}
    _json_write(MTA_STS_FILE, state, mode=0o644)
    _audit(f'MTA-STS of {domain} set to {mode} by {_dmarc_who()}')
    return mta_sts_show(None)


def dmarc_reports_set(args):
    """Send DMARC reports to the addresses domains publish. Needs Redis and outgoing mail."""
    enabled = _on_off(args.mode)
    text = open(DMARC_CONF).read() if os.path.exists(DMARC_CONF) else ''
    text = re.sub(r'reporting \{.*?\n\}\n?', '', text, flags=re.S)
    if enabled:
        domain, email, org = (args.domain or '').strip().lower(), (args.email or '').strip().lower(), (args.org or '').strip()
        if not DOMAIN_RE.match(domain):
            raise EfaError('Invalid domain.')
        if not SENDER_RE.match(email):
            raise EfaError('Invalid email address.')
        if not ORG_RE.match(org):
            raise EfaError('Organization: up to 64 letters, digits or spaces.')
        text += (f'reporting {{\n  enabled = true;\n  email = "{email}";\n  domain = "{domain}";\n'
                 f'  org_name = "{org}";\n  smtp = "127.0.0.1";\n}}\n')
    _write(DMARC_CONF, text)
    done = subprocess.run(['rspamadm', 'configtest'], capture_output=True, text=True)
    if done.returncode != 0:
        raise EfaError('rspamd rejected the setting: ' + (done.stdout + done.stderr)[-200:])
    _reload_rspamd()
    if enabled:
        _write(DMARC_CRON, '0 3 * * * root /usr/bin/rspamadm dmarc_report yesterday >/dev/null 2>&1\n')
    elif os.path.exists(DMARC_CRON):
        os.remove(DMARC_CRON)
    return {'dmarc_reports': enabled}


def admin_password(args):
    """Set the web admin password; only from the CLI, the web cannot change it. Always asked twice, against typing errors:
    on a terminal, or as two lines on stdin."""
    from werkzeug.security import generate_password_hash
    password = password_twice('New password')
    if password_problem(password, 'admin'):
        raise EfaError(password_problem(password, 'admin'))
    _admin_password_write(password)
    return {'admin_password': 'set'}


def _admin_password_write(password):
    from werkzeug.security import generate_password_hash
    os.makedirs(WEB_DIR, mode=0o750, exist_ok=True)
    shutil.chown(WEB_DIR, 'root', 'efa-web')
    fd, tmp = tempfile.mkstemp(dir=WEB_DIR)
    with os.fdopen(fd, 'w') as f:
        f.write(generate_password_hash(password, method='pbkdf2:sha256:600000'))
    shutil.chown(tmp, 'root', 'efa-websecret')  # S37: not efa-web, the group the mail services have for their files
    os.chmod(tmp, 0o640)
    os.replace(tmp, PASSWORD_FILE)


def _sane_state():
    state = _json_read(SANE_FILE, {})
    state.setdefault('enabled', True)
    state.setdefault('files', {})
    for key in ('last_check', 'last_change', 'errors', 'signatures'):
        state.setdefault(key, None)
    return state


def _sane_fetch(connection, name, target, known):
    """Conditional download. Returns the new (etag, modified), or None if the file did not change."""
    headers = {'User-Agent': 'eFa-next'}
    if known.get('etag'):
        headers['If-None-Match'] = known['etag']
    if known.get('modified'):
        headers['If-Modified-Since'] = known['modified']
    connection.request('GET', SANE_PATH + name, headers=headers)
    reply = connection.getresponse()
    if reply.status == 304:
        reply.read()
        return None
    if reply.status != 200:
        reply.read()
        raise OSError(f'HTTP {reply.status}')
    with open(target, 'wb') as out:
        shutil.copyfileobj(reply, out)
    return {'etag': reply.headers.get('ETag'), 'modified': reply.headers.get('Last-Modified')}


def _sane_verified(work, name):
    """The file must carry a good Sanesecurity signature, and clamd must be able to load it."""
    urllib.request.urlretrieve(f'https://{SANE_HOST}{SANE_PATH}{name}.sig', f'{work}/{name}.sig')
    home = work + '/gnupg'
    if not os.path.isdir(home):
        os.mkdir(home, 0o700)
        subprocess.run(['gpg', '-q', '--batch', '--homedir', home, '--import'], input=SANE_KEY, text=True, capture_output=True, check=True)
    done = subprocess.run(['gpg', '--batch', '--homedir', home, '--trust-model', 'always', '--status-fd', '1', '--verify',
                           f'{work}/{name}.sig', f'{work}/{name}'], capture_output=True, text=True)
    if done.returncode != 0 or SANE_FINGERPRINT not in done.stdout:
        return 'bad signature'
    empty = work + '/empty'
    open(empty, 'w').close()
    done = subprocess.run(['clamscan', '--quiet', '--no-summary', f'--database={work}/{name}', empty], capture_output=True, text=True, timeout=300)
    return f'clamscan refused it: {done.stderr.strip()[:100]}' if done.returncode != 0 else None


def _sane_reload():
    subprocess.run(['clamdscan', f'--config-file={ETC}/clamd.d/scan.conf', '--reload'], capture_output=True, check=False)


def _sane_count():
    total = 0
    for name in SANE_DBS:
        try:
            with open(f'{SANE_DB_DIR}/{name}', 'rb') as f:
                total += sum(chunk.count(b'\n') for chunk in iter(lambda: f.read(65536), b''))
        except FileNotFoundError:
            pass
    return total


def _sane_clean_old():
    """Once after the move from clamav-unofficial-sigs: its other feeds no longer update and would only cost memory."""
    if not os.path.isdir(SANE_OLD_DIR):
        return False
    names = {os.path.basename(path) for path in glob.glob(SANE_OLD_DIR + '/dbs-*/*')} - set(SANE_DBS)
    for name in names:
        if os.path.exists(f'{SANE_DB_DIR}/{name}'):
            os.remove(f'{SANE_DB_DIR}/{name}')
    shutil.rmtree(SANE_OLD_DIR)
    return bool(names)


def sanesecurity_run(_args):
    """Job every 2 hours: fetch what changed, verify and test it, and reload clamd only if something changed."""
    _safe(freshclam_follow, '')
    if sync_mode('sanesecurity') == 'node':
        # 6.0.0.6: a cluster node does not download; the master hands on its checked files (cluster-sync-apply).
        return {'changed': [], 'errors': [], 'from_master': True}
    state, errors, changed = _sane_state(), [], []
    removed = _sane_clean_old()
    if not state['enabled']:
        for name in SANE_DBS:
            if os.path.exists(f'{SANE_DB_DIR}/{name}'):
                os.remove(f'{SANE_DB_DIR}/{name}')
                removed = True
        state['files'] = {}
    else:
        # One connection for all files: most runs only learn that nothing changed.
        connection = http.client.HTTPSConnection(SANE_HOST, timeout=60)
        with tempfile.TemporaryDirectory() as work:
            for name in SANE_DBS:
                known = state['files'].get(name, {}) if os.path.exists(f'{SANE_DB_DIR}/{name}') else {}
                try:
                    new = _sane_fetch(connection, name, f'{work}/{name}', known)
                    if new is None:
                        continue
                    problem = _sane_verified(work, name)
                except (OSError, http.client.HTTPException, subprocess.SubprocessError) as err:
                    connection.close()
                    problem = str(err)[:100]
                    new = None
                if problem:
                    errors.append(f'{name}: {problem}')
                    continue
                # A dot name in the same folder: clamd skips it, and the replace is atomic.
                temp = f'{SANE_DB_DIR}/.{name}.new'
                shutil.copyfile(f'{work}/{name}', temp)
                os.chmod(temp, 0o644)
                shutil.chown(temp, 'clamupdate', 'clamupdate')
                os.replace(temp, f'{SANE_DB_DIR}/{name}')
                state['files'][name] = new
                changed.append(name)
    extra_changed, extra_errors = clam_sources_run(state)
    changed += extra_changed
    errors += extra_errors
    if changed or removed:
        _sane_reload()
        state['signatures'] = _sane_count()
        state['last_change'] = datetime.datetime.now().isoformat(timespec='seconds')
    state['last_check'] = datetime.datetime.now().isoformat(timespec='seconds')
    if cluster_role() == 'master':
        try:
            sync_publish('clamav', bool(changed or removed))
        except (OSError, ValueError) as err:
            errors.append(f'cluster: the nodes were not told: {str(err)[:100]}')
    state['errors'] = errors
    _json_write(SANE_FILE, state)
    return {'changed': changed, 'errors': errors}


def sanesecurity_status(_args):
    """State of the Sanesecurity signatures."""
    state = _sane_state()
    if cluster_role() == 'client':
        # A node: the state in effect is what the master handed on; the page shows it as a text, not as raw values.
        received = sync_received('clamav')[0]
        return {'active': state['enabled'] and bool(received), 'warnings': sync_notices(['clamav']) if state['enabled'] else []}
    return {'active': state['enabled'], 'last_check': state['last_check'], 'last_change': state['last_change'],
            'signatures': state['signatures'], 'errors': state['errors'] or [], 'databases': ', '.join(SANE_DBS),
            'terms': SANE_TERMS}


def sanesecurity_set(args):
    """Turn the Sanesecurity signatures on or off. The change applies at the next job, started now."""
    state = _sane_state()
    state['enabled'] = _on_off(args.mode)
    _json_write(SANE_FILE, state)
    sanesecurity_update(args)
    return {'sanesecurity': state['enabled']}


def sanesecurity_update(_args):
    """Start the job in the background: downloads and tests take longer than a page load."""
    subprocess.run(['systemctl', 'start', '--no-block', 'efa-sanesecurity.service'], capture_output=True, check=False)
    return {'started': True}


# 5v (a): more ClamAV signatures, in the job of the Sanesecurity signatures. Each source off by default and on only with its terms
# confirmed; each file over HTTPS, fetched only when it changed, loaded by clamscan before it counts, and kept as efa-<source>-<file>.
CLAM_SOURCES = {
    'urlhaus': {'name': 'URLhaus (abuse.ch, Switzerland)', 'base': 'https://urlhaus.abuse.ch/downloads/', 'files': ('urlhaus.ndb',),
                'terms': 'abuse.ch, free of charge (CC0); the links of malware that URLhaus knows.', 'id': False,
                'terms_url': 'https://abuse.ch/terms-of-use/'},
    'interserver': {'name': 'InterServer (USA)', 'base': 'https://sigs.interserver.net/', 'files': ('interserver256.hdb', 'interservertopline.db', 'shell.ldb'),
                    'terms': 'InterServer, free of charge; hashes of malware and web shells seen on its hosting.', 'id': False,
                    'terms_url': ''},
    'securiteinfo': {'name': 'SecuriteInfo (France)', 'base': 'https://www.securiteinfo.com/get/signatures/{id}/',
                     'files': ('securiteinfo.hdb', 'securiteinfophish.hdb', 'javascript.ndb', 'securiteinfohtml.hdb', 'securiteinfoascii.hdb'),
                     'terms': 'SecuriteInfo; needs an own account ID; the free one is limited and lags behind the paid one.', 'id': True,
                     'terms_url': 'https://www.securiteinfo.com/legal/conditions-generales-de-vente.shtml'},
}
CLAM_SOURCE_MAX = 200 * 1024 * 1024


def clam_source_url(name, source, account=''):
    return source['base'].format(id=account) + name


# 6.0.0.6: what the account tier of SecuriteInfo allows, enforced by the job: at most one round of downloads per interval (the
# time is written before the first request, so a crash, a restart or a manual run cannot ask sooner) and at most rate bytes
# per second. A new tier is one more line.
SI_TIERS = {'basic': {'name': 'Basic', 'interval': 1800, 'rate': 300 * 1000}}
SI_TIER_DEFAULT = 'basic'
# The DatabaseCustomURL lines of the setup page of SecuriteInfo hold the subscription key: root only, never shown or logged.
SI_URLS_FILE = ETC + '/eFa/securiteinfo-urls.json'
SI_STAMP = '/var/lib/eFa/securiteinfo-last'
# 6.0.0.6, on a cluster node: what it got from the master, per kind of download ({'clamav': {'at': time, 'files': n}}).
SYNC_RECEIVED = '/var/lib/eFa/cluster-received.json'
SYNC_MANIFEST = '/var/lib/eFa/cluster-manifest.json'
SI_URL_MAX, SI_URL_LEN, SI_BLOCK_MAX = 40, 400, 32768
SI_FILE_RE = r'[A-Za-z0-9][A-Za-z0-9_.-]{0,80}\.(hdb|hsb|ndb|ldb|cdb|mdb|msb|ign2|fp|sfp|wdb|pdb|gdb|yara|yar|ftm|cbc)'


def si_urls_parse(text):
    """The DatabaseCustomURL lines pasted from SecuriteInfo: [[file name, URL]]. Blank lines and # comments are skipped,
    anything else is refused. The errors name the line number, never its text: it holds the key."""
    if len(text) > SI_BLOCK_MAX:
        raise EfaError(f'At most {SI_BLOCK_MAX // 1024} KB of URL lines, nothing changed.')
    found = []
    for number, line in enumerate(text.replace('\r\n', '\n').split('\n'), 1):
        # A copy from a web page brings tabs and no-break spaces.
        line = line.replace('\t', ' ').replace('\xa0', ' ').strip()
        if not line or line.startswith('#'):
            continue
        refused = f'Line {number}: '
        if any(not 32 <= ord(char) < 127 for char in line):
            raise EfaError(refused + 'control or non-ASCII characters, nothing changed.')
        parts = line.split()
        if len(parts) != 2 or parts[0] != 'DatabaseCustomURL':
            raise EfaError(refused + 'only lines "DatabaseCustomURL https://..." are allowed, nothing changed.')
        url = parts[1]
        try:
            split = urllib.parse.urlsplit(url)
            host = split.hostname or ''
        except ValueError:
            raise EfaError(refused + 'not a valid address, nothing changed.')
        name = split.path.rsplit('/', 1)[-1]
        if len(url) > SI_URL_LEN or split.scheme != 'https' or split.netloc.lower() != host or split.query or split.fragment \
                or not re.fullmatch(r'[a-z0-9.-]+', host) or not re.fullmatch(r'/[A-Za-z0-9/._-]+', split.path) or '..' in split.path:
            raise EfaError(refused + f'only https addresses without user, port or query, at most {SI_URL_LEN} characters, nothing changed.')
        if host != 'securiteinfo.com' and not host.endswith('.securiteinfo.com'):
            raise EfaError(refused + 'only addresses of securiteinfo.com, nothing changed.')
        if not re.fullmatch(SI_FILE_RE, name):
            raise EfaError(refused + 'the address does not end in a ClamAV database file, nothing changed.')
        if name in {item[0] for item in found}:
            raise EfaError(refused + f'{name} comes twice, nothing changed.')
        found.append([name, url])
    if not found:
        raise EfaError('No line "DatabaseCustomURL https://...", nothing changed.')
    if len(found) > SI_URL_MAX:
        raise EfaError(f'At most {SI_URL_MAX} URLs, nothing changed.')
    return found


def _si_urls():
    """The stored URLs; the file names checked again, they become file names under /var/lib/clamav."""
    return [item for item in _json_read(SI_URLS_FILE, {}).get('urls', []) if re.fullmatch(SI_FILE_RE, item[0])]


def _si_tier(item):
    return item.get('tier') if item.get('tier') in SI_TIERS else SI_TIER_DEFAULT


def _si_last():
    try:
        with open(SI_STAMP) as f:
            return float(f.read(64))
    except (OSError, ValueError):
        return None


def si_turn(interval, now=None):
    """True when SecuriteInfo may be asked now. Then the time is written first; a second run at the same moment (lock held)
    or within the interval gets False. A damaged time counts as now."""
    now = time.time() if now is None else now
    os.makedirs(os.path.dirname(SI_STAMP), exist_ok=True)
    fd = os.open(SI_STAMP, os.O_RDWR | os.O_CREAT, 0o600)
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            return False
        raw = os.read(fd, 64)
        try:
            last, damaged = (float(raw) if raw else 0.0), False
        except ValueError:
            last, damaged = now, True
        # abs: a clock set back by less than the interval does not open the way either.
        allowed = abs(now - last) >= interval
        if allowed or damaged:
            os.lseek(fd, 0, os.SEEK_SET)
            os.ftruncate(fd, 0)
            os.write(fd, f'{now:.0f}'.encode())
            os.fsync(fd)
        return allowed
    finally:
        os.close(fd)


def rate_read(reply, limit, rate, clock=time.monotonic, sleep=time.sleep):
    """At most limit + 1 bytes, read no faster than rate bytes per second on average. Reading slower makes TCP slow the sender
    down; only the first block of the receive buffer can come faster."""
    data, start = bytearray(), clock()
    while len(data) <= limit:
        block = reply.read(min(16384, limit + 1 - len(data)))
        if not block:
            break
        data += block
        ahead = len(data) / rate - (clock() - start)
        if ahead > 0:
            sleep(ahead)
    return bytes(data)


def _clam_files(key, source, item):
    """[[file name, URL]] of a source: for SecuriteInfo the pasted URLs if there are any, else the account ID."""
    if key == 'securiteinfo':
        urls = _si_urls()
        if urls:
            return urls
    return [[name, clam_source_url(name, source, item.get('id', ''))] for name in source['files']]


def _clam_fetch(url, target, known, rate=None):
    """Conditional download; the new (etag, modified), or None when the file did not change."""
    headers = {'User-Agent': 'eFa-next'}
    if known.get('etag'):
        headers['If-None-Match'] = known['etag']
    if known.get('modified'):
        headers['If-Modified-Since'] = known['modified']
    try:
        with urllib.request.urlopen(urllib.request.Request(url, headers=headers), timeout=120) as reply:
            data = rate_read(reply, CLAM_SOURCE_MAX, rate) if rate else reply.read(CLAM_SOURCE_MAX + 1)
            info = {'etag': reply.headers.get('ETag'), 'modified': reply.headers.get('Last-Modified')}
    except urllib.error.HTTPError as err:
        if err.code == 304:
            return None
        raise OSError(f'HTTP {err.code}')
    if len(data) > CLAM_SOURCE_MAX:
        raise OSError('larger than 200 MB')
    with open(target, 'wb') as f:
        f.write(data)
    return info


def _clam_loads(path):
    empty = path + '.empty'
    open(empty, 'w').close()
    try:
        done = subprocess.run(['clamscan', '--quiet', '--no-summary', f'--database={path}', empty], capture_output=True, text=True, timeout=300)
    finally:
        os.remove(empty)
    return None if done.returncode == 0 else f'clamscan refused it: {done.stderr.strip()[:100]}'


def clam_sources_run(state):
    """The extra sources of the state: fetch what changed, check, install; remove the files of a source that is off."""
    changed, errors = [], []
    extra = state.setdefault('extra', {})
    for key, source in CLAM_SOURCES.items():
        item = extra.get(key, {})
        extra[key] = item
        if (source.get('id') or item.get('id')) and cluster_role() == 'client':
            continue  # 6.0.0.6: a node has no key and never asks a source with an account (SecuriteInfo); its files come from the master
        files = _clam_files(key, source, item) if item.get('enabled') else []
        # Off, or a file no longer in the pasted URLs: away with it.
        for path in sorted(glob.glob(f'{SANE_DB_DIR}/efa-{key}-*')):
            name = os.path.basename(path)[len(f'efa-{key}-'):]
            if name not in {file[0] for file in files}:
                os.remove(path)
                item.get('files', {}).pop(name, None)
                changed.append(f'{key}/{name} removed')
        if not files:
            continue
        rate = None
        if key == 'securiteinfo':
            tier = SI_TIERS[_si_tier(item)]
            if not si_turn(tier['interval']):
                continue
            rate = tier['rate']
        for name, url in files:
            target = f'{SANE_DB_DIR}/efa-{key}-{name}'
            with tempfile.TemporaryDirectory() as work:
                try:
                    new = _clam_fetch(url, f'{work}/{name}', item.get('files', {}).get(name, {}) if os.path.exists(target) else {}, rate)
                    problem = _clam_loads(f'{work}/{name}') if new is not None else None
                except (OSError, subprocess.SubprocessError) as err:
                    new, problem = None, str(err)[:100]
                if problem:
                    errors.append(f'{key}/{name}: {problem}')
                    continue
                if new is None:
                    continue
                temp = f'{SANE_DB_DIR}/.efa-{key}-{name}.new'
                shutil.copyfile(f'{work}/{name}', temp)
                os.chmod(temp, 0o644)
                _safe(lambda: shutil.chown(temp, 'clamupdate', 'clamupdate'), None)
                os.replace(temp, target)
                item.setdefault('files', {})[name] = new
                changed.append(f'{key}/{name}')
    return changed, errors


def clam_source_set(args):
    """5v (a): a source of extra ClamAV signatures on (its terms confirmed) or off."""
    key = (args.source or '').strip()
    if key not in CLAM_SOURCES:
        raise EfaError('Source: ' + ', '.join(CLAM_SOURCES) + '.')
    state = _sane_state()
    item = state.setdefault('extra', {}).setdefault(key, {})
    id_changed = False
    if _on_off(args.mode):
        # Terms once: a source switched off and on again, or a new account ID, needs no new consent.
        if not item.get('accepted') and (args.accept_terms or '').strip() != 'yes':
            raise EfaError(f"Confirm the terms of {CLAM_SOURCES[key]['name']}: {CLAM_SOURCES[key]['terms']} Type yes.")
        if CLAM_SOURCES[key]['id'] and cluster_role() == 'client':
            # 6.0.0.6: a node keeps no key; an old journal entry may still bring one on stdin: read and dropped.
            if not sys.stdin.isatty():
                _secrets(1, '')
            id_changed = bool(item.pop('id', None))
        elif CLAM_SOURCES[key]['id']:
            given = _secrets(1, 'Account ID of SecuriteInfo')[0].strip()
            account = given or item.get('id', '')
            # 6.0.0.6: the pasted DatabaseCustomURL lines hold the key too; with them the ID may stay empty.
            if not (account == '' and _si_urls()) and not re.fullmatch(r'[A-Za-z0-9]{16,200}', account):
                raise EfaError('The account ID of SecuriteInfo (letters and digits), or its DatabaseCustomURL lines.')
            id_changed = account != item.get('id', '')
            item['id'] = account
        if not item.get('accepted'):
            item['accepted'] = {'by': _dmarc_who(), 'at': time.strftime('%Y-%m-%d %H:%M')}
        item['enabled'] = True
    else:
        item['enabled'] = False
    _json_write(SANE_FILE, state)
    _audit(f"extra ClamAV signatures {key} {'on' if item['enabled'] else 'off'}{' (new account ID)' if id_changed and item.get('id') else ''}"
           f"{' (account ID removed)' if id_changed and not item.get('id') else ''} by {_dmarc_who()}")
    sanesecurity_update(args)
    return clam_source_status(None)


def clam_source_status(_args):
    """5v (a): the extra sources of ClamAV signatures and their state (never the account ID, never the URLs)."""
    extra = _sane_state().get('extra', {})
    rows = [{'source': key, 'name': source['name'], 'terms': source['terms'], 'active': bool(extra.get(key, {}).get('enabled')),
             'accepted': extra.get(key, {}).get('accepted'), 'files': list(source['files']),
             'terms_accepted': bool(extra.get(key, {}).get('accepted')), 'terms_url': source['terms_url'],
             'needs_id': source['id'], 'id_set': bool(extra.get(key, {}).get('id'))} for key, source in CLAM_SOURCES.items()]
    for row in rows:
        if row['source'] == 'securiteinfo':
            # 6.0.0.6: the tier in effect, how many URLs are stored (their file names only) and when SecuriteInfo was last asked.
            urls, tier, last = _si_urls(), _si_tier(extra.get('securiteinfo', {})), _si_last()
            # On a node: set on the master; the signatures come from there (until the first transfer: waiting for the master).
            row.update(cluster=cluster_role(), tier=tier, tiers=[[name, item['name'], item['interval'] // 60, item['rate'] // 1000] for name, item in SI_TIERS.items()],
                       urls=len(urls), files=[item[0] for item in urls] or row['files'],
                       last_contact=time.strftime('%Y-%m-%d %H:%M', time.localtime(last)) if last else '')
            if row['cluster'] == 'client':
                row.update(urls=0, last_contact='')
        if cluster_role() == 'client':
            # Never "on" without the checked files of the master: until then "waiting for the master".
            received = sync_received('clamav')[0]
            row.update(cluster='client', received=received, waiting=row['active'] and not received, active=row['active'] and bool(received))
    return {'sources': rows}


def clam_securiteinfo_set(args):
    """6.0.0.6: the account tier of SecuriteInfo and the DatabaseCustomURL lines of its setup page. The lines come on stdin and
    hold the subscription key: stored for root alone (0600), never shown, never in the audit log or an error."""
    if cluster_role() == 'client':
        raise EfaError('In a cluster the account tier and the URLs of SecuriteInfo are set on the master; this node gets the signatures from it.')
    tier = (args.tier or '').strip()
    if tier not in SI_TIERS:
        raise EfaError('Account tier: ' + ', '.join(SI_TIERS) + '.')
    delete = (args.delete_urls or '').strip()
    if delete not in ('', 'yes'):
        raise EfaError('Delete the URLs: yes, or empty.')
    text = _si_block()
    if text.strip() and delete:
        raise EfaError('New URL lines or delete them, not both; nothing changed.')
    state = _sane_state()
    item = state.setdefault('extra', {}).setdefault('securiteinfo', {})
    done = []
    if text.strip():
        urls = si_urls_parse(text)
        _json_write(SI_URLS_FILE, {'urls': urls}, mode=0o600)
        done.append(f'{len(urls)} URLs stored')
    elif delete and os.path.exists(SI_URLS_FILE):
        os.remove(SI_URLS_FILE)
        done.append('URLs deleted')
    if _si_tier(item) != tier or 'tier' not in item:
        done.append(f'tier {tier}')
    item['tier'] = tier
    _json_write(SANE_FILE, state)
    _audit(f"extra ClamAV signatures securiteinfo: {', '.join(done) or 'nothing changed'} by {_dmarc_who()}")
    if done and item.get('enabled'):
        sanesecurity_update(args)
    return clam_source_status(None)


# 6.0.0.6: download-only data in a cluster. Only the master downloads (its jobs work as on a single host). After each round it
# lists the files of the kind with size and SHA-256 in its manifest and notes the change in the journal; the nodes take the
# journal within half a minute and fetch what they lack over the mutual TLS of the cluster (efa-cluster, GET /v1/file). A node
# checks size, SHA-256 and the kind (clamscan must load a ClamAV file) before it swaps a file in, and keeps the old one when
# anything fails. More kinds: one entry here and one folder in efa_cluster.SYNC_DIRS.
SYNC_KINDS = {
    'clamav': {'dir': lambda: SANE_DB_DIR, 'owner': 'clamupdate', 'mode': 0o644,
               'name': lambda name: name in SANE_DBS or bool(re.fullmatch(r'efa-(?:' + '|'.join(CLAM_SOURCES) + r')-[A-Za-z0-9][A-Za-z0-9_.-]{0,100}', name))
               or bool(re.fullmatch(CLAM_OFFICIAL, name)),
               # An official database goes only when the master has it in the other form (daily.cvd becomes daily.cld).
               'keep': lambda name, items: bool(re.fullmatch(CLAM_OFFICIAL, name)) and not {name[:-3] + 'cvd', name[:-3] + 'cld'} & set(items),
               'check': lambda path: _clam_loads(path), 'after': lambda: _sane_reload(), 'used': lambda: _sane_used()},
    'rspamd': {'dir': lambda: RSPAMD_DIR, 'owner': '', 'mode': 0o644, 'name': lambda name: name == os.path.basename(RDAP_MAP),
               'check': lambda path: _sync_json(path, 100), 'after': lambda: None,
               'used': lambda: bec_state()['enabled'] and bool(bec_state()['scores']['young_domain'])},
    'maps': {'dir': lambda: RSPAMD_DIR + '/maps.d', 'owner': '', 'mode': 0o644,
             'name': lambda name: name in {os.path.basename(path) for path in FEED_MAPS.values()} | {os.path.basename(LOOKALIKE_MAP)},
             'check': lambda path: _sync_lines(path), 'after': lambda: None,
             'used': lambda: any(item.get('enabled') for item in _feeds()['feeds'].values()) or lookalike_settings()['enabled']},
    'state': {'dir': lambda: os.path.dirname(LOOKALIKE_STATE), 'owner': '', 'mode': 0o644,
              'name': lambda name: name in {os.path.basename(LOOKALIKE_STATE), os.path.basename(EUVD_FILE)},
              'check': lambda path: _sync_json(path, 0), 'after': lambda: None,
              'used': lambda: lookalike_settings()['enabled'] or cve_settings()['mode'] == 'on'},
    # The firewall stays on each host: a node loads the lists of the master into its own table efa_block (one nft transaction).
    'blocklists': {'dir': lambda: BLOCKLIST_DIR, 'owner': '', 'mode': 0o644, 'name': lambda name: bool(re.fullmatch(r'[a-z][a-z0-9-]{0,23}\.txt', name)),
                   'check': lambda path: _sync_networks(path), 'after': lambda: _sync_blocklist_load(),
                   'used': lambda: any(entry.get('enabled') and entry.get('url') for entry in _blocklist_state()['lists'].values())},
}
# The sources behind the kinds. A node whose master has been out of reach longer than the grace of a source downloads it
# itself, with the same code as the master; never a source with an account, a key or a limit (they stay on the master: the
# node keeps its last checked files). Grace: twice the interval of the source, at least two hours.
SYNC_SOURCES = {
    'sanesecurity': {'kind': 'clamav', 'grace': 4 * 3600, 'public': True},
    'urlhaus': {'kind': 'clamav', 'grace': 4 * 3600, 'public': True},
    'interserver': {'kind': 'clamav', 'grace': 4 * 3600, 'public': True},
    'securiteinfo': {'kind': 'clamav', 'grace': 0, 'public': False},
    'rdap': {'kind': 'rspamd', 'grace': 2 * 86400, 'public': True},
    'lookalike': {'kind': 'maps', 'grace': 2 * 86400, 'public': True},
    'feeds': {'kind': 'maps', 'grace': 2 * 3600, 'public': True},  # without the feeds of kind stix and misp: they may need a key
    'euvd': {'kind': 'state', 'grace': 2 * 3600, 'public': True},
    'blocklists': {'kind': 'blocklists', 'grace': 2 * 3600, 'public': True},
    'freshclam': {'kind': 'clamav', 'grace': 4 * 3600, 'public': True},
}
# The official databases of ClamAV (freshclam): on a node from the master, freshclam stopped while the master answers.
CLAM_OFFICIAL = r'(?:main|daily|bytecode)\.c[lv]d'
FRESHCLAM_OFF = '/var/lib/eFa/freshclam-off-in-cluster'


def freshclam_follow(mode=None):
    """A node with a master that answers: freshclam stopped and disabled (marked, so only eFa-next turns it on again). Single
    host, master, or a node in fallback: freshclam on again, but only if eFa-next turned it off."""
    mode = mode or sync_mode('freshclam')
    platform_now, unit = _platform(), _platform().service('avupdate')
    if mode == 'node' and platform_now.service_is_enabled(unit):
        platform_now.service_disable(unit, stop=True)
        open(FRESHCLAM_OFF, 'w').close()
        _audit('cluster: freshclam stopped on this node; the official ClamAV databases come from the master')
        return 'off'
    if mode != 'node' and os.path.exists(FRESHCLAM_OFF):
        platform_now.service_enable(unit, start=True)
        os.remove(FRESHCLAM_OFF)
        _audit(f'cluster: freshclam on again on this host ({mode})')
        return 'on'
    return ''
EUVD_FILE = '/var/lib/eFa/euvd.json'


def _sane_used():
    state = _sane_state()
    return bool(state.get('enabled') or any(item.get('enabled') for item in state.get('extra', {}).values()))


def _sync_json(path, minimum):
    try:
        with open(path) as f:
            data = json.load(f)
    except (OSError, ValueError):
        return 'not JSON'
    return None if isinstance(data, dict) and len(data) >= minimum else 'not the expected content'


def _sync_lines(path):
    """A map of rspamd: lines of printable text, none longer than 4 KB."""
    with open(path, 'rb') as f:
        for number, line in enumerate(f, 1):
            if len(line) > 4096 or re.search(rb'[\x00-\x08\x0b\x0c\x0e-\x1f\x7f]', line):
                return f'line {number}: not a line of a map'
    return None


def _sync_networks(path):
    """A list of the master: addresses and networks only, all public, within the size of a feed."""
    lib = _lib('efa_blocklist')
    if os.path.getsize(path) > lib.MAX_FEED_BYTES:
        return 'too large'
    with open(path, encoding='utf-8', errors='replace') as f:
        nets, skipped = lib.parse_entries(f.read())
    return None if nets and not skipped else 'not a list of public networks'


def _sync_blocklist_load():
    with _firewall_lock(30):
        _blocklist_load(_blocklist_state())


def _master_down_since():
    return _lib('efa_cluster').read_state(ETC).get('master_down_since') if os.path.exists(os.path.join(ETC, 'eFa', 'cluster')) else None


def sync_mode(source, now=None):
    """How this host gets a source: 'single' (no cluster), 'master', 'node' (the files of the master) or 'fallback' (a node
    whose master is out of reach longer than the grace of a public source: it downloads that one itself). Audited when a
    node starts and ends downloading itself."""
    role = cluster_role()
    if role != 'client':
        return 'master' if role == 'master' else 'single'
    since, now = _master_down_since(), time.time() if now is None else now
    received = _json_read(SYNC_RECEIVED, {})
    if not since and received.get('fallback'):
        received.pop('fallback')
        _json_write(SYNC_RECEIVED, received, mode=0o644)
        _audit('cluster: the master is reachable again; this node takes the downloads from it again')
    if since and SYNC_SOURCES[source]['public'] and now - since > SYNC_SOURCES[source]['grace']:
        if not received.get('fallback'):
            received['fallback'] = {'since': since}
            _json_write(SYNC_RECEIVED, received, mode=0o644)
            _audit(f"cluster: the master is not reachable since {time.strftime('%Y-%m-%d %H:%M', time.localtime(since))}; "
                   'this node downloads the public sources itself')
        return 'fallback'
    return 'node'


def _sync_names(kind):
    folder = SYNC_KINDS[kind]['dir']()
    if not os.path.isdir(folder):
        return []
    return [name for name in sorted(os.listdir(folder)) if SYNC_KINDS[kind]['name'](name) and '..' not in name
            and not os.path.islink(os.path.join(folder, name)) and os.path.isfile(os.path.join(folder, name))]


def sync_publish(kind, changed):
    """On the master after a round: the manifest of the kind (a file hashed again only when its size or time changed) and, when
    something changed, an entry in the journal. Only names, sizes and hashes: no address, no key. True if the nodes were told."""
    if cluster_role() != 'master':
        return False
    manifest = _json_read(SYNC_MANIFEST, {})
    old = manifest.get('kinds', {}).get(kind, {})
    items = {}
    for name in _sync_names(kind):
        info = os.stat(os.path.join(SYNC_KINDS[kind]['dir'](), name))
        known = old.get(name, {})
        items[name] = known if (known.get('size'), known.get('mtime')) == (info.st_size, info.st_mtime_ns) else \
            {'size': info.st_size, 'mtime': info.st_mtime_ns, 'sha256': _file_sha256(os.path.join(SYNC_KINDS[kind]['dir'](), name))}
    if items == old and not changed and kind in manifest.get('kinds', {}):
        return False
    manifest.setdefault('kinds', {})[kind] = items
    manifest['time'] = int(time.time())
    _json_write(SYNC_MANIFEST, manifest, mode=0o600)
    cluster, base, _state = _cluster_parts()
    cluster.journal_append(base, [{'type': 'command', 'command': 'cluster-sync-apply', 'args': {'kind': kind}, 'secrets': []}])
    return True


def cluster_sync_apply(args):
    """On a node: the files of a kind as the manifest of the master lists them. A file is fetched only when its hash differs,
    and swapped in only after size, SHA-256 and the check of its kind; a failed one keeps the old file. Files the master no
    longer lists go. The time of the last complete transfer is what the pages show."""
    kind = (getattr(args, 'kind', '') or '').strip()
    if kind not in SYNC_KINDS:
        raise EfaError('Kind: ' + ', '.join(SYNC_KINDS) + '.')
    if cluster_role() != 'client':
        return {'kind': kind, 'skipped': 'not a cluster node'}
    os.makedirs(os.path.dirname(SYNC_RECEIVED), exist_ok=True)
    with open(SYNC_RECEIVED + f'.{kind}.lock', 'a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)  # an entry of the journal and the pull at the start: one after the other
        return _cluster_sync_kind(kind)


def cluster_sync_pull(_args):
    """A node: every kind from the master (after its start, after the master was away, while a transfer failed)."""
    if cluster_role() != 'client':
        return {'skipped': 'not a cluster node'}
    _safe(freshclam_follow, '')
    done = {kind: cluster_sync_apply(argparse.Namespace(kind=kind)) for kind in SYNC_KINDS}
    _safe(lookalike_handover, 0)
    return done


def cluster_sync_publish(_args):
    """The master: the manifest of every kind anew; the nodes are told of a kind that changed."""
    return {kind: sync_publish(kind, False) for kind in SYNC_KINDS} if cluster_role() == 'master' else {'skipped': 'not the master'}


def _cluster_sync_kind(kind):
    spec, (cluster, base, state) = SYNC_KINDS[kind], _cluster_parts()
    master, folder = state['master'], SYNC_KINDS[kind]['dir']()
    os.makedirs(folder, mode=0o750, exist_ok=True)
    received = _json_read(SYNC_RECEIVED, {})
    mine = received.get(kind, {})
    now = time.strftime('%Y-%m-%d %H:%M')
    changed, errors = [], []
    try:
        manifest = cluster.call(base, master['host'], master['port'], '/v1/manifest', timeout=30)
        items = manifest.get('kinds', {}).get(kind)
        if isinstance(manifest.get('nodes'), list):
            received['nodes'] = sorted(str(name) for name in manifest['nodes'])[:100]
        if isinstance(manifest.get('peers'), dict):  # 6.0.0.6.7: for the fallback of the updates, which peer updates now
            received['peers'] = {str(name): {'host': str(peer.get('host', ''))[:255], 'port': int(peer.get('port', 0)),
                                             'fingerprint': str(peer.get('fingerprint', ''))[:128]}
                                 for name, peer in list(manifest['peers'].items())[:100] if isinstance(peer, dict) and str(peer.get('port', '')).isdigit()}
    except (OSError, ValueError, AttributeError) as err:
        items, errors = None, [f'manifest of the master: {str(err)[:100]}']
    if items is not None and not isinstance(items, dict):
        items, errors = None, ['manifest of the master: not readable']
    if items is None and not errors:
        errors = ['the master has no files of this kind yet']
    for name, meta in sorted((items or {}).items()):
        if not (isinstance(name, str) and spec['name'](name) and '..' not in name and isinstance(meta, dict) and isinstance(meta.get('size'), int)
                and 0 <= meta['size'] <= cluster.SYNC_MAX and re.fullmatch(r'[0-9a-f]{64}', str(meta.get('sha256', '')))):
            errors.append(f'{str(name)[:60]}: refused entry of the manifest')
            continue
        target = os.path.join(folder, name)
        if os.path.isfile(target) and not os.path.islink(target) and _file_sha256(target) == meta['sha256']:
            continue
        with tempfile.TemporaryDirectory() as work:
            got = os.path.join(work, name)
            try:
                size, digest = cluster.fetch_file(base, master['host'], master['port'], '/v1/file?' + urllib.parse.urlencode({'kind': kind, 'name': name}),
                                                  got, meta['size'])
                problem = None if (size, digest) == (meta['size'], meta['sha256']) else 'size or SHA-256 differ from the manifest'
                problem = problem or spec['check'](got)
            except (OSError, ValueError, subprocess.SubprocessError, http.client.HTTPException) as err:
                problem = str(err)[:100]
            if problem:
                errors.append(f'{name}: {problem}')
                continue
            temp = os.path.join(folder, f'.{name}.sync')
            shutil.copyfile(got, temp)
            os.chmod(temp, spec['mode'])
            _safe(lambda: shutil.chown(temp, spec['owner'], spec['owner']), None)
            os.replace(temp, target)
            changed.append(name)
    if items is not None:
        for name in _sync_names(kind):
            if name not in items and not spec.get('keep', lambda *_: False)(name, items):
                os.remove(os.path.join(folder, name))
                changed.append(f'{name} removed')
    if changed:
        try:
            spec['after']()
        except (EfaError, OSError, subprocess.SubprocessError) as err:  # the files are checked; what was loaded before stays
            errors.append(f'load: {str(err)[:100]}')
    received[kind] = {'at': mine.get('at', '') if errors else now, 'checked': now, 'files': len(items or {}), 'errors': errors[:20]}
    _json_write(SYNC_RECEIVED, received, mode=0o644)
    return {'kind': kind, 'changed': changed, 'errors': errors}


def sync_received(kind):
    """On a node: when the files of the kind last came complete from the master ('' = not yet), and the errors since."""
    item = _json_read(SYNC_RECEIVED, {}).get(kind, {})
    return item.get('at', ''), item.get('errors', [])


def sync_notices(kinds=None):
    """A node: the data the master has not handed on yet, a failed last transfer, or that it downloads itself for now."""
    if cluster_role() != 'client':
        return []
    found = []
    fallback = _json_read(SYNC_RECEIVED, {}).get('fallback')
    if fallback:
        found.append(_text('Master not reachable since {since}: this node downloads the public sources itself.',
                           since=time.strftime('%Y-%m-%d %H:%M', time.localtime(fallback['since']))))
    for kind in kinds or SYNC_KINDS:
        if not _safe(SYNC_KINDS[kind]['used'], False):
            continue
        at, errors = sync_received(kind)
        if not at:
            found.append(_sync_texts(kind)[0])
        elif errors:
            found.append(_sync_texts(kind, errors[0][:80], at)[1])
    return found


def _sync_texts(kind, error='', at=''):
    """Waiting, failed: one whole sentence per kind, so each is translated as a whole."""
    return {'clamav': (_text('ClamAV signatures: waiting for the master; this cluster node does not download them itself.'),
                       _text('ClamAV signatures from the master: the last transfer failed ({error}); the files of {at} stay in use.', error=error, at=at)),
            'rspamd': (_text('RDAP list: waiting for the master; this cluster node does not download it itself.'),
                       _text('RDAP list from the master: the last transfer failed ({error}); the list of {at} stays in use.', error=error, at=at)),
            'maps': (_text('Threat feeds and lookalike domains: waiting for the master; this cluster node does not download them itself.'),
                     _text('Threat feeds and lookalike domains from the master: the last transfer failed ({error}); the lists of {at} stay in use.', error=error, at=at)),
            'state': (_text('EUVD and lookalike watch: waiting for the master; this cluster node does not download them itself.'),
                      _text('EUVD and lookalike watch from the master: the last transfer failed ({error}); the data of {at} stays in use.', error=error, at=at)),
            'blocklists': (_text('IP blocklists: waiting for the master; this cluster node does not download them itself.'),
                           _text('IP blocklists from the master: the last transfer failed ({error}); the lists of {at} stay loaded.', error=error, at=at))}[kind]


def sync_card(kind):
    """The note of a card on a node: waiting, or when the files last came from the master."""
    if cluster_role() != 'client':
        return {}
    at = sync_received(kind)[0]
    return {'warnings': sync_notices([kind]) or [_text('From the master, last received {at}.', at=at)]}


def sane_without_secrets(state):
    """The settings of the signatures as a node may get them: without the account ID of SecuriteInfo."""
    state = json.loads(json.dumps(state))
    state.get('extra', {}).get('securiteinfo', {}).pop('id', None)
    return state


def cluster_secret_scrub(_args):
    """6.0.0.6, on upgrade: the key of SecuriteInfo out of the cluster. The master takes the secrets out of old journal entries
    (account ID, URL lines), a node drops what such entries left it. The journal stays in order and readable."""
    role, removed = cluster_role(), 0
    if role == 'master':
        removed = _lib('efa_cluster').journal_redact(_cluster_parts()[1], CLUSTER_SECRET_COMMANDS)
    elif role == 'client':
        state = _sane_state()
        if state.get('extra', {}).get('securiteinfo', {}).get('id'):
            _json_write(SANE_FILE, sane_without_secrets(state))
            removed += 1
        if os.path.exists(SI_URLS_FILE):
            os.remove(SI_URLS_FILE)
            removed += 1
        for path in glob.glob(FEEDS_DIR + '/*.key'):  # API keys of threat feeds stay on the master
            os.remove(path)
            removed += 1
    if removed:
        _audit(f"cluster: secrets of SecuriteInfo and threat feeds removed from {removed} {'journal entries' if role == 'master' else 'files'} on this {role}")
    return {'role': role, 'removed': removed, 'keys': cluster_keys_scrub(role)}


# INS-3: up to 6.0.0.6 the snapshot of the master carried its signing keys to every node (backups, offline bundles, audit
# anchors). Once per host: a node drops these copies (it makes its own at the next use), the master names its keys for renewal.
CLUSTER_KEYS_MARK = '/var/lib/eFa/cluster-keys-checked'


def cluster_keys_scrub(role):
    if role not in ('master', 'client') or os.path.exists(CLUSTER_KEYS_MARK):
        return []
    found = []
    if role == 'client':
        for path in (BACKUP_SIGN_KEY, OFFLINE_KEY, ANCHOR_KEY, ANCHOR_PUB):
            if os.path.exists(path):
                os.remove(path)
                found.append(os.path.basename(path))
        if found:
            _audit(f"cluster: copies of the keys of the master removed from this node: {', '.join(found)}; it makes its own at the next use")
    _json_write(CLUSTER_KEYS_MARK, {'role': role, 'at': time.strftime('%Y-%m-%d %H:%M:%S')}, mode=0o644)
    return found


def cluster_keys_notices():
    """On a master of a cluster of before: its signing keys went to the nodes; the hint stays until each one is new."""
    mark = _json_read(CLUSTER_KEYS_MARK, {})
    if mark.get('role') != 'master':
        return []
    since = os.stat(CLUSTER_KEYS_MARK).st_mtime
    old = [os.path.basename(path) for path in (BACKUP_SIGN_KEY, OFFLINE_KEY, ANCHOR_KEY) if os.path.exists(path) and os.stat(path).st_mtime <= since]
    return [_text('Up to 6.0.0.6 the nodes of the cluster got copies of the signing keys of this master: renew {keys}. Note the '
                  'fingerprint (Backup & restore, signing key), then move the files out of /etc/eFa: the next use makes new ones. '
                  'Older backups are restored with that fingerprint (signer).', keys=', '.join(old))] if old else []


def _si_block():
    """The pasted lines. A secret is one line on stdin: the web sends them in base64; a console asks line by line up to an
    empty one and journals them as one base64 line too, so a cluster node reads the same."""
    if not sys.stdin.isatty():
        value = _secrets(1, '')[0].strip()
        try:
            return base64.b64decode(value, validate=True).decode('utf-8') if value else ''
        except (ValueError, UnicodeDecodeError):
            raise EfaError('The URL lines must come in base64, nothing changed.')
    lines, start = [], len(SECRETS_SEEN)
    while len(lines) <= SI_URL_MAX * 2:
        line = _secrets(1, 'DatabaseCustomURL line, an empty line ends')[0]
        if not line.strip():
            break
        lines.append(line)
    del SECRETS_SEEN[start:]
    text = '\n'.join(lines)
    SECRETS_SEEN.append(base64.b64encode(text.encode()).decode() if text else '')
    return text

def _rbl_state():
    state = _json_read(RBL_FILE, {})
    state.setdefault('lists', {})
    state.setdefault('custom', {})
    return state


def _rbl_on(state, preset):
    return state['lists'].get(preset['id'], {}).get('enabled', preset['on'])


def _rbl_quote(symbol, score, description=''):
    return f'  "{symbol}" {{ weight = {score:g}; description = "{description}"; }}\n'


def _rbl_rule(name, symbol, zone, kind, codes=None):
    checks = RBL_TYPES[kind]
    # Without a list of codes every real listing counts, but no error answer such as 127.0.0.1 or 127.255.255.254.
    wanted = '[' + ', '.join(f'"{code}"' for code in codes) + ']' if codes else f'"{RBL_LISTED}"'
    matcher = '' if codes else 'returncodes_matcher = "regexp"; '
    return (f'  {name} {{ enabled = true; rbl = "{zone}"; {checks} unknown = false; {matcher}'
            f'returncodes {{ {symbol} = {wanted}; }} }}\n')


def _rbl_render(state):
    """The rspamd settings: rbl.conf and rbl_group.conf. Rules rspamd ships keep their own return codes."""
    rules, scores = '', ''
    for preset in RBL_PRESETS:
        saved = state['lists'].get(preset['id'], {})
        on = _rbl_on(state, preset)
        score = saved.get('score', preset.get('score'))
        if 'zone' in preset:
            symbol = preset['symbols'][0]
            rules += _rbl_rule(preset['id'], symbol, preset['zone'], preset['type']) if on else f"  {preset['id']} {{ enabled = false; }}\n"
        else:
            for rule, dqs in preset['rules'].items():
                zone = f' rbl = "{saved["key"]}.{dqs}";' if on and dqs and saved.get('key') else ''
                rules += f"  {rule} {{ enabled = {'true' if on else 'false'};{zone} }}\n"
        if score is not None:
            scores += ''.join(_rbl_quote(symbol, score, preset['name']) for symbol in preset['symbols'])
    for name, item in state['custom'].items():
        symbol = f"EFA_RBL_{name.upper().replace('-', '_')}"
        rules += _rbl_rule(f"efa_custom_{name.replace('-', '_')}", symbol, item['zone'], item['type'], item.get('codes')) if item.get('enabled', True) \
            else f"  efa_custom_{name.replace('-', '_')} {{ enabled = false; }}\n"
        scores += _rbl_quote(symbol, item['score'], name)
    return f'rbls {{\n{rules}}}\n', f'symbols {{\n{scores}}}\n'


def _rbl_apply(state):
    old = {path: open(path).read() if os.path.exists(path) else None for path in (RBL_CONF, RBL_GROUP_CONF)}
    conf, group = _rbl_render(state)
    for path, text in ((RBL_CONF, conf), (RBL_GROUP_CONF, group)):
        _write(path, text)
    # It can hold the Spamhaus key, rspamd alone has to read it.
    os.chmod(RBL_CONF, 0o640)
    _own_key(RBL_CONF)
    if not _rspamd_config_ok():
        for path, text in old.items():
            if text is None:
                os.remove(path)
            else:
                _write(path, text)
        raise EfaError('rspamd refused the new settings, nothing changed.')
    _json_write(RBL_FILE, state)
    _reload_rspamd()


def _rbl_counters():
    """Hits per symbol from rspamd's own statistics, so nothing here asks DNS."""
    done = subprocess.run(['rspamc', 'counters', '-j'], capture_output=True, text=True, check=False)
    try:
        return {item['symbol']: item.get('hits', 0) for item in json.loads(done.stdout)}
    except (ValueError, TypeError, KeyError):
        return {}


def _rbl_hits(counters, symbols):
    # rspamd puts RBL_ or RECEIVED_ in front of some symbols.
    return sum(hits for name, hits in counters.items() if any(name == s or name.endswith('_' + s) for s in symbols))


def _unbound_forwards(text):
    """True if the root zone goes to forwarders: most free lists refuse public resolvers."""
    for block in re.split(r'^\s*forward-zone:', text, flags=re.M)[1:]:
        block = re.split(r'^\s*[a-z-]+:\s*$', block, flags=re.M)[0]
        if re.search(r'^\s*name:\s*"?\."?\s*$', block, re.M) and re.search(r'^\s*forward-(addr|host):', block, re.M):
            return True
    return False


def _rbl_warnings():
    text = ''
    for path in glob.glob(ETC + '/unbound/conf.d/*.conf') + [ETC + '/unbound/unbound.conf', ETC + '/unbound/efa-forward.conf']:
        try:
            with open(path) as f:
                text += f.read() + '\n'
        except OSError:
            pass
    return [RBL_FORWARD_WARNING] if _unbound_forwards(text) else []


def spamhaus_hints(counters):
    """5v (i): what the error codes of Spamhaus mean: 127.255.255.254 a public or open resolver, 127.255.255.255 too many queries
    (127.255.255.252 a wrong list name is never sent by eFa-next)."""
    hints = []
    if _rbl_hits(counters, ('SPAMHAUS_BLOCKED_OPENRESOLVER', 'DBL_BLOCKED_OPENRESOLVER')):
        hints.append(_text('Spamhaus answers 127.255.255.254: the query came through a public or open resolver. Let Unbound of eFa-next ask the '
                           'root servers itself (no forwarders), or enter a free Spamhaus DQS key (Blocklists).'))
    if _rbl_hits(counters, ('SPAMHAUS_BLOCKED', 'DBL_BLOCKED')):
        hints.append(_text('Spamhaus answers 127.255.255.255: too many queries for the free use. A Spamhaus DQS key (Blocklists) lifts the '
                           'limit; its free tier is for low volume and non-commercial use.'))
    return hints


def rbl_show(_args):
    """Blocklists, their hits and errors since rspamd started."""
    state, counters = _rbl_state(), _rbl_counters()
    rows = []
    for preset in RBL_PRESETS:
        saved = state['lists'].get(preset['id'], {})
        rows.append({'id': preset['id'], 'list': preset['name'], 'type': preset['type'], 'active': _rbl_on(state, preset),
                     'score': saved.get('score', preset.get('score', 'rspamd default')),
                     'hits': _rbl_hits(counters, preset['symbols']), 'errors': _rbl_hits(counters, preset.get('blocked', ())),
                     'terms': preset['terms'], 'url': preset['url'], 'terms_url': RBL_TERMS.get(preset['id']) or preset['url'],
                     'terms_published': bool(RBL_TERMS.get(preset['id'])), 'accepted': _rbl_accepted_text(state, preset['id']),
                     'terms_accepted': rbl_accepted(state, preset['id']), 'dqs': preset['id'] in RBL_DQS_LISTS,
                     'key_set': bool(saved.get('key'))})
    for name, item in state['custom'].items():
        rows.append({'id': name, 'list': f"Custom: {item['zone']}", 'type': item['type'], 'active': item.get('enabled', True),
                     'score': item['score'], 'hits': _rbl_hits(counters, (f"EFA_RBL_{name.upper().replace('-', '_')}",)), 'errors': 0,
                     'terms': 'Your own list. Check its terms yourself.', 'url': item.get('website', ''), 'terms_url': item.get('website', ''),
                     'terms_published': False, 'accepted': _rbl_accepted_text(state, name), 'terms_accepted': rbl_accepted(state, name),
                     'dqs': False, 'key_set': False})
    errors = [row['id'] for row in rows if row['errors']]
    warnings = _rbl_warnings() + ([f"These lists answered with an error code, so they do not filter: {', '.join(errors)}. "
                                   'Most often the provider refuses the resolver.'] if errors else [])
    warnings += spamhaus_hints(counters)
    if any(row['active'] and row['id'] in RBL_DQS_LISTS and not state['lists'].get(row['id'], {}).get('key') for row in rows):
        warnings.append(RBL_DQS_WARNING)
    unconfirmed = [row['list'] for row in rows if row['active'] and not rbl_accepted(state, row['id'])]
    if unconfirmed:
        warnings.append(_text('Terms of use not yet confirmed for these active blocklists: {names}. Switch each on again with the confirmation of '
                              'its terms.', names=', '.join(unconfirmed)))
    return {'warnings': warnings, 'lists': rows}


def _rbl_accepted_text(state, name):
    item = rbl_accepted(state, name)
    return f"accepted by {item['by']} on {item['at']}" if item else 'terms not yet confirmed'


def _rbl_score(text):
    try:
        score = float(text)
    except ValueError:
        raise EfaError('Score must be a number.')
    if not -50 <= score <= 50:
        raise EfaError('Score must be from -50 to 50.')
    return score


def rbl_set(args):
    """Switch a list on or off, change its score, or store the Spamhaus DQS key."""
    state, name = _rbl_state(), args.id.strip()
    presets = {preset['id']: preset for preset in RBL_PRESETS}
    if name in state['custom']:
        entry = state['custom'][name]
    elif name in presets:
        entry = state['lists'].setdefault(name, {})
    else:
        raise EfaError('Unknown list.')
    entry['enabled'] = _on_off(args.mode)
    if entry['enabled']:
        _rbl_accept(state, name, args, presets[name]['name'] if name in presets else name)
    if args.score.strip():
        entry['score'] = _rbl_score(args.score.strip())
    if args.key.strip():
        if name not in RBL_DQS_LISTS or not re.fullmatch(r'[a-z0-9]{10,64}', args.key.strip()):
            raise EfaError('A DQS key is only for the Spamhaus lists: 10 to 64 small letters or digits.')
        entry['key'] = args.key.strip()
    _rbl_apply(state)
    return {'id': name, 'active': entry['enabled']}


def _secret_in_file(path, key, in_use, what):
    """remove(item) of a secret in a root-only settings file: refused while the feature that needs it is on."""
    def remove(_item):
        if in_use():
            raise EfaError(f'{what} is in use: switch it off first, or save a new one instead.')
        state = _json_read(path, {})
        if not state.get(key):
            return False
        state.pop(key)
        _json_write(path, state, mode=0o600)
        return True
    return remove


def _dqs_remove(item):
    """The Spamhaus DQS key of one list: without it the list asks the free public mirrors again."""
    state = _rbl_state()
    if item not in RBL_DQS_LISTS:
        raise EfaError('Unknown list.')
    entry = state['lists'].get(item, {})
    if not entry.get('key'):
        return False
    entry.pop('key')
    _rbl_apply(state)
    return True


def _clam_id_remove(item):
    """The account ID of a ClamAV signature source (SecuriteInfo): only while the source is off."""
    state = _sane_state()
    entry = state.get('extra', {}).get(item)
    if item not in CLAM_SOURCES or not CLAM_SOURCES[item]['id']:
        raise EfaError('Unknown source.')
    if entry and entry.get('enabled'):
        raise EfaError('The source is on: switch it off first, or save a new account ID instead.')
    if not entry or not entry.get('id'):
        return False
    entry.pop('id')
    _json_write(SANE_FILE, state)
    return True


# Hans 2026-11-17: next to a secret field the web shows whether one is stored (a yes/no of the read command, never the value or
# a part of it) and can remove it. (command, field) -> remove(item); the setter's own rights apply, every removal is audited.
SECRET_FIELDS = {
    ('otlp-set', 'token'): lambda item: _secret_in_file(OTLP_FILE, 'secret', lambda: otlp_state()['enabled'] and otlp_state()['auth'] != 'none',
                                                        'The token of the OpenTelemetry export')(item),
    ('oidc-set', 'client_secret'): lambda item: _secret_in_file(OIDC_FILE, 'client_secret', lambda: bool(_json_read(OIDC_FILE, {}).get('oidc')),
                                                                'The client secret of single sign-on')(item),
    ('ldap-set', 'bind_password'): lambda item: _secret_in_file(LDAP_FILE, 'bind_password', lambda: bool(_json_read(LDAP_FILE, {}).get('ldap')),
                                                                'The password of the LDAP service account')(item),
    ('sandbox-set', 'token'): lambda item: _secret_in_file(SANDBOX_SERVICE_CONF, 'token', lambda: bool(_json_read(SANDBOX_FILE, {}).get('enabled')),
                                                           'The API token of the sandbox')(item),
    ('rbl-set', 'key'): _dqs_remove,
    ('clam-source-set', 'id'): _clam_id_remove,
    ('tenant-ldap-set', 'bind_password'): lambda item: _tenant_idp_secret('ldap', 'bind_password', item),
    ('tenant-oidc-set', 'client_secret'): lambda item: _tenant_idp_secret('oidc', 'client_secret', item),
    ('feed-set', 'api_key'): lambda item: _feed_key_remove(item),
    ('retro-imap-set', 'password'): lambda item: _secret_in_file(RETRO_IMAP_SECRET, 'password', lambda: retro_settings()['imap']['enabled'],
                                                                  'The password of the IMAP master login')(item),
}


def secret_cell(stored, target, in_use):
    """A stored secret in a list row: stored or not, and the secret-remove target while it can go. Never the value."""
    return {'stored': bool(stored), 'remove': target if stored and not in_use else ''}


def _tenant_idp_secret(kind, key, item):
    """The bind password or client secret of the login directory of one tenant (item: its id), inside the scope only."""
    if not item.isdigit():
        raise EfaError('Unknown tenant.')
    tenant_id = int(item)
    if identity_now and identity_now['tenant_ids'] is not None and tenant_id not in identity_now['tenant_ids']:
        raise EfaError('Not allowed: this tenant is outside your scope.')
    path = _idp_file(kind, tenant_id)
    what = 'The password of the LDAP service account' if kind == 'ldap' else 'The client secret of single sign-on'
    return _secret_in_file(path, key, lambda: bool(_json_read(path, {}).get(kind)), what)(item)


def _feed_key_remove(item):
    """The API key of a STIX or MISP feed: only while the feed is off."""
    feed = _feeds()['feeds'].get(item)
    if not feed or not re.fullmatch(r'[a-z0-9][a-z0-9-]{0,31}', item):
        raise EfaError('No such feed.')
    if feed.get('enabled'):
        raise EfaError('The feed is on: switch it off first, or save a new key instead.')
    path = f'{FEEDS_DIR}/{item}.key'
    if not os.path.exists(path):
        return False
    os.remove(path)
    return True


def secret_remove(args):
    """Removes a stored secret (token, password, key) of a setting: --target 'command field [item]'."""
    parts = (args.target or '').split()
    if len(parts) not in (2, 3) or tuple(parts[:2]) not in SECRET_FIELDS:
        raise EfaError('No stored secret of that name.')
    command, field = parts[:2]
    item = parts[2] if len(parts) == 3 else ''
    if not command_allowed(identity_now, command, True):
        raise EfaError('Not allowed: removing it needs the right to change this setting.')
    removed = SECRET_FIELDS[(command, field)](item)
    if removed:
        _audit(f'stored secret removed: {command} {field}{" " + item if item else ""} by {_dmarc_who()}')
    return {'removed': removed, 'target': ' '.join(parts)}


def https_url(text):
    """An address for a link: only https, so nothing can run in the browser. An empty text stays empty."""
    text = (text or '').strip()
    if not text:
        return ''
    parts = urllib.parse.urlsplit(text)
    if parts.scheme != 'https' or not parts.hostname or parts.username or re.search(r'[\s\x00-\x1f<>"\'\\]', text) or len(text) > 500:
        raise EfaError('Website: a full https:// address, nothing else.')
    return text


def rbl_custom_set(args):
    """Add or remove your own blocklist."""
    state, name, action = _rbl_state(), args.name.strip().lower(), args.action.strip()
    if not re.fullmatch(r'[a-z0-9][a-z0-9-]{0,39}', name) or name in {preset['id'] for preset in RBL_PRESETS}:
        raise EfaError('Name: up to 40 small letters, digits or dashes, not the name of a preset.')
    if args.confirm.strip() != 'yes':
        raise EfaError('Type yes to confirm.')
    if action == 'remove':
        if state['custom'].pop(name, None) is None:
            raise EfaError('Unknown list.')
    elif action == 'add':
        zone, kind = args.zone.strip().lower(), args.type.strip()
        codes = args.codes.replace(',', ' ').split()
        if not DOMAIN_RE.match(zone):
            raise EfaError('Invalid zone name.')
        if kind not in RBL_TYPES:
            raise EfaError('Type must be ' + ', '.join(RBL_TYPES) + '.')
        for code in codes:
            try:
                ipaddress.IPv4Address(code)
            except ValueError:
                raise EfaError(f'Invalid return code: {code}')
        _rbl_accept(state, name, args, zone)
        state['custom'][name] = {'zone': zone, 'type': kind, 'score': _rbl_score(args.score.strip()), 'codes': codes, 'enabled': True,
                                 'website': https_url(args.website)}
    else:
        raise EfaError("Action must be 'add' or 'remove'.")
    _rbl_apply(state)
    return {'name': name, 'action': action}


def _rbl_keep(state, rules):
    """Upgrade or migration: a list that filters now stays on, so filtering never gets weaker. Fresh installs skip this."""
    for preset in RBL_PRESETS:
        if any(rules.get(rule) for rule in preset.get('rules', ())):
            state['lists'].setdefault(preset['id'], {})['enabled'] = True


def rbl_apply(args):
    """Write the rspamd settings from the saved choices."""
    state = _rbl_state()
    if args.keep.strip() == 'yes':
        # What rspamd does without the eFa-next settings is what filtered until now.
        if os.path.exists(RBL_CONF):
            os.remove(RBL_CONF)
        done = subprocess.run(['rspamadm', 'configdump', '-j', 'rbl.rbls'], capture_output=True, text=True, check=True)
        dump = json.loads(done.stdout)
        dump = dump.get('rbl', dump)
        _rbl_keep(state, {name: rule.get('enabled') is not False for name, rule in dump.get('rbls', dump).items()})
    _rbl_apply(state)
    return {'lists': len(RBL_PRESETS) + len(state['custom'])}


def _report_empty():
    return {'counts': {}, 'hours': {}, 'senders': {}, 'recipients': {}, 'sender_domains': {}, 'recipient_domains': {},
            'rejects': {}, 'deferrals': {}, 'bounces': {}, 'tls_in': {}, 'tls_out': {}, 'tls_out_trust': {}, 'queue': 0}


def _report_add(table, key, amount=1):
    table[key] = table.get(key, 0) + amount


def _report_reason(text):
    text = re.sub(r'<[^>]*>|\[[0-9A-Fa-f.:]+\]|\b\d{1,3}(\.\d{1,3}){3}\b', '', text)
    return re.sub(r'\s+', ' ', text).strip(' :;,')[:100] or 'unknown'


def _report_day(month, day, today):
    number = REPORT_MONTHS.index(month) + 1
    # The log has no year. A month ahead of today can only belong to last year.
    return datetime.date(today.year - (number > today.month), number, int(day)).isoformat()


def _report_line(days, pending, line, today):
    """Adds one log line to the daily aggregates."""
    match = REPORT_LINE.match(line)
    if not match:
        return
    month, day, hour, program, text = match.groups()
    if month not in REPORT_MONTHS:
        return
    date = _report_day(month, day, today)
    agg = days.setdefault(date, _report_empty())
    counts, hours = agg['counts'], agg['hours'].setdefault(hour, {})
    tls = REPORT_TLS.match(text)
    if program.endswith('smtpd') and text.startswith('connect from '):
        _report_add(counts, 'connections')
    elif tls:
        trust, way, version, cipher = tls.groups()
        if way == 'from':
            _report_add(counts, 'tls')
            _report_add(agg.setdefault('tls_in', {}), f'{version} {cipher}')
        else:
            _report_add(counts, 'tls_out')
            _report_add(agg.setdefault('tls_out', {}), f'{version} {cipher}')
            _report_add(agg.setdefault('tls_out_trust', {}), trust)
    elif text.startswith('TLS connection established from ') or program.endswith('smtpd') and ' TLS connection established from ' in text:
        _report_add(counts, 'tls')
    elif REPORT_TLS_FAILED.match(text) or ': ' in text and REPORT_TLS_FAILED.match(text.split(': ', 1)[1]):
        _report_add(counts, 'tls_failed_in' if program.endswith('smtpd') else 'tls_failed_out')
    elif program.endswith('cleanup') and ': message-id=' in text:
        _report_add(counts, 'received')
        _report_add(hours, 'received')
    elif ': removed' in text and program.endswith('qmgr'):
        pending.pop(text.split(':')[0], None)
    elif 'reject: ' in text or 'milter-reject: ' in text:
        reject = REPORT_REJECT.search(text)
        if reject:
            _report_add(counts, 'rejected')
            _report_add(hours, 'rejected')
            _report_add(agg['rejects'], _report_reason(reject.group(1)))
    else:
        first = REPORT_FROM.match(text)
        if first and program.endswith('qmgr'):
            queue_id, sender, size = first.groups()
            if queue_id not in pending:
                pending[queue_id] = int(size)
                _report_add(counts, 'bytes_received', int(size))
                _report_add(agg['senders'], sender.lower() or '(bounce)')
                _report_add(agg['sender_domains'], sender.lower().rpartition('@')[2] or '(bounce)')
            return
        done = REPORT_TO.match(text)
        if not done:
            return
        queue_id, recipient, status, reason = done.groups()
        if status == 'sent':
            kind = 'forwarded' if reason.startswith('forwarded as') else 'delivered'
            _report_add(counts, kind)
            if program == 'smtp':
                _report_add(counts, 'smtp_sent')
            _report_add(hours, kind)
            _report_add(counts, 'bytes_delivered', pending.get(queue_id, 0))
            _report_add(agg['recipients'], recipient.lower())
            _report_add(agg['recipient_domains'], recipient.lower().rpartition('@')[2])
        elif status == 'deferred':
            _report_add(counts, 'deferred')
            _report_add(agg['deferrals'], _report_reason(reason))
        elif status == 'bounced':
            _report_add(counts, 'bounced')
            _report_add(agg['bounces'], _report_reason(reason))


def _report_trim(agg):
    for key in ('senders', 'recipients', 'sender_domains', 'recipient_domains', 'rejects', 'deferrals', 'bounces', 'tls_in', 'tls_out', 'tls_out_trust'):
        agg[key] = dict(sorted(agg.get(key, {}).items(), key=lambda item: -item[1])[:REPORT_KEEP])


def _report_queue():
    total = 0
    for name in ('incoming', 'active', 'deferred', 'hold'):
        for _root, _dirs, files in os.walk(f'/var/spool/postfix/{name}'):
            total += len(files)
    return total


def _report_read(day):
    return _json_read(f'{REPORT_DIR}/{day}.json', None)


def _report_merge(dates):
    total = _report_empty()
    for day in dates:
        agg = _report_read(day)
        if not agg:
            continue
        for key, table in agg.items():
            if key == 'queue':
                total['queue'] = table
            elif key == 'hours':
                for hour, values in table.items():
                    for name, amount in values.items():
                        _report_add(total['hours'].setdefault(hour, {}), name, amount)
            else:
                for name, amount in table.items():
                    _report_add(total.setdefault(key, {}), name, amount)
    return total


def _report_top(table):
    return [{'name': name, 'mails': amount} for name, amount in sorted(table.items(), key=lambda item: -item[1])[:REPORT_SHOW]]


def _report_view(total, period):
    counts = total['counts']
    connections = counts.get('connections', 0)
    summary = {name: counts.get(name, 0) for name in ('received', 'delivered', 'forwarded', 'deferred', 'bounced', 'rejected')}
    summary.update({'megabytes_received': round(counts.get('bytes_received', 0) / 1048576, 1),
                    'megabytes_delivered': round(counts.get('bytes_delivered', 0) / 1048576, 1), 'smtp_connections': connections,
                    'tls_share_percent': round(100 * counts.get('tls', 0) / connections) if connections else 0, 'queue_size': total['queue']})
    return {'period': period, 'summary': summary,
            'per_hour': [{'hour': hour, **{name: total['hours'][hour].get(name, 0) for name in ('received', 'delivered', 'rejected')}}
                         for hour in sorted(total['hours'])],
            'top_senders': _report_top(total['senders']), 'top_recipients': _report_top(total['recipients']),
            'top_sender_domains': _report_top(total['sender_domains']), 'top_recipient_domains': _report_top(total['recipient_domains']),
            'reject_reasons': _report_top(total['rejects']), 'deferral_reasons': _report_top(total['deferrals']),
            'bounce_reasons': _report_top(total['bounces'])}


def _report_text(view):
    lines = [f"Mail report for {view['period']}", '']
    lines += [f"{name.replace('_', ' ')}: {value}" for name, value in view['summary'].items()]
    for key in ('top_senders', 'top_recipients', 'reject_reasons', 'deferral_reasons', 'bounce_reasons'):
        lines += ['', key.replace('_', ' ').capitalize()] + [f"{row['mails']:>7}  {row['name']}" for row in view[key]]
    return '\n'.join(lines)


def reports_due(settings_now, state, today):
    """Which reports are due: yesterday once a day, the last 7 days once on a Monday."""
    due = []
    if settings_now.get('daily') and state.get('sent_day') != today.isoformat():
        due.append('day')
    if settings_now.get('weekly') and today.weekday() == 0 and state.get('sent_week') != today.isoformat():
        due.append('week')
    return due


def report_period(period, today):
    if period == 'month':
        return (today - datetime.timedelta(days=30)).isoformat(), (today - datetime.timedelta(days=1)).isoformat()
    if period == 'week':
        return (today - datetime.timedelta(days=7)).isoformat(), (today - datetime.timedelta(days=1)).isoformat()
    if period == 'day':
        day = (today - datetime.timedelta(days=1)).isoformat()
        return day, day
    raise EfaError("Period must be 'day', 'week' or 'month'.")


def report_domains(domains, wanted):
    """The domain filter of a report, within what the reader may see. None: all domains."""
    wanted = (wanted or '').strip().lower()
    if not wanted:
        return domains
    if domains is not None and wanted not in domains:
        raise EfaError('Unknown domain.')
    return [wanted]


def _report_auth(rows):
    """Per sender domain: mails and the results of SPF, DKIM, DMARC and ARC that are not a pass."""
    table = {}
    for row in rows:
        entry = table.setdefault(row['domain'] or '(none)', {'domain': row['domain'] or '(none)', 'mails': 0})
        entry['mails'] += row['n']
        for check in ('spf', 'dkim', 'dmarc', 'arc'):
            result = row[check] or 'none'
            if result != 'pass':
                entry[f'{check}_{result}'] = entry.get(f'{check}_{result}', 0) + row['n']
    return sorted(table.values(), key=lambda entry: -entry['mails'])[:REPORT_TOP]


def _report_signing(rows, keys, rotation):
    """Per own domain: signatures by key type, ARC seals, unsigned mails; key age and the next rotation."""
    kinds = {(key['domain'], key['selector']): key['public'][0] for key in keys if key['public']}
    ages = {}
    for key in keys:
        if key['purpose'] == 'dkim' and key['state'] == 'active' and os.path.exists(key['path']):
            age = int((time.time() - os.path.getmtime(key['path'])) // 86400)
            ages[key['domain']] = max(ages.get(key['domain'], 0), age)
    table = {}
    for row in rows:
        entry = table.setdefault(row['domain'], {'domain': row['domain'], 'rsa': 0, 'ed25519': 0, 'arc': 0, 'unsigned': 0})
        name = row['kind'] if row['kind'] in ('arc', 'unsigned') else kinds.get((row['domain'], row['selector']), 'rsa')
        entry[name] = entry.get(name, 0) + int(row['n'])
    for entry in table.values():
        entry['key_age_days'] = ages.get(entry['domain'])
        due = [item['next_rotation'] for item in rotation if item['domain'] == entry['domain'] and item['next_rotation']]
        entry['next_rotation'] = min(due) if due else None
        entry['auto_rotate'] = any(item['auto_rotate'] for item in rotation if item['domain'] == entry['domain'])
    return sorted(table.values(), key=lambda entry: entry['domain'])


def _report_tls(total):
    """TLS from the Postfix log of the whole host: shares, versions with ciphers, failures."""
    counts = total['counts']
    connections, sent = counts.get('connections', 0), counts.get('smtp_sent', 0)
    return {'inbound_percent': round(100 * counts.get('tls', 0) / connections) if connections else None,
            'outbound_percent': min(100, round(100 * counts.get('tls_out', 0) / sent)) if sent else None,
            'failed_inbound': counts.get('tls_failed_in', 0), 'failed_outbound': counts.get('tls_failed_out', 0),
            'inbound': _report_top(total.get('tls_in', {})), 'outbound': _report_top(total.get('tls_out', {})),
            'outbound_trust': _report_top(total.get('tls_out_trust', {}))}


def report_data(period, domains, today):
    """Mail flow, threats, authentication and transport from the mail log, for the domains of one reader. None means all."""
    start, end = report_period(period, today)
    where, params = search_where({'date_from': start, 'date_to': end}, domains)
    sign_where, sign_params = 'WHERE day >= %s AND day <= %s', [start, end]
    if domains is not None:
        sign_where += ' AND domain IN (' + ', '.join(['%s'] * len(domains)) + ')' if domains else ' AND FALSE'
        sign_params += list(domains)
    db = _maillog_db()
    try:
        with db.cursor() as cur:
            def rows(sql, extra=()):
                cur.execute(sql.format(where=where), (*params, *extra))
                return cur.fetchall()
            actions = {row['action'] or 'unknown': row['n'] for row in rows('SELECT action, COUNT(*) AS n FROM maillog {where} GROUP BY action ORDER BY n DESC')}
            auth = rows("SELECT SUM(spf IN ('fail', 'softfail')) AS spf, SUM(dkim = 'fail') AS dkim, SUM(dmarc = 'fail') AS dmarc FROM maillog {where}")[0]
            spam = ' AND ' if where else ' WHERE '
            threat = spam + "action NOT IN ('no action', 'greylist')"
            senders = rows('SELECT sender AS name, COUNT(*) AS n FROM maillog {where}' + threat + ' GROUP BY sender ORDER BY n DESC LIMIT %s', (REPORT_TOP,))
            targets = rows('SELECT rcpt AS name, COUNT(*) AS n FROM maillog {where}' + threat + ' GROUP BY rcpt ORDER BY n DESC LIMIT %s', (REPORT_TOP,))
            daily = rows('SELECT CAST(DATE(ts) AS CHAR) AS day, COUNT(*) AS n FROM maillog {where} GROUP BY DATE(ts) ORDER BY day')
            by_domain = rows("SELECT SUBSTRING_INDEX(sender, '@', -1) AS domain, spf, dkim, dmarc, arc, COUNT(*) AS n FROM maillog {where}"
                             " GROUP BY domain, spf, dkim, dmarc, arc")
            failing = rows('SELECT ip AS name, COUNT(*) AS n FROM maillog {where}' + spam + "(dmarc = 'fail' OR spf = 'fail' OR dkim = 'fail' OR arc = 'fail')"
                           ' GROUP BY ip ORDER BY n DESC LIMIT %s', (REPORT_TOP,))
            arc_failed = int(rows('SELECT COUNT(*) AS n FROM maillog {where}' + spam + "arc IN ('fail', 'permerror')")[0]['n'])
    finally:
        db.close()
    signing = _admin_query('SELECT kind, domain, selector, SUM(n) AS n FROM sign_daily ' + sign_where + ' GROUP BY kind, domain, selector', sign_params)
    view = {'period': period, 'from': start, 'to': end, 'total': sum(actions.values()), 'actions': actions,
            'failed_checks': {key: int(auth[key] or 0) for key in ('spf', 'dkim', 'dmarc')}, 'top_blocked_senders': senders,
            'top_targets': targets, 'per_day': daily, 'auth_by_sender_domain': _report_auth(by_domain), 'top_failing_sources': failing,
            'arc_failed_inbound': arc_failed,
            'signing': _report_signing(signing, _dkim_keys(), rotation_status(None)['domains'] if signing else [])}
    # The Postfix log is of the whole host, so only a reader of all domains gets the TLS block.
    if domains is None:
        dates = [(datetime.date.fromisoformat(start) + datetime.timedelta(days=offset)).isoformat()
                 for offset in range((datetime.date.fromisoformat(end) - datetime.date.fromisoformat(start)).days + 1)]
        view['tls'] = _report_tls(_report_merge(dates))
    # DMARC aggregate and TLS reports come with item 6: shown once rows exist.
    for name, table in (('dmarc_aggregate', 'dmarc_rua'), ('tls_reports', 'tls_rpt')):
        found = _admin_query(f'SELECT domain, COUNT(*) AS reports FROM {table} WHERE begin_ts <= %s AND end_ts >= %s'
                             + (' AND domain IN (' + ', '.join(['%s'] * len(domains)) + ')' if domains else '') + ' GROUP BY domain',
                             [end + ' 23:59:59', start, *(domains or [])]) if domains != [] else []
        if found:
            view[name] = found
    return view


def _report_table(title, rows):
    if not rows:
        return ''
    body = ''.join(f'<tr><td>{html.escape(str(name or "(empty)"))}</td><td style="text-align:right">{count}</td></tr>' for name, count in rows)
    return f'<h2 style="font-size:1.05em;margin:1.2em 0 .3em">{html.escape(title)}</h2><table style="border-collapse:collapse;width:100%">{body}</table>'


def report_tables(view):
    tables = [('Results', list(view['actions'].items())), ('Failed checks', list(view['failed_checks'].items())),
              ('Per day', [(row['day'], row['n']) for row in view['per_day']]),
              ('Senders stopped most often', [(row['name'], row['n']) for row in view['top_blocked_senders']]),
              ('Recipients attacked most often', [(row['name'], row['n']) for row in view['top_targets']])]
    tables.append(('Inbound authentication by sender domain: mails, then results other than pass',
                   [(entry['domain'], ', '.join([str(entry['mails'])] + [f'{key.replace("_", " ")} {count}' for key, count in sorted(entry.items())
                                                                         if key not in ('domain', 'mails')]))
                    for entry in view.get('auth_by_sender_domain', [])]))
    tables.append(('Sources failing SPF, DKIM, DMARC or ARC most often', [(row['name'], row['n']) for row in view.get('top_failing_sources', [])]))
    tables.append(('Outbound signing by own domain', [
        (entry['domain'], f"RSA {entry['rsa']}, Ed25519 {entry['ed25519']}, ARC seals {entry['arc']}, unsigned {entry['unsigned']}"
                          + (f", key {entry['key_age_days']} days old" if entry['key_age_days'] is not None else '')
                          + (f", next rotation {entry['next_rotation']}" if entry['next_rotation'] else ', no rotation planned'))
        for entry in view.get('signing', [])]))
    if view.get('arc_failed_inbound'):
        tables.append(('ARC', [('Inbound ARC chains failed', view['arc_failed_inbound'])]))
    tls = view.get('tls')
    if tls:
        tables.append(('TLS', [(name, value) for name, value in (
            ('Inbound connections with TLS, percent', tls['inbound_percent']), ('Outbound deliveries with TLS, percent', tls['outbound_percent']),
            ('Failed TLS inbound', tls['failed_inbound']), ('Failed TLS outbound', tls['failed_outbound'])) if value is not None]))
        tables.append(('TLS inbound: version and cipher', [(row['name'], row['mails']) for row in tls['inbound']]))
        tables.append(('TLS outbound: version and cipher', [(row['name'], row['mails']) for row in tls['outbound']]))
        tables.append(('TLS outbound: certificate check', [(row['name'], row['mails']) for row in tls['outbound_trust']]))
    for key, title in (('dmarc_aggregate', 'DMARC aggregate reports received'), ('tls_reports', 'TLS reports received')):
        if view.get(key):
            tables.append((title, [(row['domain'], row['reports']) for row in view[key]]))
    return tables


def report_title(view, scope):
    return f"eFa-next report {view['from']}" + (f" to {view['to']}" if view['to'] != view['from'] else '') + (f' for {scope}' if scope else '')


def report_html(view, scope=''):
    """Works as a mail and as a page to print. Everything in it is escaped: senders come from outside."""
    title = html.escape(report_title(view, scope))
    tables = ''.join(_report_table(name, rows) for name, rows in report_tables(view))
    return (f'<!doctype html><html lang="en"><head><meta charset="utf-8"><title>{title}</title><style>td{{padding:.15em .4em;border-bottom:1px solid #ccc}}'
            f'@media print{{a{{display:none}}}}</style></head><body style="font-family:sans-serif;max-width:46em;margin:1em auto;padding:0 1em">'
            f'<h1 style="font-size:1.3em">{title}</h1><p>{view["total"]} mails.</p>{tables}</body></html>')


def report_pdf(view, scope='', when=None):
    """5h: the same tables as the mail and the page, as PDF (own PDF code of the hardening report, no library): A4, page X / Y."""
    when = when or time.strftime('%Y-%m-%d %H:%M')
    title = report_title(view, scope)
    blocks = [('h', title), ('p', f"{view['total']} mails from {view['from']} to {view['to']}. Made {when}.")]
    for name, rows in report_tables(view):
        if rows:
            blocks += [('p', name), ('table', [('', 360), ('Count', 135)], [(str(label or '(empty)'), str(count)) for label, count in rows])]
    return _lib('efa_pdf').report(title, blocks, footer=f'eFa-next {_efa_version()} - {when}',
                                  info={'Title': title, 'Producer': 'eFa-next', 'Creator': 'eFa-next',
                                        'CreationDate': 'D:' + re.sub(r'\D', '', when)})


def report_pdf_name(view, scope=''):
    return 'efa-next-report-' + re.sub(r'[^A-Za-z0-9.-]', '_', f"{scope + '-' if scope else ''}{view['from']}-{view['to']}") + '.pdf'


def report_plain(view, scope=''):
    lines = [report_title(view, scope), f"{view['total']} mails."]
    for name, rows in report_tables(view):
        if rows:
            lines += ['', name] + [f'  {count:>8}  {label or "(empty)"}' for label, count in rows]
    return '\n'.join(lines) + '\n'


def brand_html(page, brand):
    """The name, colour and logo of a tenant at the top of a mail."""
    if not brand:
        return page
    color = f' style="color:{brand["color"]}"' if brand['color'] else ''
    logo = '<img src="cid:efa-brand-logo" alt="" style="max-height:60px"><br>' if brand['logo'] else ''
    return page.replace('<body style="font-family:sans-serif">', f'<body style="font-family:sans-serif">{logo}<p{color}><b>{html.escape(brand["name"])}</b></p>', 1)


def brand_logo(message, brand):
    """Puts the logo into the HTML part, so no picture is loaded from outside."""
    if not brand or not brand['logo']:
        return
    with open(f"{BRAND_DIR}/{brand['tenant_id']}.png", 'rb') as f:
        data = f.read()
    for part in message.walk():
        if part.get_content_type() == 'text/html':
            part.add_related(data, 'image', 'png', cid='<efa-brand-logo>')
            return


def _report_mail(address, view, scope, brand=None):
    message = email.message.EmailMessage()
    message['To'] = address
    message['Subject'] = report_title(view, scope)
    message.set_content(report_plain(view, scope))
    message.add_alternative(brand_html(report_html(view, scope), brand), subtype='html')
    brand_logo(message, brand)
    if report_status(None).get('pdf'):
        message.add_attachment(report_pdf(view, scope), maintype='application', subtype='pdf', filename=report_pdf_name(view, scope))
    subprocess.run(['sendmail', '-t'], input=message.as_bytes(), capture_output=True, check=False)


def _reports_send(period, today):
    """The admin gets all domains, each tenant admin with an address only the domains of the tenant."""
    if _admin_email() and prefs_of('')['notifications']:
        _report_mail(_admin_email(), report_data(period, None, today), '')
    for row in _admin_query("SELECT DISTINCT u.email, u.username, t.id, t.name FROM users u JOIN user_groups m ON m.username = u.username "
                            "JOIN efa_groups g ON g.id = m.group_id AND g.builtin = 'tenant' JOIN tenants t ON t.id = m.tenant_id "
                            "WHERE u.email IS NOT NULL AND u.disabled = 0"):
        if not prefs_of(row['username'])['notifications']:
            continue
        domains = [item['domain'] for item in _admin_query('SELECT domain FROM tenant_domains WHERE tenant_id = %s', (row['id'],))]
        _report_mail(row['email'], report_data(period, domains, today), row['name'], tenant_brand(row['id']))


def report_show(args):
    """Mail flow, threats, authentication and TLS for yesterday, the last 7 or 30 days, for all or one domain.
    As a page, the browser can print it to a PDF."""
    period = (args.period or '').strip() or 'day'
    domains = report_domains(identity_now['domains'] if identity_now else None, getattr(args, 'domain', ''))
    view = report_data(period, domains, _today())
    fmt = (args.format or '').strip()
    if fmt == 'json':
        return {'json': json.dumps(view, indent=1, default=str)}
    if fmt == 'pdf':
        scope = (getattr(args, 'domain', '') or '').strip()
        return {'pdf': base64.b64encode(report_pdf(view, scope)).decode(), 'name': report_pdf_name(view, scope)}
    return {'html': report_html(view)} if fmt == 'html' else view


# G7-8: a calendar of one month and the course of the last 30, 90 or 365 days, from the mail log, for the domains of the reader.
MAILHIST_DAYS = (30, 90, 365)
MAILHIST_KEYS = ('total', 'clean', 'spam', 'rejected', 'viruses')
# The web interface puts its CSRF token here when it serves the page, for the buttons of the page (efa-web, run).
MAILHIST_CSRF = '__EFA_CSRF__'


# G7-8: the numbers of each day in the small table maillog_daily, counted once a day by the hourly job, never on a page view.
# No addresses: a row holds a day, a domain and counts; domain '' is the whole host, every own domain gets the mails whose sender
# or recipients are in it. Today comes from the mail log itself (one day over the ts index), so it is never an hour behind.
# R7-6: a mail with two or more own domains also counts in one row '+a.example,b.example' (its own domains, sorted), so a scope of
# several domains takes it off again and counts it once; '+*' when the names do not fit the column (that day: from the mail log).
MAILHIST_DAILY_MAX = 400
MAILHIST_DOMAIN_MAX = 253


def maillog_daily_rows(rows, own):
    """{(day, domain): counts} of mail log rows (day, sender, rcpt, action, threat); a mail counts for '' and each own domain in it,
    and with two or more own domains once more for the row of those domains together (R7-6)."""
    found = {}
    for row in rows:
        names = re.findall(r'@([a-z0-9.-]+)', f"{row.get('sender') or ''} {row.get('rcpt') or ''}".lower())
        action, threat = row.get('action') or '', row.get('threat') or ''
        add = {'total': 1, 'clean': int(action == 'no action'), 'spam': int(action in ('add header', 'rewrite subject')),
               'rejected': int(action == 'reject'), 'viruses': int(threat.startswith('virus:'))}
        mine = sorted({name for name in names if name in own})
        together = []
        if len(mine) >= 2:
            together = ['+' + ','.join(mine)] if len(','.join(mine)) < MAILHIST_DOMAIN_MAX else ['+*']
        for domain in {''} | set(mine) | set(together):
            item = found.setdefault((str(row['day']), domain), dict.fromkeys(MAILHIST_KEYS, 0))
            for key, value in add.items():
                item[key] += value
    return found


def maillog_daily_fill(today, back, first=1):
    """Counts the days first to back before today again and replaces their rows in maillog_daily. Returns the number of rows."""
    import pymysql
    own = set(_own_domains())
    written = 0
    db = _maillog_db()
    try:
        for offset in range(back, first - 1, -1):
            day = (today - datetime.timedelta(days=offset)).isoformat()
            # A cursor that streams: a busy day is read in pieces, not into memory at once.
            with db.cursor(pymysql.cursors.SSDictCursor) as cur:
                cur.execute('SELECT CAST(DATE(ts) AS CHAR) AS day, sender, rcpt, action, threat FROM maillog WHERE ts >= %s AND ts < %s + INTERVAL 1 DAY',
                            (day, day))
                counts = {}
                while batch := cur.fetchmany(5000):
                    for key, item in maillog_daily_rows(batch, own).items():
                        total = counts.setdefault(key, dict.fromkeys(MAILHIST_KEYS, 0))
                        for name in MAILHIST_KEYS:
                            total[name] += item[name]
            with db.cursor() as cur:
                cur.execute('DELETE FROM maillog_daily WHERE day = %s', (day,))
                if counts:
                    cur.executemany('INSERT INTO maillog_daily (day, domain, total, clean, spam, rejected, viruses) VALUES (%s, %s, %s, %s, %s, %s, %s)',
                                    [(key[0], key[1]) + tuple(item[name] for name in MAILHIST_KEYS) for key, item in sorted(counts.items())])
            written += len(counts)
    finally:
        db.close()
    return written


def maillog_daily_purge(keep):
    """The rows older than the retention of the mail log; tenants with own days lose the rows of their domains earlier."""
    db = _maillog_db()
    try:
        with db.cursor() as cur:
            cur.execute('DELETE FROM maillog_daily WHERE day < CURDATE() - INTERVAL %s DAY', (keep,))
            domains_of = _tenant_domains_or_none() or {}
            for tid, kinds in sorted(retention_tenants().items()):
                names = domains_of.get(tid) or []
                if 'maillog' in kinds and names:
                    cur.execute(f"DELETE FROM maillog_daily WHERE day < CURDATE() - INTERVAL %s DAY AND domain IN ({', '.join(['%s'] * len(names))})",
                                [kinds['maillog']] + list(names))
                    cur.execute("DELETE FROM maillog_daily WHERE day < CURDATE() - INTERVAL %s DAY AND domain LIKE '+%%' AND ("
                                + ' OR '.join(['FIND_IN_SET(%s, SUBSTRING(domain, 2))'] * len(names)) + ')', [kinds['maillog']] + list(names))
    finally:
        db.close()


MAILHIST_FILL_STEP = 30


def maillog_daily_plan(today, state, keep):
    """(first, back) of the days this run counts, or None. R7-7: the first count of the kept mail log (at most 400 days) goes
    30 days per hourly run, newest first, so no run waits for a whole year of the mail log; later the last two days once a day."""
    if not state.get('maillog_daily_full'):
        done = state.get('maillog_daily_done', 0)
        return done + 1, min(done + MAILHIST_FILL_STEP, min(max(keep, 2), MAILHIST_DAILY_MAX))
    if state.get('maillog_daily_day') == today.isoformat():
        return None
    return 1, 2


def _maillog_daily_job(today, state):
    keep = _maillog_days()
    plan = maillog_daily_plan(today, state, keep)
    if not plan:
        return
    maillog_daily_fill(today, plan[1], plan[0])
    if not state.get('maillog_daily_full'):
        state['maillog_daily_done'] = plan[1]
        if plan[1] < min(max(keep, 2), MAILHIST_DAILY_MAX):
            return
        state['maillog_daily_full'] = True
    maillog_daily_purge(keep)
    state['maillog_daily_day'] = today.isoformat()


def history_daily_sum(rows, domains):
    """R7-6: ({day: counts}, days for the mail log) of maillog_daily rows for a scope of own domains. The domain rows count a mail
    once per domain of the scope in it; a row of domains together takes it off again, so it counts once."""
    scope, found, live = set(domains), {}, set()
    for row in rows:
        domain, day = row['domain'], row['day']
        if domain == '+*':
            live.add(day)
            continue
        times = (domain in scope) if not domain.startswith('+') else 1 - len(scope & set(domain[1:].split(',')))
        if times == 0 or (domain.startswith('+') and times > 0):
            continue
        item = found.setdefault(day, dict.fromkeys(MAILHIST_KEYS, 0))
        for key in MAILHIST_KEYS:
            item[key] += times * int(row[key] or 0)
    return found, live


def history_counts(start, end, domains, today=None):
    """{'YYYY-MM-DD': {total, clean, spam, rejected, viruses}} of the days from start to end: the days before today from
    maillog_daily, today from the mail log. Before the first daily count (a new install, an update) the mail log answers."""
    import pymysql
    today = (today or _today()).isoformat()
    found = {}
    db = _maillog_db()
    try:
        with db.cursor() as cur:
            live_from = today
            if start < today and (domains is None or domains):
                try:
                    cur.execute('SELECT 1 FROM maillog_daily LIMIT 1')
                    ready = bool(cur.fetchall())
                except pymysql.MySQLError:  # the table comes with maillog-setup of 6.0.0.6.4
                    ready = False
                if ready and domains is None:
                    cur.execute('SELECT CAST(day AS CHAR) AS day, total, clean, spam, rejected, viruses FROM maillog_daily '
                                "WHERE day >= %s AND day < %s AND domain = ''", [start, today])
                    found = {row['day']: {key: int(row[key] or 0) for key in MAILHIST_KEYS} for row in cur.fetchall()}
                elif ready:
                    # The domain rows of the scope, and the rows of domains together (R7-6), which take a mail with two of them off again.
                    cur.execute('SELECT CAST(day AS CHAR) AS day, domain, total, clean, spam, rejected, viruses FROM maillog_daily '
                                f"WHERE day >= %s AND day < %s AND (domain IN ({', '.join(['%s'] * len(domains))}) OR domain LIKE '+%%')",
                                [start, today] + list(domains))
                    found, live = history_daily_sum(cur.fetchall(), domains)
                    if live:
                        live_from = min(live)
                else:
                    live_from = start
            if end >= today or live_from < today:
                where, params = search_where({'date_from': live_from, 'date_to': end}, domains)
                cur.execute("SELECT CAST(DATE(ts) AS CHAR) AS day, COUNT(*) AS total, SUM(action = 'no action') AS clean,"
                            " SUM(action IN ('add header', 'rewrite subject')) AS spam, SUM(action = 'reject') AS rejected,"
                            " SUM(threat LIKE 'virus:%%') AS viruses FROM maillog " + where + ' GROUP BY DATE(ts)', params)
                found.update({row['day']: {key: int(row[key] or 0) for key in MAILHIST_KEYS} for row in cur.fetchall()})
    finally:
        db.close()
    return found


def history_view(month, days, counts, today):
    """The calendar weeks of month (Monday first) and the series of the last days, with zeros for days without mail."""
    first = datetime.date.fromisoformat(month + '-01')
    following = (first.replace(day=28) + datetime.timedelta(days=4)).replace(day=1)
    empty = dict.fromkeys(MAILHIST_KEYS, 0)
    weeks, day = [], first - datetime.timedelta(days=first.weekday())
    while day < following:
        weeks.append([{'day': (day + datetime.timedelta(days=n)).isoformat(), 'in_month': first <= day + datetime.timedelta(days=n) < following,
                       'future': day + datetime.timedelta(days=n) > today, **counts.get((day + datetime.timedelta(days=n)).isoformat(), empty)}
                      for n in range(7)])
        day += datetime.timedelta(days=7)
    series = [{'day': (today - datetime.timedelta(days=n)).isoformat(), **counts.get((today - datetime.timedelta(days=n)).isoformat(), empty)}
              for n in range(days - 1, -1, -1)]
    previous = (first - datetime.timedelta(days=1)).strftime('%Y-%m')
    month_total = {key: sum(cell[key] for week in weeks for cell in week if cell['in_month']) for key in MAILHIST_KEYS}
    return {'month': month, 'previous': previous, 'next': following.strftime('%Y-%m') if following <= today else '', 'weeks': weeks,
            'month_total': month_total, 'days': days, 'series': series}


def history_svg(series, label, legend=('all mail', 'spam')):
    """The course as a small line chart without script: all mail and spam per day, the highest value on the axis."""
    width, height, top = 600, 160, max([point['total'] for point in series] + [1])
    step = width / max(len(series) - 1, 1)

    def line(key):
        return ' '.join(f'{i * step:.1f},{height - point[key] * (height - 10) / top:.1f}' for i, point in enumerate(series))
    return (f'<svg viewBox="-40 -10 {width + 50} {height + 30}" role="img" aria-label="{html.escape(label)}" style="width:100%;max-width:{width + 50}px">'
            f'<line x1="0" y1="{height}" x2="{width}" y2="{height}" stroke="#999"/><line x1="0" y1="0" x2="0" y2="{height}" stroke="#999"/>'
            f'<text x="-6" y="14" text-anchor="end" font-size="11">{top}</text><text x="-6" y="{height}" text-anchor="end" font-size="11">0</text>'
            f'<text x="0" y="{height + 16}" font-size="11">{html.escape(series[0]["day"])}</text>'
            f'<text x="{width}" y="{height + 16}" text-anchor="end" font-size="11">{html.escape(series[-1]["day"])}</text>'
            f'<polyline fill="none" stroke="#2563eb" stroke-width="2" points="{line("total")}"/>'
            f'<polyline fill="none" stroke="#d97706" stroke-width="2" points="{line("spam")}"/></svg>'
            f'<p><span style="color:#2563eb">&#9644;</span> {html.escape(legend[0])} &nbsp; <span style="color:#d97706">&#9644;</span> {html.escape(legend[1])}</p>')


def history_html(view, scope='', lang='en'):
    """The calendar and the course as a page in the language of the reader (R7-8), with a way back to the mail report. A day
    opens the advanced search for that day; the arrows change the month. Everything in it is escaped; the buttons post with
    the token the web interface fills in."""
    lang = lang if lang in _lib('efa_i18n').LANGUAGES else 'en'
    translated = _lib('efa_i18n').catalog(lang).gettext

    def _text(template, **values):  # the local _text: scripts/i18n_extract.py collects the templates, the page gets them translated
        return translated(template).format(**values)

    def button(target, fields, text, title=''):
        hidden = ''.join(f'<input type="hidden" name="{html.escape(name)}" value="{html.escape(value)}">' for name, value in fields.items())
        return (f'<form method="post" action="{target}" style="display:inline"><input type="hidden" name="csrf" value="{MAILHIST_CSRF}">{hidden}'
                f'<button title="{html.escape(title)}" style="border:0;background:none;padding:0;cursor:pointer;text-align:left;width:100%">{text}</button></form>')
    domain = {'domain': scope} if scope else {}
    nav = (button('/run/mail-history', {'month': view['previous'], 'days': str(view['days']), 'format': 'html', **domain}, '&larr; ' + html.escape(view['previous']))
           + ' <b>' + html.escape(view['month']) + '</b> '
           + (button('/run/mail-history', {'month': view['next'], 'days': str(view['days']), 'format': 'html', **domain}, html.escape(view['next']) + ' &rarr;') if view['next'] else ''))
    names = (_text('Mon'), _text('Tue'), _text('Wed'), _text('Thu'), _text('Fri'), _text('Sat'), _text('Sun'))
    head = ''.join(f'<th>{html.escape(name)}</th>' for name in names)
    rows = ''
    for week in view['weeks']:
        cells = ''
        for cell in week:
            if not cell['in_month']:
                cells += '<td style="background:#f3f4f6"></td>'
                continue
            text = (f'<b>{int(cell["day"][8:])}</b><br><small>' + html.escape(_text('{total} mails', total=cell['total'])) + '<br>'
                    + html.escape(_text('{spam} spam · {viruses} viruses', spam=cell['spam'], viruses=cell['viruses'])) + '<br>'
                    + html.escape(_text('{rejected} rejected', rejected=cell['rejected'])) + '</small>')
            cells += ('<td style="vertical-align:top">' + (text if cell['future'] or not cell['total'] else
                      button('/p/log/search', {'date_from': cell['day'], 'date_to': cell['day']}, text, _text('Search the mails of {day}', day=cell['day']))) + '</td>')
        rows += f'<tr>{cells}</tr>'
    total = view['month_total']
    title = _text('Mail history of {domain}', domain=scope) if scope else _text('Mail history')
    month_line = _text('{total} mails in the month, {spam} spam, {viruses} viruses, {rejected} rejected.', **total)
    return (f'<!doctype html><html lang="{lang}"><head><meta charset="utf-8"><title>{html.escape(title)}</title><style>'
            'table{border-collapse:collapse;width:100%}td,th{border:1px solid #ccc;padding:.3em;width:14%}@media print{form button,a.back{display:none}}</style></head>'
            '<body style="font-family:sans-serif;max-width:60em;margin:1em auto;padding:0 1em">'
            f'<p><a class="back" href="/p/report#mail-history">&larr; {html.escape(_text("Back to the mail report"))}</a></p>'
            f'<h1 style="font-size:1.3em">{html.escape(title)}</h1><p>{nav}</p>'
            f'<p>{html.escape(month_line)}</p>'
            f'<table><tr>{head}</tr>{rows}</table><h2 style="font-size:1.1em">{html.escape(_text("Last {days} days", days=view["days"]))}</h2>'
            + history_svg(view['series'], _text('Mail per day, last {days} days', days=view['days']), (_text('all mail'), _text('spam')))
            + '</body></html>')


def mail_history(args):
    """G7-8: the calendar of a month and the course of the last 30, 90 or 365 days. As a page (html) or as values."""
    today = _today()
    month = (args.month or '').strip() or today.strftime('%Y-%m')
    if not re.fullmatch(r'\d{4}-(0[1-9]|1[0-2])', month) or month > today.strftime('%Y-%m') or month < '2000-01':
        raise EfaError('Month like 2026-11, not in the future.')
    days = (args.days or '').strip() or '30'
    if not days.isdigit() or int(days) not in MAILHIST_DAYS:
        raise EfaError('Days: 30, 90 or 365.')
    days = int(days)
    scope = (getattr(args, 'domain', '') or '').strip().lower()
    domains = report_domains(identity_now['domains'] if identity_now else None, scope)
    first = datetime.date.fromisoformat(month + '-01')
    start = min(first, today - datetime.timedelta(days=days - 1)).isoformat()
    view = history_view(month, days, history_counts(start, today.isoformat(), domains), today)
    return {'html': history_html(view, scope, (getattr(args, 'lang', '') or '').strip())} if (args.format or '').strip() == 'html' else view


def report_set(args):
    """Reports by mail to the admin and the tenant admins: yesterday every day, the last 7 days on Mondays. Off by default."""
    state = {'daily': _on_off(args.daily), 'weekly': _on_off(args.weekly),
             'pdf': _on_off(args.pdf) if (getattr(args, 'pdf', '') or '').strip() else report_status(None)['pdf']}
    _json_write(REPORTS_FILE, state)
    return state


def report_status(_args):
    """Reports by mail; pdf: the report also as a PDF attachment (off until switched on)."""
    return {'daily': False, 'weekly': False, 'pdf': False, **_json_read(REPORTS_FILE, {})}


def rule_targets(rule, tenant_domains, group_members):
    """The addresses and @domains a rule applies to. Tenants and groups turn into what they hold now."""
    kind, value = rule['kind'], rule['value']
    if kind in ('sender', 'recipient'):
        return [value]
    if kind in ('sender_domain', 'domain'):
        return ['@' + value]
    if kind == 'tenant':
        return ['@' + domain for domain in tenant_domains(value)]
    return group_members(value)


def rule_settings_text(rules, tenant_domains, group_members):
    """rspamd takes the first rule that fits, in the order of the priorities. Rules without targets are left out."""
    blocks = []
    for rule in sorted((r for r in rules if r.get('enabled', True)), key=lambda r: -int(r['priority'])):
        actions = []
        if rule.get('reject') not in (None, ''):
            actions.append(f"reject = {rule['reject']};")
        elif rule.get('quarantine'):
            actions.append(f'reject = {RULE_NEVER_REJECT};')
        if rule.get('add_header') not in (None, ''):
            # Both count as marked spam here, and the subject rule would otherwise stay at its lower limit.
            actions.append(f'"add header" = {rule["add_header"]}; "rewrite subject" = {rule["add_header"]};')
        if rule.get('greylist') not in (None, ''):
            actions.append(f"greylist = {rule['greylist']};")
        if rule.get('spam_off'):
            # No spam action for these mails; the virus scan rejects on its own (force action), it stays.
            actions = ['reject = null; "add header" = null; "rewrite subject" = null; greylist = null;']
        extra = ' symbols_disabled = ["MIME_ENCRYPTED_ARCHIVE"];' if rule.get('allow_encrypted') else ''
        targets = rule_targets(rule, tenant_domains, group_members)
        if not (actions or extra) or not targets:
            continue
        field = 'from' if rule['kind'] in RULE_FROM_SENDER else 'rcpt'
        listed = ', '.join(json.dumps(target) for target in targets)
        applied = (f"actions {{ {' '.join(actions)} }}" if actions else '') + extra
        blocks.append(f"efa_rule_{rule['name'].replace('-', '_')} {{\n  priority = {rule['priority']};\n  {field} = [{listed}];\n"
                      f"  apply {{ {applied.strip()} }}\n}}\n")
    return (RULES_MARK + ''.join(blocks)) if blocks else ''


def rule_route_lines(rules, tenant_domains, group_members):
    """Postfix map lines: (for the recipient, for the sender)."""
    to_recipient, to_sender = [], []
    for rule in sorted((r for r in rules if r.get('enabled', True) and r.get('route')), key=lambda r: -int(r['priority'])):
        host, _, port = rule['route'].partition(':')
        hop = f'[{host}]' + (f':{port}' if port else '')
        for target in rule_targets(rule, tenant_domains, group_members):
            # A domain in a transport map has no @, in the sender map it has one.
            if rule['kind'] in RULE_FROM_SENDER:
                to_sender.append(f'{target} {hop}')
            else:
                to_recipient.append(f"{target.lstrip('@')} smtp:{hop}")
    return to_recipient, to_sender


def map_list_value(current, entry, wanted):
    """A Postfix map list with our map first, or without it. Everything else in the list stays."""
    items = [item for item in re.split(r'[\s,]+', current.strip()) if item and item != entry]
    return ', '.join(([entry] if wanted else []) + items)


def rule_map_value(current, path, wanted):
    return map_list_value(current, _map(path), wanted)


# Archive handover (8h): a copy of each mail to an external archive by SMTP, as Postfix BCC. A copy that cannot be delivered
# waits in the queue like any other mail, the queue alarm reports a backlog.
ARCHIVE_FILE = ETC + '/eFa/archive.json'
ARCHIVE_RCPT_BCC = ETC + '/postfix/efa-archive-recipient-bcc'
ARCHIVE_SENDER_BCC = ETC + '/postfix/efa-archive-sender-bcc'
ARCHIVE_TRANSPORT = ETC + '/postfix/efa-archive-transport'
ARCHIVE_TLS = ETC + '/postfix/efa-archive-tls'
ARCHIVE_TEMPLATES = ('mailstore', 'piler', 'smtp')
ARCHIVE_DIRECTIONS = ('in', 'out', 'both')
ARCHIVE_TLS_LEVELS = ('verify', 'encrypt', 'may')  # verify: TLS with a certificate checked against the system CAs and the host name


ARCHIVE_FORMATS = ('copy', 'journal')
# 6/8h: the journal reports come in here, without milters, BCC or content filter: they are never filtered or copied again.
JOURNAL_SERVICE = '127.0.0.1:10031'
JOURNAL_MASTER = ('127.0.0.1:10031 inet n - n - - smtpd -o smtpd_milters= -o non_smtpd_milters= -o content_filter= -o recipient_bcc_maps= '
                  '-o sender_bcc_maps= -o always_bcc= -o receive_override_options=no_milters,no_header_body_checks,no_unknown_recipient_checks '
                  '-o mynetworks=127.0.0.0/8 -o smtpd_client_restrictions= -o smtpd_helo_restrictions= -o smtpd_sender_restrictions= '
                  '-o smtpd_relay_restrictions=permit_mynetworks,reject -o smtpd_recipient_restrictions=permit_mynetworks,reject')


def archive_journal(targets, own):
    """6/8h: the journal addresses of the targets with the journal format, {'in': {domain: address}, 'out': {...}}."""
    found = {'in': {}, 'out': {}}
    for item in targets:
        if item.get('format', 'copy') != 'journal':
            continue
        for domain in item['domains'] or sorted(own):
            for direction in ('in', 'out') if item['direction'] == 'both' else (item['direction'],):
                found[direction][domain] = item['address']
    return found if found['in'] or found['out'] else {}


def archive_maps(targets, own):
    """The lines of the BCC, transport and TLS tables. A target without domains takes all domains of this server."""
    rcpt, sender, transport, tls, taken = [], [], [], [], {}
    for item in targets:
        for domain in item['domains'] or sorted(own):
            for direction in ('in', 'out') if item['direction'] == 'both' else (item['direction'],):
                if (domain, direction) in taken:
                    raise EfaError(f'{domain} goes to the archive {taken[domain, direction]} already ({direction}).')
                taken[domain, direction] = item['name']
                # A journal target gets its reports from the content milter, not a BCC copy.
                if item.get('format', 'copy') == 'copy':
                    (rcpt if direction == 'in' else sender).append(f'@{domain} {item["address"]}')
        transport.append(f'{item["address"]} smtp:[{item["host"]}]:{item["port"]}')
        tls.append(f'[{item["host"]}]:{item["port"]} {item["tls"]}')
    return {ARCHIVE_RCPT_BCC: rcpt, ARCHIVE_SENDER_BCC: sender, ARCHIVE_TRANSPORT: sorted(set(transport)), ARCHIVE_TLS: sorted(set(tls))}


def _archive_apply(targets):
    tables = archive_maps(targets, _own_domains())
    journal = bool(archive_journal(targets, _own_domains()))
    if journal:
        subprocess.run(['postconf', '-M', f'{JOURNAL_SERVICE}/inet={JOURNAL_MASTER}'], check=True, capture_output=True)
    else:
        subprocess.run(['postconf', '-MX', f'{JOURNAL_SERVICE}/inet'], check=False, capture_output=True)
    for path, lines in tables.items():
        if lines:
            _map_write(path, lines)
    for parameter, path in (('recipient_bcc_maps', ARCHIVE_RCPT_BCC), ('sender_bcc_maps', ARCHIVE_SENDER_BCC),
                            ('transport_maps', ARCHIVE_TRANSPORT), ('smtp_tls_policy_maps', ARCHIVE_TLS)):
        wanted = rule_map_value(_postconf(parameter), path, bool(tables[path]))
        if wanted != _postconf(parameter):
            if wanted:
                _postconf_set(parameter, wanted)
            else:
                _postconf_remove([parameter])
    for path, lines in tables.items():
        for item in _map_files(path):
            if not lines and os.path.exists(item):
                os.remove(item)


# A2: TLS required per partner domain. Out: mail to the partner leaves only encrypted (and checked, if chosen), through a
# map of smtp_tls_policy_maps. In: mail with a sender of the partner domain is taken only over TLS (reject_plaintext_session,
# a temporary refusal: a server that lost TLS by mistake tries again). Own domains have their TLS under Domain settings.
TLS_PARTNER_FILE = ETC + '/eFa/tls-partners.json'
TLS_PARTNER_OUT = ETC + '/postfix/efa-tls-partner-out'
TLS_PARTNER_IN = ETC + '/postfix/efa-tls-partner-in'
TLS_PARTNER_CLASS = 'efa_tls_partner'
TLS_PARTNER_LEVELS = ('encrypt', 'verify', 'dane-only')


def tls_partner_maps(partners):
    out = [f"{item['domain']} {item['out']}" for item in partners if item.get('out')]
    inbound = [line for item in partners if item.get('in') for line in (f"{item['domain']} {TLS_PARTNER_CLASS}", f".{item['domain']} {TLS_PARTNER_CLASS}")]
    return sorted(out), sorted(inbound)


def tls_partner_sender_value(current, wanted):
    """smtpd_sender_restrictions with the check of the partner senders last, or without it."""
    entry = f'check_sender_access {_map(TLS_PARTNER_IN)}'
    items = [item.strip() for item in current.split(',') if item.strip() and item.strip() != entry]
    return ', '.join(items + ([entry] if wanted else []))


def _tls_partners():
    return _json_read(TLS_PARTNER_FILE, {'partners': []})['partners']


def _tls_partner_apply(partners):
    out, inbound = tls_partner_maps(partners)
    for path, lines in ((TLS_PARTNER_OUT, out), (TLS_PARTNER_IN, inbound)):
        if lines:
            _map_write(path, lines)
    wanted = rule_map_value(_postconf('smtp_tls_policy_maps'), TLS_PARTNER_OUT, bool(out))
    if wanted != _postconf('smtp_tls_policy_maps'):
        _postconf_set('smtp_tls_policy_maps', wanted) if wanted else _postconf_remove(['smtp_tls_policy_maps'])
    listed = [item for item in _postconf('smtpd_restriction_classes').replace(',', ' ').split() if item != TLS_PARTNER_CLASS]
    if inbound:
        # Own networks and logged in senders are not asked: they send inside or over port 587 with TLS anyway.
        _postconf_set(TLS_PARTNER_CLASS, 'permit_mynetworks, permit_sasl_authenticated, reject_plaintext_session')
        _postconf_set('smtpd_restriction_classes', ' '.join(listed + [TLS_PARTNER_CLASS]))
    wanted = tls_partner_sender_value(_postconf('smtpd_sender_restrictions'), bool(inbound))
    if wanted != _postconf('smtpd_sender_restrictions'):
        _postconf_set('smtpd_sender_restrictions', wanted) if wanted else _postconf_remove(['smtpd_sender_restrictions'])
    if not inbound and TLS_PARTNER_CLASS in _postconf_explicit():
        _postconf_set('smtpd_restriction_classes', ' '.join(listed)) if listed else _postconf_remove(['smtpd_restriction_classes'])
        _postconf_remove([TLS_PARTNER_CLASS])
    for path, lines in ((TLS_PARTNER_OUT, out), (TLS_PARTNER_IN, inbound)):
        for item in _map_files(path):
            if not lines and os.path.exists(item):
                os.remove(item)
    _json_write(TLS_PARTNER_FILE, {'partners': partners}, mode=0o644)


# Hans 2026-11-19: TLS required for the partners that publish DANE or MTA-STS. Only a suggestion; the admin adds each with
# tls-partner-set. Port 25 stays opportunistic for everybody else (RFC 3207).
TLS_SUGGEST_DOMAINS = 30


def tls_partner_candidates(rows, lookup, dane_on):
    """The suggestions: of (domain, mails), those whose lookup(domain) gives (dane, mta_sts) with one of them true."""
    found = []
    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
        for (domain, mails), (dane, sts) in zip(rows, pool.map(lambda row: lookup(row[0]), rows)):
            if dane or sts:
                level = 'dane-only' if dane and dane_on else 'verify'
                found.append({'domain': domain, 'mails': mails, 'dane': dane, 'mta_sts': sts, 'suggested': level,
                              'command': f'efactl tls-partner-set --action add --domain {domain} --out {level}'})
    return found


def _tls_dns(domain):
    """(DANE, MTA-STS) of a domain: TLSA records for port 25 of one of its first three MX, the TXT record _mta-sts."""
    mx = [answer.split()[-1].rstrip('.') for answer in _dig(domain, 'MX')[0] if answer.split()][:3]
    dane = any(_tlsa_published(host) for host in mx if DOMAIN_RE.match(host))
    sts = any(answer.strip('"').startswith('v=STSv1') for answer in _dig('_mta-sts.' + domain, 'TXT')[0])
    return dane, sts


def tls_partner_suggest(args):
    """Partner domains to require TLS for: the most frequent recipient domains of the mail log that publish DANE or MTA-STS
    and have no rule yet, with the command to add each. Reads only; the DNS checks run when asked."""
    days = (getattr(args, 'days', '') or '7').strip()
    if not days.isdigit() or not 1 <= int(days) <= 30:
        raise EfaError('Days: 1 to 30.')
    db = _maillog_db()
    try:
        with db.cursor() as cur:
            cur.execute("SELECT LOWER(TRIM(BOTH '<> ' FROM SUBSTRING_INDEX(SUBSTRING_INDEX(rcpt, ',', 1), '@', -1))) AS domain, COUNT(*) AS n "
                        'FROM maillog WHERE ts >= NOW() - INTERVAL %s DAY GROUP BY domain ORDER BY n DESC LIMIT 200', (int(days),))
            rows = [(row['domain'], int(row['n'])) for row in cur.fetchall() if row['domain']]
    finally:
        db.close()
    skip = set(_local_domains()) | {item['domain'] for item in _tls_partners()}
    rows = [(domain, mails) for domain, mails in rows if domain not in skip and DOMAIN_RE.match(domain)][:TLS_SUGGEST_DOMAINS]
    stats = _safe(tls25_status, {})
    return {'suggestions': tls_partner_candidates(rows, _tls_dns, _postconf('smtp_dns_support_level') == 'dnssec'), 'checked_domains': len(rows),
            'days': int(days), 'port25_sessions_7d': stats.get('port25_sessions_7d', 0), 'port25_without_tls_7d': stats.get('port25_without_tls_7d', 0),
            'note': 'Port 25 stays opportunistic for every other domain (RFC 3207). Add a partner with tls-partner-set.'}


def tls_partner_list(_args):
    """Partner domains with TLS required: to them, from them, or both."""
    return {'partners': _tls_partners()}


def tls_partner_set(args):
    """Requires TLS for mail to and/or from a partner domain, or removes the requirement."""
    domain, action = (args.domain or '').strip().lower().rstrip('.'), (args.action or '').strip()
    if not DOMAIN_RE.match(domain):
        raise EfaError('Invalid domain.')
    partners = [item for item in _tls_partners() if item['domain'] != domain]
    if action == 'add':
        out, inbound = (args.out or '').strip(), (args.inbound or '').strip()
        if out not in ('',) + TLS_PARTNER_LEVELS:
            raise EfaError('Mail to the partner: one of ' + ', '.join(TLS_PARTNER_LEVELS) + ', or empty.')
        if inbound not in ('', 'on', 'off'):
            raise EfaError("Mail from the partner: 'on' or 'off'.")
        if not out and inbound != 'on':
            raise EfaError('Choose TLS for mail to the partner, from the partner, or both.')
        if out == 'dane-only' and _postconf('smtp_dns_support_level') != 'dnssec':
            raise EfaError('DANE needs the DNSSEC check of the resolver: switch DANE on first (Network, DNS & certificate).')
        if domain in _local_domains():
            raise EfaError('This is an own domain: its TLS is set under Domain settings.')
        partners.append({'domain': domain, 'out': out, 'in': inbound == 'on'})
    elif action == 'remove':
        if len(partners) == len(_tls_partners()):
            raise EfaError('No such partner domain.')
    else:
        raise EfaError("Action must be 'add' or 'remove'.")
    _tls_partner_apply(sorted(partners, key=lambda item: item['domain']))
    _audit(f'TLS for partner {domain} {action} by {_dmarc_who()}')
    return tls_partner_list(None)

# Bulk mail (8i): its own transport, slower per target domain, and a check of what the big providers ask of bulk senders.
BULK_TRANSPORT = 'efabulk'
BULK_HEADERS = ETC + '/postfix/efa-bulk-headers'
BULK_PACES = {'gentle': {'destination_concurrency_limit': 1, 'destination_rate_delay': '3s', 'destination_recipient_limit': 20},
              'normal': {'destination_concurrency_limit': 1, 'destination_rate_delay': '1s', 'destination_recipient_limit': 50},
              'fast': {'destination_concurrency_limit': 5, 'destination_rate_delay': '0s', 'destination_recipient_limit': 100}}
BULK_DEFAULTS = {'enabled': False, 'auto': True, 'senders': [], 'missing': 'log', 'pace': 'normal', 'ready': {}, 'address': '', 'helo': '',
                 'warmup': {'enabled': False, 'start': 0}, 'arf': ''}


def bulk_ready(domain, dkim_domains, txt=None):
    """What a bulk sender domain lacks: a DKIM key here (it signs with the From domain, so DKIM aligns), SPF and DMARC in DNS."""
    txt = txt or (lambda name: _dns_txt('127.0.0.1', name) or [])
    missing = [] if domain in dkim_domains else ['dkim']
    if not any('v=spf1' in line.lower() for line in txt(domain)):
        missing.append('spf')
    if not any('v=dmarc1' in line.lower() for line in txt('_dmarc.' + domain)):
        missing.append('dmarc')
    return missing


def bulk_status(_args):
    """Bulk mail: settings, and per sender domain what the providers would miss."""
    return {**BULK_DEFAULTS, **_json_read(OUTBOUND_FILE, {}).get('bulk', {})}


def bulk_set(args):
    """Bulk mail through its own slower transport: for named senders, and with auto for mail with Precedence bulk or List-Unsubscribe."""
    state = _json_read(OUTBOUND_FILE, {})
    bulk = {**BULK_DEFAULTS, **state.get('bulk', {})}
    if (args.mode or '').strip():
        bulk['enabled'] = _on_off(args.mode)
    if (args.auto or '').strip():
        bulk['auto'] = _on_off(args.auto)
    for key, choices in (('missing', ('log', 'hold')), ('pace', tuple(BULK_PACES))):
        value = (getattr(args, key) or '').strip()
        if value:
            if value not in choices:
                raise EfaError(f'{key}: {", ".join(choices)}.')
            bulk[key] = value
    if args.senders is not None and args.senders.strip():
        senders = [] if args.senders.strip() == '-' else sorted({item.strip().lower() for item in re.split(r'[\s,;]+', args.senders) if item.strip()})
        own = _own_domains()
        bad = [item for item in senders if item.rpartition('@')[2] not in own or not (DOMAIN_RE.match(item) or SENDER_RE.match(item))]
        if bad:
            raise EfaError(f'Only addresses or domains of this server: {", ".join(bad)}')
        bulk['senders'] = senders
    address = (getattr(args, 'address', '') or '').strip()
    if address:
        if address == '-':
            bulk.update(address='', helo='')
        else:
            problem = _bulk_address_check(address)
            if problem:
                raise EfaError(f'Own address of the bulk mail: {problem}. Nothing changed.')
            bulk.update(address=str(ipaddress.ip_address(address)), helo=_dig(ipaddress.ip_address(address).reverse_pointer, 'PTR')[0][0].rstrip('.'))
    warmup = (getattr(args, 'warmup', '') or '').strip()
    if warmup:
        on = _on_off(warmup)
        bulk['warmup'] = {'enabled': on, 'start': (bulk.get('warmup') or {}).get('start') or int(time.time()) if on else 0}
    arf = (getattr(args, 'arf', '') or '').strip().lower()
    if arf:
        if arf != '-' and (not SENDER_RE.match(arf) or arf.rpartition('@')[2] not in _own_domains()):
            raise EfaError('Complaints (ARF): an address of an own domain, such as fbl@example.com; - for none.')
        bulk['arf'] = '' if arf == '-' else arf
    dkim = set(_dkim_conf_domains())
    bulk['ready'] = {domain: bulk_ready(domain, dkim) for domain in sorted({item.rpartition('@')[2] for item in bulk['senders']} | _own_domains())} \
        if bulk['enabled'] else {}
    state['bulk'] = bulk
    on = bulk['enabled']
    transports = bulk_transports(bulk)
    if on:
        for name, options in transports.items():
            subprocess.run(['postconf', '-M', f'{name}/unix={name} unix - - n - - smtp'], check=True, capture_output=True)
            subprocess.run(['postconf', '-P', f'{name}/unix/syslog_name=postfix/{name}'] +
                           [f'{name}/unix/{key}={value}' for key, value in options.items() if not key.startswith('destination_')], check=True, capture_output=True)
            for key, value in options.items():
                if key.startswith('destination_'):
                    _postconf_set(f'{name}_{key}', value)
            if not bulk.get('address'):
                subprocess.run(['postconf', '-PX', f'{name}/unix/smtp_bind_address', f'{name}/unix/smtp_helo_name'], check=False, capture_output=True)
        _write(BULK_HEADERS, bulk_header_lines(bulk))
    _postconf_set('milter_header_checks', map_list_value(_postconf('milter_header_checks'), f'regexp:{BULK_HEADERS}', on))
    # The single transport of 6.0.0.6 goes; the providers have their own now.
    _postconf_remove([f'{BULK_TRANSPORT}_{name}' for name in BULK_PACES['normal']])
    subprocess.run(['postconf', '-MX', f'{BULK_TRANSPORT}/unix'], check=False, capture_output=True)
    if not on:
        for name in transports:
            _postconf_remove([f'{name}_{key}' for key in BULK_PACES['normal']])
            subprocess.run(['postconf', '-MX', f'{name}/unix'], check=False, capture_output=True)
        if os.path.exists(BULK_HEADERS):
            os.remove(BULK_HEADERS)
    # ARF complaints: the feedback loop address goes to efa-arf (counts only, no mail is kept).
    if on and bulk.get('arf'):
        subprocess.run(['postconf', '-M', f'{BULK_ARF_SERVICE}/unix={BULK_ARF_MASTER}'], check=True, capture_output=True)
        _rule_map(BULK_ARF_TRANSPORT, [f"{bulk['arf']} {BULK_ARF_SERVICE}:"])
        _postconf_set('transport_maps', map_list_value(_postconf('transport_maps'), _map(BULK_ARF_TRANSPORT), True))
    elif _map(BULK_ARF_TRANSPORT) in _postconf('transport_maps'):
        _postconf_set('transport_maps', map_list_value(_postconf('transport_maps'), _map(BULK_ARF_TRANSPORT), False))
        subprocess.run(['postconf', '-MX', f'{BULK_ARF_SERVICE}/unix'], check=False, capture_output=True)
    _outbound_write(state)
    return bulk_status(None)


# G7-18: bulk sending with an own address. The bulk transports send from that address only (P7-10: an address that is gone
# makes the mail wait, it never leaves from the main address), with a HELO name of its PTR, one transport per big provider with
# its own pace; a warm-up doubles the recipients a day per provider from 50 (no limit from day 15); complaints come only as ARF
# reports to an own address (feedback loop of the providers, efa-arf) and are counted; statistics from the delivery log.
BULK_PROVIDER_PACES = {'google': {'destination_concurrency_limit': 2, 'destination_rate_delay': '1s', 'destination_recipient_limit': 50},
                       'microsoft': {'destination_concurrency_limit': 1, 'destination_rate_delay': '2s', 'destination_recipient_limit': 20},
                       'yahoo': {'destination_concurrency_limit': 1, 'destination_rate_delay': '2s', 'destination_recipient_limit': 30}}
BULK_ARF_SERVICE = 'efa-arf'
BULK_ARF_MASTER = 'efa-arf unix - n n - 2 pipe flags=Rq user=efa-web argv=/usr/bin/python3 /usr/local/sbin/efa-arf.py'
BULK_ARF_TRANSPORT = ETC + '/postfix/efa-arf-transport'
BULK_STAT_RE = re.compile(r'postfix/efabulk-(\w+)/smtp\[\d+\]: \w+: to=<[^>]*>.* status=(sent|deferred|bounced)')


def bulk_counts(text):
    """{provider: {sent, deferred, bounced}} of the delivery log lines of the bulk transports."""
    counts = {}
    for found in BULK_STAT_RE.finditer(text):
        counts.setdefault(found.group(1), {'sent': 0, 'deferred': 0, 'bounced': 0})[found.group(2)] += 1
    return counts


def bulk_transports(bulk):
    """{transport: {parameter: value}} for the bulk mode: one per provider and one for the rest, all from the own address."""
    found = {}
    for provider in list(BULK_PROVIDER_PACES) + ['other']:
        pace = BULK_PROVIDER_PACES.get(provider, BULK_PACES[bulk['pace']])
        options = {f'destination_{key.split("destination_", 1)[1]}': str(value) for key, value in pace.items()}
        if bulk.get('address'):
            options.update(smtp_bind_address=bulk['address'], smtp_helo_name=bulk.get('helo') or own_hostname())
        found[f'{BULK_TRANSPORT}-{provider}'] = options
    return found


def bulk_header_lines(bulk):
    names = list(BULK_PROVIDER_PACES) + ['other']
    return ''.join(f'/^X-eFa-Bulk: yes {name}$/ FILTER {BULK_TRANSPORT}-{name}:\n' for name in names) + f'/^X-eFa-Bulk: yes$/ FILTER {BULK_TRANSPORT}-other:\n'


def _bulk_address_check(address):
    """'' when the address is on this host, has a PTR and its name points back; else what is missing."""
    try:
        ip = ipaddress.ip_address(address)
    except ValueError:
        return 'not an IP address'
    done = subprocess.run(['ip', '-o', 'addr', 'show'], capture_output=True, text=True)
    if f' {ip}/' not in done.stdout:
        return f'{ip} is not an address of this server (add it to an interface first)'
    ptr = [item.rstrip('.').lower() for item in _dig(ip.reverse_pointer, 'PTR')[0]]
    if not ptr:
        return f'{ip} has no PTR record'
    if str(ip) not in _dig(ptr[0], 'AAAA' if ip.version == 6 else 'A')[0]:
        return f'{ptr[0]} does not point back to {ip}'
    return ''


def bulk_stats(args):
    """G7-18: what the bulk transports delivered in the last days, per provider (from the delivery log), and the complaints."""
    days = (getattr(args, 'days', '') or '7').strip()
    if not days.isdigit() or not 1 <= int(days) <= 30:
        raise EfaError('Days: 1 to 30.')
    now = time.time()
    lines = _platform().journal_window(now - int(days) * 86400, now, [f'postfix/efabulk-{name}/smtp' for name in ('google', 'microsoft', 'yahoo', 'other')], last=None)
    counts = bulk_counts('\n'.join(lines))
    complaint_days, senders = _safe(lambda: _lib('efa_redis').call([('HGETALL', 'efa:arf:days'), ('HGETALL', 'efa:arf:senders')]), [[], []])
    days_seen = dict(zip(complaint_days[::2], complaint_days[1::2]))
    return {'days': int(days), 'delivery': counts, 'complaints': {day: int(value) for day, value in sorted(days_seen.items())[-int(days):]},
            'complaint_senders': {key: int(value) for key, value in zip(senders[::2], senders[1::2])}}


def archive_status(_args):
    """The archive targets, and how many copies wait in the queue for each."""
    targets = _json_read(ARCHIVE_FILE, {'targets': []})['targets']
    try:
        rows = _queue_rows()
    except EfaError:
        rows = []
    return {'targets': [{**item, 'waiting': sum(1 for row in rows if item['address'] in row['rcpts'])} for item in targets]}


def archive_set(args):
    """An archive target: a journal address that gets a copy of each mail of its domains, delivered by SMTP to its host."""
    name = args.name.strip().lower()
    if not SUBMITTER_NAME_RE.match(name):
        raise EfaError('Name: up to 32 small letters, digits or _.')
    template = (args.template or 'smtp').strip()
    direction = (args.direction or 'both').strip()
    tls = (args.tls or 'encrypt').strip()
    address = args.address.strip().lower()
    host = args.host.strip().lower()
    port = (args.port or '25').strip()
    if template not in ARCHIVE_TEMPLATES or direction not in ARCHIVE_DIRECTIONS or tls not in ARCHIVE_TLS_LEVELS:
        raise EfaError('Template: mailstore, piler or smtp; direction: in, out or both; TLS: verify, encrypt or may.')
    if not SENDER_RE.match(address):
        raise EfaError('Address: the journal address of the archive.')
    if not HOST_RE.match(host) or ':' in host or not port.isdigit() or not 1 <= int(port) <= 65535:
        raise EfaError('Host and port of the archive, such as archive.example.org and 25.')
    own = _own_domains()
    domains = sorted({item.strip().lower() for item in re.split(r'[\s,;]+', args.domains or '') if item.strip()})
    if any(domain not in own for domain in domains):
        raise EfaError('Domains: only domains of this server; empty for all of them.')
    if address.rpartition('@')[2] in own:
        raise EfaError('The journal address must not be in a domain of this server: the copies would be archived again.')
    form = (getattr(args, 'format', '') or 'copy').strip()
    if form not in ARCHIVE_FORMATS:
        raise EfaError('Format: copy (a copy of each mail) or journal (a report with the envelope around each mail).')
    state = _json_read(ARCHIVE_FILE, {'targets': []})
    targets = [item for item in state['targets'] if item['name'] != name] + [
        {'name': name, 'template': template, 'address': address, 'host': host, 'port': int(port), 'direction': direction, 'tls': tls,
         'domains': domains, 'format': form}]
    _archive_apply(targets)
    _json_write(ARCHIVE_FILE, {'targets': sorted(targets, key=lambda item: item['name'])})
    _content_apply(content_state())
    subprocess.run(['postfix', 'reload'], check=False, capture_output=True)
    return archive_status(None)


def archive_remove(args):
    """Removes an archive target. Copies still in the queue are delivered."""
    _confirm(args)
    state = _json_read(ARCHIVE_FILE, {'targets': []})
    targets = [item for item in state['targets'] if item['name'] != args.name.strip().lower()]
    if len(targets) == len(state['targets']):
        raise EfaError('No such archive target.')
    _archive_apply(targets)
    _json_write(ARCHIVE_FILE, {'targets': targets})
    _content_apply(content_state())
    return archive_status(None)


ARCHIVE_TEST_SECONDS = 1


def archive_test(args):
    """Test the way to an archive before it gets mail: SMTP, STARTTLS, and the certificate against the system CAs and the host
    name. Each step waits about a second; nothing is sent, the test ends with QUIT."""
    host, port = (args.host or '').strip().lower(), (args.port or '25').strip()
    if not HOST_RE.match(host) or ':' in host or not port.isdigit() or not 1 <= int(port) <= 65535:
        raise EfaError('Host and port of the archive, such as archive.example.org and 25.')
    found = {'host': host, 'port': int(port), 'connect': False, 'starttls': False, 'verified': False, 'error': ''}
    started = time.monotonic()
    try:
        with smtplib.SMTP(host, int(port), timeout=ARCHIVE_TEST_SECONDS, local_hostname=own_hostname()) as smtp:
            found['connect'] = True
            smtp.ehlo()
            if not smtp.has_extn('starttls'):
                found['error'] = 'The archive offers no STARTTLS.'
            else:
                found['starttls'] = True
                smtp.starttls(context=ssl.create_default_context())
                found['verified'] = True
                found['tls'] = smtp.sock.version()
            smtp.quit()
    except ssl.SSLCertVerificationError as err:
        found['error'] = f'Certificate not valid for {host}: {err.verify_message}'[:200]
    except (OSError, smtplib.SMTPException) as err:
        found['error'] = (str(err) or type(err).__name__)[:200]
    found['ms'] = int((time.monotonic() - started) * 1000)
    return found


def _rule_group_members(group_dn):
    """Addresses of a directory group, each time the rules are written. Without LDAP a group holds nobody."""
    state = _json_read(LDAP_FILE, {})
    if not state.get('ldap'):
        return []
    with tempfile.NamedTemporaryFile('w', dir='/run', prefix='efa-ldap-') as service:
        service.write(state['bind_password'])
        service.flush()
        done = subprocess.run(ldap_command('ldapsearch', state, state['bind_dn'], service.name) + ['-LLL', '-o', 'ldif-wrap=no', '-b', state['base'], f'(memberOf={ldap_filter_escape(group_dn)})', 'mail'],
                              capture_output=True, text=True, timeout=20)
    return sorted({line.split(':', 1)[1].strip().lower() for line in done.stdout.splitlines() if line.lower().startswith('mail:')})


def _rule_tenant_domains(name):
    return [row['domain'] for row in _admin_query('SELECT domain FROM tenant_domains WHERE tenant_id = %s', (_tenant_id(name),))]


def _rules():
    return _json_read(RULES_FILE, {'rules': []})['rules']


def _rule_map(path, lines):
    if lines:
        _write(path, '\n'.join(lines) + '\n')
        subprocess.run(['postmap', _map(path)], check=True, capture_output=True)
    else:
        for item in _map_files(path):
            if os.path.exists(item):
                os.remove(item)


def layer_value(name, value):
    """The checked form of a value, as stored."""
    value = value.strip()
    if name in ('spam_mark', 'spam_reject'):
        try:
            number = float(value)
        except ValueError:
            raise EfaError('Spam limits are numbers.')
        if not 0 < number <= 1000:
            raise EfaError('Spam limits: above 0, up to 1000.')
        return f'{number:g}'
    if name == 'headers_store':
        if value not in ('on', 'off'):
            raise EfaError('Store headers: on or off.')
        return value
    if name in ('quarantine_days', 'digest_hour', 'headers_days'):
        low, high = (0, 23) if name == 'digest_hour' else (1, 3650)
        if not value.isdigit() or not low <= int(value) <= high:
            raise EfaError(f'{name}: {low} to {high}.')
        return str(int(value))
    if name == 'digest_text':
        if len(value) > 1000 or any(ord(ch) < 32 and ch not in '\n' for ch in value):
            raise EfaError('Digest text: up to 1000 characters, no control characters.')
        return value
    if name == 'tls':
        if value not in TLS_LEVELS:
            raise EfaError('TLS: ' + ', '.join(TLS_LEVELS))
        return value
    if value not in LANGUAGES:
        raise EfaError('Language: ' + ', '.join(LANGUAGES))
    return value


def layer_effective(domain, tenant_id, rows, defaults):
    """{name: (value, source)} for a domain, or for a tenant when domain is None."""
    found = {}
    for name in LAYER_SETTINGS:
        if domain is not None and name in rows.get(('domain', domain), {}):
            found[name] = (rows[('domain', domain)][name], 'domain')
        elif tenant_id is not None and name in rows.get(('tenant', str(tenant_id)), {}):
            found[name] = (rows[('tenant', str(tenant_id))][name], 'tenant')
        else:
            found[name] = (defaults.get(name, ''), 'global')
    return found


def layer_domains(rows, tenant_domains):
    """Every domain that has a value of its own or of its tenant: {domain: tenant_id}."""
    tenant_of = {domain: tenant for tenant, domains in tenant_domains.items() for domain in domains}
    found = {target: tenant_of.get(target) for level, target in rows if level == 'domain'}
    for level, target in rows:
        if level == 'tenant' and target.isdigit():
            found.update({domain: int(target) for domain in tenant_domains.get(int(target), ())})
    return found


def layer_spam_rules(rows, tenant_domains):
    """One rspamd settings rule per domain with own spam limits; what it does not set stays global."""
    found = []
    for domain, tenant in sorted(layer_domains(rows, tenant_domains).items()):
        values = layer_effective(domain, tenant, rows, {})
        mark, reject = values['spam_mark'], values['spam_reject']
        if mark[1] == 'global' and reject[1] == 'global':
            continue
        found.append({'name': 'layer_' + re.sub(r'[^a-z0-9]', '_', domain), 'kind': 'domain', 'value': domain, 'priority': LAYER_RULE_PRIORITY,
                      'reject': reject[0] if reject[1] != 'global' else '', 'add_header': mark[0] if mark[1] != 'global' else '',
                      'greylist': '', 'quarantine': False, 'route': '', 'enabled': True})
    return found


def layer_tls_lines(rows, tenant_domains):
    return [f"{domain} {layer_effective(domain, tenant, rows, {})['tls'][0]}" for domain, tenant in sorted(layer_domains(rows, tenant_domains).items())
            if layer_effective(domain, tenant, rows, {})['tls'][1] != 'global']


HEADERS_POLICY_FILE = ETC + '/efa-web/headers-policy.json'
HEADERS_MAX = 65536
HEADERS_FREE_MIN = 0.1
EXPORTER_CONF = RSPAMD_DIR + '/local.d/metadata_exporter.conf'
# The fields efa-maillog reads, plus the raw header block; no second pass over the mail anywhere.
EXPORTER_TEXT = """# Written by efactl maillog-setup. Do not edit: the next upgrade replaces it.
custom_format {
  efa_json = <<EOD
-- 5v (j): links and attachment hashes only while the check after delivery is on (efactl retro-set writes the flag).
local retro = io.open('/etc/rspamd/efa-retro.on', 'r')
if retro then retro:close() end
local sha = require "rspamd_cryptobox_hash"
return function(task)
  local ucl = require "ucl"
  local r = {}
  if retro then
    r.urls, r.files = {}, {}
    for _, u in ipairs(task:get_urls() or {}) do if #r.urls < 50 then table.insert(r.urls, tostring(u:get_text())) end end
    for _, p in ipairs(task:get_parts() or {}) do
      local size = p:get_length() or 0
      if #r.files < 20 and p:get_filename() and size > 0 and size <= 20971520 then table.insert(r.files, sha.create_specific('sha256', p:get_content()):hex()) end
    end
  end
  local ip = task:get_from_ip()
  r.ip = (ip and ip:is_valid()) and tostring(ip) or 'unknown'
  r.qid = task:get_queue_id() or 'unknown'
  r.subject = task:get_subject() or ''
  r.action = task:get_metric_action()
  r.score = task:get_metric_score()[1]
  r.unix_time = task:get_date({format = 'connect', gmt = true})
  r.message_id = task:get_message_id()
  r.size = task:get_size()
  local from = task:get_from('smtp')
  r.from = (from and from[1] and from[1].addr) or 'unknown'
  r.rcpt = {}
  for _, a in ipairs(task:get_recipients('smtp') or {}) do table.insert(r.rcpt, a.addr) end
  r.symbols = {}
  for _, s in ipairs(task:get_symbols_all() or {}) do table.insert(r.symbols, {name = s.name, score = s.score, options = s.options}) end
  local raw = task:get_raw_headers()
  local text = raw and tostring(raw) or ''
  r.headers_size = #text
  r.headers = text:sub(1, %(max)d)
  return ucl.to_format(r, 'json-compact')
end
EOD;
}
rules {
  EFA_MAILLOG {
    backend = "http";
    url = "http://127.0.0.1:8906/";
    formatter = "efa_json";
    selector = "default";
  }
}
""" % {'max': HEADERS_MAX}


def headers_policy():
    stored = _json_read(PRIVACY_FILE, {})
    return {'store': stored.get('store_headers', True), 'days': int(stored.get('headers_days', 30))}


def _exporter_write():
    """The metadata exporter with the raw headers. Taken back if rspamd does not take it."""
    previous = open(EXPORTER_CONF).read() if os.path.exists(EXPORTER_CONF) else None
    if previous == EXPORTER_TEXT:
        return
    _write(EXPORTER_CONF, EXPORTER_TEXT)
    if not _rspamd_config_ok():
        if previous is None:
            os.remove(EXPORTER_CONF)
        else:
            _write(EXPORTER_CONF, previous)
        raise EfaError('rspamd rejected the metadata exporter, it stays as it was.')
    _reload_rspamd()


def headers_store_set(args):
    """Store the headers of all mail, and for how many days. On by default; tenants and domains can differ."""
    days = (args.days or '').strip()
    if days and (not days.isdigit() or not 1 <= int(days) <= 3650):
        raise EfaError('Days: 1 to 3650.')
    stored = _json_read(PRIVACY_FILE, {})
    stored['store_headers'] = _on_off(args.mode)
    if days:
        stored['headers_days'] = int(days)
    _json_write(PRIVACY_FILE, stored)
    _headers_policy_write()
    return headers_policy()


def _headers_policy_write():
    """What efa-maillog needs to know without the database: stored at all, and the domains that keep none."""
    rows, tenant_domains = _layer_rows(), _tenant_domains()
    off = sorted(domain for domain, tenant in layer_domains(rows, tenant_domains).items()
                 if layer_effective(domain, tenant, rows, {'headers_store': 'on'})['headers_store'][0] == 'off')
    wanted = {'store': headers_policy()['store'], 'off': off}
    if _json_read(HEADERS_POLICY_FILE, None) != wanted:
        _json_write(HEADERS_POLICY_FILE, wanted)
        os.chmod(HEADERS_POLICY_FILE, 0o640)
        shutil.chown(HEADERS_POLICY_FILE, 'root', 'efa-web')


def _headers_job(today, state):
    """Hourly: deletes headers past their days, per domain; warns once a day when the disk is nearly full."""
    _headers_policy_write()
    rows, tenant_domains = _layer_rows(), _tenant_domains()
    policy = headers_policy()
    own = {domain: int(layer_effective(domain, tenant, rows, {'headers_days': str(policy['days'])})['headers_days'][0])
           for domain, tenant in layer_domains(rows, tenant_domains).items()}
    own = {domain: days for domain, days in own.items() if days != policy['days']}
    for table in ('mail_headers', 'mail_evidence'):
        for domain, days in own.items():
            _admin_query(f'DELETE FROM {table} WHERE domain = %s AND ts < NOW() - INTERVAL %s DAY LIMIT 50000', (domain, days))
        where = ' AND domain NOT IN (' + ','.join(['%s'] * len(own)) + ')' if own else ''
        _admin_query(f'DELETE FROM {table} WHERE ts < NOW() - INTERVAL %s DAY{where} LIMIT 50000', (policy['days'], *own))
    # A record set nobody saw for longer than the longest retention belongs to no stored mail any more.
    _admin_query('DELETE FROM dns_records WHERE last_seen < NOW() - INTERVAL %s DAY LIMIT 50000', (max([policy['days'], *own.values()]),))
    usage = shutil.disk_usage('/var/lib/mysql')
    if usage.free / usage.total < HEADERS_FREE_MIN and state.get('headers_disk_alert') != today.isoformat():
        state['headers_disk_alert'] = today.isoformat()
        _event('headers_disk_full', 'error')
        _admin_notify('eFa-next: headers are not stored, the disk is nearly full',
                      f'Less than {int(HEADERS_FREE_MIN * 100)} % of the disk of the database is free. Mail still flows; headers are stored again once there is room.')


def headers_parse(text):
    """(name, value) of each header, folded lines joined, in order."""
    found = []
    for line in text.replace('\r\n', '\n').split('\n'):
        if line[:1] in (' ', '\t') and found:
            found[-1] = (found[-1][0], found[-1][1] + ' ' + line.strip())
        elif ':' in line:
            name, _sep, value = line.partition(':')
            found.append((name.strip(), value.strip()))
    return found


def received_path(headers):
    """The Received lines from the first hop to the last, with the seconds each hop took."""
    hops = []
    for name, value in reversed(headers):
        if name.lower() != 'received':
            continue
        stamp = None
        when = value.rsplit(';', 1)[1].strip() if ';' in value else ''
        try:
            stamp = email.utils.parsedate_to_datetime(when).timestamp() if when else None
        except (TypeError, ValueError, IndexError):
            stamp = None
        hops.append({'hop': value.split(';', 1)[0][:300], 'time': when[:60], 'seconds': None if stamp is None or not hops or hops[-1]['_ts'] is None
                     else round(stamp - hops[-1]['_ts']), '_ts': stamp})
    for hop in hops:
        hop.pop('_ts')
    return hops


AUTH_HEADERS = ('authentication-results', 'arc-authentication-results', 'arc-seal', 'arc-message-signature', 'dkim-signature', 'received-spf')


