        globals().update(saved_re)
        # 6.0.0.7: a code by mail instead of the lost app, only to set up a new one (Hans 2026-11-16).
        names_em = ('_admin_query', '_audit', '_account_mail', 'identity_now', 'strict_record', 'own_hostname', '_totp_row', 'TOTP_KEY',
                    'EMAIL_RECOVERY_FILE', '_load_identity', '_secrets', 'totp_policy', '_2fa_mail', 'acting_client')
        saved_em = {name: globals()[name] for name in names_em}
