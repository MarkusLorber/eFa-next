        # 6.0.0.6: allow or block the sender of one mail (mail log, live log, quarantine): checks, refusals, undo and audit.
        saved_sa = {name: globals()[name] for name in ('_local_domains', '_blocklist_allow', '_blocklist_state', 'blocklist_entry', '_audit', 'identity_now')}
        audited, blocked = [], []
        globals().update(_local_domains=lambda: ['example.com'], _blocklist_allow=lambda: [ipaddress.ip_network('198.51.100.0/24')], _audit=audited.append,
                         _blocklist_state=lambda: {'lists': {'own1': {'kind': 'own', 'enabled': True}, 'talos': {'kind': 'feed', 'enabled': True}}, 'entries': {'own1': {}}},
                         blocklist_entry=lambda item: blocked.append((item.name, item.action, item.addresses)))
        try:
            def sa(**values):
                return ns(**{'value': '', 'list': 'allow', 'recipients': '', 'qid': '', 'action': 'add', 'confirm': '', **values})
            plan = sender_action_check(sa(value='Spam@Example.net', list='block', qid='ABC123DEF'))
            assert plan['entry'] == 'spam@example.net' and plan['target_text'] == 'the global block list' and not plan['warnings'], plan
