                {'domain': 'x.org', 'selector': 'efa-ed25519', 'public': ('ed25519', ''), 'purpose': 'dkim', 'state': 'active', 'path': tmp + '/none'}]
        signing = _report_signing([{'kind': 'dkim', 'domain': 'x.org', 'selector': 'efa-rsa', 'n': 3}, {'kind': 'dkim', 'domain': 'x.org', 'selector': 'efa-ed25519', 'n': 2},
                                   {'kind': 'arc', 'domain': 'x.org', 'selector': 'efa-arc', 'n': 1}, {'kind': 'unsigned', 'domain': 'x.org', 'selector': '', 'n': 4}],
                                  keys, [{'domain': 'x.org', 'next_rotation': '2027-02-01', 'auto_rotate': True}])
        assert signing == [{'domain': 'x.org', 'rsa': 3, 'ed25519': 2, 'arc': 1, 'unsigned': 4, 'key_age_days': None, 'next_rotation': '2027-02-01',
                            'auto_rotate': True}], signing
        auth = _report_auth([{'domain': 'a.org', 'spf': 'pass', 'dkim': 'fail', 'dmarc': 'fail', 'arc': '', 'n': 2},
                             {'domain': 'a.org', 'spf': 'pass', 'dkim': 'pass', 'dmarc': 'pass', 'arc': 'pass', 'n': 5}])
        assert auth == [{'domain': 'a.org', 'mails': 7, 'dkim_fail': 2, 'dmarc_fail': 2, 'arc_none': 2}], auth
        assert report_domains(['a.org', 'b.org'], 'B.org') == ['b.org'] and report_domains(None, '') is None and report_domains(['a.org'], '') == ['a.org']
        rejected(lambda item: report_domains(['a.org'], item), 'c.org')
        page = report_html({'from': '2026-11-04', 'to': '2026-11-04', 'total': 7, 'actions': {}, 'failed_checks': {}, 'per_day': [], 'top_blocked_senders': [],
                            'top_targets': [], 'auth_by_sender_domain': auth, 'top_failing_sources': [], 'signing': signing, 'tls': tls,
                            'dmarc_aggregate': [{'domain': 'x.org', 'reports': 2}]})
        assert 'Outbound signing by own domain' in page and 'RSA 3, Ed25519 2, ARC seals 1, unsigned 4' in page and 'TLSv1.3 TLS_AES_128_GCM_SHA256' in page
        assert 'DMARC aggregate reports received' in page and 'TLS reports received' not in page
        with open(REPORT_LOG, 'a') as f:
            f.write(f'{head}/smtpd[1]: connect from d.example[192.0.2.5]\n')
        mailreport_run(ns())
        assert mailreport_today(ns())['summary']['smtp_connections'] == 3 and mailreport_today(ns())['summary']['received'] == 1
        assert _report_day('Dec', '31', datetime.date(2027, 1, 1)) == '2026-12-31' and _report_day('Jan', '1', datetime.date(2027, 1, 1)) == '2027-01-01'
        assert mailreport_yesterday(ns())['summary']['received'] == 0 and mailreport_week(ns())['summary']['received'] == 1
        rejected(lambda item: mailreport_set(item), ns(mode='x'))
    print('self-test ok')


