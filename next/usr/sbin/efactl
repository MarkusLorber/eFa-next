        # An eFa 5 host may carry its name in capitals (hostname -f, myhostname); DNS is case-insensitive.
        globals().update(ACME_FILE=tmp + '/le/acme.json', _postconf=lambda name: 'MX.Example.ORG' if name == 'myhostname' else '',
