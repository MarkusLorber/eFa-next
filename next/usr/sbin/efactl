        # The release check: a private repository is a state, an unchanged release a 304, a new one only available once its packages check out.
        class Reply(io.BytesIO):
            def __init__(self, data, etag=None):
                super().__init__(json.dumps(data).encode())
                self.headers = {'ETag': etag}

            def __enter__(self):
                return self

            def __exit__(self, *rest):
                return False
        sent = []

        def answer(code, data=None, etag=None):
            def opener(request, timeout):
                sent.append(dict(request.header_items()))
                if code != 200:
                    raise urllib.error.HTTPError(UPDATE_API, code, 'x', {}, None)
                return Reply(data, etag)
            return opener
        state = {'latest': None, 'notes': None, 'etag': None}
        assert _update_fetch_latest(state, answer(404)) is False and state['source'] == 'not reachable' and 'private' in state['last_result']
        release = {'tag_name': 'v99.0.0.1', 'body': 'Fixes CVE-2026-1234 in the parser.', 'published_at': '2026-11-10T08:00:00Z', 'name': 'eFa-next 99'}
        assert _update_fetch_latest(state, answer(200, release, '"abc"')) and state['security'] and state['published'] == '2026-11-10' and state['etag'] == '"abc"'
        assert _update_fetch_latest(state, answer(304)) is False and sent[-1].get('If-none-match') == '"abc"' and state['latest'] == 'v99.0.0.1'
        assert 'eFa-next' == sent[-1].get('User-agent'), 'no version or host in the request'
        assert not _update_available(state), 'not available before the packages are checked'
        def broken(version, folder):
            raise EfaError('Checksum of eFa-99 does not match, nothing was installed.')
        globals()['UPDATE_DIR'], saved_dir = tmp, UPDATE_DIR
        # The installed version of a test, not the one of the host (a half installed host has none).
        globals()['_update_installed'], kept_installed = (lambda: 'eFa-6.0.0.4'), _update_installed
        _update_verify(state, broken)
        assert not _update_available(state) and 'does not match' in state['last_result']
        _update_verify(state, lambda version, folder: [])
        assert _update_available(state) and state['first_seen_version'] == 'v99.0.0.1'
        globals()['UPDATE_DIR'], globals()['_update_installed'] = saved_dir, kept_installed
        assert not release_info({'tag_name': 'v1', 'body': 'Faster search.'})['security']
        # Unsigned or wrongly signed SHA256SUMS from repository and mirror: nothing counts as verified.
        sign_lib = _lib('efa_sign')
        kept_key, sign_lib.KEY_FILE = sign_lib.KEY_FILE, tmp + '/key.asc'
        _write(sign_lib.KEY_FILE, 'not a key')
        asked = []
        try:
            _signed_sums('v99.0.0.1', lambda url: asked.append(url) or b'00  eFa-99.0.0.1-1.noarch.rpm\n')
            raise AssertionError('unsigned sums accepted')
        except EfaError as err:
