        class GeoReply(io.BytesIO):
            def __init__(self, status, data=b''):
                super().__init__(data)
                self.status = status

        class GeoConnection:
            def __init__(self, replies):
                self.replies, self.asked = replies, []

            def request(self, method, path, headers=None):
                self.asked.append(path)

            def getresponse(self):
                return self.replies.pop(0)
        fake = GeoConnection([GeoReply(404), GeoReply(200, gzip.compress(asn_db)), GeoReply(500)])
        assert _geoip_fetch(fake, 'asn', '2026-11', f'{tmp}/geo-get.mmdb') is False
        assert _geoip_fetch(fake, 'asn', '2026-10', f'{tmp}/geo-get.mmdb') is True and open(f'{tmp}/geo-get.mmdb', 'rb').read() == asn_db
        try:
            _geoip_fetch(fake, 'asn', '2026-09', f'{tmp}/geo-get.mmdb')
            raise AssertionError('HTTP 500 is an error')
        except OSError:
            pass
        assert fake.asked == ['/free/dbip-asn-lite-2026-11.mmdb.gz', '/free/dbip-asn-lite-2026-10.mmdb.gz', '/free/dbip-asn-lite-2026-09.mmdb.gz']
        kept_max = GEOIP_MAX
        globals()['GEOIP_MAX'] = 1024
