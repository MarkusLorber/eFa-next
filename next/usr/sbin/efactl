# Counts per day in a Redis hash, read hourly by mailreport-run into MariaDB. Fire and forget: mail flow never waits on it.
EFA_COUNT_LUA = '''local function efa_count(task, field)
  local redis = require('rspamd_redis')
  local key = 'efa:sign:' .. os.date('%Y-%m-%d')
  local function done() end
  redis.make_request({task = task, host = '127.0.0.1:6379', cmd = 'HINCRBY', args = {key, field, '1'}, callback = done})
  redis.make_request({task = task, host = '127.0.0.1:6379', cmd = 'EXPIRE', args = {key, '1209600'}, callback = done})
end
'''
SIGN_KEY = 'efa:sign:'
# Neither header is among those ARC or DKIM sign. A header from outside goes first, so only this server's own one stays.
EFA_HEADER_ROUTINES = {
    'efa-arc-sealer': '''  efa-arc-sealer = <<EOD
''' + EFA_VERSION_LUA + EFA_COUNT_LUA + '''return function(task, common_meta)
  local remove = {['X-eFa-next-ARC-Sealer'] = 0}
  local seal = task:get_symbol('ARC_SIGNED')
  local options = seal and seal[1] and seal[1].options
  local domain, selector, instance = ((options and options[1]) or ''):match('^(.-):s=(.-):i=(%d+)$')
  if not domain then return nil, {}, remove, {} end
  efa_count(task, 'arc|' .. domain .. '|' .. selector)
  local value = string.format('eFa-next/%s; host=%s; i=%s; d=%s; s=%s', version, require('rspamd_util').get_hostname(), instance, domain, selector)
  return nil, {['X-eFa-next-ARC-Sealer'] = value}, remove, {}
end
EOD;
''',
    'efa-dkim-signer': '''  efa-dkim-signer = <<EOD
''' + EFA_VERSION_LUA + EFA_COUNT_LUA + '''return function(task, common_meta)
  local remove = {['X-eFa-next-DKIM-Signer'] = 0}
  if not task:has_symbol('DKIM_SIGNED') then
    -- Sent by a logged in user or from an internal network, but not signed: worth a look in the report.
    local ip = task:get_from_ip()
    local from = task:get_from('mime')
    local domain = from and from[1] and from[1].domain
    if domain and domain ~= '' and (task:get_user() or (ip and ip:is_valid() and ip:is_local())) then
      efa_count(task, 'unsigned|' .. domain:lower() .. '|')
    end
    return nil, {}, remove, {}
  end
  local signed = task:get_symbol('DKIM_SIGNED')
  for _, option in ipairs((signed and signed[1] and signed[1].options) or {}) do
    local domain, selector = option:match('^(.-):s=(.+)$')
    if domain then efa_count(task, 'dkim|' .. domain:lower() .. '|' .. selector) end
  end
  return nil, {['X-eFa-next-DKIM-Signer'] = 'eFa-next DKIM Signer Version ' .. version}, remove, {}
end
EOD;
''',
}
ROTATION_INTERVALS = (3, 6, 12, 24)
ROTATION_MAX_MONTHS = 24
ROTATION_GRACE_DAYS = 7
ROTATION_THRESHOLD = 2
RUF_WARNING = ('Privacy: failure reports (ruf) can contain personal data such as message headers, addresses and parts '
               'of message content. Under the GDPR a legal basis and a processing agreement with the report receiver '
               'may be needed. Many receivers do not send them at all.')
P_NONE_HINT = ('p=none only monitors. Read the aggregate reports, and move to quarantine and then reject once all '
               'legitimate mail passes.')
DOMAIN_RE = re.compile(r'^([a-z0-9]([a-z0-9-]*[a-z0-9])?\.)+[a-z]{2,}$')
SMARTHOST_RE = re.compile(r'^\[?[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?\]?(:[0-9]{1,5})?$')
SENDER_RE = re.compile(r'^[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,}$')
HOST_RE = re.compile(r'^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?(:[0-9]{1,5})?$')
BACKUP_NAME_RE = re.compile(r'^efa-backup-(upload-|config-)?\d{8}-\d{6}\.tar\.gz(\.gpg)?$')
SERVICE_RE = re.compile(r'^[A-Za-z0-9][A-Za-z0-9@._-]{0,100}$')
SELECTOR_RE = re.compile(r'^[A-Za-z0-9][A-Za-z0-9_-]{0,62}$')
RULE_FROM_RE = re.compile(r'^[A-Za-z0-9._%+=@:*-]{1,255}$')
QUEUE_ID_RE = re.compile(r'^[A-Za-z0-9]{6,32}$')
ORG_RE = re.compile(r'^[A-Za-z0-9 ]{1,64}$')
TAG_RE = re.compile(r'^[\]\[A-Za-z0-9 _:.*!-]{1,40}$')


class EfaError(Exception):
    pass


def _rspamd_user():
    return '_rspamd'


def _own_key(path):
    shutil.chown(path, 'root', _rspamd_user())


def _today():
    return datetime.date.today()


def _json_read(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except FileNotFoundError:
        return default


def _json_write(path, data, mode=0o640):
    # shortcut: no lock, the daily timer and an admin could overwrite each other; add one if that ever matters.
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + '.tmp'
    # Only for root while it is written: some of these files hold passwords and keys (mode 0600).
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    os.fchmod(fd, 0o600)
    with os.fdopen(fd, 'w') as f:
        json.dump(data, f, indent=2, sort_keys=True)
        f.flush()
        os.fsync(f.fileno())
    os.chmod(tmp, mode)
    os.replace(tmp, path)


def _reload_rspamd():
    subprocess.run(['systemctl', 'reload', 'rspamd'], check=False, capture_output=True)


def _postconf(name):
    return subprocess.run(['postconf', '-h', name], capture_output=True, text=True, check=True).stdout.strip()


def _postconf_set(name, value):
    main_cf = subprocess.run(['postconf', '-h', 'config_directory'], capture_output=True, text=True,
                             check=True).stdout.strip() + '/main.cf'
    backup = main_cf + '.efactl'
    shutil.copy2(main_cf, backup)
    try:
        subprocess.run(['postconf', '-e', f'{name} = {value}'], check=True)
        done = subprocess.run(['postfix', 'check'], capture_output=True, text=True)
        if done.returncode != 0:
            # A broken main.cf would stop mail at the next reload, so keep the working one.
            shutil.copy2(backup, main_cf)
            raise EfaError(f'postfix check failed, nothing changed: {done.stderr.strip()[:300]}')
    finally:
        os.remove(backup)
    subprocess.run(['systemctl', 'reload', 'postfix'], check=False, capture_output=True)


def _write(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, 'w') as f:
        f.write(text)
    os.chmod(path, 0o644)


def _read_lines(path):
    try:
        with open(path) as f:
            return [line.strip() for line in f if line.strip()]
    except FileNotFoundError:
        return []


def status(_args):
    """Service and milter state from the health service."""
    try:
        with urllib.request.urlopen(HEALTH_URL, timeout=5) as reply:
            return {**json.load(reply), 'dkim_rotation': _rotation_notices(), 'system_notices': _system_notices(),
                    'dkim_rotation_last_check': _rotation_state()['last_run'], 'dkim_rotation_next_check': _rotation_next_check()}
    except urllib.error.HTTPError as err:
        return {**json.load(err), 'dkim_rotation': _rotation_notices(), 'system_notices': _system_notices(),
                'dkim_rotation_last_check': _rotation_state()['last_run'], 'dkim_rotation_next_check': _rotation_next_check()}
    except OSError as err:
        raise EfaError(f'health service not reachable: {err}')


def subject_get(_args):
    """Text put in front of the subject of mail with a hard SPF, DKIM or DMARC failure."""
    try:
        with open(SUBJECT_TAG) as f:
            return {'subject_tag': f.readline().strip()}
    except FileNotFoundError:
        return {'subject_tag': ''}


def subject_set(args):
    """Set the subject marking; an empty text turns it off."""
    tag = args.text.strip()
    if not tag:
        if os.path.exists(SUBJECT_TAG):
            os.remove(SUBJECT_TAG)
        return {'subject_tag': ''}
    if not TAG_RE.match(tag):
        raise EfaError('Text: up to 40 letters, digits, spaces or [ ] _ : . * ! -')
    with open(SUBJECT_TAG, 'w') as f:
        f.write(tag + '\n')
    os.chmod(SUBJECT_TAG, 0o644)
    return {'subject_tag': tag}


# 5o: another system that signs for some domains hands its keys, their times and its DNS records to eFa-next
# (docs/api-dkim-provisioning.md). efa-dkim-api.py takes the calls on 8463 and hands each one to dkim-provision-apply.
PROVISION_FILE = ETC + '/eFa/dkim-provision.json'
PROVISION_DIR = ETC + '/eFa/dkim-api'
DKIM_PROVISIONED = DKIM_DIR + '/provisioned'
PROVISION_UNIT = 'efa-dkim-api'
PROVISION_USER = 'efa-dkim-api'
PROVISION_RATES = (60, 120, 300, 600, 1200)
PROVISION_MAX_DOMAINS = 500
PROVISION_CHANGED = []  # filled when a call stored or released something; the cluster journal looks at it
PROVISION_MODES = ('sign_here', 'signed_downstream')
# What a source may deliver; each its own right, so a DKIM source cannot set disclaimers and the other way round.
PROVISION_RIGHTS = ('dkim', 'disclaimer')
FAIL2BAN_DKIM_API_FILTER = ETC + '/fail2ban/filter.d/efa-dkim-api.conf'
FAIL2BAN_DKIM_API_JAIL = '[efa-dkim-api]\nenabled = true\nbackend = systemd\nfilter = efa-dkim-api\nport = 8463\nmaxretry = 30\nfindtime = 60\n'
# The own DKIM commands that would change a domain the source manages.
PROVISION_LOCKED = {'dkim-create', 'dkim-generate', 'dkim-generate-ed25519', 'dkim-remove', 'dkim-import', 'rotation-set', 'rotation-pregenerate', 'arc-set'}


def _provision_state():
    state = _json_read(PROVISION_FILE, {})
    state.setdefault('mode', 'off')
    state.setdefault('sources', {})
    state.setdefault('domains', {})
    return state


def _provision_write(state):
    _json_write(PROVISION_FILE, state)
    if os.path.exists(PROVISION_FILE) and _group_exists(PROVISION_USER):
        shutil.chown(PROVISION_FILE, 'root', PROVISION_USER)


def _group_exists(name):
    try:
        import grp
        grp.getgrnam(name)
        return True
    except (KeyError, ImportError):
        return False


def provision_managed(domain):
    """The source that manages a domain, or ''."""
    return _provision_state()['domains'].get(domain.strip().lower(), {}).get('source', '')


def provision_checksum(body):
    rest = {key: value for key, value in body.items() if key != 'checksum'}
    return 'sha256:' + hashlib.sha256(json.dumps(rest, sort_keys=True, separators=(',', ':')).encode()).hexdigest()


def _provision_time(value):
    if not value:
        return None
    try:
        return datetime.datetime.strptime(str(value), '%Y-%m-%dT%H:%M:%SZ').replace(tzinfo=datetime.timezone.utc)
    except ValueError:
        raise ValueError(f'time {str(value)[:30]}: like 2026-06-01T00:00:00Z')


def provision_check(body, source, sources):
    """The state of one domain as the source sent it: an error text (400/403) or None."""
    if not isinstance(body, dict):
        return 400, 'the state of a domain is a JSON object'
    domain = str(body.get('domain', '')).strip().lower()
    if not DOMAIN_RE.match(domain):
        return 400, 'domain: not a domain'
    allowed = sources[source].get('domains', [])
    if domain not in allowed:
        return 403, f'{domain} is not one of the domains of this source'
    if not isinstance(body.get('version'), int) or body['version'] < 0:
        return 400, 'version: a whole number'
    if body.get('mode') not in PROVISION_MODES:
        return 400, 'mode: sign_here or signed_downstream'
    selectors = body.get('selectors', [])
    if not isinstance(selectors, list) or (body['mode'] == 'sign_here' and not selectors) or len(selectors) > 20:
        return 400, 'selectors: for sign_here at least one, at most 20'
    for item in selectors:
        if not isinstance(item, dict) or not SELECTOR_RE.match(str(item.get('selector', ''))) or item.get('type') not in ('rsa', 'ed25519'):
            return 400, 'selector: name and type rsa or ed25519'
        if body['mode'] == 'sign_here' and 'PRIVATE KEY-----' not in str(item.get('private_key', '')):
            return 400, f"selector {item['selector']}: private_key in PEM"
        try:
            start, end = _provision_time(item.get('valid_from')), _provision_time(item.get('valid_until'))
        except ValueError as err:
            return 400, f"selector {item['selector']}: {err}"
        if start and end and end <= start:
            return 400, f"selector {item['selector']}: valid_until before valid_from"
    if body.get('checksum') != provision_checksum(body):
        return 400, 'checksum does not match'
    return None


def _provision_key_file(domain, item, folder):
    """The private key of a selector in the form rspamd reads; the type and size checked. Returns the path."""
    os.makedirs(folder, mode=0o750, exist_ok=True)
    fd, temp = tempfile.mkstemp(prefix='efa-prov-')
    with os.fdopen(fd, 'w') as f:
        f.write(item['private_key'])
    try:
        public = _dkim_public_read(temp)
        if not public or public[0] != item['type']:
            raise ValueError(f"selector {item['selector']}: the key is no {item['type']} key")
        if item['type'] == 'rsa' and (_key_bits(temp) or 0) not in DKIM_RSA_SIZES:
            raise ValueError(f"selector {item['selector']}: RSA keys of 2048, 3072 or 4096 bits only")
        path = f"{folder}/{domain}.{item['selector']}.key"
        if item['type'] == 'ed25519':
            # rspamd reads ED25519 as base64 of seed and public key.
            der = subprocess.run(['openssl', 'pkey', '-in', temp, '-outform', 'DER'], capture_output=True, check=True).stdout
            _write(path, base64.b64encode(der[-32:] + base64.b64decode(public[1])).decode() + '\n')
        else:
            shutil.copyfile(temp, path)
        _own_key(path)
        return path, public
    finally:
        os.remove(temp)


def _provision_active(domain, entry, now=None):
    """The selectors of a domain that sign now: valid now and seen in DNS by enough resolvers; until a new one is, the last one."""
    if entry.get('mode') != 'sign_here':
        return []
    now = now or datetime.datetime.now(datetime.timezone.utc)
    rotation = _rotation_state()
    resolvers = [value for value in rotation['resolvers'].values() if value]
    need = min(int(rotation.get('threshold') or 2), len(resolvers))
    valid = []
    for item in entry.get('selectors', []):
        start, end = _provision_time(item.get('valid_from')), _provision_time(item.get('valid_until'))
        if (start is None or start <= now) and (end is None or now < end):
            seen = len(_rotation_check(rotation, f"{item['selector']}._domainkey.{domain}", item.get('public', ''))[0]) if need else 0
            item['dns_visible'] = seen
            if seen >= need:
                valid.append(item['selector'])
    return valid or [name for name in entry.get('active', []) if name in {item['selector'] for item in entry.get('selectors', [])}]


def provision_refresh(state=None, write=True):
    """Sets which delivered selectors sign now; rewrites the rspamd settings when that changed. True if it changed."""
    state = state or _provision_state()
    changed = False
    for domain, entry in state['domains'].items():
        active = _provision_active(domain, entry)
        if active != entry.get('active'):
            entry['active'], changed = active, True
    if changed and write:
        _provision_write(state)
        _write_dkim_conf()
        _reload_rspamd()
    return changed


def provision_public(domain, entry):
    """What a GET shows of a domain: never a private key."""
    active = set(entry.get('active', []))
    rows = [{'selector': item['selector'], 'type': item['type'], 'public_key': item.get('public', ''), 'valid_from': item.get('valid_from'),
             'dns_visible': item.get('dns_visible', 0)} for item in entry.get('selectors', [])]
    return {'domain': domain, 'version': entry['version'], 'mode': entry['mode'], 'managed_by': entry['source'],
            'active': [row for row in rows if row['selector'] in active], 'waiting': [row for row in rows if row['selector'] not in active],
            'dns_check': entry.get('dns_check', {}), 'warnings': entry.get('warnings', [])}


def _provision_put(state, source, body):
    error = provision_check(body, source, state['sources'])
    if error:
        return error
    domain = body['domain'].strip().lower()
    old = state['domains'].get(domain)
    if old and old.get('source') != source:
        return 403, f'{domain} is managed by another source'
    if old and body['version'] < old['version']:
        return 409, f"version {body['version']} is lower than the stored {old['version']}"
    if old and body['version'] == old['version']:
        return 200, provision_public(domain, old)
    folder = f'{DKIM_PROVISIONED}/{domain}'
    selectors = []
    try:
        for item in body.get('selectors', []):
            row = {key: item.get(key) for key in ('selector', 'type', 'valid_from', 'valid_until')}
            if body['mode'] == 'sign_here':
                path, public = _provision_key_file(domain, item, folder)
                row.update(public=public[1], path=path)
            selectors.append(row)
    except (ValueError, subprocess.CalledProcessError) as err:
        return 400, str(err)
    keep = {row.get('path') for row in selectors}
    for path in glob.glob(f'{folder}/*.key'):
        if path not in keep:
            os.remove(path)
    entry = {'source': source, 'version': body['version'], 'mode': body['mode'], 'selectors': selectors,
             'dns': body.get('dns', {}) if isinstance(body.get('dns'), dict) else {}, 'updated': time.strftime('%Y-%m-%d %H:%M:%S'),
             'active': (old or {}).get('active', [])}
    entry['active'] = _provision_active(domain, entry)
    state['domains'][domain] = entry
    _provision_write(state)
    PROVISION_CHANGED.append(domain)
    _write_dkim_conf()
    _reload_rspamd()
    _event('dkim_provisioned', 'notice', source=source, domain=domain, version=body['version'], mode=body['mode'])
    return 200, provision_public(domain, entry)


def dkim_provision_apply(args):
    """For efa-dkim-api only: one call of a source, read from stdin as {method, domain, body}; answers {code, body}.
    Every call goes to the audit log, never a key."""
    result, call = _provision_apply(args)
    _audit(f"DKIM provisioning: {call.get('method', '?')} {str(call.get('domain') or '/')[:255]} by the source {args.source.strip()[:40]}: {result['code']}")
    return result


def _provision_apply(args):
    call = {}
    state = _provision_state()
    source = args.source.strip()
    if state['mode'] != 'on':
        return {'code': 403, 'body': {'error': 'the provisioning is off'}}, call
    if source not in state['sources']:
        return {'code': 401, 'body': {'error': 'unknown source'}}, call
    if 'dkim' not in (state['sources'][source].get('rights') or ['dkim']):
        return {'code': 403, 'body': {'error': 'this source has no right for dkim'}}, call
    try:
        call = json.loads(sys.stdin.read(3 * 1024 * 1024))
    except ValueError:
        return {'code': 400, 'body': {'error': 'no valid JSON'}}, call
    call = call if isinstance(call, dict) else {}
    method, domain = call.get('method'), str(call.get('domain') or '').strip().lower()
    mine = {name: entry for name, entry in state['domains'].items() if entry.get('source') == source}
    if method == 'GET' and not domain:
        return {'code': 200, 'body': {'domains': [provision_public(name, entry) for name, entry in sorted(mine.items())]}}, call
    if method == 'GET':
        return {'code': 200, 'body': provision_public(domain, mine[domain])} if domain in mine else {'code': 404, 'body': {'error': 'not delivered'}}, call
    if method == 'DELETE':
        if domain not in mine:
            return {'code': 404, 'body': {'error': 'not delivered'}}, call
        _provision_release(state, domain)
        return {'code': 200, 'body': {'domain': domain, 'managed_by': None}}, call
    if method == 'PUT':
        body = call.get('body')
        if isinstance(body, dict) and str(body.get('domain', '')).strip().lower() != domain:
            return {'code': 400, 'body': {'error': 'the domain in the body differs from the address'}}, call
        code, answer = _provision_put(state, source, body)
        return {'code': code, 'body': answer if code == 200 else {'error': answer}}, call
    if method == 'POST':
        items = (call.get('body') or {}).get('domains') if isinstance(call.get('body'), dict) else None
        if not isinstance(items, list) or len(items) > PROVISION_MAX_DOMAINS:
            return {'code': 413 if isinstance(items, list) else 400, 'body': {'error': f'domains: a list of at most {PROVISION_MAX_DOMAINS}'}}, call
        results = []
        for item in items:
            code, answer = _provision_put(_provision_state(), source, item)
            results.append({'code': code, **(answer if code == 200 else {'domain': str((item or {}).get('domain', ''))[:255], 'error': answer})})
        return {'code': 200, 'body': {'results': results}}, call
    return {'code': 405, 'body': {'error': 'GET, PUT, POST or DELETE'}}, call


def _provision_release(state, domain):
    """The domain goes back to eFa-next: its delivered keys become own imported keys, so mail stays signed."""
    entry = state['domains'].pop(domain)
    for item in entry.get('selectors', []):
        if item.get('path') and os.path.exists(item['path']) and item['selector'] in entry.get('active', []):
            os.makedirs(DKIM_IMPORTED, mode=0o750, exist_ok=True)
            os.replace(item['path'], f"{DKIM_IMPORTED}/{domain}.{item['selector']}.key")
    shutil.rmtree(f'{DKIM_PROVISIONED}/{domain}', ignore_errors=True)
    _provision_write(state)
    PROVISION_CHANGED.append(domain)
    _write_dkim_conf()
    _reload_rspamd()
    _event('dkim_provisioned', 'notice', source=entry.get('source'), domain=domain, released=True)


def dkim_provision_takeover(args):
    """A super-admin takes a domain back from its source; the keys stay and eFa-next manages them from now on."""
    _confirm(args)
    state = _provision_state()
    domain = args.domain.strip().lower()
    if domain not in state['domains']:
        raise EfaError(f'{domain} is not managed by a source.')
    source = state['domains'][domain]['source']
    _provision_release(state, domain)
    _audit(f'DKIM of {domain} taken back from the source {source} by {_dmarc_who()}')
    return {'domain': domain, 'taken_from': source}


def _provision_server_cert():
    """The own long-lived certificate of port 8463, so a pin on it stays valid (not the one of Let's Encrypt)."""
    crt, key = f'{PROVISION_DIR}/server.crt', f'{PROVISION_DIR}/server.key'
    os.makedirs(PROVISION_DIR, mode=0o750, exist_ok=True)
    if not os.path.exists(crt):
        name = _postconf('myhostname') or socket.getfqdn()
        subprocess.run(['openssl', 'req', '-x509', '-newkey', 'ec', '-pkeyopt', 'ec_paramgen_curve:P-256', '-nodes', '-days', '3650',
                        '-subj', f'/CN={name}', '-addext', f'subjectAltName=DNS:{name}', '-keyout', key, '-out', crt],
                       check=True, capture_output=True)
        os.chmod(key, 0o640)
    if _group_exists(PROVISION_USER):
        for path in (PROVISION_DIR, crt, key):
            shutil.chown(path, 'root', PROVISION_USER)
    return crt


def _cert_fingerprint(pem_path):
    done = subprocess.run(['openssl', 'x509', '-in', pem_path, '-noout', '-fingerprint', '-sha256'], capture_output=True, text=True)
    return done.stdout.strip().split('=', 1)[-1] if done.returncode == 0 else ''


def _provision_clients(state):
    """The certificates of all sources in one file: the server trusts exactly these."""
    pems = []
    for name in sorted(state['sources']):
        path = f'{PROVISION_DIR}/sources/{name}.crt'
        if os.path.exists(path):
            with open(path) as f:
                pems.append(f.read().strip())
    _write(f'{PROVISION_DIR}/clients.pem', '\n'.join(pems) + '\n')
    if _group_exists(PROVISION_USER):
        shutil.chown(f'{PROVISION_DIR}/clients.pem', 'root', PROVISION_USER)


def _provision_service(on):
    try:
        if on:
            _platform().service_enable(PROVISION_UNIT, start=True)
            _platform().service_restart(PROVISION_UNIT, check=False)
        else:
            _platform().service_disable(PROVISION_UNIT, stop=True)
    except Exception as err:  # the StepError of the platform layer
        raise EfaError(str(err))


def dkim_provision_status(_args):
    state = _provision_state()
    crt = f'{PROVISION_DIR}/server.crt'
    return {'mode': state['mode'], 'port': 8463, 'server_certificate_sha256': _cert_fingerprint(crt) if os.path.exists(crt) else '',
            'sources': [{'name': name, 'fingerprint': item.get('fingerprint', ''), 'domains': item.get('domains', []),
                         'addresses': item.get('addresses', []), 'rate': item.get('rate', 600)} for name, item in sorted(state['sources'].items())],
            'domains': [{'domain': name, 'source': entry['source'], 'mode': entry['mode'], 'version': entry['version'], 'active': entry.get('active', [])}
                        for name, entry in sorted(state['domains'].items())]}


def dkim_provision_set(args):
    """Switches the DKIM provisioning API on port 8463 on or off. Off keeps the delivered keys; they go on signing."""
    mode = _on_off(args.mode.strip())
    if mode and cluster_role() == 'client':
        raise EfaError('In a cluster only the master takes these calls.')
    state = _provision_state()
    state['mode'] = 'on' if mode else 'off'
    if mode:
        _provision_server_cert()
        _provision_clients(state)
        _write(FAIL2BAN_DKIM_API_FILTER, '[Definition]\nfailregex = efa-dkim-api login failed from <HOST>\njournalmatch = _SYSTEMD_UNIT=efa-dkim-api.service\n')
        if os.path.exists(FAIL2BAN_JAIL):
            with open(FAIL2BAN_JAIL) as f:
                jail = f.read()
            if '[efa-dkim-api]' not in jail:
                _write(FAIL2BAN_JAIL, jail.rstrip('\n') + '\n\n' + FAIL2BAN_DKIM_API_JAIL)
                _platform().service_try_restart('fail2ban')
    _provision_write(state)
    _provision_service(mode)
    return dkim_provision_status(None)


def dkim_source_set(args):
    """A source: its client certificate, its domains, the allowed addresses and calls per minute. A new token is shown once."""
    state = _provision_state()
    name = args.name.strip().lower()
    if not re.fullmatch(r'[a-z0-9][a-z0-9-]{0,40}', name):
        raise EfaError('Name: small letters, digits and dashes.')
    domains = sorted({item.strip().lower() for item in (args.domains or '').replace(',', ' ').split() if item.strip()})
    if not domains or any(not DOMAIN_RE.match(item) for item in domains):
        raise EfaError('Domains: one or more domains, separated by commas.')
    addresses = [item.strip() for item in (args.addresses or '').replace(',', ' ').split() if item.strip()]
    for item in addresses:
        try:
            ipaddress.ip_network(item, strict=False)
        except ValueError:
            raise EfaError(f'{item} is no address or network.')
    rate = int(args.rate or 600) if str(args.rate or '600').isdigit() else 0
    if rate not in PROVISION_RATES:
        raise EfaError('Calls per minute: 60, 120, 300, 600 or 1200.')
    source = state['sources'].get(name, {})
    if (args.cert or '').strip():
        with open(args.cert.strip()) as f:
            pem = f.read()
        if 'BEGIN CERTIFICATE' not in pem or len(pem) > 20000:
            raise EfaError('Certificate: a PEM file.')
        os.makedirs(f'{PROVISION_DIR}/sources', mode=0o750, exist_ok=True)
        _write(f'{PROVISION_DIR}/sources/{name}.crt', pem)
        source['fingerprint'] = _cert_fingerprint(f'{PROVISION_DIR}/sources/{name}.crt')
        if not source['fingerprint']:
            os.remove(f'{PROVISION_DIR}/sources/{name}.crt')
            raise EfaError('Certificate: openssl cannot read it.')
    if not source.get('fingerprint'):
        raise EfaError('A new source needs its client certificate (--cert).')
    token = None
    if not source.get('token_hash') or (args.new_token or '').strip() == 'yes':
        token = secrets.token_urlsafe(32)
        source['token_hash'] = hashlib.sha256(token.encode()).hexdigest()
    rights = sorted({item.strip() for item in (getattr(args, 'rights', '') or '').replace(',', ' ').split()}) or source.get('rights') or ['dkim']
    if not set(rights) <= set(PROVISION_RIGHTS):
        raise EfaError('Rights: dkim and/or disclaimer.')
    source.update(domains=domains, addresses=addresses, rate=rate, rights=rights)
    state['sources'][name] = source
    _provision_write(state)
    _provision_clients(state)
    if state['mode'] == 'on':
        _provision_service(True)
    result = {'source': name, 'fingerprint': source['fingerprint'], 'domains': domains, 'addresses': addresses, 'rate': rate, 'rights': rights}
    if token:
        result['token'] = token
        result['note'] = 'The token is shown only now. Store it in the source.'
    return result


def dkim_source_remove(args):
    state = _provision_state()
    name = args.name.strip().lower()
    if name not in state['sources']:
        raise EfaError(f'No source {name}.')
    if any(entry.get('source') == name for entry in state['domains'].values()):
        raise EfaError(f'{name} still manages domains: take them back first (dkim-provision-takeover).')
    del state['sources'][name]
    _provision_write(state)
    if os.path.exists(f'{PROVISION_DIR}/sources/{name}.crt'):
        os.remove(f'{PROVISION_DIR}/sources/{name}.crt')
    _provision_clients(state)
    if state['mode'] == 'on':
        _provision_service(True)
    return {'removed': name}


def _dkim_conf_domains():
    domains = {}
    managed = _provision_state()['domains']
    for key in sorted(glob.glob(f'{DKIM_IMPORTED}/*.key') + glob.glob(f'{DKIM_DIR}/*.key')):
        domain, selector = os.path.basename(key)[:-4].rsplit('.', 1)
        if domain not in managed:
            domains.setdefault(domain, []).append((key, selector))
    # 5o: a domain of a source signs only with its delivered keys, or not at all (signed_downstream).
    for domain, entry in managed.items():
        rows = [(item['path'], item['selector']) for item in entry.get('selectors', [])
                if item['selector'] in entry.get('active', []) and item.get('path') and os.path.exists(item['path'])]
        if rows:
            domains[domain] = rows
    return domains


def _write_dkim_conf():
    # Rebuilt from the key files so the config cannot drift from what is on disk.
    domains = _dkim_conf_domains()
    if not domains:
        text = 'enabled = false;\n'
    else:
        lines = ['allow_username_mismatch = true;', 'use_domain = "header";',
                 '# Keys belong to the exact domain, also for subdomains.', 'use_esld = false;', 'domain {']
        for domain, selectors in sorted(domains.items()):
            items = [f'      {{ path = "{key}"; selector = "{selector}"; }}' for key, selector in selectors]
            lines += [f'  {domain} {{', '    selectors [', ',\n'.join(items), '    ]', '  }']
        lines.append('}')
        text = '\n'.join(lines) + '\n'
    with open(DKIM_CONF, 'w') as f:
        f.write(text)
    _write_arc_conf()


def _rspamd_config_ok():
    done = subprocess.run(['rspamadm', 'configtest'], capture_output=True, text=True)
    return done.returncode == 0


def _dkim_keygen(domain, selector, key, kind, bits):
    extra = ['-t', 'rsa', '-b', str(bits)] if kind == 'rsa' else ['-t', 'ed25519']
    done = subprocess.run(['rspamadm', 'dkim_keygen', '-d', domain, '-s', selector, '-k', key] + extra,
                          capture_output=True, text=True, check=True)
    _own_key(key)
    os.chmod(key, 0o640)
    return done.stdout.strip()


def _dkim_make_key(domain, selector, kind, bits, folder):
    """Creates one key in folder. A failed attempt leaves no key behind."""
    if not SELECTOR_RE.match(selector):
        raise EfaError('Invalid selector.')
    if any(key['domain'] == domain and key['selector'] == selector for key in _dkim_keys()):
        raise EfaError(f'Selector {selector} already exists for {domain}, nothing changed.')
    for path in sorted({DKIM_DIR, ARC_DIR if folder.startswith(ARC_DIR) else DKIM_DIR, folder}):
        os.makedirs(path, mode=0o750, exist_ok=True)
        _own_key(path)
    key = f'{folder}/{domain}.{selector}.key'
    try:
        return _dkim_keygen(domain, selector, key, kind, bits)
    except (subprocess.CalledProcessError, OSError) as err:
        if os.path.exists(key):
            os.remove(key)
        raise EfaError(f'Key generation failed, no key was kept: {err}')


def _dkim_rsa_bits(value):
    try:
        bits = int(value)
    except ValueError:
        raise EfaError('RSA key size must be a number.')
    if bits not in DKIM_RSA_SIZES:
        raise EfaError(f'RSA keys must have one of these sizes: {", ".join(map(str, DKIM_RSA_SIZES))} bits.')
    return bits


def _dkim_domain(value):
    domain = value.strip().lower()
    if not DOMAIN_RE.match(domain):
        raise EfaError('Invalid domain.')
    return domain


def _dkim_create(domain, kind, bits, selector):
    if any(key['domain'] == domain and key['state'] == 'active' and key['purpose'] == 'dkim' and key['public']
           and key['public'][0] == kind for key in _dkim_keys()):
        raise EfaError(f'{domain} already has an active {kind} key, nothing changed.')
    record = _dkim_make_key(domain, selector, kind, bits, DKIM_DIR)
    _write_dkim_conf()
    _reload_rspamd()
    return {'domain': domain, 'type': kind, 'selector': selector, 'dns_record': record}


def dkim_generate(args):
    """Create an RSA key for a domain."""
    domain, bits = _dkim_domain(args.domain), _dkim_rsa_bits(args.bits)
    return _dkim_create(domain, 'rsa', bits, (args.selector or '').strip() or RSA_SELECTOR)


def dkim_generate_ed25519(args):
    """Create an ED25519 key for a domain."""
    domain = _dkim_domain(args.domain)
    return _dkim_create(domain, 'ed25519', None, (args.selector or '').strip() or ED_SELECTOR)


DKIM_KINDS = {'both': ['rsa', 'ed25519'], 'rsa': ['rsa'], 'ed25519': ['ed25519']}


def dkim_create(args):
    """RSA, Ed25519 or both for one domain in one step. With both, a kind the domain already has an active key of stays."""
    domain, kind = _dkim_domain(args.domain), (args.kind or 'both').strip().lower()
    if kind not in DKIM_KINDS:
        raise EfaError('Key type: both, rsa or ed25519.')
    bits = _dkim_rsa_bits(args.bits) if kind != 'ed25519' else None
    have = {key['public'][0] for key in _dkim_keys() if key['domain'] == domain and key['state'] == 'active'
            and key['purpose'] == 'dkim' and key['public']}
    todo = [item for item in DKIM_KINDS[kind] if kind != 'both' or item not in have]
    if not todo:
        raise EfaError(f'{domain} already has an active RSA and Ed25519 key, nothing changed.')
    selectors = {'rsa': (args.selector or '').strip() or RSA_SELECTOR, 'ed25519': (args.ed_selector or '').strip() or ED_SELECTOR}
    made = [_dkim_create(domain, item, bits if item == 'rsa' else None, selectors[item]) for item in todo]
    note = ('RSA below 3000 bits is under BSI TR-02102-1; 2048 is still the common size for DNS. 3072 makes a longer TXT record.'
            if 'rsa' in todo and bits < 3000 else '')
    return {'domain': domain, 'keys': made, 'kept': [item for item in DKIM_KINDS[kind] if item not in todo], 'note': note}


def dkim_remove(args):
    """Remove one key. Mail stops being signed with it at once, its DNS record is no longer needed after that."""
    domain, selector = _dkim_domain(args.domain), args.selector.strip()
    if args.confirm.strip() != 'yes':
        raise EfaError("Type 'yes' to confirm.")
    found = [key for key in _dkim_keys() if key['domain'] == domain and key['selector'] == selector]
    if not found:
        raise EfaError(f'No key {selector} for {domain}.')
    os.remove(found[0]['path'])
    state = _rotation_state()
    state['retired'].pop(f'{domain} {selector}', None)
    _json_write(ROTATION_FILE, state)
    _write_dkim_conf()
    _reload_rspamd()
    return {'removed': selector, 'domain': domain}


def _key_bits(path):
    done = subprocess.run(['openssl', 'pkey', '-in', path, '-noout', '-text'], capture_output=True, text=True)
    match = re.search(r'Private-Key: \((\d+) bit', done.stdout)
    return int(match.group(1)) if match else None


def dkim_import(args):
    """Take over an existing key with its selector, so a domain is signed once, here, and not twice. From a file on this host
    (the migration) or, in the web and the API, as the PEM file in base64 through the secret input. dkim-check warns about weak keys."""
    domain, selector = args.domain.strip().lower(), args.selector.strip()
    if not DOMAIN_RE.match(domain):
        raise EfaError('Invalid domain.')
    if not SELECTOR_RE.match(selector):
        raise EfaError('Invalid selector.')
    if not (getattr(args, 'key_file', '') or '').strip():
        try:
            pem = base64.b64decode(_secrets(1, 'Private key: the PEM file in base64')[0].strip(), validate=True)
        except (ValueError, IndexError):
            raise EfaError('Key: the PEM file in base64, on one line.')
        if not 100 < len(pem) < 20000 or b'PRIVATE KEY-----' not in pem:
            raise EfaError('Key: a private key in PEM format.')
        fd, temp = tempfile.mkstemp(prefix='efa-dkim-')
        with os.fdopen(fd, 'wb') as f:
            f.write(pem)
        try:
            return dkim_import(argparse.Namespace(domain=domain, selector=selector, key_file=temp))
        finally:
            os.remove(temp)
    if _key_bits(args.key_file) is None:
        raise EfaError(f'{args.key_file} is no readable key.')
    os.makedirs(DKIM_IMPORTED, mode=0o750, exist_ok=True)
    shutil.chown(DKIM_DIR, 'root', _rspamd_user())
    shutil.chown(DKIM_IMPORTED, 'root', _rspamd_user())
    key = f'{DKIM_IMPORTED}/{domain}.{selector}.key'
    shutil.copyfile(args.key_file, key)
    shutil.chown(key, 'root', _rspamd_user())
    os.chmod(key, 0o640)
    _write_dkim_conf()
    _reload_rspamd()
    return {'imported': key}


def _dkim_public(path):
    # One page asks for each key many times, and every openssl call costs a process.
    if path not in _dkim_public_cache:
        _dkim_public_cache[path] = _dkim_public_read(path)
    return _dkim_public_cache[path]


_dkim_public_cache = {}


def _dkim_public_read(path):
    """Type and public DNS value of a key file, or None. The private key never leaves this function."""
    done = subprocess.run(['openssl', 'pkey', '-in', path, '-pubout', '-outform', 'DER'], capture_output=True)
    if done.returncode == 0:
        # 44 bytes are the ED25519 header and key, DKIM wants only the key.
        if len(done.stdout) == 44:
            return 'ed25519', base64.b64encode(done.stdout[-32:]).decode()
        return 'rsa', base64.b64encode(done.stdout).decode()
    # rspamd stores ED25519 as base64 of 64 bytes, with the public key in the last 32.
    try:
        with open(path) as f:
            raw = base64.b64decode(f.read().strip(), validate=True)
    except (OSError, ValueError):
        return None
    return ('ed25519', base64.b64encode(raw[-32:]).decode()) if len(raw) == 64 else None


def _dkim_keys():
    keys = []
    for state, purpose, folder in (('active', 'dkim', DKIM_DIR), ('active', 'dkim', DKIM_IMPORTED),
                                   ('pending', 'dkim', DKIM_PENDING), ('retired', 'dkim', DKIM_RETIRED),
                                   ('active', 'arc', ARC_DIR), ('pending', 'arc', ARC_PENDING),
                                   ('retired', 'arc', ARC_RETIRED)):
        for path in sorted(glob.glob(f'{folder}/*.key')):
            domain, selector = os.path.basename(path)[:-4].rsplit('.', 1)
            keys.append({'domain': domain, 'selector': selector, 'state': state, 'purpose': purpose, 'path': path,
                         'public': _dkim_public(path)})
    return keys


def _dkim_value(key):
    return f'v=DKIM1; k={key["public"][0]}; p={key["public"][1]}'


def _retired_expired(state, domain, selector):
    since = state['retired'].get(f'{domain} {selector}')
    return bool(since) and datetime.date.fromisoformat(since) + datetime.timedelta(days=ROTATION_GRACE_DAYS) < _today()


def _dkim_zone_lines(record):
    # A TXT string holds at most 255 characters, longer values are split into several strings.
    value = record['value']
    parts = [f'"{value[i:i + 255]}"' for i in range(0, len(value), 255)]
    return [f'{record["name"]}. IN TXT ( {parts[0]}'] + [f'\t{part}' for part in parts[1:]] + ['\t)']


def dkim_export(args):
    """Public DNS records, of one domain or all. Never contains private keys."""
    domain, fmt = (args.domain or '').strip().lower(), (args.format or 'zone').strip()
    if domain and not DOMAIN_RE.match(domain):
        raise EfaError('Invalid domain.')
    if fmt not in ('zone', 'csv'):
        raise EfaError("Format must be 'zone' or 'csv'.")
    state = _rotation_state()
    keys = [key for key in _dkim_keys() if not domain or key['domain'] == domain]
    dmarc = {name: item for name, item in _json_read(DMARC_RECORDS, {}).items()
             if item.get('current') and (not domain or name == domain)}
    if domain and not keys and not dmarc:
        raise EfaError(f'No DNS records known for {domain}.')
    records, unreadable = [], []
    for key in keys:
        if key['public'] is None:
            unreadable.append(f'{key["domain"]} {key["selector"]}')
        elif not (key['state'] == 'retired' and _retired_expired(state, key['domain'], key['selector'])):
            records.append({'domain': key['domain'], 'selector': key['selector'], 'type': key['public'][0],
                            'name': f'{key["selector"]}._domainkey.{key["domain"]}', 'value': _dkim_value(key),
                            'state': key['state'], 'purpose': key['purpose']})
    for name, item in sorted(dmarc.items()):
        current = item['current']
        records.append({'domain': name, 'selector': '', 'type': 'dmarc', 'name': f'_dmarc.{name}',
                        'value': current['record'], 'state': 'active', 'purpose': 'dmarc'})
        for host in current['external']:
            records.append({'domain': name, 'selector': '', 'type': 'dmarc-report-authorization',
                            'name': f'{name}._report._dmarc.{host}', 'value': 'v=DMARC1', 'state': 'active',
                            'purpose': 'dmarc'})
    if fmt == 'csv':
        out = io.StringIO(newline='')
        writer = csv.DictWriter(out, ('domain', 'selector', 'type', 'name', 'value', 'state', 'purpose'),
                                lineterminator='\n')
        writer.writeheader()
        writer.writerows(records)
        text = out.getvalue()
    else:
        lines = ['; DNS records from eFa-next.',
                 '; SPF is left out: eFa does not know all mail servers that send for your domain.']
        without = sorted({key['domain'] for key in keys} - set(dmarc))
        if without:
            lines.append(f'; DMARC is left out, no record saved in eFa for: {", ".join(without)}')
        lines += [f'; No record, key cannot be read: {item}' for item in unreadable]
        for record in records:
            if record['purpose'] == 'arc':
                lines.append('; ARC key')
            if record['state'] == 'pending':
                lines.append('; Key for a future rotation: publish now, it does not sign yet.')
            elif record['state'] == 'retired':
                lines.append('; Key after a rotation: keep this record until the grace period has passed.')
            lines += _dkim_zone_lines(record)
        text = '\n'.join(lines) + '\n'
    return {'format': fmt, 'text': text, 'records': records, 'unreadable': unreadable}


def dkim_check(_args):
    """List DKIM keys. Existing keys below the rules only warn, signing keeps working."""
    warnings, notes, keys = [], [], []
    types = {}
    for key in _dkim_keys():
        if key['purpose'] != 'dkim':
            continue
        if key['public'] is None:
            warnings.append(f'{key["path"]} cannot be read.')
            keys.append({'domain': key['domain'], 'selector': key['selector'], 'type': 'unreadable',
                         'state': key['state'], 'bits': None, 'dns': ''})
            continue
        kind = key['public'][0]
        bits = _key_bits(key['path']) if kind == 'rsa' else None
        keys.append({'domain': key['domain'], 'selector': key['selector'], 'type': kind, 'state': key['state'],
                     'bits': bits, 'dns': _dkim_value(key), 'imported': key['path'].startswith(DKIM_IMPORTED)})
        if key['state'] == 'active':
            types.setdefault(key['domain'], set()).add(kind)
            if bits is not None and bits < DKIM_MIN_BITS:
                warnings.append(f'{key["domain"]}: key {key["selector"]} has only {bits} bits, generate a new key.')
    notes += [f'{domain}: signs with {kinds.copy().pop()} only.' for domain, kinds in sorted(types.items())
              if len(kinds) == 1]
    old = glob.glob(f'{OPENDKIM_KEYS}/*.private') + glob.glob(f'{OPENDKIM_KEYS}/*/*.private')
    for key in sorted(old):
        bits = _key_bits(key)
        warnings.append(f'{key}: opendkim key ({bits} bits), generate new keys.')
    domains = {key['domain'] for key in keys} | set(_json_read(DMARC_RECORDS, {}))
    return {'keys': keys, 'warnings': warnings, 'notes': notes, 'export_domains': sorted(domains)}


def _add_months(day, months):
    index = day.month - 1 + months
    year, month = day.year + index // 12, index % 12 + 1
    following = datetime.date(year + month // 12, month % 12 + 1, 1)
    return min(day.replace(year=year, month=month, day=1) + datetime.timedelta(days=day.day - 1),
               following - datetime.timedelta(days=1))


def _rotation_state():
    state = _json_read(ROTATION_FILE, {})
    state.setdefault('resolvers', {'ipv4_1': '', 'ipv4_2': '', 'ipv6_1': '', 'ipv6_2': ''})
    state.setdefault('all', {'enabled': False, 'interval': 6, 'horizon': ROTATION_MAX_MONTHS, 'bits': DKIM_MIN_BITS})
    state.setdefault('domains', {})
    state.setdefault('retired', {})
    state.setdefault('threshold', ROTATION_THRESHOLD)
    state.setdefault('mailed', {})
    state.setdefault('warnings', [])
    state.setdefault('last_run', None)
    return state


def _rotation_settings(state, domain, kind):
    override = state['domains'].get(domain, {}).get(kind)
    settings = {**state['all'], 'source': 'default', 'next': None}
    if override:
        settings.update(override, source='override')
    if kind == 'arc':
        arc = _arc_settings(_arc_state(), domain)
        settings['bits'] = arc['bits'] if arc else settings['bits']
    return settings


def _rotation_targets(state):
    targets = {(domain, kind) for domain, kinds in state['domains'].items() for kind in kinds}
    for key in _dkim_keys():
        if key['state'] == 'active' and key['public'] and key['purpose'] == 'dkim':
            targets.add((key['domain'], key['public'][0]))
    arc_state = _arc_state()
    for domain in _arc_domains(arc_state):
        arc = _arc_settings(arc_state, domain)
        if arc and arc['enabled'] and arc['key'] == 'own':
            targets.add((domain, 'arc'))
    return sorted(targets)


def _rotation_pending(domain, kind):
    found = []
    for key in _dkim_keys():
        match = re.search(r'-(\d{8})$', key['selector'])
        if (key['state'] == 'pending' and key['domain'] == domain and match and key['public']
                and (key['purpose'] == 'arc' if kind == 'arc' else key['purpose'] == 'dkim' and key['public'][0] == kind)):
            found.append((datetime.datetime.strptime(match.group(1), '%Y%m%d').date(), key))
    return sorted(found, key=lambda item: item[0])


def _rotation_log(text):
    os.makedirs(os.path.dirname(ROTATION_LOG), exist_ok=True)
    with open(ROTATION_LOG, 'a') as f:
        f.write(f'{time.strftime("%Y-%m-%d %H:%M:%S")} {text}\n')


def _rotation_pregenerate(state, domain, kind):
    """Creates the missing keys up to the horizon. They do not sign until a rotation activates them."""
    settings = _rotation_settings(state, domain, kind)
    if not settings['enabled']:
        return []
    today, created = _today(), []
    pending = _rotation_pending(domain, kind)
    if pending:
        day = _add_months(pending[-1][0], settings['interval'])
    elif settings['next'] and datetime.date.fromisoformat(settings['next']) > today:
        day = datetime.date.fromisoformat(settings['next'])
    else:
        day = _add_months(today, settings['interval'])
    end = _add_months(today, settings['horizon'])
    folder = ARC_PENDING if kind == 'arc' else DKIM_PENDING
    while day <= end:
        selector = f'efa-{kind}-{day:%Y%m%d}'
        _dkim_make_key(domain, selector, 'rsa' if kind == 'arc' else kind, settings['bits'], folder)
        _rotation_log(f'{domain} {kind}: pre-generated {selector} for {day}')
        created.append(selector)
        day = _add_months(day, settings['interval'])
    return created


def _dns_txt(resolver, name):
    try:
        done = subprocess.run(['dig', '+time=5', '+tries=2', '+short', 'TXT', name, f'@{resolver}'],
                              capture_output=True, text=True, timeout=30)
    except subprocess.TimeoutExpired:
        return None
    return done.stdout.splitlines() if done.returncode == 0 else None


def _dns_shows_key(lines, public):
    for line in lines or []:
        match = re.search(r'(?:^|;)\s*p=([^;\s]+)', ''.join(re.findall(r'"([^"]*)"', line)))
        if match and match.group(1) == public:
            return True
    return False


def _rotation_check(state, name, public):
    """Which configured resolvers show the record, show another value, or show nothing."""
    matched, different, missing = [], [], []
    for resolver in [value for value in state['resolvers'].values() if value]:
        lines = _dns_txt(resolver, name)
        if _dns_shows_key(lines, public):
            matched.append(resolver)
        elif lines:
            different.append(resolver)
        else:
            missing.append(resolver)
    return matched, different, missing


def _rotation_activate(state, domain, kind, new):
    moved = []
    active_dir, retired_dir = (ARC_DIR, ARC_RETIRED) if kind == 'arc' else (DKIM_DIR, DKIM_RETIRED)
    os.makedirs(retired_dir, mode=0o750, exist_ok=True)
    _own_key(retired_dir)
    for key in _dkim_keys():
        if (key['domain'] == domain and key['state'] == 'active' and key['public']
                and (key['purpose'] == 'arc' if kind == 'arc' else key['purpose'] == 'dkim' and key['public'][0] == kind)):
            target = f'{retired_dir}/{os.path.basename(key["path"])}'
            os.replace(key['path'], target)
            moved.append((key['path'], target, key['selector']))
    active = f'{active_dir}/{domain}.{new["selector"]}.key'
    os.replace(new['path'], active)
    _write_dkim_conf()
    if not _rspamd_config_ok():
        os.replace(active, new['path'])
        for path, target, _selector in moved:
            os.replace(target, path)
        _write_dkim_conf()
        return False
    _reload_rspamd()
    for _path, _target, selector in moved:
        state['retired'][f'{domain} {selector}'] = _today().isoformat()
    return True


def _admin_notify(subject, text):
    address = _admin_email()
    if not address:
        return
    message = f'To: {address}\nSubject: {subject}\n\n{text}\n'
    subprocess.run(['sendmail', '-t'], input=message, text=True, capture_output=True, check=False)


def rotation_run(args):
    """Job every 2 hours: top up keys, and rotate a key from its date on once enough resolvers show its record."""
    if cluster_role() == 'client':
        return {'skipped': 'a client of a cluster: the master rotates the keys and hands them on'}
    if os.path.exists(PROVISION_FILE):
        provision_refresh()
    state = _rotation_state()
    today, warnings, rotated, created, to_mail = _today(), [], [], [], []
    notify = (args.notify or 'yes').strip() != 'no'
    _write_arc_conf()
    for domain, kind in _rotation_targets(state):
        if not _rotation_settings(state, domain, kind)['enabled']:
            continue
        created += _rotation_pregenerate(state, domain, kind)
        pending = _rotation_pending(domain, kind)
        if not pending or pending[0][0] > today:
            continue
        day, key = pending[0]
        name = f'{key["selector"]}._domainkey.{domain}'
        matched, different, missing = _rotation_check(state, name, key['public'][1])
        if different:
            text = f'{domain} {kind}: key {key["selector"]} has a different record on: {", ".join(different)}'
            warnings.append(text)
            _rotation_log(f'warning: {text}')
        if len(matched) < state['threshold']:
            text = (f'{domain} {kind}: key {key["selector"]} is due since {day}, found on {len(matched)} of '
                    f'{state["threshold"]} needed DNS servers. Not visible on: {", ".join(different + missing) or "none configured"}')
            warnings.append(text)
            _rotation_log(f'check failed, not rotated: {text}')
            if notify and state['mailed'].get(key['selector'] + ' ' + domain) != today.isoformat():
                state['mailed'][key['selector'] + ' ' + domain] = today.isoformat()
                to_mail.append(text)
        elif _rotation_activate(state, domain, kind, key):
            rotated.append(f'{domain} {kind} {key["selector"]}')
            state['mailed'].pop(key['selector'] + ' ' + domain, None)
            _rotation_log(f'{domain} {kind}: rotated to {key["selector"]}, found on: {", ".join(matched)}')
        else:
            text = f'{domain} {kind}: rspamd rejected the config with key {key["selector"]}, not rotated.'
            warnings.append(text)
            _rotation_log(text)
    state['warnings'] = warnings
    state['last_run'] = time.strftime('%Y-%m-%d %H:%M:%S')
    _json_write(ROTATION_FILE, state)
    # The warning stays current on every run, the mail goes out once a day per key.
    if to_mail:
        _admin_notify('eFa: DKIM key rotation waits for DNS', '\n'.join(to_mail))
    return {'rotated': rotated, 'pre_generated': created, 'warnings': warnings}


def _rotation_due_removal(state):
    return [{'domain': item.split()[0], 'selector': item.split()[1], 'retired_on': since,
             'record': f'{item.split()[1]}._domainkey.{item.split()[0]}'}
            for item, since in sorted(state['retired'].items()) if _retired_expired(state, *item.split())]


def _rotation_next_check():
    done = subprocess.run(['systemctl', 'show', 'efa-dkim-rotation.timer', '-p', 'NextElapseUSecRealtime', '--value'],
                          capture_output=True, text=True)
    return done.stdout.strip() or None


def _rotation_notices():
    """Warnings of the DKIM key rotation, for the dashboard and efactl status."""
    state = _rotation_state()
    return state['warnings'] + [f'{item["record"]}: the rotation is {ROTATION_GRACE_DAYS} days past, remove this DNS record.'
                                for item in _rotation_due_removal(state)]


def _system_notices():
    """An update that is there, or a system update that failed. A finished one needs nobody's attention."""
    update = _update_state()
    found = [f'eFa {"security update" if update.get("security") else "update"} {update["latest"]} is available'
             f'{", published " + update["published"] if update.get("published") else ""}.'] if _update_available(update) else []
    review = [rule['name'] for rule in _rules() if rule.get('review')]
    if review:
        found.append(f'{len(review)} rules from the migration weaken the filter and need checking (Rules page): ' + ', '.join(review[:5])
                     + (' ...' if len(review) > 5 else '') + '. Change or remove them, then they leave this list.')
    system = _system_state()
    if system['state'] == 'failed':
        found.append(f'Last system update failed: {system["result"]}')
    for device in new_interfaces():
        found.append(f'New interface {device} found, not set up: it stays unused until it has a role (Network, More interfaces).')
    if os.path.exists(RSPAMD_SSO_UPGRADED) and time.time() - os.stat(RSPAMD_SSO_UPGRADED).st_mtime < 7 * 86400:
        found.append('rspamd web interface: full access is no longer offered. After the update it was open read only for one hour; '
                     'changes go through eFa (Spam & virus, Rules, Symbol scores).')
    if os.path.exists(os.path.join(ETC, 'eFa', 'cluster')):
        cluster_state = _lib('efa_cluster').read_state(ETC)
        if cluster_state.get('master_down_since'):
            found.append(f"Cluster master {cluster_state.get('master', {}).get('name', '')} not reachable since "
                         f"{time.strftime('%Y-%m-%d %H:%M', time.localtime(cluster_state['master_down_since']))}. Mail filtering goes on with the "
                         'last settings. If it is gone for good: efactl cluster-promote on one node.')
    siem = _json_read(SIEM_FILE, {})
    if siem.get('siem') and siem.get('protocol') in ('tcp', 'udp'):
        found.append(f"SIEM export stopped: it sent the logs unencrypted ({siem['protocol']}). Switch it to TLS: siem-set --protocol tls --port 6514"
                     " (the SIEM must take syslog over TLS).")
    otlp = _json_read(OTLP_FILE, {})
    if otlp.get('enabled') and str(otlp.get('endpoint', '')).startswith('http://'):
        found.append('OpenTelemetry export to an http:// address: nothing is sent until it is an https:// address (otlp-set).')
    if _harvest_settings()['mode'] == 'on':
        banned = _harvest_banned()
        if banned:
            found.append(f'Address harvesting: {len(banned)} address{"es" if len(banned) > 1 else ""} banned now (harvest-status).')
    return found


def rotation_status(_args):
    """Rotation settings per domain and key type, next dates and open warnings."""
    state = _rotation_state()
    rows = []
    for domain, kind in _rotation_targets(state):
        settings = _rotation_settings(state, domain, kind)
        pending = _rotation_pending(domain, kind)
        rows.append({'domain': domain, 'type': kind, 'settings_from': settings['source'], 'auto_rotate': settings['enabled'],
                     'interval_months': settings['interval'], 'months_ahead': settings['horizon'],
                     'next_rotation': pending[0][0].isoformat() if pending else None,
                     'next_selector': pending[0][1]['selector'] if pending else None, 'keys_ready': len(pending)})
    return {'threshold': str(state['threshold']), 'next_check': _rotation_next_check(),
            'rotation_all': state['all']['enabled'], 'rotation_interval': str(state['all']['interval']),
            'rotation_horizon': str(state['all']['horizon']), 'rotation_bits': str(state['all']['bits']),
            **state['resolvers'], 'domains': rows, 'rotation_warnings': state['warnings'],
            'remove_from_dns': _rotation_due_removal(state), 'last_run': state['last_run']}


def _rotation_numbers(interval, horizon, bits):
    try:
        interval, horizon, bits = int(interval), int(horizon), int(bits)
    except ValueError:
        raise EfaError('Interval, months ahead and key size must be numbers.')
    if interval not in ROTATION_INTERVALS:
        raise EfaError(f'Interval must be one of {", ".join(map(str, ROTATION_INTERVALS))} months.')
    if not interval <= horizon <= ROTATION_MAX_MONTHS:
        raise EfaError(f'Months ahead must be from the interval up to {ROTATION_MAX_MONTHS}.')
    if bits not in DKIM_RSA_SIZES:
        raise EfaError('Invalid RSA key size.')
    return interval, horizon, bits


def rotation_all_set(args):
    """Default for every domain and key type, also for domains added later. Off keeps all pre-generated keys."""
    enabled = _on_off(args.mode)
    interval, horizon, bits = _rotation_numbers(args.interval, args.horizon, args.bits)
    state = _rotation_state()
    state['all'] = {'enabled': enabled, 'interval': interval, 'horizon': horizon, 'bits': bits}
    created = []
    for domain, kind in _rotation_targets(state):
        created += _rotation_pregenerate(state, domain, kind)
    _json_write(ROTATION_FILE, state)
    return {'rotation_all': enabled, 'pre_generated': created}


def rotation_set(args):
    """Own settings for one domain and key type. 'default' removes them again; pre-generated keys stay."""
    domain, kind, mode = _dkim_domain(args.domain), args.type.strip(), args.mode.strip()
    if kind not in ('rsa', 'ed25519', 'arc'):
        raise EfaError("Type must be 'rsa', 'ed25519' or 'arc'.")
    state = _rotation_state()
    kinds = state['domains'].setdefault(domain, {})
    if mode == 'default':
        kinds.pop(kind, None)
        if not kinds:
            state['domains'].pop(domain)
    elif mode in ('on', 'off'):
        interval, horizon, bits = _rotation_numbers(args.interval, args.horizon, args.bits)
        first = (args.next or '').strip()
        if first:
            try:
                if datetime.date.fromisoformat(first) <= _today():
                    raise EfaError('The first rotation date must be in the future.')
            except ValueError:
                raise EfaError('First rotation date must look like 2027-01-31.')
        kinds[kind] = {'enabled': mode == 'on', 'interval': interval, 'horizon': horizon, 'bits': bits,
                       'next': first or None}
    else:
        raise EfaError("Mode must be 'on', 'off' or 'default'.")
    created = _rotation_pregenerate(state, domain, kind)
    _json_write(ROTATION_FILE, state)
    return {'domain': domain, 'type': kind, 'settings': _rotation_settings(state, domain, kind), 'pre_generated': created}


def rotation_pregenerate(args):
    """Create the missing future keys now, so their DNS records can be published early."""
    domain = _dkim_domain(args.domain) if (args.domain or '').strip() else ''
    state = _rotation_state()
    created = []
    for name, kind in _rotation_targets(state):
        if not domain or name == domain:
            created += _rotation_pregenerate(state, name, kind)
    return {'pre_generated': created}


def resolver_set(args):
    """External DNS servers that are asked for a new key, and how many must show it. Two IPv4, two IPv6."""
    state = _rotation_state()
    new = {}
    for name, version in (('ipv4_1', 4), ('ipv4_2', 4), ('ipv6_1', 6), ('ipv6_2', 6)):
        value = (getattr(args, name) or '').strip()
        if value:
            try:
                address = ipaddress.ip_address(value)
            except ValueError:
                raise EfaError(f'{value} is no IP address.')
            if address.version != version or address.is_unspecified or address.is_multicast:
                raise EfaError(f'{value} is no usable IPv{version} address.')
        new[name] = value
    configured = len([value for value in new.values() if value])
    needed = (args.threshold or '').strip() or str(ROTATION_THRESHOLD)
    # The default needs no check, it may be set before all servers are entered.
    if (args.threshold or '').strip():
        if not needed.isdigit() or not 1 <= int(needed) <= configured:
            raise EfaError(f'DNS servers needed must be from 1 to {configured}, the number of servers entered.')
    state['resolvers'], state['threshold'] = new, int(needed)
    _json_write(ROTATION_FILE, state)
    return new


def _arc_state():
    state = _json_read(ARC_FILE, {})
    state.setdefault('all', {'enabled': False, 'key': 'dkim', 'bits': DKIM_MIN_BITS})
    state.setdefault('domains', {})
    state.setdefault('trusted', [])
    return state


def _arc_settings(state, domain):
    return state['domains'].get(domain) or (state['all'] if state['all']['enabled'] else None)


def _arc_domains(state):
    return sorted(set(state['domains']) | set(_dkim_conf_domains()) if state['all']['enabled'] else set(state['domains']))


def _arc_rsa_key(domain):
    for key in _dkim_keys():
        if key['domain'] == domain and key['state'] == 'active' and key['purpose'] == 'dkim' and key['public'] \
                and key['public'][0] == 'rsa':
            return key
    return None


def _arc_own_key(domain):
    return next((key for key in _dkim_keys() if key['domain'] == domain and key['state'] == 'active'
                 and key['purpose'] == 'arc'), None)


def _arc_key_for(domain, settings):
    return _arc_own_key(domain) if settings['key'] == 'own' else _arc_rsa_key(domain)


def _write_arc_conf():
    """Seals inside rspamd, the milter order stays. Without a key rspamd still checks incoming ARC chains."""
    state = _arc_state()
    # Inbound for the recipient domain, outbound for the sender domain; exact domains only, no default key.
    lines = ['allow_username_mismatch = true;', 'try_fallback = false;', 'use_esld = false;', 'sign_inbound = true;',
             'use_domain = "recipient";', 'sign_local = true;', 'sign_authenticated = true;',
             'use_domain_sign_local = "header";', 'use_domain_sign_networks = "header";']
    entries = []
    for domain in _arc_domains(state):
        settings = _arc_settings(state, domain)
        key = _arc_key_for(domain, settings) if settings and settings['enabled'] else None
        if key:
            entries += [f'  {domain} {{', f'    path = "{key["path"]}";', f'    selector = "{key["selector"]}";', '  }']
    if entries:
        lines += ['domain {'] + entries + ['}']
    if state['trusted']:
        # A valid ARC chain of these sealers counts (ARC_ALLOW_TRUSTED) and softens a DMARC reject of forwarded mail.
        lines.append('whitelisted_signers_map = [' + ', '.join(f'"{domain}"' for domain in state['trusted']) + '];')
    _write(ARC_CONF, '\n'.join(lines) + '\n')


def add_efa_headers(conf):
    '''The milter_headers settings with the headers of eFa. Safe to run again, an older version of a routine is replaced.'''
    if not re.search(r'^use = \[', conf, re.M) or not re.search(r'^custom \{\n', conf, re.M):
        raise EfaError('milter_headers.conf has an unknown form, nothing was changed.')
    for name, routine in EFA_HEADER_ROUTINES.items():
        if f'  {name} = <<EOD' in conf:
            conf = re.sub(rf'^  {name} = <<EOD\n.*?^EOD;\n', lambda found: routine, conf, count=1, flags=re.M | re.S)
        else:
            conf = re.sub(r'^use = \[', f'use = ["{name}", ', conf, count=1, flags=re.M)
            conf = re.sub(r'^custom \{\n', lambda found: found.group(0) + routine, conf, count=1, flags=re.M)
    return conf


def efa_headers_apply(_args):
    '''Adds the headers X-eFa-next-ARC-Sealer and X-eFa-next-DKIM-Signer to the rspamd settings. A config rspamd rejects is taken back.'''
    with open(MILTER_HEADERS_CONF) as f:
        conf = f.read()
    new = add_efa_headers(conf)
    if new == conf:
        return {'efa_headers': 'present'}
    _write(MILTER_HEADERS_CONF, new)
    if not _rspamd_config_ok():
        _write(MILTER_HEADERS_CONF, conf)
        raise EfaError('rspamd rejected the config, it was taken back.')
    subprocess.run(['systemctl', 'try-reload-or-restart', 'rspamd'], check=False, capture_output=True)
    return {'efa_headers': 'added'}


def _arc_prepare(domain, settings, selector=None):
    """Makes sure the key exists. Returns a note if it cannot be used."""
    if settings['key'] == 'own':
        if not _arc_own_key(domain):
            _dkim_make_key(domain, selector or ARC_SELECTOR, 'rsa', settings['bits'], ARC_DIR)
        return None
    if not _arc_rsa_key(domain):
        return f'{domain} has no DKIM RSA key, ARC needs its own key here.'
    return None


def _arc_apply():
    _write_arc_conf()
    if not _rspamd_config_ok():
        raise EfaError('rspamd rejected the ARC config, it is written but not loaded. Check rspamadm configtest.')
    _reload_rspamd()


def _arc_key_choice(args):
    key = args.key.strip() or 'dkim'
    if key not in ('dkim', 'own'):
        raise EfaError("Key must be 'dkim' or 'own'.")
    return key, _dkim_rsa_bits(args.bits or str(DKIM_MIN_BITS))


def arc_set(args):
    """ARC for one domain, with the DKIM RSA key or an own RSA key. 'default' follows the switch for all domains."""
    domain, mode = _dkim_domain(args.domain), args.mode.strip()
    state = _arc_state()
    if mode == 'default':
        state['domains'].pop(domain, None)
        note = None
    elif mode in ('on', 'off'):
        key, bits = _arc_key_choice(args)
        settings = {'enabled': mode == 'on', 'key': key, 'bits': bits}
        note = _arc_prepare(domain, settings, (args.selector or '').strip() or None) if mode == 'on' else None
        if note:
            raise EfaError(note)
        state['domains'][domain] = settings
    else:
        raise EfaError("Mode must be 'on', 'off' or 'default'.")
    _json_write(ARC_FILE, state)
    _arc_apply()
    return arc_show(args)


def arc_trusted_set(args):
    """Sealers whose ARC chain is trusted, such as microsoft.com or google.com. Empty by default: then nothing changes."""
    action, domain = args.action.strip(), args.domain.strip().lower()
    if action not in ('add', 'remove') or not DOMAIN_RE.match(domain):
        raise EfaError("Action 'add' or 'remove', and a domain.")
    state = _arc_state()
    previous = list(state['trusted'])
    if action == 'add' and domain not in state['trusted']:
        state['trusted'] = sorted(state['trusted'] + [domain])
    elif action == 'remove':
        if domain not in state['trusted']:
            raise EfaError('This sealer is not in the list.')
        state['trusted'].remove(domain)
    _json_write(ARC_FILE, state)
    try:
        _arc_apply()
    except EfaError:
        state['trusted'] = previous
        _json_write(ARC_FILE, state)
        _write_arc_conf()
        raise
    return {'trusted_sealers': state['trusted']}


def arc_all_set(args):
    """ARC for all domains with DKIM keys, also for domains added later. A domain may keep its own setting."""
    enabled = _on_off(args.mode)
    key, bits = _arc_key_choice(args)
    state = _arc_state()
    state['all'] = {'enabled': enabled, 'key': key, 'bits': bits}
    if enabled:
        for domain in _arc_domains(state):
            if domain not in state['domains']:
                _arc_prepare(domain, state['all'])
    _json_write(ARC_FILE, state)
    _arc_apply()
    return arc_show(args)


def arc_show(_args):
    """ARC state per domain with the DNS record of the key in use."""
    state = _arc_state()
    rows = []
    for domain in _arc_domains(state):
        settings = _arc_settings(state, domain)
        key = _arc_key_for(domain, settings)
        note = '' if key else ('No DKIM RSA key: choose an own key.' if settings['key'] == 'dkim' else 'Own key is missing.')
        rows.append({'domain': domain, 'active': bool(settings['enabled'] and key), 'settings_from': 'override' if domain
                     in state['domains'] else 'default', 'key': settings['key'], 'selector': key['selector'] if key else '',
                     'bits': _key_bits(key['path']) if key else None, 'dns': _dkim_value(key) if key else '', 'note': note,
                     'has_dkim_rsa': bool(_arc_rsa_key(domain))})
    return {'arc_all': state['all']['enabled'], 'arc_all_key': state['all']['key'], 'arc_all_bits': str(state['all']['bits']),
            'arc_domains': rows, 'trusted_sealers': state['trusted']}


def _dmarc_who():
    user = os.environ.get('SUDO_USER')
    if user == 'efa-web':
        return f'web interface ({acting_user})' if acting_user else 'web interface'
    return f'console ({user or "root"})'


def _dmarc_uris(value, name):
    """Checks mailto addresses and returns them with their hosts."""
    uris, hosts = [], []
    for uri in [item.strip() for item in (value or '').split(',') if item.strip()]:
        match = re.match(r'^mailto:([a-z0-9._%+-]+)@([a-z0-9.-]+\.[a-z]{2,})$', uri.lower())
        if not match:
            raise EfaError(f'{name}: {uri} is no valid mailto address, like mailto:dmarc@example.org')
        uris.append(uri.lower())
        hosts.append(match.group(2))
    return uris, hosts


def _dmarc_policy(value, name, optional=True):
    value = (value or '').strip()
    if (not value and optional) or value in ('none', 'quarantine', 'reject'):
        return value
    raise EfaError(f'{name} must be none, quarantine or reject.')


def _dmarc_flag(value, name, allowed, default):
    value = (value or default).strip()
    if value not in allowed:
        raise EfaError(f'{name} must be one of {", ".join(allowed)}.')
    return value


def dmarc_record_set(args):
    """Builds the _dmarc TXT record of a domain after RFC 9989 and keeps every saved version."""
    domain = _dkim_domain(args.domain)
    use_ruf = (args.ruf_enable or 'off').strip() == 'on'
    fields = {'p': _dmarc_policy(args.p or 'none', 'p', optional=False), 'sp': _dmarc_policy(args.sp, 'sp'),
              'np': _dmarc_policy(args.np, 'np'), 'adkim': _dmarc_flag(args.adkim, 'adkim', ('r', 's'), 'r'),
              'aspf': _dmarc_flag(args.aspf, 'aspf', ('r', 's'), 'r'), 't': _dmarc_flag(args.t, 't', ('y', 'n'), 'n'),
              'rua': '', 'ruf': '', 'fo': '0'}
    rua_text = args.rua or ''
    # The report service template: efa adds the own report address, which eFa reads (reports-in-set).
    if (getattr(args, 'service', '') or '').strip() == 'efa':
        own = _json_read(REPORTS_FILE_IN, {})
        if not own.get('enabled') or not own.get('address'):
            raise EfaError('Switch on the own report address first: reports-in-set.')
        rua_text = ','.join(item for item in (rua_text.strip(), f"mailto:{own['address']}") if item)
    rua, hosts = _dmarc_uris(rua_text, 'rua')
    fields['rua'] = ','.join(rua)
    warnings = [P_NONE_HINT] if fields['p'] == 'none' else []
    if use_ruf:
        if (args.ruf_ack or '').strip() != 'yes':
            raise EfaError(RUF_WARNING + " Confirm this warning to save failure reports (--ruf_ack yes).")
        warnings.append(RUF_WARNING)
        ruf, ruf_hosts = _dmarc_uris(args.ruf, 'ruf')
        if not ruf:
            raise EfaError('Failure reports need at least one ruf address.')
        fields['ruf'] = ','.join(ruf)
        hosts += ruf_hosts
        fields['fo'] = _dmarc_flag(args.fo, 'fo', ('0', '1', 'd', 's'), '0')
    elif (args.ruf or '').strip():
        warnings.append('The ruf address was not saved, failure reports are not switched on.')
    parts = ['v=DMARC1', f'p={fields["p"]}']
    parts += [f'{tag}={fields[tag]}' for tag in ('sp', 'np') if fields[tag]]
    parts += [f'{tag}={fields[tag]}' for tag in ('adkim', 'aspf') if fields[tag] != 'r']
    parts += [f'{tag}={fields[tag]}' for tag in ('rua', 'ruf') if fields[tag]]
    if fields['ruf'] and fields['fo'] != '0':
        parts.append(f'fo={fields["fo"]}')
    if fields['t'] == 'y':
        parts.append('t=y')
    # shortcut: compares domains directly instead of the RFC 9989 DNS tree walk; a sibling subdomain gets one record too many.
    external = sorted({host for host in hosts if host != domain and not host.endswith('.' + domain)
                       and not domain.endswith('.' + host)})
    if external:
        warnings.append('Reports go to another domain, it must publish the authorization record: '
                        + ', '.join(f'{domain}._report._dmarc.{host}' for host in external))
    version = {'record': '; '.join(parts), 'fields': fields, 'external': external, 'when': time.strftime('%Y-%m-%d %H:%M:%S'),
               'who': _dmarc_who()}
    records = _json_read(DMARC_RECORDS, {})
    item = records.setdefault(domain, {'current': None, 'history': []})
    if not item['current'] or item['current']['record'] != version['record']:
        item['current'] = version
        item['history'].append(version)
        _json_write(DMARC_RECORDS, records)
    return {'domain': domain, 'name': f'_dmarc.{domain}', 'record': item['current']['record'], 'external': external,
            'warnings': warnings}


def dmarc_record_show(_args):
    """Saved _dmarc records of all domains with their history."""
    rows = []
    for domain, item in sorted(_json_read(DMARC_RECORDS, {}).items()):
        current = item['current']
        rows.append({'domain': domain, 'name': f'_dmarc.{domain}', 'record': current['record'],
                     'authorization': [f'{domain}._report._dmarc.{host}' for host in current['external']],
                     'ruf': bool(current['fields']['ruf']), 'history': list(reversed(item['history']))})
    return {'dmarc_records': rows, 'hint': P_NONE_HINT}


def dmarc_record_history(args):
    """All saved versions of one domain, newest first."""
    domain = _dkim_domain(args.domain)
    return {'domain': domain, 'history': list(reversed(_json_read(DMARC_RECORDS, {}).get(domain, {}).get('history', [])))}


def dmarc_record_check(args):
    """Reads an existing record and names tags that RFC 9989 removed. Saves nothing."""
    tags, notes = {}, []
    for part in [item.strip() for item in args.record.split(';') if item.strip()]:
        tag, _, value = part.partition('=')
        tags[tag.strip()] = value.strip()
    if next(iter(tags), None) != 'v' or tags.get('v') != 'DMARC1':
        raise EfaError('A DMARC record must start with v=DMARC1.')
    for tag, text in (('pct', 'use t=y for a test phase'), ('rf', 'failure report format is fixed'),
                      ('ri', 'report interval is up to the reporter')):
        if tag in tags:
            notes.append(f'{tag} is deprecated, RFC 9989 removed it: {text}.')
    known = {'v', 'p', 'sp', 'np', 'adkim', 'aspf', 'fo', 'rua', 'ruf', 't', 'psd', 'pct', 'rf', 'ri'}
    notes += [f'{tag} is no known tag.' for tag in tags if tag not in known]
    if 'ruf' in tags:
        notes.append(RUF_WARNING)
    return {'tags': tags, 'notes': notes}


def _actions():
    values = dict(DEFAULT_ACTIONS)
    for line in _read_lines(ACTIONS_CONF):
        match = re.match(r'^(greylist|rewrite_subject|reject) = ([0-9.]+);', line)
        if match:
            values[match.group(1)] = match.group(2)
    return values


def _load_limits():
    data = _json_read(LOAD_FILE, {})
    return {'load_percent': data.get('percent', 80), 'load_minutes': data.get('minutes', 30)}


def settings(_args):
    """Current values of the settings below."""
    return {
        'maintenance_mode': not os.path.exists(MONITOR_CRON),
        'relay_networks': _postconf('mynetworks').split(),
        'smarthost': _postconf('relayhost'),
        'message_size_limit_mb': int(_postconf('message_size_limit')) // (1024 * 1024),
        'spam_scores': _actions(), 'show_subjects': subjects_shown(), 'firewall_pending_seconds': firewall_pending_seconds(), 'cluster_managed_by': _cluster_managed_by(), 'store_headers': headers_policy()['store'], 'headers_days': headers_policy()['days'],
        'greylisting': 'enabled = false;' not in _read_lines(GREYLIST_CONF),
        'sender_allow': _read_lines(SENDER_MAPS['allow']),
        'sender_block': _read_lines(SENDER_MAPS['block']),
        'transports': _read_transports(),
        'admin_email': _admin_email(),
        'recipient_verification': 'reject_unverified_recipient' in _postconf('smtpd_recipient_restrictions'),
        'fail2ban': os.path.exists(FAIL2BAN_JAIL),
        'auto_backup': not os.path.exists(BACKUP_DISABLED),
        'smtpd_milters': _postconf('smtpd_milters'),
        'dns_zones': _dns_zones(),
        'extra_services': _read_lines(HEALTH_EXTRA),
        'maillog_days': _maillog_days(),
        'quarantine': f'regexp:{QUARANTINE_RULES}' in _postconf('milter_header_checks'),
        'quarantine_days': _quarantine_days(),
        'dmarc_reports': os.path.exists(DMARC_CRON),
        'maillog_max_mb': _maillog_max_mb(),
        'rspamd_sso': _rspamd_sso_mode(),
        'rspamd_sso_until': time.strftime('%H:%M', time.localtime(_rspamd_sso_until())) if _rspamd_sso_until() else '',
        'sanesecurity': _sane_state()['enabled'],
        'mailreport_daily': _report_settings()['daily'],
        **_load_limits(),
    }


def _on_off(value):
    value = value.strip().lower()
    if value not in ('on', 'off'):
        raise EfaError("Value must be 'on' or 'off'.")
    return value == 'on'


def redis_limit(ram):
    """Redis may use a quarter of the memory, and only drops keys with a TTL: Bayes keys have none."""
    return f'maxmemory {ram // 4}\nmaxmemory-policy volatile-lru\n'


def redis_tune(_args):
    """Limit the memory of Redis. Safe to run again; takes effect without a restart."""
    text = redis_limit(os.sysconf('SC_PAGE_SIZE') * os.sysconf('SC_PHYS_PAGES'))
    _write(REDIS_EFA_CONF, text)
    shutil.chown(REDIS_EFA_CONF, 'redis', 'root')
    with open(REDIS_CONF) as f:
        conf = f.read()
    include = f'include {REDIS_EFA_CONF}\n'
    if include not in conf:
        with open(REDIS_CONF, 'a') as f:
            f.write('\n' + include)
    for line in text.splitlines():
        subprocess.run(['redis-cli', 'config', 'set', *line.split()], check=False, capture_output=True)
    return {'redis': text.split()}


def ssh_admin_problem(user, groups, sudo_text, has_key, password_hash, sshd_text):
    """Why this user cannot replace root: None if the user has full sudo and can log in through SSH. Anything unclear counts against it."""
    full_sudo = re.search(r'\(ALL(\s*:\s*ALL)?\)\s+(NOPASSWD:\s*)?ALL\s*$', sudo_text, re.M)
    if not full_sudo:
        return 'no full sudo rights'
    settings = {}
    for line in sshd_text.lower().splitlines():
        key, _, value = line.partition(' ')
        settings.setdefault(key, []).extend(value.split())
    name, member = user.lower(), {group.lower() for group in groups}
    if name in settings.get('denyusers', []) or member & set(settings.get('denygroups', [])):
        return 'denied by the SSH settings'
    if settings.get('allowusers') and name not in settings['allowusers']:
        return 'not in AllowUsers'
    if settings.get('allowgroups') and not member & set(settings['allowgroups']):
        return 'not in AllowGroups'
    password = bool(password_hash) and password_hash[0] not in '!*'
    if not full_sudo.group(2) and not password:
        return 'sudo asks for a password, and the user has none'
    if password and 'yes' in settings.get('passwordauthentication', []):
        return None
    if has_key is None and 'yes' in settings.get('pubkeyauthentication', []):
        return 'unknown: eFa cannot read the SSH keys of this user'
    if not (has_key and 'yes' in settings.get('pubkeyauthentication', [])):
        return 'no SSH key and no password login'
    return None


def ssh_has_key(user, home, sshd_text):
    """True or False for an SSH key in the files of AuthorizedKeysFile, None when eFa cannot read them (such as a home it cannot see)."""
    files = next((line.split()[1:] for line in sshd_text.splitlines() if line.lower().startswith('authorizedkeysfile ')), ['.ssh/authorized_keys'])
    if not os.path.isdir(home):
        return None
    unknown = False
    for name in files:
        if name.lower() == 'none':
            continue
        path = '%'.join(part.replace('%h', home).replace('%u', user) for part in name.split('%%'))
        path = path if path.startswith('/') else os.path.join(home, path)
        try:
            with open(path) as f:
                if any(line.strip() and not line.lstrip().startswith('#') for line in f):
                    return True
        except FileNotFoundError:
            continue
        except OSError:
            unknown = True
    return None if unknown else False


def _ssh_admins():
    """Users who can take over from root, and why the others cannot."""
    with open(ETC + '/shadow') as f:
        hashes = dict(line.split(':')[:2] for line in f if ':' in line)
    admins, refused = [], {}
    for entry in pwd.getpwall():
        if not 1000 <= entry.pw_uid < 65534 or entry.pw_shell.endswith(('nologin', 'false')):
            continue
        groups = [group.gr_name for group in grp.getgrall() if entry.pw_name in group.gr_mem] + [grp.getgrgid(entry.pw_gid).gr_name]
        sudo = subprocess.run(['sudo', '-n', '-l', '-U', entry.pw_name], capture_output=True, text=True).stdout
        sshd = subprocess.run(['sshd', '-T', '-C', f'user={entry.pw_name},host=localhost,addr=127.0.0.1'], capture_output=True, text=True).stdout
        has_key = ssh_has_key(entry.pw_name, entry.pw_dir, sshd)
        problem = ssh_admin_problem(entry.pw_name, groups, sudo, has_key, hashes.get(entry.pw_name, ''), sshd)
        if problem:
            refused[entry.pw_name] = problem
        else:
            admins.append(entry.pw_name)
    return admins, refused


def _ssh_root_value():
    done = subprocess.run(['sshd', '-T'], capture_output=True, text=True)
    match = re.search(r'^permitrootlogin (\S+)$', done.stdout, re.M)
    if not match:
        raise EfaError('sshd does not answer: ' + done.stderr.strip()[-200:])
    return match.group(1)


def _sshd_apply():
    """Checks the configuration, then a reload: running sessions stay."""
    done = subprocess.run(['sshd', '-t'], capture_output=True, text=True)
    if done.returncode != 0:
        raise EfaError('sshd rejected the configuration: ' + done.stderr.strip()[-200:])
    subprocess.run(['systemctl', 'reload', 'sshd'], check=True, capture_output=True)


def _platform_path(name):
    return _platform().path(name)


def sshd_first(key, path=None):
    """The line sshd takes an option from: (value, file, line number), or None. sshd keeps the first value it reads, reads an
    Include in place (files in name order), and a Match line ends the part that holds for all logins."""
    path = path or ETC + '/ssh/sshd_config'
    try:
        with open(path) as f:
            lines = f.read().splitlines()
    except OSError:
        return None
    for number, line in enumerate(lines, 1):
        words = line.split('#', 1)[0].split()
        if not words:
            continue
        if words[0].lower() == 'match':
            return None
        if words[0].lower() == 'include':
            for pattern in words[1:]:
                pattern = ETC + pattern[4:] if pattern.startswith('/etc/') else pattern if pattern.startswith('/') else f'{ETC}/ssh/{pattern}'
                for included in sorted(glob.glob(pattern)):
                    found = sshd_first(key, included)
                    if found:
                        return found
        elif words[0].lower() == key.lower() and len(words) > 1:
            return words[1].lower(), path, number
    return None


# sshd -T names prohibit-password by its old name.
SSHD_SAME = {'without-password': 'prohibit-password'}


def ssh_override_problem(wanted, effective):
    """An error text when sshd does not take the value eFa wrote: which line comes first."""
    if SSHD_SAME.get(effective, effective) == SSHD_SAME.get(wanted, wanted):
        return None
    first = sshd_first('PermitRootLogin')
    where = f'{first[1]} line {first[2]} sets PermitRootLogin {first[0]} and comes first' if first else 'another setting comes first'
    return f'sshd does not take PermitRootLogin {wanted}: {where}.'


# The modes of the switch from what sshd -T shows.
SSH_ROOT_SHOWN = {'yes': 'on', 'prohibit-password': 'key-only', 'without-password': 'key-only', 'no': 'off'}


def ssh_root_status(_args):
    """Whether root can log in through SSH, and who could take over."""
    value = _ssh_root_value()
    admins, refused = _ssh_admins()
    warnings = []
    # eFa wrote another value than the one sshd takes: an earlier file (such as the 01-permitrootlogin.conf of Anaconda) wins.
    # Only the first file of eFa in the order sshd reads them counts: a later one of eFa is overruled by eFa itself.
    own = sorted({path for path in (SSH_ROOT_DROPIN, _platform_path('sshd_root_dropin'), SSH_ROOT_OLD_DROPIN) if path and os.path.exists(path)})
    written = sshd_first('PermitRootLogin', own[0]) if own else None
    problem = ssh_override_problem(written[0], value) if written else None
    if problem:
        warnings.append(problem)
    if value == 'yes':
        warnings.append('Root can log in through SSH with a password (PermitRootLogin yes). With key-only, root keeps its SSH keys and passwords stop.')
    elif value not in ('no',):
        warnings.append(f'Root can log in through SSH with an SSH key (PermitRootLogin {value}).')
    if value != 'no':
        if not admins:
            warnings.append('No other user can take over yet: it needs full sudo rights and an SSH key or a password login.')
    return {'ssh_root_login': value, 'mode': SSH_ROOT_SHOWN.get(value, value), 'ssh_admins': admins, 'ssh_refused': refused, 'warnings': warnings}


# What each mode of the switch writes. "off" also stops SSH keys of root; "key-only" stops passwords only.
SSH_ROOT_MODES = {'on': None, 'key-only': 'prohibit-password', 'off': 'no'}


def ssh_root_set(args):
    """Root login through SSH: on, with an SSH key only, or off. Off also refuses the SSH keys of root,
    so it needs another user with full sudo rights and SSH access."""
    _confirm(args)
    mode = args.mode.strip().lower()
    mode = {'yes': 'on', 'no': 'off', 'prohibit-password': 'key-only'}.get(mode, mode)
    if mode not in SSH_ROOT_MODES:
        raise EfaError('Mode: on, key-only or off.')
    previous = open(SSH_ROOT_DROPIN).read() if os.path.exists(SSH_ROOT_DROPIN) else None
    if mode == 'off' and not _ssh_admins()[0]:
        raise EfaError('Refused: no other user with full sudo rights and an SSH key or a password login. Root login stays on.')
    if SSH_ROOT_MODES[mode] is None:
        if previous is not None:
            os.remove(SSH_ROOT_DROPIN)
    else:
        _write(SSH_ROOT_DROPIN, f'PermitRootLogin {SSH_ROOT_MODES[mode]}\n')
    try:
        _sshd_apply()
        # A file read before ours can hold another value: then the switch would show a state that is not there.
        problem = ssh_override_problem(SSH_ROOT_MODES[mode], _ssh_root_value()) if SSH_ROOT_MODES[mode] else None
        if problem:
            raise EfaError(problem + ' The switch is taken back; remove or change that line first.')
    except (EfaError, subprocess.CalledProcessError):
        if previous is None:
            if os.path.exists(SSH_ROOT_DROPIN):
                os.remove(SSH_ROOT_DROPIN)
        else:
            _write(SSH_ROOT_DROPIN, previous)
        try:
            _sshd_apply()
        except (EfaError, subprocess.CalledProcessError):
            pass
        raise
    _audit(f'root login through SSH set to {mode} by {_dmarc_who()}')
    return {'ssh_root_login': _ssh_root_value()}


def _admin_db():
    """As root: users, tokens and the audit log are out of reach of the mail log user."""
    import pymysql
    try:
        return pymysql.connect(unix_socket='/var/lib/mysql/mysql.sock', user='root', password=_mysql_env().get('MYSQL_PWD', ''), database='efa',
                               charset='utf8mb4', autocommit=True, cursorclass=pymysql.cursors.DictCursor)
    except pymysql.MySQLError as err:
        raise EfaError(f'The database does not answer: {err}')


def _admin_query(sql, params=()):
    db = _admin_db()
    try:
        with db.cursor() as cur:
            cur.execute(sql, params)
            return cur.fetchall()
    finally:
        db.close()


def web_password_hash(password, salt=None, rounds=600000):
    salt = salt or secrets.token_bytes(16)
    digest = hashlib.pbkdf2_hmac('sha256', password.encode(), salt, rounds)
    return f'pbkdf2_sha256${rounds}${base64.b64encode(salt).decode()}${base64.b64encode(digest).decode()}'


def web_password_ok(stored, password):
    try:
        _, rounds, salt, digest = stored.split('$')
        calculated = hashlib.pbkdf2_hmac('sha256', password.encode(), base64.b64decode(salt), int(rounds))
        return secrets.compare_digest(calculated, base64.b64decode(digest))
    except ValueError:
        return False


def command_permission(name, writes):
    """The one permission a command needs. Everything without its own is a system setting."""
    if name in COMMAND_PERMISSIONS:
        return COMMAND_PERMISSIONS[name]
    for prefix, read, write in COMMAND_PERMISSION_PREFIXES:
        if name.startswith(prefix):
            return write if writes else read
    return 'settings.edit' if writes else 'settings.view'


def command_allowed(identity, name, writes):
    """identity None is root on the console, or the main admin of the web interface."""
    if identity is None:
        return True
    permission = command_permission(name, writes)
    return permission is None or permission in identity['grants']


def _scope_merge(old, new):
    """None is the whole system and wins."""
    if old is None or new is None:
        return None
    return {'tenants': old['tenants'] | new['tenants'], 'domains': old['domains'] | new['domains']}


def membership_scope(group, member, tenant_domains):
    if group['scope'] == 'member':
        if member.get('tenant_id') is not None:
            return {'tenants': {member['tenant_id']}, 'domains': set(tenant_domains.get(member['tenant_id'], ()))}
        if member.get('domain'):
            return {'tenants': set(), 'domains': {member['domain']}}
        return None
    if group['scope'] == 'global':
        return None
    domains = set(group['scope_domains'])
    for tenant in group['scope_tenants']:
        domains |= set(tenant_domains.get(tenant, ()))
    return {'tenants': set(group['scope_tenants']), 'domains': domains}


def grants_of(memberships, tenant_domains):
    """{permission: scope} of a user. The permissions of all groups add up, each with the scope of its group."""
    grants = {}
    for member in memberships:
        group = member['group']
        if group.get('disabled'):
            continue
        scope = membership_scope(group, member, tenant_domains)
        permissions = set(group['permissions']) | (set(group.get('global_extra', ())) if scope is None else set())
        permissions |= {implied for permission in permissions for implied in IMPLIED_PERMISSIONS.get(permission, ())}
        for permission in permissions:
            if permission in GLOBAL_PERMISSIONS and scope is not None:
                continue
            grants[permission] = _scope_merge(grants[permission], scope) if permission in grants else (
                None if scope is None else {'tenants': set(scope['tenants']), 'domains': set(scope['domains'])})
    return grants


def grants_cover(have, wanted):
    """Nobody hands out a permission or a scope they do not have themselves. have None is root or the main admin."""
    if have is None:
        return True
    for permission, scope in wanted.items():
        if permission not in have:
            return False
        if have[permission] is None:
            continue
        if scope is None or not scope['tenants'] <= have[permission]['tenants'] or not scope['domains'] <= have[permission]['domains']:
            return False
    return True


def _group_row(row):
    """A row of efa_groups as used by grants_of. Predefined groups take their permissions from the code."""
    if row['builtin'] in BUILTIN_GROUPS:
        spec = BUILTIN_GROUPS[row['builtin']]
        return {**row, 'permissions': set(spec['permissions']), 'global_extra': set(spec.get('global_extra', ())), 'scope': 'member',
                'scope_tenants': set(), 'scope_domains': set(), 'description': spec['description'], 'disabled': 0}
    return {**row, 'permissions': set((row['permissions'] or '').split()), 'global_extra': set(),
            'scope_tenants': {int(item) for item in (row['scope_tenants'] or '').split(',') if item.isdigit()},
            'scope_domains': {item for item in (row['scope_domains'] or '').split(',') if item}}


def _groups():
    return {row['id']: _group_row(row) for row in _admin_query('SELECT id, name, description, builtin, permissions, scope, scope_tenants, scope_domains, '
                                                               'disabled FROM efa_groups')}


def _tenant_domains():
    found = {}
    for row in _admin_query('SELECT domain, tenant_id FROM tenant_domains'):
        found.setdefault(row['tenant_id'], []).append(row['domain'])
    return found


def _memberships(username, groups=None):
    groups = groups if groups is not None else _groups()
    return [{**row, 'group': groups[row['group_id']]} for row in _admin_query('SELECT group_id, tenant_id, domain FROM user_groups WHERE username = %s',
                                                                              (username,)) if row['group_id'] in groups]


def user_tenants(memberships, tenant_domains):
    """The tenants a user belongs to, and whether one of the memberships reaches beyond tenants (global or a domain without tenant)."""
    tenant_of = {domain: tenant for tenant, domains in tenant_domains.items() for domain in domains}
    found, beyond = set(), False
    for member in memberships:
        scope = membership_scope(member['group'], member, tenant_domains)
        if scope is None:
            beyond = True
            continue
        found |= set(scope['tenants'])
        for domain in scope['domains']:
            if domain in tenant_of:
                found.add(tenant_of[domain])
            else:
                beyond = True
    return found, beyond


def restrict_grants(grants, tenant_id, tenant_domains):
    """The permissions of a token bound to one tenant: only inside it, nothing of the whole system."""
    inside = {'tenants': {tenant_id}, 'domains': set(tenant_domains.get(tenant_id, ()))}
    found = {}
    for permission, scope in grants.items():
        if permission in GLOBAL_PERMISSIONS:
            continue
        if scope is None:
            found[permission] = {'tenants': set(inside['tenants']), 'domains': set(inside['domains'])}
            continue
        kept = {'tenants': scope['tenants'] & inside['tenants'], 'domains': scope['domains'] & inside['domains']}
        if kept['tenants'] or kept['domains']:
            found[permission] = kept
    return found


def role_label(memberships, grants):
    """A short word for the web interface: super sees all pages, user gets the quarantine as start page."""
    if any(member['group'].get('builtin') == 'super' for member in memberships):
        return 'super'
    return 'user' if set(grants) <= {'quarantine.self'} else 'admin'


def _identity(row, memberships, tenant_domains):
    grants = grants_of(memberships, tenant_domains)
    return {**row, 'memberships': memberships, 'grants': grants, 'role': role_label(memberships, grants), 'domains': [], 'tenant_ids': [], 'tenant_id': None}


def identity_focus(identity, permission):
    """Sets the scope of the permission the command needs: domains and tenant_ids None mean the whole system."""
    nothing = {'tenants': set(), 'domains': set()}
    scope = identity['grants'].get(permission, nothing) if permission else nothing
    identity['domains'] = None if scope is None else sorted(scope['domains'])
    identity['tenant_ids'] = None if scope is None else sorted(scope['tenants'])
    identity['tenant_id'] = identity['tenant_ids'][0] if identity['tenant_ids'] else None
    return identity


def _mail_domains(text):
    return {item.rsplit('@', 1)[1].lower() for item in re.split(r'[\s,;<>]+', text or '') if '@' in item}


def in_scope(identity, addresses):
    """identity['domains'] None means no limit."""
    if identity is None or identity['domains'] is None:
        return True
    return bool(_mail_domains(' '.join(addresses)) & set(identity['domains']))


DOMAIN_WORD_RE = re.compile(r'\b(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\.)+[a-z]{2,}\b', re.I)


def domain_filter(value, domains, own_host=''):
    """Removes what names a domain outside the scope: list entries, keys, and texts in lists. The host name of eFa itself stays."""
    def foreign(text):
        words = [word.lower() for word in DOMAIN_WORD_RE.findall(text)]
        return any(word != own_host and word not in domains and not any(word.endswith('.' + domain) for domain in domains) for word in words)
    if isinstance(value, dict):
        return {key: domain_filter(item, domains, own_host) for key, item in value.items()
                if not (DOMAIN_RE.match(str(key).lower()) and str(key).lower() not in domains)}
    if isinstance(value, list):
        kept = []
        for item in value:
            if isinstance(item, dict) and isinstance(item.get('domain'), str) and item['domain'].lower() not in domains:
                continue
            if isinstance(item, str) and foreign(item):
                continue
            kept.append(domain_filter(item, domains, own_host))
        return kept
    return value


def domain_argument_ok(identity, name, args):
    """The domain named in the arguments is one of the own, for a limited scope. An empty one means all, so it is refused then."""
    if identity is None or identity['domains'] is None or name not in DOMAIN_ARGUMENTS:
        return True
    value = (getattr(args, DOMAIN_ARGUMENTS[name], '') or '').strip().lower()
    return bool(value) and value.rsplit('@', 1)[-1] in identity['domains']


def subjects_shown():
    return _json_read(PRIVACY_FILE, {}).get('show_subjects', True)


def subject_filter(identity, name, result, shown):
    """Subjects in the log and the search only with the permission, and while the switch is on."""
    if name not in SUBJECT_COMMANDS or not isinstance(result, dict) or 'mails' not in result:
        return result
    if shown and (identity is None or 'mail.view_subject' in identity['grants']):
        return result
    return {**result, 'mails': [{**mail, 'subject': ''} for mail in result['mails']]}


def subject_display_set(args):
    """Show subjects in the mail log and the search, or not. On by default: it changes nothing in the mail flow."""
    enabled = _on_off(args.mode)
    _json_write(PRIVACY_FILE, {**_json_read(PRIVACY_FILE, {}), 'show_subjects': enabled})
    return {'show_subjects': enabled}


def scoped_result(identity, name, result):
    """Leaves only what belongs to the caller. Everything a limited role may run and that shows mail passes here."""
    if identity is None or identity['domains'] is None or not isinstance(result, dict):
        return result
    if name in DOMAIN_FILTERED:
        return domain_filter(result, set(identity['domains']), socket.getfqdn().lower())
    if name == 'sender-list':
        # The global lists are for the whole system; a domain sees its own rules.
        return {'allow': [], 'block': [], 'rules': [rule for rule in result.get('rules', []) if rule.get('recipient', '').rsplit('@', 1)[-1] in identity['domains']]}
    if name == 'quarantine-list':
        return {**result, 'quarantine': [m for m in result['quarantine'] if in_scope(identity, m['recipients'])]}
    if name in ('maillog-search', 'maillog-live', 'message-search') and 'mails' in result:
        return {**result, 'mails': [m for m in result['mails'] if in_scope(identity, [m.get('rcpt') or '', m.get('sender') or ''])]}
    return result


def _load_identity(username, allow_disabled=False, limit_tenant=None):
    rows = _admin_query('SELECT username, email, source, disabled FROM users WHERE username = %s', (username,))
    if not rows:
        raise EfaError('Unknown user.')
    if rows[0]['disabled'] and not allow_disabled:
        raise EfaError('This user is disabled.')
    tenant_domains = _tenant_domains()
    memberships = _memberships(username)
    tenants, beyond = user_tenants(memberships, tenant_domains)
    if tenants and not beyond and not allow_disabled:
        locked = {row['id'] for row in _admin_query('SELECT id FROM tenants WHERE locked = 1')}
        if tenants <= locked:
            raise EfaError('This tenant is locked.')
    identity = _identity(rows[0], memberships, tenant_domains)
    identity['tenants_of_user'] = tenants if not beyond else None
    if limit_tenant is not None:
        identity['grants'] = restrict_grants(identity['grants'], limit_tenant, tenant_domains)
        identity['role'] = role_label([], identity['grants']) if identity['role'] == 'super' else identity['role']
    return identity


def _scope_text(scope, tenant_names):
    if scope is None:
        return 'global'
    return ', '.join(sorted([f"tenant {tenant_names.get(item, item)}" for item in scope['tenants']] + sorted(scope['domains']))) or 'nothing'


def _grants_text(grants):
    names = {row['id']: row['name'] for row in _admin_query('SELECT id, name FROM tenants')}
    return {permission: _scope_text(scope, names) for permission, scope in sorted(grants.items())}


# Personal settings: the main admin has no user row, so its settings are in a file.
PREFS_DEFAULTS = {'language': 'auto', 'timezone': '', 'page_size': 100, 'notifications': True, 'view': 'standard'}
PREFS_PAGE_SIZES = (25, 50, 100, 200, 500)
ADMIN_PREFS = ETC + '/eFa/admin-prefs.json'


def prefs_of(username):
    """The personal settings of a login, with the defaults for what it never set."""
    if not username:
        return {**PREFS_DEFAULTS, **_json_read(ADMIN_PREFS, {})}
    rows = _admin_query('SELECT prefs FROM users WHERE username = %s', (username,))
    try:
        stored = json.loads(rows[0]['prefs']) if rows and rows[0]['prefs'] else {}
    except ValueError:
        stored = {}
    return {**PREFS_DEFAULTS, **stored}


def prefs_check(current, language, timezone, page_size, notifications, view=''):
    """The new settings from the form; empty keeps a value."""
    found = dict(current)
    if language:
        if language not in ('auto', 'en', 'de'):
            raise EfaError('Language: auto, en or de.')
        found['language'] = language
    if timezone:
        import zoneinfo
        if timezone != 'server':
            try:
                zoneinfo.ZoneInfo(timezone)
            except (zoneinfo.ZoneInfoNotFoundError, ValueError):
                raise EfaError('Time zone: a name such as Europe/Vienna, or server.')
        found['timezone'] = '' if timezone == 'server' else timezone
    if page_size:
        if not page_size.isdigit() or int(page_size) not in PREFS_PAGE_SIZES:
            raise EfaError('Rows per page: ' + ', '.join(map(str, PREFS_PAGE_SIZES)) + '.')
        found['page_size'] = int(page_size)
    if notifications:
        found['notifications'] = _on_off(notifications)
    if view:
        if view not in ('standard', 'expert'):
            raise EfaError('View: standard or expert.')
        found['view'] = view
    return found


def my_settings(_args):
    """Your own settings: language, time zone, rows per page, report mails."""
    return prefs_of(identity_now['username'] if identity_now else '')


def my_settings_set(args):
    """Change your own settings. Nobody changes the settings of another login here."""
    username = identity_now['username'] if identity_now else ''
    found = prefs_check(prefs_of(username), (args.language or '').strip(), (args.timezone or '').strip(), (args.page_size or '').strip(),
                        (args.notifications or '').strip(), (getattr(args, 'view', '') or '').strip())
    if username:
        _admin_query('UPDATE users SET prefs = %s WHERE username = %s', (json.dumps(found), username))
    else:
        _json_write(ADMIN_PREFS, found)
    return found


def local_times(rows, timezone, key='ts'):
    """Times of the mail log, stored in server time, in the time zone of the reader."""
    if not timezone:
        return rows
    import zoneinfo
    zone = zoneinfo.ZoneInfo(timezone)
    for row in rows:
        try:
            row[key] = datetime.datetime.fromisoformat(str(row[key])).astimezone(zone).strftime('%Y-%m-%d %H:%M:%S')
        except (ValueError, TypeError, KeyError):
            pass
    return rows


def _reader_timezone():
    try:
        return prefs_of(identity_now['username'] if identity_now else '')['timezone']
    except Exception:  # no database yet: server time
        return ''


def whoami(_args):
    """Who this login is, its groups and what it may do where."""
    if identity_now is None:
        return {'username': acting_user or 'admin', 'role': 'super', 'domains': None, 'permissions': {permission: 'global' for permission in PERMISSIONS}}
    tenants = identity_now.get('tenants_of_user')
    brand = tenant_brand(next(iter(tenants))) if tenants and len(tenants) == 1 else None
    return {'username': identity_now['username'], 'role': identity_now['role'], 'groups': [m['group']['name'] for m in identity_now['memberships']],
            'permissions': _grants_text(identity_now['grants']), 'brand': brand}


def permission_list(_args):
    """The permissions that groups can hold. Those marked global need a group for the whole system."""
    return {'permissions': [{'name': name, 'description': text, 'global_only': name in GLOBAL_PERMISSIONS} for name, text in PERMISSIONS.items()]}


def _tenant_id(name):
    rows = _admin_query('SELECT id FROM tenants WHERE name = %s', (name,))
    if not rows:
        raise EfaError(f'Unknown tenant: {name}')
    return rows[0]['id']


def tenant_list(_args):
    """Tenants with their domains."""
    tenants = _admin_query('SELECT t.id, t.name, GROUP_CONCAT(d.domain ORDER BY d.domain) AS domains FROM tenants t '
                           'LEFT JOIN tenant_domains d ON d.tenant_id = t.id GROUP BY t.id ORDER BY t.name')
    if identity_now and identity_now['tenant_ids'] is not None:
        tenants = [t for t in tenants if t['id'] in identity_now['tenant_ids']]
    return {'tenants': [{'name': t['name'], 'domains': (t['domains'] or '').split(',') if t['domains'] else []} for t in tenants]}


def tenant_set(args):
    """Add or remove a tenant. A tenant is one customer, with its domains and users."""
    name, action = args.name.strip(), args.action.strip()
    if not TENANT_RE.match(name):
        raise EfaError('Invalid tenant name.')
    if action == 'add':
        _admin_query('INSERT IGNORE INTO tenants (name) VALUES (%s)', (name,))
    elif action == 'remove':
        tenant = _tenant_id(name)
        if _admin_query('SELECT 1 FROM users WHERE tenant_id = %s LIMIT 1', (tenant,)):
            raise EfaError('This tenant still has users.')
        _admin_query('DELETE FROM tenant_domains WHERE tenant_id = %s', (tenant,))
        _admin_query('DELETE FROM tenants WHERE id = %s', (tenant,))
    else:
        raise EfaError("Action must be 'add' or 'remove'.")
    return tenant_list(None)


def tenant_domain_set(args):
    """Give a domain to a tenant, or take it away. A domain belongs to one tenant."""
    domain, action = args.domain.strip().lower(), args.action.strip()
    if not DOMAIN_RE.match(domain):
        raise EfaError('Invalid domain.')
    tenant = _tenant_id(args.tenant.strip())
    if action == 'add':
        _tenant_add_domain(tenant, domain)
        return tenant_list(None)
    elif action == 'remove':
        _admin_query('DELETE FROM tenant_domains WHERE domain = %s AND tenant_id = %s', (domain, tenant))
    else:
        raise EfaError("Action must be 'add' or 'remove'.")
    if _layer_rows():
        # The settings of the tenant now count for this domain, or no longer.
        _layers_apply()
    return tenant_list(None)


def _member_text(member, tenant_names):
    where = tenant_names.get(member['tenant_id']) if member['tenant_id'] is not None else member['domain']
    return member['group']['name'] + (f' ({where})' if where else '')


def _users_in_scope(scope):
    """Users with a membership in the scope. None: all."""
    rows = _admin_query('SELECT username, email, source, disabled, CAST(last_login AS CHAR) AS last_login FROM users ORDER BY username')
    if scope is None:
        return rows
    inside = {row['username'] for row in _admin_query('SELECT username, tenant_id, domain FROM user_groups')
              if row['tenant_id'] in scope['tenants'] or (row['domain'] and row['domain'] in scope['domains'])}
    return [row for row in rows if row['username'] in inside]


def _actor_grants():
    return None if identity_now is None else identity_now['grants']


def _actor_scope(permission):
    return None if identity_now is None else identity_now['grants'].get(permission, {'tenants': set(), 'domains': set()})


def user_list(_args):
    """Users of the web interface and the API, besides the main admin, with their groups."""
    names = {row['id']: row['name'] for row in _admin_query('SELECT id, name FROM tenants')}
    groups = _groups()
    users = _users_in_scope(_actor_scope('users.view'))
    for user in users:
        user['groups'] = [_member_text(member, names) for member in _memberships(user['username'], groups)]
        user['disabled'] = bool(user['disabled'])
    return {'users': users}


def user_show(args):
    """One user with the effective permissions and where they count."""
    username = args.username.strip()
    if username not in {row['username'] for row in _users_in_scope(_actor_scope('users.view'))}:
        raise EfaError('Unknown user.')
    target = _load_identity(username, allow_disabled=True)
    names = {row['id']: row['name'] for row in _admin_query('SELECT id, name FROM tenants')}
    return {'username': username, 'email': target['email'], 'source': target['source'], 'disabled': bool(target['disabled']), 'role': target['role'],
            'groups': [_member_text(member, names) for member in target['memberships']], 'permissions': _grants_text(target['grants'])}


def _super_admins(changes=None):
    """Active users in the group super admin, after the changes {username: memberships or None for gone or disabled}. The main admin counts too."""
    found = 1 if os.path.exists(PASSWORD_FILE) else 0
    supers = {row['username'] for row in _admin_query("SELECT m.username FROM user_groups m JOIN efa_groups g ON g.id = m.group_id "
                                                      "JOIN users u ON u.username = m.username WHERE g.builtin = 'super' AND u.disabled = 0")}
    for username, memberships in (changes or {}).items():
        supers.discard(username)
        if memberships and any(member['group'].get('builtin') == 'super' for member in memberships):
            supers.add(username)
    return found + len(supers)


def user_change_problem(actor, target, old_grants, new_grants, removing, super_left):
    """Why a change of a user is refused, or None. actor is the user name of who works, None for root or the main admin."""
    if actor is not None and actor == target and (removing or old_grants != new_grants):
        return 'You cannot remove, disable or change the groups of your own login.'
    if super_left == 0:
        return 'This is the last active super admin.'
    return None


def _check_user_change(target, old_grants, new_grants, removing, new_memberships):
    have = _actor_grants()
    if not grants_cover(have, old_grants) or not grants_cover(have, new_grants):
        raise EfaError('Not allowed: this needs permissions or a scope you do not have.')
    problem = user_change_problem(identity_now['username'] if identity_now else None, target, old_grants, new_grants, removing,
                                  _super_admins({target: None if removing else new_memberships}))
    if problem:
        raise EfaError(problem)


def _group_by_name(name, groups):
    for group in groups.values():
        if group['name'].lower() == name.strip().lower():
            return group
    raise EfaError(f'Unknown group: {name.strip()}')


def wanted_memberships(group_names, tenant, domain, groups):
    """Memberships from a list of group names. Tenant and domain are the scope of the predefined groups."""
    found = []
    for name in group_names:
        group = _group_by_name(name, groups)
        member = {'group_id': group['id'], 'group': group, 'tenant_id': None, 'domain': None}
        if group['scope'] == 'member':
            member.update(tenant_id=tenant, domain=domain or None)
            if group.get('builtin') == 'super' and (tenant is not None or domain):
                raise EfaError('A super admin has no tenant or domain.')
            if group.get('builtin') == 'tenant' and tenant is None:
                raise EfaError('A tenant admin needs a tenant.')
            if group.get('builtin') == 'domain' and not domain:
                raise EfaError('A domain admin needs a domain.')
        found.append(member)
    return found


def _set_memberships(username, memberships):
    _admin_query('DELETE FROM user_groups WHERE username = %s', (username,))
    for member in memberships:
        _admin_query('INSERT INTO user_groups (username, group_id, tenant_id, domain) VALUES (%s, %s, %s, %s)',
                     (username, member['group_id'], member['tenant_id'], member['domain']))


def user_set(args):
    """Add or change a user, or remove one. Groups by name, separated by commas; tenant and domain are the scope of the predefined groups."""
    username, action = args.username.strip(), args.action.strip()
    if not USER_RE.match(username):
        raise EfaError('Invalid user name.')
    known = _admin_query('SELECT username FROM users WHERE username = %s', (username,))
    tenant_domains = _tenant_domains()
    old = _load_identity(username, allow_disabled=True) if known else None
    old_grants = old['grants'] if old else {}
    if action == 'remove':
        if not known:
            raise EfaError('Unknown user.')
        _confirm(args)
        _check_user_change(username, old_grants, {}, True, [])
        _admin_query('DELETE FROM api_tokens WHERE username = %s', (username,))
        _admin_query('DELETE FROM user_groups WHERE username = %s', (username,))
        _admin_query('DELETE FROM users WHERE username = %s', (username,))
        _admin_query('UPDATE web_sessions SET ended = NOW(), ended_by = %s WHERE username = %s AND ended IS NULL', (_dmarc_who()[:120], username))
        return user_list(None)
    if action != 'set':
        raise EfaError("Action must be 'set' or 'remove'.")
    domain = (args.domain or '').strip().lower()
    address = (args.email or '').strip().lower()
    if address and not SENDER_RE.match(address):
        raise EfaError('Invalid email address.')
    tenant = _tenant_id(args.tenant.strip()) if (args.tenant or '').strip() else None
    if domain and not DOMAIN_RE.match(domain):
        raise EfaError('Invalid domain.')
    if domain and tenant is not None and domain not in tenant_domains.get(tenant, ()):
        raise EfaError('This domain does not belong to the tenant.')
    names = [item for item in (args.groups or '').split(',') if item.strip()]
    if not known:
        limit_tenants = {tenant} if tenant is not None else ({_tenant_of_domain(domain)} - {None} if domain else set())
        for item in limit_tenants:
            _tenant_limit(item, 'users')
    role = (args.role or '').strip()
    if role and not names:
        if role not in ROLES:
            raise EfaError('Role must be one of: ' + ', '.join(ROLES))
        names = [BUILTIN_GROUPS[role]['name']]
    groups = _groups()
    memberships = wanted_memberships(names, tenant, domain, groups) if names else (old['memberships'] if old else [])
    if not memberships:
        raise EfaError('A new user needs at least one group.')
    new_grants = grants_of(memberships, tenant_domains)
    _check_user_change(username, old_grants, new_grants, False, memberships)
    password = password_twice('Password, empty keeps it')
    if password and password_problem(password, username):
        raise EfaError(password_problem(password, username))
    if not known and not password:
        raise EfaError('A new user needs a password.')
    stored = web_password_hash(password) if password else None
    first = next((member['group']['builtin'] for member in memberships if member['group'].get('builtin')), 'custom')
    _admin_query('INSERT INTO users (username, role, tenant_id, domain, email, password, groups_migrated) VALUES (%s, %s, %s, %s, %s, %s, 1) '
                 'ON DUPLICATE KEY UPDATE role = VALUES(role), tenant_id = VALUES(tenant_id), domain = VALUES(domain), email = VALUES(email), '
                 'password = IF(%s, VALUES(password), password)', (username, first, tenant, domain or None, address or None, stored or '', bool(stored)))
    if names or not known:
        _set_memberships(username, memberships)
    if known and old and grants_of(memberships, tenant_domains) != old_grants:
        _admin_query('UPDATE web_sessions SET ended = NOW(), ended_by = %s WHERE username = %s AND ended IS NULL', (_dmarc_who()[:120], username))
    return user_list(None)


def user_state(args):
    """Disable a user, or enable again. A disabled user cannot log in; the API tokens stop working too."""
    username, enabled = args.username.strip(), _on_off(args.mode)
    if not _admin_query('SELECT 1 FROM users WHERE username = %s', (username,)):
        raise EfaError('Unknown user.')
    target = _load_identity(username, allow_disabled=True)
    _check_user_change(username, target['grants'], target['grants'] if enabled else {}, not enabled, target['memberships'])
    _admin_query('UPDATE users SET disabled = %s WHERE username = %s', (int(not enabled), username))
    if not enabled:
        # Locked means out now, not at the next login.
        _admin_query('UPDATE web_sessions SET ended = NOW(), ended_by = %s WHERE username = %s AND ended IS NULL', (_dmarc_who()[:120], username))
    return user_show(argparse.Namespace(username=username))


SESSION_IDLE_SECONDS = 3600
SESSION_ID_RE = re.compile(r'^[0-9a-f]{12}([0-9a-f]{52})?$')


def _session_id(args):
    value = (args.session or '').strip().lower()
    if not SESSION_ID_RE.match(value):
        raise EfaError('Session: its ID, 12 or 64 hex characters.')
    return value


def session_open(args):
    """The web interface tells a new login. Only the hash of the session cookie is stored."""
    sha = _session_id(args)
    if len(sha) != 64:
        raise EfaError('Session: the full hash.')
    _admin_query('DELETE FROM web_sessions WHERE last_seen < NOW() - INTERVAL 1 DAY')
    _admin_query('INSERT INTO web_sessions (sid_sha256, username, client, agent) VALUES (%s, %s, %s, %s)',
                 (sha, identity_now['username'] if identity_now else '', acting_client[:64], (args.agent or '')[:200]))
    return {'session': sha[:12]}


def session_check(args):
    """Is this session still on: not ended, the user not disabled. Also the role again, so a change of groups takes effect."""
    sha = _session_id(args)
    rows = _admin_query('SELECT username, ended FROM web_sessions WHERE sid_sha256 = %s', (sha,))
    if not rows or rows[0]['ended'] or rows[0]['username'] != (identity_now['username'] if identity_now else ''):
        return {'active': False}
    _admin_query('UPDATE web_sessions SET last_seen = NOW() WHERE sid_sha256 = %s', (sha,))
    return {'active': True, 'role': identity_now['role'] if identity_now else 'super'}


def _session_visible(row):
    """Own sessions always. Others for whoever may change that user; those of the main admin only for a super admin."""
    if identity_now is None:
        return True
    if row['username'] == identity_now['username']:
        return True
    if not row['username']:
        return identity_now['role'] == 'super'
    if 'users.manage' not in identity_now['grants']:
        return False
    if row['username'] not in {user['username'] for user in _users_in_scope(identity_now['grants']['users.manage'])}:
        return False
    return grants_cover(identity_now['grants'], _load_identity(row['username'], allow_disabled=True)['grants'])


def session_list(_args):
    """Active logins of the web interface, your own on other devices too."""
    rows = _admin_query('SELECT sid_sha256, username, client, agent, CAST(started AS CHAR) AS started, CAST(last_seen AS CHAR) AS last_seen FROM web_sessions '
                        'WHERE ended IS NULL AND last_seen > NOW() - INTERVAL %s SECOND ORDER BY last_seen DESC', (SESSION_IDLE_SECONDS,))
    return {'sessions': [{'id': row['sid_sha256'][:12], 'user': row['username'] or 'admin (main)', 'client': row['client'], 'browser': row['agent'],
                          'started': row['started'], 'last_seen': row['last_seen']} for row in rows if _session_visible(row)]}


def session_end(args):
    """End a session: the browser is logged out within 15 seconds."""
    value = _session_id(args)
    rows = [row for row in _admin_query('SELECT sid_sha256, username FROM web_sessions WHERE ended IS NULL AND sid_sha256 LIKE %s', (value + '%',))
            if _session_visible(row)]
    if len(rows) != 1:
        raise EfaError('No such active session.')
    _admin_query('UPDATE web_sessions SET ended = NOW(), ended_by = %s WHERE sid_sha256 = %s', (_dmarc_who()[:120], rows[0]['sid_sha256']))
    return {'ended': rows[0]['sid_sha256'][:12], 'user': rows[0]['username'] or 'admin (main)'}


def _own_tenant(args):
    """The tenant named in the arguments, if it is inside the scope of the permission of the command."""
    tenant_id = _tenant_id((args.tenant or '').strip())
    if identity_now and identity_now['tenant_ids'] is not None and tenant_id not in identity_now['tenant_ids']:
        raise EfaError('Not allowed: this tenant is outside your scope.')
    return tenant_id


def tenant_idp_status(args):
    """The login directory of a tenant: LDAP and OIDC, and its group mappings."""
    tenant_id = _own_tenant(args)
    return {'ldap': ldap_status(None, _idp_file('ldap', tenant_id)), 'oidc': oidc_status(None, _idp_file('oidc', tenant_id)),
            'groups': group_map_list(None, tenant_id)['groups']}


def tenant_ldap_set(args):
    """LDAP or Active Directory of a tenant: for logins with an address of its domains."""
    return ldap_set(args, _idp_file('ldap', _own_tenant(args)))


def tenant_oidc_set(args):
    """Single sign-on of a tenant: the login page asks for the mail domain and uses it."""
    return oidc_set(args, _idp_file('oidc', _own_tenant(args)))


def tenant_group_map_set(args):
    """A group of the directory of a tenant gets an eFa group, inside the tenant only."""
    return group_map_set(args, _own_tenant(args))


def png_size(data):
    """(width, height) of a PNG, or an error: only PNG, as an SVG can carry script."""
    if len(data) > BRAND_LOGO_BYTES:
        raise EfaError(f'Logo: at most {BRAND_LOGO_BYTES // 1024} KB.')
    if data[:8] != b'\x89PNG\r\n\x1a\n' or data[12:16] != b'IHDR' or not data.rstrip(b'\0').endswith(b'IEND\xaeB`\x82'):
        raise EfaError('Logo: a PNG file only.')
    width, height = int.from_bytes(data[16:20], 'big'), int.from_bytes(data[20:24], 'big')
    if not (1 <= width <= 1024 and 1 <= height <= 1024):
        raise EfaError('Logo: at most 1024 by 1024 pixels.')
    return width, height


def tenant_brand(tenant_id):
    rows = _admin_query('SELECT name, brand_name, brand_color FROM tenants WHERE id = %s', (tenant_id,))
    if not rows or not (rows[0]['brand_name'] or rows[0]['brand_color'] or os.path.exists(f'{BRAND_DIR}/{tenant_id}.png')):
        return None
    return {'tenant_id': tenant_id, 'name': rows[0]['brand_name'] or rows[0]['name'], 'color': rows[0]['brand_color'] or '',
            'logo': os.path.exists(f'{BRAND_DIR}/{tenant_id}.png')}


def tenant_brand_show(args):
    """Name, colour and logo of a tenant, for the web interface, the digest and the reports."""
    return {'brand': tenant_brand(_own_tenant(args))}


def tenant_brand_set(args):
    """Name, colour (#rrggbb) and logo (PNG, up to 200 KB and 1024 pixels) of a tenant. none takes a value away."""
    tenant_id = _own_tenant(args)
    name, color = (args.name or '').strip(), (args.color or '').strip()
    if name:
        if name != 'none' and (len(name) > 100 or any(ord(ch) < 32 for ch in name)):
            raise EfaError('Name: up to 100 characters.')
        _admin_query('UPDATE tenants SET brand_name = %s WHERE id = %s', (None if name == 'none' else name, tenant_id))
    if color:
        if color != 'none' and not BRAND_COLOR_RE.match(color):
            raise EfaError('Colour: like #1f6feb.')
        _admin_query('UPDATE tenants SET brand_color = %s WHERE id = %s', (None if color == 'none' else color.lower(), tenant_id))
    logo = (args.logo_file or '').strip()
    if logo == '-':
        # From the upload of the web interface, over stdin.
        data = sys.stdin.buffer.read(BRAND_LOGO_BYTES + 1)
        png_size(data)
        os.makedirs(BRAND_DIR, mode=0o755, exist_ok=True)
        with open(f'{BRAND_DIR}/{tenant_id}.png.tmp', 'wb') as f:
            f.write(data)
        os.chmod(f'{BRAND_DIR}/{tenant_id}.png.tmp', 0o644)
        os.replace(f'{BRAND_DIR}/{tenant_id}.png.tmp', f'{BRAND_DIR}/{tenant_id}.png')
    elif logo == 'none':
        if os.path.exists(f'{BRAND_DIR}/{tenant_id}.png'):
            os.remove(f'{BRAND_DIR}/{tenant_id}.png')
    elif logo:
        with open(logo, 'rb') as f:
            data = f.read(BRAND_LOGO_BYTES + 1)
        png_size(data)
        os.makedirs(BRAND_DIR, mode=0o755, exist_ok=True)
        with open(f'{BRAND_DIR}/{tenant_id}.png.tmp', 'wb') as f:
            f.write(data)
        os.chmod(f'{BRAND_DIR}/{tenant_id}.png.tmp', 0o644)
        os.replace(f'{BRAND_DIR}/{tenant_id}.png.tmp', f'{BRAND_DIR}/{tenant_id}.png')
    return {'brand': tenant_brand(tenant_id)}


def _brand_of_domain(domain):
    try:
        tenant_id = _tenant_of_domain(domain)
        return tenant_brand(tenant_id) if tenant_id is not None else None
    except EfaError:
        return None


def _tenant_counts(tenant_id, tenant_domains):
    """Domains, users and quarantine size of a tenant now."""
    domains = set(tenant_domains.get(tenant_id, ()))
    users = 0
    groups = _groups()
    for row in _admin_query('SELECT DISTINCT username FROM user_groups'):
        found, beyond = user_tenants(_memberships(row['username'], groups), tenant_domains)
        users += tenant_id in found
    size = 0
    if domains:
        found = _admin_query('SELECT COALESCE(SUM(m.size), 0) AS size FROM quarantine_mail m WHERE EXISTS (SELECT 1 FROM quarantine_rcpt r WHERE r.mail_id = m.id AND ('
                             + ' OR '.join(['r.rcpt LIKE %s'] * len(domains)) + '))', ['%@' + domain for domain in sorted(domains)])
        size = int(found[0]['size'])
    return {'domains': len(domains), 'users': users, 'quarantine_mb': round(size / 1048576, 1)}


def _tenant_mails(domains, since, until):
    """Mails to the domains of a tenant in a time range, from the mail log."""
    if not domains:
        return 0
    pattern = '@(' + '|'.join(re.escape(domain) for domain in sorted(domains)) + ')([ ,;>]|$)'
    db = _maillog_db()
    try:
        with db.cursor() as cur:
            cur.execute('SELECT COUNT(*) AS n FROM maillog WHERE ts >= %s AND ts < %s AND rcpt REGEXP %s', (since, until, pattern))
            return int(cur.fetchone()['n'])
    finally:
        db.close()


def limit_level(used, limit):
    """0 below 80 %, 1 from 80 %, 2 at the limit. No limit set: 0."""
    if not limit:
        return 0
    return 2 if used >= limit else 1 if used >= 0.8 * limit else 0


def _tenant_limit(tenant_id, kind, adding=1):
    """Refuses a new domain or user once the tenant is at its limit. Mail is never refused for this."""
    rows = _admin_query(f'SELECT limit_{kind} AS n FROM tenants WHERE id = %s', (tenant_id,))
    if rows and rows[0]['n'] is not None and _tenant_counts(tenant_id, _tenant_domains())[kind] + adding > rows[0]['n']:
        raise EfaError(f'This tenant is at its limit of {rows[0]["n"]} {kind}.')


def tenant_limits_set(args):
    """Limits of a tenant: domains, users, mails per day, quarantine in MB. none takes one away. From 80 % the admin gets a mail."""
    tenant_id = _tenant_id(args.tenant.strip())
    for kind in LIMITS:
        value = (getattr(args, kind) or '').strip()
        if not value:
            continue
        if value != 'none' and (not value.isdigit() or not 0 < int(value) <= 100000000):
            raise EfaError(f'{kind}: a positive number, or none.')
        _admin_query(f'UPDATE tenants SET limit_{kind} = %s WHERE id = %s', (None if value == 'none' else int(value), tenant_id))
    _tenant_limits_job(datetime.date.today())
    return tenant_usage(argparse.Namespace(tenant=args.tenant, month='', format=''))


def tenant_usage(args):
    """What a tenant uses: domains, users, quarantine now, mails per month. JSON, or CSV for a month."""
    tenant_id = _own_tenant(args)
    tenant_domains = _tenant_domains()
    month = (args.month or '').strip() or datetime.date.today().strftime('%Y-%m')
    if not re.fullmatch(r'\d{4}-(0[1-9]|1[0-2])', month):
        raise EfaError('Month like 2026-11.')
    start = datetime.date(int(month[:4]), int(month[5:]), 1)
    end = _add_months(start, 1)
    limits = _admin_query('SELECT name, limit_domains, limit_users, limit_mails_day, limit_quarantine_mb FROM tenants WHERE id = %s', (tenant_id,))[0]
    today = datetime.date.today()
    usage = {'tenant': limits['name'], 'month': month, **_tenant_counts(tenant_id, tenant_domains),
             'mails_month': _tenant_mails(tenant_domains.get(tenant_id, ()), start, end),
             'mails_today': _tenant_mails(tenant_domains.get(tenant_id, ()), today, today + datetime.timedelta(days=1)),
             'limits': {kind: limits[f'limit_{kind}'] for kind in LIMITS}}
    if (args.format or '').strip() == 'csv':
        keys = ('tenant', 'month', 'domains', 'users', 'quarantine_mb', 'mails_month', 'mails_today')
        return {'csv': csv_safe_text([keys, [usage[key] for key in keys]]), 'rows': 1}
    if (args.format or '').strip() == 'json':
        return {'json': json.dumps(usage, indent=1, default=str), 'rows': 1}
    return usage


def csv_safe_text(rows):
    """CSV where no cell can start a formula in a spreadsheet."""
    out = io.StringIO()
    writer = csv.writer(out)
    for row in rows:
        writer.writerow(["'" + str(cell) if str(cell)[:1] in ('=', '+', '-', '@', '\t', '\r') else cell for cell in row])
    return out.getvalue()


def _tenant_limits_job(today):
    """Hourly: limits at 80 % and 100 % send one mail a day to the admin; a full quarantine stops new quarantine for the tenant."""
    tenants = _admin_query('SELECT id, name, limit_domains, limit_users, limit_mails_day, limit_quarantine_mb FROM tenants WHERE '
                           'limit_domains IS NOT NULL OR limit_users IS NOT NULL OR limit_mails_day IS NOT NULL OR limit_quarantine_mb IS NOT NULL')
    tenant_domains, full = _tenant_domains(), []
    for tenant in tenants:
        counts = _tenant_counts(tenant['id'], tenant_domains)
        counts['mails_day'] = _tenant_mails(tenant_domains.get(tenant['id'], ()), today, today + datetime.timedelta(days=1))
        for kind in LIMITS:
            level = limit_level(counts[kind], tenant[f'limit_{kind}'])
            if kind == 'quarantine_mb' and level == 2:
                full += tenant_domains.get(tenant['id'], [])
            if not level:
                continue
            known = _admin_query('SELECT level FROM tenant_alerts WHERE tenant_id = %s AND kind = %s AND day = %s', (tenant['id'], kind, today))
            if known and known[0]['level'] >= level:
                continue
            _admin_query('REPLACE INTO tenant_alerts (tenant_id, kind, day, level) VALUES (%s, %s, %s, %s)', (tenant['id'], kind, today, level))
            text = f"Tenant {tenant['name']}: {kind} at {counts[kind]} of {tenant[f'limit_{kind}']}."
            _event('tenant_limit', 'warning' if level == 1 else 'error', tenant=tenant['name'], limit=kind, used=counts[kind])
            _admin_notify(f"eFa: tenant {tenant['name']} {'near' if level == 1 else 'at'} its limit", text + (
                ' Mail still flows; ' + ('new mail is not quarantined for it.' if kind == 'quarantine_mb' else 'nothing new of this kind can be added.')
                if level == 2 else ''))
    if sorted(full) != sorted(_json_read(QUARANTINE_FULL, {}).get('domains', [])):
        if full:
            _json_write(QUARANTINE_FULL, {'domains': sorted(full)})
            os.chmod(QUARANTINE_FULL, 0o640)
            shutil.chown(QUARANTINE_FULL, 'root', 'efa-web')
        elif os.path.exists(QUARANTINE_FULL):
            os.remove(QUARANTINE_FULL)


def _tenant_add_domain(tenant_id, domain):
    taken = _admin_query('SELECT tenant_id FROM tenant_domains WHERE domain = %s', (domain,))
    if taken and taken[0]['tenant_id'] != tenant_id:
        raise EfaError('This domain belongs to another tenant.')
    if not taken:
        _tenant_limit(tenant_id, 'domains')
    _admin_query('INSERT IGNORE INTO tenant_domains (domain, tenant_id) VALUES (%s, %s)', (domain, tenant_id))
    _admin_query('DELETE FROM domain_pending WHERE domain = %s', (domain,))
    if _layer_rows():
        _layers_apply()


def domain_onboard(args):
    """A tenant admin adds a domain: it counts only after a TXT record shows the tenant owns it. A super admin adds it at once."""
    tenant_id, domain = _own_tenant(args), args.domain.strip().lower()
    if not DOMAIN_RE.match(domain):
        raise EfaError('Invalid domain.')
    if _admin_query('SELECT 1 FROM tenant_domains WHERE domain = %s', (domain,)) or \
            _admin_query('SELECT 1 FROM domain_pending WHERE domain = %s AND tenant_id <> %s', (domain, tenant_id)):
        raise EfaError('This domain is taken.')
    if identity_now is None or identity_now['grants'].get('tenants.manage', False) is None:
        _tenant_add_domain(tenant_id, domain)
        return {'domain': domain, 'state': 'active'}
    _tenant_limit(tenant_id, 'domains')
    known = _admin_query('SELECT token FROM domain_pending WHERE domain = %s', (domain,))
    token = known[0]['token'] if known else secrets.token_hex(16)
    if not known:
        _admin_query('INSERT INTO domain_pending (domain, tenant_id, token, created_by) VALUES (%s, %s, %s, %s)', (domain, tenant_id, token, _dmarc_who()[:120]))
    return {'domain': domain, 'state': 'waiting for DNS', 'record': f'_efa-verify.{domain}. TXT "efa-verify={token}"'}


def dns_txt(name):
    done = subprocess.run(['dig', '+short', '+time=5', '+tries=2', 'TXT', name], capture_output=True, text=True, timeout=30)
    return [''.join(re.findall(r'"([^"]*)"', line)) for line in done.stdout.splitlines() if line.strip()]


def domain_verify(args):
    """Looks up the TXT record of a waiting domain and turns it on when it is right."""
    domain = args.domain.strip().lower()
    rows = _admin_query('SELECT tenant_id, token FROM domain_pending WHERE domain = %s', (domain,))
    if not rows or (identity_now and identity_now['tenant_ids'] is not None and rows[0]['tenant_id'] not in identity_now['tenant_ids']):
        raise EfaError('No such waiting domain.')
    if f"efa-verify={rows[0]['token']}" not in dns_txt(f'_efa-verify.{domain}'):
        raise EfaError(f'The TXT record of _efa-verify.{domain} is not there yet, or is different.')
    _tenant_add_domain(rows[0]['tenant_id'], domain)
    return {'domain': domain, 'state': 'active'}


def domain_pending_list(_args):
    """Domains that wait for their DNS check."""
    rows = _admin_query('SELECT p.domain, p.tenant_id, t.name AS tenant, p.token, CAST(p.created AS CHAR) AS created FROM domain_pending p '
                        'JOIN tenants t ON t.id = p.tenant_id ORDER BY p.domain')
    if identity_now and identity_now['tenant_ids'] is not None:
        rows = [row for row in rows if row['tenant_id'] in identity_now['tenant_ids']]
    return {'pending': [{'domain': row['domain'], 'tenant': row['tenant'], 'created': row['created'],
                         'record': f"_efa-verify.{row['domain']}. TXT \"efa-verify={row['token']}\""} for row in rows]}


def tenant_hold_lines(rows):
    """Postfix transport lines that keep mail of locked tenants in the queue."""
    return [f"{row['domain']} retry:4.3.2 tenant locked" for row in rows]


def _tenant_users(tenant_id):
    """(users only in this tenant, users also elsewhere)."""
    tenant_domains, groups = _tenant_domains(), _groups()
    only, mixed = [], []
    for row in _admin_query('SELECT DISTINCT username FROM user_groups'):
        found, beyond = user_tenants(_memberships(row['username'], groups), tenant_domains)
        if tenant_id in found:
            (only if found == {tenant_id} and not beyond else mixed).append(row['username'])
    return only, mixed


def tenant_lock(args):
    """Lock a tenant: its users cannot log in and are logged out. Mail flows on, or waits in the queue with --mail defer."""
    tenant_id, enabled = _tenant_id(args.tenant.strip()), _on_off(args.mode)
    mail = (args.mail or '').strip() or 'flow'
    if mail not in ('flow', 'defer'):
        raise EfaError("Mail: flow or defer.")
    _admin_query('UPDATE tenants SET locked = %s, lock_mail = %s WHERE id = %s', (int(enabled), mail, tenant_id))
    if enabled:
        for username in _tenant_users(tenant_id)[0]:
            _admin_query('UPDATE web_sessions SET ended = NOW(), ended_by = %s WHERE username = %s AND ended IS NULL', (_dmarc_who()[:120], username))
    _rules_apply()
    return {'tenant': args.tenant.strip(), 'locked': enabled, 'mail': mail if enabled else 'flow'}


def tenant_delete(args):
    """Delete a tenant with all its data: users only in it, its groups, settings, keys, quarantine and mail log. Type its name again."""
    _confirm(args)
    name = args.tenant.strip()
    if (args.name_again or '').strip() != name:
        raise EfaError('Type the name of the tenant again, exactly.')
    tenant_id = _tenant_id(name)
    domains = [row['domain'] for row in _admin_query('SELECT domain FROM tenant_domains WHERE tenant_id = %s', (tenant_id,))]
    done = {'users': 0, 'groups': 0, 'quarantine': 0, 'maillog': 0, 'dkim_keys': 0}
    only, mixed = _tenant_users(tenant_id)
    for username in only:
        for table in ('api_tokens', 'user_groups', 'users'):
            _admin_query(f'DELETE FROM {table} WHERE username = %s', (username,))
        _admin_query('UPDATE web_sessions SET ended = NOW(), ended_by = %s WHERE username = %s AND ended IS NULL', (_dmarc_who()[:120], username))
        done['users'] += 1
    _admin_query('DELETE FROM user_groups WHERE tenant_id = %s' + (' OR domain IN (' + ','.join(['%s'] * len(domains)) + ')' if domains else ''), (tenant_id, *domains))
    for group in _groups().values():
        if group['builtin'] or group['scope'] not in ('tenants', 'domains'):
            continue
        tenants_left, domains_left = group['scope_tenants'] - {tenant_id}, group['scope_domains'] - set(domains)
        if (tenants_left, domains_left) == (group['scope_tenants'], group['scope_domains']):
            continue
        if not tenants_left and not domains_left:
            for table in ('user_groups', 'group_roles'):
                _admin_query(f'DELETE FROM {table} WHERE group_id = %s', (group['id'],))
            _admin_query('DELETE FROM efa_groups WHERE id = %s', (group['id'],))
            done['groups'] += 1
        else:
            _admin_query('UPDATE efa_groups SET scope_tenants = %s, scope_domains = %s WHERE id = %s',
                         (','.join(str(item) for item in sorted(tenants_left)), ','.join(sorted(domains_left)), group['id']))
    _admin_query('DELETE FROM group_roles WHERE idp_tenant = %s OR tenant_id = %s' + (' OR domain IN (' + ','.join(['%s'] * len(domains)) + ')' if domains else ''),
                 (tenant_id, tenant_id, *domains))
    _admin_query("DELETE FROM scoped_settings WHERE (level = 'tenant' AND target = %s)" + (" OR (level = 'domain' AND target IN (" + ','.join(['%s'] * len(domains)) + '))'
                                                                                         if domains else ''), (str(tenant_id), *domains))
    for domain in domains:
        _admin_query('DELETE r FROM quarantine_rcpt r WHERE r.rcpt LIKE %s', ('%@' + domain.replace('_', '\\_'),))
        for key in [key for key in _dkim_keys() if key['domain'] == domain and key['purpose'] == 'dkim']:
            dkim_remove(argparse.Namespace(domain=domain, selector=key['selector'], confirm='yes'))
            done['dkim_keys'] += 1
    for row in _admin_query('SELECT m.id FROM quarantine_mail m WHERE NOT EXISTS (SELECT 1 FROM quarantine_rcpt r WHERE r.mail_id = m.id)'):
        if os.path.exists(_uq_path(row['id'])):
            os.remove(_uq_path(row['id']))
        _admin_query('DELETE FROM quarantine_mail WHERE id = %s', (row['id'],))
        done['quarantine'] += 1
    if domains:
        pattern = '@(' + '|'.join(re.escape(domain) for domain in sorted(domains)) + ')([ ,;>]|$)'
        db = _maillog_db()
        try:
            with db.cursor() as cur:
                done['maillog'] = cur.execute('DELETE FROM maillog WHERE rcpt REGEXP %s', (pattern,))
            db.commit()
        finally:
            db.close()
        kept = [line for line in _read_lines(TRANSPORT) if line.split()[:1] and line.split()[0] not in domains]
        if kept != _read_lines(TRANSPORT):
            _write(TRANSPORT, ''.join(line + '\n' for line in kept))
            subprocess.run(['postmap', TRANSPORT], check=False, capture_output=True)
        rules = [entry for entry in _read_lines(SENDER_RULES) if entry.split('|')[-1].rsplit('@', 1)[-1] not in domains]
        if rules != _read_lines(SENDER_RULES):
            _write(SENDER_RULES, ''.join(entry + '\n' for entry in rules))
    _json_write(RULES_FILE, {'rules': [rule for rule in _rules() if not (rule['kind'] == 'tenant' and rule['value'] == name)
                                       and not (rule['kind'] == 'domain' and rule['value'].lstrip('@') in domains)]})
    for path in (f'{BRAND_DIR}/{tenant_id}.png', _idp_file('ldap', tenant_id), _idp_file('oidc', tenant_id)):
        if os.path.exists(path):
            os.remove(path)
    for table, column in (('domain_pending', 'tenant_id'), ('tenant_alerts', 'tenant_id'), ('tenant_domains', 'tenant_id'), ('tenants', 'id')):
        _admin_query(f'DELETE FROM {table} WHERE {column} = %s', (tenant_id,))
    _admin_query('UPDATE api_tokens SET expires = NOW() WHERE tenant_id = %s', (tenant_id,))
    _layers_apply()
    _tenant_limits_job(datetime.date.today())
    return {'deleted': name, 'domains': domains, 'users_kept_elsewhere': mixed, **done}


def user_verify(args):
    """Checks a login of the web interface."""
    username, password = args.username.strip(), _secrets(1, 'Password')[0]
    rows = _admin_query('SELECT password, disabled FROM users WHERE username = %s AND source = %s', (username, 'local'))
    tenant = _tenant_of_domain(username.rsplit('@', 1)[1]) if not rows and '@' in username and DOMAIN_RE.match(username.rsplit('@', 1)[1].lower()) else None
    own = _json_read(_idp_file('ldap', tenant), {}) if tenant is not None else {}
    if not rows and own.get('ldap'):
        return _external_login(username.lower(), _ldap_groups(username, password, own), f'ldap:{tenant}', tenant)
    if not rows and _json_read(LDAP_FILE, {}).get('ldap'):
        return _external_login(username, _ldap_groups(username, password), 'ldap')
    # The same work for an unknown name, so the time does not tell which names exist.
    stored = rows[0]['password'] if rows and rows[0]['password'] else web_password_hash('')
    if not web_password_ok(stored, password) or not rows or not rows[0]['password']:
        raise EfaError('Wrong user name or password.')
    if rows[0]['disabled']:
        raise EfaError('This user is disabled.')
    _admin_query('UPDATE users SET last_login = NOW() WHERE username = %s', (username,))
    return {key: value for key, value in _load_identity(username).items() if key in ('username', 'role')}


def mapped_memberships(directory_groups, mapping, groups):
    """The eFa groups of a directory login: one per mapped directory group. No mapped group means no login."""
    names = {group.lower() for group in directory_groups}
    return [{'group_id': row['group_id'], 'group': groups[row['group_id']], 'tenant_id': row['tenant_id'], 'domain': row['domain']}
            for row in mapping if row['group_name'] in names and row['group_id'] in groups]


def tenant_admin_grants(tenant_id, tenant_domains):
    """The most a tenant can hand out: what its tenant admin holds."""
    return grants_of([{'group': {**BUILTIN_GROUPS['tenant'], 'scope': 'member'}, 'tenant_id': tenant_id, 'domain': None}], tenant_domains)


def _external_login(username, directory_groups, source, tenant=None):
    """An OIDC or LDAP login: its groups decide the eFa groups on each login, so a change in the directory takes effect.
    The directory of a tenant only maps its own groups, and never beyond the tenant."""
    if not USER_RE.match(username):
        raise EfaError('Wrong user name or password.')
    memberships = mapped_memberships(directory_groups, _admin_query('SELECT group_name, group_id, tenant_id, domain FROM group_roles WHERE idp_tenant = %s',
                                                                     (tenant or 0,)), _groups())
    if tenant is not None:
        tenant_domains = _tenant_domains()
        most = tenant_admin_grants(tenant, tenant_domains)
        memberships = [member for member in memberships if grants_cover(most, grants_of([member], tenant_domains))]
    if not memberships:
        raise EfaError('Your login is valid, but none of your groups has a group here.')
    current = _admin_query('SELECT source, disabled FROM users WHERE username = %s', (username,))
    if current and current[0]['source'] != source:
        raise EfaError('This user name belongs to another kind of login.')
    if current and current[0]['disabled']:
        raise EfaError('This user is disabled.')
    first = next((member['group']['builtin'] for member in memberships if member['group'].get('builtin')), 'custom')
    _admin_query('INSERT INTO users (username, role, source, last_login, groups_migrated) VALUES (%s, %s, %s, NOW(), 1) '
                 'ON DUPLICATE KEY UPDATE role = VALUES(role), last_login = NOW()', (username, first, source))
    _set_memberships(username, memberships)
    return {'username': username, 'role': _load_identity(username)['role']}


def group_list(_args):
    """The predefined and the own groups, their permissions, scope and members."""
    names = {row['id']: row['name'] for row in _admin_query('SELECT id, name FROM tenants')}
    counts = {row['group_id']: row['n'] for row in _admin_query('SELECT group_id, COUNT(*) AS n FROM user_groups GROUP BY group_id')}
    found = []
    for group in sorted(_groups().values(), key=lambda item: (item['builtin'] is None, item['name'])):
        scope = 'per member: tenant or domain' if group['scope'] == 'member' else group['scope']
        if group['scope'] in ('tenants', 'domains'):
            scope += ': ' + ', '.join(sorted([names.get(item, str(item)) for item in group['scope_tenants']] + sorted(group['scope_domains'])))
        found.append({'name': group['name'], 'description': group['description'], 'predefined': group['builtin'] is not None, 'disabled': bool(group['disabled']),
                      'permissions': sorted(group['permissions'] | group['global_extra']), 'scope': scope, 'members': counts.get(group['id'], 0)})
    return {'groups': found}


def group_spec(args, base, tenant_ids, tenant_domains):
    """The new state of an own group from the arguments, on top of base. Checks names, permissions and scope."""
    spec = {'permissions': set(base['permissions']), 'scope': base['scope'] if base['scope'] != 'member' else 'global',
            'scope_tenants': set(base['scope_tenants']), 'scope_domains': set(base['scope_domains']), 'description': base['description'], 'disabled': 0}
    if (args.description or '').strip():
        spec['description'] = args.description.strip()[:255]
    if (args.permissions or '').strip():
        spec['permissions'] = set(re.split(r'[\s,]+', args.permissions.strip()))
    unknown = spec['permissions'] - set(PERMISSIONS)
    if unknown:
        raise EfaError('Unknown permissions: ' + ', '.join(sorted(unknown)))
    if (args.scope or '').strip():
        spec['scope'] = args.scope.strip()
        values = [item.strip() for item in (args.scope_values or '').split(',') if item.strip()]
        spec['scope_tenants'], spec['scope_domains'] = set(), set()
        if spec['scope'] == 'tenants':
            for value in values:
                if value not in tenant_ids:
                    raise EfaError(f'Unknown tenant: {value}')
                spec['scope_tenants'].add(tenant_ids[value])
        elif spec['scope'] == 'domains':
            for value in values:
                if not DOMAIN_RE.match(value.lower()):
                    raise EfaError(f'Invalid domain: {value}')
                spec['scope_domains'].add(value.lower())
    if spec['scope'] not in GROUP_SCOPES:
        raise EfaError('Scope: global, tenants or domains.')
    if spec['scope'] != 'global' and not (spec['scope_tenants'] or spec['scope_domains']):
        raise EfaError('Name the tenants or domains of the scope.')
    held = spec['permissions'] & GLOBAL_PERMISSIONS
    if spec['scope'] != 'global' and held:
        raise EfaError('Only a global group can hold: ' + ', '.join(sorted(held)))
    return spec


def _group_grants(group, tenant_domains):
    return grants_of([{'group': group, 'tenant_id': None, 'domain': None}], tenant_domains)


def _check_own_access(group_id, new_group, tenant_domains):
    """Self-lockout: whoever changes a group of their own keeps the right to manage users and groups."""
    if identity_now is None:
        return
    after = [{**member, 'group': new_group} if member['group']['id'] == group_id else member for member in identity_now['memberships']]
    after = [member for member in after if member['group'] is not None]
    kept = grants_of(after, tenant_domains)
    for permission in ('users.manage', 'groups.manage'):
        if permission in identity_now['grants'] and permission not in kept:
            raise EfaError(f'Refused: you would lose {permission} yourself.')


def group_set(args):
    """Add or change an own group. --copy_from takes permissions and scope of another group, a predefined one too."""
    name = args.name.strip()
    if not TENANT_RE.match(name):
        raise EfaError('Group name: letters, digits, space . _ -, up to 100.')
    groups, tenant_domains = _groups(), _tenant_domains()
    tenant_ids = {row['name']: row['id'] for row in _admin_query('SELECT id, name FROM tenants')}
    existing = next((group for group in groups.values() if group['name'].lower() == name.lower()), None)
    if existing and existing['builtin']:
        raise EfaError('Predefined groups cannot be changed. Copy one with --copy_from and change the copy.')
    if (args.copy_from or '').strip():
        base = _group_by_name(args.copy_from, groups)
        if base['scope'] == 'member' and (args.scope or 'global').strip() == 'global':
            # A global copy of the helpdesk reads the whole system, as its members without tenant do.
            base = {**base, 'permissions': base['permissions'] | base['global_extra']}
    else:
        base = existing or {'permissions': set(), 'scope': 'global', 'scope_tenants': set(), 'scope_domains': set(), 'description': ''}
    spec = group_spec(args, base, tenant_ids, tenant_domains)
    have = _actor_grants()
    if not grants_cover(have, _group_grants(spec, tenant_domains)) or (existing and not grants_cover(have, _group_grants(existing, tenant_domains))):
        raise EfaError('Not allowed: this needs permissions or a scope you do not have.')
    if existing:
        _check_own_access(existing['id'], {**existing, **spec}, tenant_domains)
    values = (spec['description'], ' '.join(sorted(spec['permissions'])), spec['scope'], ','.join(str(item) for item in sorted(spec['scope_tenants'])),
              ','.join(sorted(spec['scope_domains'])))
    if existing:
        _admin_query('UPDATE efa_groups SET description = %s, permissions = %s, scope = %s, scope_tenants = %s, scope_domains = %s WHERE id = %s',
                     (*values, existing['id']))
    else:
        _admin_query('INSERT INTO efa_groups (name, description, permissions, scope, scope_tenants, scope_domains) VALUES (%s, %s, %s, %s, %s, %s)',
                     (name, *values))
    return group_list(None)


def _own_group(args):
    group = _group_by_name(args.name, _groups())
    if group['builtin']:
        raise EfaError('Predefined groups cannot be changed or removed.')
    if not grants_cover(_actor_grants(), _group_grants(group, _tenant_domains())):
        raise EfaError('Not allowed: this needs permissions or a scope you do not have.')
    return group


def group_state(args):
    """Disable an own group, or enable it again. Its members lose its permissions while it is off."""
    group, enabled = _own_group(args), _on_off(args.mode)
    if not enabled:
        _check_own_access(group['id'], {**group, 'disabled': 1}, _tenant_domains())
    _admin_query('UPDATE efa_groups SET disabled = %s WHERE id = %s', (int(not enabled), group['id']))
    return group_list(None)


def group_remove(args):
    """Remove an own group. Its members and directory mappings lose it."""
    _confirm(args)
    group = _own_group(args)
    _check_own_access(group['id'], None, _tenant_domains())
    _admin_query('DELETE FROM user_groups WHERE group_id = %s', (group['id'],))
    _admin_query('DELETE FROM group_roles WHERE group_id = %s', (group['id'],))
    _admin_query('DELETE FROM efa_groups WHERE id = %s', (group['id'],))
    return group_list(None)


def group_map_list(_args, idp_tenant=0):
    """Which group of the directory gets which eFa group."""
    return {'groups': _admin_query('SELECT r.group_name, g.name AS efa_group, t.name AS tenant, r.domain FROM group_roles r '
                                   'LEFT JOIN efa_groups g ON g.id = r.group_id LEFT JOIN tenants t ON t.id = r.tenant_id WHERE r.idp_tenant = %s '
                                   'ORDER BY r.group_name', (idp_tenant,))}


def group_map_set(args, idp_tenant=0):
    """Give a group from OIDC or LDAP an eFa group, or remove it. For LDAP the full DN or the CN."""
    directory_group, action = args.group.strip().lower(), args.action.strip()
    if not directory_group or len(directory_group) > 255:
        raise EfaError('Group: 1 to 255 characters.')
    if action == 'remove':
        _admin_query('DELETE FROM group_roles WHERE group_name = %s AND idp_tenant = %s', (directory_group, idp_tenant))
        return group_map_list(None, idp_tenant)
    if action != 'set':
        raise EfaError("Action must be 'set' or 'remove'.")
    name = (args.efa_group or '').strip()
    role = (args.role or '').strip()
    if not name and role:
        if role not in ROLES:
            raise EfaError('Role must be one of: ' + ', '.join(ROLES))
        name = BUILTIN_GROUPS[role]['name']
    domain = (args.domain or '').strip().lower()
    tenant = _tenant_id(args.tenant.strip()) if (args.tenant or '').strip() else None
    if domain and not DOMAIN_RE.match(domain):
        raise EfaError('Invalid domain.')
    groups, tenant_domains = _groups(), _tenant_domains()
    if idp_tenant:
        # The tenant argument names the directory here; a domain narrows the group to that domain of the tenant.
        tenant = None if domain else idp_tenant
        if domain and domain not in tenant_domains.get(idp_tenant, ()):
            raise EfaError('This domain does not belong to the tenant.')
    elif domain and tenant is not None and domain not in tenant_domains.get(tenant, ()):
        raise EfaError('This domain does not belong to the tenant.')
    member = wanted_memberships([name], tenant, domain, groups)[0] if name else None
    if member is None:
        raise EfaError('Name the eFa group.')
    if not grants_cover(_actor_grants(), grants_of([member], tenant_domains)):
        raise EfaError('Not allowed: this needs permissions or a scope you do not have.')
    if idp_tenant and not grants_cover(tenant_admin_grants(idp_tenant, tenant_domains), grants_of([member], tenant_domains)):
        raise EfaError('The directory of a tenant can only give groups inside the tenant.')
    _admin_query('REPLACE INTO group_roles (group_name, role, group_id, tenant_id, domain, idp_tenant) VALUES (%s, %s, %s, %s, %s, %s)',
                 (directory_group, member['group'].get('builtin') or 'custom', member['group_id'], member['tenant_id'], member['domain'], idp_tenant))
    return group_map_list(None, idp_tenant)


def ldap_filter_escape(text):
    """RFC 4515: a user name must not change the search."""
    return ''.join(f'\\{ord(ch):02x}' if ch in '*()\\\0' else ch for ch in text)


def ldif_entries(text):
    """(dn, values of memberOf) of each entry in the output of ldapsearch -LLL. Long lines are folded, values can be base64."""
    entries = []
    for block in re.sub(r'\r?\n ', '', text).split('\n\n'):
        dn, groups = None, []
        for line in block.splitlines():
            name, separator, value = line.partition(':')
            if not separator:
                continue
            if value.startswith(':'):
                value = base64.b64decode(value[1:].strip()).decode('utf-8', 'replace')
            value = value.strip()
            if name.lower() == 'dn':
                dn = value
            elif name.lower() == 'memberof':
                groups.append(value)
        if dn:
            entries.append((dn, groups))
    return entries


def ldap_group_names(member_of):
    """A group can be mapped by its full DN or its CN."""
    names = []
    for dn in member_of:
        names.append(dn)
        match = re.match(r'(?i)cn=((?:[^,\\]|\\.)+)', dn)
        if match:
            names.append(match.group(1))
    return names


def ldap_command(tool, state, dn, password_file):
    # ldap:// only with STARTTLS (-ZZ): passwords must not cross the network in clear text.
    return [tool, '-x', '-H', state['uri'], *(['-ZZ'] if state['uri'].lower().startswith('ldap://') else []), '-D', dn, '-y', password_file]


def _idp_file(kind, tenant_id):
    """The login directory of a tenant, or the global one for None."""
    if tenant_id is None:
        return LDAP_FILE if kind == 'ldap' else OIDC_FILE
    return f'{IDP_DIR}/{kind}-{int(tenant_id)}.json'


def _tenant_of_domain(domain):
    rows = _admin_query('SELECT tenant_id FROM tenant_domains WHERE domain = %s', (domain.lower(),))
    return rows[0]['tenant_id'] if rows else None


def _ldap_groups(username, password, state=None):
    """Finds the user with the service account, then binds as the user. An empty password would be an anonymous bind, which proves nothing."""
    state = state if state is not None else _json_read(LDAP_FILE, {})
    if not password or not USER_RE.match(username):
        raise EfaError('Wrong user name or password.')
    search = state['user_filter'].replace('{user}', ldap_filter_escape(username))
    with tempfile.NamedTemporaryFile('w', dir='/run', prefix='efa-ldap-') as service, tempfile.NamedTemporaryFile('w', dir='/run', prefix='efa-ldap-') as user:
        # -y takes the whole file as the password: no line end.
        service.write(state['bind_password'])
        service.flush()
        user.write(password)
        user.flush()
        found = subprocess.run(ldap_command('ldapsearch', state, state['bind_dn'], service.name) + ['-LLL', '-o', 'ldif-wrap=no', '-b', state['base'], search, 'dn', 'memberOf'],
                               capture_output=True, text=True, timeout=20)
        entries = ldif_entries(found.stdout) if found.returncode == 0 else []
        if found.returncode != 0:
            print(f'ldapsearch: {found.stderr.strip()[-200:]}', file=sys.stderr)
        if len(entries) != 1:
            raise EfaError('Wrong user name or password.')
        dn, groups = entries[0]
        if subprocess.run(ldap_command('ldapwhoami', state, dn, user.name), capture_output=True, timeout=20).returncode != 0:
            raise EfaError('Wrong user name or password.')
    return ldap_group_names(groups)


def ldap_status(_args, path=None):
    """Login with a directory: LDAP or Active Directory. Off by default."""
    state = _json_read(path or LDAP_FILE, {'ldap': False})
    return {key: value for key, value in state.items() if key != 'bind_password'}


def ldap_set(args, path=None):
    """Turn LDAP login on or off. Roles come from the group table. Uses ldaps, or ldap with STARTTLS."""
    path = path or LDAP_FILE
    if not _on_off(args.mode):
        _json_write(path, {'ldap': False})
        return {'ldap': False}
    uri, bind_dn, base = args.uri.strip(), args.bind_dn.strip(), args.base.strip()
    user_filter = args.user_filter.strip() or LDAP_DEFAULT_FILTER
    if not re.fullmatch(r'ldaps?://[A-Za-z0-9.:\[\]-]+(:\d+)?/?', uri, re.I):
        raise EfaError('URI like ldaps://dc1.example.org')
    if not bind_dn or not base or any(ch in bind_dn + base for ch in '\r\n\0'):
        raise EfaError('Service account DN and search base are needed.')
    if '{user}' not in user_filter or not user_filter.startswith('(') or user_filter.count('(') != user_filter.count(')'):
        raise EfaError('Filter: in brackets, with {user} for the name.')
    password = _secrets(1, 'Password of the service account')[0] or _json_read(path, {}).get('bind_password', '')
    if not password:
        raise EfaError('The service account needs a password.')
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    _json_write(path, {'ldap': True, 'uri': uri, 'bind_dn': bind_dn, 'base': base, 'user_filter': user_filter, 'bind_password': password}, mode=0o600)
    return ldap_status(None, path)


def b64url(text):
    return base64.urlsafe_b64decode(text + '=' * (-len(text) % 4))


def rs256_ok(message, signature, modulus, exponent):
    """RSASSA-PKCS1-v1_5 with SHA-256, the signature OIDC requires of a provider. Keys below 2048 bits count as bad."""
    size = (modulus.bit_length() + 7) // 8
    if size < 256 or len(signature) != size or int.from_bytes(signature, 'big') >= modulus:
        return False
    tail = SHA256_PREFIX + hashlib.sha256(message).digest()
    expected = b'\x00\x01' + b'\xff' * (size - 3 - len(tail)) + b'\x00' + tail
    return secrets.compare_digest(pow(int.from_bytes(signature, 'big'), exponent, modulus).to_bytes(size, 'big'), expected)


def verify_id_token(token, keys, issuer, audience, nonce, now):
    """Checks an OIDC ID token and returns its claims. Only RS256: a token cannot choose a weaker way to be checked."""
    try:
        head, body, signature = token.split('.')
        header, claims = json.loads(b64url(head)), json.loads(b64url(body))
        raw_signature = b64url(signature)
    except ValueError:
        raise EfaError('OIDC: the ID token is damaged.')
    if header.get('alg') != 'RS256':
        raise EfaError('OIDC: only RS256 is accepted.')
    candidates = [key for key in keys if key.get('kty') == 'RSA' and (not header.get('kid') or key.get('kid') == header['kid'])]
    message = f'{head}.{body}'.encode()
    if not any(rs256_ok(message, raw_signature, int.from_bytes(b64url(key['n']), 'big'), int.from_bytes(b64url(key['e']), 'big')) for key in candidates):
        raise EfaError('OIDC: the signature of the ID token is wrong.')
    audiences = claims.get('aud') if isinstance(claims.get('aud'), list) else [claims.get('aud')]
    if claims.get('iss') != issuer or audience not in audiences:
        raise EfaError('OIDC: the ID token is for someone else.')
    if not isinstance(claims.get('exp'), (int, float)) or claims['exp'] < now - 60:
        raise EfaError('OIDC: the ID token has expired.')
    if not nonce or not secrets.compare_digest(str(claims.get('nonce', '')), nonce):
        raise EfaError('OIDC: the login does not match this browser session.')
    return claims


def _oidc_json(url, data=None):
    if not url.startswith('https://'):
        raise EfaError('OIDC: the provider must use https.')
    request = urllib.request.Request(url, data=urllib.parse.urlencode(data).encode() if data else None, headers={'Accept': 'application/json'})
    try:
        with urllib.request.urlopen(request, timeout=15) as reply:
            return json.load(reply)
    except urllib.error.HTTPError as err:
        raise EfaError(f'OIDC: the provider answered {err.code}.')
    except (OSError, ValueError) as err:
        raise EfaError(f'OIDC: the provider does not answer: {err}')


def _oidc_provider(state):
    found = _oidc_json(state['issuer'].rstrip('/') + '/.well-known/openid-configuration')
    if found.get('issuer', '').rstrip('/') != state['issuer'].rstrip('/'):
        raise EfaError('OIDC: the provider names another issuer.')
    return found


def oidc_status(_args, path=None):
    """Single sign-on for the web interface: Entra ID, Keycloak or another OIDC provider. Off by default."""
    state = _json_read(path or OIDC_FILE, {'oidc': False})
    found = {key: value for key, value in state.items() if key != 'client_secret'}
    if path is None:
        # The login page asks for the mail domain when a tenant has its own.
        found['tenant_sso'] = any(_json_read(item, {}).get('oidc') for item in glob.glob(IDP_DIR + '/oidc-*.json'))
    return found


def oidc_set(args, path=None):
    """Turn single sign-on on or off. Roles come from the group table, matched against the groups claim."""
    path = path or OIDC_FILE
    if not _on_off(args.mode):
        _json_write(path, {'oidc': False})
        return {'oidc': False}
    issuer, client_id, redirect = args.issuer.strip(), args.client_id.strip(), args.redirect_uri.strip()
    https_url(issuer)
    https_url(redirect)
    if not issuer or not client_id or not redirect.endswith('/login/oidc/callback'):
        raise EfaError('Issuer, client ID and a redirect address ending in /login/oidc/callback are needed.')
    claim = args.group_claim.strip() or 'groups'
    secret = _secrets(1, 'Client secret')[0] or _json_read(path, {}).get('client_secret', '')
    if not secret:
        raise EfaError('The client secret is needed.')
    state = {'oidc': True, 'issuer': issuer, 'client_id': client_id, 'redirect_uri': redirect, 'group_claim': claim, 'client_secret': secret}
    _oidc_provider(state)
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    _json_write(path, state, mode=0o600)
    return oidc_status(None, path)


def _oidc_tenant(args):
    """The tenant whose single sign-on a login uses, by the mail domain typed on the login page. None: the global one."""
    domain = (getattr(args, 'domain', '') or '').strip().lower().rsplit('@', 1)[-1]
    if domain:
        tenant = _tenant_of_domain(domain) if DOMAIN_RE.match(domain) else None
        if tenant is not None and _json_read(_idp_file('oidc', tenant), {}).get('oidc'):
            return tenant
    tenant = (getattr(args, 'tenant', '') or '').strip()
    return int(tenant) if tenant.isdigit() else None


def oidc_start(args):
    """The address a browser goes to for its login, and what must come back. With PKCE."""
    tenant = _oidc_tenant(args)
    state = _json_read(_idp_file('oidc', tenant), {})
    if not state.get('oidc'):
        raise EfaError('Single sign-on is off.')
    provider = _oidc_provider(state)
    login_state, nonce, verifier = secrets.token_urlsafe(32), secrets.token_urlsafe(32), secrets.token_urlsafe(48)
    challenge = base64.urlsafe_b64encode(hashlib.sha256(verifier.encode()).digest()).rstrip(b'=').decode()
    query = urllib.parse.urlencode({'response_type': 'code', 'client_id': state['client_id'], 'redirect_uri': state['redirect_uri'],
                                    'scope': 'openid profile email', 'state': login_state, 'nonce': nonce,
                                    'code_challenge': challenge, 'code_challenge_method': 'S256'})
    return {'url': f"{provider['authorization_endpoint']}?{query}", 'state': login_state, 'nonce': nonce, 'verifier': verifier,
            'tenant': '' if tenant is None else str(tenant)}


def oidc_finish(args):
    """Trades the code of the browser for an ID token, checks it and logs the user in."""
    tenant = _oidc_tenant(argparse.Namespace(tenant=getattr(args, 'tenant', '') or ''))
    state = _json_read(_idp_file('oidc', tenant), {})
    if not state.get('oidc'):
        raise EfaError('Single sign-on is off.')
    provider = _oidc_provider(state)
    answer = _oidc_json(provider['token_endpoint'], {'grant_type': 'authorization_code', 'code': args.code.strip(), 'redirect_uri': state['redirect_uri'],
                                                     'client_id': state['client_id'], 'client_secret': state['client_secret'], 'code_verifier': args.verifier.strip()})
    if 'id_token' not in answer:
        raise EfaError('OIDC: the provider sent no ID token.')
    keys = _oidc_json(provider['jwks_uri']).get('keys', [])
    claims = verify_id_token(answer['id_token'], keys, provider['issuer'], state['client_id'], args.nonce.strip(), time.time())
    username = claims.get('preferred_username') or claims.get('email') or claims.get('sub') or ''
    groups = claims.get(state['group_claim']) or []
    if tenant is not None:
        # The directory of a tenant speaks only for addresses of that tenant.
        username = (claims.get('email') or username).lower()
        if '@' not in username or _tenant_of_domain(username.rsplit('@', 1)[1]) != tenant:
            raise EfaError('This login does not belong to a domain of the tenant.')
        return _external_login(username, groups if isinstance(groups, list) else [str(groups)], f'oidc:{tenant}', tenant)
    return _external_login(username, groups if isinstance(groups, list) else [str(groups)], 'oidc')


def _api_state():
    return _json_read(API_FILE, {}).get('api', False)


def api_status(_args):
    """REST API on /api/v1/<command>, with a token per user."""
    return {'api': _api_state()}


def api_set(args):
    """Turn the REST API on or off. Off is the default. Tokens stay when it is off."""
    enabled = _on_off(args.mode)
    _json_write(API_FILE, {'api': enabled})
    return {'api': enabled}


def _token_owner(args):
    username = args.username.strip()
    if identity_now is None or 'api_tokens.manage' in identity_now['grants']:
        return username or (identity_now or {}).get('username') or ''
    if username and username != identity_now['username']:
        raise EfaError('Only your own tokens.')
    return identity_now['username']


def token_list(args):
    """API tokens. The token itself is only shown once, when it is made."""
    owner = _token_owner(args)
    where, params = ('WHERE username = %s', (owner,)) if owner else ('', ())
    return {'tokens': _admin_query('SELECT id, username, label, CAST(expires AS CHAR) AS expires, CAST(last_used AS CHAR) AS last_used '
                                   f'FROM api_tokens {where} ORDER BY id', params)}


def token_create(args):
    """Make an API token. It has the rights of its user."""
    owner = _token_owner(args)
    if not owner or not _admin_query('SELECT 1 FROM users WHERE username = %s', (owner,)):
        raise EfaError('Name an existing user. The main admin has no token: make a user with the role super for that.')
    if _load_identity(owner).get('role') == 'user':
        raise EfaError('Users of the portal get no API token: the API belongs to the admin interface.')
    label = args.label.strip() or 'token'
    days = (args.days or '').strip() or str(TOKEN_DAYS_DEFAULT)
    if not days.isdigit() or not 1 <= int(days) <= 3650 or len(label) > 100:
        raise EfaError('Days: 1 to 3650. Label: up to 100 characters.')
    tenant = _tenant_id(args.tenant.strip()) if (getattr(args, 'tenant', '') or '').strip() else None
    if tenant is not None:
        holder = _load_identity(owner)['grants']
        if not any(scope is None or tenant in scope['tenants'] for scope in holder.values()):
            raise EfaError('This user has nothing in that tenant.')
        if identity_now and not any(scope is None or tenant in scope['tenants'] for scope in identity_now['grants'].values()):
            raise EfaError('Not allowed: this tenant is outside your scope.')
    token = 'efa_' + secrets.token_urlsafe(32)
    _admin_query('INSERT INTO api_tokens (token_sha256, username, label, expires, tenant_id) VALUES (%s, %s, %s, NOW() + INTERVAL %s DAY, %s)',
                 (hashlib.sha256(token.encode()).hexdigest(), owner, label, int(days), tenant))
    return {'token': token, 'username': owner, 'label': label, 'days': int(days), 'tenant': args.tenant.strip() if tenant is not None else '',
            'note': 'Shown only now. Store it.'}


def token_revoke(args):
    """Delete an API token."""
    if not args.id.strip().isdigit():
        raise EfaError('Token ID must be a number.')
    owner = _token_owner(args) if identity_now and 'api_tokens.manage' not in identity_now['grants'] else ''
    where, params = ('AND username = %s', (owner,)) if owner else ('', ())
    _admin_query(f'DELETE FROM api_tokens WHERE id = %s {where}', (int(args.id), *params))
    return {'revoked': args.id.strip()}


def token_check(_args):
    """Who an API token belongs to, for the web interface. Fails while the API is off."""
    if not _api_state():
        raise EfaError('The API is off.')
    sha = hashlib.sha256(_secrets(1, 'Token')[0].strip().encode()).hexdigest()
    rows = _admin_query('SELECT username, tenant_id FROM api_tokens WHERE token_sha256 = %s AND expires > NOW()', (sha,))
    if not rows or _load_identity(rows[0]['username']).get('role') == 'user':
        raise EfaError('Invalid token.')
    _admin_query('UPDATE api_tokens SET last_used = NOW() WHERE token_sha256 = %s', (sha,))
    return {'username': rows[0]['username'], 'tenant_id': rows[0]['tenant_id']}


def audit_redact(values):
    """Passwords and keys never reach the audit log."""
    return {key: '***' if re.search(r'pass|secret|token|key', key, re.I) and value else value for key, value in values.items()}


def audit_changes(before, after):
    """Only what changed; a key that is gone, such as a removed user, shows as None."""
    keys = [key for key in {**before, **after} if before.get(key) != after.get(key)]
    return {key: before.get(key) for key in keys}, {key: after.get(key) for key in keys}


def _access_state():
    """Users, groups and directory mappings, one key each, so the audit log shows old and new of each one."""
    state = {}
    names = {row['id']: row['name'] for row in _admin_query('SELECT id, name FROM tenants')}
    groups = _groups()
    for row in _admin_query('SELECT username, email, disabled FROM users'):
        state['user:' + row['username']] = {'groups': sorted(_member_text(member, names) for member in _memberships(row['username'], groups)),
                                            'email': row['email'], 'disabled': bool(row['disabled'])}
    for group in groups.values():
        if not group['builtin']:
            state['group:' + group['name']] = {'permissions': sorted(group['permissions']), 'scope': group['scope'],
                                               'tenants': sorted(names.get(item, str(item)) for item in group['scope_tenants']),
                                               'domains': sorted(group['scope_domains']), 'disabled': bool(group['disabled'])}
    for row in _admin_query('SELECT group_name, group_id, tenant_id, domain FROM group_roles'):
        state['directory group:' + row['group_name']] = {'efa_group': groups.get(row['group_id'], {}).get('name'),
                                                         'tenant': names.get(row['tenant_id']), 'domain': row['domain']}
    return state


def _audit_state():
    try:
        found = settings(None)
    except (EfaError, OSError, subprocess.CalledProcessError, ValueError):
        found = {}
    try:
        found.update(_access_state())
    except Exception:  # no database yet, or pymysql errors without a common base: the settings still count
        pass
    return found


def _audit_write(command, args, before, ok):
    """Who, what, when, old and new. A failing database must not stop the work: the file log has the line already."""
    old, new = audit_changes(before, _audit_state())
    values = audit_redact({key: value for key, value in vars(args).items() if key not in ('func', 'command', 'as_user', 'client', 'limit_tenant')})
    tenant = identity_now['tenant_id'] if identity_now else None
    try:
        _admin_query('INSERT INTO audit (actor, client, tenant_id, command, args, old_value, new_value, ok) VALUES (%s, %s, %s, %s, %s, %s, %s, %s)',
                     (_dmarc_who(), acting_client[:64], tenant, command, json.dumps(values), json.dumps(audit_redact(old), default=str),
                      json.dumps(audit_redact(new), default=str), int(ok)))
    except (EfaError, OSError, ImportError) as err:
        print(f'audit log: {err}', file=sys.stderr)
    except Exception as err:  # pymysql errors have no common base here: the change itself is done
        print(f'audit log: {err}', file=sys.stderr)


def audit_search(args):
    """Search the audit log of changes: who, what, when, old and new."""
    limit = (args.limit or '').strip() or '100'
    if not limit.isdigit() or not 1 <= int(limit) <= 1000:
        raise EfaError('Limit must be 1 to 1000.')
    needle = '%' + args.text.strip().replace('\\', '\\\\').replace('%', '\\%').replace('_', '\\_') + '%'
    where, params = 'WHERE (actor LIKE %s OR command LIKE %s OR args LIKE %s)', [needle, needle, needle]
    if identity_now and identity_now['tenant_ids'] is not None:
        where += ' AND tenant_id IN (' + ','.join(['%s'] * len(identity_now['tenant_ids'])) + ')' if identity_now['tenant_ids'] else ' AND FALSE'
        params.extend(identity_now['tenant_ids'])
    return {'audit': _admin_query('SELECT CAST(ts AS CHAR) AS ts, actor, client, command, args, old_value, new_value, ok '
                                  f'FROM audit {where} ORDER BY id DESC LIMIT %s', (*params, int(limit)))}


def strict_settings():
    return {**STRICT_DEFAULTS, **_json_read(STRICT_FILE, {})}


def strict_mac(key, prev, entry):
    """HMAC-SHA256 over the previous MAC and the entry without its own MAC: changing or removing a line breaks the chain."""
    body = json.dumps({name: value for name, value in entry.items() if name != 'mac'}, sort_keys=True, separators=(',', ':'), default=str)
    return hmac.new(key, (prev + body).encode(), hashlib.sha256).hexdigest()


def _strict_key():
    if not os.path.exists(STRICT_KEY):
        fd = os.open(STRICT_KEY, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, 'w') as f:
            f.write(secrets.token_hex(32) + '\n')
    with open(STRICT_KEY) as f:
        return bytes.fromhex(f.read().strip())


def _strict_last_mac(path):
    """The MAC of the last line, '' for an empty or missing file."""
    try:
        with open(path, 'rb') as f:
            f.seek(0, os.SEEK_END)
            f.seek(max(0, f.tell() - 65536))
            lines = f.read().splitlines()
    except OSError:
        return ''
    return json.loads(lines[-1]).get('mac', '') if lines else ''


def strict_entry(action, object_='', result='ok', old=None, new=None, reason='', session=''):
    """One entry, the time in UTC. Secrets never get here: arguments go through audit_redact first."""
    who = identity_now or {}
    return {'ts': datetime.datetime.now(datetime.timezone.utc).isoformat(timespec='milliseconds').replace('+00:00', 'Z'),
            'user': who.get('username') or acting_user or ('admin (web)' if os.environ.get('SUDO_USER') == 'efa-web' else f"console ({os.environ.get('SUDO_USER') or 'root'})"),
            'role': who.get('role') or ('super' if not acting_user else ''), 'tenant': who.get('tenant_id') or '', 'src_ip': acting_client or '',
            'session': session or acting_session or '', 'action': action, 'object': object_, 'result': result,
            'old': old, 'new': new, 'reason': reason}


def strict_write(entry, prev=None, path=None):
    """Appends one entry under a lock, with fsync. Raises OSError if it cannot: the caller refuses the action then."""
    path = path or STRICT_LOG
    os.makedirs(os.path.dirname(path), mode=0o750, exist_ok=True)
    key = _strict_key()
    new_file = not os.path.exists(path)
    fd = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
    with os.fdopen(fd, 'a') as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        entry['prev'] = _strict_last_mac(path) if prev is None else prev
        entry['mac'] = strict_mac(key, entry['prev'], entry)
        f.write(json.dumps(entry, sort_keys=True, separators=(',', ':'), default=str) + '\n')
        f.flush()
        os.fsync(f.fileno())
    if new_file:
        _strict_append_only(path, True)
    return entry


def _strict_append_only(path, on):
    try:
        _platform().append_only(path, on)
    except Exception:  # not every file system knows it; the HMAC chain still shows any change
        pass


def strict_ready():
    """Fail closed: in strict mode an action runs only if its entry can be written."""
    folder = os.path.dirname(STRICT_LOG)
    try:
        os.makedirs(folder, mode=0o750, exist_ok=True)
        usage = shutil.disk_usage(folder)
    except OSError as err:
        raise EfaError(f'Strict audit mode: the audit log cannot be written ({err}), so this is refused.')
    if usage.free < STRICT_MIN_FREE or (os.path.exists(STRICT_LOG) and not os.access(STRICT_LOG, os.W_OK)):
        raise EfaError('Strict audit mode: the audit log cannot be written (disk full?), so this is refused.')


def strict_record(action, object_='', result='ok', **fields):
    """Writes an entry if strict mode is on, and forwards it as an event to Syslog, OTLP and Wazuh."""
    if not strict_settings()['on']:
        return None
    entry = strict_write(strict_entry(action, object_, result, **fields))
    _event('audit_entry', 'notice' if result == 'ok' else 'warning', user=entry['user'], src_ip=entry['src_ip'], tenant=entry['tenant'],
           action=action, object=str(object_)[:200], result=result)
    return entry


def strict_verify(paths, key):
    """Checks the chain over all files in order. Returns entries counted and the first break, or None."""
    prev, count = '', 0
    for path in paths:
        if path != paths[-1] and os.path.exists(path + '.sig'):
            with open(path, 'rb') as f, open(path + '.sig') as sig:
                if not hmac.compare_digest(hmac.new(key, f.read(), hashlib.sha256).hexdigest(), sig.read().strip()):
                    return count, {'file': path, 'line': 0, 'reason': 'the signature of the closed file does not match'}
        with open(path) as f:
            for number, line in enumerate(f, 1):
                try:
                    entry = json.loads(line)
                except ValueError:
                    return count, {'file': path, 'line': number, 'reason': 'not a valid entry'}
                if entry.get('prev') != prev:
                    return count, {'file': path, 'line': number, 'reason': 'an entry before it is missing or changed'}
                if not hmac.compare_digest(strict_mac(key, prev, entry), entry.get('mac', '')):
                    return count, {'file': path, 'line': number, 'reason': 'this entry was changed'}
                prev, count = entry['mac'], count + 1
    return count, None


def _strict_files():
    return sorted(glob.glob(STRICT_LOG + '-*[0-9]')) + ([STRICT_LOG] if os.path.exists(STRICT_LOG) else [])


def audit_verify(_args):
    """Checks the strict audit log: every entry, the chain between them and the signature of each closed file."""
    files = _strict_files()
    if not files:
        return {'ok': True, 'entries': 0, 'files': 0, 'note': 'No strict audit log yet.'}
    count, broken = strict_verify(files, _strict_key())
    return {'ok': broken is None, 'entries': count, 'files': len(files), 'first_break': broken}


def strict_rotate(now=None):
    """Closes the log of an earlier day: a last entry naming the next file, a signature over the file, then the next file goes on with the chain."""
    if not os.path.exists(STRICT_LOG) or not os.path.getsize(STRICT_LOG):
        return None
    now = now or time.time()
    # The day of the first entry: every entry changes the time of the file, so that cannot tell.
    with open(STRICT_LOG) as f:
        first = json.loads(f.readline())['ts']
    started = datetime.datetime.fromisoformat(first.replace('Z', '+00:00')).astimezone()
    if started.strftime('%Y-%m-%d') == time.strftime('%Y-%m-%d', time.localtime(now)):
        return None
    closed = STRICT_LOG + time.strftime('-%Y%m%d-%H%M%S', time.localtime(now))
    while os.path.exists(closed):
        closed += '0'
    last = strict_write(strict_entry('audit_log_closed', os.path.basename(closed)))
    _strict_append_only(STRICT_LOG, False)
    os.rename(STRICT_LOG, closed)
    with open(closed, 'rb') as f:
        _write(closed + '.sig', hmac.new(_strict_key(), f.read(), hashlib.sha256).hexdigest() + '\n')
    os.chmod(closed, 0o400)
    strict_write(strict_entry('audit_log_opened', os.path.basename(closed)), prev=last['mac'])
    return closed


def _strict_job(today):
    """Hourly: rotation at a new day, and closed files past their days are removed."""
    if not strict_settings()['on'] and not os.path.exists(STRICT_LOG):
        return
    strict_rotate()
    cutoff = time.time() - strict_settings()['days'] * 86400
    for path in _strict_files()[:-1]:
        if os.path.getmtime(path) < cutoff:
            for item in (path, path + '.sig'):
                if os.path.exists(item):
                    os.remove(item)


def audit_mode(args):
    """Strict audit mode: on or off, only by a super admin, with a reason. Off by default."""
    if identity_now and identity_now['role'] != 'super':
        raise EfaError('Only a super admin switches the strict audit mode.')
    mode, reason = _on_off(args.mode), (args.reason or '').strip()
    if len(reason) < 5:
        raise EfaError('Give a reason, at least 5 characters.')
    state = strict_settings()
    days = (args.days or '').strip()
    if days:
        if not days.isdigit() or not 30 <= int(days) <= 3650:
            raise EfaError('Days: 30 to 3650.')
        state['days'] = int(days)
    if (args.require_reason or '').strip():
        state['require_reason'] = _on_off(args.require_reason)
    if not mode and state['on']:
        # Logged while still on; the external targets learn it as a warning.
        strict_record('audit_mode_off', reason=reason)
        _event('audit_mode_off', 'warning', user=_dmarc_who(), src_ip=acting_client, reason=reason)
    state['on'] = mode
    _json_write(STRICT_FILE, state)
    os.chmod(STRICT_FILE, 0o644)
    if mode:
        try:
            strict_ready()
            strict_record('audit_mode_on', reason=reason, new={'require_reason': state['require_reason'], 'days': state['days']})
        except (EfaError, OSError):
            state['on'] = False
            _json_write(STRICT_FILE, state)
            raise
    return {'strict_audit': mode, 'require_reason': state['require_reason'], 'days': state['days']}


def audit_strict_status(_args):
    """Strict audit mode: on or off, files, size, and the check of the chain."""
    state, files = strict_settings(), _strict_files()
    return {**state, 'files': len(files), 'megabytes': round(sum(os.path.getsize(path) for path in files) / 1048576, 1),
            'audit_rules': _audit_rules_present()}


def _audit_rules_present():
    try:
        return _platform().audit_rules_present()
    except Exception:  # no platform layer, as in a test
        return False


def audit_note(args):
    """An action of the web interface without a command of its own: login, logout, page view, download, refusal."""
    action = (args.action or '').strip()[:64]
    if not re.fullmatch(r'[a-z_]+(:[A-Z]+ [\w./<>-]+)?', action):
        raise EfaError('Unknown action.')
    entry = strict_record(action, (args.object or '')[:500], (args.result or 'ok').strip()[:32], session=(args.session or '')[:64])
    return {'logged': bool(entry)}


def audit_rules_text():
    return '# Written by efactl audit-rules-set. Do not edit: it is replaced.\n' + ''.join(f'-w {path} -p wa -k efa\n' for path in AUDIT_RULE_PATHS)


def audit_rules_set(args):
    """Rules of the audit daemon for the eFa settings and programs, loaded without a reboot."""
    mode = _on_off(args.mode)
    try:
        _platform().audit_rules(audit_rules_text() if mode else None)
    except Exception as err:  # the StepError of the platform layer
        raise EfaError(f'The audit daemon did not take the rules: {err}')
    return {'audit_rules': mode}


def content_reason_set(args):
    """A reason is needed before the content of a mail is shown, also without the strict audit mode. The reason goes to the audit log."""
    state = _json_read(STRICT_FILE, {})
    state['content_reason'] = _on_off(args.mode)
    _json_write(STRICT_FILE, state)
    return {'content_reason': state['content_reason']}


def audit_purge(_args):
    """Remove audit entries after their days (400 by default), and the rows of DMARC and TLS reports after theirs."""
    _admin_query('DELETE FROM audit WHERE ts < NOW() - INTERVAL %s DAY', (retention('audit'),))
    for table in ('dmarc_rua', 'tls_rpt'):
        try:
            _admin_query(f'DELETE FROM {table} WHERE begin_ts < NOW() - INTERVAL %s DAY LIMIT 100000', (retention('reports'),))
        except Exception:  # pymysql: the table exists only once reports are read
            pass
    return {'kept_days': retention('audit'), 'report_days': retention('reports')}


def retention_status(_args):
    """How long each kind of data is kept, and where that is set."""
    policy = headers_policy()
    return {'retention': [
        {'data': 'mail log', 'days': _maillog_days(), 'set_with': 'maillog-retention-set'},
        {'data': 'headers of all mail', 'days': policy['days'] if policy['store'] else 0, 'set_with': 'headers-store-set, per domain: domain-general-set'},
        {'data': 'quarantine', 'days': _quarantine_days(), 'set_with': 'quarantine-days-set'},
        {'data': 'audit log', 'days': retention('audit'), 'set_with': 'retention-set'},
        {'data': 'DMARC and TLS reports', 'days': retention('reports'), 'set_with': 'retention-set'},
        {'data': 'originals of disarmed attachments', 'days': retention('cdr'), 'set_with': 'retention-set'},
        {'data': 'reported phishing mails', 'days': retention('phish'), 'set_with': 'retention-set'},
        {'data': 'web sessions', 'days': 1, 'set_with': ''},
        {'data': 'local backups', 'days': BACKUP_KEEP_DAYS, 'set_with': ''},
        {'data': 'event log (SIEM, OTLP, Wazuh)', 'days': 120, 'set_with': 'monthly rotation, 4 files'}]}


def retention_set(args):
    """Days to keep the audit log, DMARC and TLS reports, originals of disarmed attachments or reported phishing mails."""
    kind, days = (args.data or '').strip(), (args.days or '').strip()
    if kind not in RETENTION_DEFAULTS:
        raise EfaError('Data: ' + ', '.join(RETENTION_DEFAULTS))
    low, high = RETENTION_LIMITS[kind]
    if not days.isdigit() or not low <= int(days) <= high:
        raise EfaError(f'Days for {kind}: {low} to {high}.')
    state = _json_read(RETENTION_FILE, {})
    state[kind] = int(days)
    _json_write(RETENTION_FILE, state)
    return retention_status(None)


def search_pattern(text):
    """A plain value matches exactly and can use the index, * is the wildcard."""
    escaped = text.strip().replace('\\', '\\\\').replace('%', '\\%').replace('_', '\\_')
    return escaped.replace('*', '%')


def search_where(filters, domains):
    """The WHERE clause of a message search. Values only ever travel as parameters."""
    where, params = [], []
    for column in ('sender', 'rcpt', 'ip', 'qid', 'action', 'message_id', 'header_from', 'reply_to', 'return_path', 'x_mailer'):
        value = filters.get(column, '').strip()
        if value:
            where.append(f'{column} LIKE %s')
            params.append(search_pattern(value))
    subject = filters.get('subject', '').strip()
    if subject:
        words = re.findall(r'\w{3,}', subject)
        if words and '*' not in subject:
            where.append('MATCH(subject) AGAINST(%s IN BOOLEAN MODE)')
            params.append(' '.join('+' + word for word in words))
        else:
            where.append('subject LIKE %s')
            params.append('%' + search_pattern(subject) + '%')
    for key, sign in (('date_from', '>='), ('date_to', '<=')):
        value = filters.get(key, '').strip()
        if value:
            if not re.fullmatch(r'\d{4}-\d{2}-\d{2}( \d{2}:\d{2}(:\d{2})?)?', value):
                raise EfaError('Dates like 2026-11-05 or 2026-11-05 14:30.')
            where.append(f'ts {sign} %s')
            params.append(value + (' 23:59:59' if sign == '<=' and len(value) == 10 else ''))
    if domains is not None:
        # Empty list: this login sees no mail at all.
        scope = [f'{column} LIKE %s' for column in ('rcpt', 'sender') for _ in domains]
        where.append('(' + ' OR '.join(scope) + ')' if scope else 'FALSE')
        params += [f'%@{domain}%' for _ in ('rcpt', 'sender') for domain in domains]
    return ('WHERE ' + ' AND '.join(where) if where else ''), params


def search_csv(rows):
    """A cell a spreadsheet would run as a formula gets a leading quote: senders and subjects come from outside."""
    out = io.StringIO()
    writer = csv.writer(out)
    writer.writerow(SEARCH_COLUMNS)
    for row in rows:
        cells = ['' if row.get(column) is None else str(row[column]) for column in SEARCH_COLUMNS]
        writer.writerow(["'" + cell if cell[:1] in ('=', '+', '-', '@', '\t', '\r') else cell for cell in cells])
    return out.getvalue()


def message_search(args):
    """Search all mail in the log with filters, also as CSV. Exact values use the index, * is the wildcard."""
    fmt = (args.format or '').strip()
    as_csv = fmt in ('csv', 'json')
    if as_csv and identity_now and 'export' not in identity_now['grants']:
        raise EfaError('Not allowed: the export needs the permission export.')
    top = SEARCH_LIMIT_CSV if as_csv else SEARCH_LIMIT_PAGE
    limit = (args.limit or '').strip() or '100'
    if not limit.isdigit() or not 1 <= int(limit) <= top:
        raise EfaError(f'Limit must be 1 to {top}.')
    filters = {key: getattr(args, key, '') or '' for key in ('sender', 'rcpt', 'subject', 'ip', 'qid', 'action', 'date_from', 'date_to', 'message_id',
                                                                 'header_from', 'reply_to', 'return_path', 'x_mailer')}
    where, params = search_where(filters, identity_now['domains'] if identity_now else None)
    db = _maillog_db()
    try:
        with db.cursor() as cur:
            cur.execute('SELECT id, CAST(ts AS CHAR) AS ts, qid, message_id, sender, rcpt, ip, action, score, subject, spf, dkim, dmarc '
                        f'FROM maillog {where} ORDER BY ts DESC, id DESC LIMIT %s', (*params, int(limit)))
            rows = cur.fetchall()
    finally:
        db.close()
    rows = subject_filter(identity_now, 'message-search', scoped_result(identity_now, 'message-search', {'mails': rows}), subjects_shown())['mails']
    rows = local_times(rows, _reader_timezone())
    if fmt == 'json':
        return {'json': json.dumps(rows, indent=1, default=str), 'rows': len(rows)}
    return {'csv': search_csv(rows), 'rows': len(rows)} if as_csv else {'mails': rows}


SIEM_CA_DEFAULT = '/etc/pki/tls/certs/ca-bundle.crt'


def siem_conf(target, port, protocol, kind, ca_file=SIEM_CA_DEFAULT):
    """rsyslog sends mail, audit and firewall lines on, over TLS with the certificate of the target checked by its name. The
    queue is bounded, so a dead target only costs the oldest lines. tcp and udp stay only for a setup of before (S1 notice)."""
    template = 'RSYSLOG_SyslogProtocol23Format' if kind == 'rfc5424' else 'efaSiemJson'
    json_template = """template(name="efaSiemJson" type="list" option.jsonf="on") {
  property(outname="@timestamp" name="timereported" dateformat="rfc3339" format="jsonf")
  property(outname="host" name="hostname" format="jsonf")
  property(outname="facility" name="syslogfacility-text" format="jsonf")
  property(outname="severity" name="syslogseverity-text" format="jsonf")
  property(outname="program" name="programname" format="jsonf")
  property(outname="message" name="msg" format="jsonf")
}
""" if kind == 'json' else ''
    tls = (f'StreamDriver="gtls" StreamDriverMode="1" StreamDriverAuthMode="x509/name" StreamDriverPermittedPeers="{target}"\n'
           f'         StreamDriver.CAFile="{ca_file}"\n         ') if protocol == 'tls' else ''
    return f"""# Written by efactl siem-set. Do not edit: the next change replaces it.
module(load="imfile")
input(type="imfile" File="{AUDIT_LOG}" Tag="efa-audit:" Facility="local6" Severity="info" freshStartTail="on")
input(type="imfile" File="{FIREWALL_LOG}" Tag="efa-firewall:" Facility="local6" Severity="info" freshStartTail="on")
input(type="imfile" File="{EVENTS_LOG}" Tag="efa-events:" Facility="local6" Severity="info" freshStartTail="on")
{json_template}if ($syslogfacility-text == "mail" or $programname startswith "efa-" or $programname startswith "fail2ban") then {{
  action(type="omfwd" target="{target}" port="{port}" protocol="{'tcp' if protocol == 'tls' else protocol}" template="{template}"
         {tls}queue.type="LinkedList" queue.size="10000" queue.discardMark="9000" action.resumeRetryCount="-1")
}}
"""


def siem_stop_plain(_args):
    """Upgrade step (S1, fail closed): an export of before over plain TCP or UDP stops; its settings stay for the switch to TLS."""
    state = _json_read(SIEM_FILE, {})
    if state.get('siem') and state.get('protocol') in ('tcp', 'udp') and os.path.exists(SIEM_CONF):
        os.remove(SIEM_CONF)
        _platform().service_try_restart('rsyslog')
        state['stopped_plain'] = True
        _json_write(SIEM_FILE, state)
    return {'stopped': bool(state.get('stopped_plain'))}


def siem_status(_args):
    """Forwarding of logs to a SIEM. Off by default."""
    return _json_read(SIEM_FILE, {'siem': False})


def siem_set(args):
    """Send logs to a SIEM through rsyslog, as RFC 5424 or JSON. A target rsyslog rejects is not kept."""
    if not _on_off(args.mode):
        if os.path.exists(SIEM_CONF):
            os.remove(SIEM_CONF)
        _json_write(SIEM_FILE, {'siem': False})
        events_marker()
        subprocess.run(['systemctl', 'try-restart', 'rsyslog'], check=False, capture_output=True)
        return {'siem': False}
    target, port, protocol, kind = args.target.strip(), args.port.strip() or '6514', args.protocol.strip() or 'tls', args.format.strip() or 'rfc5424'
    ca_file = (getattr(args, 'ca_file', '') or '').strip() or SIEM_CA_DEFAULT
    try:
        ipaddress.ip_address(target)
    except ValueError:
        if not DOMAIN_RE.match(target):
            raise EfaError('Target: a host name or an IP address.')
    if not port.isdigit() or not 1 <= int(port) <= 65535:
        raise EfaError('Port: 1 to 65535.')
    if protocol in ('tcp', 'udp'):
        raise EfaError('Plain tcp or udp would send the logs readable over the network: use tls (port 6514 by default).')
    if protocol != 'tls':
        raise EfaError('Protocol: tls.')
    if not os.path.isfile(ca_file):
        raise EfaError(f'CA file {ca_file} is not there.')
    if ca_file != SIEM_CA_DEFAULT:
        # rsyslog runs confined by SELinux: it reads a copy below /etc/pki, not the file where the admin put it.
        with open(ca_file) as f:
            pem = f.read()
        if 'BEGIN CERTIFICATE' not in pem:
            raise EfaError('CA file: a certificate in PEM format.')
        os.makedirs(ETC + '/pki/rsyslog', exist_ok=True)
        ca_file = ETC + '/pki/rsyslog/efa-siem-ca.pem'
        _write(ca_file, pem)
        os.chmod(ca_file, 0o644)
        _platform().restore_context(ca_file)
    if not _platform().package_installed('rsyslog-gnutls'):
        _platform().package_install(['rsyslog-gnutls'])
    if kind not in SIEM_FORMATS:
        raise EfaError('Format: ' + ' or '.join(SIEM_FORMATS) + '.')
    previous = open(SIEM_CONF).read() if os.path.exists(SIEM_CONF) else None
    _write(SIEM_CONF, siem_conf(target, port, protocol, kind, ca_file))
    done = subprocess.run(['rsyslogd', '-N1'], capture_output=True, text=True)
    if done.returncode != 0:
        if previous is None:
            os.remove(SIEM_CONF)
        else:
            _write(SIEM_CONF, previous)
        raise EfaError('rsyslog rejected this, nothing changed: ' + (done.stderr or done.stdout).strip()[-200:])
    subprocess.run(['systemctl', 'restart', 'rsyslog'], check=True, capture_output=True)
    state = {'siem': True, 'target': target, 'port': int(port), 'protocol': protocol, 'format': kind, 'ca_file': ca_file}
    _json_write(SIEM_FILE, state)
    events_marker()
    return state


def metric_label(value):
    return str(value).replace('\\', '\\\\').replace('"', '\\"').replace('\n', ' ')


BAYES_CONF = RSPAMD_DIR + '/local.d/classifier-bayes.conf'
# The default of rspamd when the file does not set it.
BAYES_MIN_LEARNS = 200


def bayes_parse(stat_text, conf_text):
    """Learned spam and ham from rspamc stat, the switches from classifier-bayes.conf. Only reads."""
    learned = {'spam': 0, 'ham': 0}
    for match in re.finditer(r'^Statfile: BAYES_(SPAM|HAM) .*?learned: (\d+)', stat_text, re.M):
        learned[match.group(1).lower()] += int(match.group(2))
    def value(name):
        found = re.search(rf'^\s*{name}\s*=\s*([^;#\n]+)', conf_text, re.M)
        return found.group(1).strip().strip('"') if found else None
    min_learns = int(value('min_learns')) if (value('min_learns') or '').isdigit() else BAYES_MIN_LEARNS
    autolearn = value('autolearn')
    return {'spam_learned': learned['spam'], 'ham_learned': learned['ham'], 'min_learns': min_learns,
            'active': learned['spam'] >= min_learns and learned['ham'] >= min_learns,
            'autolearn': 'off' if autolearn in (None, 'false') else ('on, rspamd thresholds' if autolearn == 'true' else f'on: {autolearn}'),
            'per_user': value('per_user') not in (None, 'false'), 'backend': value('backend') or 'redis'}


# The processes the dashboard counts, by their name or the program in their command line.
DASH_PROCESSES = {'Postfix': ('master', 'smtpd', 'smtp', 'qmgr', 'pickup', 'cleanup', 'tlsmgr', 'anvil', 'postscreen', 'proxymap', 'trivial-rewrite',
                              'bounce', 'lmtp', 'local', 'showq', 'scache', 'verify', 'dnsblog', 'tlsproxy', 'smtp-sink'),
                  'rspamd': ('rspamd',), 'Milter': ('efa-milter-health', 'efa-milter-health.py'), 'ClamAV': ('clamd',),
                  'Unbound': ('unbound',), 'MariaDB': ('mariadbd', 'mysqld'), 'Redis': ('redis-server',)}
DASH_QUEUE_WARN = 100


def dash_queues(entries, own):
    """postqueue -j lines to counts per queue, split into inbound (to an own domain) and outbound."""
    counts = {}
    for entry in entries:
        recipients = [item.get('address', '') for item in entry.get('recipients') or []]
        way = 'in' if recipients and all(address.rpartition('@')[2].lower() in own for address in recipients) else 'out'
        name = entry.get('queue_name', 'unknown')
        counts.setdefault(name, {'in': 0, 'out': 0})[way] += 1
    return counts


def dash_minutes(rows, now):
    """The last 60 minutes, oldest first, each with mails, spam and viruses; minutes without mail count 0."""
    found = {row['minute']: row for row in rows}
    minutes = []
    for back in range(59, -1, -1):
        key = (now - datetime.timedelta(minutes=back)).strftime('%H:%M')
        row = found.get(key, {})
        minutes.append({'minute': key, 'mails': int(row.get('mails') or 0), 'spam': int(row.get('spam') or 0), 'virus': int(row.get('virus') or 0)})
    return minutes


def dash_stats(_args):
    """Today's totals, the last hour per minute, queues and processes for the dashboard. Reads only; the host-wide parts need all domains."""
    domains = identity_now['domains'] if identity_now else None
    where, params = search_where({'date_from': _today().isoformat()}, domains)
    hour_where, hour_params = search_where({'date_from': (datetime.datetime.now() - datetime.timedelta(minutes=59)).strftime('%Y-%m-%d %H:%M')}, domains)
    spam = "action IN ('add header', 'rewrite subject')"
    db = _maillog_db()
    try:
        with db.cursor() as cur:
            cur.execute("SELECT COUNT(*) AS processed, COALESCE(SUM(size), 0) AS bytes, SUM(action = 'no action') AS clean, SUM(" + spam + ") AS spam,"
                        " SUM(action = 'reject' AND COALESCE(threat, '') = '') AS high_spam, SUM(threat LIKE 'virus:%%') AS viruses,"
                        " SUM(threat LIKE 'file:%%') AS blocked_files FROM maillog " + where, params)
            today = {key: int(value or 0) for key, value in cur.fetchone().items()}
            cur.execute("SELECT SUBSTRING(threat, 7) AS name, COUNT(*) AS n FROM maillog " + where + (' AND ' if where else ' WHERE ')
                        + "threat LIKE 'virus:%%' GROUP BY name ORDER BY n DESC LIMIT 1", params)
            top = cur.fetchone()
            cur.execute("SELECT DATE_FORMAT(ts, '%%H:%%i') AS minute, COUNT(*) AS mails, SUM(" + spam + " OR action = 'reject' AND COALESCE(threat, '') = '') AS spam,"
                        " SUM(threat LIKE 'virus:%%') AS virus FROM maillog " + hour_where + ' GROUP BY minute', hour_params)
            minutes = dash_minutes(cur.fetchall(), datetime.datetime.now())
    finally:
        db.close()
    processed = today['processed']
    today['megabytes'] = round(today.pop('bytes') / 1048576, 1)
    today['other'] = max(0, processed - today['clean'] - today['spam'] - today['high_spam'] - today['viruses'] - today['blocked_files'])
    today['percent'] = {key: round(100 * today[key] / processed, 1) if processed else 0
                        for key in ('clean', 'spam', 'high_spam', 'viruses', 'blocked_files', 'other')}
    today['top_virus'] = top['name'] if top else None
    result = {'today': today, 'last_hour': minutes}
    if domains is None:
        done = subprocess.run(['postqueue', '-j'], capture_output=True, text=True, timeout=30)
        entries = [json.loads(line) for line in done.stdout.splitlines() if line.startswith('{')] if done.returncode == 0 else []
        queues = dash_queues(entries, {line.split()[0].lower() for line in _read_lines(TRANSPORT) if line.split()})
        result['queues'] = {'counts': queues, 'warn': sum(sum(way.values()) for way in queues.values()) >= DASH_QUEUE_WARN}
        try:
            result['processes'] = _platform().process_counts(DASH_PROCESSES)
        except Exception:  # the StepError of the platform layer; the dashboard shows the rest
            result['processes'] = None
    return result


def bayes_status(_args):
    """The Bayes classifier of rspamd: how much it has learned, whether it counts yet, and how it learns. Changes nothing."""
    done = subprocess.run(['rspamc', 'stat'], capture_output=True, text=True, timeout=30)
    if done.returncode != 0:
        raise EfaError('rspamd does not answer.')
    conf = open(BAYES_CONF).read() if os.path.exists(BAYES_CONF) else ''
    return bayes_parse(done.stdout, conf)


def metrics_text(health, queues, mails, held, bayes=None):
    """Prometheus text format, from the values the other commands already know."""
    lines = ['# TYPE efa_up gauge', f"efa_up {1 if health.get('status') == 'ok' else 0}", '# TYPE efa_check_up gauge']
    lines += [f'efa_check_up{{check="{metric_label(name)}"}} {1 if good else 0}' for name, good in sorted(health.get('checks', {}).items())]
    lines.append('# TYPE efa_queue_messages gauge')
    lines += [f'efa_queue_messages{{queue="{metric_label(name)}"}} {count}' for name, count in sorted(queues.items())]
    lines.append('# TYPE efa_mail_today gauge')
    lines += [f'efa_mail_today{{action="{metric_label(name)}"}} {count}' for name, count in sorted(mails.items())]
    lines += ['# TYPE efa_quarantine_messages gauge', f'efa_quarantine_messages {held}']
    if bayes:
        lines += ['# TYPE efa_bayes_learned gauge', f"efa_bayes_learned{{class=\"spam\"}} {bayes['spam_learned']}",
                  f"efa_bayes_learned{{class=\"ham\"}} {bayes['ham_learned']}", '# TYPE efa_bayes_active gauge', f"efa_bayes_active {int(bayes['active'])}"]
    return '\n'.join(lines) + '\n'


def metrics(_args):
    """Values for Prometheus, at /metrics with an API token."""
    try:
        health = status(None)
    except EfaError:
        health = {}
    queues = {}
    held = 0
    done = subprocess.run(['postqueue', '-j'], capture_output=True, text=True)
    for line in done.stdout.splitlines():
        name = json.loads(line).get('queue_name', 'unknown')
        queues[name] = queues.get(name, 0) + 1
        held += name == 'hold'
    mails = {}
    try:
        db = _maillog_db()
        try:
            with db.cursor() as cur:
                cur.execute('SELECT action, COUNT(*) AS n FROM maillog WHERE ts >= CURDATE() GROUP BY action')
                mails = {row['action'] or 'unknown': row['n'] for row in cur.fetchall()}
        finally:
            db.close()
    except (EfaError, OSError):
        pass
    try:
        bayes = bayes_status(None)
    except (EfaError, OSError, subprocess.SubprocessError):
        bayes = None
    return {'text': metrics_text(health, queues, mails, held, bayes)}


# The services an admin may restart from the web and the text interface.
RESTARTABLE = ('postfix', 'rspamd', 'redis', 'clamd@scan', 'nginx', 'mariadb', 'unbound', 'fail2ban', 'efa-web', 'efa-portal', 'efa-portal-helper',
               'efa-maillog', 'efa-milter-health')
LOGS = {'mail': '/var/log/maillog', 'efa': '/var/log/eFa/eFa-config.log', 'audit': '/var/log/eFa/audit.log', 'firewall': '/var/log/eFa/firewall.log',
        'update': '/var/log/eFa/update-system.log'}


def _platform():
    """The platform layer of eFa-base: service control without calling the service manager here."""
    if '/usr/lib/eFa/python' not in sys.path:
        sys.path.insert(0, '/usr/lib/eFa/python')
    import efa_platform
    return efa_platform.detect()


def service_restart(args):
    """Restart one service of eFa, for example after a change by hand. Mail waits for the seconds it takes."""
    name = args.name.strip()
    if name not in RESTARTABLE:
        raise EfaError('Service: one of ' + ', '.join(RESTARTABLE))
    platform_now = _platform()
    try:
        platform_now.service_restart(name)
    except Exception as err:  # the StepError of the platform layer
        raise EfaError(str(err))
    return {'service': name, 'active': platform_now.service_is_active(name)}


def log_tail(path, lines):
    """The last lines of a log file, read from the end: a large log costs no more than a small one."""
    if not os.path.exists(path):
        return []
    with open(path, 'rb') as f:
        f.seek(0, 2)
        size, block, data = f.tell(), 65536, b''
        while size > 0 and data.count(b'\n') <= lines:
            step = min(block, size)
            size -= step
            f.seek(size)
            data = f.read(step) + data
    return [line.decode('utf-8', 'replace') for line in data.splitlines()[-lines:]]


def log_show(args):
    """The last lines of a log: mail, eFa setup, audit, firewall or system update."""
    name = args.name.strip()
    if name not in LOGS:
        raise EfaError('Log: one of ' + ', '.join(LOGS))
    count = (args.lines or '').strip() or '100'
    if not count.isdigit() or not 1 <= int(count) <= 2000:
        raise EfaError('Lines: 1 to 2000.')
    return {'log': LOGS[name], 'lines': log_tail(LOGS[name], int(count))}


SECURITY_FILE = '/var/lib/eFa/security-check.json'
SECURITY_SETTINGS = ETC + '/eFa/security-check.json'
COMMON_PASSWORDS = '/usr/share/eFa/common-passwords.txt'
# What listens on more than the loopback by design: SMTP, submission, web, SSH.
EXPECTED_PORTS = {25, 465, 587, 80, 443, 22}
LEVELS = ('ok', 'warning', 'problem')


def finding(level, title, detail, fix=''):
    return {'level': level, 'title': title, 'detail': detail, 'fix': fix}


def zone_findings(zones, routed):
    """firewalld zones that let everything in on an interface with the default route, and rules in zones no traffic reaches.
    zones: {name: {'target', 'interfaces', 'sources', 'rules'}} of the permanent configuration; routed: interfaces with the
    default route. Changes nothing (the fix is the admin's, between minute 20 and 50)."""
    found = []
    for name, zone in sorted(zones.items()):
        open_on = sorted(set(zone['interfaces']) & set(routed))
        if zone['target'] == 'ACCEPT' and open_on:
            found.append(finding('problem', f'Interface {", ".join(open_on)} in zone {name}, which lets everything in',
                                 'Every port that listens is open to every network the host can be reached from; rules of other zones do not apply.',
                                 'Move the interface into a zone such as public that allows only what is needed, with a way back armed.'))
        if zone['rules'] and not zone['interfaces'] and not zone['sources']:
            found.append(finding('warning', f'{zone["rules"]} firewall rules in zone {name} do nothing',
                                 'The zone has no interface and no source, so no packet reaches its rules.',
                                 'Move the interface into this zone, or keep blocklists in eFa (IP blocklists), which work for every interface.'))
    return found


def _firewall_zones():
    """The permanent zones as zone_findings takes them, and the interfaces with the default route."""
    zones = {}
    for name in _fw('--permanent', '--get-zones').stdout.split():
        info = _fw('--permanent', f'--zone={name}', '--list-all').stdout
        get = lambda key: (re.search(rf'^\s+{key}: ?(.*)$', info, re.M) or [None, ''])[1].split()
        zones[name] = {'target': (get('target') or ['default'])[0], 'interfaces': get('interfaces'), 'sources': get('sources'),
                       'rules': len(re.findall(r'^\s+rule ', info, re.M))}
    # Interfaces NetworkManager put into a zone are not in the files of firewalld: the zones at run time hold them.
    current = None
    for line in _fw('--get-active-zones').stdout.splitlines():
        if line and not line.startswith(' '):
            current = line.split()[0]
        elif current and line.strip().startswith('interfaces:') and current in zones:
            zones[current]['interfaces'] = sorted(set(zones[current]['interfaces']) | set(line.split(':', 1)[1].split()))
    routes = subprocess.run(['ip', 'route', 'show', 'default'], capture_output=True, text=True, timeout=15).stdout
    return zones, sorted(set(re.findall(r'\bdev (\S+)', routes)))


def update_findings(updates, listening):
    """Security updates that are missing; first those of packages that listen on the network."""
    exposed = {item['package'] for item in listening if item['package'] and item['address'] not in ('127.0.0.1', '::1')}
    found = []
    for item in sorted(updates, key=lambda item: (item['package'] not in exposed, item['package'])):
        ids = ', '.join(item['ids'][:8]) + (' ...' if len(item['ids']) > 8 else '')
        level = 'problem' if item['package'] in exposed and item['severity'] in ('Critical', 'Important') else 'warning'
        found.append(finding(level, f"Security update for {item['package']}" + (' (listens on the network)' if item['package'] in exposed else ''),
                             f"{item['severity']}: {ids}", 'Maintenance & update: Update system.'))
    return found


# Services of the site that are not part of eFa-next: one per line, "port/proto process comment" (process * for any).
SECURITY_EXCLUDE_DIR = ETC + '/eFa/security-check.d'


def security_excludes(texts):
    """The excluded services of the files: [(port, proto, process, comment)]. Lines it cannot read are skipped."""
    found = []
    for text in texts:
        for line in text.splitlines():
            parts = line.split('#', 1)[0].split(None, 2)
            match = re.match(r'^(\d{1,5})/(tcp|udp)$', parts[0]) if len(parts) >= 2 else None
            if match:
                found.append((int(match.group(1)), match.group(2), parts[1], (parts[2] if len(parts) > 2 else '').strip()[:80]))
    return found


def _security_excludes():
    texts = []
    for path in sorted(glob.glob(SECURITY_EXCLUDE_DIR + '/*.conf')):
        try:
            with open(path) as f:
                texts.append(f.read())
        except OSError:
            continue
    return security_excludes(texts)


def port_findings(listening, excludes=(), excluded=None):
    found = []
    for item in listening:
        if item['address'] in ('127.0.0.1', '::1') or item['address'].startswith('127.') or item['port'] in EXPECTED_PORTS or item['proto'] == 'udp':
            continue
        hit = next((rule for rule in excludes if rule[0] == int(item['port']) and rule[1] == item['proto'] and rule[2] in ('*', item['process'])), None)
        if hit:
            if excluded is not None:
                excluded.append({'port': f"{item['port']}/{item['proto']}", 'process': item['process'] or 'unknown', 'comment': hit[3] or 'not part of eFa-next'})
            continue
        found.append(finding('warning', f"Port {item['port']}/{item['proto']} is open to the network", f"{item['process'] or 'unknown'} ({item['package'] or 'no package'})",
                             'Stop the service or bind it to 127.0.0.1, if it is not needed from outside.'))
    return found


def sshd_findings(text):
    values = dict(line.split(None, 1) for line in text.splitlines() if ' ' in line)
    found = []
    if values.get('permitrootlogin') == 'yes':
        found.append(finding('warning', 'Root can log in through SSH with a password', 'PermitRootLogin yes', 'Security: Root login through SSH.'))
    if values.get('passwordauthentication') == 'yes' and values.get('permitrootlogin') in ('yes',):
        found.append(finding('warning', 'SSH accepts passwords', 'PasswordAuthentication yes', 'Use SSH keys, then turn password logins off.'))
    return found


def tls_findings(smtpd_protocols, nginx_conf, dovecot_min):
    found = []
    allowed = smtpd_protocols.replace(',', ' ').split()
    if '!SSLv3' not in allowed and '>=TLSv1.2' not in allowed and '>=TLSv1' not in allowed:
        found.append(finding('problem', 'Postfix allows SSLv3', f'smtpd_tls_protocols = {smtpd_protocols or "(default)"}', 'postconf smtpd_tls_protocols="!SSLv2, !SSLv3"'))
    match = re.search(r'ssl_protocols\s+([^;]+);', nginx_conf)
    # TLSv1 alone, not the start of TLSv1.2.
    if match and re.search(r'(?<![\w.])(SSLv3|TLSv1|TLSv1\.1)(?![\w.])', match.group(1)):
        found.append(finding('problem', 'nginx allows old TLS versions', match.group(1), 'ssl_protocols TLSv1.2 TLSv1.3;'))
    if '!SSLv3' in allowed and not _tls12(smtpd_protocols):
        found.append(finding('warning', 'Postfix still allows TLS 1.0 and 1.1', f'smtpd_tls_protocols = {smtpd_protocols}',
                             'efactl tls-min-set --mode on; a very old server then sends unencrypted'))
    if dovecot_min and dovecot_min in ('SSLv3', 'TLSv1', 'TLSv1.1'):
        found.append(finding('warning', 'Dovecot allows old TLS versions', f'ssl_min_protocol = {dovecot_min}', 'ssl_min_protocol = TLSv1.2'))
    return found


CIPHER_GRADES = ('export', 'low', 'medium', 'high', 'null')


def cipher_findings(values):
    """A cipher list where Postfix wants a grade: Postfix logs "invalid cipher grade" and STARTTLS breaks."""
    return [finding('problem', 'Postfix cipher setting is no grade, STARTTLS fails', f'{name} = {value[:80]}',
                    f'postconf "{name} = high" "tls_high_cipherlist = {value[:40]}…"')
            for name, value in values.items() if value and value.lower() not in CIPHER_GRADES]


def protocol_syntax_findings(values, version):
    """">=TLSv1.2" before Postfix 3.6: it rejects the value, and STARTTLS no longer works."""
    parts = [int(item) for item in re.findall(r'\d+', version)[:2]] or [0, 0]
    if parts >= [3, 6]:
        return []
    return [finding('problem', 'Postfix does not understand this TLS protocol setting', f'{name} = {value} (Postfix {version})',
                    f'postconf "{name} = {TLS_MIN_NEW}"') for name, value in values.items() if '>=' in value or '<=' in value]


def pam_findings(pam_on, submission_on):
    if pam_on and submission_on:
        return [finding('warning', 'SMTP AUTH uses system accounts via PAM', 'port 587 checks logins against the accounts of this host, through Dovecot',
                        'Switch to submitter logins to drop Dovecot: Mail routing → Submitters, then efactl submission-pam-set --mode off.')]
    return []


def relay_findings(restrictions, mynetworks):
    found = []
    if 'reject_unauth_destination' not in restrictions and 'defer_unauth_destination' not in restrictions:
        found.append(finding('problem', 'Postfix may be an open relay', 'neither reject_unauth_destination nor defer_unauth_destination in the relay restrictions',
                             'Mail routing: relay networks; postconf smtpd_relay_restrictions.'))
    if re.search(r'(^|[\s,])(0\.0\.0\.0/0|::/0|\[::\]/0)([\s,]|$)', mynetworks):
        found.append(finding('problem', 'Everybody may relay', f'mynetworks = {mynetworks}', 'Mail routing: Relay networks.'))
    return found


def mode_findings(paths):
    found = []
    for path in paths:
        try:
            mode = os.stat(path).st_mode
        except OSError:
            continue
        if mode & 0o004:
            found.append(finding('problem', f'{path} is readable by everyone', oct(mode & 0o777), f'chmod o-r {path}'))
    return found


def certificate_findings(not_after, now=None):
    if not_after is None:
        return []
    left = (not_after - (now or time.time())) / 86400
    if left < 0:
        return [finding('problem', 'The certificate of the web interface has expired', f'{-int(left)} days ago', 'Network & certificate: Let\'s Encrypt.')]
    if left < 21:
        return [finding('warning', 'The certificate of the web interface expires soon', f'in {int(left)} days', 'Network & certificate: Let\'s Encrypt.')]
    return []


def _certificate_end():
    match = re.search(r'ssl_certificate\s+([^;]+);', open('/etc/nginx/conf.d/efa.conf').read()) if os.path.exists('/etc/nginx/conf.d/efa.conf') else None
    if not match:
        return None
    done = subprocess.run(['openssl', 'x509', '-noout', '-enddate', '-in', match.group(1).strip()], capture_output=True, text=True)
    found = re.search(r'notAfter=(.+)', done.stdout)
    return time.mktime(time.strptime(found.group(1).strip().replace(' GMT', ''), '%b %d %H:%M:%S %Y')) if found else None


def security_check(_args):
    """Looks for what makes this host weak: missing security updates, ports, firewall, SSH, TLS, relay, file modes, certificate. Changes nothing."""
    checks, platform_now = [], _platform()
    try:
        listening = platform_now.listening()
    except Exception as err:  # the StepError of the platform layer
        listening, checks = [], [finding('warning', 'Listening ports not readable', str(err)[:200])]
    try:
        checks += update_findings(platform_now.security_updates(), listening)
    except Exception as err:
        checks.append(finding('warning', 'Security updates not checked', str(err)[:200], 'Check the access to the package repositories.'))
    excluded = []
    checks += port_findings(listening, _security_excludes(), excluded)
    try:
        found, _status = oval_check(listening)
        checks += found
    except Exception as err:  # a broken OVAL file or a platform without it: the other checks go on
        checks.append(finding('warning', 'OVAL check failed', str(err)[:200], 'security-oval-set --mode off, then on again to load it anew.'))
    fw = _firewall_state()
    try:
        firewall_up = _fw('--state').returncode == 0
    except OSError:
        firewall_up = False
    if not firewall_up:
        checks.append(finding('problem', 'The firewall does not run', 'firewalld is down', 'Security: Firewall guard, or start firewalld between minute 20 and 50.'))
    if not fw.get('guard'):
        checks.append(finding('warning', 'The firewall guard is off', 'missing eFa rules are not restored', 'Security: Firewall guard.'))
    if firewall_up:
        try:
            checks += zone_findings(*_firewall_zones())
        except (OSError, subprocess.SubprocessError) as err:
            checks.append(finding('warning', 'Firewall zones not checked', str(err)[:200]))
    try:
        health = status(None)
        failed = health.get('down', [])
        if failed:
            checks.append(finding('problem', 'A mail filter or service is down', ', '.join(failed),
                                  'Status: start the service; set milter-health-set to tempfail for a milter that must never be skipped.'))
    except EfaError as err:
        checks.append(finding('warning', 'The health service does not answer', str(err)[:200], 'Start efa-milter-health.'))
    checks += sshd_findings(subprocess.run(['sshd', '-T'], capture_output=True, text=True).stdout)
    try:
        overruled = [text for text in ssh_root_status(None)['warnings'] if text.startswith('sshd does not take')]
    except EfaError:
        overruled = []
    checks += [finding('warning', 'An eFa setting of SSH does not take effect', text, 'Security: Root login through SSH.') for text in overruled]
    nginx = open('/etc/nginx/conf.d/efa.conf').read() if os.path.exists('/etc/nginx/conf.d/efa.conf') else ''
    dovecot = subprocess.run(['doveconf', '-h', 'ssl_min_protocol'], capture_output=True, text=True).stdout.strip() if shutil.which('doveconf') else ''
    checks += tls_findings(_postconf('smtpd_tls_protocols'), nginx, dovecot)
    checks += cipher_findings({name: _postconf(name) for name in ('smtpd_tls_ciphers', 'smtpd_tls_mandatory_ciphers', 'smtp_tls_ciphers',
                                                                  'smtp_tls_mandatory_ciphers')})
    checks += protocol_syntax_findings({name: _postconf(name) for name in TLS_PARAMETERS}, _postconf('mail_version'))
    checks += pam_findings(_pam_on(), _submission_active())
    checks += relay_findings(_postconf('smtpd_relay_restrictions') + ' ' + _postconf('smtpd_recipient_restrictions'), _postconf('mynetworks'))
    checks += mode_findings(sorted(glob.glob(ETC + '/eFa/*.json')) + [ETC + '/eFa/MySQL-Config', WEB_DIR + '/admin.pw', WEB_DIR + '/maillog.pw'])
    try:
        checks += certificate_findings(_certificate_end())
    except (OSError, ValueError):
        pass
    update = _update_state()
    if update.get('security') and _update_available(update) and update.get('first_seen') and \
            datetime.date.today() - datetime.date.fromisoformat(update['first_seen']) > datetime.timedelta(days=7):
        checks.append(finding('problem', f"eFa security update {update['latest']} waits for more than 7 days", f"available since {update['first_seen']}",
                              'Maintenance & update: Install the eFa update now.'))
    level = max((LEVELS.index(item['level']) for item in checks), default=0)
    result = {'checked': time.strftime('%Y-%m-%d %H:%M:%S'), 'level': LEVELS[level], 'findings': sorted(checks, key=lambda item: -LEVELS.index(item['level'])),
              'excluded_not_part_of_efa_next': excluded}
    previous = _json_read(SECURITY_FILE, {})
    _json_write(SECURITY_FILE, result)
    new = {item['title'] for item in checks if item['level'] == 'problem'} - {item['title'] for item in previous.get('findings', []) if item['level'] == 'problem'}
    if new:
        _event('security_findings', 'warning', problems=len(new))
        _admin_notify('eFa: security self check found problems', '\n'.join(f"- {item['title']}: {item['detail']} -> {item['fix']}"
                                                                          for item in checks if item['title'] in new))
    return result


# Hardening report (Q5): the state of this host against the CIS benchmark for AlmaLinux 9 (system part) and BSI TR-03108
# (secure mail transport). Own short texts; the references name the topic, the documents themselves are not copied.
SYSCTL_WANTED = {'net.ipv4.ip_forward': '0', 'net.ipv4.conf.all.accept_redirects': '0', 'net.ipv4.conf.all.send_redirects': '0',
                 'net.ipv4.tcp_syncookies': '1', 'kernel.randomize_va_space': '2', 'fs.suid_dumpable': '0'}


def _tls12(value):
    """Whether a Postfix protocol list leaves out everything below TLS 1.2."""
    items = value.replace(',', ' ').split()
    return '>=TLSv1.2' in items or {'!SSLv2', '!SSLv3', '!TLSv1', '!TLSv1.1'} <= set(items)


TLS_PARAMETERS = ('smtpd_tls_protocols', 'smtpd_tls_mandatory_protocols', 'smtp_tls_protocols', 'smtp_tls_mandatory_protocols')
TLS_MIN_OLD = '!SSLv2, !SSLv3'
# Postfix 3.5 (EL9) knows no ">=TLSv1.2"; the list of exclusions works with every version.
TLS_MIN_NEW = '!SSLv2, !SSLv3, !TLSv1, !TLSv1.1'
KERNEL_SETTINGS = {'net.ipv4.conf.all.accept_redirects': '0', 'net.ipv4.conf.default.accept_redirects': '0',
                   'net.ipv6.conf.all.accept_redirects': '0', 'net.ipv4.conf.all.send_redirects': '0',
                   'net.ipv4.conf.default.send_redirects': '0', 'fs.suid_dumpable': '0'}


def tls_min_set(args):
    """TLS 1.2 or newer for all SMTP (BSI TR-03108). Back to TLS 1.0 is no longer offered (5t, docs/tls-profiles.md)."""
    on = _on_off(args.mode)
    if not on:
        raise EfaError('TLS 1.0 and 1.1 are no longer offered by eFa-next: see Security, TLS profile.')
    for name in TLS_PARAMETERS:
        _postconf_set(name, TLS_MIN_NEW if on else TLS_MIN_OLD)
    return {name: _postconf(name) for name in TLS_PARAMETERS}


# 5t: TLS profiles. Each one stays inside the lower limit of docs/tls-profiles.md (TLS 1.2+, ECDHE, AEAD); a custom list is
# checked against it with openssl. The profile sets nginx (443) and Postfix (25, 587/465, outgoing); the cluster (8460) and
# the provisioning API (8463) have the limit in their code. The crypto policy of the system stays as it is.
TLS_PROFILE_FILE = ETC + '/eFa/tls-profile.json'
TLS_RAISED = '/var/lib/eFa/tls-raised'
TLS_CURVES = ('X25519', 'prime256v1', 'secp384r1')
TLS_PROFILES = {
    'bsi': {'title': 'BSI TR-02102-2 (default)', 'protocols': ('TLSv1.2', 'TLSv1.3'),
            'ciphers': 'ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256'},
    'rfc9325': {'title': 'RFC 9325 (BCP 195)', 'protocols': ('TLSv1.2', 'TLSv1.3'),
                'ciphers': 'ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:'
                           'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256'},
    # TLS 1.3 only for the web and for logins (587/465); port 25 and outgoing mail keep TLS 1.2, or old servers send in clear text.
    'mozilla-modern': {'title': 'Mozilla modern (TLS 1.3 only for web and logins)', 'protocols': ('TLSv1.3',),
                       'ciphers': 'ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:'
                                  'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256'},
}
TLS_EXCLUDE = {'TLSv1.2': '!SSLv2, !SSLv3, !TLSv1, !TLSv1.1', 'TLSv1.3': '!SSLv2, !SSLv3, !TLSv1, !TLSv1.1, !TLSv1.2'}


def tls_cipher_problem(openssl_lines):
    """None when every cipher of `openssl ciphers -v` lies inside the limit: TLS 1.2/1.3, ECDHE (or TLS 1.3), AEAD."""
    if not openssl_lines:
        return 'The list names no cipher openssl knows.'
    for line in openssl_lines:
        parts = line.split()
        fields = dict(item.split('=', 1) for item in parts if '=' in item)
        if parts[1:2] not in (['TLSv1.2'], ['TLSv1.3']) or fields.get('Kx') not in ('ECDH', 'any') or fields.get('Mac') != 'AEAD' or \
                not re.search(r'GCM|CHACHA20', fields.get('Enc', '')):
            return f'{parts[0]} is outside the limit (TLS 1.2+, ECDHE, AES-GCM or ChaCha20-Poly1305).'
    return None


def tls_profile_state():
    return {'profile': 'bsi', 'custom': '', **_json_read(TLS_PROFILE_FILE, {})}


def tls_wanted(state):
    """(nginx protocols, cipher list, Postfix protocols for 25 and outgoing, for 587/465) of a profile."""
    profile = TLS_PROFILES.get(state['profile'], TLS_PROFILES['bsi'])
    ciphers = state['custom'] if state['profile'] == 'custom' else profile['ciphers']
    protocols = ('TLSv1.2', 'TLSv1.3') if state['profile'] == 'custom' else profile['protocols']
    return ' '.join(protocols), ciphers, TLS_EXCLUDE['TLSv1.2'], TLS_EXCLUDE[protocols[0]]


def _tls_postfix(state):
    _protocols, ciphers, opportunistic, mandatory = tls_wanted(state)
    values = {'smtpd_tls_protocols': opportunistic, 'smtp_tls_protocols': opportunistic, 'smtp_tls_mandatory_protocols': opportunistic,
              'smtpd_tls_mandatory_protocols': mandatory, 'smtpd_tls_ciphers': 'high', 'smtpd_tls_mandatory_ciphers': 'high',
              'smtp_tls_ciphers': 'high', 'smtp_tls_mandatory_ciphers': 'high', 'tls_high_cipherlist': ciphers,
              'tls_preempt_cipherlist': 'yes', 'tls_eecdh_auto_curves': ' '.join(TLS_CURVES)}
    changed = {name: value for name, value in values.items() if _postconf(name) != value}
    if not changed:
        return []
    main_cf = _postconf('config_directory') + '/main.cf'
    backup = main_cf + '.efactl-tls'
    shutil.copy2(main_cf, backup)
    try:
        subprocess.run(['postconf', '-e'] + [f'{name} = {value}' for name, value in changed.items()], check=True, capture_output=True)
        done = subprocess.run(['postfix', 'check'], capture_output=True, text=True)
        if done.returncode != 0:
            shutil.copy2(backup, main_cf)
            raise EfaError(f'postfix check failed, nothing changed: {done.stderr.strip()[:300]}')
    finally:
        os.remove(backup)
    subprocess.run(['postfix', 'reload'], check=False, capture_output=True)
    return sorted(changed)


def tls_profile_status(_args):
    """The TLS profile and what it sets: web (443) and mail (25, 587/465, outgoing)."""
    state = tls_profile_state()
    protocols, ciphers, opportunistic, mandatory = tls_wanted(state)
    raised = os.path.exists(TLS_RAISED) and time.time() - os.stat(TLS_RAISED).st_mtime < 7 * 86400
    return {'profile': state['profile'], 'profiles': {name: item['title'] for name, item in TLS_PROFILES.items()} | {'custom': 'Custom, checked'},
            'web_protocols': protocols, 'ciphers': ciphers.split(':'), 'curves': list(TLS_CURVES),
            'smtp_25_and_out': opportunistic, 'smtp_587_465': mandatory, 'in_effect': {name: _postconf(name) for name in TLS_PARAMETERS},
            'warnings': ['TLS was raised to the profile BSI TR-02102-2 by the update: no TLS 1.0/1.1, no CBC or SHA-1 ciphers. '
                         'An old server without a fitting cipher delivers to port 25 without encryption.'] if raised else []}


def tls_profile_set(args):
    """A TLS profile for the web interface and for mail. Everything stays inside the limit; nginx and Postfix check their
    settings before they load them, a refused one is taken back."""
    name = (args.profile or '').strip()
    if name not in (*TLS_PROFILES, 'custom'):
        raise EfaError('Profile: bsi, rfc9325, mozilla-modern or custom.')
    custom = (args.ciphers or '').strip()
    if name == 'custom':
        if not re.fullmatch(r'[A-Za-z0-9:+_-]{1,1000}', custom):
            raise EfaError('Ciphers: an OpenSSL list, separated by colons.')
        done = subprocess.run(['openssl', 'ciphers', '-v', '-tls1_2', custom], capture_output=True, text=True)
        problem = tls_cipher_problem(done.stdout.splitlines() if done.returncode == 0 else [])
        if problem:
            raise EfaError(problem)
    previous = tls_profile_state()
    state = {'profile': name, 'custom': custom if name == 'custom' else ''}
    _json_write(TLS_PROFILE_FILE, state)
    try:
        changed = _tls_postfix(state)
        _nginx_apply()
    except (EfaError, OSError, subprocess.CalledProcessError):
        _json_write(TLS_PROFILE_FILE, previous)
        _tls_postfix(previous)
        raise
    _audit(f'TLS profile {name} set by {_dmarc_who()}')
    return {**tls_profile_status(None), 'postfix_changed': changed}


def tls_profile_upgrade(_args):
    """Package update: every eFa-next keeps the limit. Without a profile yet, BSI is set and the dashboard says so once."""
    if os.path.exists(TLS_PROFILE_FILE):
        state = tls_profile_state()
    else:
        state = {'profile': 'bsi', 'custom': ''}
        _json_write(TLS_PROFILE_FILE, state)
    changed = _tls_postfix(state)
    if changed:
        _write(TLS_RAISED, ' '.join(changed) + '\n')
    return {'profile': state['profile'], 'postfix_changed': changed}


# 5t-b: SSH after BSI TR-02102-4. The hardening report checks what sshd offers; ssh-profile-set writes a drop-in that comes
# before the crypto policy of the system (sshd keeps the first value) and takes itself back after 10 minutes unless confirmed.
SSH_BSI_FILE = ETC + '/ssh/sshd_config.d/40-efa-bsi.conf'
SSH_BSI = {'kexalgorithms': ('curve25519-sha256', 'curve25519-sha256@libssh.org', 'ecdh-sha2-nistp256', 'ecdh-sha2-nistp384',
                             'sntrup761x25519-sha512', 'sntrup761x25519-sha512@openssh.com', 'mlkem768x25519-sha256'),
           'ciphers': ('aes256-gcm@openssh.com', 'aes128-gcm@openssh.com', 'chacha20-poly1305@openssh.com'),
           'macs': ('hmac-sha2-512-etm@openssh.com', 'hmac-sha2-256-etm@openssh.com'),
           'hostkeyalgorithms': ('ssh-ed25519', 'ecdsa-sha2-nistp256', 'ecdsa-sha2-nistp384', 'rsa-sha2-512', 'rsa-sha2-256',
                                 'ssh-ed25519-cert-v01@openssh.com', 'ecdsa-sha2-nistp256-cert-v01@openssh.com',
                                 'ecdsa-sha2-nistp384-cert-v01@openssh.com', 'rsa-sha2-512-cert-v01@openssh.com',
                                 'rsa-sha2-256-cert-v01@openssh.com')}
SSH_REVERT_MINUTES = 10


def ssh_crypto_problems(sshd):
    """What sshd -T offers outside BSI TR-02102-4: SHA-1, CBC, MACs without encrypt-then-MAC, ssh-rsa and DSA host keys."""
    found = []
    for key, allowed in SSH_BSI.items():
        offered = [item for item in sshd.get(key, '').split(',') if item]
        extra = [item for item in offered if item not in allowed]
        if extra:
            found.append(f"{key}: {', '.join(extra)}")
    return found


def ssh_profile_text(offered_kex):
    """The drop-in: only what this sshd knows (ssh -Q), so sshd -t passes on every version."""
    lines = ['# Written by efactl ssh-profile-set (BSI TR-02102-4). efactl ssh-profile-set --mode system removes it.']
    for key, name in (('kexalgorithms', 'KexAlgorithms'), ('ciphers', 'Ciphers'), ('macs', 'MACs'), ('hostkeyalgorithms', 'HostKeyAlgorithms')):
        wanted = [item for item in SSH_BSI[key] if key != 'kexalgorithms' or item in offered_kex]
        lines.append(f"{name} {','.join(wanted)}")
    return '\n'.join(lines) + '\n'


def ssh_profile_status(_args):
    sshd = dict(line.split(None, 1) for line in subprocess.run(['sshd', '-T'], capture_output=True, text=True).stdout.splitlines() if ' ' in line)
    return {'profile': 'bsi' if os.path.exists(SSH_BSI_FILE) else 'system', 'problems': ssh_crypto_problems(sshd),
            'kexalgorithms': sshd.get('kexalgorithms', '').split(','), 'ciphers': sshd.get('ciphers', '').split(','),
            'macs': sshd.get('macs', '').split(','), 'confirmed': os.path.exists(SSH_BSI_FILE) and not os.path.exists(SSH_BSI_FILE + '.pending')}


def ssh_profile_set(args):
    """bsi: SSH after BSI TR-02102-4, back to the system setting after 10 minutes unless ssh-profile-confirm follows from a new
    login; system: the crypto policy of the operating system again. Running sessions stay, sshd checks the file first."""
    mode = (args.mode or '').strip()
    if mode not in ('bsi', 'system'):
        raise EfaError('Mode: bsi or system.')
    old = open(SSH_BSI_FILE).read() if os.path.exists(SSH_BSI_FILE) else None
    if mode == 'system':
        for path in (SSH_BSI_FILE, SSH_BSI_FILE + '.pending'):
            if os.path.exists(path):
                os.remove(path)
        _platform().service_stop('efa-ssh-revert.timer')
    else:
        offered = subprocess.run(['ssh', '-Q', 'kex'], capture_output=True, text=True).stdout.split()
        _write(SSH_BSI_FILE, ssh_profile_text(offered))
        os.chmod(SSH_BSI_FILE, 0o600)
        _write(SSH_BSI_FILE + '.pending', time.strftime('%Y-%m-%d %H:%M:%S\n'))
    try:
        _sshd_apply()
    except EfaError:
        if old is None:
            os.remove(SSH_BSI_FILE)
        else:
            _write(SSH_BSI_FILE, old)
        raise
    if mode == 'bsi':
        _platform().run_later('efa-ssh-revert', SSH_REVERT_MINUTES * 60, ['/usr/sbin/efactl', 'ssh-profile-revert'])
    _audit(f'SSH profile {mode} set by {_dmarc_who()}')
    return {**ssh_profile_status(None), 'note': f'Log in again over SSH in a new window, then confirm within {SSH_REVERT_MINUTES} minutes '
                                                '(efactl ssh-profile-confirm); otherwise the setting goes back by itself.' if mode == 'bsi' else ''}


def ssh_profile_confirm(_args):
    if not os.path.exists(SSH_BSI_FILE + '.pending'):
        raise EfaError('Nothing to confirm.')
    os.remove(SSH_BSI_FILE + '.pending')
    _platform().service_stop('efa-ssh-revert.timer')
    _audit(f'SSH profile bsi confirmed by {_dmarc_who()}')
    return ssh_profile_status(None)


def ssh_profile_revert(_args):
    """The job of ssh-profile-set: back to the system setting when the BSI profile was not confirmed."""
    if os.path.exists(SSH_BSI_FILE + '.pending'):
        return ssh_profile_set(argparse.Namespace(mode='system'))
    return ssh_profile_status(None)


def cert_key(path):
    """(algorithm, bits) of the key of a certificate file: ('rsa', 2048), ('ec', 256), or None."""
    done = subprocess.run(['openssl', 'x509', '-in', path, '-noout', '-text'], capture_output=True, text=True)
    bits = re.search(r'Public-Key: \((\d+) bit\)', done.stdout)
    if done.returncode != 0 or not bits:
        return None
    return ('ec' if 'id-ecPublicKey' in done.stdout else 'ed25519' if 'ED25519' in done.stdout else 'rsa', int(bits.group(1)))


def key_ok(found):
    """BSI TR-02102-1: RSA from 3000 bits, ECC from 250 bits (P-256, P-384, Ed25519)."""
    return found is not None and (found[1] >= 3000 if found[0] == 'rsa' else found[1] >= 250)


def pqc_available():
    """(available, OpenSSL version): whether this OpenSSL offers the hybrid group X25519MLKEM768."""
    version = subprocess.run(['openssl', 'version'], capture_output=True, text=True).stdout.split()[:2]
    groups = subprocess.run(['openssl', 'list', '-tls-groups'], capture_output=True, text=True)
    return 'X25519MLKEM768' in groups.stdout, ' '.join(version)


def web_curves():
    """The groups of nginx: the hybrid X25519MLKEM768 first where OpenSSL has it (3.5 on EL9), then the classic ones. Postfix 3.5
    does not know the name, so mail keeps the classic groups."""
    return (('X25519MLKEM768',) if pqc_available()[0] else ()) + TLS_CURVES


def kernel_hardening_set(args):
    """The kernel settings of the hardening report for every boot: no ICMP redirects, no core dumps of SUID programs."""
    on = _on_off(args.mode)
    try:
        _platform().kernel_settings(KERNEL_SETTINGS if on else None)
    except Exception as err:  # the StepError of the platform layer
        raise EfaError(str(err))
    return {'kernel_hardening': on, 'note': '' if on else 'The system defaults apply from the next boot.'}


def hardening_checks(f):
    """The checks from the gathered facts: (reference, title, passed or None for not applicable, detail, fix)."""
    ssh = f['sshd']
    checks = [
        ('CIS AlmaLinux 9: mandatory access control', 'SELinux enforces', f['selinux'] == 'Enforcing', f['selinux'], 'setenforce 1, SELINUX=enforcing'),
        ('CIS AlmaLinux 9: host firewall', 'The firewall runs', f['firewall'], '', 'Security: Firewall guard.'),
        ('CIS AlmaLinux 9: logging and auditing', 'auditd runs', f['auditd'], '', 'Enable and start the service auditd.'),
        ('CIS AlmaLinux 9: time synchronisation', 'chronyd runs', f['time'], '', 'Enable and start the time service (chronyd).'),
        ('CIS AlmaLinux 9: software updates', 'Operating system updates are installed automatically', f['os_updates'], f['os_updates_detail'],
         'Maintenance & update: Update system.'),
        ('CIS AlmaLinux 9: SSH server', 'Root cannot log in with a password', ssh.get('permitrootlogin') in ('no', 'prohibit-password', 'without-password'),
         f"PermitRootLogin {ssh.get('permitrootlogin', '?')}", 'Security: Root login through SSH.'),
        ('CIS AlmaLinux 9: SSH server', 'No empty passwords over SSH', ssh.get('permitemptypasswords') == 'no', '', 'PermitEmptyPasswords no'),
        ('CIS AlmaLinux 9: SSH server', 'No X11 forwarding', ssh.get('x11forwarding') == 'no', f"X11Forwarding {ssh.get('x11forwarding', '?')}", 'X11Forwarding no'),
        ('CIS AlmaLinux 9: SSH server', 'At most 4 login attempts per connection', ssh.get('maxauthtries', '6').isdigit() and int(ssh.get('maxauthtries', '6')) <= 4,
         f"MaxAuthTries {ssh.get('maxauthtries', '?')}", 'MaxAuthTries 4'),
        ('CIS AlmaLinux 9: user accounts', 'Passwords are stored with SHA-512 or yescrypt', f['encrypt_method'] in ('SHA512', 'YESCRYPT'),
         f"ENCRYPT_METHOD {f['encrypt_method'] or '?'}", 'ENCRYPT_METHOD SHA512 in /etc/login.defs'),
        ('CIS AlmaLinux 9: file permissions', '/etc/shadow is readable by root only', f['shadow_mode'] is not None and not f['shadow_mode'] & 0o077,
         oct(f['shadow_mode'] or 0), 'chmod 0000 /etc/shadow'),
    ]
    for name, wanted in SYSCTL_WANTED.items():
        fix = 'efactl kernel-hardening-set --mode on' if name in KERNEL_SETTINGS else f'sysctl -w {name}={wanted} and a file in /etc/sysctl.d'
        checks.append(('CIS AlmaLinux 9: kernel network and memory settings', f'{name} = {wanted}', f['sysctl'].get(name) == wanted,
                       f"now {f['sysctl'].get(name, '?')}", fix))
    pf = f['postconf']
    checks += [
        ('BSI TR-03108: TLS versions', 'Incoming SMTP offers TLS 1.2 or newer only', _tls12(pf['smtpd_tls_protocols']), pf['smtpd_tls_protocols'],
         'efactl tls-min-set --mode on (a very old server then sends unencrypted)'),
        ('BSI TR-03108: TLS versions', 'Port 587 requires TLS 1.2 or newer', _tls12(pf['smtpd_tls_mandatory_protocols']), pf['smtpd_tls_mandatory_protocols'],
         'efactl tls-min-set --mode on (a very old server then sends unencrypted)'),
        ('BSI TR-03108: TLS versions', 'Outgoing SMTP uses TLS 1.2 or newer only', _tls12(pf['smtp_tls_protocols']), pf['smtp_tls_protocols'],
         'efactl tls-min-set --mode on (a very old server then sends unencrypted)'),
        ('BSI TR-03108: cipher suites', 'Cipher settings are valid grades', not f['cipher_problems'], '; '.join(f['cipher_problems']),
         'Security self check: cipher finding.'),
        ('BSI TR-03108: authentication', 'SMTP-AUTH only over TLS', pf['smtpd_tls_auth_only'] == 'yes', pf['smtpd_tls_auth_only'], 'postconf smtpd_tls_auth_only=yes'),
        ('BSI TR-02102-1: key lengths', 'Certificate of web and mail: RSA from 3000 bits or ECC (P-256, P-384)',
         key_ok(f.get('cert_key')) if f.get('cert_key') else None, '%s %s bits' % f['cert_key'] if f.get('cert_key') else 'no certificate',
         'efactl letsencrypt-set (ECDSA P-256), or a certificate with RSA 3072 or ECC'),
        ('BSI TR-02102-1: key lengths', 'SSH host key RSA from 3000 bits', None if f.get('ssh_rsa_bits') is None else f['ssh_rsa_bits'] >= 3000,
         f"RSA {f.get('ssh_rsa_bits')} bits" if f.get('ssh_rsa_bits') else 'no RSA host key',
         'ssh-keygen -t rsa -b 3072 -f /etc/ssh/ssh_host_rsa_key (clients then see a new host key), or Ed25519 only'),
        ('BSI TR-02102-1: key lengths', 'DKIM RSA keys from 3000 bits (Ed25519 next to them)',
         None if not f.get('dkim_rsa_bits') else all(bits >= 3000 for bits in f['dkim_rsa_bits']),
         f"{sum(1 for bits in f.get('dkim_rsa_bits') or [] if bits < 3000)} of {len(f.get('dkim_rsa_bits') or [])} RSA keys below 3000 bits",
         'DKIM: new keys with RSA 3072 and Ed25519 (the TXT record gets longer, check that your DNS takes it)'),
        ('BSI TR-02102-4: SSH', 'SSH offers only BSI key exchange, ciphers, MACs and host key algorithms', not ssh_crypto_problems(ssh),
         '; '.join(ssh_crypto_problems(ssh))[:300], 'efactl ssh-profile-set --mode bsi (goes back by itself unless confirmed)'),
        ('CIS AlmaLinux 9: network configuration', 'No interface with a profile the network service made by itself (DHCP from any network)',
         None if f.get('auto_profiles') is None else not f['auto_profiles'], ', '.join(f.get('auto_profiles') or []),
         'Give the interface a role (Network, More interfaces) or remove the profile: nmcli connection delete "<name>"'),
        ('BSI TR-02102-2: post-quantum', 'Hybrid key exchange X25519MLKEM768 offered', True if f.get('pqc') else None,
         f"available ({f.get('openssl', '')})" if f.get('pqc') else f"not available on this platform ({f.get('openssl', 'OpenSSL')}), planned for EL10/FreeBSD",
         ''),
        ('BSI TR-03108: authentication', 'Port 587 does not take system accounts', not f['pam_587'], '', 'efactl submission-pam-set --mode off'),
        ('BSI TR-03108: DNSSEC', 'The own resolver validates DNSSEC', f['dnssec'], '', 'Unbound with a trust anchor (eFa default).'),
        ('BSI TR-03108: DANE', 'Outgoing mail uses DANE', f['dane'], '', 'efactl dane-set --mode on'),
        ('BSI TR-03108: MTA-STS', 'Own domains publish MTA-STS', f['mta_sts'] if f['domains'] else None, f"{f['mta_sts_count']} of {f['domains']} domains",
         'Protection: MTA-STS.'),
        ('BSI TR-03108: reporting', 'TLS reports (TLS-RPT) are read', f['tls_rpt'], '', 'efactl reports-in-set'),
        ('BSI TR-03108: certificates', 'The server certificate is valid for more than 14 days', f['certificate_ok'], f['certificate_detail'],
         'Network: Let\'s Encrypt.'),
        ('BSI TR-03108: TLS versions', 'The web interface offers TLS 1.2 or newer only', f['nginx_tls12'], '', 'ssl_protocols TLSv1.2 TLSv1.3;'),
    ]
    return [{'reference': ref, 'title': title, 'result': 'n/a' if ok is None else 'pass' if ok else 'fail', 'detail': detail, 'fix': '' if ok else fix}
            for ref, title, ok, detail, fix in checks]


def _hardening_facts():
    platform_now = _platform()

    def active(name):
        try:
            return platform_now.service_is_active(name)
        except Exception:  # a unit the platform does not know
            return False
    sysctl = {}
    for name in SYSCTL_WANTED:
        done = subprocess.run(['sysctl', '-n', name], capture_output=True, text=True)
        if done.returncode == 0:
            sysctl[name] = done.stdout.strip()
    login_defs = dict(line.split(None, 1) for line in _read_lines('/etc/login.defs') if not line.startswith('#') and ' ' in line.replace('\t', ' '))
    try:
        shadow_mode = os.stat('/etc/shadow').st_mode & 0o777
    except OSError:
        shadow_mode = None
    names = ('smtpd_tls_protocols', 'smtpd_tls_mandatory_protocols', 'smtp_tls_protocols', 'smtpd_tls_auth_only',
             'smtpd_tls_ciphers', 'smtpd_tls_mandatory_ciphers', 'smtp_tls_ciphers', 'smtp_tls_mandatory_ciphers')
    postconf = {name: _postconf(name) for name in names}
    nginx = open('/etc/nginx/conf.d/efa.conf').read() if os.path.exists('/etc/nginx/conf.d/efa.conf') else ''
    try:
        end = _certificate_end()
        certificate = certificate_findings(end)
        certificate_ok, certificate_detail = not certificate, str(end)
    except (OSError, ValueError) as err:
        certificate_ok, certificate_detail = False, str(err)[:100]
    mta = _json_read(MTA_STS_FILE, {})
    cert_path = _platform().path('cert_file') if hasattr(_platform(), 'path') else '/etc/pki/tls/certs/efa.crt'
    rsa_dkim = [bits for bits in (_key_bits(key['path']) for key in _dkim_keys() if key['state'] == 'active' and key['public']
                                  and key['public'][0] == 'rsa') if bits]
    host_rsa = subprocess.run(['ssh-keygen', '-lf', ETC + '/ssh/ssh_host_rsa_key.pub'], capture_output=True, text=True).stdout.split()[:1]
    pqc, openssl_version = pqc_available()
    try:
        auto = [f"{item['name']} ({item['device'] or 'no device'})" for item in _platform().auto_profiles()]
    except (NotImplementedError, AttributeError):
        auto = None
    try:
        os_updates = 'enabled' if platform_now.service_is_enabled('dnf-automatic.timer') else 'not enabled'
    except Exception:  # the StepError of the platform layer
        os_updates = 'unknown'
    return {'selinux': subprocess.run(['getenforce'], capture_output=True, text=True).stdout.strip() or 'unknown',
            'firewall': active(platform_now.service('firewall')), 'auditd': active('auditd'), 'time': active(platform_now.service('time')),
            'os_updates': os_updates == 'enabled', 'os_updates_detail': f'dnf-automatic.timer {os_updates or "missing"}',
            'sshd': dict(line.split(None, 1) for line in subprocess.run(['sshd', '-T'], capture_output=True, text=True).stdout.splitlines() if ' ' in line),
            'encrypt_method': login_defs.get('ENCRYPT_METHOD', '').strip(), 'shadow_mode': shadow_mode, 'sysctl': sysctl, 'postconf': postconf,
            'cipher_problems': [item['detail'] for item in cipher_findings({name: postconf[name] for name in names if 'ciphers' in name})],
            'pam_587': bool(pam_findings(_pam_on(), _submission_active())), 'dnssec': _resolver_validates(),
            'dane': _postconf('smtp_tls_security_level') == 'dane', 'domains': len(_local_domains()), 'mta_sts': bool(mta),
            'mta_sts_count': len(mta), 'tls_rpt': bool(_json_read(REPORTS_FILE_IN, {}).get('enabled')),
            'certificate_ok': certificate_ok, 'certificate_detail': certificate_detail,
            'cert_key': cert_key(cert_path) if os.path.exists(cert_path) else None, 'dkim_rsa_bits': rsa_dkim,
            'ssh_rsa_bits': int(host_rsa[0]) if host_rsa and host_rsa[0].isdigit() else None, 'pqc': pqc, 'openssl': openssl_version, 'auto_profiles': auto,
            'nginx_tls12': not any('nginx' in item['title'] for item in tls_findings('>=TLSv1.2', nginx, ''))}


def hardening_markdown(checks, version):
    lines = [f'# Hardening report eFa-next {version}', '',
             'Own checks against the CIS benchmark for AlmaLinux 9 (system part) and BSI TR-03108 (secure mail transport). '
             'The references name the topic; this is no certification.', '',
             '| Result | Reference | Check | Now | Fix |', '| --- | --- | --- | --- | --- |']
    for item in checks:
        cells = [item['result'].upper(), item['reference'], item['title'], item['detail'], item['fix']]
        lines.append('| ' + ' | '.join(str(cell).replace('|', '/') for cell in cells) + ' |')
    counts = {result: sum(1 for item in checks if item['result'] == result) for result in ('pass', 'fail', 'n/a')}
    lines += ['', f"{counts['pass']} passed, {counts['fail']} failed, {counts['n/a']} not applicable."]
    return '\n'.join(lines) + '\n'


HARDENING_STATUS = {'pass': 'ok', 'fail': 'error', 'n/a': 'na'}


def hardening_pdf(checks, version, host, when, mode='single'):
    """Q5b: the report as PDF for audits, from the same checks as the table: the failed ones first. Only results, no secrets."""
    version = re.sub(r'^eFa-', '', version or '')
    counts = {result: sum(1 for item in checks if item['result'] == result) for result in ('pass', 'fail', 'n/a')}
    order = sorted(checks, key=lambda item: ({'fail': 0, 'n/a': 2}.get(item['result'], 1), item['reference']))
    rows = [(item['reference'], item['title'], item['result'].upper(),
             item['detail'] + (f" Fix: {item['fix']}" if item['fix'] and item['result'] == 'fail' else ''), HARDENING_STATUS.get(item['result'], 'na'))
            for item in order]
    blocks = [('h', f'Hardening report {host}'),
              ('p', f'Date: {when}. Host: {host}. eFa-next {version}. Mode: {mode}.'),
              ('p', f"Result: {counts['pass']} passed, {counts['fail']} failed, {counts['n/a']} not applicable."),
              ('p', 'Own checks against the CIS benchmark for AlmaLinux 9 (system part) and BSI TR-03108 (secure mail transport). '
                    'The references name the topic; this is no certification.'),
              ('table', [('Reference', 120), ('Check', 150), ('Result', 45), ('Now / fix', 180)], rows)]
    return _lib('efa_pdf').report(f'eFa-next hardening report {host}', blocks, footer=f'eFa-next {version} - {when}',
                                  info={'Title': f'Hardening report {host}', 'Producer': 'eFa-next', 'Creator': 'eFa-next',
                                        'CreationDate': 'D:' + re.sub(r'\D', '', when)})


def hardening_report(args):
    """The hardening of this host against CIS AlmaLinux 9 and BSI TR-03108; as JSON, Markdown for the release, or PDF
    (--format pdf for the web, --pdf FILE or --pdf - on the command line)."""
    checks = hardening_checks(_hardening_facts())
    version = _update_installed()
    if (getattr(args, 'format', '') or '').strip() == 'markdown':
        return {'markdown': hardening_markdown(checks, version)}
    target = (getattr(args, 'pdf', '') or '').strip()
    if (getattr(args, 'format', '') or '').strip() == 'pdf' or target:
        host, now = socket.getfqdn(), time.localtime()
        pdf = hardening_pdf(checks, version, host, time.strftime('%Y-%m-%d %H:%M:%S', now), cluster_mode() or 'single')
        name = f"efa-hardening-{re.sub(r'[^A-Za-z0-9.-]', '_', host)}-{time.strftime('%Y%m%d-%H%M', now)}.pdf"
        if target == '-':
            sys.stdout.buffer.write(pdf)
            return None
        if target:
            # Command line only (the web has no such argument).
            _write_bytes(target, pdf)
            return {'file': target, 'bytes': len(pdf)}
        return {'pdf': base64.b64encode(pdf).decode(), 'name': name}
    return {'version': version, 'passed': sum(1 for item in checks if item['result'] == 'pass'),
            'failed': sum(1 for item in checks if item['result'] == 'fail'), 'checks': checks}


def switches_status(_args):
    """The switches whose state no other status shows, so their forms show what is set now."""
    security = _json_read(SECURITY_SETTINGS, {})
    queue = {**QUEUE_DEFAULTS, **_json_read(QUEUE_FILE, {})}
    reports = _json_read(REPORTS_FILE_IN, {})
    try:
        kernel = _platform().kernel_settings_active()
    except NotImplementedError:
        kernel = None
    milters = [item.rsplit(':', 1)[-1] for item in _postconf('smtpd_milters').replace(',', ' ').split() if item.startswith('inet:')]
    return {'tls_min': all(_tls12(_postconf(name)) for name in TLS_PARAMETERS), 'kernel_hardening': kernel,
            'pwned': bool(security.get('pwned')), 'oval': bool(security.get('oval')), 'submission_pam': _pam_on(),
            'alarm_size': queue['alarm_size'], 'alarm_hours': queue['alarm_hours'], 'reports_in': bool(reports.get('enabled')),
            'reports_in_address': reports.get('address', ''), 'milter_ports': ' '.join(milters)}


def form_check(_args):
    """For CI on an installed host: every form takes its values from a read command that has them, and a pulldown gets one of its choices."""
    nav = _lib('efa_nav')
    problems, outputs = [], {}
    for name, (status, keys) in sorted(nav.FORM_SOURCE.items()):
        if status not in outputs:
            try:
                outputs[status] = COMMANDS[status]['func'](argparse.Namespace())
            except Exception as err:  # noqa: BLE001 - one broken status is a finding, the others go on
                outputs[status] = None
                problems.append(f'{status}: {err}')
        for arg in COMMANDS[name]['args']:
            key = keys.get(arg['name'])
            value = nav.form_value(outputs[status], key)
            if key and value is None and not key.startswith('?'):
                problems.append(f'{name} --{arg["name"]}: {status} has no {key}')
            options = [item['value'] for item in arg.get('choices', [])]
            if options and value not in (None, '') and value not in options:
                problems.append(f'{name} --{arg["name"]}: {value!r} is none of {options}')
    if problems:
        raise EfaError('Forms without their current value: ' + '; '.join(problems))
    return {'forms': len(nav.FORM_SOURCE), 'status_commands': len(outputs), 'ok': True}


def security_status(_args):
    """The last result of the security self check."""
    return {**_json_read(SECURITY_FILE, {'checked': None, 'level': 'not checked yet', 'findings': []}),
            'daily': _json_read(SECURITY_SETTINGS, {}).get('daily', False)}


# CVEs from the open OVAL data of the distribution (Q12): loaded only when switched on, once a day with ETag, offline with the
# last copy. Complements dnf updateinfo, which needs the repositories.
OVAL_FILE = '/var/lib/eFa/oval.xml.bz2'
OVAL_STATE = '/var/lib/eFa/oval.json'
OVAL_NS = '{http://oval.mitre.org/XMLSchema/oval-definitions-5}'
OVAL_LINUX = '{http://oval.mitre.org/XMLSchema/oval-definitions-5#linux}'


def oval_parse(stream):
    """The patch definitions of an OVAL file: [{'id', 'title', 'severity', 'cves', 'tests'}] and the package tests
    {test id: (package, (epoch, version, release))} for 'installed version less than fixed'. Read piece by piece, little memory."""
    from xml.etree.ElementTree import iterparse
    definitions, tests, objects, states = [], {}, {}, {}
    for _event, node in iterparse(stream):
        tag = node.tag
        if tag == OVAL_NS + 'definition':
            if node.get('class') == 'patch':
                meta = node.find(OVAL_NS + 'metadata')
                severity = meta.find(f'{OVAL_NS}advisory/{OVAL_NS}severity') if meta is not None else None
                definitions.append({'id': node.get('id'), 'title': (meta.findtext(OVAL_NS + 'title') or '')[:200] if meta is not None else '',
                                    'severity': (severity.text or '').strip() if severity is not None else '',
                                    'cves': sorted({ref.get('ref_id') for ref in node.iter(OVAL_NS + 'reference') if ref.get('source') == 'CVE'}),
                                    'tests': [item.get('test_ref') for item in node.iter(OVAL_NS + 'criterion')]})
            node.clear()
        elif tag == OVAL_LINUX + 'rpminfo_test':
            obj, state = node.find(OVAL_LINUX + 'object'), node.find(OVAL_LINUX + 'state')
            if obj is not None and state is not None:
                tests[node.get('id')] = (obj.get('object_ref'), state.get('state_ref'))
            node.clear()
        elif tag == OVAL_LINUX + 'rpminfo_object':
            objects[node.get('id')] = node.findtext(OVAL_LINUX + 'name') or ''
            node.clear()
        elif tag == OVAL_LINUX + 'rpminfo_state':
            evr = node.find(OVAL_LINUX + 'evr')
            if evr is not None and evr.get('operation') == 'less than' and evr.text:
                epoch, _, rest = evr.text.partition(':')
                version, _, release = rest.rpartition('-')
                states[node.get('id')] = (epoch, version, release)
            node.clear()
    package_tests = {test: (objects[obj], states[state]) for test, (obj, state) in tests.items() if obj in objects and state in states}
    return definitions, package_tests


def oval_same_stream(installed, fixed):
    """Whether a fix is for the stream that is installed: a module stream (mariadb:11.8) only for the same module stream, the
    normal package only for the normal package. The OVAL criteria name the module; this short form looks at the release."""
    module_have, module_fix = 'module' in installed[2], 'module' in fixed[2]
    if module_have != module_fix:
        return False
    return not module_have or installed[1].split('.')[:2] == fixed[1].split('.')[:2]


def oval_findings(definitions, package_tests, installed, older, exposed=()):
    """One finding per installed package that is older than the fix of a definition, with its CVEs."""
    per_package = {}
    for item in definitions:
        for test in item['tests']:
            if test not in package_tests:
                continue
            name, fixed = package_tests[test]
            versions = installed.get(name, [])
            # Several kernels stay installed side by side: only the newest one counts.
            newest = versions[0] if versions else None
            for have in versions[1:]:
                if older(newest, have):
                    newest = have
            if newest is not None and oval_same_stream(newest, fixed) and older(newest, fixed):
                entry = per_package.setdefault(name, {'cves': set(), 'severity': set(), 'advisories': set()})
                entry['cves'] |= set(item['cves'])
                entry['severity'].add(item['severity'])
                entry['advisories'].add(item['title'].split(':')[0])
    found = []
    for name, entry in sorted(per_package.items(), key=lambda pair: (pair[0] not in exposed, pair[0])):
        serious = bool(entry['severity'] & {'Critical', 'Important'})
        cves = sorted(entry['cves'])
        found.append(finding('problem' if serious and name in exposed else 'warning',
                             f'OVAL: {name} has known vulnerabilities' + (' (listens on the network)' if name in exposed else ''),
                             f"{', '.join(sorted(item for item in entry['severity'] if item))}: {', '.join(cves[:8])}" + (' ...' if len(cves) > 8 else ''),
                             'Maintenance & update: Update system.'))
    return found


def _oval_fetch():
    """Loads the OVAL file when it changed (ETag). Offline the last copy stays."""
    import urllib.request
    url = _platform().oval_source()
    if not url:
        return 'no OVAL data for this system'
    state = _json_read(OVAL_STATE, {})
    request = urllib.request.Request(url, headers={'User-Agent': 'eFa-next'})
    if state.get('etag') and os.path.exists(OVAL_FILE):
        request.add_header('If-None-Match', state['etag'])
    try:
        with urllib.request.urlopen(request, timeout=60) as answer:
            data = answer.read(64 * 1024 * 1024)
            etag = answer.headers.get('ETag', '')
    except urllib.error.HTTPError as err:
        return 'unchanged' if err.code == 304 else f'not loaded: HTTP {err.code}'
    except OSError as err:
        return f'not loaded, the last copy is used: {err}'
    _write_bytes(OVAL_FILE, data)
    _json_write(OVAL_STATE, {'etag': etag, 'loaded': time.strftime('%Y-%m-%d %H:%M'), 'url': url})
    return 'loaded'


def _write_bytes(path, data):
    with open(path + '.new', 'wb') as f:
        f.write(data)
    os.replace(path + '.new', path)


def oval_check(listening):
    """The OVAL findings of this host, when the OVAL check is on."""
    if not _json_read(SECURITY_SETTINGS, {}).get('oval'):
        return [], None
    status = _oval_fetch()
    if not os.path.exists(OVAL_FILE):
        return [finding('warning', 'OVAL data not loaded', status, 'Check the access to the OVAL source over HTTPS.')], status
    import bz2
    with bz2.open(OVAL_FILE) as stream:
        definitions, package_tests = oval_parse(stream)
    platform_now = _platform()
    exposed = {item['package'] for item in listening if item['package'] and item['address'] not in ('127.0.0.1', '::1')}
    return oval_findings(definitions, package_tests, platform_now.package_versions(), platform_now.version_older, exposed), status


def security_oval_set(args):
    """Also check the installed packages against the open OVAL data of the distribution (CVEs), loaded once a day. Off by default."""
    on = _on_off(args.mode)
    _json_write(SECURITY_SETTINGS, {**_json_read(SECURITY_SETTINGS, {}), 'oval': on})
    return {'oval_check': on, 'source': _platform().oval_source() or 'none for this system'}


def security_check_set(args):
    """Run the security self check every day. Off by default."""
    enabled = _on_off(args.mode)
    _json_write(SECURITY_SETTINGS, {**_json_read(SECURITY_SETTINGS, {}), 'daily': enabled})
    return security_status(None)


def password_problem(password, username=''):
    """Why a new password is weak, or None: short, all one character, the user name, or on the list that ships with eFa."""
    if len(password) < 12:
        return 'Password: at least 12 characters.'
    if len(set(password)) < 4:
        return 'Password: too few different characters.'
    if username and username.split('@')[0].lower() in password.lower():
        return 'Password: it contains the user name.'
    try:
        with open(COMMON_PASSWORDS, encoding='utf-8') as f:
            common = {line.strip().lower() for line in f if line.strip()}
    except OSError:
        common = set()
    # As typed, without trailing punctuation, and as the base word without trailing digits.
    if {password.lower(), re.sub(r'[!?.]+$', '', password.lower()), re.sub(r'[\d!?.]+$', '', password.lower())} & common:
        return 'Password: it is on the list of common passwords.'
    if _json_read(SECURITY_SETTINGS, {}).get('pwned') and pwned_count(password):
        return 'Password: it is in known data breaches (Have I Been Pwned).'
    return None


PWNED_URL = 'https://api.pwnedpasswords.com/range/'


def pwned_count(password, fetch=None):
    """How often a password is in known data breaches, by k-anonymity: only the first 5 characters of its SHA-1 leave this
    host. 0 when the service cannot be reached: then only the own checks count."""
    digest = hashlib.sha1(password.encode('utf-8')).hexdigest().upper()

    def online(prefix):
        import urllib.request
        request = urllib.request.Request(PWNED_URL + prefix, headers={'User-Agent': 'eFa-next', 'Add-Padding': 'true'})
        with urllib.request.urlopen(request, timeout=5) as answer:
            return answer.read().decode('ascii', 'replace')
    try:
        text = (fetch or online)(digest[:5])
    except OSError:
        return 0
    for line in text.splitlines():
        suffix, _, count = line.strip().partition(':')
        if suffix == digest[5:] and count.isdigit():
            return int(count)
    return 0


def pwned_check_set(args):
    """New passwords are also checked against known data breaches (Have I Been Pwned, k-anonymity). Off by default."""
    on = _on_off(args.mode)
    _json_write(SECURITY_SETTINGS, {**_json_read(SECURITY_SETTINGS, {}), 'pwned': on})
    return {'pwned_check': on, 'note': 'Only the first 5 characters of the SHA-1 of a new password go to api.pwnedpasswords.com.'}


INTERFACES_FILE = ETC + '/eFa/interfaces.json'
INTERFACE_ROLES = ('unused', 'uplink', 'internal', 'management')
INTERFACE_REVERT = 'efa-interface-revert'
# The firewall zone of each role, and what an internal or management network may reach.
ROLE_ZONES = {'uplink': 'public', 'internal': 'internal', 'management': 'internal', 'unused': 'drop'}
INTERNAL_SERVICES = ('smtp', 'smtp-submission', 'smtps', 'ssh', 'https')
# Each extra uplink gets its own routing table, so its answers leave where the request came in.
UPLINK_TABLE_BASE = 100


def interfaces_state():
    return {'interfaces': {}, 'pending': None, **_json_read(INTERFACES_FILE, {})}


def interface_settings(role, method, address, gateway, dns, metric, table):
    """The NetworkManager settings of one interface from its role. Uplinks besides the main one route their own answers by their own table."""
    if role == 'unused':
        # The own routing table and its rule of a former uplink go too.
        return {'ipv4.method': 'disabled', 'ipv4.addresses': '', 'ipv4.gateway': '', 'connection.zone': ROLE_ZONES['unused'],
                'ipv4.route-table': '0', 'ipv4.routing-rules': ''}
    found = {'ipv4.method': method, 'connection.zone': ROLE_ZONES[role], 'ipv4.dns': dns or ''}
    if method == 'manual':
        found.update({'ipv4.addresses': address, 'ipv4.gateway': gateway if role == 'uplink' else ''})
    else:
        found.update({'ipv4.addresses': '', 'ipv4.gateway': ''})
    if role == 'uplink':
        found['ipv4.route-metric'] = str(metric)
        if method == 'manual' and table:
            ip = address.split('/')[0]
            found.update({'ipv4.route-table': str(table), 'ipv4.routing-rules': f'priority {table} from {ip} table {table}'})
    else:
        # An internal network never becomes the way out.
        found.update({'ipv4.never-default': 'yes', 'ipv4.route-table': '0', 'ipv4.routing-rules': ''})
    return found


def interfaces_list(_args):
    """All ethernet interfaces with their role, address and state. The interface of the default route is shown, never changed here."""
    platform_now, state = _platform(), interfaces_state()
    try:
        main, found = platform_now.main_interface(), platform_now.interfaces()
    except Exception as err:  # the StepError of the platform layer
        raise EfaError(str(err))
    rows = []
    for item in found:
        settings = platform_now.connection_settings(item['connection']) if item['connection'] else {}
        rows.append({**item, 'main': item['device'] == main, 'role': 'main uplink' if item['device'] == main else state['interfaces'].get(item['device'], {}).get('role', 'unused'),
                     'address': settings.get('ipv4.addresses', ''), 'gateway': settings.get('ipv4.gateway', ''), 'zone': settings.get('connection.zone', '')})
    return {'interfaces': rows, 'waiting_for_confirmation': state['pending']['device'] if state['pending'] else None}


def interface_set(args):
    """Role and address of an extra interface. Reverts after 5 minutes unless confirmed; the zone changes only between minute 20 and 50."""
    _confirm(args)
    device, role = args.device.strip(), args.role.strip()
    vlan = (args.vlan or '').strip()
    if not re.fullmatch(r'[A-Za-z0-9._-]{1,15}', device) or role not in INTERFACE_ROLES or (vlan and not (vlan.isdigit() and 1 <= int(vlan) <= 4094)):
        raise EfaError('Device, role (' + ', '.join(INTERFACE_ROLES) + ') and VLAN 1 to 4094.')
    state, platform_now = interfaces_state(), _platform()
    if state['pending']:
        raise EfaError('Another interface change waits for confirmation.')
    try:
        main, known = platform_now.main_interface(), {item['device'] for item in platform_now.interfaces()}
    except Exception as err:
        raise EfaError(str(err))
    if device == main:
        raise EfaError('This is the interface of the default route: it is set on the page Network & certificate, not here.')
    if device not in known:
        raise EfaError('No such ethernet interface.')
    method = (args.method or '').strip() or 'manual'
    address, gateway, dns = (args.address or '').strip(), (args.gateway or '').strip(), (args.dns or '').strip()
    if role != 'unused' and method == 'manual':
        try:
            network = ipaddress.IPv4Interface(address)
            if gateway and ipaddress.IPv4Address(gateway) not in network.network:
                raise EfaError('The gateway is not in the network of the address.')
        except ValueError:
            raise EfaError('Address like 192.0.2.10/24, gateway like 192.0.2.1.')
        if role == 'uplink' and not gateway:
            raise EfaError('An uplink needs a gateway.')
    try:
        dns = ' '.join(str(ipaddress.ip_address(item)) for item in dns.replace(',', ' ').split())
    except ValueError:
        raise EfaError('DNS servers: IP addresses.')
    zone_change = role != state['interfaces'].get(device, {}).get('role', 'unused')
    if zone_change and not UPDATE_WINDOW[0] <= datetime.datetime.now().minute <= UPDATE_WINDOW[1]:
        raise EfaError(f'A firewall zone changes only between minute {UPDATE_WINDOW[0]} and {UPDATE_WINDOW[1]}.')
    uplinks = sorted(name for name, item in state['interfaces'].items() if item.get('role') == 'uplink' and name != device)
    table = UPLINK_TABLE_BASE + len(uplinks) + 1 if role == 'uplink' else None
    try:
        connection, made = platform_now.connection_ensure(device, int(vlan) if vlan else None)
        previous = platform_now.connection_settings(connection)
        services = platform_now.zone_service_list('internal') if role in ('internal', 'management') else None
        state['pending'] = {'device': device, 'connection': connection, 'made': made, 'previous': previous, 'internal_services': services,
                            'old': state['interfaces'].get(device), 'until': time.strftime('%Y-%m-%d %H:%M:%S', time.localtime(time.time() + 300))}
        # The way back first, as for the firewall.
        platform_now.schedule(INTERFACE_REVERT, 300, ['/usr/sbin/efactl', 'interface-revert'])
        _json_write(INTERFACES_FILE, state)
        if role in ('internal', 'management'):
            platform_now.zone_services('internal', INTERNAL_SERVICES if role == 'internal' else ('ssh', 'https'))
        platform_now.connection_apply(connection, interface_settings(role, method, address, gateway, dns, 50 + 10 * (len(uplinks) + 1), table))
    except Exception as err:
        raise EfaError(f'The interface was not changed fully, it is taken back within 5 minutes: {err}')
    state['interfaces'][device] = {'role': role, 'method': method, 'address': address, 'gateway': gateway, 'dns': dns, 'vlan': vlan, 'table': table}
    _json_write(INTERFACES_FILE, state)
    hints = []
    if role == 'uplink' and method == 'manual':
        hints.append(f'Mail sent over this uplink needs a PTR record for {address.split("/")[0]}, the same name as HELO, and the address in the SPF record.')
    if role == 'internal':
        hints.append(f'Add {ipaddress.IPv4Interface(address).network if method == "manual" else "its network"} to the relay networks if its mail servers send through eFa.')
    return {'device': device, 'role': role, 'confirm_until': state['pending']['until'], 'hints': hints,
            'note': 'Check that you still have access, then confirm with interface-confirm. Otherwise this reverts by itself after 5 minutes.'}


# 5l: mail of a sender domain leaves over an extra uplink: an own smtp transport bound to the address of that uplink, chosen by
# sender_dependent_default_transport_maps. Its answers come back the same way through the routing table of the uplink.
UPLINK_ROUTES = ETC + '/postfix/efa-sender-transport'
UPLINK_SERVICE = 'efa-out-'


def uplink_route_plan(routes, interfaces):
    """({transport: bind address}, map lines) for {sender domain: device}; a device must be an uplink with a fixed address."""
    services, lines = {}, []
    for domain, device in sorted(routes.items()):
        item = interfaces.get(device) or {}
        if item.get('role') != 'uplink' or item.get('method') != 'manual' or not item.get('address'):
            raise EfaError(f'{device} is no uplink with a fixed address (interface-set).')
        name = UPLINK_SERVICE + re.sub(r'[^a-z0-9]', '-', device.lower())
        services[name] = item['address'].split('/')[0]
        lines.append(f'@{domain} {name}:')
    return services, lines


def uplink_services_in(master):
    """The uplink services of `postconf -M`, which prints "name unix ..." (older Postfix "name/unix ...")."""
    return [line.split()[0].split('/')[0] for line in master.splitlines() if line.startswith(UPLINK_SERVICE)]


def _uplink_routes_apply(routes, interfaces):
    services, lines = uplink_route_plan(routes, interfaces)
    have = uplink_services_in(subprocess.run(['postconf', '-M'], capture_output=True, text=True).stdout)
    for name, address in services.items():
        subprocess.run(['postconf', '-M', f'{name}/unix={name} unix - - n - - smtp'], check=True, capture_output=True)
        subprocess.run(['postconf', '-P', f'{name}/unix/smtp_bind_address={address}', f'{name}/unix/syslog_name=postfix/{name}'],
                       check=True, capture_output=True)
    for name in set(have) - set(services):
        subprocess.run(['postconf', '-MX', f'{name}/unix'], check=False, capture_output=True)
    current = _postconf('sender_dependent_default_transport_maps')
    if lines:
        if current not in ('', f'hash:{UPLINK_ROUTES}'):
            raise EfaError(f'sender_dependent_default_transport_maps is already used ({current}), nothing changed.')
        _map_write(UPLINK_ROUTES, lines, 'hash')
        _postconf_set('sender_dependent_default_transport_maps', f'hash:{UPLINK_ROUTES}')
    elif current == f'hash:{UPLINK_ROUTES}':
        _postconf_remove(['sender_dependent_default_transport_maps'])
        subprocess.run(['postfix', 'reload'], check=False, capture_output=True)


def uplink_route_set(args):
    """Outgoing mail of one of the own sender domains over an extra uplink, or back over the main one (--device main)."""
    domain, device = args.domain.strip().lower(), args.device.strip()
    if not DOMAIN_RE.match(domain) or domain not in _local_domains():
        raise EfaError('Domain: one of the own domains.')
    state = interfaces_state()
    routes = dict(state.get('routes') or {})
    if device == 'main':
        routes.pop(domain, None)
    else:
        routes[domain] = device
    _uplink_routes_apply(routes, state['interfaces'])
    state['routes'] = routes
    _json_write(INTERFACES_FILE, state)
    _audit(f'outgoing mail of {domain} over {device} set by {_dmarc_who()}')
    hint = '' if device == 'main' else (f'The address of {device} needs a PTR record with the HELO name and a place in the SPF record of {domain}.')
    return {'routes': routes, 'note': hint}


def network_harden(_args):
    """Package setup: a new interface gets no automatic DHCP profile (it could take an address or a default route from an unknown
    network); it stays unused until it has a role. Profiles that exist stay."""
    try:
        return {'no_auto_profiles': _platform().no_auto_profiles()}
    except (NotImplementedError, AttributeError):
        return {'no_auto_profiles': None}


def new_interfaces(found=None):
    """Network devices that are neither the interface of the default route nor have a role in eFa-next. No program is started:
    the dashboard asks on every load."""
    try:
        devices, main = found if found is not None else _platform().ethernet_devices()
    except (NotImplementedError, AttributeError):  # a platform without it (the plain one of the tests)
        return []
    known = set(interfaces_state()['interfaces'])
    return [name for name in devices if name not in main and name not in known]


def interface_confirm(_args):
    state = interfaces_state()
    if not state['pending']:
        raise EfaError('No interface change waits for confirmation.')
    _platform().unschedule(INTERFACE_REVERT)
    state['pending'] = None
    _json_write(INTERFACES_FILE, state)
    return {'confirmed': True}


def interface_revert(_args):
    """Takes an unconfirmed interface change back: the old settings, or the connection eFa made goes again."""
    state = interfaces_state()
    pending = state['pending']
    if not pending:
        return {'reverted': False}
    platform_now = _platform()
    try:
        if pending['made']:
            platform_now.connection_delete(pending['connection'])
        else:
            platform_now.connection_apply(pending['connection'], pending['previous'])
        # The services of the internal zone as they were, if this change set them.
        if pending.get('internal_services') is not None:
            platform_now.zone_services('internal', pending['internal_services'])
    finally:
        if pending['old'] is None:
            state['interfaces'].pop(pending['device'], None)
        else:
            state['interfaces'][pending['device']] = pending['old']
        state['pending'] = None
        _json_write(INTERFACES_FILE, state)
    _admin_notify('eFa: interface change taken back', f"The change of {pending['device']} was not confirmed within 5 minutes and was taken back.")
    return {'reverted': True}


def tui(_args):
    """The text interface, efa-tui, with the same commands and checks as the web interface."""
    os.execv('/usr/local/sbin/efa-tui', ['/usr/local/sbin/efa-tui', *sys.argv[2:]])


def maintenance_set(args):
    """Maintenance mode stops the service monitor from restarting services."""
    if _on_off(args.mode):
        if os.path.exists(MONITOR_CRON):
            os.remove(MONITOR_CRON)
    else:
        _write(MONITOR_CRON, '* * * * * root /usr/sbin/efa-monitor >/dev/null 2>&1\n')
    return {'maintenance_mode': not os.path.exists(MONITOR_CRON)}


def relay_networks_set(args):
    """Networks allowed to relay; rspamd treats them as internal."""
    nets = []
    for item in args.networks.replace(',', ' ').split():
        try:
            net = ipaddress.ip_network(item.replace('[', '').replace(']', ''), strict=False)
        except ValueError:
            raise EfaError(f'Invalid network: {item}')
        if net.prefixlen == 0:
            raise EfaError(f'Refusing open relay network: {item}')
        if str(net) not in RELAY_SYSTEM:
            nets.append(str(net))
    state = _json_read(RELAY_FILE, {})
    state.pop('draft', None)
    _json_write(RELAY_FILE, state)
    return _relay_write(nets)


def _relay_write(nets):
    postfix_nets = ['127.0.0.0/8', '[::1]/128'] + [f'[{n.split("/")[0]}]/{n.split("/")[1]}' if ':' in n else n
                                                  for n in nets]
    _postconf_set('mynetworks', ' '.join(postfix_nets))
    quoted = ','.join(f'"{n}"' for n in ['127.0.0.0/8', '::1/128'] + nets)
    _write(OPTIONS_INC, f'local_addrs = [{quoted}];\n')
    _reload_rspamd()
    if os.path.exists(OUTBOUND_FILE):
        state = _json_read(OUTBOUND_FILE, {})
        state['networks'] = _outbound_networks()
        _write(OUTBOUND_FILE, json.dumps(state, indent=1))
    return {'relay_networks': postfix_nets}


def _relay_active():
    nets, unknown = [], []
    for item in _postconf('mynetworks').replace(',', ' ').split():
        try:
            net = str(ipaddress.ip_network(item.replace('[', '').replace(']', ''), strict=False))
        except ValueError:
            unknown.append(item)
            continue
        if net not in RELAY_SYSTEM:
            nets.append(net)
    return nets, unknown


def _relay_warnings(net, others):
    warnings = []
    if net.is_global and net.prefixlen <= (8 if net.version == 4 else 32):
        warnings.append(f'{net} is very broad and public: everyone in it may relay through this server.')
    for other in others:
        other = ipaddress.ip_network(other)
        if other != net and other.version == net.version and other.overlaps(net):
            warnings.append(f'{net} overlaps {other}.')
    return warnings


def relay_networks_list(_args):
    """Relay networks with the changes that wait for Apply."""
    active, unknown = _relay_active()
    state = _json_read(RELAY_FILE, {})
    draft = state.get('draft', active)
    descriptions = state.get('descriptions', {})
    rows = [{'network': net, 'family': 'IPv6' if ':' in net else 'IPv4', 'description': 'system', 'state': 'active', 'locked': True}
            for net in RELAY_SYSTEM]
    warnings = []
    for net in list(active) + [item for item in draft if item not in active]:
        state_name = 'to add' if net not in active else 'to remove' if net not in draft else 'active'
        rows.append({'network': net, 'family': 'IPv6' if ':' in net else 'IPv4', 'description': descriptions.get(net, ''),
                     'state': state_name, 'locked': False})
        if net in draft:
            warnings += _relay_warnings(ipaddress.ip_network(net), draft)
    added, removed = [n for n in draft if n not in active], [n for n in active if n not in draft]
    return {'networks': rows, 'added': added, 'removed': removed, 'pending': bool(added or removed),
            'warnings': warnings, 'unknown': unknown}


def relay_networks_add(args):
    """Adds networks to the changes that wait for Apply. Several at once, separated by spaces or commas."""
    active, _unknown = _relay_active()
    state = _json_read(RELAY_FILE, {})
    draft = state.get('draft', active)
    description = (args.description or '').strip()
    if len(description) > 200:
        raise EfaError('Description: up to 200 characters.')
    items, warnings, added = args.networks.replace(',', ' ').split(), [], []
    if not items:
        raise EfaError('Enter at least one network.')
    for item in items:
        try:
            net = ipaddress.ip_network(item.replace('[', '').replace(']', ''))
        except ValueError as err:
            raise EfaError(f'Invalid network, nothing was added: {item}: {err}')
        if net.prefixlen == 0:
            raise EfaError(f'Refusing open relay network, nothing was added: {item}')
        if str(net) in RELAY_SYSTEM or str(net) in draft:
            raise EfaError(f'{net} is already in the list, nothing was added.')
        warnings += _relay_warnings(net, draft)
        draft.append(str(net))
        added.append(str(net))
    if description:
        state.setdefault('descriptions', {}).update({net: description for net in added})
    state['draft'] = draft
    _json_write(RELAY_FILE, state)
    return {'added': added, 'warnings': warnings, 'note': 'Not active yet, use Apply.'}


def relay_networks_remove(args):
    """Marks a network for removal. It stays active until Apply."""
    item = args.network.strip()
    if item in RELAY_SYSTEM or item == '[::1]/128':
        raise EfaError(f'{item} is a system entry and stays.')
    active, _unknown = _relay_active()
    state = _json_read(RELAY_FILE, {})
    draft = state.get('draft', active)
    if item not in draft:
        raise EfaError(f'{item} is not in the list.')
    draft.remove(item)
    state['draft'] = draft
    _json_write(RELAY_FILE, state)
    return {'to_remove': item, 'note': 'Still active, use Apply.'}


def relay_networks_apply(args):
    """Writes the waiting changes to postfix and rspamd."""
    if args.confirm.strip() != 'yes':
        raise EfaError("Type 'yes' to confirm.")
    active, unknown = _relay_active()
    if unknown:
        raise EfaError(f'mynetworks holds entries eFa cannot read, nothing changed: {" ".join(unknown)}')
    state = _json_read(RELAY_FILE, {})
    draft = state.pop('draft', active)
    state['descriptions'] = {net: text for net, text in state.get('descriptions', {}).items() if net in draft}
    _json_write(RELAY_FILE, state)
    return _relay_write(draft)


# Submitters (8g): internal mail systems that send through this server. Postfix itself binds each one to its own sender domains,
# so the binding holds also when a milter is down. Without a submitter nothing changes.
SUBMITTERS_FILE = ETC + '/eFa/submitters.json'
SUBMITTER_KINDS = ('ip', 'auth', 'cert')
SUBMITTER_NAME_RE = re.compile(r'^[a-z0-9][a-z0-9_]{0,31}$')
SUBMITTER_LOGIN_RE = re.compile(r'^[a-z0-9][a-z0-9._@-]{0,63}$')
FINGERPRINT_RE = re.compile(r'^([0-9A-F]{2}:){31}[0-9A-F]{2}$')
SUB_CIDR = ETC + '/postfix/efa-submitters.cidr'
SUB_SASL = ETC + '/postfix/efa-submitters-sasl'
SUB_CCERT = ETC + '/postfix/efa-submitters-ccert'
SUB_PASSWD = ETC + '/dovecot/efa-submitters.passwd'
SUB_DOVECOT = ETC + '/dovecot/conf.d/90-efa-submitters.conf'
# 5u: the logins for efa-sasl, which replaces Dovecot; Dovecot stays only where system accounts (PAM) still log in on 587.
SASL_LOGINS = ETC + '/efa-sasl/logins'
SASL_UNITS = ('efa-sasl.socket', 'efa-sasl.service')
SASL_SOCKET = '/run/efa-sasl/auth'
SUB_CHECKS = [f'check_client_access cidr:{SUB_CIDR}', f'check_sasl_access hash:{SUB_SASL}', f'check_ccert_access hash:{SUB_CCERT}']
SUB_CLASS = 'efa_sub_'


def submitter_restrictions(current, on):
    """A restriction list with the submitter checks first (before permit_mynetworks), or without them."""
    items = [item.strip() for item in current.split(',') if item.strip() and item.strip() not in SUB_CHECKS]
    return ', '.join((SUB_CHECKS if on else []) + items)


def submitter_maps(submitters):
    """The lines of the Postfix tables: client, login and certificate to the class of the submitter; per class its domains."""
    tables = {SUB_CIDR: [], SUB_SASL: [], SUB_CCERT: []}
    classes = {}
    for item in submitters:
        name = SUB_CLASS + item['name']
        tables[{'ip': SUB_CIDR, 'auth': SUB_SASL, 'cert': SUB_CCERT}[item['kind']]].append(f'{item["value"]} {name}')
        # The null sender: bounces and out of office replies of the internal system.
        classes[name] = [f'{domain} OK' for domain in item['domains']] + ['<> OK']
    return tables, classes


def _map_write(path, lines, kind='hash'):
    _write(path, ''.join(line + '\n' for line in lines))
    os.chmod(path, 0o644)
    if kind == 'hash' and subprocess.run(['postmap', path], capture_output=True).returncode != 0:
        raise EfaError(f'postmap {path} failed.')


def _postconf_explicit():
    return {line.split('=')[0].strip() for line in subprocess.run(['postconf', '-n'], capture_output=True, text=True).stdout.splitlines()}


def _postconf_remove(names):
    if names:
        subprocess.run(['postconf', '-X'] + names, check=True, capture_output=True)


def _submitters():
    return _json_read(SUBMITTERS_FILE, {'submitters': []})['submitters']


def _submitters_apply(submitters):
    """Writes the tables, the classes and the restriction lists, and the logins for Dovecot."""
    tables, classes = submitter_maps(submitters)
    on = bool(submitters)
    if on:
        for path, lines in tables.items():
            _map_write(path, lines, 'cidr' if path == SUB_CIDR else 'hash')
    for name, lines in classes.items():
        path = f'{ETC}/postfix/{name.replace("_", "-")}'
        _map_write(path, lines)
        _postconf_set(name, f'check_sender_access hash:{path}, reject')
    listed = _postconf('smtpd_restriction_classes').replace(',', ' ').split()
    # Taken from the list before it changes: a class that is out of the list is an unused parameter postconf -n no longer shows.
    gone = [item for item in listed if item.startswith(SUB_CLASS) and item not in classes]
    others = [item for item in listed if not item.startswith(SUB_CLASS)]
    if others or classes:
        _postconf_set('smtpd_restriction_classes', ' '.join(others + sorted(classes)))
    for name in ('smtpd_relay_restrictions', 'smtpd_recipient_restrictions'):
        _postconf_set(name, submitter_restrictions(_postconf(name), on))
    _postconf_set('efa_submission_restrictions', ', '.join((SUB_CHECKS if on else []) + ['permit_sasl_authenticated', 'reject']))
    # Port 587 reads the same list; set here too, an upgrade does not touch master.cf.
    if _submission_active():
        subprocess.run(['postconf', '-P'] + [f'submission/inet/{name}=$efa_submission_restrictions'
                                             for name in ('smtpd_relay_restrictions', 'smtpd_recipient_restrictions')], check=True, capture_output=True)
    if any(item['kind'] == 'cert' for item in submitters):
        _postconf_set('smtpd_tls_ask_ccert', 'yes')
        _postconf_set('smtpd_tls_fingerprint_digest', 'sha256')
    elif _postconf('smtpd_tls_ask_ccert') == 'yes' and _postconf('smtpd_tls_fingerprint_digest') == 'sha256':
        _postconf_remove(['smtpd_tls_ask_ccert', 'smtpd_tls_fingerprint_digest'])
    # Classes that are gone, and without submitters the tables and the empty class list: their parameters and files.
    _postconf_remove(gone + ([] if others or classes or 'smtpd_restriction_classes' not in _postconf_explicit() else ['smtpd_restriction_classes']))
    files = [f'{ETC}/postfix/{name.replace("_", "-")}' for name in gone] + ([] if on else list(tables))
    for path in files + [path + '.db' for path in files]:
        if os.path.exists(path):
            os.remove(path)
    _dovecot_logins_write(submitters, _pam_on())
    if os.path.exists(OUTBOUND_FILE):
        _outbound_strict_apply(_json_read(OUTBOUND_FILE, {}))


DOVECOT_AUTH = ETC + '/dovecot/conf.d/10-auth.conf'
PAM_INCLUDE = '!include auth-system.conf.ext'
PAM_OFF_MARK = '  # eFa: system accounts off (efactl submission-pam-set)'


def _pam_on():
    """Whether Dovecot also checks logins on port 587 against the system accounts (PAM), as the package sets it up."""
    return any(line.strip() == PAM_INCLUDE for line in _read_lines(DOVECOT_AUTH))


def pam_toggled(text, on):
    """10-auth.conf with the include of the system accounts on or commented out."""
    lines = []
    for line in text.splitlines():
        if line.strip() == PAM_INCLUDE and not on:
            line = '#' + PAM_INCLUDE + PAM_OFF_MARK
        elif line.strip() == '#' + PAM_INCLUDE + PAM_OFF_MARK.rstrip() or line == '#' + PAM_INCLUDE + PAM_OFF_MARK:
            line = PAM_INCLUDE if on else line
        lines.append(line)
    return '\n'.join(lines) + '\n'


def login_hash(password, crypt_module=None):
    """The stored form of a submitter login: scrypt for efa-sasl; SHA512-CRYPT only while Dovecot checks the logins (PAM on)."""
    if crypt_module:
        return '{SHA512-CRYPT}' + crypt_module.crypt(password, crypt_module.mksalt(crypt_module.METHOD_SHA512))
    salt = secrets.token_bytes(16)
    digest = hashlib.scrypt(password.encode(), salt=salt, n=2 ** 15, r=8, p=1, dklen=32, maxmem=128 * 1024 * 1024)
    return '{SCRYPT}%d$%d$%d$%s$%s' % (2 ** 15, 8, 1, base64.b64encode(salt).decode(), base64.b64encode(digest).decode())


def _sasl_logins_write(submitters):
    logins = [item for item in submitters if item['kind'] == 'auth']
    os.makedirs(os.path.dirname(SASL_LOGINS), exist_ok=True)
    fd = os.open(SASL_LOGINS + '.new', os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o640)
    os.fchmod(fd, 0o640)  # the umask must not take the group read away
    with os.fdopen(fd, 'w') as f:
        f.write(''.join(f'{item["value"]}:{item["hash"]}\n' for item in logins))
    shutil.chown(SASL_LOGINS + '.new', 'root', 'efa-sasl')
    os.replace(SASL_LOGINS + '.new', SASL_LOGINS)
    return logins


def _dovecot_logins_write(submitters, pam_on):
    if not pam_on:
        # efa-sasl checks the logins; the files of Dovecot stay as they were, for the way back.
        logins = _sasl_logins_write(submitters)
        try:
            _sasl_apply(bool(logins), restart=True)
        except Exception as err:  # the StepError of the platform layer
            raise EfaError(f'Saved, but the login service did not follow: {err}')
        return
    """The logins of the submitters for Dovecot. Without PAM the file is there, maybe empty, so Dovecot has a password database."""
    logins = [item for item in submitters if item['kind'] == 'auth']
    had = os.path.exists(SUB_DOVECOT)
    if logins or not pam_on:
        fd = os.open(SUB_PASSWD + '.new', os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o640)
        os.fchmod(fd, 0o640)  # the umask must not take the group read away
        with os.fdopen(fd, 'w') as f:
            f.write(''.join(f'{item["value"]}:{item["hash"]}\n' for item in logins))
        shutil.chown(SUB_PASSWD + '.new', 'root', 'dovecot')
        os.replace(SUB_PASSWD + '.new', SUB_PASSWD)
        # Without the system accounts there is no user database either: SASL needs none, Dovecot wants one.
        userdb = '' if pam_on else 'userdb {\n  driver = static\n  args = uid=dovecot gid=dovecot home=/nonexistent\n}\n'
        _write(SUB_DOVECOT, '# eFa: logins of the submitters (efactl submitter-set), before the other password databases.\n'
                            f'passdb {{\n  driver = passwd-file\n  args = scheme=SHA512-CRYPT {SUB_PASSWD}\n}}\n' + userdb)
    else:
        for path in (SUB_DOVECOT, SUB_PASSWD):
            if os.path.exists(path):
                os.remove(path)
    try:
        _sasl_apply(bool(logins) or pam_on, restart=bool(logins or had or not pam_on))
    except Exception as err:  # the StepError of the platform layer
        raise EfaError(f'Saved, but Dovecot did not follow: {err}')


def _sasl_apply(needed, restart=True, pam_on=None):
    """Who checks the SMTP-AUTH logins of port 587: efa-sasl, or Dovecot while system accounts (PAM) still log in there.
    Without a login on 587 neither runs, and 587 offers no AUTH; submitters known by network or certificate still send there."""
    platform_now = _platform()
    dovecot = platform_now.service('sasl')
    pam_on = _pam_on() if pam_on is None else pam_on
    subprocess.run(['postconf', '-P', f"submission/inet/smtpd_sasl_auth_enable={'yes' if needed else 'no'}"], check=True, capture_output=True)
    # Port 587 asks efa-sasl on its own socket, Dovecot on the socket in the private folder of Postfix (the default).
    if needed and not pam_on:
        subprocess.run(['postconf', '-P', f'submission/inet/smtpd_sasl_path={SASL_SOCKET}'], check=True, capture_output=True)
    else:
        subprocess.run(['postconf', '-PX', 'submission/inet/smtpd_sasl_path'], check=False, capture_output=True)
    if not (needed and pam_on) and platform_now.service_exists(dovecot):
        platform_now.service_disable(dovecot, stop=True)
    if needed and pam_on:
        for unit in reversed(SASL_UNITS):
            platform_now.service_disable(unit, stop=True)
        platform_now.service_enable(dovecot, start=True)
        if restart:
            platform_now.service_try_restart(dovecot)
    elif needed:
        platform_now.service_enable(SASL_UNITS[0], start=True)
        if restart:
            platform_now.service_try_restart(SASL_UNITS[1])
    else:
        for unit in reversed(SASL_UNITS):
            platform_now.service_disable(unit, stop=True)
    platform_now.service_reload_if_active(platform_now.service('mta'))


def sasl_apply(_args):
    """The login service of port 587 as the submitters and the PAM setting want it; run by the upgrade."""
    pam_on = _pam_on()
    if not pam_on:
        _sasl_logins_write(_submitters())
    needed = pam_on or any(item['kind'] == 'auth' for item in _submitters())
    _sasl_apply(needed, pam_on=pam_on)
    return {'logins_on_587': needed, 'checked_by': ('Dovecot (system accounts, PAM)' if pam_on else 'efa-sasl') if needed else 'nobody: no AUTH on 587'}


def submission_pam_set(args):
    """Whether system accounts (PAM) may log in on port 587 too. Off: only the logins of the submitters."""
    on = _on_off(args.mode)
    if on and not _pam_on():
        raise EfaError('System accounts no longer log in on port 587: make a submitter with a login for each mail system (efactl submitter-set).')
    if os.path.exists(DOVECOT_AUTH):
        with open(DOVECOT_AUTH) as f:
            text = f.read()
        changed = pam_toggled(text, on)
        if changed != text:
            _write(DOVECOT_AUTH, changed)
    _dovecot_logins_write(_submitters(), on)
    return {'system_accounts_on_587': _pam_on()}


def submitter_list(_args):
    """The submitters: internal systems that send through this server, each only for its own domains."""
    rows = [{key: value for key, value in item.items() if key != 'hash'} for item in _submitters()]
    if identity_now and identity_now['domains'] is not None:
        rows = [row for row in rows if set(row['domains']) <= set(identity_now['domains'])]
    return {'submitters': rows, 'limits': {**OUTBOUND_LIMIT_DEFAULTS, **_json_read(OUTBOUND_FILE, {}).get('limits', {})}}


def _submitter_domains(text, tenant, others):
    domains = sorted({item.strip().lower() for item in re.split(r'[\s,;]+', text or '') if item.strip()})
    if not domains:
        raise EfaError('Name at least one sender domain.')
    tenant_of = {domain: tenant_id for tenant_id, items in _tenant_domains().items() for domain in items}
    tenant_id = _tenant_id(tenant) if tenant else None
    own = _own_domains()
    for domain in domains:
        if not DOMAIN_RE.match(domain) or domain not in own:
            raise EfaError(f'{domain} is not a domain of this server.')
        if tenant_of.get(domain) != tenant_id:
            raise EfaError(f'{domain} belongs to {"another tenant" if tenant_of.get(domain) else "no tenant"}: name its tenant.')
        if identity_now and identity_now['domains'] is not None and domain not in identity_now['domains']:
            raise EfaError(f'Not allowed: {domain} is not one of your domains.')
        clash = [item['name'] for item in others if domain in item['domains'] and item.get('tenant') != tenant]
        if clash:
            raise EfaError(f'{domain} is bound to the submitter {clash[0]} of another tenant.')
    return domains


def submitter_set(args):
    """Adds or changes a submitter: by network, by login (SMTP-AUTH on port 587) or by its TLS client certificate."""
    import crypt  # shortcut: the crypt module ends with Python 3.13; use another scheme Dovecot reads by then (FreeBSD, EL10).
    name = args.name.strip().lower()
    if not SUBMITTER_NAME_RE.match(name):
        raise EfaError('Name: up to 32 small letters, digits or _.')
    kind, value = (args.kind or '').strip(), (args.value or '').strip()
    if kind not in SUBMITTER_KINDS:
        raise EfaError('Kind: ip, auth or cert.')
    submitters = _submitters()
    old = next((item for item in submitters if item['name'] == name), None)
    others = [item for item in submitters if item['name'] != name]
    tenant = (args.tenant or '').strip()
    item = {'name': name, 'tenant': tenant, 'kind': kind, 'domains': _submitter_domains(args.domains, tenant, others)}
    if kind == 'ip':
        try:
            net = ipaddress.ip_network(value, strict=False)
        except ValueError:
            raise EfaError('Value: a network such as 192.0.2.10/32 or 2001:db8::/64.')
        if net.prefixlen < (16 if net.version == 4 else 32):
            raise EfaError('Network: at most a /16 (IPv4) or /32 (IPv6).')
        item['value'] = str(net)
    elif kind == 'auth':
        value = value.lower()
        if not SUBMITTER_LOGIN_RE.match(value):
            raise EfaError('Value: the login, letters, digits and . _ @ -')
        first, second = _secrets(2, 'Password, then again')
        if first != second:
            raise EfaError(PASSWORD_DIFFER + ' Nothing was changed.')
        if not first and not (old and old['kind'] == 'auth' and old['value'] == value):
            raise EfaError('A new login needs a password.')
        if first and len(first) < 12:
            raise EfaError('Password: at least 12 characters.')
        item['value'] = value
        item['hash'] = login_hash(first, crypt if _pam_on() else None) if first else old['hash']
    else:
        value = value.upper()
        if not FINGERPRINT_RE.match(value):
            raise EfaError('Value: the SHA-256 fingerprint of the client certificate, 32 pairs such as AB:12:… (openssl x509 -fingerprint -sha256).')
        item['value'] = value
    if any(other['kind'] == kind and other['value'] == item['value'] for other in others):
        raise EfaError('Another submitter has this value already.')
    submitters = sorted(others + [item], key=lambda entry: entry['name'])
    _submitters_apply(submitters)
    _json_write(SUBMITTERS_FILE, {'submitters': submitters})
    os.chmod(SUBMITTERS_FILE, 0o600)
    result = submitter_list(None)
    if kind == 'auth' and _pam_on():
        result['notes'] = ['System accounts can log in on port 587 too. Recommended: efactl submission-pam-set --mode off, '
                           'then only the logins of the submitters count.']
    return result


def submitter_remove(args):
    """Removes a submitter: its mail is treated like any other client again."""
    _confirm(args)
    submitters = _submitters()
    if not any(item['name'] == args.name.strip().lower() for item in submitters):
        raise EfaError('No such submitter.')
    submitters = [item for item in submitters if item['name'] != args.name.strip().lower()]
    _submitters_apply(submitters)
    _json_write(SUBMITTERS_FILE, {'submitters': submitters})
    return submitter_list(None)


OUTBOUND_LIMIT_ACTIONS = ('off', 'log', 'throttle', 'hold', 'reject')


# Shown before the first change too, so the form has its current values on a fresh host.
OUTBOUND_LIMIT_DEFAULTS = {'recipients_hour': 500, 'domains_hour': 100, 'action': 'off'}


def outbound_limits_set(args):
    """Limits per sender and hour against taken over accounts: recipients and target domains of outgoing mail."""
    state = _json_read(OUTBOUND_FILE, {})
    limits = {**OUTBOUND_LIMIT_DEFAULTS, **state.get('limits', {})}
    for key in ('recipients_hour', 'domains_hour'):
        value = (getattr(args, key) or '').strip()
        if value:
            if not value.isdigit() or not 0 <= int(value) <= 100000:
                raise EfaError('Limits: a number from 0 (no limit) to 100000.')
            limits[key] = int(value)
    action = (args.action or '').strip()
    if action:
        if action not in OUTBOUND_LIMIT_ACTIONS:
            raise EfaError('Action: off, log, throttle, hold or reject.')
        limits['action'] = action
    state['limits'] = limits
    _outbound_write(state)
    return submitter_list(None)


def relay_networks_discard(_args):
    """Drops the waiting changes."""
    state = _json_read(RELAY_FILE, {})
    state.pop('draft', None)
    _json_write(RELAY_FILE, state)
    return {'discarded': True}


def _sender_type(entry):
    if '*' in entry:
        return 'pattern'
    try:
        ipaddress.ip_network(entry)
        return 'IP'
    except ValueError:
        return 'address' if '@' in entry else 'domain' if DOMAIN_RE.match(entry) else 'pattern'


def _sender_is_map_entry(entry):
    return bool(SENDER_RE.match(entry) or DOMAIN_RE.match(entry))


def _sender_rules():
    return [line.split('|') for line in _read_lines(SENDER_RULES) if line.count('|') == 2]


def _sender_rows(meta, which, entries):
    return [{'entry': entry, 'type': _sender_type(entry), 'comment': meta.get(entry, {}).get('comment', ''),
             'added': meta.get(entry, {}).get('added', '')} for entry in entries]


def sender_list(_args):
    """All sender entries with type, comment and date. The date is empty for entries older than this feature."""
    meta = _json_read(SENDER_META, {})
    rules = [{**_sender_rows(meta, 'rules', [sender])[0], 'list': which, 'recipient': recipient}
             for which, sender, recipient in _sender_rules()]
    return {'allow': _sender_rows(meta, 'allow', _read_lines(SENDER_MAPS['allow'])),
            'block': _sender_rows(meta, 'block', _read_lines(SENDER_MAPS['block'])), 'rules': rules}


def sender_add(args):
    """Adds addresses and domains to a list, IPs and patterns as rules. Entries already there are reported."""
    which, comment = args.list.strip(), (args.comment or '').strip()
    if which not in SENDER_MAPS:
        raise EfaError("List must be 'allow' or 'block'.")
    if len(comment) > 200 or '\n' in comment:
        raise EfaError('Comment: one line, up to 200 characters.')
    items = [item.lower() for item in args.entries.replace(',', ' ').split()]
    if not items:
        raise EfaError('Enter at least one sender.')
    for item in items:
        if not _sender_is_map_entry(item) and (not RULE_FROM_RE.match(item) or item.strip('*') == ''):
            raise EfaError(f'Invalid sender, nothing was added: {item}')
    entries = _read_lines(SENDER_MAPS[which])
    rules = _read_lines(SENDER_RULES)
    meta = _json_read(SENDER_META, {})
    added, skipped = [], []
    for item in items:
        target, line = (entries, item) if _sender_is_map_entry(item) else (rules, f'{which}|{item}|default')
        if line in target:
            skipped.append(item)
            continue
        target.append(line)
        added.append(item)
        meta[item] = {'comment': comment, 'added': _today().isoformat()}
    _write(SENDER_MAPS[which], ''.join(e + '\n' for e in entries))
    _write(SENDER_RULES, ''.join(e + '\n' for e in rules))
    _json_write(SENDER_META, meta)
    _reload_rspamd()
    return {'added': added, 'skipped': skipped}


def sender_remove(args):
    """Removes entries from every list and rule that holds them."""
    if args.confirm.strip() != 'yes':
        raise EfaError("Type 'yes' to confirm.")
    items = [item.lower() for item in args.entries.replace(',', ' ').split()]
    known = sender_list(args)
    present = {row['entry'] for name in ('allow', 'block', 'rules') for row in known[name]}
    missing = [item for item in items if item not in present]
    if not items or missing:
        raise EfaError(f'Not in the lists, nothing was removed: {" ".join(missing)}')
    for which in SENDER_MAPS:
        _write(SENDER_MAPS[which], ''.join(e + '\n' for e in _read_lines(SENDER_MAPS[which]) if e not in items))
    _write(SENDER_RULES, ''.join(e + '\n' for e in _read_lines(SENDER_RULES)
                                 if e.count('|') != 2 or e.split('|')[1] not in items))
    meta = _json_read(SENDER_META, {})
    for item in items:
        meta.pop(item, None)
    _json_write(SENDER_META, meta)
    _reload_rspamd()
    return {'removed': items}


def sender_move(args):
    """Moves one entry to the other list and keeps its comment."""
    entry, target = args.entry.strip().lower(), args.to.strip()
    if target not in SENDER_MAPS:
        raise EfaError("Target must be 'allow' or 'block'.")
    other = 'block' if target == 'allow' else 'allow'
    entries = _read_lines(SENDER_MAPS[other])
    if entry in entries:
        entries.remove(entry)
        _write(SENDER_MAPS[other], ''.join(e + '\n' for e in entries))
        wanted = _read_lines(SENDER_MAPS[target])
        if entry not in wanted:
            wanted.append(entry)
        _write(SENDER_MAPS[target], ''.join(e + '\n' for e in wanted))
    else:
        rules = _read_lines(SENDER_RULES)
        changed = [f'{target}|{entry}|{line.split("|")[2]}' if line.startswith(f'{other}|{entry}|') else line for line in rules]
        if changed == rules:
            raise EfaError(f'{entry} is not in the {other} list.')
        _write(SENDER_RULES, ''.join(e + '\n' for e in changed))
    _reload_rspamd()
    return {'moved': entry, 'to': target}


def smarthost_set(args):
    """Outbound smarthost, for example [mail.example.org]:587; empty sends directly."""
    host = args.host.strip()
    if host and not SMARTHOST_RE.match(host):
        raise EfaError('Invalid smarthost.')
    _postconf_set('relayhost', host)
    return {'smarthost': host}


def message_size_set(args):
    """Largest accepted message in MB."""
    try:
        size = int(args.megabytes)
    except ValueError:
        raise EfaError('Size must be a number.')
    if not 1 <= size <= 1024:
        raise EfaError('Size must be 1 to 1024 MB.')
    _postconf_set('message_size_limit', str(size * 1024 * 1024))
    return {'message_size_limit_mb': size}


def spam_scores_set(args):
    """Scores for greylisting, spam marking and rejecting; each must be higher than the one before."""
    try:
        values = [float(args.greylist), float(args.mark), float(args.reject)]
    except ValueError:
        raise EfaError('Scores must be numbers.')
    if not 0 < values[0] < values[1] < values[2]:
        raise EfaError('Scores must rise: greylist < mark < reject.')
    _write(ACTIONS_CONF, f'greylist = {values[0]:g};\nrewrite_subject = {values[1]:g};\nreject = {values[2]:g};\n'
                         'subject = "{Spam?} %s";\n' + ACTION_DISCARD)
    _reload_rspamd()
    return {'spam_scores': _actions()}


def greylisting_set(args):
    """Turn rspamd greylisting on or off."""
    enabled = _on_off(args.mode)
    _write(GREYLIST_CONF, 'enabled = true;\n' if enabled else 'enabled = false;\n')
    _reload_rspamd()
    return {'greylisting': enabled}


def sender_list_set(args):
    """Add or remove a sender. Allow only lowers the score; DMARC and virus checks still apply."""
    which, action, address = args.list.strip(), args.action.strip(), args.address.strip().lower()
    if which not in SENDER_MAPS or action not in ('add', 'remove'):
        raise EfaError("List must be 'allow' or 'block', action 'add' or 'remove'.")
    if not SENDER_RE.match(address) and not DOMAIN_RE.match(address):
        raise EfaError('Invalid sender address or domain.')
    entries = _read_lines(SENDER_MAPS[which])
    if action == 'add' and address not in entries:
        entries.append(address)
    elif action == 'remove' and address in entries:
        entries.remove(address)
    _write(SENDER_MAPS[which], ''.join(e + '\n' for e in entries))
    _reload_rspamd()
    return {f'sender_{which}': entries}


def _read_transports():
    entries = {}
    for line in _read_lines(TRANSPORT):
        match = re.match(r'^(\S+)\s+smtp:\[?([^\]\s]+)\]?(:\d+)?$', line)
        if match:
            entries[match.group(1)] = match.group(2) + (match.group(3) or '')
    return entries


def sender_rule_set(args):
    """Rules beyond the lists: IP addresses, patterns with *, or only for one recipient or domain. A word without . @ : matches anywhere."""
    which, action = args.list.strip(), args.action.strip()
    sender, recipient = args.sender.strip().lower(), (args.recipient.strip().lower() or 'default')
    if which not in SENDER_MAPS or action not in ('add', 'remove'):
        raise EfaError("List must be 'allow' or 'block', action 'add' or 'remove'.")
    if not RULE_FROM_RE.match(sender) or sender.strip('*') == '':
        raise EfaError('Invalid sender, IP address or pattern.')
    if recipient != 'default' and not SENDER_RE.match(recipient) and not DOMAIN_RE.match(recipient):
        raise EfaError('Recipient must be an address, a domain or empty.')
    line = f'{which}|{sender}|{recipient}'
    entries = [e for e in _read_lines(SENDER_RULES) if e != line]
    if action == 'add':
        entries.append(line)
    _write(SENDER_RULES, ''.join(e + '\n' for e in entries))
    _reload_rspamd()
    return {'sender_rules': entries}


def transport_set(args):
    """Inbound mail route: which internal server receives mail for a domain."""
    domain, action, dest = args.domain.strip().lower(), args.action.strip(), args.destination.strip()
    if not DOMAIN_RE.match(domain):
        raise EfaError('Invalid domain.')
    if action not in ('add', 'remove'):
        raise EfaError("Action must be 'add' or 'remove'.")
    if action == 'add' and not HOST_RE.match(dest):
        raise EfaError('Invalid destination host.')
    backup = open(TRANSPORT).read() if os.path.exists(TRANSPORT) else ''
    lines = [line for line in backup.splitlines() if line.split()[:1] != [domain]]
    if action == 'add':
        host, _, port = dest.partition(':')
        lines.append(f'{domain}  smtp:[{host}]' + (f':{port}' if port else ''))
    _write(TRANSPORT, '\n'.join(lines) + '\n')
    try:
        subprocess.run(['postmap', TRANSPORT], check=True, capture_output=True)
    except subprocess.CalledProcessError:
        _write(TRANSPORT, backup)
        subprocess.run(['postmap', TRANSPORT], check=False, capture_output=True)
        raise EfaError('postmap failed, nothing changed.')
    subprocess.run(['systemctl', 'reload', 'postfix'], check=False, capture_output=True)
    if os.path.exists(ARCHIVE_FILE):
        _archive_apply(_json_read(ARCHIVE_FILE, {'targets': []})['targets'])
    if os.path.exists(OUTBOUND_FILE):
        _write(OUTBOUND_FILE, json.dumps({**_json_read(OUTBOUND_FILE, {}), 'local_domains': _local_domains()}, indent=1))
    return {'transports': _read_transports()}


def _admin_email():
    for line in _read_lines(EFA_CONFIG):
        if line.startswith('ADMINEMAIL:'):
            return line.split(':', 1)[1]
    return ''


def admin_email_set(args):
    """Address for system alerts; root mail goes there too."""
    email = args.email.strip().lower()
    if not SENDER_RE.match(email):
        raise EfaError('Invalid email address.')
    lines = [line for line in _read_lines(EFA_CONFIG) if not line.startswith('ADMINEMAIL:')]
    _write(EFA_CONFIG, '\n'.join(lines + [f'ADMINEMAIL:{email}']) + '\n')
    if os.path.exists(OUTBOUND_FILE):
        _write(OUTBOUND_FILE, json.dumps({**_json_read(OUTBOUND_FILE, {}), 'admin': email}, indent=1))
    # Keep the raw lines: alias continuation lines depend on their leading whitespace.
    with open(ALIASES) as f:
        aliases = [line for line in f if not line.startswith('root:')]
    _write(ALIASES, ''.join(aliases) + f'root: {email}\n')
    subprocess.run(['newaliases'], check=True, capture_output=True)
    return {'admin_email': email}


def recipient_verification_set(args):
    """Ask the internal mail server if a recipient exists before accepting mail."""
    enabled = _on_off(args.mode)
    items = [i.strip() for i in _postconf('smtpd_recipient_restrictions').split(',') if i.strip()]
    items = [i for i in items if i != 'reject_unverified_recipient']
    if enabled:
        items.append('reject_unverified_recipient')
        _postconf_set('unverified_recipient_reject_reason', 'No user at this address')
        _postconf_set('unverified_recipient_reject_code', '550')
    _postconf_set('smtpd_recipient_restrictions', ', '.join(items))
    return {'recipient_verification': enabled}


def fail2ban_set(args):
    """Ban addresses after failed SSH and SMTP logins."""
    enabled = _on_off(args.mode)
    if shutil.which('fail2ban-client') is None:
        raise EfaError('fail2ban is not installed.')
    if enabled:
        # The jails of eFa that other steps added (efa-web, efa-dkim-api) stay.
        old = open(FAIL2BAN_JAIL).read() if os.path.exists(FAIL2BAN_JAIL) else ''
        kept = ''.join('\n' + part.strip() + '\n' for part in re.findall(r'^\[efa-[a-z0-9-]+\][^\[]*', old, re.M))
        _write(FAIL2BAN_JAIL, '[sshd]\nenabled = true\n\n[postfix-sasl]\nenabled = true\nfilter = postfix[mode=auth]\n' + kept)
        subprocess.run(['systemctl', 'enable', '--now', 'fail2ban'], check=True, capture_output=True)
        subprocess.run(['systemctl', 'restart', 'fail2ban'], check=True, capture_output=True)
    else:
        if os.path.exists(FAIL2BAN_JAIL):
            os.remove(FAIL2BAN_JAIL)
        subprocess.run(['systemctl', 'disable', '--now', 'fail2ban'], check=True, capture_output=True)
    return {'fail2ban': enabled}


# 9i: one address that tries many unknown recipients (address harvesting, flooding with guessed addresses) is banned by
# Fail2Ban, on all nodes of a cluster (9d). Never the own networks, the allowlist of the firewall or the cluster nodes.
HARVEST_FILE = ETC + '/eFa/harvest.json'
HARVEST_JAIL = ETC + '/fail2ban/jail.d/efa-harvest.local'
HARVEST_FILTER = ETC + '/fail2ban/filter.d/efa-harvest.conf'
HARVEST_REGEX = r'NOQUEUE: reject: RCPT from \S+\[<HOST>\]: 550 5\.1\.1 '


def _harvest_settings():
    return {'mode': 'off', 'tries': 10, 'minutes': 10, 'hours': 1, 'allow': [], **_json_read(HARVEST_FILE, {})}


def harvest_ignore(settings_now):
    """The addresses Fail2Ban never bans for this: localhost, relay networks, the firewall allowlist, cluster nodes, own list."""
    found = ['127.0.0.1/8', '::1']
    found += _json_read(OUTBOUND_FILE, {}).get('networks', [])
    found += _json_read(ETC + '/eFa/firewall.json', {}).get('allowlist', [])
    if os.path.exists(os.path.join(ETC, 'eFa', 'cluster')):
        state = _lib('efa_cluster').read_state(ETC)
        found += [node.get('host', '') for node in state.get('nodes', {}).values()] + [state.get('master', {}).get('host', '')]
    found += settings_now['allow']
    return sorted({item for item in found if item})


def harvest_jail(settings_now):
    return ('[efa-harvest]\nenabled = true\nfilter = efa-harvest\nlogpath = /var/log/maillog\nport = smtp,submission,submissions\n'
            f"maxretry = {settings_now['tries']}\nfindtime = {settings_now['minutes'] * 60}\nbantime = {settings_now['hours'] * 3600}\n"
            f"ignoreip = {' '.join(harvest_ignore(settings_now))}\n")


def harvest_set(args):
    """On or off, how many unknown recipients in how many minutes, how long the ban lasts, and addresses never banned for it."""
    settings_now = _harvest_settings()
    mode = 'on' if _on_off(args.mode) else 'off'
    for key, low, high in (('tries', 3, 100), ('minutes', 1, 1440), ('hours', 1, 720)):
        value = (getattr(args, key) or '').strip()
        if value:
            if not value.isdigit() or not low <= int(value) <= high:
                raise EfaError(f'{key}: {low} to {high}.')
            settings_now[key] = int(value)
    if getattr(args, 'allow', None) is not None and args.allow.strip() != '':
        allow = [item.strip() for item in args.allow.replace(',', ' ').split() if item.strip() and item.strip() != '-']
        for item in allow:
            try:
                ipaddress.ip_network(item, strict=False)
            except ValueError:
                raise EfaError(f'{item} is no address or network.')
        settings_now['allow'] = allow
    settings_now['mode'] = mode
    _json_write(HARVEST_FILE, settings_now)
    if mode == 'on':
        _write(HARVEST_FILTER, f'[Definition]\nfailregex = {HARVEST_REGEX}\nignoreregex =\n')
        _write(HARVEST_JAIL, harvest_jail(settings_now))
    elif os.path.exists(HARVEST_JAIL):
        os.remove(HARVEST_JAIL)
    if shutil.which('fail2ban-client'):
        _platform().service_try_restart('fail2ban')
    return harvest_status(None)


def _harvest_banned():
    done = subprocess.run(['fail2ban-client', 'status', 'efa-harvest'], capture_output=True, text=True) if shutil.which('fail2ban-client') else None
    match = re.search(r'Banned IP list:\s*(.*)', done.stdout) if done and done.returncode == 0 else None
    return match.group(1).split() if match else []


def harvest_top(lines, limit=10):
    """The addresses with the most unknown recipients in these mail log lines."""
    counts = {}
    pattern = re.compile(HARVEST_REGEX.replace('<HOST>', r'([0-9A-Fa-f:.]+)'))
    for line in lines:
        match = pattern.search(line)
        if match:
            counts[match.group(1)] = counts.get(match.group(1), 0) + 1
    return [{'address': address, 'unknown_recipients': count} for address, count in sorted(counts.items(), key=lambda item: -item[1])[:limit]]


def harvest_status(_args):
    settings_now = _harvest_settings()
    lines = []
    if os.path.exists('/var/log/maillog'):
        with open('/var/log/maillog', errors='replace') as f:
            lines = f.readlines()[-200000:]
    warnings = harvest_warnings(_postconf('smtpd_recipient_restrictions'), _postconf('relay_recipient_maps'), _postconf('relay_domains'))
    return {**{key: settings_now[key] for key in ('mode', 'tries', 'minutes', 'hours', 'allow')}, 'never_banned': harvest_ignore(settings_now),
            'banned_now': _harvest_banned() if settings_now['mode'] == 'on' else [], 'top_sources': harvest_top(lines), 'warnings': warnings}


def harvest_warnings(restrictions, recipient_maps, relay_domains):
    """Without a check of the recipients Postfix takes every address of the relay domains: no 550 5.1.1, nothing to ban."""
    if relay_domains.strip() and not recipient_maps.strip() and 'reject_unverified_recipient' not in restrictions:
        return ['No recipient check: every address of the own domains is accepted, so address harvesting is not seen. '
                'Switch on recipient verification (recipient-verification-set) or list the recipients.']
    return []


# 9l: what the start page draws. The setup only (mode, nodes with their own key, delivery targets, relay senders), never a mail.
FLOW_FILE = ETC + '/eFa/flow.json'
CLOUD_HOSTS = ('outlook.com', 'office365.com', 'google.com', 'googlemail.com', 'gmail.com')


def flow_targets(transport, relayhost=''):
    """The next hops of delivery from the transport table: name and whether it is a cloud service."""
    hosts = []
    for line in transport.splitlines():
        parts = line.split()
        if len(parts) >= 2 and not line.lstrip().startswith('#') and ':' in parts[1]:
            host = parts[1].split(':', 1)[1].strip('[]').split(']')[0].split(':')[0]
            if host and host not in hosts:
                hosts.append(host)
    if relayhost:
        host = relayhost.strip('[]').split(']')[0].split(':')[0]
        if host and host not in hosts:
            hosts.append(host)
    return [{'name': host, 'kind': 'cloud' if host.lower().endswith(CLOUD_HOSTS) else 'server'} for host in hosts]


def flow_status(_args):
    cluster_dir = os.path.join(ETC, 'eFa', 'cluster')
    nodes, mode = [], 'single'
    if os.path.exists(cluster_dir):
        cluster, base, state = _cluster_parts()
        if state:
            mode = state.get('mode', 'master-client')
            with open(os.path.join(base, 'node.crt')) as f:
                own = f.read()
            until = cluster.cert_end(own)
            nodes.append({'name': state['name'], 'self': True, 'role': state['role'], 'state': 'ok',
                          'fingerprint': cluster.fingerprint_pem(own)[:23], 'until': time.strftime('%Y-%m-%d', time.localtime(until)),
                          'expiring': until - time.time() < 30 * 86400})
            peers = sorted(state.get('nodes', {}).items()) if state['role'] == 'master' else [(state['master'].get('name', 'master'), state['master'])]
            for name, peer in peers:
                try:
                    cluster.call(base, peer['host'], peer['port'], '/v1/status', timeout=2)
                    reached = 'ok'
                except (OSError, ValueError):
                    reached = 'down'
                nodes.append({'name': name, 'self': False, 'role': 'master' if state['role'] == 'client' else 'client', 'state': reached,
                              'fingerprint': (peer.get('fingerprint') or '')[:23]})
    if not nodes:
        nodes = [{'name': _postconf('myhostname') or socket.getfqdn(), 'self': True, 'role': 'single', 'state': 'ok'}]
    transport = open(ETC + '/postfix/transport').read() if os.path.exists(ETC + '/postfix/transport') else ''
    relays = [item for item in _json_read(OUTBOUND_FILE, {}).get('networks', [])
              if not item.startswith(('127.', '::1', '[::1]'))]
    return {'mode': mode, 'nodes': nodes, 'targets': flow_targets(transport, _postconf('relayhost'))[:8], 'relay_networks': len(relays),
            'animation': _json_read(FLOW_FILE, {}).get('animation', 'on')}


def flow_set(args):
    """The moving letters of the start page on or off."""
    _json_write(FLOW_FILE, {**_json_read(FLOW_FILE, {}), 'animation': 'on' if _on_off(args.animation) else 'off'})
    return {'animation': _json_read(FLOW_FILE, {})['animation']}


def backup_set(args):
    """Turn the automatic daily backup on or off."""
    enabled = _on_off(args.mode)
    if enabled:
        if os.path.exists(BACKUP_DISABLED):
            os.remove(BACKUP_DISABLED)
    else:
        _write(BACKUP_DISABLED, '')
    return {'auto_backup': enabled}


def _confirm(args):
    if args.confirm.strip() != 'yes':
        raise EfaError("Type 'yes' to confirm.")


def update_now(args):
    """Install all available updates, the same way as update-system without a reboot: backup, script check, time window."""
    _confirm(args)
    return update_system(argparse.Namespace(confirm='yes', reboot='off', reboot_confirm='', dry_run=''))


def reboot_host(args):
    """Restart the host in one minute."""
    _confirm(args)
    subprocess.run(['shutdown', '-r', '+1'], check=True, capture_output=True)
    return {'reboot': 'in one minute', 'cancel': 'shutdown -c'}


def halt_host(args):
    """Shut the host down in one minute."""
    _confirm(args)
    subprocess.run(['shutdown', '-h', '+1'], check=True, capture_output=True)
    return {'halt': 'in one minute', 'cancel': 'shutdown -c'}


def _mysql_env():
    env = dict(os.environ)
    for line in _read_lines(MYSQL_CONFIG):
        if line.startswith('MYSQLROOTPWD:'):
            env['MYSQL_PWD'] = line.split(':', 1)[1]
    return env


SECRETS_SEEN = []


def _secrets(count, prompt):
    """Reads passwords from a prompt, or from stdin when the web interface calls. Never from an argument."""
    if sys.stdin.isatty():
        values = [getpass.getpass(f'{prompt}: ') for _ in range(count)]
    else:
        values = [sys.stdin.readline().rstrip('\n') for _ in range(count)]
    SECRETS_SEEN.extend(values)
    return values


PASSWORD_ATTEMPTS = 3
PASSWORD_DIFFER = 'The two entries are not the same.'


def password_twice(prompt):
    """A new password, asked twice. On a terminal up to three attempts, otherwise two lines from stdin. Differing entries change nothing."""
    if not sys.stdin.isatty():
        first, second = _secrets(2, prompt)
        if first != second:
            raise EfaError(PASSWORD_DIFFER + ' Nothing was changed.')
        return first
    for _attempt in range(PASSWORD_ATTEMPTS):
        first, second = getpass.getpass(f'{prompt}: '), getpass.getpass('Repeat it: ')
        if first == second:
            return first
        print(PASSWORD_DIFFER, file=sys.stderr)
    raise EfaError(f'{PASSWORD_DIFFER} Stopped after {PASSWORD_ATTEMPTS} attempts, nothing was changed.')


def _new_password():
    first, second = _secrets(2, 'Password, then again')
    if first != second:
        raise EfaError('The two passwords are not the same.')
    if len(first) < 12:
        raise EfaError('Backup password: at least 12 characters.')
    return first


def _gpg(password, *args):
    # A temp home keeps gpg away from any keyring. --passphrase-fd keeps the password out of the process list.
    with tempfile.TemporaryDirectory() as home:
        os.chmod(home, 0o700)
        return subprocess.run(['gpg', '--homedir', home, '--batch', '--yes', '--pinentry-mode', 'loopback',
                               '--passphrase-fd', '0'] + list(args), input=password + '\n', text=True, capture_output=True)


def _backup_new_name():
    os.makedirs(BACKUP_DIR, mode=0o700, exist_ok=True)
    os.chmod(BACKUP_DIR, 0o700)
    # A name used twice would overwrite a backup, for example the one about to be restored.
    while True:
        name = time.strftime('efa-backup-%Y%m%d-%H%M%S.tar.gz')
        if not (os.path.exists(f'{BACKUP_DIR}/{name}') or os.path.exists(f'{BACKUP_DIR}/{name}.gpg')):
            return name
        time.sleep(1)


def backup_password_set(args):
    """Stored password for automatic backups. Losing it makes those backups unusable. It is never shown again."""
    if args.mode.strip() == 'remove':
        if os.path.exists(BACKUP_PASSWORD):
            os.remove(BACKUP_PASSWORD)
        return {'backup_password': 'removed'}
    password = _new_password()
    os.makedirs(os.path.dirname(BACKUP_PASSWORD), exist_ok=True)
    fd = os.open(BACKUP_PASSWORD + '.tmp', os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, 'w') as f:
        f.write(password + '\n')
    os.replace(BACKUP_PASSWORD + '.tmp', BACKUP_PASSWORD)
    return {'backup_password': 'set'}


def _backup_stored_password():
    if os.path.exists(BACKUP_PASSWORD):
        with open(BACKUP_PASSWORD) as f:
            return f.read().rstrip('\n')
    return None


# External backup targets: only encrypted backups leave the host, right after a backup, with a bandwidth limit. Off by default.
BACKUP_TARGETS = ETC + '/eFa/backup-targets.json'
BACKUP_TARGET_DIR = ETC + '/eFa/backup-targets'
BACKUP_TARGET_RE = re.compile(r'^[a-z0-9][a-z0-9-]{0,31}$')


def sigv4_headers(method, host, path, query, headers, payload_hash, region, service, access, secret, amz_date):
    """AWS Signature Version 4: the Authorization header for one request, over the given headers."""
    names = sorted(name.lower() for name in headers)
    canonical_headers = ''.join(f'{name}:{str(headers[next(k for k in headers if k.lower() == name)]).strip()}\n' for name in names)
    signed = ';'.join(names)
    canonical_query = '&'.join(f'{urllib.parse.quote(k, safe="-_.~")}={urllib.parse.quote(v, safe="-_.~")}' for k, v in sorted(query))
    request = '\n'.join([method, path, canonical_query, canonical_headers, signed, payload_hash])
    scope = f'{amz_date[:8]}/{region}/{service}/aws4_request'
    to_sign = '\n'.join(['AWS4-HMAC-SHA256', amz_date, scope, hashlib.sha256(request.encode()).hexdigest()])
    key = ('AWS4' + secret).encode()
    for part in (amz_date[:8], region, service, 'aws4_request'):
        key = hmac.new(key, part.encode(), hashlib.sha256).digest()
    signature = hmac.new(key, to_sign.encode(), hashlib.sha256).hexdigest()
    return f'AWS4-HMAC-SHA256 Credential={access}/{scope}, SignedHeaders={signed}, Signature={signature}'


def _s3_call(target, method, key='', query=(), body_path=None, payload_hash=None):
    """One signed request to an S3 bucket, path style. A file body is streamed with the bandwidth limit of the target."""
    import http.client
    parts = urllib.parse.urlsplit(target['endpoint'])
    path = '/' + urllib.parse.quote(target['bucket']) + ('/' + urllib.parse.quote(key) if key else '')
    amz_date = datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%dT%H%M%SZ')
    payload_hash = payload_hash or hashlib.sha256(b'').hexdigest()
    headers = {'host': parts.netloc, 'x-amz-date': amz_date, 'x-amz-content-sha256': payload_hash}
    headers['Authorization'] = sigv4_headers(method, parts.netloc, path, list(query), {k: v for k, v in headers.items()}, payload_hash,
                                             target['region'], 's3', target['access_key'], target['secret_key'], amz_date)
    body = None
    if body_path:
        size = os.path.getsize(body_path)
        headers['Content-Length'] = str(size)
        limit = target.get('limit_kbps', 0) * 1024 // 8

        def chunks():
            with open(body_path, 'rb') as f:
                while True:
                    started = time.time()
                    chunk = f.read(65536)
                    if not chunk:
                        return
                    yield chunk
                    if limit:
                        time.sleep(max(0.0, len(chunk) / limit - (time.time() - started)))
        body = chunks()
    connection = http.client.HTTPSConnection(parts.netloc, timeout=120, context=ssl.create_default_context())
    try:
        connection.request(method, path + ('?' + urllib.parse.urlencode(list(query)) if query else ''), body=body, headers=headers)
        reply = connection.getresponse()
        data = reply.read()
    finally:
        connection.close()
    if reply.status >= 300:
        raise EfaError(f'S3 answered {reply.status}: {data[:200].decode("utf-8", "replace")}')
    return data


def _sftp_call(target, commands):
    """Runs sftp commands as a batch, with the key, the known host key and the bandwidth limit of the target."""
    argv = ['sftp', '-b', '-', '-i', target['key_file'], '-P', str(target.get('port', 22)), '-o', 'BatchMode=yes', '-o', 'StrictHostKeyChecking=yes',
            '-o', f'UserKnownHostsFile={BACKUP_TARGET_DIR}/{target["name"]}.known_hosts']
    if target.get('limit_kbps'):
        argv += ['-l', str(target['limit_kbps'])]
    done = subprocess.run(argv + [f"{target['user']}@{target['host']}"], input='\n'.join(commands) + '\n', capture_output=True, text=True, timeout=3600)
    if done.returncode != 0:
        raise EfaError('sftp failed: ' + done.stderr[-200:].strip())
    return done.stdout


def backup_old_names(names, keep_days, now):
    """Backup names past the days of a target, from the date in the name."""
    old = []
    for name in names:
        found = re.search(r'efa-backup-(?:upload-|config-)?(\d{8})-\d{6}', name)
        if found and (now - datetime.datetime.strptime(found.group(1), '%Y%m%d')).days > keep_days:
            old.append(name)
    return old


def _target_upload(target, path):
    """One encrypted backup to one target, its checksum checked, and backups past the days of the target removed there."""
    name = os.path.basename(path)
    with open(path, 'rb') as f:
        checksum = hashlib.sha256(f.read()).hexdigest()
    now = datetime.datetime.now()
    if target['kind'] == 's3':
        prefix = target.get('prefix', '').strip('/')
        key = (prefix + '/' if prefix else '') + name
        # S3 refuses the upload if the data does not match this checksum.
        _s3_call(target, 'PUT', key, body_path=path, payload_hash=checksum)
        listing = _s3_call(target, 'GET', query=[('list-type', '2'), ('prefix', prefix + '/' if prefix else '')]).decode('utf-8', 'replace')
        keys = re.findall(r'<Key>([^<]+)</Key>', listing)
        for old in backup_old_names(keys, target['keep_days'], now):
            _s3_call(target, 'DELETE', old)
    else:
        folder = target.get('path', '.').rstrip('/') or '.'
        with tempfile.NamedTemporaryFile('w', suffix='.sha256', delete=False) as side:
            side.write(f'{checksum}  {name}\n')
        try:
            _sftp_call(target, [f'put {path} {folder}/{name}', f'put {side.name} {folder}/{name}.sha256'])
        finally:
            os.remove(side.name)
        names = [line.strip().rsplit('/', 1)[-1] for line in _sftp_call(target, [f'ls -1 {folder}']).splitlines() if 'efa-backup-' in line]
        old = backup_old_names(names, target['keep_days'], now)
        if old:
            _sftp_call(target, [f'-rm {folder}/{item}' for item in old])
    return checksum


def _backup_upload(name):
    """After a backup: the encrypted file to each target. A failed target mails the admin and sends an event; the others go on."""
    targets = _json_read(BACKUP_TARGETS, {})
    if not targets:
        return []
    if not name.endswith('.gpg'):
        _admin_notify('eFa: backup not uploaded', f'{name} is not encrypted and stays on this host. Set a backup password.')
        # The status of each target shows it too, not only the mail.
        for key, target in targets.items():
            target.update(last=time.strftime('%Y-%m-%d %H:%M:%S'), last_result='not encrypted, not uploaded: set a backup password')
            _event('backup_upload_failed', 'warning', target=key)
        _backup_targets_write(targets)
        return [{'target': key, 'result': target['last_result']} for key, target in sorted(targets.items())]
    results = []
    for key, target in sorted(targets.items()):
        try:
            checksum = _target_upload({**target, 'name': key}, f'{BACKUP_DIR}/{name}')
            target.update(last=time.strftime('%Y-%m-%d %H:%M:%S'), last_result='ok', last_sha256=checksum)
        except (EfaError, OSError, ssl.SSLError, ValueError) as err:
            target.update(last=time.strftime('%Y-%m-%d %H:%M:%S'), last_result=str(err)[:300])
            _admin_notify('eFa: backup upload failed', f'The backup {name} did not reach the target {key}: {err}')
            _event('backup_upload_failed', 'warning', target=key)
        results.append({'target': key, 'result': target['last_result']})
    _backup_targets_write(targets)
    return results


def _backup_targets_write(targets):
    fd = os.open(BACKUP_TARGETS + '.tmp', os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, 'w') as f:
        json.dump(targets, f, indent=1)
    os.replace(BACKUP_TARGETS + '.tmp', BACKUP_TARGETS)


def backup_target_list(_args):
    """The external backup targets and their last upload. Keys and passwords are never shown."""
    rows = []
    for key, target in sorted(_json_read(BACKUP_TARGETS, {}).items()):
        where = f"{target['endpoint']}/{target['bucket']}/{target.get('prefix', '')}" if target['kind'] == 's3' else \
            f"sftp://{target['user']}@{target['host']}:{target.get('port', 22)}/{target.get('path', '')}"
        rows.append({'name': key, 'kind': target['kind'], 'where': where, 'keep_days': target['keep_days'], 'limit_kbps': target.get('limit_kbps', 0),
                     'last': target.get('last'), 'last_result': target.get('last_result')})
    return {'targets': rows}


def backup_target_set(args):
    """Add or remove an external backup target, S3 or SFTP. The secret of S3 comes twice on stdin, never as an argument."""
    name, action = args.name.strip().lower(), args.action.strip()
    if not BACKUP_TARGET_RE.match(name) or action not in ('add', 'remove'):
        raise EfaError("A name of small letters, digits and dashes, and the action 'add' or 'remove'.")
    targets = _json_read(BACKUP_TARGETS, {})
    if action == 'remove':
        if targets.pop(name, None) is None:
            raise EfaError('No such target.')
        _backup_targets_write(targets)
        # Its host key goes with it: a new target of the same name takes the key of its server anew.
        if os.path.exists(f'{BACKUP_TARGET_DIR}/{name}.known_hosts'):
            os.remove(f'{BACKUP_TARGET_DIR}/{name}.known_hosts')
        return backup_target_list(None)
    kind = (args.kind or '').strip()
    keep = (args.keep_days or '').strip() or '30'
    limit = (args.limit_kbps or '').strip() or '0'
    if not keep.isdigit() or not 1 <= int(keep) <= 3650 or not limit.isdigit():
        raise EfaError('Keep for 1 to 3650 days; the limit in kbit/s, 0 for none.')
    target = {'kind': kind, 'keep_days': int(keep), 'limit_kbps': int(limit)}
    if kind == 's3':
        endpoint = https_url((args.endpoint or '').strip().rstrip('/'))
        bucket, region, access = (args.bucket or '').strip(), (args.region or '').strip() or 'us-east-1', (args.access_key or '').strip()
        if not endpoint or not re.fullmatch(r'[a-z0-9][a-z0-9.-]{1,62}', bucket) or not re.fullmatch(r'[\w-]{1,32}', region) or not re.fullmatch(r'[\w]{8,128}', access):
            raise EfaError('S3: an https endpoint, a bucket, a region and an access key.')
        secret = password_twice('Secret key')
        if not 8 <= len(secret) <= 256:
            raise EfaError('The secret key looks wrong.')
        target.update(endpoint=endpoint, bucket=bucket, region=region, access_key=access, secret_key=secret,
                      prefix=re.sub(r'[^\w./-]', '', (args.path or '').strip('/')))
    elif kind == 'sftp':
        host, user, key_file = (args.host or '').strip().lower(), (args.user or '').strip(), (args.key_file or '').strip()
        port = (args.port or '').strip() or '22'
        if not DOMAIN_RE.match(host) and not re.fullmatch(r'[0-9a-f.:]+', host) or not USER_RE.match(user) or not port.isdigit():
            raise EfaError('SFTP: a host, a user and a port.')
        if not key_file.startswith('/') or not os.path.exists(key_file) or oct(os.stat(key_file).st_mode)[-2:] != '00':
            raise EfaError('SFTP: the path of a private key that only root can read.')
        os.makedirs(BACKUP_TARGET_DIR, mode=0o700, exist_ok=True)
        # The host key is taken now and shown: compare it with the one of the server before the first backup goes there.
        keys = subprocess.run(['ssh-keyscan', '-p', port, '-T', '10', host], capture_output=True, text=True, timeout=30).stdout
        if not keys.strip():
            raise EfaError('The SFTP server does not answer.')
        _write(f'{BACKUP_TARGET_DIR}/{name}.known_hosts', keys)
        os.chmod(f'{BACKUP_TARGET_DIR}/{name}.known_hosts', 0o600)
        target.update(host=host, user=user, port=int(port), key_file=key_file, path=re.sub(r'[^\w./-]', '', (args.path or '').strip()) or '.')
        fingerprints = subprocess.run(['ssh-keygen', '-lf', f'{BACKUP_TARGET_DIR}/{name}.known_hosts'], capture_output=True, text=True).stdout
        target['host_keys'] = fingerprints.strip().splitlines()
    else:
        raise EfaError("Kind 's3' or 'sftp'.")
    targets[name] = target
    _backup_targets_write(targets)
    return {**backup_target_list(None), 'host_keys': target.get('host_keys', [])}


def backup_target_test(args):
    """Upload the newest encrypted backup to one target now."""
    targets = _json_read(BACKUP_TARGETS, {})
    name = args.name.strip().lower()
    if name not in targets:
        raise EfaError('No such target.')
    newest = sorted(glob.glob(f'{BACKUP_DIR}/efa-backup-*.gpg'), key=os.path.getmtime)
    if not newest:
        raise EfaError('No encrypted backup yet: make one with a backup password.')
    return {'target': name, 'backup': os.path.basename(newest[-1]), 'sha256': _target_upload({**targets[name], 'name': name}, newest[-1])}


def backup_now_command(args):
    """Back up now, then the encrypted file goes to the external targets."""
    result = backup_now(args)
    uploads = _backup_upload(result['backup'])
    return {**result, 'uploads': uploads} if uploads else result


def backup_now(args):
    """Back up eFa settings, DKIM keys and the database; backups older than 5 days are removed."""
    mode = (getattr(args, 'encrypt', '') or '').strip()
    if mode not in ('', 'on', 'off'):
        raise EfaError("Encrypt must be 'on' or 'off'.")
    password = None
    if mode == 'on':
        lines = _secrets(2, 'Password, then again')
        if lines[0] or lines[1]:
            if lines[0] != lines[1]:
                raise EfaError('The two passwords are not the same.')
            if len(lines[0]) < 12:
                raise EfaError('Backup password: at least 12 characters.')
            password = lines[0]
        elif not os.path.exists(BACKUP_PASSWORD):
            raise EfaError('Enter a password, no backup password is stored.')
    if mode != 'off' and password is None:
        password = _backup_stored_password()
    return _backup_make(password)


def _backup_make(password, database=True, prefix=''):
    name = _backup_new_name().replace('efa-backup-', 'efa-backup-' + prefix)
    with tempfile.TemporaryDirectory(dir=BACKUP_DIR) as tmp:
        dump = None
        if database and shutil.which('mysqldump'):
            dump = tmp + '/backup.sql'
            with open(dump, 'w') as f:
                subprocess.run(['mysqldump', '--user=root', '--all-databases', '--events', '--single-transaction'],
                               stdout=f, env=_mysql_env(), check=True, stderr=subprocess.PIPE)
        path = f'{BACKUP_DIR}/{name}'
        with tarfile.open(path + '.tmp', 'w:gz') as tar:
            os.chmod(path + '.tmp', 0o600)
            for item in BACKUP_PATHS:
                if os.path.exists(item):
                    tar.add(item, arcname=item.lstrip('/'))
            if dump:
                tar.add(dump, arcname='backup.sql')
        if password is not None:
            done = _gpg(password, '--symmetric', '--cipher-algo', 'AES256', '--output', path + '.gpg.tmp', path + '.tmp')
            os.remove(path + '.tmp')
            if done.returncode != 0:
                raise EfaError('Encryption failed, no backup was kept.')
            os.chmod(path + '.gpg.tmp', 0o600)
            os.replace(path + '.gpg.tmp', path + '.gpg')
            name, path = name + '.gpg', path + '.gpg'
        else:
            os.replace(path + '.tmp', path)
    cutoff = time.time() - BACKUP_KEEP_DAYS * 86400
    for old in glob.glob(f'{BACKUP_DIR}/efa-backup-*'):
        if os.path.getmtime(old) < cutoff and os.path.isfile(old):
            os.remove(old)
    return {'backup': name, 'size': os.path.getsize(path), 'database': bool(dump), 'encrypted': password is not None}


def backup_list(_args):
    """List available backups."""
    rows = []
    for path in sorted(glob.glob(f'{BACKUP_DIR}/efa-backup-*.tar.gz') + glob.glob(f'{BACKUP_DIR}/efa-backup-*.tar.gz.gpg')):
        name = os.path.basename(path)
        rows.append({'name': name, 'size_mb': round(os.path.getsize(path) / 1048576, 1),
                     'date': time.strftime('%Y-%m-%d %H:%M', time.localtime(os.path.getmtime(path))),
                     'encrypted': name.endswith('.gpg')})
    rows.sort(key=lambda row: row['name'].replace('upload-', ''))
    return {'backups': rows, 'backup_password_stored': os.path.exists(BACKUP_PASSWORD)}


def _backup_path(name):
    name = name.strip()
    if not BACKUP_NAME_RE.match(name) or not os.path.exists(f'{BACKUP_DIR}/{name}'):
        raise EfaError('Unknown backup.')
    return f'{BACKUP_DIR}/{name}'


def _backup_web_check(path):
    """Through the web interface a backup leaves this host only encrypted: it holds the database and private keys."""
    if os.environ.get('SUDO_USER') == 'efa-web' and not path.endswith('.gpg'):
        raise EfaError('Only encrypted backups can be downloaded. Set a backup password, then make a new backup.')


def backup_download(args):
    """Where a backup is, with size and checksum, to fetch it from the console."""
    path = _backup_path(args.name)
    _backup_web_check(path)
    with open(path, 'rb') as f:
        checksum = hashlib.sha256(f.read()).hexdigest()
    return {'path': path, 'size': os.path.getsize(path), 'sha256': checksum}


def backup_read(args):
    """Writes the raw backup to stdout for the web download, and logs it."""
    path = _backup_path(args.name)
    _backup_web_check(path)
    _audit(f'backup {os.path.basename(path)} downloaded by {_dmarc_who()}')
    with open(path, 'rb') as f:
        shutil.copyfileobj(f, sys.stdout.buffer)
    sys.stdout.buffer.flush()


def backup_import(args):
    """Stores an uploaded backup from stdin in the backup folder. It can then be restored from the list."""
    os.makedirs(BACKUP_DIR, mode=0o700, exist_ok=True)
    if args.file and os.environ.get('SUDO_USER') == 'efa-web':
        raise EfaError('Not allowed from the web interface, upload the file instead.')
    data = sys.stdin.buffer.read() if not args.file else open(args.file, 'rb').read()
    return {'imported': _backup_store(data)}


def _backup_store(data):
    if data[:2] == b'\x1f\x8b':
        suffix = '.tar.gz'
    elif data[:1] in (b'\x8c', b'\xc3') or data[:5] == b'-----':
        suffix = '.tar.gz.gpg'
    else:
        raise EfaError('This is no eFa backup: neither .tar.gz nor .tar.gz.gpg.')
    name = time.strftime('efa-backup-upload-%Y%m%d-%H%M%S') + suffix
    fd = os.open(f'{BACKUP_DIR}/{name}', os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, 'wb') as f:
        f.write(data)
    if suffix == '.tar.gz':
        try:
            with tarfile.open(f'{BACKUP_DIR}/{name}') as tar:
                tar.getmembers()
        except tarfile.TarError:
            os.remove(f'{BACKUP_DIR}/{name}')
            raise EfaError('This file is damaged or no backup, it was not kept.')
    return name


def _restore_unsafe(members, allowed):
    """A backup may come from an upload: no way out of the allowed folders, and no device files. Returns the first bad name."""
    links = {member.name for member in members if member.issym()}
    for member in members:
        parts = member.name.split('/')
        if '..' in parts or member.name.startswith('/'):
            return member.name
        if not (member.isreg() or member.isdir() or member.issym() or member.islnk()):
            return member.name
        # Links may point anywhere, real configs do. But nothing may be written through one.
        if any('/'.join(parts[:i]) in links for i in range(1, len(parts))):
            return member.name
        if member.islnk():
            target = os.path.normpath(member.linkname)
            if not any(target == x or target.startswith(x + '/') for x in allowed):
                return member.name
    return None


# Written by efa5-export into a backup: the settings of an eFa 5.0, applied once by the restore.
EFA5_IMPORT = ETC + '/eFa/efa5-import'


def _lib(name):
    """A library of eFa: the copy next to this file in the source tree first, then the installed one."""
    import importlib
    for folder in ('/usr/lib/eFa/python', os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', 'lib', 'eFa', 'python')):
        if folder not in sys.path:
            sys.path.insert(0, folder)
    return importlib.import_module(name)


def _efa5_convert():
    return _lib('efa5_convert')


def efa5_apply(run_efactl=None):
    """Applies the eFa 5.0 settings of a restored efa5-export file, through the same commands as the in-place migration.
    Returns what was taken over, adjusted and not taken over; the plan is renamed so a later restore does not apply it again."""
    convert = _efa5_convert()
    # The restore creates folders world-readable; the keys and SASL passwords in here are for root only.
    for folder, _dirs, _files in os.walk(EFA5_IMPORT):
        os.chmod(folder, 0o700)
    with open(EFA5_IMPORT + '/plan.json') as f:
        plan = json.load(f)
    failed = []
    if run_efactl is None:
        def run_efactl(*step):
            # As root, like the migration: the web user started the restore, and that was allowed and logged.
            env = {k: v for k, v in os.environ.items() if k != 'SUDO_USER'}
            done = subprocess.run([sys.executable, os.path.abspath(sys.argv[0]), *step], capture_output=True, text=True, env=env)
            return done.returncode == 0, (done.stdout + done.stderr)[-200:].strip()
    for table in plan['tables']:
        source = f'{EFA5_IMPORT}/postfix/{table}'
        if os.path.exists(source):
            shutil.copyfile(source, f'{ETC}/postfix/{table}')
            os.chmod(f'{ETC}/postfix/{table}', 0o600 if table == 'sasl_passwd' else 0o644)
            if subprocess.run(['postmap', f'{ETC}/postfix/{table}'], capture_output=True).returncode != 0:
                failed.append(f'postmap {table}')
    own = set(_postconf_names())
    taken, _left = convert.fresh_postconf(plan['old_postconf'], own=own)
    for name, value in taken.items():
        if subprocess.run(['postconf', '-e', f'{name} = {value}'], capture_output=True).returncode != 0:
            failed.append(f'postconf {name}')
    for step in convert.settings_steps(plan, EFA5_IMPORT, fresh=True):
        ok, text = run_efactl(*step)
        if not ok:
            failed.append(f'{step[0]}: {text}')
    report = convert.fresh_report(plan, own=own)
    report['failed'] = failed
    _write(EFA5_IMPORT + '/report.txt', convert.report_text(report) + ''.join(f'Failed: {item}\n' for item in failed))
    os.replace(EFA5_IMPORT + '/plan.json', EFA5_IMPORT + '/plan.applied.json')
    _audit(f'eFa 5.0 settings applied by {_dmarc_who()}: {len(report["taken"])} taken over, {len(failed)} failed')
    return report


def _postconf_names():
    """The names this host sets in main.cf, before anything of the old host is applied."""
    out = subprocess.run(['postconf', '-n'], capture_output=True, text=True).stdout
    return [line.split('=', 1)[0].strip() for line in out.splitlines() if '=' in line]


def restore(args):
    """Restore a backup. It is checked first, then a backup of the current state is made.
    A file from efa5-export also applies the eFa 5.0 settings in it, once."""
    _confirm(args)
    file = (getattr(args, 'file', '') or '').strip()
    if file and os.environ.get('SUDO_USER') == 'efa-web':
        # Would let a web session read any file on the system through the backup list.
        raise EfaError('Not allowed from the web interface, upload the file instead.')
    if file:
        with open(file, 'rb') as f:
            name = _backup_store(f.read())
    else:
        name = args.name.strip()
    path = _backup_path(name)
    with tempfile.TemporaryDirectory(dir=BACKUP_DIR) as tmp:
        plain = path
        if name.endswith('.gpg'):
            password = _secrets(1, 'Backup password')[0]
            plain = tmp + '/backup.tar.gz'
            if _gpg(password, '--decrypt', '--output', plain, path).returncode != 0:
                raise EfaError('Wrong password or damaged backup, nothing was changed.')
        allowed = tuple(item.lstrip('/') for item in BACKUP_PATHS)
        try:
            with tarfile.open(plain) as tar:
                members = [m for m in tar.getmembers()
                           if m.name == 'backup.sql' or any(m.name == x or m.name.startswith(x + '/') for x in allowed)]
                unsafe = _restore_unsafe(members, allowed)
                if unsafe:
                    raise EfaError(f'Unsafe entry in this backup, nothing was changed: {unsafe}')
                if not members:
                    raise EfaError('This file holds no eFa settings, nothing was changed.')
                safety = backup_now(None)['backup']
                _write(RESTORE_RUNNING, 'restore\n')
                tar.extractall(tmp, members=members, filter='tar')
        except tarfile.TarError:
            raise EfaError('Damaged backup, nothing was changed.')
        try:
            for member in members:
                if member.name == 'backup.sql' or member.isdir():
                    continue
                target = '/' + member.name
                os.makedirs(os.path.dirname(target), exist_ok=True)
                # Copying a symlink fails when the target already exists.
                if member.issym() and os.path.lexists(target):
                    os.remove(target)
                shutil.copy2(f'{tmp}/{member.name}', target, follow_symlinks=False)
                os.chown(target, member.uid, member.gid, follow_symlinks=False)
            dump = tmp + '/backup.sql'
            if os.path.exists(dump):
                with open(dump) as f:
                    subprocess.run(['mysql', '--user=root'], stdin=f, env=_mysql_env(), check=True, capture_output=True)
        finally:
            os.remove(RESTORE_RUNNING)
    # Copied files keep the label of the temp directory, and SELinux would lock services out of them.
    subprocess.run(['restorecon', '-R'] + [item for item in BACKUP_PATHS if os.path.exists(item)], check=False,
                   capture_output=True)
    result = {'restored': name, 'safety_backup': safety, 'files': len(members)}
    if os.path.exists(EFA5_IMPORT + '/plan.json'):
        result['efa5_import'] = efa5_apply()
    for service in ('postfix', 'rspamd', 'nginx', 'unbound'):
        subprocess.run(['systemctl', 'reload-or-restart', service], check=False, capture_output=True)
    return result


def _audit(text):
    os.makedirs(os.path.dirname(AUDIT_LOG), exist_ok=True)
    with open(AUDIT_LOG, 'a') as log:
        log.write(f'{time.strftime("%Y-%m-%d %H:%M:%S")} {text}\n')
    os.chmod(AUDIT_LOG, 0o640)


# 9n: the rspamd web interface only for reading and only for a while; writing goes through eFa (rights, audit, cluster).
RSPAMD_SSO_MINUTES = (60, 15, 240)
RSPAMD_SSO_UPGRADED = '/var/lib/eFa/rspamd-sso-upgraded'


def _rspamd_sso_until():
    """When the read access ends (seconds since 1970), 0 when it is off. The file holds "read-only <until>"."""
    parts = (_read_lines(RSPAMD_SSO_FILE) or [''])[0].split()
    if len(parts) == 2 and parts[0] == 'read-only' and parts[1].isdigit() and int(parts[1]) > time.time():
        return int(parts[1])
    return 0


def _rspamd_sso_mode():
    return 'read-only' if _rspamd_sso_until() else 'off'


def _rspamd_sso_inc(mode):
    if mode == 'off':
        return 'location /rspamd/ { return 404; }\n'
    # rspamd trusts connections from this host without its password, unless a forwarded address names another
    # client. So no password is needed here, and the browser sends none. The headers are cleared to keep that trust.
    # Only reading: changes go through eFa (9n). An old full mode reads too.
    limit = '        limit_except GET HEAD { deny all; }\n'
    return f"""location = /_efa_rspamd_auth {{
    internal;
    proxy_pass http://127.0.0.1:8080/rspamd-auth;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
}}
location @efa_login {{ return 302 /login; }}
location /rspamd/ {{
    auth_request /_efa_rspamd_auth;
    error_page 401 = @efa_login;
{limit}    proxy_pass http://127.0.0.1:11334/;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For "";
    proxy_set_header X-Real-IP "";
    proxy_set_header Password "";
    proxy_set_header Cookie "";
    add_header X-Frame-Options DENY always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
}}
"""


def _nginx_apply():
    """Writes the eFa include files and loads them; a config nginx rejects is taken back."""
    include = f'    include {NGINX_HARDENING};\n'
    with open(NGINX_CONF) as f:
        conf = f.read()
    if include not in conf:
        marker = '    client_max_body_size 64m;\n'
        if marker not in conf:
            raise EfaError(f'{NGINX_CONF} has an unknown form, nothing was changed.')
        new_conf = conf.replace(marker, marker + include, 1)
    else:
        new_conf = conf
    backups = {}
    for path in (NGINX_HARDENING, NGINX_RSPAMD, NGINX_PORTAL, NGINX_ADMIN_ALLOW):
        backups[path] = open(path).read() if os.path.exists(path) else None
    protocols, ciphers, _out, _in = tls_wanted(tls_profile_state())
    new_conf = re.sub(r'ssl_protocols [^;]+;', f'ssl_protocols {protocols};', new_conf)
    _write(NGINX_HARDENING, f"""ssl_ciphers {ciphers};
ssl_ecdh_curve {':'.join(web_curves())};
ssl_prefer_server_ciphers on;""" + """
ssl_session_tickets off;
server_tokens off;
add_header Strict-Transport-Security "max-age=31536000" always;
include """ + NGINX_RSPAMD + """;
include """ + NGINX_PORTAL + """;
""")
    _write(NGINX_RSPAMD, _rspamd_sso_inc(_rspamd_sso_mode()))
    _write(NGINX_PORTAL, NGINX_PORTAL_INC)
    _write(NGINX_ADMIN_ALLOW, admin_allow_conf(_web_allow_state()))
    with open(NGINX_CONF, 'w') as f:
        f.write(new_conf)
    done = subprocess.run(['nginx', '-t'], capture_output=True, text=True)
    if done.returncode != 0:
        with open(NGINX_CONF, 'w') as f:
            f.write(conf)
        for path, text in backups.items():
            if text is None:
                os.remove(path)
            else:
                _write(path, text)
        raise EfaError('nginx rejected the config, it was taken back: ' + done.stderr[-200:])
    subprocess.run(['systemctl', 'reload', 'nginx'], check=False, capture_output=True)


NGINX_PORTAL_INC = ''.join(f"""location ^~ /{path} {{
    proxy_pass http://127.0.0.1:8081;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Cookie $http_cookie;
}}
""" for path in PORTAL_PATHS[:3]) + """# 5p: only the allowed addresses reach the admin interface; the portal stays open to all.
if ($efa_admin_refused) { return 403; }
"""


def _web_allow_state():
    return {'mode': 'all', 'entries': [], **_json_read(WEB_ALLOW_FILE, {})}


def admin_allow_conf(state):
    """The nginx variables of the admin allowlist (http level): refused is 1 for an address outside the list, except on the portal paths."""
    allowed = state['mode'] == 'allowed' and state['entries']
    lines = [f"    {item['network']} 1;\n" for item in state['entries']] if allowed else []
    skip = '|'.join(re.escape(path) for path in PORTAL_PATHS)
    return (f'# eFa: efactl web-allowlist-set, do not edit.\ngeo $efa_admin_ip_ok {{\n    default {0 if allowed else 1};\n' + ''.join(lines) + '}\n'
            f'map "$efa_admin_ip_ok:$uri" $efa_admin_refused {{\n    default 0;\n    "~^0:/(?!{skip})" 1;\n}}\n')


def web_allow_entries(text):
    """Networks with a comment each, one per line or comma separated: 192.0.2.0/24 office."""
    entries = []
    for item in re.split(r'[,\n]+', text or ''):
        parts = item.strip().split(None, 1)
        if not parts:
            continue
        try:
            network = str(ipaddress.ip_network(parts[0], strict=False))
        except ValueError:
            raise EfaError(f'{parts[0]} is no IP address or network, such as 192.0.2.0/24 or 2001:db8::/32.')
        entries.append({'network': network, 'comment': (parts[1] if len(parts) > 1 else '')[:80].replace(';', ' ')})
    return entries


def web_allow_refusal(state, client):
    """Why switching to allowed addresses would lock out: an empty list, or the address of this admin is not in it."""
    if state['mode'] != 'allowed':
        return None
    if not state['entries']:
        raise EfaError('The list is empty: add the admin networks first.')
    try:
        address = ipaddress.ip_address(client)
    except ValueError:
        return None  # the console or a node of the cluster: no address of a browser to lock out
    if not any(address in ipaddress.ip_network(item['network']) for item in state['entries']):
        raise EfaError(f'Refused: your own address {client} is not in the list, you would lock yourself out. Add it first.')
    return None


def web_allowlist_show(_args):
    state = _web_allow_state()
    return {'mode': state['mode'], 'networks': ', '.join(f"{item['network']} {item['comment']}".strip() for item in state['entries']),
            'your_address': acting_client if acting_client and acting_client[0].isdigit() or ':' in acting_client else ''}


def web_allowlist_set(args):
    """5p: the admin interface only from these networks; the user portal stays open. The list can be kept while it is off."""
    state = _web_allow_state()
    if args.networks is not None and args.networks.strip() != '':
        state['entries'] = [] if args.networks.strip() == '-' else web_allow_entries(args.networks)
    mode = (args.mode or state['mode']).strip()
    if mode not in ('all', 'allowed', 'off'):
        raise EfaError('Mode: all or allowed.')
    state['mode'] = 'all' if mode == 'off' else mode
    if state['mode'] == 'allowed':
        _confirm(args)
        web_allow_refusal(state, acting_client)
    _json_write(WEB_ALLOW_FILE, state)
    os.chmod(WEB_ALLOW_FILE, 0o640)
    shutil.chown(WEB_ALLOW_FILE, 'root', 'efa-web')
    _nginx_apply()
    _audit(f'admin web allowlist set to {state["mode"]} with {len(state["entries"])} networks by {_dmarc_who()}')
    return web_allowlist_show(None)


def web_harden(_args):
    """TLS settings, security headers and the ban on failed web logins. Safe to run again."""
    _nginx_apply()
    _write(FAIL2BAN_FILTER, '[Definition]\nfailregex = efa-web login failed from <HOST>\n            efa-web admin address refused from <HOST>\n'
                            'journalmatch = _SYSTEMD_UNIT=efa-web.service + _SYSTEMD_UNIT=efa-portal.service\n')
    if os.path.exists(FAIL2BAN_JAIL):
        with open(FAIL2BAN_JAIL) as f:
            jail = f.read()
        if '[efa-web]' not in jail:
            _write(FAIL2BAN_JAIL, jail.rstrip('\n') + '\n\n' + FAIL2BAN_WEB_JAIL)
            subprocess.run(['systemctl', 'try-restart', 'fail2ban'], check=False, capture_output=True)
    return {'web_harden': 'done'}


def rspamd_sso_set(args):
    """Opens the rspamd web interface through the eFa login for reading, for 15, 60 or 240 minutes; then it closes by itself.
    Only the main admin: it shows the mail of every domain."""
    mode = args.mode.strip()
    if mode not in ('off', 'read-only'):
        raise EfaError("Mode must be 'off' or 'read-only'. Changes go through eFa, so they keep rights, audit and cluster.")
    if identity_now and identity_now.get('role') != 'super':
        raise EfaError('Only the main admin opens the rspamd web interface: it shows the mail of all domains.')
    minutes = int((getattr(args, 'minutes', '') or '60').strip() or 60) if str(getattr(args, 'minutes', '') or '60').strip().isdigit() else 0
    if mode == 'read-only' and minutes not in RSPAMD_SSO_MINUTES:
        raise EfaError('Minutes: 15, 60 or 240.')
    previous = (_read_lines(RSPAMD_SSO_FILE) or ['off'])[0]
    until = int(time.time()) + minutes * 60 if mode == 'read-only' else 0
    _write(RSPAMD_SSO_FILE, (f'read-only {until}' if until else 'off') + '\n')
    try:
        _nginx_apply()
    except EfaError:
        _write(RSPAMD_SSO_FILE, previous + '\n')
        raise
    # The way out: at the end a timer closes it again; the check of the web login refuses it after that time anyway.
    if until:
        _platform().run_later('efa-rspamd-close', minutes * 60, ['/usr/sbin/efactl', 'rspamd-sso-set', '--mode', 'off'])
    else:
        _platform().service_stop('efa-rspamd-close.timer')
    _audit(f'rspamd access set to {mode}{f" for {minutes} minutes" if until else ""} by {_dmarc_who()}')
    return {'rspamd_sso': mode, 'until': time.strftime('%Y-%m-%d %H:%M', time.localtime(until)) if until else ''}


def rspamd_sso_upgrade(_args):
    """Package update: full access is no longer offered. Open access becomes read-only for an hour, with a notice."""
    old = (_read_lines(RSPAMD_SSO_FILE) or [''])[0].split()
    if old[:1] in (['full'], ['read-only']) and len(old) == 1:
        until = int(time.time()) + 3600
        _write(RSPAMD_SSO_FILE, f'read-only {until}\n')
        _nginx_apply()
        _write(RSPAMD_SSO_UPGRADED, old[0] + '\n')
        _platform().run_later('efa-rspamd-close', 3600, ['/usr/sbin/efactl', 'rspamd-sso-set', '--mode', 'off'])
        return {'rspamd_sso': 'read-only', 'was': old[0]}
    return {'rspamd_sso': _rspamd_sso_mode()}


def audit_rspamd(args):
    """Notes that an admin opened the rspamd web interface."""
    client = args.client.strip()
    ipaddress.ip_address(client)
    _audit(f'rspamd opened, mode {_rspamd_sso_mode()}, admin from {client}')
    return {'logged': True}


def _firewall_state():
    state = _json_read(FIREWALL_FILE, {})
    state.setdefault('allowlist', [])
    state.setdefault('submission', _submission_active())
    # On by default only where the admin uses firewalld: an upgrade must not start a firewall that was off on purpose.
    if 'guard' not in state:
        state['guard'] = subprocess.run(['systemctl', 'is-enabled', 'firewalld'], capture_output=True, text=True).stdout.strip() == 'enabled'
    state.setdefault('pending', None)
    state.setdefault('owned_ports', {})
    state.setdefault('probe_url', '')
    return state


def _submission_active():
    return subprocess.run(['postconf', '-M', 'submission/inet'], capture_output=True, text=True).stdout.strip() != ''


def _ssh_port():
    done = subprocess.run(['sshd', '-T'], capture_output=True, text=True)
    match = re.search(r'^port (\d+)$', done.stdout, re.M)
    return match.group(1) if match else '22'


def _firewall_ports(state):
    """Ports eFa needs open. SSH and web are limited separately by the allowlist."""
    ports = ['25', '80', '443', _ssh_port()]
    if state['submission']:
        ports += [port for port, name in (('587', 'submission'), ('465', 'smtps'))
                  if subprocess.run(['postconf', '-M', f'{name}/inet'], capture_output=True, text=True).stdout.strip()]
    return ports


def _firewall_table(state, ssh_port):
    """Our own nftables table. It only limits SSH and web to the allowlist; firewalld and other tables stay as they are."""
    if not state['allowlist']:
        return f'table inet {FIREWALL_TABLE}\ndelete table inet {FIREWALL_TABLE}\n'
    ipv4 = [net for net in state['allowlist'] if ':' not in net]
    ipv6 = [net for net in state['allowlist'] if ':' in net]
    ports = f'{{ {ssh_port}, 443 }}'
    lines = [f'table inet {FIREWALL_TABLE}', f'delete table inet {FIREWALL_TABLE}', f'table inet {FIREWALL_TABLE} {{',
             '  chain input {', '    type filter hook input priority -10; policy accept;',
             '    ct state established,related accept', '    iif "lo" accept']
    if ipv4:
        lines.append(f'    ip saddr {{ {", ".join(ipv4)} }} tcp dport {ports} accept')
    if ipv6:
        lines.append(f'    ip6 saddr {{ {", ".join(ipv6)} }} tcp dport {ports} accept')
    lines += [f'    tcp dport {ports} reject with tcp reset', '  }', '}']
    return '\n'.join(lines) + '\n'


def _firewall_load(state):
    """One nft transaction: it replaces only our table, or leaves everything as it was. Does not need firewalld."""
    done = subprocess.run(['nft', '-f', '-'], input=_firewall_table(state, _ssh_port()), capture_output=True, text=True, timeout=30)
    if done.returncode != 0:
        raise EfaError(f'nft refused the rules, nothing was changed: {done.stderr[-200:]}')


def _firewall_table_ok(state):
    done = subprocess.run(['nft', 'list', 'table', 'inet', FIREWALL_TABLE], capture_output=True, text=True, timeout=30)
    if not state['allowlist']:
        return done.returncode != 0
    return done.returncode == 0 and all(net.split('/')[0] in done.stdout for net in state['allowlist'])


def _fw(*args):
    return subprocess.run(['firewall-cmd'] + list(args), capture_output=True, text=True, timeout=60)


def _firewall_open_zones():
    """Active zones that do not let everything in anyway. Never adds a zone or moves an interface."""
    zones = [line for line in _fw('--get-active-zones').stdout.splitlines() if line and not line.startswith(' ')]
    return [zone for zone in zones if _fw(f'--zone={zone}', '--get-target').stdout.strip() != 'ACCEPT'
            and _fw('--permanent', f'--zone={zone}', '--get-target').stdout.strip() != 'ACCEPT']


def _firewall_add_ports(state):
    """Adds missing eFa ports to the active zones, runtime and permanent, and remembers them. There is never a reload."""
    added = []
    for zone in _firewall_open_zones():
        for port in _firewall_ports(state):
            spec = f'{port}/tcp'
            if _fw(f'--zone={zone}', f'--query-port={spec}').returncode != 0 and not _firewall_service_has(zone, port):
                _fw(f'--zone={zone}', f'--add-port={spec}')
                added.append(f'{zone} {spec}')
                state['owned_ports'].setdefault(zone, [])
                if spec not in state['owned_ports'][zone]:
                    state['owned_ports'][zone].append(spec)
            if _fw('--permanent', f'--zone={zone}', f'--query-port={spec}').returncode != 0 and spec in state['owned_ports'].get(zone, []):
                _fw('--permanent', f'--zone={zone}', f'--add-port={spec}')
    return added


def _firewall_service_has(zone, port):
    names = {'25': 'smtp', '80': 'http', '443': 'https', '22': 'ssh', '587': 'smtp-submission', '465': 'smtps'}
    return port in names and _fw(f'--zone={zone}', f'--query-service={names[port]}').returncode == 0


def _firewall_log(text):
    os.makedirs(os.path.dirname(FIREWALL_LOG), exist_ok=True)
    with open(FIREWALL_LOG, 'a') as log:
        log.write(f'{time.strftime("%Y-%m-%d %H:%M:%S")} {text}\n')


def firewall_set(args):
    """Applies the admin allowlist. It reverts by itself after 5 minutes unless confirmed."""
    state = _firewall_state()
    if state['pending']:
        raise EfaError('A change waits for confirmation: confirm it or let it revert first.')
    nets = []
    for item in args.allowlist.replace(',', ' ').split():
        try:
            net = ipaddress.ip_network(item, strict=False)
        except ValueError:
            raise EfaError(f'Invalid network: {item}')
        if net.prefixlen == 0:
            raise EfaError('An allowlist for the whole internet is the same as an empty list: leave it empty.')
        nets.append(str(net))
    previous = {'allowlist': state['allowlist'], 'submission': state['submission']}
    state['allowlist'] = nets
    if (args.submission or '').strip():
        state['submission'] = _on_off(args.submission)
    state['pending'] = {'previous': previous, 'until': time.strftime('%Y-%m-%d %H:%M:%S', time.localtime(time.time() + 300))}
    # The timer comes first: if applying breaks access, the way back is already armed.
    _firewall_schedule_revert()
    _json_write(FIREWALL_FILE, state)
    _firewall_load(state)
    _firewall_add_ports(state)
    _json_write(FIREWALL_FILE, state)
    _firewall_log(f'changed by {_dmarc_who()}: allowlist {" ".join(nets) or "none"}')
    return {'allowlist': nets, 'confirm_until': state['pending']['until'],
            'note': 'Check that you still have access, then confirm. Otherwise this reverts by itself after 5 minutes.'}


def _firewall_schedule_revert():
    # A fixed time, not --on-active: a daemon-reload, as by a package update, would start a relative timer again.
    when = time.strftime('%Y-%m-%d %H:%M:%S', time.localtime(time.time() + 300))
    done = subprocess.run(['systemd-run', f'--unit={FIREWALL_REVERT_UNIT}', '--collect', f'--on-calendar={when}', '--timer-property=AccuracySec=1s',
                           '/usr/sbin/efactl', 'firewall-revert'], capture_output=True, text=True)
    if done.returncode != 0:
        raise EfaError(f'The safety timer could not start, nothing was changed: {done.stderr[-200:]}')


def firewall_pending_seconds():
    """Seconds until an unconfirmed firewall change is taken back, or None: every page of the web interface shows it."""
    try:
        pending = _firewall_state()['pending']
    except (OSError, ValueError, KeyError):
        return None
    if not pending:
        return None
    left = time.mktime(time.strptime(pending['until'], '%Y-%m-%d %H:%M:%S')) - time.time()
    return max(0, int(left))


def firewall_confirm(_args):
    """Keeps the change and stops the automatic revert."""
    state = _firewall_state()
    if not state['pending']:
        raise EfaError('No change waits for confirmation.')
    subprocess.run(['systemctl', 'stop', f'{FIREWALL_REVERT_UNIT}.timer'], check=False, capture_output=True)
    state['pending'] = None
    _json_write(FIREWALL_FILE, state)
    _firewall_log(f'confirmed by {_dmarc_who()}')
    return {'confirmed': True}


def firewall_revert(_args):
    """Takes back a change that was not confirmed. Works without firewalld, it only replaces our nftables table."""
    state = _firewall_state()
    if not state['pending']:
        return {'reverted': False}
    state.update(state['pending']['previous'])
    state['pending'] = None
    _firewall_load(state)
    _json_write(FIREWALL_FILE, state)
    _firewall_log('not confirmed, reverted')
    _admin_notify('eFa: firewall change reverted', 'A firewall change was not confirmed within 5 minutes and was taken back.')
    return {'reverted': True}


def firewall_show(_args):
    """eFa firewall rules, zones and warnings."""
    state = _firewall_state()
    if shutil.which('firewall-cmd') is None:
        raise EfaError('firewalld is not installed.')
    running = _fw('--state').returncode == 0
    zones = _fw('--get-active-zones').stdout if running else ''
    notes = []
    if re.search(r'^trusted$', zones, re.M):
        notes.append('An interface is in the zone trusted: all ports stay open there, except SSH and web if an allowlist is set.')
    return {'firewall_allowlist': ' '.join(state['allowlist']), 'firewall_submission': state['submission'], 'running': running,
            'guard': state['guard'], 'waiting_for_confirmation_until': state['pending']['until'] if state['pending'] else None,
            'ports_added_by_efa': state['owned_ports'], 'allowlist_active': _firewall_table_ok(state) and bool(state['allowlist']),
            'notes': notes, 'firewall_probe_url': state['probe_url']}


def firewall_guard_set(args):
    """The guard restores the eFa rules every 5 minutes. It never changes anything else."""
    state = _firewall_state()
    state['guard'] = _on_off(args.mode)
    _json_write(FIREWALL_FILE, state)
    return {'guard': state['guard']}


def firewall_guard_status(_args):
    state = _firewall_state()
    return {'guard': state['guard'], 'recent': _read_lines(FIREWALL_LOG)[-10:]}


def _firewall_restart_allowed(now):
    # Jobs that add firewall rules usually run around the full hour, and firewalld failed when restarted during one.
    return 20 <= now.minute <= 50


def firewall_guard_run(_args):
    """Timer job: starts firewalld if it is down, adds back missing eFa ports and restores our table."""
    state = _firewall_state()
    if not state['guard']:
        return {'guard': 'off'}
    repairs = []
    if not _firewall_table_ok(state):
        _firewall_load(state)
        repairs.append('allowlist table')
    if shutil.which('firewall-cmd') is not None:
        if _fw('--state').returncode != 0:
            subprocess.run(['systemctl', 'start', 'firewalld'], check=False, capture_output=True, timeout=120)
            if _fw('--state').returncode != 0:
                text = 'firewalld does not start. The allowlist still works, opening ports does not.'
                _firewall_log(text)
                _admin_notify('eFa: firewall problem', text)
                return {'repaired': repairs, 'problem': text}
            repairs.append('firewalld started')
        elif not _fw('--get-active-zones').stdout.strip():
            # firewalld can run with no zones after an internal error, and then cuts the host off completely.
            if not _firewall_restart_allowed(datetime.datetime.now()):
                text = 'firewalld has no active zones. It restarts in the next safe slot, from minute 20 to 50.'
                _firewall_log(text)
                return {'repaired': repairs, 'waiting': text}
            subprocess.run(['systemctl', 'restart', 'firewalld'], check=False, capture_output=True, timeout=180)
            repairs.append('firewalld restarted, it had no active zones')
        # Fail2Ban stops together with firewalld and does not come back by itself.
        if repairs and subprocess.run(['systemctl', 'is-enabled', '--quiet', 'fail2ban']).returncode == 0:
            subprocess.run(['systemctl', 'start', 'fail2ban'], check=False, capture_output=True, timeout=60)
        repairs += _firewall_add_ports(state)
    if repairs:
        _event('firewall_guard_repair', 'warning', repairs=repairs)
        _json_write(FIREWALL_FILE, state)
        for item in repairs:
            _firewall_log(f'guard repaired: {item}')
        _admin_notify('eFa: firewall rules repaired', '\n'.join(repairs))
    return {'repaired': repairs}


# 9m: IP blocklists, feeds and own lists, in the nftables table efa_block (efa_blocklist.py). Settings and own entries in /etc
# (they go to every cluster node), what a feed sent below /var/lib on each node, which fetches it itself.
BLOCKLIST_FILE = ETC + '/eFa/blocklists.json'
BLOCKLIST_DIR = '/var/lib/eFa/blocklists'
# Shared with the package updates of eFa: no list is loaded while dnf runs.
FIREWALL_LOCK = '/run/lock/efa-firewall.lock'
BLOCKLIST_MAX_HOURS = 8760


@contextlib.contextmanager
def _firewall_lock(wait=600):
    """The lock of firewall changes of eFa: blocklist runs, and package updates while they run."""
    os.makedirs(os.path.dirname(FIREWALL_LOCK), exist_ok=True)
    with open(FIREWALL_LOCK, 'a') as handle:
        until = time.time() + wait
        while True:
            try:
                fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.time() >= until:
                    raise EfaError('Another firewall change or a package update is running, try again later.')
                time.sleep(1)
        try:
            yield
        finally:
            fcntl.flock(handle, fcntl.LOCK_UN)


def _blocklist_state():
    state = _json_read(BLOCKLIST_FILE, {})
    state.setdefault('lists', {})
    state.setdefault('entries', {})
    return state


def _blocklist_feed_file(name):
    return os.path.join(BLOCKLIST_DIR, name + '.txt')


def _blocklist_allow():
    """Addresses that are never blocked: relay networks, the admin allowlist, the cluster nodes and the own addresses."""
    lib = _lib('efa_blocklist')
    text = ' '.join(_postconf('mynetworks').replace(',', ' ').replace('[', '').replace(']', '').split())
    text += ' ' + ' '.join(_firewall_state()['allowlist'])
    hosts = []

    def walk(value):
        if isinstance(value, dict):
            for key, item in value.items():
                if key in ('host', 'address') and isinstance(item, str):
                    hosts.append(item)
                else:
                    walk(item)
        elif isinstance(value, list):
            for item in value:
                walk(item)
    walk(_lib('efa_cluster').read_state(ETC))
    for host in hosts:
        try:
            text += ' ' + ' '.join({info[4][0] for info in socket.getaddrinfo(host, None, proto=socket.IPPROTO_TCP)})
        except OSError:
            pass
    done = subprocess.run(['ip', '-j', 'addr'], capture_output=True, text=True, timeout=15)
    try:
        text += ' ' + ' '.join(item['local'] for link in json.loads(done.stdout or '[]') for item in link.get('addr_info', []))
    except (ValueError, KeyError, TypeError):
        pass
    return lib.parse_entries(text, allow_private=True)[0]


def _blocklist_tables(state):
    """The lists that are on, as efa_blocklist.nft_script takes them."""
    lib = _lib('efa_blocklist')
    lists = {}
    for name, entry in state['lists'].items():
        if not entry.get('enabled'):
            continue
        feed = []
        if entry.get('kind') == 'feed' and os.path.exists(_blocklist_feed_file(name)):
            with open(_blocklist_feed_file(name)) as f:
                feed = lib.parse_entries(f.read())[0]
        lists[name] = {'ports': entry['ports'], 'feed': feed, 'own': state['entries'].get(name, {})}
    return lists


def _blocklist_load(state):
    """The table efa_block in one nft transaction; without a list that is on, no table at all."""
    lib = _lib('efa_blocklist')
    lists = _blocklist_tables(state)
    script = lib.nft_script(lists, _blocklist_allow(), time.time()) if lists else f'table inet {lib.TABLE}\ndelete table inet {lib.TABLE}\n'
    ok, error = _platform().nft_apply(script)
    if not ok:
        raise EfaError(f'nft refused the blocklists, the loaded ones stay: {error}')


def _blocklist_fetch(name, entry, now):
    """One feed: https only, at most MAX_FEED_BYTES, with ETag and If-Modified-Since; 429 and 503 set when to ask again."""
    lib = _lib('efa_blocklist')
    headers = {'User-Agent': f'eFa-next/{_efa_version()} (blocklist)'}
    if entry.get('etag') and os.path.exists(_blocklist_feed_file(name)):
        headers['If-None-Match'] = entry['etag']
    if entry.get('modified') and os.path.exists(_blocklist_feed_file(name)):
        headers['If-Modified-Since'] = entry['modified']
    request = urllib.request.Request(entry['url'], headers=headers)
    try:
        with urllib.request.urlopen(request, timeout=60, context=ssl.create_default_context()) as answer:
            data = answer.read(lib.MAX_FEED_BYTES + 1)
            if len(data) > lib.MAX_FEED_BYTES:
                raise EfaError(f'larger than {lib.MAX_FEED_BYTES // 1024 // 1024} MB')
            nets, skipped = lib.parse_entries(data.decode('utf-8', 'replace'))
            if not nets:
                raise EfaError('no address in the answer, the list stays as it was')
            os.makedirs(BLOCKLIST_DIR, mode=0o750, exist_ok=True)
            _write(_blocklist_feed_file(name), '\n'.join(str(net) for net in nets) + '\n')
            entry.update(etag=answer.headers.get('ETag', ''), modified=answer.headers.get('Last-Modified', ''), count=len(nets),
                         skipped=skipped, error='')
    except urllib.error.HTTPError as err:
        if err.code == 304:
            entry['error'] = ''
        elif err.code in (429, 503):
            entry['retry_at'] = lib.retry_at(err.headers.get('Retry-After'), now)
            entry['error'] = f'HTTP {err.code}: the feed asks to wait until {time.strftime("%Y-%m-%d %H:%M", time.localtime(entry["retry_at"]))}'
        else:
            entry['error'] = f'HTTP {err.code}'
    except (urllib.error.URLError, OSError, EfaError, ValueError) as err:
        entry['error'] = str(getattr(err, 'reason', err))[:200]
    entry['fetched_at'] = now


def blocklist_show(_args):
    """The IP blocklists: what each one holds, when its feed answered last, and whether the table is loaded."""
    lib = _lib('efa_blocklist')
    state = _blocklist_state()
    now = time.time()
    lists = []
    for name, entry in sorted(state['lists'].items()):
        own = lib.live_entries(state['entries'].get(name, {}), now)
        lists.append({'name': name, 'kind': entry.get('kind'), 'enabled': bool(entry.get('enabled')), 'ports': ','.join(map(str, entry['ports'])) or 'all',
                      'url': entry.get('url', ''), 'interval': entry.get('interval', ''), 'terms_accepted': bool(entry.get('terms_accepted')),
                      'feed_addresses': entry.get('count', 0) if entry.get('kind') == 'feed' else 0, 'own_addresses': len(own),
                      'fetched': time.strftime('%Y-%m-%d %H:%M', time.localtime(entry['fetched_at'])) if entry.get('fetched_at') else '',
                      'error': entry.get('error', '')})
    loaded = _platform().nft_has_table('inet', lib.TABLE)
    known = [{'name': name, 'title': feed['title'], 'url': feed['url'], 'terms': feed['terms']} for name, feed in lib.FEEDS.items()]
    return {'blocklists': lists, 'loaded': loaded, 'known_feeds': known,
            'warnings': [f'{item["name"]}: {item["error"]}' for item in lists if item['enabled'] and item['error']]}


def blocklist_set(args):
    """Add or change a list: a feed (URL, interval, terms accepted once) or an own list, its ports, on or off."""
    lib = _lib('efa_blocklist')
    name = (args.name or '').strip().lower()
    if lib.name_problem(name):
        raise EfaError(lib.name_problem(name))
    state = _blocklist_state()
    entry = dict(state['lists'].get(name, {}))
    kind = (args.kind or entry.get('kind') or ('feed' if name in lib.FEEDS else 'own')).strip()
    if kind not in ('feed', 'own'):
        raise EfaError('Kind: feed or own.')
    try:
        ports = lib.parse_ports(args.ports or (','.join(map(str, entry['ports'])) or 'all' if 'ports' in entry else '25'))
    except ValueError as err:
        raise EfaError(str(err))
    entry.update(kind=kind, ports=ports, enabled=_on_off(args.mode))
    if kind == 'feed':
        url = (args.url or '').strip() or entry.get('url') or lib.FEEDS.get(name, {}).get('url', '')
        if not url.startswith('https://') or len(url) > 500 or re.search(r'\s', url):
            raise EfaError('Feed address: an https:// address.')
        interval = int(args.interval or entry.get('interval') or 120) if str(args.interval or entry.get('interval') or 120).isdigit() else 0
        if interval not in lib.INTERVALS:
            raise EfaError('Interval in minutes: ' + ', '.join(map(str, lib.INTERVALS)) + '.')
        if url != entry.get('url'):
            entry.update(etag='', modified='', retry_at=0, fetched_at=0)
        entry.update(url=url, interval=interval)
        if (args.accept_terms or '').strip() == 'yes':
            entry['terms_accepted'] = True
        if entry['enabled'] and not entry.get('terms_accepted'):
            raise EfaError('Read the terms of the feed and accept them, then switch it on.')
    state['lists'][name] = entry
    with _firewall_lock(60):
        _json_write(BLOCKLIST_FILE, state)
        _blocklist_load(state)
    return {'name': name, 'enabled': entry['enabled'], 'note': 'A feed is fetched by the next run, within 5 minutes.' if kind == 'feed' else ''}


def blocklist_entry(args):
    """Own entries: add addresses or networks to a list, for some hours or for good, or take them out."""
    lib = _lib('efa_blocklist')
    name = (args.name or '').strip().lower()
    state = _blocklist_state()
    if name not in state['lists']:
        raise EfaError(f'No list {name}. Add it first (blocklist-set).')
    action = (args.action or '').strip()
    nets, skipped = lib.parse_entries(args.addresses, allow_private=True)
    if not nets or skipped:
        raise EfaError('Addresses: IPv4 or IPv6 addresses or networks, separated by spaces or commas.')
    hours = (args.hours or '').strip()
    if hours and (not hours.isdigit() or not 1 <= int(hours) <= BLOCKLIST_MAX_HOURS):
        raise EfaError(f'Hours: 1 to {BLOCKLIST_MAX_HOURS}, or empty for good.')
    allow = _blocklist_allow()
    entries = state['entries'].setdefault(name, {})
    if action == 'add':
        kept = [net for net in nets if any(net.overlaps(other) for other in allow)]
        if kept:
            raise EfaError('Never blocked, these are relay networks, allowed admins, cluster nodes or own addresses: ' + ', '.join(map(str, kept)))
        for net in nets:
            entries[str(net)] = time.time() + int(hours) * 3600 if hours else 0
    elif action == 'remove':
        for net in nets:
            entries.pop(str(net), None)
    else:
        raise EfaError('Action: add or remove.')
    with _firewall_lock(60):
        _json_write(BLOCKLIST_FILE, state)
        _blocklist_load(state)
    return {'name': name, 'own_addresses': len(lib.live_entries(entries, time.time()))}


def blocklist_import(args):
    """Command line only, for efa-migrate: the addresses of a file into an own list, made when it is missing. Addresses that
    are never blocked are left out and counted instead of stopping the import."""
    lib = _lib('efa_blocklist')
    name = (args.name or '').strip().lower()
    if lib.name_problem(name):
        raise EfaError(lib.name_problem(name))
    try:
        ports = lib.parse_ports(args.ports or '25')
    except ValueError as err:
        raise EfaError(str(err))
    hours = (args.hours or '').strip()
    if hours and (not hours.isdigit() or not 1 <= int(hours) <= BLOCKLIST_MAX_HOURS):
        raise EfaError(f'Hours: 1 to {BLOCKLIST_MAX_HOURS}, or empty for good.')
    with open(args.file) as f:
        nets, skipped = lib.parse_entries(f.read(), allow_private=True)
    allow = _blocklist_allow()
    kept = [net for net in nets if not any(net.overlaps(other) for other in allow)]
    state = _blocklist_state()
    entry = state['lists'].setdefault(name, {'kind': 'own', 'enabled': True})
    entry['ports'] = ports
    entries = state['entries'].setdefault(name, {})
    for net in kept:
        entries[str(net)] = time.time() + int(hours) * 3600 if hours else 0
    with _firewall_lock(120):
        _json_write(BLOCKLIST_FILE, state)
        _blocklist_load(state)
    # Command line only: not in the table of the web, so the audit line is written here.
    _audit(f'blocklist-import {name}: {len(kept)} addresses by {_dmarc_who()}')
    return {'name': name, 'imported': len(kept), 'never_blocked': len(nets) - len(kept), 'not_addresses': skipped}


def blocklist_remove(args):
    """Remove a list with its own entries; its addresses are let through again at once."""
    _confirm(args)
    name = (args.name or '').strip().lower()
    state = _blocklist_state()
    if name not in state['lists']:
        raise EfaError(f'No list {name}.')
    state['lists'].pop(name)
    state['entries'].pop(name, None)
    with _firewall_lock(60):
        _json_write(BLOCKLIST_FILE, state)
        _blocklist_load(state)
    if os.path.exists(_blocklist_feed_file(name)):
        os.remove(_blocklist_feed_file(name))
    return {'removed': name}


def blocklist_run(_args):
    """Timer job, every 5 minutes: fetches the feeds that are due, lets run-out own entries go, and loads the table again
    when it is missing (after a boot) or a list changed. Waits for a running package update instead of racing it."""
    lib = _lib('efa_blocklist')
    state = _blocklist_state()
    if not state['lists']:
        return {'lists': 0}
    now = time.time()
    fetched = [name for name, entry in state['lists'].items() if lib.due(entry, now)]
    for name in fetched:
        _blocklist_fetch(name, state['lists'][name], now)
    expired = {name: [address for address, expiry in entries.items() if expiry and expiry <= now] for name, entries in state['entries'].items()}
    for name, addresses in expired.items():
        for address in addresses:
            state['entries'][name].pop(address)
    loaded = _platform().nft_has_table('inet', lib.TABLE)
    wanted = any(entry.get('enabled') for entry in state['lists'].values())
    try:
        with _firewall_lock(30):
            if fetched or any(expired.values()):
                _json_write(BLOCKLIST_FILE, state)
            if fetched or any(expired.values()) or loaded != wanted:
                _blocklist_load(state)
    except EfaError as err:
        return {'skipped': str(err)}
    for name in fetched:
        if state['lists'][name].get('error'):
            _event('blocklist_feed_failed', 'warning', blocklist=name, error=state['lists'][name]['error'])
    return {'fetched': fetched, 'expired': sum(len(items) for items in expired.values()), 'reloaded': not loaded and wanted}


def _test_blocked(port):
    """A local rule of eFa or the admin, so the hint can name it instead of a plain failure."""
    done = subprocess.run(['iptables', '-S', 'OUTPUT'], capture_output=True, text=True, timeout=15)
    return bool(re.search(rf'--dport {port}\b.*-j (REJECT|DROP)', done.stdout))


def _test_tcp(name, host, port, hint):
    start = time.time()
    try:
        with socket.create_connection((host, port), timeout=8):
            return {'test': name, 'result': 'ok', 'ms': int((time.time() - start) * 1000), 'hint': ''}
    except OSError as err:
        blocked = _test_blocked(port)
        return {'test': name, 'result': 'blocked by eFa test mode or firewall' if blocked else 'failed',
                'ms': int((time.time() - start) * 1000), 'hint': '' if blocked else f'{err}. {hint}'}


def _test_smtp(name, host, port):
    start = time.time()
    try:
        # Only says hello and leaves, it never sends mail.
        with smtplib.SMTP(host, port, timeout=8, local_hostname=socket.getfqdn()) as smtp:
            code, _reply = smtp.ehlo()
            return {'test': name, 'result': 'ok' if code == 250 else f'answered {code}', 'ms': int((time.time() - start) * 1000), 'hint': ''}
    except (OSError, smtplib.SMTPException) as err:
        blocked = _test_blocked(port)
        return {'test': name, 'result': 'blocked by eFa test mode or firewall' if blocked else 'failed',
                'ms': int((time.time() - start) * 1000), 'hint': '' if blocked else f'{err}. Check outbound port {port}.'}


def _test_dns(name, resolver, tcp):
    start = time.time()
    try:
        done = subprocess.run(['dig', '+time=4', '+tries=1', '+tcp' if tcp else '+notcp', '+short', 'SOA', 'example.org', f'@{resolver}'],
                              capture_output=True, text=True, timeout=8)
        ok = done.returncode == 0 and done.stdout.strip()
    except subprocess.TimeoutExpired:
        ok = False
    return {'test': name, 'result': 'ok' if ok else 'failed', 'ms': int((time.time() - start) * 1000),
            'hint': '' if ok else f'{"TCP" if tcp else "UDP"} port 53 to {resolver} does not answer.'}


def _test_ntp(name, host):
    start = time.time()
    try:
        with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as sock:
            sock.settimeout(5)
            sock.sendto(b'\x1b' + 47 * b'\0', (host, 123))
            sock.recv(48)
        return {'test': name, 'result': 'ok', 'ms': int((time.time() - start) * 1000), 'hint': ''}
    except OSError as err:
        return {'test': name, 'result': 'failed', 'ms': int((time.time() - start) * 1000), 'hint': f'{err}. Check outbound UDP 123.'}


def _test_listening(port):
    done = subprocess.run(['ss', '-ltnH', f'sport = :{port}'], capture_output=True, text=True, timeout=10)
    return bool(done.stdout.strip())


def _test_probe(url, port):
    start = time.time()
    try:
        with urllib.request.urlopen(f'{url}?port={port}', timeout=15) as reply:
            result = json.load(reply)
        ok = bool(result.get('open'))
        return {'test': f'From outside: port {port}', 'result': 'ok' if ok else 'failed', 'ms': int((time.time() - start) * 1000),
                'hint': '' if ok else 'The probe could not connect. Check the firewall in front of this server.'}
    except (OSError, ValueError) as err:
        return {'test': f'From outside: port {port}', 'result': 'failed', 'ms': int((time.time() - start) * 1000), 'hint': f'Probe: {err}'}


def firewall_test(args):
    """Checks outbound and inbound connectivity. Every check has a time limit, and no mail is sent."""
    only = (args.only or 'all').strip()
    if only not in ('all', 'dns', 'smtp', 'https', 'http', 'ntp', 'inbound'):
        raise EfaError('Choose all, dns, smtp, https, http, ntp or inbound.')
    state, jobs = _firewall_state(), []
    resolvers = [value for value in _rotation_state()['resolvers'].values() if value] or ['1.1.1.1', '2606:4700:4700::1111']
    if only in ('all', 'dns'):
        for resolver in resolvers:
            jobs += [lambda r=resolver: _test_dns(f'DNS UDP to {r}', r, False), lambda r=resolver: _test_dns(f'DNS TCP to {r}', r, True)]
    if only in ('all', 'smtp'):
        domain = (args.domain or '').strip().lower() or 'example.org'
        lines = subprocess.run(['dig', '+time=4', '+tries=1', '+short', 'MX', domain], capture_output=True, text=True, timeout=10).stdout.split('\n')
        mx = lines[0].split()[-1].rstrip('.') if lines and lines[0].strip() else ''
        if mx:
            jobs.append(lambda: _test_smtp(f'SMTP 25 to MX of {domain}', mx, 25))
        else:
            jobs.append(lambda: {'test': f'SMTP 25 to MX of {domain}', 'result': 'skipped', 'ms': 0, 'hint': 'No MX found.'})
        relay = _postconf('relayhost').replace('[', '').replace(']', '')
        if relay:
            host = relay.split(':')[0]
            jobs += [lambda: _test_tcp(f'Smarthost {host}:{port}', host, port, 'Check the smarthost.') for port in (587, 465)]
    if only in ('all', 'https'):
        jobs += [lambda h=host: _test_tcp(f'HTTPS to {h}', h, 443, 'Updates need this.') for host in UPDATE_TEST_HTTPS]
    if only in ('all', 'http'):
        jobs += [lambda h=host: _test_tcp(f'HTTP to {h}', h, 80, 'Certificates and OS repos need this.') for host in UPDATE_TEST_HTTP]
    if only in ('all', 'ntp'):
        jobs.append(lambda: _test_ntp('NTP to pool.ntp.org', 'pool.ntp.org'))
    rows = []
    if only in ('all', 'inbound'):
        running = _fw('--state').returncode == 0 if shutil.which('firewall-cmd') else False
        rows.append({'test': 'firewalld running', 'result': 'ok' if running else 'failed', 'ms': 0, 'hint': ''})
        rows.append({'test': 'Firewall guard', 'result': 'on' if state['guard'] else 'off', 'ms': 0, 'hint': ''})
        for port in _firewall_ports(state):
            rows.append({'test': f'Listening on port {port}', 'result': 'ok' if _test_listening(port) else 'failed', 'ms': 0,
                         'hint': '' if _test_listening(port) else 'No service listens on this port.'})
        if state['probe_url']:
            jobs += [lambda p=port: _test_probe(state['probe_url'], p) for port in ('25', '443', '80', _ssh_port())]
    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
        rows += list(pool.map(lambda job: job(), jobs))
    outside = None
    if only in ('all', 'inbound') and not state['probe_url']:
        outside = ('No probe is set. From another machine run, with your server address: nc -vz SERVER 25; nc -vz SERVER 443; '
                   'nc -vz SERVER 80; or run efa-probe on a server of yours and set its address here.')
    when = time.strftime('%Y-%m-%d %H:%M:%S')
    text = '\n'.join([f'eFa firewall test {when}'] + [f'{row["test"]}: {row["result"]} ({row["ms"]} ms) {row["hint"]}'.rstrip() for row in rows]) + '\n'
    return {'when': when, 'tests': rows, 'outside_check': outside, 'text': text}


def firewall_probe_set(args):
    """Address of your own efa-probe, which checks from outside whether this server answers."""
    url = args.url.strip()
    if url and not re.match(r'^https?://[A-Za-z0-9.:\[\]-]+(/[A-Za-z0-9._/-]*)?$', url):
        raise EfaError('Invalid probe address.')
    state = _firewall_state()
    state['probe_url'] = url
    _json_write(FIREWALL_FILE, state)
    return {'probe_url': url}


def _system_state():
    state = _json_read(UPDATE_SYSTEM_FILE, {})
    for key in ('state', 'started', 'finished', 'result', 'backup', 'config_export'):
        state.setdefault(key, None)
    return state


def _system_log(text):
    os.makedirs(os.path.dirname(UPDATE_SYSTEM_LOG), exist_ok=True)
    with open(UPDATE_SYSTEM_LOG, 'a') as log:
        log.write(f'{time.strftime("%Y-%m-%d %H:%M:%S")} {text}\n')


# Package scripts that reload or restart firewalld can take the firewall down while other tools change it
# (some run at the full hour). Those packages are left out of a system update, and the update starts only in this window.
UPDATE_WINDOW = (20, 50)
FIREWALL_SCRIPT_RE = re.compile(r'firewall-cmd\b[^\n]*--(complete-)?reload|systemctl\b[^\n]*\b(restart|reload|try-restart|reload-or-restart|start)\b[^\n]*\bfirewalld'
                                r'|systemd-update-helper\b[^\n]*\bmark-restart-system-units\b[^\n]*\bfirewalld|%systemd_postun_with_restart[^\n]*firewalld', re.I)


def firewall_script_lines(scripts):
    """Lines of package scripts that would reload or restart firewalld."""
    return [line.strip() for line in scripts.splitlines() if FIREWALL_SCRIPT_RE.search(line)]


def update_window_wait(now):
    """None inside the window, else the next start time as a datetime."""
    if UPDATE_WINDOW[0] <= now.minute <= UPDATE_WINDOW[1]:
        return None
    start = now.replace(minute=UPDATE_WINDOW[0], second=0, microsecond=0)
    return start if now.minute < UPDATE_WINDOW[0] else start + datetime.timedelta(hours=1)


def _firewall_risky_updates():
    """{package: script line} for pending updates whose scripts or triggers touch firewalld. Downloads them, installs nothing."""
    folder = tempfile.mkdtemp(prefix='efa-upd-check-', dir='/var/tmp')
    try:
        done = subprocess.run(['dnf', '-y', '-q', 'upgrade', '--downloadonly', f'--downloaddir={folder}', '--exclude=eFa', '--exclude=eFa-base'],
                              capture_output=True, text=True, timeout=1800)
        if done.returncode != 0:
            raise EfaError(f'Downloading the updates for the check failed: {done.stderr[-200:]}')
        risky = {}
        for path in sorted(glob.glob(folder + '/*.rpm')):
            info = subprocess.run(['rpm', '-qp', '--qf', '%{NAME}', path], capture_output=True, text=True).stdout.strip()
            scripts = subprocess.run(['rpm', '-qp', '--scripts', '--triggers', path], capture_output=True, text=True).stdout
            lines = firewall_script_lines(scripts)
            if info and lines:
                risky[info] = lines[0][:160]
        return risky
    finally:
        shutil.rmtree(folder, ignore_errors=True)


def _pending_os_updates():
    done = subprocess.run(['dnf', '-q', 'check-update'], capture_output=True, text=True, timeout=300)
    # 100 means updates exist, 0 none, anything else is an error.
    if done.returncode not in (0, 100):
        raise EfaError(f'dnf check-update failed: {done.stderr[-200:]}')
    packages = []
    for line in done.stdout.splitlines():
        parts = line.split()
        if len(parts) == 3 and '.' in parts[0] and not line.startswith(' '):
            packages.append({'package': parts[0], 'version': parts[1], 'repository': parts[2]})
    return packages


def _reboot_required():
    if shutil.which('needs-restarting') is None:
        return None
    return subprocess.run(['needs-restarting', '-r'], capture_output=True, timeout=120).returncode == 1


def update_pending(_args):
    """What an update of the system would install, and whether a reboot is due."""
    update = _update_state()
    return {'os_updates': _pending_os_updates(), 'efa_installed': _update_installed(), 'efa_latest': update['latest'],
            'efa_update': _update_available(update), 'reboot_required': _reboot_required()}


def update_status(_args):
    """State of the last system update, with its log."""
    state = _system_state()
    lines = _read_lines(UPDATE_SYSTEM_LOG)
    return {**state, 'log': lines[-40:]}


def update_system(args):
    """Backup and config export first, then OS and eFa updates in the background, optionally with a reboot."""
    _confirm(args)
    reboot = (args.reboot or 'off').strip() == 'on'
    if reboot and (args.reboot_confirm or '').strip() != 'yes':
        raise EfaError('The automatic reboot is at your own risk and mail is not accepted during it. '
                       "Type 'yes' in the reboot field to accept that.")
    blocker = _update_blocker()
    if blocker:
        raise EfaError(blocker)
    dry = (args.dry_run or '').strip() == 'yes'
    start = update_window_wait(datetime.datetime.now())
    timer = ['--on-calendar=' + start.strftime('%Y-%m-%d %H:%M:00'), '--timer-property=AccuracySec=1s'] if start and not dry else []
    done = subprocess.run(['systemd-run', '--unit=efa-update-system', '--collect', *timer, '/usr/sbin/efactl', 'update-system-run',
                           f'--reboot={"on" if reboot else "off"}', f'--dry_run={"yes" if dry else "no"}'],
                          capture_output=True, text=True)
    if done.returncode != 0:
        raise EfaError(f'Could not start: {done.stderr[-200:]}')
    if timer:
        return {'update': f"will run at {start.strftime('%H:%M')}", 'why': f'System updates start only between minute {UPDATE_WINDOW[0]} and {UPDATE_WINDOW[1]}.',
                'dry_run': dry, 'reboot': reboot, 'progress': 'efactl update-status'}
    return {'update': 'started', 'dry_run': dry, 'reboot': reboot, 'progress': 'efactl update-status'}


def update_system_run(args):
    """The background part of update-system."""
    lock = open(UPDATE_LOCK, 'w')
    try:
        import fcntl
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        raise EfaError('Another update is running.')
    state = _system_state()
    state.update(state='running', started=time.strftime('%Y-%m-%d %H:%M:%S'), finished=None, result=None)
    dry = args.dry_run.strip() == 'yes'
    reboot = args.reboot.strip() == 'on'

    def finish(result, ok):
        state.update(state='done' if ok else 'failed', finished=time.strftime('%Y-%m-%d %H:%M:%S'), result=result)
        _json_write(UPDATE_SYSTEM_FILE, state)
        _system_log(result)
        _admin_notify(f'eFa: system update {"finished" if ok else "failed"}', result)
        return {'result': result}
    _json_write(UPDATE_SYSTEM_FILE, state)
    _system_log(f'started, dry run {dry}, reboot {reboot}')
    try:
        state['backup'] = backup_now(None)['backup']
        state['config_export'] = _backup_make(_backup_stored_password(), database=False, prefix='config-')['backup']
    except (OSError, EfaError, subprocess.CalledProcessError) as err:
        return finish(f'Backup failed, nothing was updated: {err}', False)
    _json_write(UPDATE_SYSTEM_FILE, state)
    _system_log(f'backup {state["backup"]}, config export {state["config_export"]}')
    try:
        pending = _pending_os_updates()
    except (EfaError, subprocess.TimeoutExpired) as err:
        return finish(f'{err}', False)
    _system_log(f'{len(pending)} operating system updates pending')
    try:
        risky = _firewall_risky_updates() if pending else {}
    except (EfaError, subprocess.TimeoutExpired) as err:
        return finish(f'The check of the package scripts failed, nothing was updated: {err}', False)
    skipped = (f'Left out, their scripts reload or restart firewalld: {", ".join(sorted(risky))}. '
               f'Install them by hand between minute {UPDATE_WINDOW[0]} and {UPDATE_WINDOW[1]}, then run efactl firewall-guard-run. ') if risky else ''
    for name, line in sorted(risky.items()):
        _system_log(f'left out {name}: {line}')
    update = _update_state()
    if dry:
        _maintenance('on')
        problems = _update_health()
        _maintenance('off')
        return finish(f'Dry run: nothing installed. Pending: {len(pending)}. {skipped}eFa update: {_update_available(update)}. '
                      f'Health check: {"; ".join(problems) or "ok"}.', not problems)
    notes = []
    if _update_available(update):
        result = _update_install(update)
        notes.append(result)
        _system_log(result)
        if not result.startswith('Installed'):
            return finish(result, False)
    _maintenance('on')
    try:
        # No blocklist run while the packages change (9m); the table of eFa survives any firewalld reload of a package.
        with _firewall_lock(900):
            done = subprocess.run(['dnf', '-y', 'upgrade', '--exclude=eFa', '--exclude=eFa-base', *[f'--exclude={name}' for name in sorted(risky)]],
                                  capture_output=True, text=True, timeout=3600)
    except subprocess.TimeoutExpired:
        _maintenance('off')
        return finish(f'Operating system update did not finish within an hour. Backup: {state["backup"]}', False)
    with open(UPDATE_SYSTEM_LOG, 'a') as log:
        log.write(done.stdout[-8000:])
    if done.returncode != 0:
        _maintenance('off')
        return finish(f'Operating system update failed: {done.stderr[-300:]}. Backup: {state["backup"]}', False)
    # Package scripts can run firewall-cmd --reload, and firewalld can lose its zones on that. Do not wait for the timer.
    firewall_guard_run(None)
    problems = _update_health()
    if problems or not reboot:
        _maintenance('off')
    if problems:
        return finish(f'Health check after the update: {"; ".join(problems)}. No reboot. Backup: {state["backup"]}', False)
    if not reboot:
        return finish(f'Updated, health check ok. {skipped}Reboot required: {_reboot_required()}. {" ".join(notes)}', True)
    _system_log('rebooting: mail intake stops now')
    _write(POST_BOOT_MARK, _update_installed() + '\n')
    subprocess.run(['systemctl', 'stop', 'postfix'], check=False, capture_output=True)
    time.sleep(10)
    state.update(state='rebooting', finished=None)
    _json_write(UPDATE_SYSTEM_FILE, state)
    subprocess.run(['systemctl', 'reboot'], check=False, capture_output=True)
    return {'result': 'rebooting'}


def update_post_boot(_args):
    """After a reboot from update-system: health check, result on the dashboard and to the admin."""
    if not os.path.exists(POST_BOOT_MARK):
        return {'post_boot': 'nothing to do'}
    os.remove(POST_BOOT_MARK)
    _maintenance('off')
    problems = _update_health()
    state = _system_state()
    text = 'Reboot finished, health check ok.' if not problems else f'After the reboot: {"; ".join(problems)}'
    state.update(state='done' if not problems else 'failed', finished=time.strftime('%Y-%m-%d %H:%M:%S'), result=text)
    _json_write(UPDATE_SYSTEM_FILE, state)
    _system_log(text)
    _admin_notify('eFa: system update and reboot', text)
    return {'post_boot': text}


def load_set(args):
    """Limits of the load warning. The file holds no secret, efa-web reads it directly."""
    if not (args.percent.isdigit() and 1 <= int(args.percent) <= 100 and args.minutes.isdigit() and 1 <= int(args.minutes) <= 1440):
        raise EfaError('Percent must be from 1 to 100, minutes from 1 to 1440.')
    data = {'percent': int(args.percent), 'minutes': int(args.minutes)}
    _write(LOAD_FILE, json.dumps(data) + '\n')
    return data


def load_notify(args):
    # Called once a day per resource by efa-web. The text is shown only to the admin, as the body of the mail.
    text = re.sub(r'[^A-Za-z0-9 %.,:/-]', '', args.text)[:300]
    _admin_notify('eFa: sustained load', text)
    return {'mailed': True}


def _version_tuple(text):
    match = re.search(r'(\d+)\.(\d+)\.(\d+)\.(\d+)', text or '')
    return tuple(int(part) for part in match.groups()) if match else None


def _update_state():
    state = _json_read(UPDATE_FILE, {})
    state.setdefault('mode', 'notify')
    state.setdefault('days', ['sun'])
    state.setdefault('time', '03:00')
    for key in ('last_check', 'latest', 'notes', 'notified', 'last_result'):
        state.setdefault(key, None)
    return state


def _update_installed():
    lines = _read_lines(ETC + '/eFa-Version')
    return lines[0] if lines else ''


def _update_available(state, verified_only=True):
    latest, installed = _version_tuple(state['latest']), _version_tuple(_update_installed())
    newer = bool(latest and installed and latest > installed)
    # Before the packages were checked, the dashboard does not call it available.
    return newer and (not verified_only or state.get('verified') == state['latest'])


SECURITY_RE = re.compile(r'\bsecurity\b|\bCVE-\d{4}-\d+', re.I)


def release_info(release):
    """What the dashboard shows of a release: version, date, a part of the notes, and whether it fixes security issues."""
    notes = (release.get('body') or '')[:4000]
    return {'latest': release['tag_name'], 'notes': notes, 'published': (release.get('published_at') or '')[:10],
            'security': bool(SECURITY_RE.search(notes) or SECURITY_RE.search(release.get('name') or ''))}


def _update_fetch_latest(state, opener=urllib.request.urlopen):
    """Asks the release source once, with the ETag of the last answer: an unchanged release costs no download.
    No telemetry: the request carries no version, host name or ID. A source that is not there (a private repository) is a state, not an error."""
    state['last_check'] = time.strftime('%Y-%m-%d %H:%M:%S')
    # The notes are shown only; what gets installed is checked against the signed SHA256SUMS in _update_download.
    for source in (UPDATE_API, UPDATE_MIRROR_API):
        headers = {'Accept': 'application/vnd.github+json', 'User-Agent': 'eFa-next'}
        if state.get('etag') and source == UPDATE_API:
            headers['If-None-Match'] = state['etag']
        try:
            with opener(urllib.request.Request(source, headers=headers), timeout=30) as reply:
                release = json.load(reply)
                etag = reply.headers.get('ETag') if source == UPDATE_API else None
        except urllib.error.HTTPError as err:
            if err.code == 304:
                state['source'] = 'reachable'
                return False
            state['last_result'] = f'Release source not reachable (HTTP {err.code}); the repository may be private. Nothing changed.'
            continue
        except (OSError, ValueError) as err:
            state['last_result'] = f'Release source not reachable: {str(err)[:120]}. Nothing changed.'
            continue
        state.update(release_info(release), source='reachable' if source == UPDATE_API else 'mirror', etag=etag)
        return True
    state['source'] = 'not reachable'
    return False


def _update_verify(state, fetch=None):
    """An update counts as available only when its two packages are there and match the checksums of the release."""
    if not _update_available(state, verified_only=False) or state.get('verified') == state['latest']:
        return
    folder = f"{UPDATE_DIR}/{state['latest']}"
    try:
        (fetch or _update_download)(state['latest'], folder)
    except (EfaError, OSError, ValueError) as err:
        state['verified'] = None
        state['last_result'] = f"Release {state['latest']} is not complete or does not match its checksums: {str(err)[:150]}"
        return
    state['verified'] = state['latest']
    state['first_seen'] = state.get('first_seen') if state.get('first_seen_version') == state['latest'] else time.strftime('%Y-%m-%d')
    state['first_seen_version'] = state['latest']


def _update_note(state):
    if _update_available(state) and state['notified'] != state['latest']:
        state['notified'] = state['latest']
        kind = 'security update' if state.get('security') else 'update'
        _event('update_available', 'warning' if state.get('security') else 'notice', version=state['latest'], security=bool(state.get('security')))
        _admin_notify(f'eFa: {kind} {state["latest"]} is available', f'Installed: {_update_installed()}\nPublished: {state.get("published") or "unknown"}\n\n{state["notes"]}')


def update_check(_args):
    """Asks GitHub for the newest release and mails the admin once per new version."""
    state = _update_state()
    _update_fetch_latest(state)
    _update_verify(state)
    _update_note(state)
    _json_write(UPDATE_FILE, state)
    return autoupdate_status(None)


def autoupdate_set(args):
    """Off, notify only, or install eFa updates by itself inside the maintenance window."""
    mode = args.mode.strip()
    if mode not in ('off', 'notify', 'auto'):
        raise EfaError("Mode must be 'off', 'notify' or 'auto'.")
    days = [day for day in args.days.replace(',', ' ').lower().split()]
    if not days or [day for day in days if day not in UPDATE_DAYS]:
        raise EfaError(f'Days must be from: {" ".join(UPDATE_DAYS)}.')
    if not re.match(r'^([01]\d|2[0-3]):[0-5]\d$', args.time.strip()):
        raise EfaError('Time must look like 03:00.')
    state = _update_state()
    state.update(mode=mode, days=days, time=args.time.strip())
    _json_write(UPDATE_FILE, state)
    return autoupdate_status(None)


def autoupdate_status(_args):
    """State of eFa updates. Operating system updates are handled by dnf-automatic."""
    state = _update_state()
    done = subprocess.run(['systemctl', 'is-enabled', 'dnf-automatic.timer'], capture_output=True, text=True)
    return {'installed': _update_installed(), 'latest': state['latest'], 'update_available': _update_available(state),
            'security_update': bool(state.get('security')) and _update_available(state), 'published': state.get('published'),
            'source': state.get('source') or 'not checked yet',
            'release_notes': state['notes'], 'mode': state['mode'], 'days': ' '.join(state['days']), 'time': state['time'],
            'last_check': state['last_check'], 'last_result': state['last_result'],
            'os_updates': 'dnf-automatic ' + (done.stdout.strip() or 'not installed'),
            'trust_note': UPDATE_TRUST_NOTE}


def _update_in_window(state, now):
    """Inside for the hour after the set time, because the job runs hourly."""
    hour, minute = map(int, state['time'].split(':'))
    start = now.replace(hour=hour, minute=minute, second=0, microsecond=0)
    return UPDATE_DAYS[now.weekday()] in state['days'] and start <= now < start + datetime.timedelta(hours=1)


def _update_blocker():
    if os.path.exists('/etc/MailScanner/MailScanner.conf'):
        return 'MailScanner is installed, use efa-migrate.'
    if not os.path.exists(MONITOR_CRON):
        return 'Maintenance mode is on.'
    if os.path.exists(RESTORE_RUNNING):
        return 'A restore is running.'
    return None


UPDATE_PREVIOUS = '/var/lib/eFa/update-previous.json'


def _signed_sums(version, fetch=None):
    """SHA256SUMS of a release with its base address, from the repository or the mirror, only with a valid signature of the pinned key."""
    sign = _lib('efa_sign')
    with open(sign.KEY_FILE, 'rb') as f:
        key = f.read()
    fetch = fetch or (lambda url: urllib.request.urlopen(url, timeout=60).read())
    problems = []
    for base in (UPDATE_DOWNLOAD.format(tag=version), UPDATE_MIRROR_DOWNLOAD.format(tag=version)):
        try:
            data, signature = fetch(f'{base}/SHA256SUMS'), fetch(f'{base}/SHA256SUMS.asc')
        except (OSError, ValueError) as err:
            problems.append(f'{base}: {str(err)[:80]}')
            continue
        if sign.verify(data, signature, key):
            return base, dict(reversed(line.split()) for line in data.decode().splitlines() if line.strip())
        problems.append(f'{base}: signature not valid')
    raise EfaError(f'Release {version} has no SHA256SUMS signed by the eFa-next key ({"; ".join(problems)}), nothing was installed.')


def _update_download(version, folder):
    """Fetches the two packages of a release and checks them against its signed SHA256SUMS."""
    os.makedirs(folder, mode=0o700, exist_ok=True)
    plain = version.lstrip('v')
    base, sums = _signed_sums(version)
    # The release part of the file names differs between versions.
    names = [n for n in sums if n.startswith((f'eFa-{plain}-', f'eFa-base-{plain}-')) and n.endswith('.rpm')]
    if len(names) != 2:
        raise EfaError(f'Release {version} does not list two packages, nothing was installed.')
    paths = []
    for name in names:
        with urllib.request.urlopen(f'{base}/{name}', timeout=300) as reply:
            data = reply.read()
        if name not in sums or hashlib.sha256(data).hexdigest() != sums[name]:
            raise EfaError(f'Checksum of {name} does not match, nothing was installed.')
        path = f'{folder}/{name}'
        with open(path, 'wb') as f:
            f.write(data)
        paths.append(path)
    return paths


def _update_health():
    """Services, rspamd config, status and the web interface, with some time to come up."""
    problems = []
    for _attempt in range(6):
        problems = [f'{unit} is not active' for unit in UPDATE_UNITS
                    if subprocess.run(['systemctl', 'is-active', '--quiet', unit]).returncode != 0]
        if not _rspamd_config_ok():
            problems.append('rspamd config test failed')
        try:
            context = ssl._create_unverified_context()
            with urllib.request.urlopen('https://127.0.0.1/login', timeout=10, context=context) as reply:
                if reply.status != 200:
                    problems.append(f'web interface answered {reply.status}')
        except OSError as err:
            problems.append(f'web interface: {err}')
        try:
            if status(None)['status'] != 'ok':
                problems.append('efactl status is not ok')
        except EfaError as err:
            problems.append(str(err))
        if not problems:
            return []
        time.sleep(10)
    return problems


def _maintenance(mode):
    maintenance_set(argparse.Namespace(mode=mode))


def _update_install(state):
    """Runs the install in maintenance mode, so the service monitor does not interfere."""
    blocker = _update_blocker()
    if blocker:
        return f'Not installed: {blocker}'
    _maintenance('on')
    try:
        return _update_install_steps(state)
    finally:
        _maintenance('off')


def _update_install_steps(state):
    """Backup, install from verified local files, health check, and back to the old packages if it fails."""
    if not _update_available(state):
        return 'Not installed: no newer version known.'
    current = 'v' + '.'.join(map(str, _version_tuple(_update_installed())))
    new = state['latest']
    try:
        rollback = _update_download(current, f'{UPDATE_DIR}/rollback-{current}')
        packages = _update_download(new, f'{UPDATE_DIR}/{new}')
        backup = backup_now(None)['backup']
    except (OSError, ValueError, EfaError, subprocess.CalledProcessError) as err:
        return f'Not installed: {err}'
    with _firewall_lock(900):
        done = subprocess.run(['dnf', '-y', 'upgrade'] + packages, capture_output=True, text=True)
    version_ok = _version_tuple(_update_installed()) == _version_tuple(new)
    problems = [] if done.returncode == 0 and version_ok else [f'dnf failed: {(done.stderr or done.stdout)[-300:]}']
    problems = problems or _update_health()
    if not problems:
        # The way back for update-rollback: the verified packages of the version before, and the backup taken right before.
        _json_write(UPDATE_PREVIOUS, {'version': current, 'packages': rollback, 'backup': backup, 'installed': new,
                                      'at': time.strftime('%Y-%m-%d %H:%M:%S')})
        return f'Installed {new}, backup {backup}.'
    undo = subprocess.run(['dnf', '-y', 'downgrade'] + rollback, capture_output=True, text=True)
    for unit in ('efa-web', 'efa-maillog', 'efa-milter-health'):
        subprocess.run(['systemctl', 'restart', unit], check=False, capture_output=True)
    undone = undo.returncode == 0 and _version_tuple(_update_installed()) == _version_tuple(current)
    text = (f'Update to {new} failed: {"; ".join(problems)}. '
            + (f'Rolled back to {current}.' if undone else f'ROLLBACK FAILED, check the system. Backup: {backup}.'))
    _admin_notify('eFa: automatic update failed', text)
    return text


def rollback_plan(previous, installed, exists=os.path.exists):
    """What update-rollback would do, or why it cannot."""
    if not previous:
        return None, 'No update of eFa was installed by this server, so there is no version to go back to.'
    if _version_tuple(installed) != _version_tuple(previous['installed']):
        return None, f"The installed version is {installed}, not {previous['installed']}: it changed since, roll back by hand."
    missing = [path for path in previous['packages'] if not exists(path)]
    if missing:
        return None, 'The packages of the version before are gone: ' + ', '.join(missing)
    return {'from': installed, 'to': previous['version'], 'packages': previous['packages'], 'backup': previous['backup']}, None


def update_rollback(args):
    """Back to the version before the last eFa update: its verified packages, then the backup taken right before the update.
    --dry_run yes only shows it. Settings changed since the update are lost with the backup; --backup off keeps them."""
    plan, problem = rollback_plan(_json_read(UPDATE_PREVIOUS, None), _update_installed())
    if problem:
        raise EfaError(problem)
    keep = (args.backup or 'on').strip() == 'off'
    if (args.dry_run or '').strip() == 'yes':
        return {**plan, 'restore_backup': not keep, 'dry_run': True}
    _confirm(args)
    blocker = _update_blocker()
    if blocker:
        raise EfaError(blocker)
    _maintenance('on')
    try:
        ok, output = _platform().package_downgrade(plan['packages'])
        if not ok or _version_tuple(_update_installed()) != _version_tuple(plan['to']):
            raise EfaError(f"The downgrade failed, still {_update_installed()}: {output}")
        restored = None
        if not keep:
            restored = restore(argparse.Namespace(name=plan['backup'], confirm='yes', file=''))['restored']
    finally:
        _maintenance('off')
    for unit in ('efa-web', 'efa-maillog', 'efa-milter-health'):
        try:
            _platform().service_restart(unit)
        except Exception as err:  # the StepError of the platform layer; the rollback itself is done
            print(f'restart {unit}: {err}', file=sys.stderr)
    os.remove(UPDATE_PREVIOUS)
    _admin_notify('eFa: rolled back', f"eFa went back from {plan['from']} to {plan['to']}" + (f', backup {restored} restored.' if restored else '.'))
    return {'rolled_back_to': plan['to'], 'backup_restored': restored}


def update_run(args):
    """Hourly job: checks GitHub once a day, installs only in auto mode inside the window."""
    # The hourly job and an install button must not run at the same time.
    lock = open(UPDATE_LOCK, 'w')
    try:
        import fcntl
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return {'update': 'already running'}
    state = _update_state()
    force = (getattr(args, 'install', '') or '').strip() == 'yes'
    if state['mode'] == 'off' and not force:
        return {'update': 'off'}
    if force or not state['last_check'] or state['last_check'][:10] != time.strftime('%Y-%m-%d'):
        _update_fetch_latest(state)
        _update_verify(state)
    _update_note(state)
    _json_write(UPDATE_FILE, state)
    if _update_available(state) and (force or (state['mode'] == 'auto' and _update_in_window(state, datetime.datetime.now()))):
        state['last_result'] = f'{time.strftime("%Y-%m-%d %H:%M")} {_update_install(state)}'
        _json_write(UPDATE_FILE, state)
    return autoupdate_status(None)


def update_install(args):
    """Installs the newest eFa release now, in the background; the web interface restarts on the way."""
    _confirm(args)
    blocker = _update_blocker()
    if blocker:
        raise EfaError(blocker)
    subprocess.run(['systemd-run', '--unit=efa-autoupdate-now', '--collect', '/usr/sbin/efactl', 'update-run', '--install=yes'],
                   check=True, capture_output=True)
    return {'update': 'started', 'log': 'journalctl -u efa-autoupdate-now', 'result': 'efactl autoupdate-status'}


def mariadb_repair(args):
    """Repair and optimize all databases. Mail stays queued meanwhile."""
    _confirm(args)
    env = _mysql_env()
    subprocess.run(['systemctl', 'stop', 'postfix'], check=False, capture_output=True)
    try:
        for mode in ('--repair', '--optimize'):
            done = subprocess.run(['mysqlcheck', '--user=root', mode, '--all-databases'], env=env,
                                  capture_output=True, text=True, check=True)
    finally:
        subprocess.run(['systemctl', 'start', 'postfix'], check=False, capture_output=True)
    return {'mariadb_repair': 'done', 'output': done.stdout[-500:]}


def network_show(_args):
    """Current hostname and network settings."""
    device = _network_device()
    done = subprocess.run(['nmcli', '-t', '-f', 'ipv4.method,ipv4.addresses,ipv4.gateway,ipv4.dns',
                           'connection', 'show', device], capture_output=True, text=True, check=True)
    return dict(line.split(':', 1) for line in done.stdout.splitlines()) | {
        'connection': device, 'hostname': subprocess.run(['hostname', '-f'], capture_output=True, text=True).stdout.strip()}


def _network_device():
    done = subprocess.run(['nmcli', '-t', '-f', 'NAME,TYPE', 'connection', 'show', '--active'],
                          capture_output=True, text=True, check=True)
    for line in done.stdout.splitlines():
        name, _, kind = line.rpartition(':')
        if kind == '802-3-ethernet':
            return name
    raise EfaError('No active ethernet connection.')


def network_set(args):
    """Set hostname and IPv4 address. Takes effect after the next reboot so a typo cannot cut the session."""
    _confirm(args)
    fqdn = args.hostname.strip().lower()
    if not DOMAIN_RE.match(fqdn):
        raise EfaError('Hostname must be a full name, for example mx1.example.org.')
    method = args.method.strip()
    if method not in ('auto', 'manual'):
        raise EfaError("Method must be 'auto' or 'manual'.")
    # Validate everything first: nmcli only runs once all input is known to be good.
    if method == 'manual':
        try:
            iface = ipaddress.IPv4Interface(args.address.strip())
            gateway = ipaddress.IPv4Address(args.gateway.strip())
        except ValueError:
            raise EfaError('Address must look like 192.0.2.10/24 and the gateway like 192.0.2.1.')
        if gateway not in iface.network:
            raise EfaError('Gateway is not in the network of the address.')
        ipv4 = ['ipv4.method', 'manual', 'ipv4.addresses', str(iface), 'ipv4.gateway', str(gateway)]
        address = str(iface.ip)
    else:
        ipv4 = ['ipv4.method', 'auto', 'ipv4.addresses', '', 'ipv4.gateway', '']
        address = None
    method6 = args.ipv6_method.strip() or 'ignore'
    if method6 not in ('auto', 'manual', 'ignore'):
        raise EfaError("IPv6 method must be 'auto', 'manual' or 'ignore'.")
    address6 = None
    if method6 == 'manual':
        try:
            iface6 = ipaddress.IPv6Interface(args.ipv6_address.strip())
            gateway6 = ipaddress.IPv6Address(args.ipv6_gateway.strip())
        except ValueError:
            raise EfaError('IPv6 address must look like 2001:db8::10/64 and the gateway like 2001:db8::1.')
        ipv6 = ['ipv6.method', 'manual', 'ipv6.addresses', str(iface6), 'ipv6.gateway', str(gateway6), 'ipv6.dns', '::1']
        address6 = str(iface6.ip)
    else:
        ipv6 = ['ipv6.method', method6, 'ipv6.addresses', '', 'ipv6.gateway', '']
    device = _network_device()
    subprocess.run(['nmcli', 'connection', 'modify', device] + ipv4 + ['ipv4.dns', '127.0.0.1'] + ipv6, check=True,
                   capture_output=True)
    short = fqdn.split('.')[0]
    shutil.copy2(HOSTS, HOSTS + '.bak')
    lines = ['127.0.0.1   localhost localhost.localdomain localhost4 localhost4.localdomain4',
             '::1         localhost localhost.localdomain localhost6 localhost6.localdomain6']
    if address:
        lines.append(f'{address}    {fqdn}   {short}')
    if address6:
        lines.append(f'{address6}    {fqdn}   {short}')
    _write(HOSTS, '\n'.join(lines) + '\n')
    _write(ETC + '/hostname', fqdn + '\n')
    _postconf_set('myhostname', fqdn)
    return {'hostname': fqdn, 'method': method, 'address': args.address.strip(), 'ipv6_method': method6,
            'ipv6_address': args.ipv6_address.strip(), 'effective': 'after reboot'}


# The files of eFa that name the host. Others (logs, copies, the history of a migration) keep the old name.
HOSTNAME_MAPS = ('helo_access', 'sender_canonical', 'recipient_canonical', 'canonical', 'generic', 'virtual', 'transport', 'relocated')


def renamed_text(text, old, new):
    """Every whole occurrence of the old host name (full and short, any case) as the new one: full for full, short for short."""
    old_short, new_short = old.split('.')[0], new.split('.')[0]
    text = re.sub(r'(?<![\w.-])' + re.escape(old) + r'(?![\w-])', new, text, flags=re.I)
    return re.sub(r'(?<![\w.-])' + re.escape(old_short) + r'(?![\w.-])', new_short, text, flags=re.I)


def hostname_set(args):
    """The host name everywhere eFa writes it: the system, /etc/hosts, Postfix and its tables, the eFa settings, the address
    of the checked links and the self-signed certificate. A certificate of Let's Encrypt or an own one stays: request a new one."""
    _confirm(args)
    new = args.hostname.strip().lower().rstrip('.')
    if not DOMAIN_RE.match(new) or '.' not in new:
        raise EfaError('Host name: a full name, such as mx2.example.org.')
    old = (_postconf('myhostname') or socket.getfqdn()).strip().lower()
    changed = []
    # The same name again only puts the own address into /etc/hosts (a clone has the address of its origin there).
    if old != new:
        subprocess.run(['hostnamectl', 'set-hostname', new], check=False, capture_output=True)
        _write(ETC + '/hostname', new + '\n')
        changed.append('/etc/hostname')
    paths = [HOSTS, ETC + '/eFa/eFa-Config'] + [f'{ETC}/postfix/{name}' for name in HOSTNAME_MAPS] if old != new else []
    for path in paths:
        if not os.path.exists(path):
            continue
        with open(path) as f:
            text = f.read()
        fixed = renamed_text(text, old, new)
        if fixed != text:
            shutil.copy2(path, path + '.before-rename')
            _write(path, fixed)
            changed.append(_etc_relative(path))
            if path.startswith(ETC + '/postfix/') and os.path.exists(path + '.db'):
                subprocess.run(['postmap', path], check=False, capture_output=True)
    # The block of eFa in /etc/hosts names this host by its own address now; a clone keeps the address of its origin otherwise.
    own = _own_address(socket.AF_INET, '192.0.2.1')
    if own and os.path.exists(HOSTS):
        sys.path.insert(0, '/usr/lib/eFa/python')
        import efa_common
        with open(HOSTS) as f:
            text = f.read()
        fixed = efa_common.replace_block(text, [f'{own} {new} {new.split(".")[0]}'])
        if fixed != text:
            _write(HOSTS, fixed)
            changed.append(f'/etc/hosts: {new} at {own}')
    _postconf_set('myhostname', new)
    changed.append('postfix myhostname')
    content = _json_read(CONTENT_FILE, {})
    base = content.get('links', {}).get('base', '')
    if base and renamed_text(base, old, new) != base:
        content['links']['base'] = renamed_text(base, old, new)
        _write(CONTENT_FILE, json.dumps(content, indent=1))
        _content_apply(content)
        changed.append('address of the checked links')
    cert = _platform().path('cert_file') if hasattr(_platform(), 'path') else '/etc/pki/tls/certs/efa.crt'
    subject = subprocess.run(['openssl', 'x509', '-noout', '-subject', '-issuer', '-nameopt', 'RFC2253', '-in', cert], capture_output=True, text=True).stdout.split('\n')
    if len(subject) >= 2 and subject[0].replace('subject=', '') == subject[1].replace('issuer=', ''):
        sys.path.insert(0, '/usr/lib/eFa/python')
        import efa_common
        efa_common.ensure_certificate(new, force=True)
        changed.append('self-signed certificate')
    for unit in ('mta', 'web'):
        try:
            _platform().service_reload_if_active(_platform().service(unit))
        except Exception:  # noqa: S110 - a service this host does not have
            pass
    _audit(f'host name changed from {old} to {new} by {_dmarc_who()}')
    left = subprocess.run(['grep', '-rli', '--exclude=*.before-rename', '--exclude=*.bak*', '--exclude-dir=efa5-import', old, ETC + '/eFa', ETC + '/postfix',
                           ETC + '/efa-web', ETC + '/rspamd', ETC + '/nginx', HOSTS], capture_output=True, text=True).stdout.split()
    return {'hostname': new, 'was': old, 'changed': changed, 'still_naming_the_old_name': left,
            'note': 'DNS (A, PTR, MX), SPF and a certificate of Let\'s Encrypt are outside this host: change them too.'}


def letsencrypt_set(args):
    """Request a Let's Encrypt certificate for nginx and postfix. Port 80 must be reachable from outside."""
    domain = args.domain.strip().lower()
    email = args.email.strip().lower()
    if not DOMAIN_RE.match(domain):
        raise EfaError('Invalid domain.')
    if not SENDER_RE.match(email):
        raise EfaError('Invalid email address.')
    if args.accept_tos.strip() != 'yes':
        raise EfaError("Type 'yes' to accept the Let's Encrypt terms of service.")
    # 5t-b: ECDSA P-256 (BSI TR-02102-1), not RSA 2048.
    done = subprocess.run(['certbot', '--nginx', '--non-interactive', '--agree-tos', '--key-type', 'ecdsa', '--elliptic-curve', 'secp256r1',
                           '-m', email, '--domains', domain],
                          capture_output=True, text=True)
    if done.returncode != 0:
        raise EfaError('certbot failed: ' + (done.stderr or done.stdout)[-400:])
    live = f'{ETC}/letsencrypt/live/{domain}'
    _postconf_set('smtpd_tls_key_file', f'{live}/privkey.pem')
    _postconf_set('smtpd_tls_cert_file', f'{live}/fullchain.pem')
    _write(ETC + '/cron.d/certbotrenew',
           '0 0,12 * * * root certbot renew --quiet --deploy-hook "systemctl reload nginx postfix"\n')
    return {'letsencrypt': domain}


def _maillog_db():
    import pymysql
    with open(MAILLOG_PW) as f:
        password = f.read().strip()
    try:
        return _maillog_connect(pymysql, password)
    except pymysql.MySQLError as err:
        raise EfaError(f'The mail log database does not answer: {err}')


def _maillog_connect(pymysql, password):
    return pymysql.connect(unix_socket='/var/lib/mysql/mysql.sock', user='efa_log', password=password, database='efa',
                           charset='utf8mb4', autocommit=True, cursorclass=pymysql.cursors.DictCursor)


def maillog_live(args):
    """The newest mails, or only those after a known entry. The live log filters them in the browser."""
    after = (args.after_id or '').strip()
    if after and not after.isdigit():
        raise EfaError('after_id must be a number.')
    db = _maillog_db()
    try:
        with db.cursor() as cur:
            cur.execute('SELECT id, CAST(ts AS CHAR) AS ts, qid, message_id, sender, rcpt, ip, action, score, subject, '
                        'spf, dkim, dmarc FROM maillog WHERE id > %s ORDER BY id DESC LIMIT 1000', (int(after or 0),))
            return {'mails': cur.fetchall()}
    finally:
        db.close()


def maillog_setup(_args):
    """Create the mail log database and its restricted user. Safe to run again."""
    os.makedirs(WEB_DIR, mode=0o750, exist_ok=True)
    if os.path.exists(MAILLOG_PW):
        with open(MAILLOG_PW) as f:
            password = f.read().strip()
    else:
        password = secrets.token_urlsafe(32)
        fd = os.open(MAILLOG_PW, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o640)
        os.fchmod(fd, 0o640)  # the umask must not take the group read away
        with os.fdopen(fd, 'w') as f:
            f.write(password + '\n')
    shutil.chown(MAILLOG_PW, 'root', 'efa-web')
    sql = f"""CREATE DATABASE IF NOT EXISTS efa CHARACTER SET utf8mb4;
CREATE TABLE IF NOT EXISTS efa.maillog (
  id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
  ts DATETIME NOT NULL, qid VARCHAR(64), message_id VARCHAR(255), sender VARCHAR(255), rcpt VARCHAR(1000),
  ip VARCHAR(64), action VARCHAR(32), score FLOAT, subject VARCHAR(500),
  KEY ts (ts), KEY sender (sender), KEY qid (qid));
ALTER TABLE efa.maillog ADD COLUMN IF NOT EXISTS spf VARCHAR(16), ADD COLUMN IF NOT EXISTS dkim VARCHAR(16),
  ADD COLUMN IF NOT EXISTS dmarc VARCHAR(16), ADD COLUMN IF NOT EXISTS arc VARCHAR(16), ADD COLUMN IF NOT EXISTS threat VARCHAR(255),
  ADD COLUMN IF NOT EXISTS size INT UNSIGNED, ADD COLUMN IF NOT EXISTS symbols TEXT;
CREATE USER IF NOT EXISTS 'efa_log'@'localhost' IDENTIFIED BY '{password}';
ALTER USER 'efa_log'@'localhost' IDENTIFIED BY '{password}';
GRANT SELECT, INSERT, DELETE ON efa.maillog TO 'efa_log'@'localhost';
ALTER TABLE efa.maillog ADD COLUMN IF NOT EXISTS header_from VARCHAR(255), ADD COLUMN IF NOT EXISTS reply_to VARCHAR(255),
  ADD COLUMN IF NOT EXISTS return_path VARCHAR(255), ADD COLUMN IF NOT EXISTS x_mailer VARCHAR(255);
ALTER TABLE efa.maillog ADD KEY IF NOT EXISTS message_id (message_id(191)), ADD KEY IF NOT EXISTS header_from (header_from(191)),
  ADD KEY IF NOT EXISTS reply_to (reply_to(191)), ADD KEY IF NOT EXISTS return_path (return_path(191)), ADD KEY IF NOT EXISTS x_mailer (x_mailer(191));
CREATE TABLE IF NOT EXISTS efa.mail_headers (
  maillog_id BIGINT UNSIGNED PRIMARY KEY, ts DATETIME NOT NULL, domain VARCHAR(253) NOT NULL DEFAULT '', raw_size INT UNSIGNED NOT NULL,
  truncated TINYINT NOT NULL DEFAULT 0, data MEDIUMBLOB NOT NULL, KEY ts (ts), KEY domain (domain));
GRANT SELECT, INSERT ON efa.mail_headers TO 'efa_log'@'localhost';
CREATE TABLE IF NOT EXISTS efa.dns_records (
  sha256 CHAR(64) PRIMARY KEY, name VARCHAR(255) NOT NULL, type VARCHAR(8) NOT NULL, data BLOB NOT NULL, first_seen DATETIME NOT NULL,
  last_seen DATETIME NOT NULL, KEY last_seen (last_seen));
CREATE TABLE IF NOT EXISTS efa.mail_evidence (
  maillog_id BIGINT UNSIGNED PRIMARY KEY, ts DATETIME NOT NULL, domain VARCHAR(253) NOT NULL DEFAULT '', data MEDIUMBLOB NOT NULL, KEY ts (ts), KEY domain (domain));
GRANT SELECT, INSERT, UPDATE ON efa.dns_records TO 'efa_log'@'localhost';
GRANT SELECT, INSERT ON efa.mail_evidence TO 'efa_log'@'localhost';
ALTER TABLE efa.maillog ADD KEY IF NOT EXISTS rcpt (rcpt(191)), ADD KEY IF NOT EXISTS ip (ip), ADD KEY IF NOT EXISTS action (action),
  ADD FULLTEXT KEY IF NOT EXISTS subject_text (subject);
CREATE TABLE IF NOT EXISTS efa.sign_daily (
  day DATE NOT NULL, kind VARCHAR(16) NOT NULL, domain VARCHAR(253) NOT NULL, selector VARCHAR(64) NOT NULL DEFAULT '', n INT UNSIGNED NOT NULL,
  PRIMARY KEY (day, kind, domain, selector), KEY domain (domain));
CREATE TABLE IF NOT EXISTS efa.dmarc_rua (
  id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY, report_id VARCHAR(255) NOT NULL, org VARCHAR(255) NOT NULL, domain VARCHAR(253) NOT NULL,
  begin_ts DATETIME NOT NULL, end_ts DATETIME NOT NULL, source_ip VARCHAR(64) NOT NULL, n INT UNSIGNED NOT NULL, disposition VARCHAR(16) NOT NULL,
  dkim VARCHAR(16) NOT NULL, spf VARCHAR(16) NOT NULL, header_from VARCHAR(253) NOT NULL DEFAULT '',
  UNIQUE KEY report_row (org(100), report_id(100), source_ip, header_from(40)), KEY domain_day (domain, begin_ts));
CREATE TABLE IF NOT EXISTS efa.tls_rpt (
  id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY, report_id VARCHAR(255) NOT NULL, org VARCHAR(255) NOT NULL, domain VARCHAR(253) NOT NULL,
  begin_ts DATETIME NOT NULL, end_ts DATETIME NOT NULL, policy VARCHAR(16) NOT NULL, success INT UNSIGNED NOT NULL, failure INT UNSIGNED NOT NULL,
  failures JSON, UNIQUE KEY report_policy (org(100), report_id(100), policy), KEY domain_day (domain, begin_ts));
GRANT INSERT ON efa.dmarc_rua TO 'efa_log'@'localhost';
GRANT INSERT ON efa.tls_rpt TO 'efa_log'@'localhost';
""" + ADMIN_SQL
    subprocess.run(['mysql', '--user=root'], input=sql, text=True, env=_mysql_env(), check=True, capture_output=True)
    _exporter_write()
    _headers_policy_write()
    return {'maillog_setup': 'done'}


def maillog_search(args):
    """Search the mail log by sender, recipient, subject, queue ID or IP."""
    try:
        limit = int(args.limit)
    except ValueError:
        raise EfaError('Limit must be a number.')
    if not 1 <= limit <= 1000:
        raise EfaError('Limit must be 1 to 1000.')
    needle = '%' + args.text.strip().replace('\\', '\\\\').replace('%', '\\%').replace('_', '\\_') + '%'
    db = _maillog_db()
    try:
        with db.cursor() as cur:
            cur.execute('SELECT CAST(ts AS CHAR) AS ts, qid, sender, rcpt, ip, action, score, subject, spf, dkim, dmarc '
                        'FROM maillog WHERE sender LIKE %s OR rcpt LIKE %s OR subject LIKE %s OR qid LIKE %s OR ip LIKE %s '
                        'ORDER BY ts DESC, id DESC LIMIT %s', (needle, needle, needle, needle, needle, limit))
            return {'mails': cur.fetchall()}
    finally:
        db.close()


def _maillog_days():
    for line in _read_lines(MAILLOG_DAYS_FILE):
        if line.isdigit():
            return int(line)
    return MAILLOG_DEFAULT_DAYS


def maillog_retention_set(args):
    """Days to keep the mail log. It holds personal data, so keep it as short as you can."""
    try:
        days = int(args.days)
    except ValueError:
        raise EfaError('Days must be a number.')
    if not 1 <= days <= 3650:
        raise EfaError('Days must be 1 to 3650.')
    _write(MAILLOG_DAYS_FILE, f'{days}\n')
    return {'maillog_days': days}


def _maillog_max_mb():
    for line in _read_lines(MAILLOG_SIZE_FILE):
        if line.isdigit():
            return int(line)
    return 0


def maillog_size_set(args):
    """Largest size of the mail log in MB; the oldest entries go first. 0 turns the limit off."""
    try:
        megabytes = int(args.megabytes)
    except ValueError:
        raise EfaError('Size must be a number.')
    if not 0 <= megabytes <= 10485760:
        raise EfaError('Size must be 0 to 10485760 MB.')
    _write(MAILLOG_SIZE_FILE, f'{megabytes}\n')
    return {'maillog_max_mb': megabytes}


def maillog_purge(_args):
    """Delete entries older than the retention period and, if set, the oldest ones above the size limit."""
    days, max_mb = _maillog_days(), _maillog_max_mb()
    db = _maillog_db()
    try:
        with db.cursor() as cur:
            deleted = cur.execute('DELETE FROM maillog WHERE ts < NOW() - INTERVAL %s DAY', (days,))
            deleted_size = 0
            if max_mb:
                cur.execute("SELECT data_length + index_length AS size FROM information_schema.tables "
                            "WHERE table_schema = 'efa' AND table_name = 'maillog'")
                size = cur.fetchone()['size'] or 0
                cur.execute('SELECT COUNT(*) AS n FROM maillog')
                rows = cur.fetchone()['n']
                limit = max_mb * 1024 * 1024
                if size > limit and rows:
                    # shortcut: row sizes are averaged, so the result is close to the limit, not exact.
                    keep = int(rows * limit / size)
                    cur.execute('SELECT id FROM maillog ORDER BY id DESC LIMIT 1 OFFSET %s', (keep,))
                    found = cur.fetchone()
                    if found:
                        deleted_size = cur.execute('DELETE FROM maillog WHERE id <= %s', (found['id'],))
    finally:
        db.close()
    if deleted or deleted_size:
        # InnoDB keeps freed space in its file until the table is rebuilt.
        subprocess.run(['mysqlcheck', '--user=root', '--optimize', 'efa', 'maillog'], env=_mysql_env(),
                       check=True, capture_output=True)
    return {'deleted_by_age': deleted, 'deleted_by_size': deleted_size, 'maillog_days': days, 'maillog_max_mb': max_mb}


def _port_listening(port):
    with socket.socket() as probe:
        probe.settimeout(2)
        return probe.connect_ex(('127.0.0.1', port)) == 0


def milter_chain_set(args):
    """Order of the milters by port, for site-specific milters. rspamd (11332) and the health milter must stay in."""
    try:
        ports = [int(item) for item in args.ports.replace(',', ' ').split()]
    except ValueError:
        raise EfaError('Ports must be numbers.')
    if not ports or len(set(ports)) != len(ports) or not all(1 <= port <= 65535 for port in ports):
        raise EfaError('Give each port once, 1 to 65535.')
    for required in REQUIRED_MILTERS:
        if required not in ports:
            raise EfaError(f'Port {required} must stay in the chain.')
    # A wrong port delays every mail until its timeout, so refuse what does not answer.
    closed = [port for port in ports if not _port_listening(port)]
    if closed:
        raise EfaError(f'Nothing listens on port {closed}, nothing changed.')
    chain = ', '.join(f'inet:127.0.0.1:{port}' for port in ports)
    _postconf_set('smtpd_milters', chain)
    if os.path.exists(OUTBOUND_FILE):
        _outbound_strict_apply(_json_read(OUTBOUND_FILE, {}))
    return {'smtpd_milters': chain}


def dns_zone_set(args):
    """Send one DNS zone to internal servers, for example a company domain. Everything else resolves directly."""
    zone, action = args.zone.strip().lower().rstrip('.'), args.action.strip()
    if not DOMAIN_RE.match(zone):
        raise EfaError('Invalid zone.')
    if action not in ('add', 'remove'):
        raise EfaError("Action must be 'add' or 'remove'.")
    zones = _dns_zones()
    if action == 'add':
        servers = args.servers.replace(',', ' ').split()
        try:
            servers = [str(ipaddress.ip_address(server)) for server in servers]
        except ValueError:
            raise EfaError('Servers must be IP addresses.')
        if not servers:
            raise EfaError('Give at least one server.')
        zones[zone] = servers
    else:
        zones.pop(zone, None)
    lines = []
    for name, servers in sorted(zones.items()):
        # Internal zones are usually unsigned and would fail DNSSEC validation.
        lines += ['server:', f'  domain-insecure: "{name}"', 'forward-zone:', f'  name: "{name}"']
        lines += [f'  forward-addr: {server}' for server in servers]
    previous = open(DNS_ZONES).read() if os.path.exists(DNS_ZONES) else None
    _write(DNS_ZONES, '\n'.join(lines) + '\n')
    done = subprocess.run(['unbound-checkconf'], capture_output=True, text=True)
    if done.returncode != 0:
        if previous is None:
            os.remove(DNS_ZONES)
        else:
            _write(DNS_ZONES, previous)
        raise EfaError('unbound rejected the change, nothing changed: ' + done.stdout.strip()[-200:])
    subprocess.run(['systemctl', 'restart', 'unbound'], check=False, capture_output=True)
    return {'dns_zones': zones}


def _dns_zones():
    zones = {}
    name = None
    for line in _read_lines(DNS_ZONES):
        if line.startswith('name:'):
            name = line.split('"')[1]
            zones[name] = []
        elif line.startswith('forward-addr:') and name:
            zones[name].append(line.split()[1])
    return zones


def extra_service_set(args):
    """Site-specific systemd services the health service also watches. They show in status, not in mail."""
    name, action = args.name.strip(), args.action.strip()
    if not SERVICE_RE.match(name):
        raise EfaError('Invalid service name.')
    if action not in ('add', 'remove'):
        raise EfaError("Action must be 'add' or 'remove'.")
    entries = [e for e in _read_lines(HEALTH_EXTRA) if e != name]
    if action == 'add':
        entries.append(name)
    _write(HEALTH_EXTRA, ''.join(e + '\n' for e in entries))
    return {'extra_services': entries}


def quarantine_set(args):
    """Hold mail rspamd marks as spam instead of delivering it. It waits in the mail server until released or deleted."""
    enabled = _on_off(args.mode)
    if enabled:
        _write(QUARANTINE_RULES, '/^X-Spam: Yes/ HOLD eFa quarantine\n/^X-Spam-Status: Yes/ HOLD eFa quarantine\n')
    _postconf_set('milter_header_checks', map_list_value(_postconf('milter_header_checks'), f'regexp:{QUARANTINE_RULES}', enabled))
    return {'quarantine': enabled}


def _held_mail():
    done = subprocess.run(['postqueue', '-j'], capture_output=True, text=True, check=True)
    mails = []
    for line in done.stdout.splitlines():
        item = json.loads(line)
        if item.get('queue_name') == 'hold':
            mails.append({'id': item['queue_id'], 'sender': item.get('sender', ''),
                          'recipients': [r['address'] for r in item.get('recipients', [])],
                          'arrived': item.get('arrival_time'), 'size': item.get('message_size')})
    return mails


# The mail queue: every mail Postfix holds, with actions that each need a yes and land in the audit log.
QUEUE_FILE = ETC + '/eFa/queue.json'
QUEUE_DEFAULTS = {'alarm_size': 200, 'alarm_hours': 24}
QUEUE_ACTIONS = {'hold': '-h', 'release': '-H', 'requeue': '-r', 'delete': '-d'}
DEST_FILE = '/var/lib/eFa/destinations.json'
SPOOL_DEFAULTS = {'maximal_queue_lifetime': '5d', 'bounce_queue_lifetime': '5d', 'initial_destination_concurrency': '2'}
QUEUE_RELAY_RE = re.compile(r'^(\w+): to=<[^>]*>, relay=([^\[,\s]+)(?:\[[^\]]*\](?::\d+)?)?,.* status=(sent|deferred|bounced) \((.*)\)\s*$')
QUEUE_DOWN_RE = re.compile(r'connect to |Connection refused|Connection timed out|No route to host|lost connection|Network is unreachable|Host not found', re.I)


def queue_entries(lines):
    """postqueue -j lines to rows: ID, queue, age, size, sender, recipients and why it waits."""
    rows, now = [], time.time()
    for line in lines:
        if not line.startswith('{'):
            continue
        item = json.loads(line)
        recipients = item.get('recipients') or []
        rows.append({'id': item.get('queue_id', ''), 'queue': item.get('queue_name', ''), 'age_hours': round((now - item.get('arrival_time', now)) / 3600, 1),
                     'size': item.get('message_size', 0), 'sender': item.get('sender', ''), 'rcpts': ', '.join(r.get('address', '') for r in recipients),
                     'reason': '; '.join(sorted({r.get('delay_reason', '') for r in recipients if r.get('delay_reason')}))[:300]})
    return rows


def _queue_rows():
    done = subprocess.run(['postqueue', '-j'], capture_output=True, text=True, timeout=60)
    if done.returncode != 0:
        raise EfaError('postqueue failed: ' + done.stderr[-200:])
    return queue_entries(done.stdout.splitlines())


def queue_list(args):
    """The mail queue: active, waiting, held. Filter by queue and by text in sender, recipient or reason."""
    rows = _queue_rows()
    queue, text = (args.queue or '').strip(), (args.text or '').strip().lower()
    if queue:
        rows = [row for row in rows if row['queue'] == queue]
    if text:
        rows = [row for row in rows if text in (row['sender'] + ' ' + row['rcpts'] + ' ' + row['reason']).lower()]
    counts = {}
    for row in _queue_rows() if (queue or text) else rows:
        counts[row['queue']] = counts.get(row['queue'], 0) + 1
    return {'counts': counts, 'mails': sorted(rows, key=lambda row: -row['age_hours'])[:500]}


def queue_show(args):
    """The headers of one mail in the queue. The body stays closed."""
    queue_id = args.id.strip()
    if not QUEUE_ID_RE.match(queue_id) or queue_id not in {row['id'] for row in _queue_rows()}:
        raise EfaError('This mail is not in the queue.')
    done = subprocess.run(['postcat', '-hq', queue_id], capture_output=True, text=True, timeout=30)
    return {'id': queue_id, 'headers': done.stdout[:20000]}


def queue_action(args):
    """Hold, release, put back into the queue (a new try, a new arrival time) or delete one mail of the queue, or all waiting ones."""
    _confirm(args)
    action, queue_id = args.action.strip(), args.id.strip()
    if action not in QUEUE_ACTIONS:
        raise EfaError('Action: hold, release, requeue or delete.')
    if queue_id == 'ALL':
        if action == 'delete':
            raise EfaError('Delete only one mail at a time.')
        targets = [row['id'] for row in _queue_rows() if row['queue'] == ('hold' if action == 'release' else 'deferred')]
    elif QUEUE_ID_RE.match(queue_id) and queue_id in {row['id'] for row in _queue_rows()}:
        targets = [queue_id]
    else:
        raise EfaError('This mail is not in the queue.')
    for target in targets:
        subprocess.run(['postsuper', QUEUE_ACTIONS[action], target], capture_output=True, timeout=60)
    _audit(f'queue {action} {", ".join(targets[:50])} by {_dmarc_who()}')
    return {'action': action, 'mails': len(targets)}


def queue_flush(args):
    """Try all waiting mail now."""
    _confirm(args)
    subprocess.run(['postqueue', '-f'], capture_output=True, timeout=60)
    return {'flushed': True}


def queue_alarm_set(args):
    """Alarm by mail and event when the queue holds this many mails, or a mail waits this long."""
    state = {**QUEUE_DEFAULTS, **_json_read(QUEUE_FILE, {})}
    for key, low, high in (('alarm_size', 10, 1000000), ('alarm_hours', 1, 240)):
        value = (getattr(args, key, '') or '').strip()
        if value:
            if not value.isdigit() or not low <= int(value) <= high:
                raise EfaError(f'{key}: {low} to {high}.')
            state[key] = int(value)
    _json_write(QUEUE_FILE, state)
    return state


def queue_alarm(rows, state, now, last):
    """The alarm text, or None: at most every 6 hours."""
    if now - last < 6 * 3600:
        return None
    old = [row for row in rows if row['queue'] == 'deferred' and row['age_hours'] >= state['alarm_hours']]
    if len(rows) >= state['alarm_size']:
        return f'{len(rows)} mails in the queue, the limit is {state["alarm_size"]}.'
    if old:
        return f'{len(old)} mails wait longer than {state["alarm_hours"]} hours, the oldest {max(row["age_hours"] for row in old)} hours.'
    return None


def destination_update(state, lines, now):
    """Per receiving server: up or down, and since when, from the Postfix log. Returns the changes, (host, 'up'/'down')."""
    changes = []
    for line in lines:
        found = REPORT_LINE.match(line)
        if not found or not found.group(4).endswith('smtp'):
            continue
        done = QUEUE_RELAY_RE.match(found.group(5))
        if not done:
            continue
        _id, host, status, reason = done.groups()
        if host in ('none', 'local'):
            host = re.search(r'connect to ([^\[\s:]+)', reason).group(1) if re.search(r'connect to ([^\[\s:]+)', reason) else None
            if not host:
                continue
        wanted = 'up' if status == 'sent' else ('down' if status == 'deferred' and QUEUE_DOWN_RE.search(reason) else None)
        if not wanted:
            continue
        item = state.setdefault(host.lower(), {'state': wanted, 'since': now})
        if item['state'] != wanted:
            item.update(state=wanted, since=now)
            changes.append((host.lower(), wanted))
        item['last'] = now
    return changes


def spool_status(_args):
    """How long mail may wait, how fast it goes again after a pause, and each receiving server: up or down since when."""
    state = _json_read(DEST_FILE, {})
    return {**{key: _postconf(key) for key in SPOOL_DEFAULTS},
            'destinations': [{'host': host, 'state': item['state'], 'since': time.strftime('%Y-%m-%d %H:%M', time.localtime(item['since']))}
                             for host, item in sorted(state.items(), key=lambda pair: (pair[1]['state'] != 'down', pair[0]))][:200]}


def spool_set(args):
    """How long mail may wait in the queue (default 5 days), bounces too, and with how many connections a server starts again."""
    for key, pattern in (('maximal_queue_lifetime', r'\d{1,3}[hd]'), ('bounce_queue_lifetime', r'\d{1,3}[hd]'), ('initial_destination_concurrency', r'[1-9]|1\d|20')):
        value = (getattr(args, key, '') or '').strip()
        if value:
            if not re.fullmatch(pattern, value):
                raise EfaError(f'{key}: ' + ('like 5d or 12h.' if 'lifetime' in key else '1 to 20.'))
            _postconf_set(key, value)
    subprocess.run(['postfix', 'reload'], check=False, capture_output=True)
    return spool_status(None)


def _queue_job(lines):
    """Hourly with the mail report: the state of the receiving servers and the queue alarm."""
    now = time.time()
    state = _json_read(DEST_FILE, {})
    for host, wanted in destination_update(state, lines, now):
        text = f'The server {host} is ' + ('reachable again: the waiting mail goes out.' if wanted == 'up' else 'not reachable: mail to it waits in the queue.')
        _admin_notify(f'eFa: {host} {"is back" if wanted == "up" else "is down"}', text)
        _event('destination_up' if wanted == 'up' else 'destination_down', 'notice' if wanted == 'up' else 'warning', host=host)
    _json_write(DEST_FILE, state)
    settings_now = {**QUEUE_DEFAULTS, **_json_read(QUEUE_FILE, {})}
    alarm = queue_alarm(_queue_rows(), settings_now, now, settings_now.get('last_alarm', 0))
    if alarm:
        _admin_notify('eFa: the mail queue grows', alarm)
        _event('queue_alarm', 'warning', text=alarm)
        settings_now['last_alarm'] = now
        _json_write(QUEUE_FILE, settings_now)


def quarantine_list(_args):
    """List quarantined mail."""
    return {'quarantine': _held_mail(), 'quarantine_days': _quarantine_days()}


def _held_id(args):
    queue_id = args.id.strip()
    if not QUEUE_ID_RE.match(queue_id):
        raise EfaError('Invalid queue ID.')
    if queue_id not in [m['id'] for m in _held_mail()]:
        raise EfaError('This mail is not in quarantine.')
    return queue_id


def quarantine_show(args):
    """Show the headers of a quarantined mail."""
    queue_id = _held_id(args)
    done = subprocess.run(['postcat', '-hq', queue_id], capture_output=True, text=True, check=True)
    return {'id': queue_id, 'headers': done.stdout[:20000]}


def quarantine_release(args):
    """Deliver a quarantined mail."""
    queue_id = _held_id(args)
    # -r, not -H: released mail gets a new arrival time, so old mail does not bounce
    subprocess.run(['postsuper', '-r', queue_id], check=True, capture_output=True)
    return {'released': queue_id}


def quarantine_delete(args):
    """Delete a quarantined mail for good."""
    _confirm(args)
    queue_id = _held_id(args)
    subprocess.run(['postsuper', '-d', queue_id], check=True, capture_output=True)
    return {'deleted': queue_id}


def _quarantine_days():
    for line in _read_lines(QUARANTINE_DAYS_FILE):
        if line.isdigit():
            return int(line)
    return QUARANTINE_DEFAULT_DAYS


def quarantine_days_set(args):
    """Days until quarantined mail is deleted."""
    try:
        days = int(args.days)
    except ValueError:
        raise EfaError('Days must be a number.')
    if not 1 <= days <= 3650:
        raise EfaError('Days must be 1 to 3650.')
    _write(QUARANTINE_DAYS_FILE, f'{days}\n')
    return {'quarantine_days': days}


def quarantine_purge(_args):
    """Delete quarantined mail older than the set number of days."""
    cutoff = time.time() - _quarantine_days() * 86400
    deleted = [m['id'] for m in _held_mail() if (m['arrived'] or 0) < cutoff]
    for queue_id in deleted:
        subprocess.run(['postsuper', '-d', queue_id], check=True, capture_output=True)
    return {'deleted': len(deleted)}


# Reports that other servers send: one address goes to a pipe that reads DMARC aggregate and TLS reports.
REPORTS_FILE_IN = ETC + '/eFa/reports-in.json'
REPORTS_TRANSPORT = ETC + '/postfix/efa-reports-transport'
REPORTS_SERVICE = 'efa-reports'
REPORTS_MASTER = ('efa-reports unix - n n - 4 pipe flags=Rq user=efa-web argv=/usr/bin/python3 /usr/local/sbin/efa-reports.py')
DMARC_HINT_MIN = 10


def reports_in_set(args):
    """One address of yours receives the DMARC and TLS reports of other servers; eFa reads them instead of delivering them."""
    on = _on_off(args.mode)
    address = (args.address or '').strip().lower() or _json_read(REPORTS_FILE_IN, {}).get('address', '')
    if on and not SENDER_RE.match(address):
        raise EfaError('The address that receives the reports, such as dmarc-reports@example.org.')
    if on:
        subprocess.run(['postconf', '-M', f'{REPORTS_SERVICE}/unix={REPORTS_MASTER}'], check=True, capture_output=True)
        _rule_map(REPORTS_TRANSPORT, [f'{address} {REPORTS_SERVICE}:'])
    else:
        _rule_map(REPORTS_TRANSPORT, [])
        subprocess.run(['postconf', '-MX', f'{REPORTS_SERVICE}/unix'], check=False, capture_output=True)
    wanted = rule_map_value(_postconf('transport_maps'), REPORTS_TRANSPORT, on)
    if wanted != _postconf('transport_maps'):
        _postconf_set('transport_maps', wanted)
    subprocess.run(['postfix', 'reload'], check=False, capture_output=True)
    _json_write(REPORTS_FILE_IN, {'enabled': on, 'address': address})
    return {'enabled': on, 'address': address,
            'records': {'dmarc': f'rua=mailto:{address}', 'tls_rpt': f'v=TLSRPTv1; rua=mailto:{address}'} if address else {},
            'note': 'An address of another domain than the reported one needs its permission record, see dmarc-record-set.'}


def dmarc_hints(rows, own):
    """Sources that send for a domain and fail both checks: a missing SPF entry or DKIM key, or someone abusing the domain."""
    hints = []
    for row in rows:
        if row['n'] >= DMARC_HINT_MIN and row['dkim'] != 'pass' and row['spf'] != 'pass':
            known = row['source_ip'] in own
            hints.append(f"{row['source_ip']} sent {row['n']} mails for {row['domain']} that fail SPF and DKIM: "
                         + ('this server, check its DKIM key.' if known else 'if it is a service of yours, add it to SPF or let it sign with DKIM; '
                                                                              'if not, someone uses your domain.'))
    return hints


def dmarc_report_show(args):
    """DMARC aggregate reports received: per domain and sending address, with hints on senders that are not covered."""
    days = (args.days or '').strip() or '30'
    if not days.isdigit() or not 1 <= int(days) <= 400:
        raise EfaError('Days: 1 to 400.')
    domains = identity_now['domains'] if identity_now else None
    where, params = 'WHERE begin_ts >= NOW() - INTERVAL %s DAY', [int(days)]
    wanted = (args.domain or '').strip().lower()
    if wanted:
        where, params = where + ' AND domain = %s', params + [wanted]
    if domains is not None:
        where += ' AND domain IN (' + ', '.join(['%s'] * len(domains)) + ')' if domains else ' AND FALSE'
        params += list(domains)
    rows = _admin_query('SELECT domain, source_ip, SUM(n) AS n, MAX(dkim) AS dkim, MAX(spf) AS spf, MAX(disposition) AS disposition, '
                        'COUNT(DISTINCT org) AS reporters FROM dmarc_rua ' + where + ' GROUP BY domain, source_ip, dkim, spf ORDER BY n DESC LIMIT 500', params)
    rows = [{**row, 'n': int(row['n'])} for row in rows]
    own = set()
    try:
        own = set(re.findall(r'inet6? ([0-9a-f.:]+)/', subprocess.run(['ip', '-o', 'addr'], capture_output=True, text=True).stdout))
    except OSError:
        pass
    total = sum(row['n'] for row in rows)
    passed = sum(row['n'] for row in rows if row['dkim'] == 'pass' or row['spf'] == 'pass')
    return {'days': int(days), 'mails': total, 'pass_percent': round(100 * passed / total, 1) if total else None, 'sources': rows,
            'hints': dmarc_hints(rows, own)}


def tls_report_show(args):
    """TLS reports received: per domain and policy, successful and failed sessions, and why they failed."""
    days = (args.days or '').strip() or '30'
    if not days.isdigit() or not 1 <= int(days) <= 400:
        raise EfaError('Days: 1 to 400.')
    domains = identity_now['domains'] if identity_now else None
    where, params = 'WHERE begin_ts >= NOW() - INTERVAL %s DAY', [int(days)]
    if domains is not None:
        where += ' AND domain IN (' + ', '.join(['%s'] * len(domains)) + ')' if domains else ' AND FALSE'
        params += list(domains)
    rows = _admin_query('SELECT domain, policy, org, SUM(success) AS success, SUM(failure) AS failure, '
                        'GROUP_CONCAT(failures SEPARATOR \'\\n\') AS failures FROM tls_rpt ' + where + ' GROUP BY domain, policy, org ORDER BY domain', params)
    found = []
    for row in rows:
        reasons = {}
        for line in (row['failures'] or '').splitlines():
            try:
                for item in json.loads(line):
                    reasons[item['type']] = reasons.get(item['type'], 0) + int(item['count'])
            except (ValueError, KeyError, TypeError):
                continue
        found.append({'domain': row['domain'], 'policy': row['policy'], 'reporter': row['org'], 'success': int(row['success']), 'failure': int(row['failure']),
                      'reasons': ', '.join(f'{name} {count}' for name, count in sorted(reasons.items()))})
    return {'days': int(days), 'reports': found}


# DANE: outgoing mail checks the TLSA records of the receiving server, which needs answers the own resolver validated.
DANE_FILE = ETC + '/eFa/dane.json'
DNSSEC_PROBE = ('isc.org', 'dnssec-failed.org')


def _resolver_validates():
    """True if the own resolver validates DNSSEC: a signed answer has the ad flag, a broken signature fails."""
    good = subprocess.run(['dig', '+dnssec', '+time=3', '+tries=1', DNSSEC_PROBE[0], 'SOA', '@127.0.0.1'], capture_output=True, text=True, timeout=15).stdout
    bad = subprocess.run(['dig', '+dnssec', '+time=3', '+tries=1', DNSSEC_PROBE[1], 'A', '@127.0.0.1'], capture_output=True, text=True, timeout=15).stdout
    return bool(re.search(r'flags:[^;]*\bad\b', good)) and 'status: SERVFAIL' in bad


def dane_status(_args):
    """DANE for outgoing mail: on or off, and whether the own resolver validates DNSSEC."""
    level = _postconf('smtp_tls_security_level')
    return {'enabled': level == 'dane', 'tls_level': level, 'dns_support': _postconf('smtp_dns_support_level') or 'default',
            'resolver_validates': _resolver_validates()}


def dane_set(args):
    """Outgoing mail uses DANE: a receiver with TLSA records gets verified TLS, all others TLS where they offer it."""
    on = _on_off(args.mode)
    level = _postconf('smtp_tls_security_level')
    if on:
        if level not in ('may', 'none', 'dane', ''):
            raise EfaError(f'The TLS level for all mail is {level}: DANE would make it weaker for servers without TLSA records.')
        if not _resolver_validates():
            raise EfaError('The own resolver does not validate DNSSEC, DANE would not be safe. Check Unbound and its trust anchor.')
        if level != 'dane':
            _json_write(DANE_FILE, {'previous': level or 'may', 'previous_dns': _postconf('smtp_dns_support_level')})
        _postconf_set('smtp_dns_support_level', 'dnssec')
        _postconf_set('smtp_tls_security_level', 'dane')
    elif level == 'dane':
        before = _json_read(DANE_FILE, {})
        _postconf_set('smtp_tls_security_level', before.get('previous', 'may'))
        if before.get('previous_dns'):
            _postconf_set('smtp_dns_support_level', before['previous_dns'])
        else:
            subprocess.run(['postconf', '-X', 'smtp_dns_support_level'], check=False, capture_output=True)
    subprocess.run(['postfix', 'reload'], check=False, capture_output=True)
    return dane_status(None)


def tlsa_records(der_spki, host, issuer_spki=None):
    """TLSA records for the SMTP server: 3 1 1 for its own key, and 2 1 1 for the key of the issuer if it is known."""
    records = [f'_25._tcp.{host}. IN TLSA 3 1 1 {hashlib.sha256(der_spki).hexdigest()}']
    if issuer_spki:
        records.append(f'_25._tcp.{host}. IN TLSA 2 1 1 {hashlib.sha256(issuer_spki).hexdigest()}')
    return records


def _spki_of(pem):
    """The DER public key of a certificate, through openssl."""
    key = subprocess.run(['openssl', 'x509', '-noout', '-pubkey'], input=pem, capture_output=True, timeout=30)
    der = subprocess.run(['openssl', 'pkey', '-pubin', '-outform', 'DER'], input=key.stdout, capture_output=True, timeout=30)
    if key.returncode or der.returncode:
        raise EfaError('openssl could not read the certificate.')
    return der.stdout


def tlsa_show(args):
    """TLSA records to publish for the MX name of this server, from the certificate Postfix uses, and what DNS shows now."""
    host = (args.host or '').strip().lower().rstrip('.') or _postconf('myhostname')
    if not DOMAIN_RE.match(host):
        raise EfaError('Host: the MX name of this server.')
    with open(_postconf('smtpd_tls_cert_file'), 'rb') as f:
        chain = re.findall(rb'-----BEGIN CERTIFICATE-----.*?-----END CERTIFICATE-----', f.read(), re.S)
    if not chain:
        raise EfaError('No certificate found.')
    issuer = _spki_of(chain[1]) if len(chain) > 1 else None
    wanted = tlsa_records(_spki_of(chain[0]), host, issuer)
    done = subprocess.run(['dig', '+short', '+time=3', '+tries=1', f'_25._tcp.{host}', 'TLSA', '@127.0.0.1'], capture_output=True, text=True, timeout=15)
    published = [line.lower().replace(' ', '') for line in done.stdout.splitlines() if line.strip()]
    matches = [record for record in wanted if record.split('TLSA ', 1)[1].lower().replace(' ', '') in published]
    return {'host': host, 'records': wanted, 'published': done.stdout.split('\n')[:-1], 'matching': matches,
            'note': 'A certificate with a new key needs a new 3 1 1 record before it is used: renew with the same key (certbot --reuse-key), '
                    'or publish the new record a day ahead. The 2 1 1 record follows the issuer and changes less often.'}


# MTA-STS: the policy of each domain at https://mta-sts.<domain>/.well-known/mta-sts.txt, served by nginx from files.
MTA_STS_DIR = '/var/www/efa-mta-sts'
MTA_STS_FILE = ETC + '/eFa/mta-sts.json'
MTA_STS_NGINX = ETC + '/nginx/conf.d/efa-mta-sts.conf'
MTA_STS_MODES = ('testing', 'enforce', 'none')
MTA_STS_SERVER = r'''# Written by efactl mta-sts-set. Do not edit.
server {
    listen 443 ssl;
    http2 on;
    server_name ~^mta-sts\.(?<sts_domain>[a-z0-9.-]+)$;
    ssl_certificate /etc/pki/tls/certs/efa.crt;
    ssl_certificate_key /etc/pki/tls/private/efa.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    location = /.well-known/mta-sts.txt {
        root %(folder)s;
        try_files /$sts_domain.txt =404;
        default_type text/plain;
    }
    location / { return 404; }
}
'''


def mta_sts_policy(mode, mx, max_age):
    """The policy file of RFC 8461."""
    return 'version: STSv1\n' + f'mode: {mode}\n' + ''.join(f'mx: {host}\n' for host in mx) + f'max_age: {max_age}\n'


def mta_sts_records(domain, policy_id, host, report_address):
    """What to publish in DNS for one domain: the policy ID, the name of the policy server, and where TLS reports go."""
    records = [f'_mta-sts.{domain}. IN TXT "v=STSv1; id={policy_id}"', f'mta-sts.{domain}. IN CNAME {host}.']
    if report_address:
        records.append(f'_smtp._tls.{domain}. IN TXT "v=TLSRPTv1; rua=mailto:{report_address}"')
    return records


def _mta_sts_apply(state):
    os.makedirs(MTA_STS_DIR, mode=0o755, exist_ok=True)
    for name in os.listdir(MTA_STS_DIR):
        if name.endswith('.txt') and name[:-4] not in state:
            os.remove(os.path.join(MTA_STS_DIR, name))
    for domain, item in state.items():
        _write(os.path.join(MTA_STS_DIR, domain + '.txt'), mta_sts_policy(item['mode'], item['mx'], item['max_age']))
        os.chmod(os.path.join(MTA_STS_DIR, domain + '.txt'), 0o644)
    before = open(MTA_STS_NGINX).read() if os.path.exists(MTA_STS_NGINX) else None
    if state:
        _write(MTA_STS_NGINX, MTA_STS_SERVER % {'folder': MTA_STS_DIR})
    elif before is not None:
        os.remove(MTA_STS_NGINX)
    platform_now = _platform()
    platform_now.file_labels(MTA_STS_DIR)
    done = subprocess.run(['nginx', '-t'], capture_output=True, text=True)
    if done.returncode != 0:
        if before is None:
            if os.path.exists(MTA_STS_NGINX):
                os.remove(MTA_STS_NGINX)
        else:
            _write(MTA_STS_NGINX, before)
        raise EfaError('nginx rejected the config, it was taken back: ' + done.stderr[-200:])
    platform_now.service_reload_if_active('nginx')
    _json_write(MTA_STS_FILE, state)


def mta_sts_show(_args):
    """MTA-STS of each domain: the policy, the DNS records to publish, and the ID DNS shows now."""
    state = _json_read(MTA_STS_FILE, {})
    own_reports = _json_read(REPORTS_FILE_IN, {})
    host, reports = _postconf('myhostname').lower(), own_reports.get('address', '') if own_reports.get('enabled') else ''
    rows = []
    for domain, item in sorted(state.items()):
        if identity_now and identity_now['domains'] is not None and domain not in identity_now['domains']:
            continue
        done = subprocess.run(['dig', '+short', '+time=3', '+tries=1', f'_mta-sts.{domain}', 'TXT', '@127.0.0.1'], capture_output=True, text=True, timeout=15)
        rows.append({'domain': domain, 'mode': item['mode'], 'mx': ' '.join(item['mx']), 'max_age': item['max_age'], 'id': item['id'],
                     'records': mta_sts_records(domain, item['id'], host, reports), 'dns_now': done.stdout.strip(),
                     'published': f"id={item['id']}" in done.stdout})
    return {'domains': rows, 'note': f'The certificate of this server must also name mta-sts.<domain> of each domain: add them to letsencrypt-set.'}


def mta_sts_set(args):
    """The MTA-STS policy of a domain: testing first, then enforce. remove takes it away."""
    domain = args.domain.strip().lower()
    if not DOMAIN_RE.match(domain):
        raise EfaError('Invalid domain.')
    if identity_now and identity_now['domains'] is not None and domain not in identity_now['domains']:
        raise EfaError('Not allowed: name one of your own domains.')
    state = _json_read(MTA_STS_FILE, {})
    mode = args.mode.strip()
    if mode == 'remove':
        state.pop(domain, None)
    else:
        if mode not in MTA_STS_MODES:
            raise EfaError('Mode: testing, enforce, none or remove.')
        mx = [item.strip().lower().rstrip('.') for item in (args.mx or '').replace(',', ' ').split()] or [_postconf('myhostname')]
        if any(not re.fullmatch(r'(\*\.)?([a-z0-9-]+\.)+[a-z]{2,}', item) for item in mx):
            raise EfaError('MX names like mx.example.org, or *.example.org.')
        max_age = (args.max_age or '').strip() or '604800'
        if not max_age.isdigit() or not 86400 <= int(max_age) <= 31557600:
            raise EfaError('max_age: one day (86400) to one year (31557600) in seconds.')
        state[domain] = {'mode': mode, 'mx': mx, 'max_age': int(max_age), 'id': time.strftime('%Y%m%d%H%M%S')}
    _mta_sts_apply(state)
    return mta_sts_show(None)


def dmarc_reports_set(args):
    """Send DMARC reports to the addresses domains publish. Needs Redis and outgoing mail."""
    enabled = _on_off(args.mode)
    text = open(DMARC_CONF).read() if os.path.exists(DMARC_CONF) else ''
    text = re.sub(r'reporting \{.*?\n\}\n?', '', text, flags=re.S)
    if enabled:
        domain, email, org = (args.domain or '').strip().lower(), (args.email or '').strip().lower(), (args.org or '').strip()
        if not DOMAIN_RE.match(domain):
            raise EfaError('Invalid domain.')
        if not SENDER_RE.match(email):
            raise EfaError('Invalid email address.')
        if not ORG_RE.match(org):
            raise EfaError('Organization: up to 64 letters, digits or spaces.')
        text += (f'reporting {{\n  enabled = true;\n  email = "{email}";\n  domain = "{domain}";\n'
                 f'  org_name = "{org}";\n  smtp = "127.0.0.1";\n}}\n')
    _write(DMARC_CONF, text)
    done = subprocess.run(['rspamadm', 'configtest'], capture_output=True, text=True)
    if done.returncode != 0:
        raise EfaError('rspamd rejected the setting: ' + (done.stdout + done.stderr)[-200:])
    _reload_rspamd()
    if enabled:
        _write(DMARC_CRON, '0 3 * * * root /usr/bin/rspamadm dmarc_report yesterday >/dev/null 2>&1\n')
    elif os.path.exists(DMARC_CRON):
        os.remove(DMARC_CRON)
    return {'dmarc_reports': enabled}


def admin_password(args):
    """Set the web admin password; only from the CLI, the web cannot change it. Always asked twice, against typing errors:
    on a terminal, or as two lines on stdin."""
    from werkzeug.security import generate_password_hash
    password = password_twice('New password')
    if password_problem(password, 'admin'):
        raise EfaError(password_problem(password, 'admin'))
    os.makedirs(WEB_DIR, mode=0o750, exist_ok=True)
    shutil.chown(WEB_DIR, 'root', 'efa-web')
    fd, tmp = tempfile.mkstemp(dir=WEB_DIR)
    with os.fdopen(fd, 'w') as f:
        f.write(generate_password_hash(password, method='pbkdf2:sha256:600000'))
    shutil.chown(tmp, 'root', 'efa-web')
    os.chmod(tmp, 0o640)
    os.replace(tmp, PASSWORD_FILE)
    return {'admin_password': 'set'}


def _sane_state():
    state = _json_read(SANE_FILE, {})
    state.setdefault('enabled', True)
    state.setdefault('files', {})
    for key in ('last_check', 'last_change', 'errors', 'signatures'):
        state.setdefault(key, None)
    return state


def _sane_fetch(connection, name, target, known):
    """Conditional download. Returns the new (etag, modified), or None if the file did not change."""
    headers = {'User-Agent': 'eFa-next'}
    if known.get('etag'):
        headers['If-None-Match'] = known['etag']
    if known.get('modified'):
        headers['If-Modified-Since'] = known['modified']
    connection.request('GET', SANE_PATH + name, headers=headers)
    reply = connection.getresponse()
    if reply.status == 304:
        reply.read()
        return None
    if reply.status != 200:
        reply.read()
        raise OSError(f'HTTP {reply.status}')
    with open(target, 'wb') as out:
        shutil.copyfileobj(reply, out)
    return {'etag': reply.headers.get('ETag'), 'modified': reply.headers.get('Last-Modified')}


def _sane_verified(work, name):
    """The file must carry a good Sanesecurity signature, and clamd must be able to load it."""
    urllib.request.urlretrieve(f'https://{SANE_HOST}{SANE_PATH}{name}.sig', f'{work}/{name}.sig')
    home = work + '/gnupg'
    if not os.path.isdir(home):
        os.mkdir(home, 0o700)
        subprocess.run(['gpg', '-q', '--batch', '--homedir', home, '--import'], input=SANE_KEY, text=True, capture_output=True, check=True)
    done = subprocess.run(['gpg', '--batch', '--homedir', home, '--trust-model', 'always', '--status-fd', '1', '--verify',
                           f'{work}/{name}.sig', f'{work}/{name}'], capture_output=True, text=True)
    if done.returncode != 0 or SANE_FINGERPRINT not in done.stdout:
        return 'bad signature'
    empty = work + '/empty'
    open(empty, 'w').close()
    done = subprocess.run(['clamscan', '--quiet', '--no-summary', f'--database={work}/{name}', empty], capture_output=True, text=True, timeout=300)
    return f'clamscan refused it: {done.stderr.strip()[:100]}' if done.returncode != 0 else None


def _sane_reload():
    subprocess.run(['clamdscan', f'--config-file={ETC}/clamd.d/scan.conf', '--reload'], capture_output=True, check=False)


def _sane_count():
    total = 0
    for name in SANE_DBS:
        try:
            with open(f'{SANE_DB_DIR}/{name}', 'rb') as f:
                total += sum(chunk.count(b'\n') for chunk in iter(lambda: f.read(65536), b''))
        except FileNotFoundError:
            pass
    return total


def _sane_clean_old():
    """Once after the move from clamav-unofficial-sigs: its other feeds no longer update and would only cost memory."""
    if not os.path.isdir(SANE_OLD_DIR):
        return False
    names = {os.path.basename(path) for path in glob.glob(SANE_OLD_DIR + '/dbs-*/*')} - set(SANE_DBS)
    for name in names:
        if os.path.exists(f'{SANE_DB_DIR}/{name}'):
            os.remove(f'{SANE_DB_DIR}/{name}')
    shutil.rmtree(SANE_OLD_DIR)
    return bool(names)


def sanesecurity_run(_args):
    """Job every 2 hours: fetch what changed, verify and test it, and reload clamd only if something changed."""
    state, errors, changed = _sane_state(), [], []
    removed = _sane_clean_old()
    if not state['enabled']:
        for name in SANE_DBS:
            if os.path.exists(f'{SANE_DB_DIR}/{name}'):
                os.remove(f'{SANE_DB_DIR}/{name}')
                removed = True
        state['files'] = {}
    else:
        # One connection for all files: most runs only learn that nothing changed.
        connection = http.client.HTTPSConnection(SANE_HOST, timeout=60)
        with tempfile.TemporaryDirectory() as work:
            for name in SANE_DBS:
                known = state['files'].get(name, {}) if os.path.exists(f'{SANE_DB_DIR}/{name}') else {}
                try:
                    new = _sane_fetch(connection, name, f'{work}/{name}', known)
                    if new is None:
                        continue
                    problem = _sane_verified(work, name)
                except (OSError, http.client.HTTPException, subprocess.SubprocessError) as err:
                    connection.close()
                    problem = str(err)[:100]
                    new = None
                if problem:
                    errors.append(f'{name}: {problem}')
                    continue
                # A dot name in the same folder: clamd skips it, and the replace is atomic.
                temp = f'{SANE_DB_DIR}/.{name}.new'
                shutil.copyfile(f'{work}/{name}', temp)
                os.chmod(temp, 0o644)
                shutil.chown(temp, 'clamupdate', 'clamupdate')
                os.replace(temp, f'{SANE_DB_DIR}/{name}')
                state['files'][name] = new
                changed.append(name)
    if changed or removed:
        _sane_reload()
        state['signatures'] = _sane_count()
        state['last_change'] = datetime.datetime.now().isoformat(timespec='seconds')
    state['last_check'] = datetime.datetime.now().isoformat(timespec='seconds')
    state['errors'] = errors
    _json_write(SANE_FILE, state)
    return {'changed': changed, 'errors': errors}


def sanesecurity_status(_args):
    """State of the Sanesecurity signatures."""
    state = _sane_state()
    return {'active': state['enabled'], 'last_check': state['last_check'], 'last_change': state['last_change'],
            'signatures': state['signatures'], 'errors': state['errors'] or [], 'databases': ', '.join(SANE_DBS),
            'terms': SANE_TERMS}


def sanesecurity_set(args):
    """Turn the Sanesecurity signatures on or off. The change applies at the next job, started now."""
    state = _sane_state()
    state['enabled'] = _on_off(args.mode)
    _json_write(SANE_FILE, state)
    sanesecurity_update(args)
    return {'sanesecurity': state['enabled']}


def sanesecurity_update(_args):
    """Start the job in the background: downloads and tests take longer than a page load."""
    subprocess.run(['systemctl', 'start', '--no-block', 'efa-sanesecurity.service'], capture_output=True, check=False)
    return {'started': True}


def _rbl_state():
    state = _json_read(RBL_FILE, {})
    state.setdefault('lists', {})
    state.setdefault('custom', {})
    return state


def _rbl_on(state, preset):
    return state['lists'].get(preset['id'], {}).get('enabled', preset['on'])


def _rbl_quote(symbol, score, description=''):
    return f'  "{symbol}" {{ weight = {score:g}; description = "{description}"; }}\n'


def _rbl_rule(name, symbol, zone, kind, codes=None):
    checks = RBL_TYPES[kind]
    # Without a list of codes every real listing counts, but no error answer such as 127.0.0.1 or 127.255.255.254.
    wanted = '[' + ', '.join(f'"{code}"' for code in codes) + ']' if codes else f'"{RBL_LISTED}"'
    matcher = '' if codes else 'returncodes_matcher = "regexp"; '
    return (f'  {name} {{ enabled = true; rbl = "{zone}"; {checks} unknown = false; {matcher}'
            f'returncodes {{ {symbol} = {wanted}; }} }}\n')


def _rbl_render(state):
    """The rspamd settings: rbl.conf and rbl_group.conf. Rules rspamd ships keep their own return codes."""
    rules, scores = '', ''
    for preset in RBL_PRESETS:
        saved = state['lists'].get(preset['id'], {})
        on = _rbl_on(state, preset)
        score = saved.get('score', preset.get('score'))
        if 'zone' in preset:
            symbol = preset['symbols'][0]
            rules += _rbl_rule(preset['id'], symbol, preset['zone'], preset['type']) if on else f"  {preset['id']} {{ enabled = false; }}\n"
        else:
            for rule, dqs in preset['rules'].items():
                zone = f' rbl = "{saved["key"]}.{dqs}";' if on and dqs and saved.get('key') else ''
                rules += f"  {rule} {{ enabled = {'true' if on else 'false'};{zone} }}\n"
        if score is not None:
            scores += ''.join(_rbl_quote(symbol, score, preset['name']) for symbol in preset['symbols'])
    for name, item in state['custom'].items():
        symbol = f"EFA_RBL_{name.upper().replace('-', '_')}"
        rules += _rbl_rule(f"efa_custom_{name.replace('-', '_')}", symbol, item['zone'], item['type'], item.get('codes')) if item.get('enabled', True) \
            else f"  efa_custom_{name.replace('-', '_')} {{ enabled = false; }}\n"
        scores += _rbl_quote(symbol, item['score'], name)
    return f'rbls {{\n{rules}}}\n', f'symbols {{\n{scores}}}\n'


def _rbl_apply(state):
    old = {path: open(path).read() if os.path.exists(path) else None for path in (RBL_CONF, RBL_GROUP_CONF)}
    conf, group = _rbl_render(state)
    for path, text in ((RBL_CONF, conf), (RBL_GROUP_CONF, group)):
        _write(path, text)
    # It can hold the Spamhaus key, rspamd alone has to read it.
    os.chmod(RBL_CONF, 0o640)
    _own_key(RBL_CONF)
    if not _rspamd_config_ok():
        for path, text in old.items():
            if text is None:
                os.remove(path)
            else:
                _write(path, text)
        raise EfaError('rspamd refused the new settings, nothing changed.')
    _json_write(RBL_FILE, state)
    _reload_rspamd()


def _rbl_counters():
    """Hits per symbol from rspamd's own statistics, so nothing here asks DNS."""
    done = subprocess.run(['rspamc', 'counters', '-j'], capture_output=True, text=True, check=False)
    try:
        return {item['symbol']: item.get('hits', 0) for item in json.loads(done.stdout)}
    except (ValueError, TypeError, KeyError):
        return {}


def _rbl_hits(counters, symbols):
    # rspamd puts RBL_ or RECEIVED_ in front of some symbols.
    return sum(hits for name, hits in counters.items() if any(name == s or name.endswith('_' + s) for s in symbols))


def _unbound_forwards(text):
    """True if the root zone goes to forwarders: most free lists refuse public resolvers."""
    for block in re.split(r'^\s*forward-zone:', text, flags=re.M)[1:]:
        block = re.split(r'^\s*[a-z-]+:\s*$', block, flags=re.M)[0]
        if re.search(r'^\s*name:\s*"?\."?\s*$', block, re.M) and re.search(r'^\s*forward-(addr|host):', block, re.M):
            return True
    return False


def _rbl_warnings():
    text = ''
    for path in glob.glob(ETC + '/unbound/conf.d/*.conf') + [ETC + '/unbound/unbound.conf']:
        try:
            with open(path) as f:
                text += f.read() + '\n'
        except OSError:
            pass
    return [RBL_FORWARD_WARNING] if _unbound_forwards(text) else []


def rbl_show(_args):
    """Blocklists, their hits and errors since rspamd started."""
    state, counters = _rbl_state(), _rbl_counters()
    rows = []
    for preset in RBL_PRESETS:
        saved = state['lists'].get(preset['id'], {})
        rows.append({'id': preset['id'], 'list': preset['name'], 'type': preset['type'], 'active': _rbl_on(state, preset),
                     'score': saved.get('score', preset.get('score', 'rspamd default')),
                     'hits': _rbl_hits(counters, preset['symbols']), 'errors': _rbl_hits(counters, preset.get('blocked', ())),
                     'terms': preset['terms'], 'url': preset['url'], 'terms_url': RBL_TERMS.get(preset['id']) or preset['url'],
                     'terms_published': bool(RBL_TERMS.get(preset['id'])), 'accepted': _rbl_accepted_text(state, preset['id'])})
    for name, item in state['custom'].items():
        rows.append({'id': name, 'list': f"Custom: {item['zone']}", 'type': item['type'], 'active': item.get('enabled', True),
                     'score': item['score'], 'hits': _rbl_hits(counters, (f"EFA_RBL_{name.upper().replace('-', '_')}",)), 'errors': 0,
                     'terms': 'Your own list. Check its terms yourself.', 'url': item.get('website', ''), 'terms_url': item.get('website', ''),
                     'terms_published': False, 'accepted': _rbl_accepted_text(state, name)})
    errors = [row['id'] for row in rows if row['errors']]
    warnings = _rbl_warnings() + ([f"These lists answered with an error code, so they do not filter: {', '.join(errors)}. "
                                   'Most often the provider refuses the resolver.'] if errors else [])
    if any(row['active'] and row['id'] in RBL_DQS_LISTS and not state['lists'].get(row['id'], {}).get('key') for row in rows):
        warnings.append(RBL_DQS_WARNING)
    unconfirmed = [row['list'] for row in rows if row['active'] and not rbl_accepted(state, row['id'])]
    if unconfirmed:
        warnings.append(f"{RBL_UNCONFIRMED}: {', '.join(unconfirmed)}. Switch each on again with the confirmation of its terms.")
    return {'warnings': warnings, 'lists': rows}


def _rbl_accepted_text(state, name):
    item = rbl_accepted(state, name)
    return f"accepted by {item['by']} on {item['at']}" if item else 'terms not yet confirmed'


def _rbl_score(text):
    try:
        score = float(text)
    except ValueError:
        raise EfaError('Score must be a number.')
    if not -50 <= score <= 50:
        raise EfaError('Score must be from -50 to 50.')
    return score


def rbl_set(args):
    """Switch a list on or off, change its score, or store the Spamhaus DQS key."""
    state, name = _rbl_state(), args.id.strip()
    presets = {preset['id']: preset for preset in RBL_PRESETS}
    if name in state['custom']:
        entry = state['custom'][name]
    elif name in presets:
        entry = state['lists'].setdefault(name, {})
    else:
        raise EfaError('Unknown list.')
    entry['enabled'] = _on_off(args.mode)
    if entry['enabled']:
        _rbl_accept(state, name, args, presets[name]['name'] if name in presets else name)
    if args.score.strip():
        entry['score'] = _rbl_score(args.score.strip())
    if args.key.strip():
        if name not in RBL_DQS_LISTS or not re.fullmatch(r'[a-z0-9]{10,64}', args.key.strip()):
            raise EfaError('A DQS key is only for the Spamhaus lists: 10 to 64 small letters or digits.')
        entry['key'] = args.key.strip()
    _rbl_apply(state)
    return {'id': name, 'active': entry['enabled']}


def https_url(text):
    """An address for a link: only https, so nothing can run in the browser. An empty text stays empty."""
    text = (text or '').strip()
    if not text:
        return ''
    parts = urllib.parse.urlsplit(text)
    if parts.scheme != 'https' or not parts.hostname or parts.username or re.search(r'[\s\x00-\x1f<>"\'\\]', text) or len(text) > 500:
        raise EfaError('Website: a full https:// address, nothing else.')
    return text


def rbl_custom_set(args):
    """Add or remove your own blocklist."""
    state, name, action = _rbl_state(), args.name.strip().lower(), args.action.strip()
    if not re.fullmatch(r'[a-z0-9][a-z0-9-]{0,39}', name) or name in {preset['id'] for preset in RBL_PRESETS}:
        raise EfaError('Name: up to 40 small letters, digits or dashes, not the name of a preset.')
    if args.confirm.strip() != 'yes':
        raise EfaError('Type yes to confirm.')
    if action == 'remove':
        if state['custom'].pop(name, None) is None:
            raise EfaError('Unknown list.')
    elif action == 'add':
        zone, kind = args.zone.strip().lower(), args.type.strip()
        codes = args.codes.replace(',', ' ').split()
        if not DOMAIN_RE.match(zone):
            raise EfaError('Invalid zone name.')
        if kind not in RBL_TYPES:
            raise EfaError('Type must be ' + ', '.join(RBL_TYPES) + '.')
        for code in codes:
            try:
                ipaddress.IPv4Address(code)
            except ValueError:
                raise EfaError(f'Invalid return code: {code}')
        _rbl_accept(state, name, args, zone)
        state['custom'][name] = {'zone': zone, 'type': kind, 'score': _rbl_score(args.score.strip()), 'codes': codes, 'enabled': True,
                                 'website': https_url(args.website)}
    else:
        raise EfaError("Action must be 'add' or 'remove'.")
    _rbl_apply(state)
    return {'name': name, 'action': action}


def _rbl_keep(state, rules):
    """Upgrade or migration: a list that filters now stays on, so filtering never gets weaker. Fresh installs skip this."""
    for preset in RBL_PRESETS:
        if any(rules.get(rule) for rule in preset.get('rules', ())):
            state['lists'].setdefault(preset['id'], {})['enabled'] = True


def rbl_apply(args):
    """Write the rspamd settings from the saved choices."""
    state = _rbl_state()
    if args.keep.strip() == 'yes':
        # What rspamd does without the eFa settings is what filtered until now.
        if os.path.exists(RBL_CONF):
            os.remove(RBL_CONF)
        done = subprocess.run(['rspamadm', 'configdump', '-j', 'rbl.rbls'], capture_output=True, text=True, check=True)
        dump = json.loads(done.stdout)
        dump = dump.get('rbl', dump)
        _rbl_keep(state, {name: rule.get('enabled') is not False for name, rule in dump.get('rbls', dump).items()})
    _rbl_apply(state)
    return {'lists': len(RBL_PRESETS) + len(state['custom'])}


def _report_empty():
    return {'counts': {}, 'hours': {}, 'senders': {}, 'recipients': {}, 'sender_domains': {}, 'recipient_domains': {},
            'rejects': {}, 'deferrals': {}, 'bounces': {}, 'tls_in': {}, 'tls_out': {}, 'tls_out_trust': {}, 'queue': 0}


def _report_add(table, key, amount=1):
    table[key] = table.get(key, 0) + amount


def _report_reason(text):
    text = re.sub(r'<[^>]*>|\[[0-9A-Fa-f.:]+\]|\b\d{1,3}(\.\d{1,3}){3}\b', '', text)
    return re.sub(r'\s+', ' ', text).strip(' :;,')[:100] or 'unknown'


def _report_day(month, day, today):
    number = REPORT_MONTHS.index(month) + 1
    # The log has no year. A month ahead of today can only belong to last year.
    return datetime.date(today.year - (number > today.month), number, int(day)).isoformat()


def _report_line(days, pending, line, today):
    """Adds one log line to the daily aggregates."""
    match = REPORT_LINE.match(line)
    if not match:
        return
    month, day, hour, program, text = match.groups()
    if month not in REPORT_MONTHS:
        return
    date = _report_day(month, day, today)
    agg = days.setdefault(date, _report_empty())
    counts, hours = agg['counts'], agg['hours'].setdefault(hour, {})
    tls = REPORT_TLS.match(text)
    if program.endswith('smtpd') and text.startswith('connect from '):
        _report_add(counts, 'connections')
    elif tls:
        trust, way, version, cipher = tls.groups()
        if way == 'from':
            _report_add(counts, 'tls')
            _report_add(agg.setdefault('tls_in', {}), f'{version} {cipher}')
        else:
            _report_add(counts, 'tls_out')
            _report_add(agg.setdefault('tls_out', {}), f'{version} {cipher}')
            _report_add(agg.setdefault('tls_out_trust', {}), trust)
    elif text.startswith('TLS connection established from ') or program.endswith('smtpd') and ' TLS connection established from ' in text:
        _report_add(counts, 'tls')
    elif REPORT_TLS_FAILED.match(text) or ': ' in text and REPORT_TLS_FAILED.match(text.split(': ', 1)[1]):
        _report_add(counts, 'tls_failed_in' if program.endswith('smtpd') else 'tls_failed_out')
    elif program.endswith('cleanup') and ': message-id=' in text:
        _report_add(counts, 'received')
        _report_add(hours, 'received')
    elif ': removed' in text and program.endswith('qmgr'):
        pending.pop(text.split(':')[0], None)
    elif 'reject: ' in text or 'milter-reject: ' in text:
        reject = REPORT_REJECT.search(text)
        if reject:
            _report_add(counts, 'rejected')
            _report_add(hours, 'rejected')
            _report_add(agg['rejects'], _report_reason(reject.group(1)))
    else:
        first = REPORT_FROM.match(text)
        if first and program.endswith('qmgr'):
            queue_id, sender, size = first.groups()
            if queue_id not in pending:
                pending[queue_id] = int(size)
                _report_add(counts, 'bytes_received', int(size))
                _report_add(agg['senders'], sender.lower() or '(bounce)')
                _report_add(agg['sender_domains'], sender.lower().rpartition('@')[2] or '(bounce)')
            return
        done = REPORT_TO.match(text)
        if not done:
            return
        queue_id, recipient, status, reason = done.groups()
        if status == 'sent':
            kind = 'forwarded' if reason.startswith('forwarded as') else 'delivered'
            _report_add(counts, kind)
            if program == 'smtp':
                _report_add(counts, 'smtp_sent')
            _report_add(hours, kind)
            _report_add(counts, 'bytes_delivered', pending.get(queue_id, 0))
            _report_add(agg['recipients'], recipient.lower())
            _report_add(agg['recipient_domains'], recipient.lower().rpartition('@')[2])
        elif status == 'deferred':
            _report_add(counts, 'deferred')
            _report_add(agg['deferrals'], _report_reason(reason))
        elif status == 'bounced':
            _report_add(counts, 'bounced')
            _report_add(agg['bounces'], _report_reason(reason))


def _report_trim(agg):
    for key in ('senders', 'recipients', 'sender_domains', 'recipient_domains', 'rejects', 'deferrals', 'bounces', 'tls_in', 'tls_out', 'tls_out_trust'):
        agg[key] = dict(sorted(agg.get(key, {}).items(), key=lambda item: -item[1])[:REPORT_KEEP])


def _report_queue():
    total = 0
    for name in ('incoming', 'active', 'deferred', 'hold'):
        for _root, _dirs, files in os.walk(f'/var/spool/postfix/{name}'):
            total += len(files)
    return total


def _report_read(day):
    return _json_read(f'{REPORT_DIR}/{day}.json', None)


def _report_merge(dates):
    total = _report_empty()
    for day in dates:
        agg = _report_read(day)
        if not agg:
            continue
        for key, table in agg.items():
            if key == 'queue':
                total['queue'] = table
            elif key == 'hours':
                for hour, values in table.items():
                    for name, amount in values.items():
                        _report_add(total['hours'].setdefault(hour, {}), name, amount)
            else:
                for name, amount in table.items():
                    _report_add(total.setdefault(key, {}), name, amount)
    return total


def _report_top(table):
    return [{'name': name, 'mails': amount} for name, amount in sorted(table.items(), key=lambda item: -item[1])[:REPORT_SHOW]]


def _report_view(total, period):
    counts = total['counts']
    connections = counts.get('connections', 0)
    summary = {name: counts.get(name, 0) for name in ('received', 'delivered', 'forwarded', 'deferred', 'bounced', 'rejected')}
    summary.update({'megabytes_received': round(counts.get('bytes_received', 0) / 1048576, 1),
                    'megabytes_delivered': round(counts.get('bytes_delivered', 0) / 1048576, 1), 'smtp_connections': connections,
                    'tls_share_percent': round(100 * counts.get('tls', 0) / connections) if connections else 0, 'queue_size': total['queue']})
    return {'period': period, 'summary': summary,
            'per_hour': [{'hour': hour, **{name: total['hours'][hour].get(name, 0) for name in ('received', 'delivered', 'rejected')}}
                         for hour in sorted(total['hours'])],
            'top_senders': _report_top(total['senders']), 'top_recipients': _report_top(total['recipients']),
            'top_sender_domains': _report_top(total['sender_domains']), 'top_recipient_domains': _report_top(total['recipient_domains']),
            'reject_reasons': _report_top(total['rejects']), 'deferral_reasons': _report_top(total['deferrals']),
            'bounce_reasons': _report_top(total['bounces'])}


def _report_text(view):
    lines = [f"Mail report for {view['period']}", '']
    lines += [f"{name.replace('_', ' ')}: {value}" for name, value in view['summary'].items()]
    for key in ('top_senders', 'top_recipients', 'reject_reasons', 'deferral_reasons', 'bounce_reasons'):
        lines += ['', key.replace('_', ' ').capitalize()] + [f"{row['mails']:>7}  {row['name']}" for row in view[key]]
    return '\n'.join(lines)


def reports_due(settings_now, state, today):
    """Which reports are due: yesterday once a day, the last 7 days once on a Monday."""
    due = []
    if settings_now.get('daily') and state.get('sent_day') != today.isoformat():
        due.append('day')
    if settings_now.get('weekly') and today.weekday() == 0 and state.get('sent_week') != today.isoformat():
        due.append('week')
    return due


def report_period(period, today):
    if period == 'month':
        return (today - datetime.timedelta(days=30)).isoformat(), (today - datetime.timedelta(days=1)).isoformat()
    if period == 'week':
        return (today - datetime.timedelta(days=7)).isoformat(), (today - datetime.timedelta(days=1)).isoformat()
    if period == 'day':
        day = (today - datetime.timedelta(days=1)).isoformat()
        return day, day
    raise EfaError("Period must be 'day', 'week' or 'month'.")


def report_domains(domains, wanted):
    """The domain filter of a report, within what the reader may see. None: all domains."""
    wanted = (wanted or '').strip().lower()
    if not wanted:
        return domains
    if domains is not None and wanted not in domains:
        raise EfaError('Unknown domain.')
    return [wanted]


def _report_auth(rows):
    """Per sender domain: mails and the results of SPF, DKIM, DMARC and ARC that are not a pass."""
    table = {}
    for row in rows:
        entry = table.setdefault(row['domain'] or '(none)', {'domain': row['domain'] or '(none)', 'mails': 0})
        entry['mails'] += row['n']
        for check in ('spf', 'dkim', 'dmarc', 'arc'):
            result = row[check] or 'none'
            if result != 'pass':
                entry[f'{check}_{result}'] = entry.get(f'{check}_{result}', 0) + row['n']
    return sorted(table.values(), key=lambda entry: -entry['mails'])[:REPORT_TOP]


def _report_signing(rows, keys, rotation):
    """Per own domain: signatures by key type, ARC seals, unsigned mails; key age and the next rotation."""
    kinds = {(key['domain'], key['selector']): key['public'][0] for key in keys if key['public']}
    ages = {}
    for key in keys:
        if key['purpose'] == 'dkim' and key['state'] == 'active' and os.path.exists(key['path']):
            age = int((time.time() - os.path.getmtime(key['path'])) // 86400)
            ages[key['domain']] = max(ages.get(key['domain'], 0), age)
    table = {}
    for row in rows:
        entry = table.setdefault(row['domain'], {'domain': row['domain'], 'rsa': 0, 'ed25519': 0, 'arc': 0, 'unsigned': 0})
        name = row['kind'] if row['kind'] in ('arc', 'unsigned') else kinds.get((row['domain'], row['selector']), 'rsa')
        entry[name] = entry.get(name, 0) + int(row['n'])
    for entry in table.values():
        entry['key_age_days'] = ages.get(entry['domain'])
        due = [item['next_rotation'] for item in rotation if item['domain'] == entry['domain'] and item['next_rotation']]
        entry['next_rotation'] = min(due) if due else None
        entry['auto_rotate'] = any(item['auto_rotate'] for item in rotation if item['domain'] == entry['domain'])
    return sorted(table.values(), key=lambda entry: entry['domain'])


def _report_tls(total):
    """TLS from the Postfix log of the whole host: shares, versions with ciphers, failures."""
    counts = total['counts']
    connections, sent = counts.get('connections', 0), counts.get('smtp_sent', 0)
    return {'inbound_percent': round(100 * counts.get('tls', 0) / connections) if connections else None,
            'outbound_percent': min(100, round(100 * counts.get('tls_out', 0) / sent)) if sent else None,
            'failed_inbound': counts.get('tls_failed_in', 0), 'failed_outbound': counts.get('tls_failed_out', 0),
            'inbound': _report_top(total.get('tls_in', {})), 'outbound': _report_top(total.get('tls_out', {})),
            'outbound_trust': _report_top(total.get('tls_out_trust', {}))}


def report_data(period, domains, today):
    """Mail flow, threats, authentication and transport from the mail log, for the domains of one reader. None means all."""
    start, end = report_period(period, today)
    where, params = search_where({'date_from': start, 'date_to': end}, domains)
    sign_where, sign_params = 'WHERE day >= %s AND day <= %s', [start, end]
    if domains is not None:
        sign_where += ' AND domain IN (' + ', '.join(['%s'] * len(domains)) + ')' if domains else ' AND FALSE'
        sign_params += list(domains)
    db = _maillog_db()
    try:
        with db.cursor() as cur:
            def rows(sql, extra=()):
                cur.execute(sql.format(where=where), (*params, *extra))
                return cur.fetchall()
            actions = {row['action'] or 'unknown': row['n'] for row in rows('SELECT action, COUNT(*) AS n FROM maillog {where} GROUP BY action ORDER BY n DESC')}
            auth = rows("SELECT SUM(spf IN ('fail', 'softfail')) AS spf, SUM(dkim = 'fail') AS dkim, SUM(dmarc = 'fail') AS dmarc FROM maillog {where}")[0]
            spam = ' AND ' if where else ' WHERE '
            threat = spam + "action NOT IN ('no action', 'greylist')"
            senders = rows('SELECT sender AS name, COUNT(*) AS n FROM maillog {where}' + threat + ' GROUP BY sender ORDER BY n DESC LIMIT %s', (REPORT_TOP,))
            targets = rows('SELECT rcpt AS name, COUNT(*) AS n FROM maillog {where}' + threat + ' GROUP BY rcpt ORDER BY n DESC LIMIT %s', (REPORT_TOP,))
            daily = rows('SELECT CAST(DATE(ts) AS CHAR) AS day, COUNT(*) AS n FROM maillog {where} GROUP BY DATE(ts) ORDER BY day')
            by_domain = rows("SELECT SUBSTRING_INDEX(sender, '@', -1) AS domain, spf, dkim, dmarc, arc, COUNT(*) AS n FROM maillog {where}"
                             " GROUP BY domain, spf, dkim, dmarc, arc")
            failing = rows('SELECT ip AS name, COUNT(*) AS n FROM maillog {where}' + spam + "(dmarc = 'fail' OR spf = 'fail' OR dkim = 'fail' OR arc = 'fail')"
                           ' GROUP BY ip ORDER BY n DESC LIMIT %s', (REPORT_TOP,))
            arc_failed = int(rows('SELECT COUNT(*) AS n FROM maillog {where}' + spam + "arc IN ('fail', 'permerror')")[0]['n'])
    finally:
        db.close()
    signing = _admin_query('SELECT kind, domain, selector, SUM(n) AS n FROM sign_daily ' + sign_where + ' GROUP BY kind, domain, selector', sign_params)
    view = {'period': period, 'from': start, 'to': end, 'total': sum(actions.values()), 'actions': actions,
            'failed_checks': {key: int(auth[key] or 0) for key in ('spf', 'dkim', 'dmarc')}, 'top_blocked_senders': senders,
            'top_targets': targets, 'per_day': daily, 'auth_by_sender_domain': _report_auth(by_domain), 'top_failing_sources': failing,
            'arc_failed_inbound': arc_failed,
            'signing': _report_signing(signing, _dkim_keys(), rotation_status(None)['domains'] if signing else [])}
    # The Postfix log is of the whole host, so only a reader of all domains gets the TLS block.
    if domains is None:
        dates = [(datetime.date.fromisoformat(start) + datetime.timedelta(days=offset)).isoformat()
                 for offset in range((datetime.date.fromisoformat(end) - datetime.date.fromisoformat(start)).days + 1)]
        view['tls'] = _report_tls(_report_merge(dates))
    # DMARC aggregate and TLS reports come with item 6: shown once rows exist.
    for name, table in (('dmarc_aggregate', 'dmarc_rua'), ('tls_reports', 'tls_rpt')):
        found = _admin_query(f'SELECT domain, COUNT(*) AS reports FROM {table} WHERE begin_ts <= %s AND end_ts >= %s'
                             + (' AND domain IN (' + ', '.join(['%s'] * len(domains)) + ')' if domains else '') + ' GROUP BY domain',
                             [end + ' 23:59:59', start, *(domains or [])]) if domains != [] else []
        if found:
            view[name] = found
    return view


def _report_table(title, rows):
    if not rows:
        return ''
    body = ''.join(f'<tr><td>{html.escape(str(name or "(empty)"))}</td><td style="text-align:right">{count}</td></tr>' for name, count in rows)
    return f'<h2 style="font-size:1.05em;margin:1.2em 0 .3em">{html.escape(title)}</h2><table style="border-collapse:collapse;width:100%">{body}</table>'


def report_tables(view):
    tables = [('Results', list(view['actions'].items())), ('Failed checks', list(view['failed_checks'].items())),
              ('Per day', [(row['day'], row['n']) for row in view['per_day']]),
              ('Senders stopped most often', [(row['name'], row['n']) for row in view['top_blocked_senders']]),
              ('Recipients attacked most often', [(row['name'], row['n']) for row in view['top_targets']])]
    tables.append(('Inbound authentication by sender domain: mails, then results other than pass',
                   [(entry['domain'], ', '.join([str(entry['mails'])] + [f'{key.replace("_", " ")} {count}' for key, count in sorted(entry.items())
                                                                         if key not in ('domain', 'mails')]))
                    for entry in view.get('auth_by_sender_domain', [])]))
    tables.append(('Sources failing SPF, DKIM, DMARC or ARC most often', [(row['name'], row['n']) for row in view.get('top_failing_sources', [])]))
    tables.append(('Outbound signing by own domain', [
        (entry['domain'], f"RSA {entry['rsa']}, Ed25519 {entry['ed25519']}, ARC seals {entry['arc']}, unsigned {entry['unsigned']}"
                          + (f", key {entry['key_age_days']} days old" if entry['key_age_days'] is not None else '')
                          + (f", next rotation {entry['next_rotation']}" if entry['next_rotation'] else ', no rotation planned'))
        for entry in view.get('signing', [])]))
    if view.get('arc_failed_inbound'):
        tables.append(('ARC', [('Inbound ARC chains failed', view['arc_failed_inbound'])]))
    tls = view.get('tls')
    if tls:
        tables.append(('TLS', [(name, value) for name, value in (
            ('Inbound connections with TLS, percent', tls['inbound_percent']), ('Outbound deliveries with TLS, percent', tls['outbound_percent']),
            ('Failed TLS inbound', tls['failed_inbound']), ('Failed TLS outbound', tls['failed_outbound'])) if value is not None]))
        tables.append(('TLS inbound: version and cipher', [(row['name'], row['mails']) for row in tls['inbound']]))
        tables.append(('TLS outbound: version and cipher', [(row['name'], row['mails']) for row in tls['outbound']]))
        tables.append(('TLS outbound: certificate check', [(row['name'], row['mails']) for row in tls['outbound_trust']]))
    for key, title in (('dmarc_aggregate', 'DMARC aggregate reports received'), ('tls_reports', 'TLS reports received')):
        if view.get(key):
            tables.append((title, [(row['domain'], row['reports']) for row in view[key]]))
    return tables


def report_title(view, scope):
    return f"eFa report {view['from']}" + (f" to {view['to']}" if view['to'] != view['from'] else '') + (f' for {scope}' if scope else '')


def report_html(view, scope=''):
    """Works as a mail and as a page to print. Everything in it is escaped: senders come from outside."""
    title = html.escape(report_title(view, scope))
    tables = ''.join(_report_table(name, rows) for name, rows in report_tables(view))
    return (f'<!doctype html><html lang="en"><head><meta charset="utf-8"><title>{title}</title><style>td{{padding:.15em .4em;border-bottom:1px solid #ccc}}'
            f'@media print{{a{{display:none}}}}</style></head><body style="font-family:sans-serif;max-width:46em;margin:1em auto;padding:0 1em">'
            f'<h1 style="font-size:1.3em">{title}</h1><p>{view["total"]} mails.</p>{tables}</body></html>')


def report_plain(view, scope=''):
    lines = [report_title(view, scope), f"{view['total']} mails."]
    for name, rows in report_tables(view):
        if rows:
            lines += ['', name] + [f'  {count:>8}  {label or "(empty)"}' for label, count in rows]
    return '\n'.join(lines) + '\n'


def brand_html(page, brand):
    """The name, colour and logo of a tenant at the top of a mail."""
    if not brand:
        return page
    color = f' style="color:{brand["color"]}"' if brand['color'] else ''
    logo = '<img src="cid:efa-brand-logo" alt="" style="max-height:60px"><br>' if brand['logo'] else ''
    return page.replace('<body style="font-family:sans-serif">', f'<body style="font-family:sans-serif">{logo}<p{color}><b>{html.escape(brand["name"])}</b></p>', 1)


def brand_logo(message, brand):
    """Puts the logo into the HTML part, so no picture is loaded from outside."""
    if not brand or not brand['logo']:
        return
    with open(f"{BRAND_DIR}/{brand['tenant_id']}.png", 'rb') as f:
        data = f.read()
    for part in message.walk():
        if part.get_content_type() == 'text/html':
            part.add_related(data, 'image', 'png', cid='<efa-brand-logo>')
            return


def _report_mail(address, view, scope, brand=None):
    message = email.message.EmailMessage()
    message['To'] = address
    message['Subject'] = report_title(view, scope)
    message.set_content(report_plain(view, scope))
    message.add_alternative(brand_html(report_html(view, scope), brand), subtype='html')
    brand_logo(message, brand)
    subprocess.run(['sendmail', '-t'], input=message.as_bytes(), capture_output=True, check=False)


def _reports_send(period, today):
    """The admin gets all domains, each tenant admin with an address only the domains of the tenant."""
    if _admin_email() and prefs_of('')['notifications']:
        _report_mail(_admin_email(), report_data(period, None, today), '')
    for row in _admin_query("SELECT DISTINCT u.email, u.username, t.id, t.name FROM users u JOIN user_groups m ON m.username = u.username "
                            "JOIN efa_groups g ON g.id = m.group_id AND g.builtin = 'tenant' JOIN tenants t ON t.id = m.tenant_id "
                            "WHERE u.email IS NOT NULL AND u.disabled = 0"):
        if not prefs_of(row['username'])['notifications']:
            continue
        domains = [item['domain'] for item in _admin_query('SELECT domain FROM tenant_domains WHERE tenant_id = %s', (row['id'],))]
        _report_mail(row['email'], report_data(period, domains, today), row['name'], tenant_brand(row['id']))


def report_show(args):
    """Mail flow, threats, authentication and TLS for yesterday, the last 7 or 30 days, for all or one domain.
    As a page, the browser can print it to a PDF."""
    period = (args.period or '').strip() or 'day'
    domains = report_domains(identity_now['domains'] if identity_now else None, getattr(args, 'domain', ''))
    view = report_data(period, domains, _today())
    fmt = (args.format or '').strip()
    if fmt == 'json':
        return {'json': json.dumps(view, indent=1, default=str)}
    return {'html': report_html(view)} if fmt == 'html' else view


def report_set(args):
    """Reports by mail to the admin and the tenant admins: yesterday every day, the last 7 days on Mondays. Off by default."""
    state = {'daily': _on_off(args.daily), 'weekly': _on_off(args.weekly)}
    _json_write(REPORTS_FILE, state)
    return state


def report_status(_args):
    """Reports by mail."""
    return _json_read(REPORTS_FILE, {'daily': False, 'weekly': False})


def rule_targets(rule, tenant_domains, group_members):
    """The addresses and @domains a rule applies to. Tenants and groups turn into what they hold now."""
    kind, value = rule['kind'], rule['value']
    if kind in ('sender', 'recipient'):
        return [value]
    if kind in ('sender_domain', 'domain'):
        return ['@' + value]
    if kind == 'tenant':
        return ['@' + domain for domain in tenant_domains(value)]
    return group_members(value)


def rule_settings_text(rules, tenant_domains, group_members):
    """rspamd takes the first rule that fits, in the order of the priorities. Rules without targets are left out."""
    blocks = []
    for rule in sorted((r for r in rules if r.get('enabled', True)), key=lambda r: -int(r['priority'])):
        actions = []
        if rule.get('reject') not in (None, ''):
            actions.append(f"reject = {rule['reject']};")
        elif rule.get('quarantine'):
            actions.append(f'reject = {RULE_NEVER_REJECT};')
        if rule.get('add_header') not in (None, ''):
            # Both count as marked spam here, and the subject rule would otherwise stay at its lower limit.
            actions.append(f'"add header" = {rule["add_header"]}; "rewrite subject" = {rule["add_header"]};')
        if rule.get('greylist') not in (None, ''):
            actions.append(f"greylist = {rule['greylist']};")
        if rule.get('spam_off'):
            # No spam action for these mails; the virus scan rejects on its own (force action), it stays.
            actions = ['reject = null; "add header" = null; "rewrite subject" = null; greylist = null;']
        extra = ' symbols_disabled = ["MIME_ENCRYPTED_ARCHIVE"];' if rule.get('allow_encrypted') else ''
        targets = rule_targets(rule, tenant_domains, group_members)
        if not (actions or extra) or not targets:
            continue
        field = 'from' if rule['kind'] in RULE_FROM_SENDER else 'rcpt'
        listed = ', '.join(json.dumps(target) for target in targets)
        applied = (f"actions {{ {' '.join(actions)} }}" if actions else '') + extra
        blocks.append(f"efa_rule_{rule['name'].replace('-', '_')} {{\n  priority = {rule['priority']};\n  {field} = [{listed}];\n"
                      f"  apply {{ {applied.strip()} }}\n}}\n")
    return (RULES_MARK + ''.join(blocks)) if blocks else ''


def rule_route_lines(rules, tenant_domains, group_members):
    """Postfix map lines: (for the recipient, for the sender)."""
    to_recipient, to_sender = [], []
    for rule in sorted((r for r in rules if r.get('enabled', True) and r.get('route')), key=lambda r: -int(r['priority'])):
        host, _, port = rule['route'].partition(':')
        hop = f'[{host}]' + (f':{port}' if port else '')
        for target in rule_targets(rule, tenant_domains, group_members):
            # A domain in a transport map has no @, in the sender map it has one.
            if rule['kind'] in RULE_FROM_SENDER:
                to_sender.append(f'{target} {hop}')
            else:
                to_recipient.append(f"{target.lstrip('@')} smtp:{hop}")
    return to_recipient, to_sender


def map_list_value(current, entry, wanted):
    """A Postfix map list with our map first, or without it. Everything else in the list stays."""
    items = [item for item in re.split(r'[\s,]+', current.strip()) if item and item != entry]
    return ', '.join(([entry] if wanted else []) + items)


def rule_map_value(current, path, wanted):
    return map_list_value(current, f'hash:{path}', wanted)


# Archive handover (8h): a copy of each mail to an external archive by SMTP, as Postfix BCC. A copy that cannot be delivered
# waits in the queue like any other mail, the queue alarm reports a backlog.
ARCHIVE_FILE = ETC + '/eFa/archive.json'
ARCHIVE_RCPT_BCC = ETC + '/postfix/efa-archive-recipient-bcc'
ARCHIVE_SENDER_BCC = ETC + '/postfix/efa-archive-sender-bcc'
ARCHIVE_TRANSPORT = ETC + '/postfix/efa-archive-transport'
ARCHIVE_TLS = ETC + '/postfix/efa-archive-tls'
ARCHIVE_TEMPLATES = ('mailstore', 'piler', 'smtp')
ARCHIVE_DIRECTIONS = ('in', 'out', 'both')
ARCHIVE_TLS_LEVELS = ('encrypt', 'may')


def archive_maps(targets, own):
    """The lines of the BCC, transport and TLS tables. A target without domains takes all domains of this server."""
    rcpt, sender, transport, tls, taken = [], [], [], [], {}
    for item in targets:
        for domain in item['domains'] or sorted(own):
            for direction in ('in', 'out') if item['direction'] == 'both' else (item['direction'],):
                if (domain, direction) in taken:
                    raise EfaError(f'{domain} goes to the archive {taken[domain, direction]} already ({direction}).')
                taken[domain, direction] = item['name']
                (rcpt if direction == 'in' else sender).append(f'@{domain} {item["address"]}')
        transport.append(f'{item["address"]} smtp:[{item["host"]}]:{item["port"]}')
        tls.append(f'[{item["host"]}]:{item["port"]} {item["tls"]}')
    return {ARCHIVE_RCPT_BCC: rcpt, ARCHIVE_SENDER_BCC: sender, ARCHIVE_TRANSPORT: sorted(set(transport)), ARCHIVE_TLS: sorted(set(tls))}


def _archive_apply(targets):
    tables = archive_maps(targets, _own_domains())
    for path, lines in tables.items():
        if lines:
            _map_write(path, lines)
    for parameter, path in (('recipient_bcc_maps', ARCHIVE_RCPT_BCC), ('sender_bcc_maps', ARCHIVE_SENDER_BCC),
                            ('transport_maps', ARCHIVE_TRANSPORT), ('smtp_tls_policy_maps', ARCHIVE_TLS)):
        wanted = rule_map_value(_postconf(parameter), path, bool(tables[path]))
        if wanted != _postconf(parameter):
            if wanted:
                _postconf_set(parameter, wanted)
            else:
                _postconf_remove([parameter])
    for path, lines in tables.items():
        for item in (path, path + '.db'):
            if not lines and os.path.exists(item):
                os.remove(item)


# Bulk mail (8i): its own transport, slower per target domain, and a check of what the big providers ask of bulk senders.
BULK_TRANSPORT = 'efabulk'
BULK_HEADERS = ETC + '/postfix/efa-bulk-headers'
BULK_PACES = {'gentle': {'destination_concurrency_limit': 1, 'destination_rate_delay': '3s', 'destination_recipient_limit': 20},
              'normal': {'destination_concurrency_limit': 1, 'destination_rate_delay': '1s', 'destination_recipient_limit': 50},
              'fast': {'destination_concurrency_limit': 5, 'destination_rate_delay': '0s', 'destination_recipient_limit': 100}}
BULK_DEFAULTS = {'enabled': False, 'auto': True, 'senders': [], 'missing': 'log', 'pace': 'normal', 'ready': {}}


def bulk_ready(domain, dkim_domains, txt=None):
    """What a bulk sender domain lacks: a DKIM key here (it signs with the From domain, so DKIM aligns), SPF and DMARC in DNS."""
    txt = txt or (lambda name: _dns_txt('127.0.0.1', name) or [])
    missing = [] if domain in dkim_domains else ['dkim']
    if not any('v=spf1' in line.lower() for line in txt(domain)):
        missing.append('spf')
    if not any('v=dmarc1' in line.lower() for line in txt('_dmarc.' + domain)):
        missing.append('dmarc')
    return missing


def bulk_status(_args):
    """Bulk mail: settings, and per sender domain what the providers would miss."""
    return {**BULK_DEFAULTS, **_json_read(OUTBOUND_FILE, {}).get('bulk', {})}


def bulk_set(args):
    """Bulk mail through its own slower transport: for named senders, and with auto for mail with Precedence bulk or List-Unsubscribe."""
    state = _json_read(OUTBOUND_FILE, {})
    bulk = {**BULK_DEFAULTS, **state.get('bulk', {})}
    if (args.mode or '').strip():
        bulk['enabled'] = _on_off(args.mode)
    if (args.auto or '').strip():
        bulk['auto'] = _on_off(args.auto)
    for key, choices in (('missing', ('log', 'hold')), ('pace', tuple(BULK_PACES))):
        value = (getattr(args, key) or '').strip()
        if value:
            if value not in choices:
                raise EfaError(f'{key}: {", ".join(choices)}.')
            bulk[key] = value
    if args.senders is not None and args.senders.strip():
        senders = [] if args.senders.strip() == '-' else sorted({item.strip().lower() for item in re.split(r'[\s,;]+', args.senders) if item.strip()})
        own = _own_domains()
        bad = [item for item in senders if item.rpartition('@')[2] not in own or not (DOMAIN_RE.match(item) or SENDER_RE.match(item))]
        if bad:
            raise EfaError(f'Only addresses or domains of this server: {", ".join(bad)}')
        bulk['senders'] = senders
    dkim = set(_dkim_conf_domains())
    bulk['ready'] = {domain: bulk_ready(domain, dkim) for domain in sorted({item.rpartition('@')[2] for item in bulk['senders']} | _own_domains())} \
        if bulk['enabled'] else {}
    state['bulk'] = bulk
    on = bulk['enabled']
    if on:
        subprocess.run(['postconf', '-M', f'{BULK_TRANSPORT}/unix={BULK_TRANSPORT} unix - - n - - smtp'], check=True, capture_output=True)
        subprocess.run(['postconf', '-P', f'{BULK_TRANSPORT}/unix/syslog_name=postfix/bulk'], check=True, capture_output=True)
        for name, value in BULK_PACES[bulk['pace']].items():
            _postconf_set(f'{BULK_TRANSPORT}_{name}', str(value))
        _write(BULK_HEADERS, f'/^X-eFa-Bulk: yes$/ FILTER {BULK_TRANSPORT}:\n')
    _postconf_set('milter_header_checks', map_list_value(_postconf('milter_header_checks'), f'regexp:{BULK_HEADERS}', on))
    if not on:
        _postconf_remove([f'{BULK_TRANSPORT}_{name}' for name in BULK_PACES['normal']])
        subprocess.run(['postconf', '-MX', f'{BULK_TRANSPORT}/unix'], check=False, capture_output=True)
        if os.path.exists(BULK_HEADERS):
            os.remove(BULK_HEADERS)
    _outbound_write(state)
    return bulk_status(None)


def archive_status(_args):
    """The archive targets, and how many copies wait in the queue for each."""
    targets = _json_read(ARCHIVE_FILE, {'targets': []})['targets']
    try:
        rows = _queue_rows()
    except EfaError:
        rows = []
    return {'targets': [{**item, 'waiting': sum(1 for row in rows if item['address'] in row['rcpts'])} for item in targets]}


def archive_set(args):
    """An archive target: a journal address that gets a copy of each mail of its domains, delivered by SMTP to its host."""
    name = args.name.strip().lower()
    if not SUBMITTER_NAME_RE.match(name):
        raise EfaError('Name: up to 32 small letters, digits or _.')
    template = (args.template or 'smtp').strip()
    direction = (args.direction or 'both').strip()
    tls = (args.tls or 'encrypt').strip()
    address = args.address.strip().lower()
    host = args.host.strip().lower()
    port = (args.port or '25').strip()
    if template not in ARCHIVE_TEMPLATES or direction not in ARCHIVE_DIRECTIONS or tls not in ARCHIVE_TLS_LEVELS:
        raise EfaError('Template: mailstore, piler or smtp; direction: in, out or both; TLS: encrypt or may.')
    if not SENDER_RE.match(address):
        raise EfaError('Address: the journal address of the archive.')
    if not HOST_RE.match(host) or ':' in host or not port.isdigit() or not 1 <= int(port) <= 65535:
        raise EfaError('Host and port of the archive, such as archive.example.org and 25.')
    own = _own_domains()
    domains = sorted({item.strip().lower() for item in re.split(r'[\s,;]+', args.domains or '') if item.strip()})
    if any(domain not in own for domain in domains):
        raise EfaError('Domains: only domains of this server; empty for all of them.')
    if address.rpartition('@')[2] in own:
        raise EfaError('The journal address must not be in a domain of this server: the copies would be archived again.')
    state = _json_read(ARCHIVE_FILE, {'targets': []})
    targets = [item for item in state['targets'] if item['name'] != name] + [
        {'name': name, 'template': template, 'address': address, 'host': host, 'port': int(port), 'direction': direction, 'tls': tls,
         'domains': domains}]
    _archive_apply(targets)
    _json_write(ARCHIVE_FILE, {'targets': sorted(targets, key=lambda item: item['name'])})
    return archive_status(None)


def archive_remove(args):
    """Removes an archive target. Copies still in the queue are delivered."""
    _confirm(args)
    state = _json_read(ARCHIVE_FILE, {'targets': []})
    targets = [item for item in state['targets'] if item['name'] != args.name.strip().lower()]
    if len(targets) == len(state['targets']):
        raise EfaError('No such archive target.')
    _archive_apply(targets)
    _json_write(ARCHIVE_FILE, {'targets': targets})
    return archive_status(None)


def _rule_group_members(group_dn):
    """Addresses of a directory group, each time the rules are written. Without LDAP a group holds nobody."""
    state = _json_read(LDAP_FILE, {})
    if not state.get('ldap'):
        return []
    with tempfile.NamedTemporaryFile('w', dir='/run', prefix='efa-ldap-') as service:
        service.write(state['bind_password'])
        service.flush()
        done = subprocess.run(ldap_command('ldapsearch', state, state['bind_dn'], service.name) + ['-LLL', '-o', 'ldif-wrap=no', '-b', state['base'], f'(memberOf={ldap_filter_escape(group_dn)})', 'mail'],
                              capture_output=True, text=True, timeout=20)
    return sorted({line.split(':', 1)[1].strip().lower() for line in done.stdout.splitlines() if line.lower().startswith('mail:')})


def _rule_tenant_domains(name):
    return [row['domain'] for row in _admin_query('SELECT domain FROM tenant_domains WHERE tenant_id = %s', (_tenant_id(name),))]


def _rules():
    return _json_read(RULES_FILE, {'rules': []})['rules']


def _rule_map(path, lines):
    if lines:
        _write(path, '\n'.join(lines) + '\n')
        subprocess.run(['postmap', path], check=True, capture_output=True)
    else:
        for item in (path, path + '.db'):
            if os.path.exists(item):
                os.remove(item)


def layer_value(name, value):
    """The checked form of a value, as stored."""
    value = value.strip()
    if name in ('spam_mark', 'spam_reject'):
        try:
            number = float(value)
        except ValueError:
            raise EfaError('Spam limits are numbers.')
        if not 0 < number <= 1000:
            raise EfaError('Spam limits: above 0, up to 1000.')
        return f'{number:g}'
    if name == 'headers_store':
        if value not in ('on', 'off'):
            raise EfaError('Store headers: on or off.')
        return value
    if name in ('quarantine_days', 'digest_hour', 'headers_days'):
        low, high = (0, 23) if name == 'digest_hour' else (1, 3650)
        if not value.isdigit() or not low <= int(value) <= high:
            raise EfaError(f'{name}: {low} to {high}.')
        return str(int(value))
    if name == 'digest_text':
        if len(value) > 1000 or any(ord(ch) < 32 and ch not in '\n' for ch in value):
            raise EfaError('Digest text: up to 1000 characters, no control characters.')
        return value
    if name == 'tls':
        if value not in TLS_LEVELS:
            raise EfaError('TLS: ' + ', '.join(TLS_LEVELS))
        return value
    if value not in LANGUAGES:
        raise EfaError('Language: ' + ', '.join(LANGUAGES))
    return value


def layer_effective(domain, tenant_id, rows, defaults):
    """{name: (value, source)} for a domain, or for a tenant when domain is None."""
    found = {}
    for name in LAYER_SETTINGS:
        if domain is not None and name in rows.get(('domain', domain), {}):
            found[name] = (rows[('domain', domain)][name], 'domain')
        elif tenant_id is not None and name in rows.get(('tenant', str(tenant_id)), {}):
            found[name] = (rows[('tenant', str(tenant_id))][name], 'tenant')
        else:
            found[name] = (defaults.get(name, ''), 'global')
    return found


def layer_domains(rows, tenant_domains):
    """Every domain that has a value of its own or of its tenant: {domain: tenant_id}."""
    tenant_of = {domain: tenant for tenant, domains in tenant_domains.items() for domain in domains}
    found = {target: tenant_of.get(target) for level, target in rows if level == 'domain'}
    for level, target in rows:
        if level == 'tenant' and target.isdigit():
            found.update({domain: int(target) for domain in tenant_domains.get(int(target), ())})
    return found


def layer_spam_rules(rows, tenant_domains):
    """One rspamd settings rule per domain with own spam limits; what it does not set stays global."""
    found = []
    for domain, tenant in sorted(layer_domains(rows, tenant_domains).items()):
        values = layer_effective(domain, tenant, rows, {})
        mark, reject = values['spam_mark'], values['spam_reject']
        if mark[1] == 'global' and reject[1] == 'global':
            continue
        found.append({'name': 'layer_' + re.sub(r'[^a-z0-9]', '_', domain), 'kind': 'domain', 'value': domain, 'priority': LAYER_RULE_PRIORITY,
                      'reject': reject[0] if reject[1] != 'global' else '', 'add_header': mark[0] if mark[1] != 'global' else '',
                      'greylist': '', 'quarantine': False, 'route': '', 'enabled': True})
    return found


def layer_tls_lines(rows, tenant_domains):
    return [f"{domain} {layer_effective(domain, tenant, rows, {})['tls'][0]}" for domain, tenant in sorted(layer_domains(rows, tenant_domains).items())
            if layer_effective(domain, tenant, rows, {})['tls'][1] != 'global']


HEADERS_POLICY_FILE = ETC + '/efa-web/headers-policy.json'
HEADERS_MAX = 65536
HEADERS_FREE_MIN = 0.1
EXPORTER_CONF = RSPAMD_DIR + '/local.d/metadata_exporter.conf'
# The fields efa-maillog reads, plus the raw header block; no second pass over the mail anywhere.
EXPORTER_TEXT = """# Written by efactl maillog-setup. Do not edit: the next upgrade replaces it.
custom_format {
  efa_json = <<EOD
return function(task)
  local ucl = require "ucl"
  local r = {}
  local ip = task:get_from_ip()
  r.ip = (ip and ip:is_valid()) and tostring(ip) or 'unknown'
  r.qid = task:get_queue_id() or 'unknown'
  r.subject = task:get_subject() or ''
  r.action = task:get_metric_action()
  r.score = task:get_metric_score()[1]
  r.unix_time = task:get_date({format = 'connect', gmt = true})
  r.message_id = task:get_message_id()
  r.size = task:get_size()
  local from = task:get_from('smtp')
  r.from = (from and from[1] and from[1].addr) or 'unknown'
  r.rcpt = {}
  for _, a in ipairs(task:get_recipients('smtp') or {}) do table.insert(r.rcpt, a.addr) end
  r.symbols = {}
  for _, s in ipairs(task:get_symbols_all() or {}) do table.insert(r.symbols, {name = s.name, score = s.score, options = s.options}) end
  local raw = task:get_raw_headers()
  local text = raw and tostring(raw) or ''
  r.headers_size = #text
  r.headers = text:sub(1, %(max)d)
  return ucl.to_format(r, 'json-compact')
end
EOD;
}
rules {
  EFA_MAILLOG {
    backend = "http";
    url = "http://127.0.0.1:8906/";
    formatter = "efa_json";
    selector = "default";
  }
}
""" % {'max': HEADERS_MAX}


def headers_policy():
    stored = _json_read(PRIVACY_FILE, {})
    return {'store': stored.get('store_headers', True), 'days': int(stored.get('headers_days', 30))}


def _exporter_write():
    """The metadata exporter with the raw headers. Taken back if rspamd does not take it."""
    previous = open(EXPORTER_CONF).read() if os.path.exists(EXPORTER_CONF) else None
    if previous == EXPORTER_TEXT:
        return
    _write(EXPORTER_CONF, EXPORTER_TEXT)
    if not _rspamd_config_ok():
        if previous is None:
            os.remove(EXPORTER_CONF)
        else:
            _write(EXPORTER_CONF, previous)
        raise EfaError('rspamd rejected the metadata exporter, it stays as it was.')
    _reload_rspamd()


def headers_store_set(args):
    """Store the headers of all mail, and for how many days. On by default; tenants and domains can differ."""
    days = (args.days or '').strip()
    if days and (not days.isdigit() or not 1 <= int(days) <= 3650):
        raise EfaError('Days: 1 to 3650.')
    stored = _json_read(PRIVACY_FILE, {})
    stored['store_headers'] = _on_off(args.mode)
    if days:
        stored['headers_days'] = int(days)
    _json_write(PRIVACY_FILE, stored)
    _headers_policy_write()
    return headers_policy()


def _headers_policy_write():
    """What efa-maillog needs to know without the database: stored at all, and the domains that keep none."""
    rows, tenant_domains = _layer_rows(), _tenant_domains()
    off = sorted(domain for domain, tenant in layer_domains(rows, tenant_domains).items()
                 if layer_effective(domain, tenant, rows, {'headers_store': 'on'})['headers_store'][0] == 'off')
    wanted = {'store': headers_policy()['store'], 'off': off}
    if _json_read(HEADERS_POLICY_FILE, None) != wanted:
        _json_write(HEADERS_POLICY_FILE, wanted)
        os.chmod(HEADERS_POLICY_FILE, 0o640)
        shutil.chown(HEADERS_POLICY_FILE, 'root', 'efa-web')


def _headers_job(today, state):
    """Hourly: deletes headers past their days, per domain; warns once a day when the disk is nearly full."""
    _headers_policy_write()
    rows, tenant_domains = _layer_rows(), _tenant_domains()
    policy = headers_policy()
    own = {domain: int(layer_effective(domain, tenant, rows, {'headers_days': str(policy['days'])})['headers_days'][0])
           for domain, tenant in layer_domains(rows, tenant_domains).items()}
    own = {domain: days for domain, days in own.items() if days != policy['days']}
    for table in ('mail_headers', 'mail_evidence'):
        for domain, days in own.items():
            _admin_query(f'DELETE FROM {table} WHERE domain = %s AND ts < NOW() - INTERVAL %s DAY LIMIT 50000', (domain, days))
        where = ' AND domain NOT IN (' + ','.join(['%s'] * len(own)) + ')' if own else ''
        _admin_query(f'DELETE FROM {table} WHERE ts < NOW() - INTERVAL %s DAY{where} LIMIT 50000', (policy['days'], *own))
    # A record set nobody saw for longer than the longest retention belongs to no stored mail any more.
    _admin_query('DELETE FROM dns_records WHERE last_seen < NOW() - INTERVAL %s DAY LIMIT 50000', (max([policy['days'], *own.values()]),))
    usage = shutil.disk_usage('/var/lib/mysql')
    if usage.free / usage.total < HEADERS_FREE_MIN and state.get('headers_disk_alert') != today.isoformat():
        state['headers_disk_alert'] = today.isoformat()
        _event('headers_disk_full', 'error')
        _admin_notify('eFa: headers are not stored, the disk is nearly full',
                      f'Less than {int(HEADERS_FREE_MIN * 100)} % of the disk of the database is free. Mail still flows; headers are stored again once there is room.')


def headers_parse(text):
    """(name, value) of each header, folded lines joined, in order."""
    found = []
    for line in text.replace('\r\n', '\n').split('\n'):
        if line[:1] in (' ', '\t') and found:
            found[-1] = (found[-1][0], found[-1][1] + ' ' + line.strip())
        elif ':' in line:
            name, _sep, value = line.partition(':')
            found.append((name.strip(), value.strip()))
    return found


def received_path(headers):
    """The Received lines from the first hop to the last, with the seconds each hop took."""
    hops = []
    for name, value in reversed(headers):
        if name.lower() != 'received':
            continue
        stamp = None
        when = value.rsplit(';', 1)[1].strip() if ';' in value else ''
        try:
            stamp = email.utils.parsedate_to_datetime(when).timestamp() if when else None
        except (TypeError, ValueError, IndexError):
            stamp = None
        hops.append({'hop': value.split(';', 1)[0][:300], 'time': when[:60], 'seconds': None if stamp is None or not hops or hops[-1]['_ts'] is None
                     else round(stamp - hops[-1]['_ts']), '_ts': stamp})
    for hop in hops:
        hop.pop('_ts')
    return hops


AUTH_HEADERS = ('authentication-results', 'arc-authentication-results', 'arc-seal', 'arc-message-signature', 'dkim-signature', 'received-spf')


