        em_sent.clear()
        for _round in range(3):
            em_given[:] = ['Eva-Pass-2026-long']
            totp_email_send(ns(username='eva'))
        assert len(em_sent) == 2 and any('3 mails in 15 minutes' in text for text in em_noted), 'two more, then none'
        em_codes['eva'].update(sends='[]')
        em_given[:] = ['Eva-Pass-2026-long']
        totp_email_send(ns(username='eva'))
        em_code = re.search(r'Code: ([0-9]{8})', em_sent[-1][2]).group(1)
        wrong = '00000000' if em_code != '00000000' else '11111111'
        for _round in range(5):
            rejected(lambda code: _totp_gate({'username': 'eva', 'role': 'domain'}, code), wrong)
        assert em_codes['eva']['code_hash'] is None
        rejected(lambda code: _totp_gate({'username': 'eva', 'role': 'domain'}, code), em_code)
        assert em_totp['eva']['active'] == 1, 'after 5 wrong tries the right code does not count either'
        globals()['identity_now'] = {'username': 'boss', 'role': 'tenant'}
        rejected(lambda mode: email_recovery_set(ns(role='domain', mode=mode)), 'off')
        globals()['identity_now'] = None
        email_recovery_set(ns(role='domain', mode='off'))
        rejected(lambda item: email_recovery_set(ns(**item)), {'role': 'king', 'mode': 'on'}, {'role': 'user', 'mode': 'maybe'})
        em_codes['eva'].update(sends='[]')
        em_sent.clear()
        em_given[:] = ['Eva-Pass-2026-long']
        totp_email_send(ns(username='eva'))
        assert not em_sent and any('off for its role' in text for text in em_noted)
        globals().update(saved_em)
        # 6.0.0.5: the setup variant. Guided asks 2FA of the main admin, the EU link of the setup is hard, a new EU link locks again.
