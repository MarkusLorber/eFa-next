        # The update: a table made by hand (or of the first version) is taken over and goes; the allow list is in Postfix.
        saved_allow = (SENDER_META, SENDER_MAPS, SENDER_RULES, SKIP_DOMAINCHECK_MAP, ALLOW_MAP, ALLOW_LOG_MAP, _postconf, _postconf_set,
