        def fake_keygen(_domain, _selector, key, kind, _bits):
            if kind == 'rsa':
                subprocess.run(['openssl', 'genpkey', '-algorithm', 'RSA', '-out', key], check=True, capture_output=True)
            else:
                with open(key, 'w') as f:
                    f.write(base64.b64encode(os.urandom(64)).decode())
            return 'record'
