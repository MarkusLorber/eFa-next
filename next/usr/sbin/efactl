        # Backups: plain and encrypted, a wrong password changes nothing, and the password is not in the file.
        global BACKUP_DIR, BACKUP_PASSWORD, BACKUP_PATHS, _secrets
        BACKUP_DIR, BACKUP_PASSWORD = tmp + '/backups', tmp + '/backup-password'
        saved_paths = BACKUP_PATHS
        BACKUP_PATHS = (tmp + '/allow.map',)
        rejected(lambda item: backup_password_set(item), ns(mode='set')) if False else None
        answers = []
        _secrets = lambda count, prompt: [answers.pop(0) for _ in range(count)]
        plain = backup_now(ns(encrypt='off'))
        assert not plain['encrypted'] and plain['backup'].endswith('.tar.gz')
        answers += ['correct horse battery', 'other password xx']
        rejected(lambda item: backup_now(item), ns(encrypt='on'))
        answers += ['short', 'short']
        rejected(lambda item: backup_now(item), ns(encrypt='on'))
        answers += ['correct horse battery', 'correct horse battery']
        locked = backup_now(ns(encrypt='on'))
        assert locked['encrypted'] and locked['backup'].endswith('.tar.gz.gpg')
        with open(f'{BACKUP_DIR}/{locked["backup"]}', 'rb') as f:
            content = f.read()
        assert b'correct horse' not in content and content[:2] != b'\x1f\x8b'
        rows = backup_list(ns())['backups']
        assert {row['encrypted'] for row in rows} == {True, False} and all(row['date'] and 'size_mb' in row for row in rows)
        assert backup_download(ns(name=plain['backup']))['size'] == plain['size']
        rejected(lambda item: backup_download(item), ns(name='../../etc/passwd'), ns(name='efa-backup-none.tar.gz'))
        sudo_user, os.environ['SUDO_USER'] = os.environ.get('SUDO_USER'), 'efa-web'
        rejected(lambda item: backup_download(item), ns(name=plain['backup']))
        assert backup_download(ns(name=locked['backup']))['path'].endswith('.gpg')
