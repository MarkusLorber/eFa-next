# Switches whose label is not the plain "on or off".
SWITCH_LABELS = {'on (enabled) or off (disabled)': 'Enabled', 'on (locked) or off': 'Locked'}


def arg_meta(commands):
    """Puts the choices and the kind of each argument into the command table, for the schema and the checks."""
    for name, cmd in commands.items():
        for arg in cmd['args']:
            if (name, arg['name']) in ARG_CHOICES:
                label, options = ARG_CHOICES[(name, arg['name'])]
                arg.update(label=label, choices=[{'value': value, 'text': text} for value, text in options])
                # Only what the web form shows first: the command line keeps its own default.
                arg['preselect'] = arg.get('default') or options[0][0]
            elif arg['label'] in SWITCH_LABELS:
                arg.update(label=SWITCH_LABELS[arg['label']] + ': on or off')
            if arg['name'] in ('confirm', 'accept_tos', 'reboot_confirm', 'accept_terms'):
                arg['kind'] = 'confirm'


# Other words the command line takes for a choice, such as the way back on the console: web-allowlist-set --mode off.
CHOICE_ALIASES = {('web-allowlist-set', 'mode'): {'off'}}


def arg_choice_problem(cmd, args, name=None):
    """The first argument whose value is not one of its choices."""
    for arg in cmd['args']:
        value = getattr(args, arg['name'], None)
        known = {item['value'] for item in arg['choices']} | CHOICE_ALIASES.get((name, arg['name']), set()) if arg.get('choices') else set()
        if arg.get('choices') and value not in (None, '') and value.strip() not in known:
            return f"{arg['label']}: one of " + ', '.join(item['value'] or '(empty)' for item in arg['choices'])
    return None


arg_meta(COMMANDS)


def main():
    if '--self-test' in sys.argv:
        self_test()
        return 0
    parser = argparse.ArgumentParser(prog='efactl', description='eFa control tool')
    parser.add_argument('--as', dest='as_user', default='', help=argparse.SUPPRESS)
    parser.add_argument('--client', default='', help=argparse.SUPPRESS)
    # Set by the web interface for an API token bound to one tenant.
    parser.add_argument('--limit-tenant', dest='limit_tenant', default='', help=argparse.SUPPRESS)
    # The hashed session of the web interface, for the strict audit log.
    parser.add_argument('--session', dest='web_session', default='', help=argparse.SUPPRESS)
    sub = parser.add_subparsers(dest='command', required=True)
    sub.add_parser('schema').set_defaults(func=schema)
    sub.add_parser('menu')
    # Only the parser of the command asked for: all 330 of them took 0.13 s on every call. Help and typos get all.
    words = sys.argv[1:]
    wanted = next((item for i, item in enumerate(words) if not item.startswith('-')
                   and (i == 0 or words[i - 1] not in ('--as', '--client', '--limit-tenant', '--session'))), '')
    table = {**COMMANDS, **CLI_ONLY}
    for name, cmd in ({wanted: table[wanted]} if wanted in table else table).items():
        cmd_parser = sub.add_parser(name, help=cmd.get('title'))
        cmd_parser.set_defaults(func=cmd['func'])
        for arg in [item for item in cmd['args'] if not item.get('secret')]:
            cmd_parser.add_argument('--' + arg['name'], default=arg.get('default', None if name in CLI_ONLY else ''),
                                    required=arg.get('required', False))
    args = parser.parse_args()
    # A compromised web process must not reach CLI-only commands through its sudo rule.
    if args.command in (*CLI_ONLY, 'menu') and os.environ.get('SUDO_USER') == 'efa-web':
        print(json.dumps({'error': 'not allowed from the web interface'}))
        return 1
    if args.command == 'menu':
        return menu()
    global acting_user, acting_client, acting_session, identity_now
    acting_user, acting_client, acting_session = args.as_user, args.client, re.sub(r'[^0-9a-f]', '', args.web_session)[:64]
    writes = COMMANDS.get(args.command, {}).get('writes')
    before = None
    strict = strict_settings()['on'] and args.command not in STRICT_QUIET
    outcome = 'error'
    try:
        if strict:
            strict_ready()
        if args.as_user:
            identity_now = _load_identity(args.as_user, limit_tenant=int(args.limit_tenant) if args.limit_tenant.isdigit() else None)
        if args.command in COMMANDS and arg_choice_problem(COMMANDS[args.command], args, args.command):
            raise EfaError(arg_choice_problem(COMMANDS[args.command], args, args.command))
        if args.command in COMMANDS and not command_allowed(identity_now, args.command, writes):
            outcome = 'denied'
            raise EfaError('Not allowed: this needs the permission ' + str(command_permission(args.command, writes)) + '.')
        asked = strict_settings()
        if args.command in CONTENT_COMMANDS and (strict and asked['require_reason'] or asked['content_reason']) and \
                len((getattr(args, 'reason', '') or '').strip()) < 5:
            outcome = 'denied'
            raise EfaError('Give a reason (at least 5 characters) to see the content of a mail.')
        if identity_now:
            identity_focus(identity_now, command_permission(args.command, writes))
            if not domain_argument_ok(identity_now, args.command, args):
                raise EfaError('Not allowed: name one of your own domains.')
        if identity_now and args.command in QUARANTINE_WORK - {'quarantine-list'}:
            held = [m for m in _held_mail() if m['id'] == args.id.strip()]
            if held and not in_scope(identity_now, held[0]['recipients']):
                raise EfaError('This mail is not in quarantine.')
        if args.command in AUDITED_READS:
            _audit(f'{args.command} {getattr(args, "id", "")} by {_dmarc_who()}')
            try:
                _admin_query('INSERT INTO audit (actor, client, tenant_id, command, args, old_value, new_value, ok) VALUES (%s, %s, %s, %s, %s, %s, %s, 1)',
                             (_dmarc_who(), acting_client[:64], identity_now['tenant_id'] if identity_now else None, args.command,
                              json.dumps({'id': getattr(args, 'id', ''), 'reason': (getattr(args, 'reason', '') or '')[:500]}), '{}', '{}'))
            except Exception as err:  # the audit file has the line; pymysql errors have no common base here
                print(f'audit log: {err}', file=sys.stderr)
        if writes:
            _audit(f'{args.command} by {_dmarc_who()}')
        logged = writes and args.command not in BACKGROUND_JOBS
        if logged:
            before = _audit_state()
        if args.command in PROVISION_LOCKED and (getattr(args, 'domain', '') or '').strip() and provision_managed(args.domain):
            raise EfaError(f'{args.domain.strip().lower()} is managed externally by {provision_managed(args.domain)}, read only. '
                           'A super-admin can take it back: dkim-provision-takeover.')
        forwarded = os.environ.get('EFA_CLUSTER_FORWARDED')
        if forwarded and not (cluster_replicated(args.command) or args.command in CLUSTER_HA_FORWARD):
            raise EfaError(f'{args.command} is not handed on in a cluster.')
        role = cluster_role() if cluster_replicated(args.command) or args.command in CLUSTER_HA_FORWARD else 'none'
        if role == 'client' and not os.environ.get('EFA_CLUSTER_REPLAY'):
            if cluster_mode() == 'ha':
                args.func, role = _cluster_forward, 'forwarded'
            elif cluster_replicated(args.command):
                master = _lib('efa_cluster').read_state(ETC).get('master', {}).get('name', 'the master')
                raise EfaError(f'Managed by {master}: this node is a client in master/client mode. Change it on {master}.')
            else:
                role = 'none'
        try:
            result = args.func(args)
        except (EfaError, subprocess.CalledProcessError, subprocess.TimeoutExpired, OSError):
            if logged:
                _audit_write(args.command, args, before, False)
                _event('config_change_failed', 'warning', user=_dmarc_who(), src_ip=acting_client, command=args.command)
            raise
        if logged:
            _audit_write(args.command, args, before, True)
            _event('config_change', 'info', user=_dmarc_who(), src_ip=acting_client, tenant=(identity_now or {}).get('tenant_id') or '', command=args.command)
        if role == 'master' and cluster_replicated(args.command):
            try:
                _cluster_journal(args.command, args)
            except OSError as err:  # the change is done here; the nodes get it with the next change or a full sync later
                print(f'cluster journal: {err}', file=sys.stderr)
        outcome = 'ok'
        if result is None:
            return 0
        result = subject_filter(identity_now, args.command, scoped_result(identity_now, args.command, result),
                                subjects_shown() if args.command in SUBJECT_COMMANDS else True)
        # The web process reads JSON, an admin gets the records to paste or redirect.
        if args.command == 'dkim-export' and os.environ.get('SUDO_USER') != 'efa-web':
            print(result['text'], end='')
        else:
            print(json.dumps(result, indent=2))
    except (EfaError, subprocess.CalledProcessError, subprocess.TimeoutExpired, OSError) as err:
        print(json.dumps({'error': str(err)}))
        return 1
    finally:
        if strict:
            _strict_command_entry(args, outcome)
    return 0


def _strict_command_entry(args, outcome):
    """The entry of one efactl call: the command, its arguments with secrets masked, and how it ended."""
    values = audit_redact({key: value for key, value in vars(args).items()
                           if key not in ('func', 'command', 'as_user', 'client', 'limit_tenant', 'web_session') and value not in (None, '')})
    try:
        strict_record('efactl:' + args.command, json.dumps(values, sort_keys=True, default=str)[:2000], outcome, reason=str(values.get('reason', ''))[:500])
    except OSError as err:
        print(json.dumps({'error': f'Strict audit mode: the entry could not be written: {err}'}))


if __name__ == '__main__':
    sys.exit(main())
