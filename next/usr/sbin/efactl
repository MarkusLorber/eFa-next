            assert 'partner@example.net' in _read_lines(SENDER_MAPS['allow']) and 'partner@example.net' not in _read_lines(SENDER_MAPS['block'])
            # IP: blocked in the first own IP list that is on; a private address warns; relay and cluster addresses never.
            assert any('private' in text for text in sender_action_check(sa(value='192.0.2.7', list='block'))['warnings'])
            rejected(lambda item: sender_action(item), sa(value='192.0.2.7', list='block'), sa(value='198.51.100.9', list='block', confirm='yes'))
            sender_action(sa(value='192.0.2.7', list='block', confirm='yes'))
            assert blocked == [('own1', 'add', '192.0.2.7')]
            # The cluster: the nodes get the target the master chose and run it without a login; twice does no harm.
            master_args = sa(value='late@example.net', list='block')
            sender_action(master_args)
            assert master_args.scope == 'list'
            sender_action(sa(value='late@example.net', list='block', action='remove'))
            os.environ['EFA_CLUSTER_REPLAY'] = '1'
            try:
                for _ in range(2):
                    sender_action(sa(value='news2@example.net', list='block', scope='rule:t.example'))
                assert _sender_rules().count(['block', 'news2@example.net', 't.example']) == 1
                sender_action(sa(value='news2@example.net', list='block', action='remove', scope='rule:t.example'))
                assert ['block', 'news2@example.net', 't.example'] not in _sender_rules()
                rejected(lambda item: sender_action(item), sa(value='news2@example.net', list='block', scope='global:x'))
            finally:
                del os.environ['EFA_CLUSTER_REPLAY']
            # A tenant admin: a rule for an own recipient domain only, never global, never an IP.
