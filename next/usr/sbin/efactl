        done_calls = []

        class FakePlatform:
            def service(self, logical):
                return {'sasl': 'dovecot', 'mta': 'postfix'}[logical]

            def service_exists(self, name):
                return True

            def __getattr__(self, name):
                return lambda *args, **kwargs: done_calls.append((name, args, kwargs))
        saved_platform, kept_run = globals()['_platform'], subprocess.run
        globals()['_platform'] = FakePlatform
        subprocess.run = lambda argv, **kwargs: done_calls.append(('run', tuple(argv), {}))
        try:
            _sasl_apply(False, pam_on=False)
            assert ('service_disable', ('efa-sasl.socket',), {'stop': True}) in done_calls
