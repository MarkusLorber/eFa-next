        assert _version_tuple('v6.0.0.4.1') > _version_tuple('eFa-6.0.0.4') and _version_tuple('eFa-6.0.0.4.1-1.el9') == (6, 0, 0, 4, 1)
        assert _version_tuple('v6.0.0.5') > _version_tuple('v6.0.0.4.1') and _version_tuple('6.0.0') is None
        # A pre-release installed: its release counts as newer (only with prerelease false), and the way back is its own tag.
        saved_installed = globals()['_update_installed']
        try:
            globals()['_update_installed'] = lambda: 'eFa-6.0.0.6-alpha2'
