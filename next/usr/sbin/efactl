        new_app = totp_setup(ns(qr=False))
        assert re_db['dora']['reenroll'] == 1 and _totp_gate({'username': 'dora', 'role': 'super'}, '')['totp_setup_needed'], 'half way: still marked'
        new_secret = totp_open(re_db['dora']['secret'], 'dora')
        assert new_app['secret'] and totp_confirm(ns(code=hotp(new_secret, int(time.time() // 30))))['active']
        assert re_db['dora']['reenroll'] == 0 and re_db['dora']['active'] == 1
        # A recovery code used: a mail to the own address; without an address only the audit log.
