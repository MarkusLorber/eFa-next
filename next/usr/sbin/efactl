        assert 'r.example: signs with rsa only.' in check['notes'] and not [w for w in check['warnings'] if 'ED25519' in w]

        rejected(lambda item: resolver_set(item), ns(ipv4_1='nope', ipv4_2='', ipv6_1='', ipv6_2='', threshold=''),
                 ns(ipv4_1='2001:db8::1', ipv4_2='', ipv6_1='', ipv6_2='', threshold=''),
                 ns(ipv4_1='', ipv4_2='', ipv6_1='192.0.2.1', ipv6_2='', threshold=''), ns(ipv4_1='0.0.0.0', ipv4_2='', ipv6_1='', ipv6_2='', threshold=''))
        assert _rotation_check(_rotation_state(), 'x', 'p') == ([], [], [])
        rejected(lambda item: resolver_set(item), ns(ipv4_1='192.0.2.1', ipv4_2='', ipv6_1='', ipv6_2='', threshold='2'),
                 ns(ipv4_1='192.0.2.1', ipv4_2='', ipv6_1='', ipv6_2='', threshold='0'))
        resolver_set(ns(ipv4_1='192.0.2.1', ipv4_2='', ipv6_1='2001:db8::1', ipv6_2='', threshold=''))
        assert _rotation_state()['threshold'] == 2
        rejected(lambda item: rotation_all_set(item), ns(mode='on', interval='5', horizon='24', bits='2048'),
                 ns(mode='on', interval='6', horizon='25', bits='2048'), ns(mode='on', interval='6', horizon='3', bits='2048'))
        # All domains: each existing key type gets future keys, which do not sign.
        created = rotation_all_set(ns(mode='on', interval='3', horizon='6', bits='2048'))['pre_generated']
        assert 'efa-rsa-20270430' in created and 'efa-rsa-20270730' in created and 'efa-ed25519-20270430' in created
        with open(DKIM_CONF) as f:
            assert 'efa-rsa-2027' not in f.read()
        assert 'efa-rsa-20270430._domainkey.r.example' in dkim_export(ns(domain='r.example', format='zone'))['text']
        status_row = [r for r in rotation_status(ns())['domains'] if r['domain'] == 'r.example'][0]
        assert status_row['next_rotation'] == '2027-04-30' and status_row['settings_from'] == 'default'
        # Not due yet, then due but not visible on all servers: no rotation, warning and mail.
        assert rotation_run(ns(notify='yes'))['rotated'] == [] and not mails
        assert merged({'links': {'enabled': True, 'base': 'https://mx1.example/l'}, 'cdr': False}, {'links': {'base': 'https://mx2.example/l'}}) ==             {'links': {'enabled': True, 'base': 'https://mx2.example/l'}, 'cdr': False}
        _write(tmp + '/helo_access', 'mx1.example REJECT own name\nmx1 REJECT\nmx10.example OK\n')
        assert own_names([tmp + '/helo_access', tmp + '/other'], 'mx1.example', 'mx2.example') == [tmp + '/helo_access']
        assert open(tmp + '/helo_access').read() == 'mx2.example REJECT own name\nmx2 REJECT\nmx10.example OK\n'
        assert own_names([tmp + '/helo_access'], 'mx2.example', 'mx2.example') == []
        day[0] = datetime.date(2027, 4, 30)
        pending_key = _rotation_pending('r.example', 'rsa')[0][1]
        record = f'"v=DKIM1; k=rsa; " "p={pending_key["public"][1]}"'
        _dns_txt = lambda resolver, name: [record] if resolver == '192.0.2.1' and 'r.example' in name else []
        result = rotation_run(ns(notify='yes'))
        assert not [r for r in result['rotated'] if 'r.example' in r] and mails
        assert any('2001:db8::1' in w and 'r.example' in w for w in result['warnings']) and _rotation_notices()
        # A second run on the same day warns again but does not mail again.
        count = len(mails)
        assert rotation_run(ns(notify='yes'))['warnings'] and len(mails) == count
        # A different value on one server is a warning, and one server is not enough.
        _dns_txt = lambda resolver, name: [record if resolver == '192.0.2.1' else '"v=DKIM1; p=other"'] if 'r.example' in name else []
        result = rotation_run(ns(notify='no'))
        assert not [r for r in result['rotated'] if 'r.example' in r] and any('different record' in w for w in result['warnings'])
        with open(ROTATION_LOG) as f:
            assert 'different record' in f.read()
        # Before its date a key never rotates, even if the record is visible.
        early = _rotation_pending('r.example', 'rsa')[1][1]
        assert early['selector'] not in str(rotation_run(ns(notify='no'))['rotated'])
        # Threshold 1 would rotate here; back to 2 for the next steps.
        assert _rotation_state()['threshold'] == 2
        with open(DKIM_CONF) as f:
            assert f'{RSA_SELECTOR}.key' in f.read()
        # A wrong key is no match, and a split TXT record is read correctly.
        assert not _dns_shows_key(['"v=DKIM1; k=rsa; p=other"'], 'mine') and _dns_shows_key(['"v=DKIM1; p=mi" "ne"'], 'mine')
        # Visible on two servers: rotates, the old key stops signing and stays in the export for the grace period.
        _dns_txt = lambda resolver, name: [record] if 'r.example' in name else []
        mails.clear()
        result = rotation_run(ns(notify='no'))
        assert 'r.example rsa efa-rsa-20270430' in result['rotated'] and not mails
        with open(DKIM_CONF) as f:
            conf = f.read()
        assert 'r.example.efa-rsa-20270430.key' in conf and f'r.example.{RSA_SELECTOR}.key' not in conf
        assert f'{RSA_SELECTOR}._domainkey.r.example' in dkim_export(ns(domain='r.example', format='zone'))['text']
        day[0] = datetime.date(2027, 5, 10)
        assert f'{RSA_SELECTOR}._domainkey.r.example' in [r['record'].split('.')[0] + '._domainkey.r.example'
                                                          for r in rotation_status(ns())['remove_from_dns']]
        assert f'{RSA_SELECTOR}._domainkey.r.example' not in dkim_export(ns(domain='r.example', format='zone'))['text']
        # An override wins and is marked, off keeps the keys, default follows the switch again.
        ready = len(_rotation_pending('e.example', 'ed25519'))
        assert rotation_set(ns(domain='e.example', type='ed25519', mode='off', interval='6', horizon='24', bits='2048',
                               next=''))['settings']['source'] == 'override'
        assert len(_rotation_pending('e.example', 'ed25519')) == ready
        rejected(lambda item: rotation_set(item), ns(domain='e.example', type='x', mode='on', interval='6', horizon='24',
                                                     bits='2048', next=''),
                 ns(domain='e.example', type='rsa', mode='on', interval='6', horizon='24', bits='2048', next='2020-01-01'))
        assert rotation_set(ns(domain='e.example', type='ed25519', mode='default', interval='', horizon='', bits='',
                               next=''))['settings']['source'] == 'default'
        rotation_all_set(ns(mode='off', interval='3', horizon='6', bits='2048'))
        assert len(_rotation_pending('e.example', 'ed25519')) >= ready
        rejected(lambda item: dkim_remove(item), ns(domain='e.example', selector='mine', confirm='no'),
                 ns(domain='e.example', selector='none', confirm='yes'))
        assert dkim_remove(ns(domain='e.example', selector='mine', confirm='yes'))['removed'] == 'mine'

        # ARC: DKIM RSA key by default, own key on request, Ed25519-only domains need an own key.
