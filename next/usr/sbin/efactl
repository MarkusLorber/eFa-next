        # Every form shows what is set now: a source for each field, or it is listed as a form for a new entry or one key.
        nav = _lib('efa_nav')
        for name, cmd in COMMANDS.items():
            fields = [arg['name'] for arg in cmd['args'] if not arg.get('secret') and arg.get('kind') != 'confirm' and arg['name'] != 'confirm']
            if not cmd['writes'] or not fields or name in nav.FORM_NEW or name in nav.FORM_KEYED:
                continue
            assert name in nav.FORM_SOURCE, f'{name}: a form without a source of its current values (efa_nav.FORM_SOURCE)'
            status, keys = nav.FORM_SOURCE[name]
            assert status in COMMANDS and not COMMANDS[status]['writes'] and not [arg for arg in COMMANDS[status]['args'] if arg.get('required')], (name, status)
            assert set(fields) <= set(keys) <= set(fields), (name, sorted(set(fields) ^ set(keys)))
        assert not (nav.FORM_NEW | nav.FORM_KEYED) & set(nav.FORM_SOURCE) and (nav.FORM_NEW | nav.FORM_KEYED) <= set(COMMANDS)
