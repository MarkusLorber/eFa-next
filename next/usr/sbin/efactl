def retention(kind):
    return int(_json_read(RETENTION_FILE, {}).get(kind, RETENTION_DEFAULTS[kind]))
ADMIN_SQL = '''CREATE TABLE IF NOT EXISTS efa.tenants (
  id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY, name VARCHAR(100) NOT NULL UNIQUE, created DATETIME NOT NULL DEFAULT NOW());
CREATE TABLE IF NOT EXISTS efa.tenant_domains (
  domain VARCHAR(253) PRIMARY KEY, tenant_id INT UNSIGNED NOT NULL, KEY tenant_id (tenant_id));
CREATE TABLE IF NOT EXISTS efa.users (
  username VARCHAR(100) PRIMARY KEY, role VARCHAR(16) NOT NULL, tenant_id INT UNSIGNED NULL, domain VARCHAR(253) NULL,
  password VARCHAR(200) NOT NULL DEFAULT '', source VARCHAR(16) NOT NULL DEFAULT 'local', created DATETIME NOT NULL DEFAULT NOW(),
  last_login DATETIME NULL, KEY tenant_id (tenant_id));
ALTER TABLE efa.users ADD COLUMN IF NOT EXISTS email VARCHAR(254) NULL;
ALTER TABLE efa.users ADD COLUMN IF NOT EXISTS prefs TEXT NULL;
CREATE TABLE IF NOT EXISTS efa.train_requests (
  id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY, ts DATETIME NOT NULL DEFAULT NOW(), username VARCHAR(100) NOT NULL, source VARCHAR(16) NOT NULL,
  ref VARCHAR(64) NOT NULL, sender VARCHAR(255) NOT NULL DEFAULT '', subject VARCHAR(500) NOT NULL DEFAULT '', verdict VARCHAR(8) NOT NULL,
  state VARCHAR(16) NOT NULL DEFAULT 'pending', decided_by VARCHAR(120) NULL, decided DATETIME NULL, result VARCHAR(255) NULL,
  KEY state (state), KEY username_ts (username, ts));
ALTER TABLE efa.train_requests ADD COLUMN IF NOT EXISTS features TEXT NULL;
ALTER TABLE efa.train_requests ADD COLUMN IF NOT EXISTS raw MEDIUMBLOB NULL;
GRANT INSERT ON efa.train_requests TO 'efa_log'@'localhost';
CREATE TABLE IF NOT EXISTS efa.quarantine_mail (
  id CHAR(32) PRIMARY KEY, ts DATETIME NOT NULL DEFAULT NOW(), qid VARCHAR(64), message_id VARCHAR(255), sender VARCHAR(255), subject VARCHAR(500),
  ip VARCHAR(64), score FLOAT, malware TINYINT NOT NULL DEFAULT 0, size BIGINT UNSIGNED NOT NULL DEFAULT 0, KEY ts (ts));
CREATE TABLE IF NOT EXISTS efa.quarantine_rcpt (
  id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY, mail_id CHAR(32) NOT NULL, rcpt VARCHAR(320) NOT NULL, state VARCHAR(12) NOT NULL DEFAULT 'held',
  changed DATETIME NULL, changed_by VARCHAR(120) NULL, digested TINYINT NOT NULL DEFAULT 0, KEY mail_id (mail_id), KEY rcpt (rcpt(191)), KEY state (state));
CREATE TABLE IF NOT EXISTS efa.quarantine_links (
  token_sha256 CHAR(64) PRIMARY KEY, purpose VARCHAR(12) NOT NULL, rcpt VARCHAR(320) NOT NULL, rcpt_id BIGINT UNSIGNED NULL, expires DATETIME NOT NULL, used DATETIME NULL, KEY expires (expires));
GRANT INSERT ON efa.quarantine_mail TO 'efa_log'@'localhost';
GRANT INSERT ON efa.quarantine_rcpt TO 'efa_log'@'localhost';
CREATE TABLE IF NOT EXISTS efa.group_roles (
  group_name VARCHAR(255) PRIMARY KEY, role VARCHAR(16) NOT NULL, tenant_id INT UNSIGNED NULL, domain VARCHAR(253) NULL);
CREATE TABLE IF NOT EXISTS efa.api_tokens (
  id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY, token_sha256 CHAR(64) NOT NULL UNIQUE, username VARCHAR(100) NOT NULL, label VARCHAR(100) NOT NULL,
  created DATETIME NOT NULL DEFAULT NOW(), expires DATETIME NOT NULL, last_used DATETIME NULL, KEY username (username));
CREATE TABLE IF NOT EXISTS efa.audit (
  id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY, ts DATETIME NOT NULL DEFAULT NOW(), actor VARCHAR(120) NOT NULL, client VARCHAR(64) NOT NULL DEFAULT '',
  tenant_id INT UNSIGNED NULL, command VARCHAR(64) NOT NULL, args TEXT, old_value MEDIUMTEXT, new_value MEDIUMTEXT, ok TINYINT NOT NULL,
  KEY ts (ts), KEY actor (actor), KEY tenant_id (tenant_id));
CREATE TABLE IF NOT EXISTS efa.efa_groups (
  id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY, name VARCHAR(100) NOT NULL UNIQUE, description VARCHAR(255) NOT NULL DEFAULT '', builtin VARCHAR(16) NULL UNIQUE,
  permissions TEXT, scope VARCHAR(8) NOT NULL DEFAULT 'member', scope_tenants TEXT, scope_domains TEXT, disabled TINYINT NOT NULL DEFAULT 0);
INSERT IGNORE INTO efa.efa_groups (name, builtin) VALUES ('super admin', 'super'), ('tenant admin', 'tenant'), ('domain admin', 'domain'),
  ('helpdesk', 'helpdesk'), ('user', 'user'), ('read-only', 'readonly'), ('auditor', 'auditor'), ('domain manager', 'manager');
CREATE TABLE IF NOT EXISTS efa.user_groups (
  username VARCHAR(100) NOT NULL, group_id INT UNSIGNED NOT NULL, tenant_id INT UNSIGNED NULL, domain VARCHAR(253) NULL,
  PRIMARY KEY (username, group_id), KEY group_id (group_id));
ALTER TABLE efa.users ADD COLUMN IF NOT EXISTS disabled TINYINT NOT NULL DEFAULT 0, ADD COLUMN IF NOT EXISTS groups_migrated TINYINT NOT NULL DEFAULT 0;
INSERT IGNORE INTO efa.user_groups (username, group_id, tenant_id, domain)
  SELECT u.username, g.id, u.tenant_id, NULLIF(u.domain, '') FROM efa.users u JOIN efa.efa_groups g ON g.builtin = u.role WHERE u.groups_migrated = 0;
UPDATE efa.users SET groups_migrated = 1 WHERE groups_migrated = 0;
ALTER TABLE efa.group_roles ADD COLUMN IF NOT EXISTS group_id INT UNSIGNED NULL;
UPDATE efa.group_roles r JOIN efa.efa_groups g ON g.builtin = r.role SET r.group_id = g.id WHERE r.group_id IS NULL;
CREATE TABLE IF NOT EXISTS efa.scoped_settings (
  level VARCHAR(8) NOT NULL, target VARCHAR(253) NOT NULL, name VARCHAR(32) NOT NULL, value VARCHAR(2000) NOT NULL,
  changed DATETIME NOT NULL DEFAULT NOW(), changed_by VARCHAR(120) NOT NULL DEFAULT '', PRIMARY KEY (level, target, name));
ALTER TABLE efa.tenants ADD COLUMN IF NOT EXISTS locked TINYINT NOT NULL DEFAULT 0, ADD COLUMN IF NOT EXISTS lock_mail VARCHAR(8) NOT NULL DEFAULT 'flow',
  ADD COLUMN IF NOT EXISTS brand_name VARCHAR(100) NULL, ADD COLUMN IF NOT EXISTS brand_color CHAR(7) NULL,
  ADD COLUMN IF NOT EXISTS limit_domains INT UNSIGNED NULL, ADD COLUMN IF NOT EXISTS limit_users INT UNSIGNED NULL,
  ADD COLUMN IF NOT EXISTS limit_mails_day INT UNSIGNED NULL, ADD COLUMN IF NOT EXISTS limit_quarantine_mb INT UNSIGNED NULL;
ALTER TABLE efa.api_tokens ADD COLUMN IF NOT EXISTS tenant_id INT UNSIGNED NULL;
ALTER TABLE efa.group_roles ADD COLUMN IF NOT EXISTS idp_tenant INT UNSIGNED NOT NULL DEFAULT 0;
ALTER TABLE efa.group_roles DROP PRIMARY KEY, ADD PRIMARY KEY (group_name, idp_tenant);
CREATE TABLE IF NOT EXISTS efa.domain_pending (
  domain VARCHAR(253) PRIMARY KEY, tenant_id INT UNSIGNED NOT NULL, token CHAR(32) NOT NULL, created DATETIME NOT NULL DEFAULT NOW(), created_by VARCHAR(120) NOT NULL DEFAULT '');
CREATE TABLE IF NOT EXISTS efa.tenant_alerts (
  tenant_id INT UNSIGNED NOT NULL, kind VARCHAR(16) NOT NULL, day DATE NOT NULL, level TINYINT NOT NULL, PRIMARY KEY (tenant_id, kind, day));
CREATE TABLE IF NOT EXISTS efa.web_sessions (
  sid_sha256 CHAR(64) PRIMARY KEY, username VARCHAR(100) NOT NULL DEFAULT '', client VARCHAR(64) NOT NULL DEFAULT '', agent VARCHAR(200) NOT NULL DEFAULT '',
  started DATETIME NOT NULL DEFAULT NOW(), last_seen DATETIME NOT NULL DEFAULT NOW(), ended DATETIME NULL, ended_by VARCHAR(120) NULL, KEY username (username));
