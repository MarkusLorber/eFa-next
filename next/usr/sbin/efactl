        # An unsigned or wrongly signed feed: the last good copy stays, nothing new triggers.
        class Reply:
            def __init__(self, data):
                self.data, self.headers = data, {'ETag': '"e"'}
            def read(self, size): return self.data[:size]
            def __enter__(self): return self
            def __exit__(self, *args): return False
        saved_feed = (urllib.request.urlopen, _lib)
        bad_feed = json.dumps({'advisories': feed}).encode()
        sign_stub = type('Sign', (), {'KEY_FILE': tmp + '/key', 'verify': staticmethod(lambda data, signature, key: signature == b'good')})
        open(tmp + '/key', 'wb').write(b'k')
        globals()['_lib'] = lambda name: sign_stub
        try:
            urllib.request.urlopen = lambda request, timeout: Reply(b'bad' if request.full_url.endswith('.sig') else bad_feed)
