        # Restore refuses paths out of the allowed folders, device files and links that leave them.
        class Member:
            def __init__(self, name, kind='file', link=''):
                self.name, self.linkname = name, link
                self.isreg = lambda: kind == 'file'
                self.isdir = lambda: kind == 'dir'
                self.issym = lambda: kind == 'sym'
                self.islnk = lambda: kind == 'hard'
        allowed_roots = ('etc/postfix',)
        good = [Member('etc/postfix/main.cf'), Member('backup.sql'), Member('etc/postfix/a', 'sym', '/usr/share/x'), Member('etc/postfix/b', 'hard', 'etc/postfix/main.cf')]
        assert _restore_unsafe(good, allowed_roots) is None
        for bad in ([Member('etc/postfix/../../root/x')], [Member('etc/postfix/x', 'dev')], [Member('/etc/postfix/x')], [Member('etc/postfix/a', 'hard', 'etc/shadow')],
                    [Member('etc/postfix/a', 'sym', '/root'), Member('etc/postfix/a/x')]):
            assert _restore_unsafe(bad, allowed_roots), bad[0].name
