            _lockdown_check([], {'lockdown': 'all'}, state)
            assert calls[-1] == (False, 'all') and 'locked' not in state
            state['released_for'] = ['CVE-2026-1 (nginx)']
            _lockdown_check(['CVE-2026-1 (nginx)'], {'lockdown': 'all'}, state)
            assert len(calls) == 2, 'no lock again after a release by hand for the same items'
            _lockdown_check(['CVE-2026-1 (nginx)', 'CVE-2026-9 (openssl)'], {'lockdown': 'all'}, state)
            assert len(calls) == 3, 'a new hole locks again'
