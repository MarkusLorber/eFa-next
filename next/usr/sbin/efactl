        assert user_change_problem('t', 't', {'a': None}, {'a': None}, False, 3) is None, 'a new password for the own login is fine'
        assert user_change_problem('t', 'x', {}, {}, True, 0) == 'This is the last active super admin.'
        assert user_change_problem(None, 'x', {}, {}, True, 1) is None
