        assert [row['locked'] for row in listed['networks'][:2]] == [True, True] and listed['networks'][-1]['family'] == 'IPv6'
        rejected(lambda item: relay_networks_apply(item), ns(confirm='no'))
        relay_networks_apply(ns(confirm='yes'))
        assert postfix['mynetworks'] == '127.0.0.0/8 [::1]/128 198.51.100.0/24 [2001:db8::]/32' and not relay_networks_list(ns())['pending']
        assert [row['description'] for row in relay_networks_list(ns())['networks']][-1] == 'Office'
        relay_networks_add(ns(networks='203.0.113.0/24', description=''))
        relay_networks_discard(ns())
        assert not relay_networks_list(ns())['added']
        # The old form value with its system entries and brackets keeps working.
        assert relay_networks_set(ns(networks='127.0.0.0/8 [::1]/128 192.0.2.0/24 [2001:db8::]/32'))['relay_networks'] == \
            ['127.0.0.0/8', '[::1]/128', '192.0.2.0/24', '[2001:db8::]/32']
        OUTBOUND_FILE = kept_outbound

        # Sender lists with comments and types.
        SENDER_MAPS = {'allow': tmp + '/allow.map', 'block': tmp + '/block.map'}
        SENDER_RULES, SENDER_META = tmp + '/rules.map', tmp + '/senders.json'
        added = sender_add(ns(list='allow', entries='a@example.org example.net\n192.0.2.1 *news*', comment='Partner'))
        assert added['added'] == ['a@example.org', 'example.net', '192.0.2.1', '*news*'] and not added['skipped']
        assert sender_add(ns(list='allow', entries='a@example.org', comment=''))['skipped'] == ['a@example.org']
        rejected(lambda item: sender_add(item), ns(list='x', entries='a@example.org', comment=''),
                 ns(list='allow', entries='a b|c', comment=''), ns(list='allow', entries='', comment=''),
                 ns(list='allow', entries='b@example.org', comment='x' * 201))
