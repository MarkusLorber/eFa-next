        # A real key and real signatures from openssl, so the check is tested against what a provider sends.
        key_file = tmp + '/oidc.key'
        subprocess.run(['openssl', 'genrsa', '-out', key_file, '2048'], check=True, capture_output=True)
        text = subprocess.run(['openssl', 'rsa', '-in', key_file, '-noout', '-modulus'], check=True, capture_output=True, text=True).stdout
        modulus = bytes.fromhex(text.split('=')[1].strip())
        encode = lambda data: base64.urlsafe_b64encode(data).rstrip(b'=').decode()
        keys = [{'kty': 'RSA', 'kid': 'k1', 'n': encode(modulus), 'e': encode(b'\x01\x00\x01')}]
        def signed(header=None, **claims):
            body = {'iss': 'https://idp.example', 'aud': 'app', 'exp': 2000, 'nonce': 'n1', 'preferred_username': 'anna', **claims}
            start = encode(json.dumps(header or {'alg': 'RS256', 'kid': 'k1'}).encode()) + '.' + encode(json.dumps(body).encode())
            signature = subprocess.run(['openssl', 'dgst', '-sha256', '-sign', key_file], input=start.encode(), check=True, capture_output=True).stdout
            return start + '.' + encode(signature)
        good = signed()
        assert verify_id_token(good, keys, 'https://idp.example', 'app', 'n1', 1000)['preferred_username'] == 'anna'
        assert verify_id_token(signed(aud=['x', 'app']), keys, 'https://idp.example', 'app', 'n1', 1000)
        first, middle, last = good.split('.')
        forged = first + '.' + encode(json.dumps({'iss': 'https://idp.example', 'aud': 'app', 'exp': 2000, 'nonce': 'n1', 'preferred_username': 'root'}).encode()) + '.' + last
        unsigned = encode(b'{"alg":"none"}') + '.' + middle + '.'
        other = [{**keys[0], 'n': encode(bytes([modulus[0] ^ 1]) + modulus[1:])}]
        for bad_token, bad_keys, nonce, now in ((forged, keys, 'n1', 1000), (unsigned, keys, 'n1', 1000), (good, other, 'n1', 1000), (good, keys, 'n2', 1000),
                                                (good, keys, '', 1000), (good, keys, 'n1', 5000), (signed(iss='https://evil.example'), keys, 'n1', 1000),
                                                (signed(aud='other'), keys, 'n1', 1000), (signed({'alg': 'HS256', 'kid': 'k1'}), keys, 'n1', 1000), ('junk', keys, 'n1', 1000)):
            try:
                verify_id_token(bad_token, bad_keys, 'https://idp.example', 'app', nonce, now)
                raise AssertionError(bad_token[:40])
            except EfaError:
                pass
