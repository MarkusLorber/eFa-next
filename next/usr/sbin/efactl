        assert arc_trusted_set(ns(action='add', domain='google.com'))['trusted_sealers'] == ['google.com', 'microsoft.com']
        with open(ARC_CONF) as f:
            assert 'whitelisted_signers_map = ["google.com", "microsoft.com"];' in f.read()
        rejected(arc_trusted_set, ns(action='remove', domain='yahoo.com'), ns(action='add', domain='a b'), ns(action='x', domain='a.org'))
        arc_trusted_set(ns(action='remove', domain='google.com'))
        assert arc_trusted_set(ns(action='remove', domain='microsoft.com'))['trusted_sealers'] == [] and arc_show(ns())['trusted_sealers'] == []

        # DMARC record generator after RFC 9989.
        # Never the EU state and setup variant of the host that runs the test (a host set up guided with EU link refuses more).
        saved_eu, saved_variant = EU_FILE, SETUP_VARIANT_FILE
        globals().update(EU_FILE=tmp + '/eu.json', SETUP_VARIANT_FILE=tmp + '/setup-variant-dmarc.json')
