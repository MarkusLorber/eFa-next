        acc_sql, acc_noted, acc_sent, acc_given = [], [], [], []

        def acc_query(sql, params=()):
            acc_sql.append((sql, params))
            if sql.startswith(('SELECT password, source FROM users', 'SELECT email, email_pending', 'SELECT source FROM users')):
                return [dict(acc_db[params[0]])] if params[0] in acc_db else []
            if sql.startswith('UPDATE users SET email_pending'):
                acc_db[params[1]]['email_pending'] = params[0]
            elif sql.startswith('UPDATE users SET email = email_pending'):
                acc_db[params[0]].update(email=acc_db[params[0]]['email_pending'], email_pending=None)
            elif sql.startswith('UPDATE users SET full_name'):
                acc_db[params[2]].update(full_name=params[0], phone=params[1])
            elif sql.startswith('UPDATE users SET password'):
                acc_db[params[1]]['password'] = params[0]
            return []

        def acc_refused(call, text=REAUTH_FAILED):
            try:
                call()
            except EfaError as err:
                assert text in str(err), err
                return
            raise AssertionError('not refused')
        globals().update(_admin_query=acc_query, _audit=acc_noted.append, _secrets=lambda count, prompt: [acc_given.pop(0) for _ in range(count)],
