        # C2: signed backups; the restore checks signature, signer and every file.
        from cryptography.hazmat.primitives.asymmetric import ed25519
        own, foreign = ed25519.Ed25519PrivateKey.generate(), ed25519.Ed25519PrivateKey.generate()
        folder = tempfile.mkdtemp()
        os.makedirs(folder + '/conf/sub')
        with open(folder + '/conf/a.cf', 'w') as f:
            f.write('a = 1\n')
        with open(folder + '/conf/sub/b.map', 'w') as f:
            f.write('b OK\n')

        def signed_archive(key, change=None, unsigned=False):
            files, out = {}, io.BytesIO()
            with tarfile.open(fileobj=out, mode='w:gz') as tar:
                _tar_add_hashed(tar, folder + '/conf', files, 'conf')
                if change:
                    data = change.encode()
                    info = tarfile.TarInfo('conf/extra')
                    info.size = len(data)
                    tar.addfile(info, io.BytesIO(data))
                if not unsigned:
                    manifest = json.dumps(backup_manifest(files, key, 'mx1.example')).encode()
                    info = tarfile.TarInfo(BACKUP_MANIFEST)
                    info.size = len(manifest)
                    tar.addfile(info, io.BytesIO(manifest))
            out.seek(0)
            return tarfile.open(fileobj=out)
        own_raw = _raw_public(own.public_key())
        assert backup_manifest_check(signed_archive(own), own_raw) is None
        assert sorted(json.loads(signed_archive(own).extractfile(BACKUP_MANIFEST).read())['files']) == ['conf/a.cf', 'conf/sub/b.map']
        assert backup_manifest_check(signed_archive(own, change='x'), own_raw) == 'conf/extra is not in the signed list'
        assert backup_manifest_check(signed_archive(own, unsigned=True), own_raw) == 'unsigned'
        problem = backup_manifest_check(signed_archive(foreign), own_raw)
        fingerprint = key_fingerprint(_raw_public(foreign.public_key()))
        assert problem.startswith('signed by another host (mx1.example)') and fingerprint in problem and len(fingerprint) == 39
        assert backup_manifest_check(signed_archive(foreign), own_raw, fingerprint.lower().replace(' ', '')) is None
        bad = signed_archive(own)
        manifest = json.loads(bad.extractfile(BACKUP_MANIFEST).read())
        manifest['files']['conf/a.cf'] = '0' * 64
        out = io.BytesIO()
        with tarfile.open(fileobj=out, mode='w:gz') as tar:
            for member in bad.getmembers():
                if member.name == BACKUP_MANIFEST:
                    data = json.dumps(manifest).encode()
                    member.size = len(data)
                    tar.addfile(member, io.BytesIO(data))
                else:
                    tar.addfile(member, bad.extractfile(member) if member.isreg() else None)
        out.seek(0)
        assert backup_manifest_check(tarfile.open(fileobj=out), own_raw) == 'the signature of this backup is not valid'
        shutil.rmtree(folder)
