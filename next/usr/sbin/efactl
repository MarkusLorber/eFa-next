    class ClonePlatform:
        def restore_context(self, path): pass
        def service_restart(self, name, check=True): restarted.append(name)
        def service_try_restart(self, name): restarted.append(name)
        def service_reload_if_active(self, name): restarted.append(name)
        def service_is_active(self, name): return True

    def clone_run(cmd, **kwargs):
        ran.append(cmd[0])
        if cmd[0] == 'ssh-keygen':
            with open(root + '/ssh/ssh_host_ed25519_key', 'w') as f:
                f.write('new')
        if cmd[0] == 'systemd-machine-id-setup':
            with open(root + '/machine-id', 'w') as f:
                f.write('bbb\n')
        if cmd[0] == 'grubby':
            # grubby names the running kernel as the default, unless the test says the boot entries lost it.
            kernel = f"{root}/boot/vmlinuz-{grubby_default[0]}"
            return subprocess.CompletedProcess(cmd, 0, kernel if cmd[1] == '--default-kernel' else f'kernel="{kernel}"\n', '')
        return subprocess.CompletedProcess(cmd, 0, '', '')
