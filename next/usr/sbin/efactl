            assert ('run', ('postconf', '-P', 'submission/inet/smtpd_sasl_path=/run/efa-sasl/auth'), {}) in done_calls
            done_calls.clear()
            _sasl_apply(True, pam_on=True)
            assert ('run', ('postconf', '-PX', 'submission/inet/smtpd_sasl_path'), {}) in done_calls, 'Dovecot: the socket of Postfix again'
