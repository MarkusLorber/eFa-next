def _symbol_texts(fetch=None):
    """rspamd's own description of each symbol, cached for a day. Without rspamd only the names are shown."""
    cached = _json_read(SYMBOL_CACHE, None)
    if cached and time.time() - cached.get('fetched', 0) < 86400:
        return cached['texts']
    try:
        groups = fetch() if fetch else json.loads(urllib.request.urlopen(SYMBOL_URL, timeout=5).read())
        texts = {rule['symbol']: rule.get('description') or '' for group in groups for rule in group.get('rules', [])}
    except (OSError, ValueError, KeyError, TypeError):
        return (cached or {}).get('texts', {})
    try:
        _json_write(SYMBOL_CACHE, {'fetched': time.time(), 'texts': texts})
    except OSError:
        pass
    return texts


# 9n: own scores of rspamd symbols, kept by eFa-next (rights, audit, cluster) instead of the rspamd web interface.
SYMBOL_SCORES_FILE = ETC + '/eFa/symbol-scores.json'
SYMBOL_GROUPS_CONF = RSPAMD_DIR + '/local.d/groups.conf'
SYMBOL_NAME_RE = re.compile(r'^[A-Z0-9_]{2,64}$')
SYMBOL_SCORE_RANGE = (-50.0, 50.0)


def _symbol_groups(fetch=None):
    """The symbols rspamd knows now: {symbol: (group, weight, description)}."""
    groups = fetch() if fetch else json.loads(urllib.request.urlopen(SYMBOL_URL, timeout=10).read())
    return {rule['symbol']: (group.get('group', ''), rule.get('weight', 0), rule.get('description') or '') for group in groups for rule in group.get('rules', [])}


def symbol_groups_conf(overrides):
    """local.d/groups.conf of the own scores: per group of rspamd, each symbol with its weight. Merged into rspamd's groups."""
    by_group = {}
    for symbol, item in sorted(overrides.items()):
        by_group.setdefault(item['group'], []).append((symbol, item['score']))
    lines = ['# Written by eFa-next (efactl symbol-score-set). Changes here are overwritten.']
    for group, items in sorted(by_group.items()):
        lines.append(f'group "{group}" {{\n  symbols {{')
        lines += [f'    "{symbol}" {{ weight = {score:g}; }}' for symbol, score in items]
        lines.append('  }\n}')
    return '\n'.join(lines) + '\n'


def symbol_scores(args):
    """The symbols of rspamd with the score that counts now and the own ones; filtered by part of a name or description."""
    wanted = (getattr(args, 'filter', '') or '').strip().lower()
    overrides = _json_read(SYMBOL_SCORES_FILE, {})
    try:
        known = _symbol_groups()
    except (OSError, ValueError, KeyError, TypeError) as err:
        raise EfaError(f'rspamd does not answer: {err}')
    rows = [{'symbol': symbol, 'group': group, 'score': weight, 'own': overrides.get(symbol, {}).get('score'), 'description': text}
            for symbol, (group, weight, text) in sorted(known.items())
            if not wanted or wanted in symbol.lower() or wanted in text.lower()]
    return {'symbols': rows[:300], 'shown': min(len(rows), 300), 'found': len(rows), 'own_scores': len(overrides)}


def symbol_score_set(args):
    """An own score for one symbol, or back to the score of rspamd (--reset on). Checked by rspamd before it loads."""
    symbol = (args.symbol or '').strip().upper()
    if not SYMBOL_NAME_RE.match(symbol):
        raise EfaError('Symbol: the name as rspamd shows it, such as FORGED_SENDER.')
    overrides = _json_read(SYMBOL_SCORES_FILE, {})
    if (args.reset or '').strip() in ('yes', 'on'):
        if symbol not in overrides:
            raise EfaError(f'{symbol} has no own score.')
        before = overrides.pop(symbol)
    else:
        try:
            score = float((args.score or '').strip().replace(',', '.'))
        except ValueError:
            raise EfaError('Score: a number, such as 2.5 or -1.')
        if not SYMBOL_SCORE_RANGE[0] <= score <= SYMBOL_SCORE_RANGE[1]:
            raise EfaError(f'Score: from {SYMBOL_SCORE_RANGE[0]:g} to {SYMBOL_SCORE_RANGE[1]:g}.')
        try:
            known = _symbol_groups()
        except (OSError, ValueError, KeyError, TypeError) as err:
            raise EfaError(f'rspamd does not answer, nothing was changed: {err}')
        if symbol not in known:
            raise EfaError(f'rspamd does not know the symbol {symbol}.')
        before = overrides.get(symbol)
        overrides[symbol] = {'group': known[symbol][0], 'score': score, 'default': known[symbol][1]}
    old_conf = open(SYMBOL_GROUPS_CONF).read() if os.path.exists(SYMBOL_GROUPS_CONF) else None
    _write(SYMBOL_GROUPS_CONF, symbol_groups_conf(overrides))
    done = subprocess.run(['rspamadm', 'configtest'], capture_output=True, text=True, timeout=120)
    if done.returncode != 0:
        if old_conf is None:
            os.remove(SYMBOL_GROUPS_CONF)
        else:
            _write(SYMBOL_GROUPS_CONF, old_conf)
        raise EfaError(f'rspamd does not take it, nothing was changed: {(done.stdout + done.stderr)[-200:]}')
    _json_write(SYMBOL_SCORES_FILE, overrides)
    _reload_rspamd()
    _audit(f"symbol score {symbol}: {before['score'] if before else 'rspamd'} -> {overrides[symbol]['score'] if symbol in overrides else 'rspamd'} by {_dmarc_who()}")
    return {'symbol': symbol, 'score': overrides.get(symbol, {}).get('score', 'rspamd default'), 'own_scores': len(overrides)}


# 9n: "Check a mail": one uploaded mail through rspamd, only to show its verdict. Nothing is learned or kept; rspamd gets the
# flags no_log and no_stat. The mail comes base64 on stdin, never as an argument.
MAIL_CHECK_MAX = 10 * 1024 * 1024
MAIL_CHECK_URL = 'http://127.0.0.1:11333/checkv2'


def mail_check_domains(raw):
    """The domains of the senders and recipients named in the head of a mail."""
    head = email.message_from_bytes(raw.split(b'\r\n\r\n', 1)[0].split(b'\n\n', 1)[0] + b'\n\n', policy=email.policy.default)
    found = set()
    for name in ('From', 'Sender', 'To', 'Cc', 'Delivered-To'):
        for _real, address in email.utils.getaddresses([str(value) for value in head.get_all(name, [])]):
            if '@' in address:
                found.add(address.rpartition('@')[2].lower())
    return found


def mail_check(_args):
    """Scan one mail with rspamd and show the action, the score and each symbol with its meaning."""
    import base64 as b64
    data = sys.stdin.readline().strip()
    try:
        raw = b64.b64decode(data, validate=True)
    except ValueError:
        raise EfaError('Give the mail as an .eml file.')
    if not raw or len(raw) > MAIL_CHECK_MAX:
        raise EfaError(f'A mail of up to {MAIL_CHECK_MAX // 1024 // 1024} MB.')
    if identity_now and identity_now['domains'] is not None:
        # A domain admin checks only mail of the own domains.
        if not mail_check_domains(raw) & set(identity_now['domains']):
            raise EfaError('Not allowed: the mail names none of your domains.')
    request = urllib.request.Request(MAIL_CHECK_URL, data=raw, method='POST', headers={'Flags': 'no_log,no_stat', 'Content-Type': 'message/rfc822'})
    try:
        with urllib.request.urlopen(request, timeout=60) as answer:
            result = json.loads(answer.read())
    except (OSError, ValueError) as err:
        raise EfaError(f'rspamd does not answer: {err}')
    texts = _symbol_texts()
    symbols = sorted(result.get('symbols', {}).values(), key=lambda item: -abs(item.get('score', 0)))
    _audit(f"mail-check by {_dmarc_who()}: {result.get('action')} {result.get('score', 0):.2f} ({len(raw)} bytes)")
    return {'action': result.get('action'), 'score': round(result.get('score', 0), 2), 'required_score': result.get('required_score'),
            'symbols': [{'symbol': item['name'], 'score': round(item.get('score', 0), 2), 'text': texts.get(item['name']) or '',
                         'text_de': SYMBOL_DE.get(item['name'], ''), 'options': ', '.join(item.get('options', []))[:200]} for item in symbols]}


def mail_verdict(symbols, texts):
    """Why a mail got its score: each symbol with its score and one sentence, in English and German where known."""
    try:
        pairs = json.loads(symbols or '[]')
    except ValueError:
        return []
    return [{'symbol': name, 'score': score, 'text': texts.get(name) or '', 'text_de': SYMBOL_DE.get(name, '')} for name, score in pairs]


def _verdict_by_qid(qid):
    if not qid:
        return []
    db = _maillog_db()
    try:
        with db.cursor() as cur:
            cur.execute('SELECT symbols FROM maillog WHERE qid = %s ORDER BY id DESC LIMIT 1', (qid,))
            row = cur.fetchone()
    finally:
        db.close()
    return mail_verdict(row['symbols'], _symbol_texts()) if row else []


def mail_show(args):
    """One mail of the log with its stored headers: raw, the path over the servers, the checks. The content of delivered mail is not stored."""
    mail_id = (args.id or '').strip()
    if not mail_id.isdigit():
        raise EfaError('Mail: its number in the log.')
    db = _maillog_db()
    try:
        with db.cursor() as cur:
            cur.execute('SELECT id, CAST(ts AS CHAR) AS ts, qid, message_id, sender, rcpt, ip, action, score, subject, spf, dkim, dmarc, arc, '
                        'header_from, reply_to, return_path, x_mailer, symbols FROM maillog WHERE id = %s', (int(mail_id),))
            mail = cur.fetchone()
    finally:
        db.close()
    if not mail or (identity_now and identity_now['domains'] is not None and not in_scope(identity_now, [mail['rcpt'] or '', mail['sender'] or ''])):
        raise EfaError('No such mail.')
    mail = local_times(subject_filter(identity_now, 'message-search', {'mails': [mail]}, subjects_shown())['mails'], _reader_timezone())[0]
    rows = _admin_query('SELECT raw_size, truncated, data FROM mail_headers WHERE maillog_id = %s', (int(mail_id),))
    raw = zlib.decompress(rows[0]['data']).decode('utf-8', 'replace') if rows else None
    if (args.format or '').strip() == 'raw':
        if identity_now and 'export' not in identity_now['grants']:
            raise EfaError('Not allowed: the download needs the permission export.')
        if raw is None:
            raise EfaError('No headers stored for this mail.')
        key = mail['qid'] if re.fullmatch(r'[A-Za-z0-9]{5,20}', mail['qid'] or '') else hashlib.sha256((mail['message_id'] or mail_id).encode()).hexdigest()[:16]
        return {'raw': raw, 'filename': f"{mail['ts'][:10]}_{key}.headers.txt"}
    proof = _admin_query('SELECT data FROM mail_evidence WHERE maillog_id = %s', (int(mail_id),))
    evidence = json.loads(zlib.decompress(proof[0]['data'])) if proof else None
    if evidence:
        keys = sorted({check['record'] for check in evidence['checks']})
        found = {row['sha256']: json.loads(zlib.decompress(row['data'])) for row in
                 (_admin_query('SELECT sha256, data FROM dns_records WHERE sha256 IN (' + ','.join(['%s'] * len(keys)) + ')', keys) if keys else [])}
        for check in evidence['checks']:
            check['answers'] = found.get(check['record'], [])
    if (args.format or '').strip() == 'evidence':
        if identity_now and 'export' not in identity_now['grants']:
            raise EfaError('Not allowed: the download needs the permission export.')
        if not evidence:
            raise EfaError('No DNS evidence stored for this mail.')
        return {'evidence': evidence, 'filename': f"{mail['ts'][:10]}_{mail_id}.evidence.json"}
    headers = headers_parse(raw or '')
    verdict = mail_verdict(mail.pop('symbols', None), _symbol_texts())
    return {'mail': mail, 'verdict': verdict, 'headers': raw, 'evidence': evidence, 'headers_note': 'No headers stored for this mail.' if raw is None else
            (f"Cut at {HEADERS_MAX // 1024} KB of {rows[0]['raw_size']} bytes." if rows[0]['truncated'] else ''),
            'received': received_path(headers), 'checks': [{'name': name, 'value': value} for name, value in headers if name.lower() in AUTH_HEADERS],
            'spam': [{'name': name, 'value': value} for name, value in headers if name.lower().startswith(('x-spam', 'x-rspamd'))],
            'content': 'Content not stored: eFa-next stores the content only of mail in quarantine.'}


# Web exports: readable by the web interface that hands them out, deleted after a day.
EXPORT_DIR = '/var/lib/efa-exports'
EXPORT_LIMIT = 50000
EXPORT_NOW = 5000
EXPORT_HOURS = 24
SEARCH_FILTERS = ('sender', 'rcpt', 'subject', 'ip', 'qid', 'action', 'date_from', 'date_to', 'message_id', 'header_from', 'reply_to', 'return_path', 'x_mailer')


def export_name(ts, qid, message_id, mail_id):
    """A file name from the time and the queue ID, never from text a sender chose beyond plain characters."""
    key = qid if re.fullmatch(r'[A-Za-z0-9]{5,20}', qid or '') else hashlib.sha256((message_id or str(mail_id)).encode()).hexdigest()[:16]
    return f"{re.sub(r'[^0-9]', '', str(ts))[:14]}_{key}"


def headers_zip(path, rows, fetch_headers, fetch_evidence, with_subject):
    """One file per mail and index.csv, written mail by mail: the mails are never all in memory."""
    index = [['file', 'time', 'from', 'to', 'subject', 'result', 'queue_id', 'message_id']]
    seen = set()
    with zipfile.ZipFile(path, 'w', zipfile.ZIP_DEFLATED) as archive:
        for row in rows:
            raw = fetch_headers(row['id'])
            if raw is None:
                continue
            name = export_name(row['ts'], row['qid'], row['message_id'], row['id'])
            while name in seen:
                name += '_'
            seen.add(name)
            archive.writestr(f'{name}.headers.txt', raw)
            evidence = fetch_evidence(row['id']) if fetch_evidence else None
            if evidence is not None:
                archive.writestr(f'{name}.evidence.json', json.dumps(evidence, indent=1))
            index.append([f'{name}.headers.txt', row['ts'], row['sender'], row['rcpt'], row['subject'] if with_subject else '', row['action'], row['qid'], row['message_id']])
        archive.writestr('index.csv', csv_safe_text(index))
    return len(index) - 1


def _stored_headers(mail_id):
    rows = _admin_query('SELECT data FROM mail_headers WHERE maillog_id = %s', (mail_id,))
    return zlib.decompress(rows[0]['data']) if rows else None


def _stored_evidence(mail_id):
    return mail_show(argparse.Namespace(id=str(mail_id), format=''))['evidence']


def headers_export(args):
    """The stored headers of the mails a search finds, as a ZIP with one file per mail and index.csv, optionally with the DNS evidence."""
    if identity_now and 'export' not in identity_now['grants']:
        raise EfaError('Not allowed: the export needs the permission export.')
    filters = {key: getattr(args, key, '') or '' for key in SEARCH_FILTERS}
    readable = pseudo_days() and (identity_now is None or 'mail.view_headers' in identity_now['grants'])
    where, params = search_where(filters, identity_now['domains'] if identity_now else None, _pseudo_key() if readable else None)
    joined = (where + ' AND ' if where else 'WHERE ') + 'EXISTS (SELECT 1 FROM mail_headers h WHERE h.maillog_id = maillog.id)'
    job = (args.job or '').strip()
    if job and os.environ.get('EFA_EXPORT_JOB') != job:
        # Only the background run started here names its job: nobody can aim an export at the file of another.
        raise EfaError('Invalid job.')
    db = _maillog_db()
    try:
        with db.cursor() as cur:
            cur.execute(f'SELECT COUNT(*) AS n FROM maillog {joined}', params)
            count = int(cur.fetchone()['n'])
            if count > EXPORT_LIMIT:
                raise EfaError(f'{count} mails: at most {EXPORT_LIMIT} per export. Narrow the search, for example by date.')
            if count > EXPORT_NOW and not job:
                token = secrets.token_hex(16)
                command = ['systemd-run', '--unit', f'efa-export-{token[:8]}', '--collect', f'--setenv=EFA_EXPORT_JOB={token}', '/usr/sbin/efactl', '--client', acting_client,
                           *(['--as', identity_now['username']] if identity_now else []), 'headers-export', f'--job={token}',
                           f"--evidence={(args.evidence or '').strip()}", *[f'--{key}={value}' for key, value in filters.items() if value]]
                subprocess.run(command, check=True, capture_output=True)
                return {'count': count, 'state': 'running', 'job': token, 'note': 'The download link works once the export is done, for 24 hours.'}
            cur.execute(f'SELECT id, CAST(ts AS CHAR) AS ts, qid, message_id, sender, rcpt, subject, action FROM maillog {joined} ORDER BY ts, id', params)
            rows = cur.fetchall()
    finally:
        db.close()
    rows = scoped_result(identity_now, 'message-search', {'mails': rows})['mails']
    with_subject = subjects_shown() and (identity_now is None or 'mail.view_subject' in identity_now['grants'])
    out = (args.out or '').strip() if not identity_now else ''
    token = job or secrets.token_hex(16)
    if not re.fullmatch(r'[0-9a-f]{32}', token):
        raise EfaError('Invalid job.')
    if out:
        target = os.path.realpath(out)
        if not target.startswith('/var/lib/eFa/exports/') or not target.endswith('.zip'):
            raise EfaError('Write the ZIP to /var/lib/eFa/exports/<name>.zip.')
        os.makedirs('/var/lib/eFa/exports', mode=0o700, exist_ok=True)
    else:
        os.makedirs(EXPORT_DIR, mode=0o750, exist_ok=True)
        shutil.chown(EXPORT_DIR, 'root', 'efa-web')
        target = f'{EXPORT_DIR}/{token}.zip'
    fd = os.open(target + '.tmp', os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    os.close(fd)
    written = headers_zip(target + '.tmp', rows, _stored_headers, _stored_evidence if (args.evidence or '').strip() == 'yes' else None, with_subject)
    if not out:
        os.chmod(target + '.tmp', 0o640)
        shutil.chown(target + '.tmp', 'root', 'efa-web')
        _json_write(f'{EXPORT_DIR}/{token}.json', {'user': identity_now['username'] if identity_now else '', 'count': written, 'created': time.time()})
        os.chmod(f'{EXPORT_DIR}/{token}.json', 0o640)
        shutil.chown(f'{EXPORT_DIR}/{token}.json', 'root', 'efa-web')
    os.replace(target + '.tmp', target)
    return {'count': written, 'state': 'done', **({'file': target} if out else {'job': token})}


def _exports_job():
    """Hourly: web exports older than a day go."""
    for path in glob.glob(EXPORT_DIR + '/*'):
        if os.path.getmtime(path) < time.time() - EXPORT_HOURS * 3600:
            os.remove(path)


def _layer_rows():
    rows = {}
    try:
        found = _admin_query('SELECT level, target, name, value FROM scoped_settings')
    except Exception as err:  # pymysql errors have no common base here
        if getattr(err, 'args', (None,))[0] == 1146:
            return rows  # before the upgrade made the table: nothing set yet
        raise
    for row in found:
        rows.setdefault((row['level'], row['target']), {})[row['name']] = row['value']
    return rows


def _layer_defaults():
    actions, quarantine = _actions(), uq_state()
    return {'spam_mark': actions.get('rewrite_subject', ''), 'spam_reject': actions.get('reject', ''), 'quarantine_days': str(quarantine['days']),
            'digest_hour': '0', 'digest_text': '', 'tls': _postconf('smtp_tls_security_level') or 'may', 'language': 'en',
            'headers_store': 'on' if headers_policy()['store'] else 'off', 'headers_days': str(headers_policy()['days'])}


def _layer_target(args):
    """('domain', name, tenant id) or ('tenant', id, id). A limited scope reaches only its own domains and tenants."""
    domain, tenant = (getattr(args, 'domain', '') or '').strip().lower(), (getattr(args, 'tenant', '') or '').strip()
    if bool(domain) == bool(tenant):
        raise EfaError('Name either a domain or a tenant.')
    tenant_domains = _tenant_domains()
    if domain:
        if not DOMAIN_RE.match(domain):
            raise EfaError('Invalid domain.')
        if identity_now and identity_now['domains'] is not None and domain not in identity_now['domains']:
            raise EfaError('Not allowed: name one of your own domains.')
        return 'domain', domain, next((tid for tid, domains in tenant_domains.items() if domain in domains), None)
    tenant_id = _tenant_id(tenant)
    if identity_now and identity_now['tenant_ids'] is not None and tenant_id not in identity_now['tenant_ids']:
        raise EfaError('Not allowed: this tenant is outside your scope.')
    return 'tenant', str(tenant_id), tenant_id


def domain_settings_show(args):
    """The settings of a domain or a tenant, each with where it comes from: domain, tenant or global."""
    level, target, tenant_id = _layer_target(args)
    values = layer_effective(target if level == 'domain' else None, tenant_id, _layer_rows(), _layer_defaults())
    return {level: args.domain.strip().lower() if level == 'domain' else args.tenant.strip(),
            'settings': [{'name': name, 'value': value, 'source': source, 'permission': LAYER_SETTINGS[name]} for name, (value, source) in values.items()],
            **({'mail_server': next((line.split(None, 1)[1] for line in _read_lines(TRANSPORT) if line.split()[:1] == [target]), 'global route')}
               if level == 'domain' else {})}


def _layers_apply():
    """Spam limits as rspamd rules, TLS as a Postfix map. Retention and digest are read by the hourly job."""
    _rules_apply()
    rows = _layer_rows()
    lines = layer_tls_lines(rows, _tenant_domains()) if rows else []
    if lines != _read_lines(TLS_POLICY):
        _rule_map(TLS_POLICY, lines)
        wanted = rule_map_value(_postconf('smtp_tls_policy_maps'), TLS_POLICY, bool(lines))
        if wanted != _postconf('smtp_tls_policy_maps'):
            _postconf_set('smtp_tls_policy_maps', wanted)
        subprocess.run(['systemctl', 'reload', 'postfix'], check=False, capture_output=True)


def _layer_set(args, names):
    """Each given value is set; 'inherit' takes the own value away, so the tenant or global one counts again."""
    level, target, _tenant = _layer_target(args)
    changed = False
    for name in names:
        value = getattr(args, name, '') or ''
        if not value.strip():
            continue
        if value.strip() == 'inherit':
            _admin_query('DELETE FROM scoped_settings WHERE level = %s AND target = %s AND name = %s', (level, target, name))
        else:
            _admin_query('REPLACE INTO scoped_settings (level, target, name, value, changed_by) VALUES (%s, %s, %s, %s, %s)',
                         (level, target, name, layer_value(name, value), _dmarc_who()[:120]))
        changed = True
    if not changed:
        raise EfaError("Give at least one value, or 'inherit' to take the value of the tenant or global again.")
    _layers_apply()
    return domain_settings_show(args)


def domain_spam_set(args):
    """Spam limits of a domain or tenant: mark as spam, reject. Below the rules of the admins."""
    return _layer_set(args, ('spam_mark', 'spam_reject'))


def domain_quarantine_set(args):
    """How long held mail stays, and when and with which text the digest goes out."""
    return _layer_set(args, ('quarantine_days', 'digest_hour', 'digest_text'))


def domain_routing_set(args):
    """TLS for mail to the domain. The mail server of a domain is set with transport-set."""
    return _layer_set(args, ('tls',))


def domain_general_set(args):
    """The language of digests and pages for the domain, and whether and how long the headers of its mail are kept."""
    return _layer_set(args, ('language', 'headers_store', 'headers_days'))


def _rules_apply():
    """Writes the rules to rspamd and Postfix if they changed. A config rspamd rejects is taken back."""
    layer_rows = _layer_rows()
    rules = _rules() + (layer_spam_rules(layer_rows, _tenant_domains()) if layer_rows else []) + user_spam_rules(user_spam_state()) + role_spam_rules()
    text = rule_settings_text(rules, _rule_tenant_domains, _rule_group_members)
    previous = open(RULES_SETTINGS).read() if os.path.exists(RULES_SETTINGS) else ''
    if previous and not previous.startswith(RULES_MARK):
        raise EfaError(f'{RULES_SETTINGS} was not written by eFa-next, nothing changed.')
    if text != previous:
        if text:
            _write(RULES_SETTINGS, text)
        elif previous:
            os.remove(RULES_SETTINGS)
        if not _rspamd_config_ok():
            if previous:
                _write(RULES_SETTINGS, previous)
            elif os.path.exists(RULES_SETTINGS):
                os.remove(RULES_SETTINGS)
            raise EfaError('rspamd rejected the rules, nothing changed.')
        subprocess.run(['systemctl', 'try-reload-or-restart', 'rspamd'], check=False, capture_output=True)
    notify_write(_rules())
    to_recipient, to_sender = rule_route_lines(rules, _rule_tenant_domains, _rule_group_members)
    held = _admin_query("SELECT d.domain FROM tenant_domains d JOIN tenants t ON t.id = d.tenant_id WHERE t.locked = 1 AND t.lock_mail = 'defer' ORDER BY d.domain") \
        if os.path.exists(RULES_FILE) or layer_rows or _admin_query("SELECT 1 FROM tenants WHERE locked = 1 LIMIT 1") else []
    if held:
        # A locked tenant whose mail waits: its domains first, with no other route for them.
        gone = {row['domain'] for row in held}
        to_recipient = tenant_hold_lines(held) + [line for line in to_recipient if line.split()[0] not in gone]
    old = [_read_lines(path) for path in (RULES_TRANSPORT, RULES_SENDER_RELAY)]
    if [to_recipient, to_sender] != old:
        _rule_map(RULES_TRANSPORT, to_recipient)
        _rule_map(RULES_SENDER_RELAY, to_sender)
        for parameter, path, lines in (('transport_maps', RULES_TRANSPORT, to_recipient), ('sender_dependent_relayhost_maps', RULES_SENDER_RELAY, to_sender)):
            wanted = rule_map_value(_postconf(parameter), path, bool(lines))
            if wanted != _postconf(parameter):
                _postconf_set(parameter, wanted)
        subprocess.run(['systemctl', 'reload', 'postfix'], check=False, capture_output=True)


def notify_rules(rules, show_subject):
    """The rules with notify, for efa-maillog: the senders as address or @domain, and the addresses to tell."""
    found = [{'name': rule['name'], 'senders': rule_targets(rule, None, None), 'notify': rule['notify']}
             for rule in rules if rule.get('enabled', True) and rule.get('notify') and rule['kind'] in RULE_FROM_SENDER]
    return {'rules': found, 'subject': show_subject}


def notify_write(rules):
    wanted = notify_rules(rules, subjects_shown())
    if not wanted['rules']:
        if os.path.exists(NOTIFY_FILE):
            os.remove(NOTIFY_FILE)
        return
    if _json_read(NOTIFY_FILE, None) != wanted:
        _json_write(NOTIFY_FILE, wanted)
        os.chmod(NOTIFY_FILE, 0o640)
        shutil.chown(NOTIFY_FILE, 'root', 'efa-web')


def rule_check(rule):
    """Checks one rule. Values end up in rspamd and Postfix settings, so they pass here first."""
    if not re.fullmatch(r'[a-z0-9][a-z0-9-]{0,39}', rule['name']):
        raise EfaError('Name: up to 40 small letters, digits or dashes.')
    value = rule['value']
    if rule['kind'] not in RULE_KINDS:
        raise EfaError('Kind must be one of: ' + ', '.join(RULE_KINDS))
    if rule['kind'] in ('sender', 'recipient') and not SENDER_RE.match(value):
        raise EfaError('This kind needs an email address.')
    if rule['kind'] in ('sender_domain', 'domain') and not DOMAIN_RE.match(value):
        raise EfaError('This kind needs a domain.')
    if rule['kind'] in ('tenant', 'group') and (not value or any(ch in value for ch in '\r\n\0"')):
        raise EfaError('This kind needs a tenant name or a group DN.')
    for key in ('reject', 'add_header', 'greylist'):
        if rule[key] != '':
            try:
                score = float(rule[key])
            except ValueError:
                raise EfaError('Scores must be numbers.')
            if not -100 <= score <= 1000:
                raise EfaError('Scores must be from -100 to 1000.')
    if not re.fullmatch(r'\d{1,4}', str(rule['priority'])):
        raise EfaError('Priority must be a number up to 9999.')
    if rule['route'] and not RULE_ROUTE_RE.match(rule['route']):
        raise EfaError('Route: host or IP address, optionally with :port.')
    if rule['route'] and rule['kind'] == 'group':
        raise EfaError('A group cannot have a route.')
    notify = rule.get('notify') or []
    if notify and (rule['kind'] not in RULE_FROM_SENDER or len(notify) > 10 or not all(SENDER_RE.match(address) for address in notify)):
        raise EfaError('Notify: up to 10 addresses, and only for a rule on a sender or a sender domain.')
    if not any((rule['reject'], rule['add_header'], rule['greylist'], rule['quarantine'], rule['route'], notify, rule.get('spam_off'),
                rule.get('allow_encrypted'))):
        raise EfaError('A rule needs a score, quarantine, a route, addresses to notify, spam filter off or encrypted archives allowed.')


def rule_list(_args):
    """Rules: other spam limits, quarantine instead of rejecting, or another route. The highest priority that fits wins."""
    return {'rules': sorted(_rules(), key=lambda r: -int(r['priority']))}


def rule_set(args):
    """Add, change or remove a rule. A rule looks at the whole mail: with several recipients, it applies if one of them fits."""
    name, action = args.name.strip().lower(), args.action.strip()
    rules = [rule for rule in _rules() if rule['name'] != name]
    if action == 'set':
        rule = {'name': name, 'kind': args.kind.strip(), 'value': args.value.strip().lower() if args.kind.strip() in RULE_KINDS[:4] else args.value.strip(),
                'priority': (args.priority or '').strip() or '10', 'reject': (args.reject or '').strip(), 'add_header': (args.add_header or '').strip(),
                'greylist': (args.greylist or '').strip(), 'quarantine': (args.quarantine or '').strip() == 'on', 'route': (args.route or '').strip(), 'enabled': True,
                'notify': sorted({item.strip().lower() for item in (getattr(args, 'notify', '') or '').replace(',', ' ').split()}),
                'spam_off': (getattr(args, 'spam_off', '') or '').strip() == 'on', 'allow_encrypted': (getattr(args, 'allow_encrypted', '') or '').strip() == 'on',
                # Rules efa-migrate made from rules of eFa 5 that weaken the filter: on, and on the dashboard until checked.
                'review': (getattr(args, 'review', '') or '').strip() or ''}
        rule_check(rule)
        rules.append(rule)
    elif action != 'remove':
        raise EfaError("Action must be 'set' or 'remove'.")
    previous = _rules()
    _json_write(RULES_FILE, {'rules': rules})
    try:
        _rules_apply()
    except (EfaError, OSError, subprocess.CalledProcessError):
        _json_write(RULES_FILE, {'rules': previous})
        raise
    return rule_list(None)


def uq_state():
    return {**UQ_DEFAULTS, **_json_read(UQ_FILE, {})}


def uq_status(_args):
    """The quarantine for users. Off by default: mail is then rejected as before."""
    state = uq_state()
    rows = _admin_query("SELECT COUNT(*) AS n, COALESCE(SUM(m.size), 0) AS size FROM quarantine_mail m WHERE EXISTS "
                        "(SELECT 1 FROM quarantine_rcpt r WHERE r.mail_id = m.id AND r.state IN ('held', 'requested'))")
    return {**state, 'held': rows[0]['n'], 'held_mb': round(float(rows[0]['size']) / 1048576, 1)}


# Attachments: rspamd finds the real type and looks into archives; eFa-next sets the dangerous endings and how strict it is.
ATTACH_FILE = ETC + '/eFa/attachments.json'
ATTACH_TYPES_CONF = RSPAMD_DIR + '/local.d/mime_types.conf'
ATTACH_GROUP_CONF = RSPAMD_DIR + '/local.d/mime_types_group.conf'
ATTACH_LUA = RSPAMD_DIR + '/efa-attachments.lua'
ATTACH_LOAD_LINE = ("do local ok, err = pcall(dofile, '" + ATTACH_LUA + "'); if not ok then require('rspamd_logger').errx(rspamd_config, 'efa-attachments: %s', err) end end "
                    "-- efa-attachments\n")
ATTACH_DANGEROUS = ('ade', 'adp', 'app', 'application', 'bat', 'chm', 'cmd', 'com', 'cpl', 'gadget', 'hta', 'img', 'inf', 'ins', 'iso', 'jar', 'js', 'jse',
                    'lnk', 'msc', 'msi', 'msp', 'mst', 'pif', 'ps1', 'psc1', 'reg', 'scf', 'scr', 'sct', 'shb', 'url', 'vb', 'vbe', 'vbs', 'vhd', 'vhdx',
                    'ws', 'wsc', 'wsf', 'wsh', 'xll', 'exe')
# names: file names that hide what they are (over 150 characters, a CLSID {...}, 10 or more spaces), also inside archives;
# executables: a program by its content (MZ: Windows and self-extracting archives, ELF), whatever its name. Both as eFa 5 had them.
ATTACH_DEFAULTS = {'enabled': False, 'extensions': list(ATTACH_DANGEROUS), 'action': 'reject', 'encrypted': 'mark', 'macros': 'mark',
                   'names': 'off', 'executables': 'off'}
# What reject and mark mean as scores: reject lies above the reject limit, mark at the spam mark.
ATTACH_SCORES = {'reject': 16.0, 'mark': 6.0, 'off': 0.0}
ATTACH_LUA_TEXT = r'''-- Written by efactl attachment-set. Do not edit.
-- Office files with macros: legacy OLE files name their _VBA_PROJECT stream in UTF-16, OOXML files hold a vbaProject.bin,
-- whose name stands uncompressed in the zip. Large parts are skipped: the scan stays cheap.
local MAX = 20 * 1024 * 1024
local OLE = '_\0V\0B\0A\0_\0P\0R\0O\0J\0E\0C\0T\0'
rspamd_config:register_symbol({name = 'EFA_MACRO', score = %(score)s, group = 'efa_attachments',
  description = 'An Office attachment with macros', callback = function(task)
  for _, part in ipairs(task:get_parts() or {}) do
    local name = part:get_filename()
    if name or part:is_attachment() then
      local content = part:get_content()
      if content and #content > 0 and #content < MAX then
        local text = tostring(content)
        if text:find(OLE, 1, true) or text:find('vbaProject.bin', 1, true) then
          return true, 1.0, name or 'attachment'
        end
      end
    end
  end
end})
local function hiding(name)
  return #name > 150 or name:find('{[%%x%%-]+}') and #name:match('{([%%x%%-]+)}') >= 25 or name:find('%%s%%s%%s%%s%%s%%s%%s%%s%%s%%s')
end
rspamd_config:register_symbol({name = 'EFA_BAD_FILENAME', score = %(names)s, group = 'efa_attachments',
  description = 'A file name that hides what the file is', callback = function(task)
  for _, part in ipairs(task:get_parts() or {}) do
    local name = part:get_filename()
    if name and hiding(name) then
      return true, 1.0, name:sub(1, 60)
    end
    if part:is_archive() then
      local ok, files = pcall(function() return part:get_archive():get_files() end)
      for _, inner in ipairs(ok and files or {}) do
        if type(inner) == 'string' and hiding(inner) then
          return true, 1.0, inner:sub(1, 60)
        end
      end
    end
  end
end})
rspamd_config:register_symbol({name = 'EFA_EXECUTABLE', score = %(executables)s, group = 'efa_attachments',
  description = 'An attachment that is a program (Windows, self-extracting, ELF)', callback = function(task)
  for _, part in ipairs(task:get_parts() or {}) do
    if part:get_filename() or part:is_attachment() then
      local content = part:get_content()
      if content and #content > 3 then
        local head = content:sub(1, 4)
        if head:sub(1, 2) == 'MZ' or head == '\127ELF' then
          return true, 1.0, part:get_filename() or 'attachment'
        end
      end
    end
  end
end})
'''


def attach_state():
    return {**ATTACH_DEFAULTS, **_json_read(ATTACH_FILE, {})}


def attach_texts(state):
    """The rspamd settings: the endings, also inside archives, and the weights of the symbols for the chosen strictness."""
    endings = ' '.join(f'{ext} = 4;' for ext in sorted(state['extensions']))
    types = f'bad_extensions {{ {endings} }}\nbad_archive_extensions {{ {endings} }}\n'
    # MIME_BAD_EXTENSION counts its weight times the factor of the ending (4): a quarter of the score reaches it.
    bad = ATTACH_SCORES[state['action']] / 4
    # The group of rspamd caps its symbols at 10: reject has to get above the reject limit.
    group = ('max_score = 30;\nsymbols {\n' + f'  "MIME_BAD_EXTENSION" {{ weight = {bad}; }}\n  "MIME_DOUBLE_BAD_EXTENSION" {{ weight = {ATTACH_SCORES[state["action"]]}; }}\n'
             f'  "MIME_ENCRYPTED_ARCHIVE" {{ weight = {ATTACH_SCORES[state["encrypted"]]}; }}\n}}\n')
    return types, group, ATTACH_LUA_TEXT % {'score': ATTACH_SCORES[state['macros']], 'names': ATTACH_SCORES[state.get('names', 'off')],
                                            'executables': ATTACH_SCORES[state.get('executables', 'off')]}


def attachment_status(_args):
    """How attachments are checked: the endings, also inside archives, encrypted archives and Office macros."""
    return attach_state()


def attachment_set(args):
    """Dangerous endings reject or mark the mail, encrypted archives and Office macros too. rspamd finds the real type of a file."""
    state = attach_state()
    state['enabled'] = _on_off(args.mode)
    for key in ('action', 'encrypted', 'macros', 'names', 'executables'):
        value = (getattr(args, key, '') or '').strip()
        if value:
            if value not in ATTACH_SCORES or (key == 'action' and value == 'off'):
                raise EfaError(f'{key}: reject, mark' + (' or off.' if key != 'action' else '.'))
            state[key] = value
    for field, change in (('add', set.union), ('remove', set.difference)):
        items = {item.strip().lower().lstrip('.') for item in (getattr(args, field, '') or '').replace(',', ' ').split()}
        if any(not re.fullmatch(r'[a-z0-9]{1,12}', item) for item in items):
            raise EfaError('Endings: letters and digits, such as exe or js.')
        state['extensions'] = sorted(change(set(state['extensions']), items))
    files = (ATTACH_TYPES_CONF, ATTACH_GROUP_CONF, ATTACH_LUA, RSPAMD_LOCAL_LUA)
    old = [open(path).read() if os.path.exists(path) else None for path in files]
    lua_local = re.sub(r'^.*-- efa-attachments\n', '', old[3] or '', flags=re.M)
    if state['enabled']:
        types, group, lua = attach_texts(state)
        _write(ATTACH_TYPES_CONF, types)
        _write(ATTACH_GROUP_CONF, group)
        _write(ATTACH_LUA, lua)
        lua_local = lua_local.rstrip('\n') + '\n' + ATTACH_LOAD_LINE
    else:
        for path in (ATTACH_TYPES_CONF, ATTACH_GROUP_CONF):
            if os.path.exists(path):
                os.remove(path)
    _write(RSPAMD_LOCAL_LUA, lua_local)
    if not _rspamd_config_ok():
        for path, text in zip(files, old):
            if text is None:
                if os.path.exists(path):
                    os.remove(path)
            else:
                _write(path, text)
        raise EfaError('rspamd rejected the settings, nothing changed.')
    _json_write(ATTACH_FILE, state)
    _reload_rspamd()
    return state


# Content disarm: its own milter after rspamd, off by default; qpdf is installed only when it is switched on.
CDR_PORT = 8907
RSPAMD_MILTER = REQUIRED_MILTERS[0]
CDR_STORE = '/var/lib/efa-cdr'
CDR_UNIT = 'efa-cdr'
CDR_KEEP_DAYS = 30
CDR_KEY_RE = re.compile(r'^\d{14}-[0-9a-f]{12}$')
# Both features of the content milter; root:efa-web 0640, it holds the key of the link signatures.
CONTENT_FILE = ETC + '/efa-web/content.json'
LINKS_DEFAULTS = {'enabled': False, 'base': '', 'continue': True, 'exceptions': [], 'unchecked': 'page'}
LINK_UNCHECKED = ('page', 'follow', 'block')


def cdr_chain(chain, on):
    """The milter ports with the disarm milter right after rspamd, or without it."""
    ports = [port for port in chain if port != CDR_PORT]
    if on:
        ports.insert(ports.index(RSPAMD_MILTER) + 1 if RSPAMD_MILTER in ports else 0, CDR_PORT)
    return ports


def _milter_ports_now():
    return milter_ports_of(_postconf('smtpd_milters'))


def milter_ports_of(value):
    """The ports of inet:host:port milters, not the numbers of the address."""
    return [int(port) for port in re.findall(r'inet:[^:,\s]+:(\d+)', value)]


def content_state():
    state = _json_read(CONTENT_FILE, {})
    return {'cdr': bool(state.get('cdr')), 'links': {**LINKS_DEFAULTS, **state.get('links', {})},
            'banner': {**BANNER_DEFAULTS, **state.get('banner', {})}, 'html_disarm': {'all': False, 'domains': [], **state.get('html_disarm', {})},
            'bimi': {'enabled': False, **state.get('bimi', {})},
            'tracking': {'all': False, 'domains': [], 'exceptions': [], 'hosts': [], **state.get('tracking', {})}}


def cdr_status(_args):
    """Content disarm: on or off, qpdf, and the originals kept for the admin."""
    platform_now = _platform()
    kept = sorted(glob.glob(CDR_STORE + '/*.json'))
    return {'enabled': content_state()['cdr'], 'milter_in_chain': CDR_PORT in _milter_ports_now(), 'service': platform_now.service_is_active(CDR_UNIT),
            'qpdf': platform_now.package_installed('qpdf'), 'originals': len(kept), 'keep_days': retention('cdr')}




def html_disarm_set(args):
    """5v (e): scripts, forms, frames, event handlers and redirects out of HTML mail, for all domains or one; signed mail stays."""
    on, domain = _on_off(args.mode), (args.domain or '').strip().lower()
    state = content_state()
    html = state['html_disarm']
    if domain:
        if not DOMAIN_RE.match(domain) or domain not in _local_domains():
            raise EfaError('Domain: one of the own domains, or empty for all.')
        if identity_now and identity_now.get('domains') is not None and domain not in identity_now['domains']:
            raise EfaError('Not allowed: name one of your own domains.')
        html['domains'] = sorted(set(html['domains']) | {domain}) if on else [item for item in html['domains'] if item != domain]
    else:
        if identity_now and identity_now.get('role') != 'super':
            raise EfaError('Name your domain: only a super admin switches it for all.')
        html['all'] = on
    _content_apply(state)
    _audit(f'active HTML disarm {"on" if on else "off"} for {domain or "all"} by {_dmarc_who()}')
    return {'html_disarm': html, 'note': 'The mail is changed after the DKIM and ARC checks; its DKIM signature no longer fits for the mail client.'}


def tracking_status(_args):
    """M1: where tracking pixels and tracking parameters are taken out of incoming mail, and which senders keep them."""
    tracking = content_state()['tracking']
    mine = identity_now.get('domains') if identity_now else None
    return {'all': tracking['all'], 'domains': [item for item in tracking['domains'] if mine is None or item in mine],
            'exceptions': tracking['exceptions'], 'own_hosts': tracking['hosts'],
            'note': 'The mail is changed after the DKIM and ARC checks; its DKIM signature no longer fits for the mail client.'}


def tracking_set(args):
    """M1: tracking pixels and tracking parameters out of incoming mail, for all, a tenant, or a domain."""
    on, domain, tenant = _on_off(args.mode), (args.domain or '').strip().lower(), (getattr(args, 'tenant', '') or '').strip()
    state = content_state()
    tracking = state['tracking']
    if tenant:
        tid = _tenant_id(tenant)
        if identity_now and identity_now.get('tenant_ids') is not None and tid not in identity_now['tenant_ids']:
            raise EfaError('Not allowed: name your own tenant.')
        names = set(_tenant_domains_or_none().get(tid, []))
    elif domain:
        if not DOMAIN_RE.match(domain) or domain not in _local_domains():
            raise EfaError('Domain: one of the own domains, or empty for all.')
        if identity_now and identity_now.get('domains') is not None and domain not in identity_now['domains']:
            raise EfaError('Not allowed: name one of your own domains.')
        names = {domain}
    else:
        if identity_now and identity_now.get('role') != 'super':
            raise EfaError('Name your domain or tenant: only a super admin switches it for all.')
        tracking['all'], names = on, set()
    if names:
        tracking['domains'] = sorted(set(tracking['domains']) | names) if on else [item for item in tracking['domains'] if item not in names]
    _content_apply(state)
    _audit(f'tracking protection {"on" if on else "off"} for {tenant or domain or "all"} by {_dmarc_who()}')
    return tracking_status(None)


def tracking_list_set(args):
    """M1: a sender that keeps its tracking (exception), or an own tracking host whose pictures always go."""
    kind, action, value = (args.kind or '').strip(), (args.action or '').strip(), (args.value or '').strip().lower()
    if kind not in ('exception', 'host') or action not in ('add', 'remove'):
        raise EfaError("Kind 'exception' or 'host', action 'add' or 'remove'.")
    if not (DOMAIN_RE.match(value) or kind == 'exception' and SENDER_RE.match(value)):
        raise EfaError('An address or domain for an exception, a host name for a tracking host.')
    state = content_state()
    key = 'exceptions' if kind == 'exception' else 'hosts'
    items = set(state['tracking'][key])
    state['tracking'][key] = sorted(items | {value} if action == 'add' else items - {value})
    _content_apply(state)
    _audit(f'tracking {kind} {value} {action} by {_dmarc_who()}')
    return tracking_status(None)

def bimi_set(args):
    """5w: the BIMI check of incoming mail: the logo of a sender that passed DMARC with quarantine or reject, as headers."""
    state = content_state()
    state['bimi'] = {'enabled': _on_off(args.mode)}
    _content_apply(state)
    _audit(f'BIMI check {"on" if state["bimi"]["enabled"] else "off"} by {_dmarc_who()}')
    return {'bimi': state['bimi']['enabled'],
            'note': 'The SVG of the sender is fetched once an hour per domain over HTTPS; its server sees this host asking. '
                    'Certificates (VMC) are not checked: policy.authority=none.'}

def links_hint_set(args):
    """Item 4: an own text of a tenant on the warning page of the link check, under the general hints; empty removes it."""
    tenant = (args.tenant or '').strip()
    tid = str(_tenant_id(tenant)) if tenant else 'all'
    if tenant and identity_now and identity_now.get('tenant_ids') is not None and int(tid) not in identity_now['tenant_ids']:
        raise EfaError('Not allowed: this tenant is outside your scope.')
    if not tenant and identity_now and identity_now.get('role') != 'super':
        raise EfaError('Name your tenant.')
    text = ' '.join((args.text or '').split())
    if len(text) > 600:
        raise EfaError('At most 600 characters.')
    state = content_state()
    hints = dict(state['links'].get('hints') or {})
    if text:
        hints[tid] = text
    else:
        hints.pop(tid, None)
    state['links']['hints'] = hints
    _content_apply(state)
    _audit(f'link warning hint of {tenant or "all"} set by {_dmarc_who()}')
    return {'hints': {key: value for key, value in hints.items() if not identity_now or identity_now.get('tenant_ids') is None or key == tid}}

def _content_apply(state):
    """The settings for the milter; it runs and sits after rspamd while one of its features is on."""
    # Item 4: the tenant of each domain goes into the link tokens, for the hints of its warning page.
    state['links']['tenants'] = {domain: str(tid) for tid, domains in _tenant_domains_or_none().items() for domain in domains}
    # 6/8h: the journal addresses for the content milter, from the archive targets with the journal format.
    state['journal'] = archive_journal(_json_read(ARCHIVE_FILE, {'targets': []})['targets'], _own_domains())
    _write(CONTENT_FILE, json.dumps(state, indent=1))
    os.chmod(CONTENT_FILE, 0o640)
    shutil.chown(CONTENT_FILE, 'root', 'efa-web')
    html = state.get('html_disarm') or {}
    tracking = state.get('tracking') or {}
    on = state['cdr'] or state['links']['enabled'] or state.get('banner', {}).get('enabled') or html.get('all') or bool(html.get('domains')) or \
        bool(state.get('bimi', {}).get('enabled')) or tracking.get('all') or bool(tracking.get('domains')) or bool(state.get('journal'))
    platform_now = _platform()
    try:
        if on:
            platform_now.service_enable(CDR_UNIT, start=True)
            for _ in range(20):
                if _port_listening(CDR_PORT):
                    break
                time.sleep(0.5)
            else:
                raise EfaError('The content milter does not answer, nothing changed in the mail flow.')
        chain = cdr_chain(_milter_ports_now(), on)
        if chain != _milter_ports_now():
            milter_chain_set(argparse.Namespace(ports=' '.join(map(str, chain))))
            subprocess.run(['postfix', 'reload'], check=False, capture_output=True)
        if not on:
            platform_now.service_disable(CDR_UNIT, stop=True)
    except EfaError:
        raise
    except Exception as err:  # the StepError of the platform layer
        raise EfaError(str(err))


# Outgoing mail: disclaimers and data loss prevention in their own milter before rspamd, so the text is signed with the mail.
OUTBOUND_FILE = ETC + '/eFa/outbound.json'
OUTBOUND_PORT = 8908
OUTBOUND_UNIT = 'efa-outbound'
DLP_ACTIONS = ('off', 'log', 'encrypt', 'hold', 'reject')
DLP_DEFAULTS = {'cards': 'off', 'iban': 'off', 'ids': 'off', 'ignore': [], 'rules': []}
# The agreed passwords of the PDF encryption: root only, systemd hands them to the milter (LoadCredential).
PDF_PASSWORDS = ETC + '/eFa/pdf-passwords.json'
PDF_KEYWORD_RE = re.compile(r'^[^\s<>"]{3,30}$')
DLP_NAME_RE = re.compile(r'^[a-z0-9][a-z0-9_-]{0,31}$')
IBAN_RE = re.compile(r'^[A-Z]{2}\d{2}[A-Z0-9]{11,30}$')


def outbound_chain(chain, on):
    """The milter ports with the outbound milter right before rspamd, or without it."""
    ports = [port for port in chain if port != OUTBOUND_PORT]
    if on:
        ports.insert(ports.index(RSPAMD_MILTER) if RSPAMD_MILTER in ports else 0, OUTBOUND_PORT)
    return ports


def _outbound_on(state):
    dlp = state.get('dlp', {})
    return bool(state.get('domains')) or bool(state.get('disclaimers')) or any(dlp.get(key, 'off') != 'off' for key in ('cards', 'iban', 'ids')) or \
        any(rule['action'] != 'off' for rule in dlp.get('rules', [])) or bool(state.get('pdf', {}).get('keyword')) or \
        state.get('limits', {}).get('action', 'off') != 'off' or bool(state.get('bulk', {}).get('enabled')) or \
        any(state.get('privacy', {}).get(key) for key in ('all', 'domains', 'submitters')) or bool(state.get('recall')) or bool(state.get('misdirect')) or \
        bool(state.get('crypto'))


def _local_domains():
    return sorted({line.split()[0].lower() for line in _read_lines(TRANSPORT) if line.split() and DOMAIN_RE.match(line.split()[0].lower())})


def _outbound_networks():
    # The milter reads plain networks only: without the brackets of IPv6 and without lookup tables.
    return ['127.0.0.0/8', '::1/128'] + _relay_active()[0]


def _outbound_write(state):
    """Writes the settings and puts the milter into the mail flow, or takes it out when nothing is left for it."""
    state['networks'] = _outbound_networks()
    state['admin'] = _admin_email()
    state['local_domains'] = _local_domains()
    _disclaimer_lookups(state)
    _privacy_lookups(state)
    # 9j: the tenant of each own domain, for the limit per tenant.
    state['tenants'] = {domain: str(tid) for tid, domains in _tenant_domains_or_none().items() for domain in domains}
    _write(OUTBOUND_FILE, json.dumps(state, indent=1))
    os.chmod(OUTBOUND_FILE, 0o644)
    if not os.path.exists(PDF_PASSWORDS):
        _pdf_passwords_write({})  # the unit loads it, it has to exist
    os.makedirs(CRYPTO_DIR, mode=0o700, exist_ok=True)  # 15: the unit loads the keys of this folder
    if not os.path.exists(SIGNATURE_FIELDS):
        fd = os.open(SIGNATURE_FIELDS, os.O_WRONLY | os.O_CREAT, 0o600)  # the unit loads it too
        with os.fdopen(fd, 'w') as f:
            f.write('{}')
    on = _outbound_on(state)
    platform_now = _platform()
    try:
        if on:
            platform_now.service_enable(OUTBOUND_UNIT, start=True)
            for _ in range(20):
                if _port_listening(OUTBOUND_PORT):
                    break
                time.sleep(0.5)
            else:
                raise EfaError('The outbound milter does not answer, nothing changed in the mail flow.')
        chain = outbound_chain(_milter_ports_now(), on)
        if chain != _milter_ports_now():
            milter_chain_set(argparse.Namespace(ports=' '.join(map(str, chain))))
        _outbound_strict_apply(state)
        subprocess.run(['postfix', 'reload'], check=False, capture_output=True)
        if not on:
            platform_now.service_disable(OUTBOUND_UNIT, stop=True)
    except EfaError:
        raise
    except Exception as err:  # the StepError of the platform layer
        raise EfaError(str(err))


OUT_CLIENTS = ETC + '/postfix/efa-outbound-clients.cidr'


def strict_chain(ports):
    """The milter list with efa-outbound on tempfail: when it is down, mail waits instead of leaving unchecked."""
    return ', '.join(f'{{ inet:127.0.0.1:{port}, default_action=tempfail }}' if port == OUTBOUND_PORT else f'inet:127.0.0.1:{port}' for port in ports)


def _outbound_strict(state):
    # Disclaimers alone keep accept: a missing disclaimer is no leak.
    # Bulk mode alone too: without the mark the mail takes the normal transport, nothing leaks.
    # Header privacy alone too: a mail with its Received lines is no leak of content.
    return _outbound_on({**state, 'domains': {}, 'disclaimers': [], 'bulk': {}, 'privacy': {}})


# M2: the Received lines, client addresses and mail programs of outgoing mail go before it leaves: for all senders, for chosen
# sender domains or for chosen submitters (8g). Headers a DKIM signature of the internal system covers stay.
def _privacy_lookups(state):
    privacy = state.get('privacy')
    if not privacy:
        return
    chosen = set(privacy.get('submitters', []))
    logins, networks = [], []
    for item in _submitters():
        if item['name'] in chosen:
            if item['kind'] == 'auth':
                logins.append(item['value'])
            elif item['kind'] == 'ip':
                networks.append(item['value'])
    privacy.update(logins=sorted(logins), networks=sorted(networks))


def header_privacy_status(_args):
    """Outgoing mail without Received lines, client addresses and mail programs: for whom."""
    privacy = _json_read(OUTBOUND_FILE, {}).get('privacy', {})
    return {'all': bool(privacy.get('all')), 'domains': privacy.get('domains', []), 'submitters': privacy.get('submitters', []),
            'removed': ['Received', 'X-Originating-IP', 'X-Mailer', 'User-Agent', 'X-Forwarded-For', 'X-Client-IP']}


def header_privacy_set(args):
    """For all senders, a sender domain or a submitter: their outgoing mail leaves without the headers of the internal network."""
    action, scope, name = (args.action or '').strip(), (args.scope or '').strip(), (args.name or '').strip().lower()
    if action not in ('add', 'remove') or scope not in ('all', 'domain', 'submitter'):
        raise EfaError("Action 'add' or 'remove', scope 'all', 'domain' or 'submitter'.")
    state = _json_read(OUTBOUND_FILE, {})
    privacy = {'all': False, 'domains': [], 'submitters': [], **state.get('privacy', {})}
    if scope == 'all':
        privacy['all'] = action == 'add'
    else:
        key = 'domains' if scope == 'domain' else 'submitters'
        if scope == 'domain' and (not DOMAIN_RE.match(name) or name not in _local_domains()):
            raise EfaError('Domain: one of the own domains.')
        if scope == 'submitter' and name not in {item['name'].lower() for item in _submitters()}:
            raise EfaError('No such submitter (Mail routing, Submitters).')
        privacy[key] = sorted(set(privacy[key]) | {name}) if action == 'add' else [item for item in privacy[key] if item != name]
    state['privacy'] = privacy
    _outbound_write(state)
    _audit(f'header privacy {action} {scope} {name} by {_dmarc_who()}')
    return header_privacy_status(None)


def _outbound_strict_apply(state):
    """Port 587 and the clients of the relay networks and submitters get efa-outbound on tempfail while DLP, PDF encryption or
    limits are on. Mail from the internet keeps the global list (milter_default_action accept) and never waits for it."""
    ports = _milter_ports_now()
    strict = _outbound_strict(state) and OUTBOUND_PORT in ports
    if strict:
        chain = strict_chain(ports)
        nets = _outbound_networks() + [item['value'] for item in _submitters() if item['kind'] == 'ip']
        _map_write(OUT_CLIENTS, [f'{net} {chain}' for net in dict.fromkeys(nets)], 'cidr')
        _postconf_set('smtpd_milter_maps', f'cidr:{OUT_CLIENTS}')
    elif _postconf('smtpd_milter_maps') == f'cidr:{OUT_CLIENTS}':
        _postconf_remove(['smtpd_milter_maps'])
    if not strict and os.path.exists(OUT_CLIENTS):
        os.remove(OUT_CLIENTS)
    if strict:
        _postconf_set('efa_submission_milters', strict_chain(ports))
        if _submission_active():
            subprocess.run(['postconf', '-P', 'submission/inet/smtpd_milters=$efa_submission_milters'], check=True, capture_output=True)
    else:
        # Port 587 takes the global list again; a reference to $smtpd_milters there would call itself.
        if _submission_active():
            subprocess.run(['postconf', '-PX', 'submission/inet/smtpd_milters'], check=False, capture_output=True)
        # Unused once 587 no longer names it, so postconf -n does not show it any more: remove it in any case.
        _postconf_remove(['efa_submission_milters'])


# The cluster (9): a master and its clients over TLS with certificates of the own CA of the master. 9a: certificates, join, status.
CLUSTER_UNIT = 'efa-cluster'


# 9b: the master hands its settings on as commands. Each write command that is not about this host goes into a journal (0600);
# the clients fetch it over mutual TLS and run the same commands, so the changes they make to Postfix and rspamd follow too.
CLUSTER_LOCAL = {
    'network-set', 'interface-set', 'interface-confirm', 'interface-revert', 'firewall-set', 'firewall-confirm', 'firewall-revert',
    'firewall-guard-set', 'firewall-probe-set', 'firewall-test', 'letsencrypt-set', 'ssh-root-set', 'admin-password', 'reboot', 'halt',
    'update-system', 'update-system-run', 'update-now', 'update-install', 'update-run', 'update-rollback', 'update-post-boot',
    'autoupdate-set', 'maintenance-set', 'restore', 'backup-now', 'backup-import', 'backup-password-set', 'backup-set',
    'backup-target-set', 'mariadb-repair', 'service-restart', 'extra-service-set', 'load-set', 'load-notify', 'resolver-set',
    'dns-zone-set', 'kernel-hardening-set', 'wazuh-install', 'wazuh-config', 'wazuh-service', 'wazuh-update', 'wazuh-remove',
    'session-open', 'session-end', 'token-create', 'token-revoke', 'audit-mode', 'audit-rules-set', 'audit-note', 'audit-purge',
    'maillog-purge', 'maillog-setup', 'quarantine-release', 'quarantine-delete', 'quarantine-purge', 'queue-action', 'queue-flush',
    'cdr-release', 'uq-release', 'uq-request', 'uq-delete', 'uq-sender', 'uq-link-use', 'train-request', 'train-decide',
    'mailreport-run', 'events-run', 'security-check', 'ml-train', 'efa-headers-apply', 'cluster-init', 'cluster-token',
    'cluster-join', 'cluster-node-remove', 'cluster-leave', 'cluster-mail-action', 'sanesecurity-update', 'sanesecurity-run', 'rotation-run', 'tui',
    # The package setup runs these on every host for itself (nginx, logins of port 587, the memory of redis).
    'web-harden', 'sasl-apply', 'redis-tune',
    # 5o: the API, its certificate files and sources belong to the master; the keys it takes are shared as files (CLUSTER_DKIM).
    'dkim-provision-set', 'dkim-source-set', 'dkim-source-remove'}
# Commands that make random keys: not run again, the master hands on the folder of the keys instead (and the link key).
CLUSTER_DKIM = {'dkim-create', 'dkim-generate', 'dkim-generate-ed25519', 'dkim-remove', 'dkim-import', 'rotation-set', 'rotation-all-set',
                'rotation-pregenerate', 'rotation-run', 'arc-set', 'arc-all-set', 'dkim-provision-apply', 'dkim-provision-takeover'}
CLUSTER_CONTENT = {'links-set'}
# shortcut: each change hands the whole disclaimer folder to the nodes (up to 200 templates); send one template when that grows.
CLUSTER_DISCLAIMER = {'disclaimer-template-set', 'disclaimer-template-remove', 'disclaimer-restore', 'disclaimer-import', 'disclaimer-provision-apply'}


def cluster_role():
    return _lib('efa_cluster').read_state(ETC).get('role', 'none') if os.path.exists(os.path.join(ETC, 'eFa', 'cluster')) else 'none'


# 9g: master/client (settings only on the master, the clients read only) or HA (a change on any node goes to the master, which
# runs it and hands it to all; the order of the master decides, so the last change wins). The overviews of the master too.
CLUSTER_MODES = ('master-client', 'ha')
CLUSTER_HA_FORWARD = {'cluster-maillog', 'cluster-quarantine', 'cluster-queue', 'cluster-mail-action', 'cluster-unban', 'cluster-mx-check'}


def _cluster_managed_by():
    """The master of a client in master/client mode, for the note on every page; empty otherwise."""
    if cluster_role() != 'client' or cluster_mode() != 'master-client':
        return ''
    return _lib('efa_cluster').read_state(ETC).get('master', {}).get('name', '')


def cluster_mode():
    return _lib('efa_cluster').read_state(ETC).get('mode', 'master-client') if os.path.exists(os.path.join(ETC, 'eFa', 'cluster')) else ''


def _cluster_forward(args):
    """HA: the command to the master; it runs it there with the rights already checked here, and answers with its result."""
    cluster, base, state = _cluster_parts()
    spec = COMMANDS[args.command]['args']
    values = {arg['name']: getattr(args, arg['name'], '') for arg in spec if not arg.get('secret')}
    stdin = ''
    if any(arg.get('secret') for arg in spec):
        if sys.stdin.isatty():
            raise EfaError('A secret goes to the master only from the web interface or a pipe; or change it on the master.')
        stdin = sys.stdin.read(65536)
    master = state['master']
    try:
        answer = cluster.call(base, master['host'], master['port'], '/v1/forward',
                              {'command': args.command, 'args': {k: v for k, v in values.items() if v is not None}, 'stdin': stdin,
                               'user': _dmarc_who()}, timeout=180)
    except (OSError, ValueError) as err:
        raise EfaError(f"Cluster (HA): the master {master.get('name', '')} is not reachable, so settings cannot change now: {str(err)[:120]}. "
                       'Mail filtering goes on with the last settings.')
    if isinstance(answer, dict) and set(answer) == {'error'}:
        raise EfaError(answer['error'])
    return answer


# Whole families stay on their host, whatever the list above forgets: a firewall job run on another node with its own files would
# take away rules there (it did, in the test of 9b: the guard of the master ran again on a node and removed the allowlist table).
CLUSTER_LOCAL_PREFIXES = ('firewall-', 'interface-', 'network-', 'update-', 'backup-', 'cluster-', 'wazuh-', 'session-', 'token-', 'audit-')


def cluster_replicated(command):
    if command in CLUSTER_DKIM:
        return True
    return bool(command in COMMANDS and COMMANDS[command].get('writes') and command not in CLUSTER_LOCAL and command not in BACKGROUND_JOBS
                and not command.startswith(CLUSTER_LOCAL_PREFIXES))


def _etc_relative(path):
    # The paths in the journal are below /etc of each node, so a node with another EFA_ETC (a test) writes into its own.
    return os.path.relpath(path, ETC)


def _file_item(path, mode=None):
    with open(path, 'rb') as f:
        data = base64.b64encode(f.read()).decode()
    return {'path': _etc_relative(path), 'mode': os.stat(path).st_mode & 0o777 if mode is None else mode, 'data': data}


def _tree_files(top):
    """Every file below a folder with its mode, as base64."""
    found = []
    for root, dirs, names in os.walk(top):
        dirs.sort()
        for name in sorted(names):
            found.append(_file_item(os.path.join(root, name)))
    return found


def cluster_entries(command, args, secrets_seen):
    """What the journal gets for one command on the master: the command itself, files, or both."""
    # A call of a source that changed nothing (GET, the same version, a refusal) goes to no node.
    if command == 'dkim-provision-apply' and not PROVISION_CHANGED:
        return []
    if command in CLUSTER_DISCLAIMER:
        if not DISCLAIMER_CHANGED:
            return []
        return [{'type': 'files', 'files': _tree_files(DISCLAIMER_DIR) if os.path.isdir(DISCLAIMER_DIR) else [],
                 'mirror': [_etc_relative(DISCLAIMER_DIR)], 'then': 'disclaimer-sync'}]
    if command in CLUSTER_DKIM:
        files = (_tree_files(DKIM_DIR) + ([_file_item(ROTATION_FILE, 0o600)] if os.path.exists(ROTATION_FILE) else [])
                 + ([_file_item(PROVISION_FILE, 0o640)] if os.path.exists(PROVISION_FILE) else []))
        return [{'type': 'files', 'files': files, 'mirror': [_etc_relative(DKIM_DIR)], 'then': 'cluster-dkim-apply'}]
    values = {arg['name']: getattr(args, arg['name'], '') for arg in COMMANDS[command]['args'] if not arg.get('secret')}
    # An empty value stays: it is how a text is cleared (subject-set --text '').
    entries = [{'type': 'command', 'command': command, 'args': {k: v for k, v in values.items() if v is not None}, 'secrets': list(secrets_seen)}]
    if command in CLUSTER_CONTENT and os.path.exists(CONTENT_FILE):
        entries.append({'type': 'files', 'files': [_file_item(CONTENT_FILE, 0o640)], 'mirror': [], 'then': 'cluster-content-apply'})
    return entries


def _cluster_journal(command, args):
    """On the master: the entries of a successful write command, numbered on, the oldest dropped past CLUSTER_KEEP."""
    cluster = _lib('efa_cluster')
    cluster.journal_append(cluster.folder(ETC), cluster_entries(command, args, SECRETS_SEEN))


# 9c, full sync: a new node takes the settings of the master once, then follows the journal from that point.
SNAP_SKIP_EFA = {'audit-strict.json', 'audit-strict.key', 'autoupdate.json', 'backup-targets.json', 'firewall.json', 'interfaces.json',
                 'security-check.json', 'update-system.json', 'MySQL-Config', 'eFa-Config', 'rspamd-sso', 'wazuh.json'}
SNAP_SKIP_DIRS = {'eFa/backup-targets', 'eFa/efa5-import', 'eFa/cluster'}
SNAP_RSPAMD_SKIP = ('redis.conf', 'worker-', '.example')
SNAP_POSTFIX_MAPS = ('access', 'canonical', 'generic', 'header_checks', 'helo_access', 'milter_header_checks', 'efa-quarantine', 'recipient_access',
                     'recipient_canonical', 'relay_recipients', 'relocated', 'sender_access', 'sender_canonical', 'transport', 'virtual', 'sasl_passwd')
SNAP_POSTCONF = ('smtpd_milters', 'smtpd_milter_maps', 'efa_submission_restrictions', 'efa_submission_milters', 'smtpd_restriction_classes',
                 'smtpd_relay_restrictions', 'smtpd_recipient_restrictions', 'recipient_bcc_maps', 'sender_bcc_maps', 'transport_maps',
                 'smtp_tls_policy_maps', 'milter_header_checks', 'message_size_limit', 'relayhost', 'mynetworks', 'smtpd_tls_protocols',
                 'smtpd_tls_mandatory_protocols', 'smtp_tls_protocols', 'smtp_tls_mandatory_protocols', 'smtp_tls_security_level',
                 'smtp_dns_support_level', 'smtpd_tls_ask_ccert', 'smtpd_tls_fingerprint_digest')
SNAP_POSTCONF_PREFIXES = ('efa_sub_', 'efabulk_', 'smtp_sasl_')
SNAP_SERVICES = ('efabulk/unix', 'efa-phish/unix', 'efa-reports/unix')
SNAP_TABLES = ('tenants', 'tenant_domains', 'users', 'efa_groups', 'user_groups', 'group_roles', 'scoped_settings')
SNAP_UNITS = ('efa-outbound', 'efa-cdr')
# What the master sets goes to all nodes; only the identity of a host stays. Values of one node go here, never shared.
LOCAL_DIR = ETC + '/eFa/local.d'


def merged(base, override):
    """The settings with the override of this host on top, key by key."""
    out = dict(base)
    for key, value in override.items():
        out[key] = merged(out[key], value) if isinstance(value, dict) and isinstance(out.get(key), dict) else value
    return out


def own_names(paths, master, own):
    """The name of the master in the shared Postfix tables as the name of this host."""
    fixed = []
    for path in paths:
        if master and own and master != own and os.path.basename(path) in HOSTNAME_MAPS and os.path.exists(path):
            with open(path) as f:
                text = f.read()
            if renamed_text(text, master, own) != text:
                _write(path, renamed_text(text, master, own))
                fixed.append(path)
    return fixed


def snapshot_files():
    """The setting files of this host that a cluster shares, below ETC."""
    found = []
    for name in sorted(os.listdir(ETC + '/eFa')):
        path = f'{ETC}/eFa/{name}'
        if os.path.isfile(path) and name not in SNAP_SKIP_EFA:
            found.append(path)
    for path in (f'{ETC}/efa-web/content.json', f'{ETC}/efa-web/headers-policy.json', SUB_DOVECOT, SUB_PASSWD):
        if os.path.exists(path):
            found.append(path)
    for root, dirs, names in os.walk(RSPAMD_DIR):
        dirs.sort()
        for name in sorted(names):
            if not any(part in name for part in SNAP_RSPAMD_SKIP):
                found.append(os.path.join(root, name))
    postfix = ETC + '/postfix'
    for name in sorted(os.listdir(postfix)) if os.path.isdir(postfix) else []:
        if (name in SNAP_POSTFIX_MAPS or name.startswith('efa-')) and not name.endswith('.db'):
            found.append(f'{postfix}/{name}')
    return [path for path in found if not any(_etc_relative(path).startswith(item + '/') for item in SNAP_SKIP_DIRS)]


def cluster_snapshot(_args):
    """The master: its shared settings in one piece for a new node, with the journal number they stand at."""
    cluster, base, state = _cluster_parts()
    if state.get('role') != 'master':
        raise EfaError('Only the master gives a snapshot.')
    journal = cluster.journal_read(base)
    explicit = {}
    for line in subprocess.run(['postconf', '-n'], capture_output=True, text=True).stdout.splitlines():
        name, _, value = line.partition(' = ')
        if name in SNAP_POSTCONF or name.startswith(SNAP_POSTCONF_PREFIXES):
            explicit[name] = value
    services = {}
    for service in SNAP_SERVICES:
        line = subprocess.run(['postconf', '-M', service], capture_output=True, text=True).stdout.strip()
        if line:
            services[service] = line
    sql = ''
    if shutil.which('mysqldump'):
        done = subprocess.run(['mysqldump', '--user=root', '--single-transaction', 'efa', *SNAP_TABLES], capture_output=True, text=True, env=_mysql_env())
        sql = done.stdout if done.returncode == 0 else ''
    platform_now = _platform()
    files = [{**_file_item(path), 'hash': os.path.exists(path + '.db')} for path in snapshot_files()]
    return {'seq': journal[-1]['seq'] if journal else 0, 'hostname': _postconf('myhostname'), 'files': files, 'postconf': explicit, 'services': services, 'sql': sql,
            'units': {unit: platform_now.service_is_active(unit) for unit in SNAP_UNITS}}


def snapshot_apply(snapshot, files_only=False):
    """A snapshot of the master on this node. With files_only (a test on one host) the rest is only listed."""
    written, maps = [], []
    for item in snapshot['files']:
        path = os.path.realpath(os.path.join(ETC, item['path']))
        if not path.startswith(os.path.realpath(ETC) + os.sep):
            raise EfaError(f'a path outside {ETC}: {item["path"]}')
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path + '.new', 'wb') as f:
            f.write(base64.b64decode(item['data']))
        os.chmod(path + '.new', item['mode'])
        if os.path.exists(path):  # the owner of the file here (rspamd keys, the Dovecot password file) stays
            owner = os.stat(path)
            os.chown(path + '.new', owner.st_uid, owner.st_gid)
        os.replace(path + '.new', path)
        written.append(item['path'])
        if item.get('hash'):
            maps.append(path)
    own_names([os.path.join(ETC, item['path']) for item in snapshot['files']], snapshot.get('hostname', ''), _postconf('myhostname'))
    pending = {'postconf': sorted(snapshot['postconf']), 'services': sorted(snapshot['services']), 'sql_bytes': len(snapshot['sql']),
               'units': snapshot['units'], 'postmap': [os.path.relpath(path, ETC) for path in maps]}
    if files_only:
        return {'files': len(written), 'not_applied_in_this_test': pending}
    for path in maps:
        subprocess.run(['postmap', path], check=False, capture_output=True)
    for name, value in snapshot['postconf'].items():
        subprocess.run(['postconf', '-e', f'{name} = {value}'], check=False, capture_output=True)
    for service, line in snapshot['services'].items():
        subprocess.run(['postconf', '-M', f'{service}={line}'], check=False, capture_output=True)
    if snapshot['sql']:
        subprocess.run(['mysql', '--user=root', 'efa'], input=snapshot['sql'], text=True, env=_mysql_env(), check=False, capture_output=True)
    platform_now = _platform()
    for unit, active in snapshot['units'].items():
        try:
            (platform_now.service_enable(unit, start=True) if active else platform_now.service_disable(unit, stop=True))
        except Exception as err:  # the StepError of the platform layer: the other parts are done
            print(f'cluster sync: {unit}: {err}', file=sys.stderr)
    if os.path.exists(SUB_PASSWD):
        shutil.chown(SUB_PASSWD, 'root', 'dovecot')
    if os.path.exists(CONTENT_FILE):
        cluster_content_apply(None)
    cluster_dkim_apply(None)
    for unit in (_platform().service('mta'), _platform().service('sasl')):
        try:
            _platform().service_reload_if_active(unit)
        except Exception:  # noqa: S110 - a service that is not there here
            pass
    return {'files': len(written), 'postconf': len(snapshot['postconf']), 'services': len(snapshot['services']), 'tables': len(SNAP_TABLES)}


# 9e: failover works through several MX records of equal priority, one per node; no shared storage.
def _addresses_of(host):
    try:
        return sorted({item[4][0] for item in socket.getaddrinfo(host, 25, proto=socket.IPPROTO_TCP)})
    except (OSError, UnicodeError):
        return []


def _own_address(family, probe):
    """The source address this host uses towards the internet. A UDP connect sends nothing."""
    try:
        with socket.socket(family, socket.SOCK_DGRAM) as sock:
            sock.connect((probe, 25))
            return sock.getsockname()[0]
    except OSError:
        return None


def mx_findings(domain, records, addresses_of, nodes):
    """What the MX records of one domain mean for the failover. records: [(priority, host)], nodes: {address: node name}."""
    findings = []
    if not records:
        return [{'level': 'problem', 'domain': domain, 'text': 'No MX record: other servers deliver to the A record of the domain, or not at all.'}]
    covered, foreign = set(), []
    for priority, host in records:
        found = [nodes[address] for address in addresses_of(host) if address in nodes]
        if found:
            covered.update(found)
        else:
            foreign.append(host)
    for host in foreign:
        findings.append({'level': 'warning', 'domain': domain, 'text': f'MX {host} is no node of this cluster: mail sent there does not pass these filters.'})
    for name in sorted(set(nodes.values()) - covered):
        findings.append({'level': 'warning', 'domain': domain, 'text': f'No MX points to {name}: it takes no mail for this domain from outside.'})
    if len(covered) == 1:
        findings.append({'level': 'warning', 'domain': domain, 'text': 'Only one node takes the mail: if it fails, senders queue and retry for days.'})
    ours = sorted({priority for priority, host in records if host not in foreign})
    if len(ours) > 1:
        findings.append({'level': 'note', 'domain': domain, 'text': f'The nodes have the priorities {", ".join(map(str, ours))}: '
                                                                     'the lower takes all mail, the higher only while it fails. Equal priorities share the load.'})
    return findings


def cluster_mx_check(_args):
    """The master: do the MX records of the local domains point to the nodes, so that one can fail without loss of mail?"""
    _cluster, _base, state = _cluster_parts()
    if state.get('role') != 'master':
        raise EfaError('The MX check runs on the master: it knows all nodes.')
    nodes = {}
    for address in (_own_address(socket.AF_INET, '192.0.2.1'), _own_address(socket.AF_INET6, '2001:db8::1')):
        if address:
            nodes[address] = state['name']
    for name, node in state.get('nodes', {}).items():
        for address in _addresses_of(node['host']) or [node['host']]:
            nodes[address] = name
    findings, domains = [], _local_domains()
    for domain in domains:
        lines = subprocess.run(['dig', '+time=4', '+tries=1', '+short', 'MX', domain], capture_output=True, text=True, timeout=15).stdout.split('\n')
        records = []
        for line in lines:
            parts = line.split()
            if len(parts) == 2 and parts[0].isdigit():
                records.append((int(parts[0]), parts[1].rstrip('.').lower()))
        findings += mx_findings(domain, sorted(records), _addresses_of, nodes)
    return {'domains': len(domains), 'nodes': sorted(set(nodes.values())), 'findings': findings,
            'ok': not any(item['level'] in ('problem', 'warning') for item in findings)}


def cluster_resync(_args):
    """A client takes all shared settings of the master anew, then follows the journal from that point. Joining does it once."""
    cluster, base, state = _cluster_parts()
    if state.get('role') != 'client':
        raise EfaError('Only a client takes the settings of a master.')
    master = state['master']
    try:
        snapshot = cluster.call(base, master['host'], master['port'], '/v1/snapshot', timeout=120)
    except (OSError, ValueError) as err:
        raise EfaError(f'The master does not answer: {err}')
    result = snapshot_apply(snapshot, files_only=bool(os.environ.get('EFA_CLUSTER_SYNC_FILES_ONLY')))
    state = cluster.read_state(ETC)
    state['applied'] = snapshot['seq']
    # The snapshot holds the result of the failed entries before it: they are no longer open.
    state['failed'] = [item for item in state.get('failed', []) if int(item.get('seq', 0)) > snapshot['seq']]
    cluster.write_state(state, ETC)
    return {**result, 'journal_from': snapshot['seq']}


def cluster_dkim_apply(_args):
    """On a client, after the keys of the master came: the rspamd settings from the key files, and a reload."""
    for path in glob.glob(DKIM_DIR + '/**/*.key', recursive=True):
        _own_key(path)
    _write_dkim_conf()
    _reload_rspamd()
    return {'dkim': 'applied'}


def cluster_content_apply(_args):
    """On a client, after the link key of the master came: the content milter takes it."""
    os.chmod(CONTENT_FILE, 0o640)
    shutil.chown(CONTENT_FILE, 'root', 'efa-web')
    _content_apply(merged(_json_read(CONTENT_FILE, {}), _json_read(LOCAL_DIR + '/content.json', {})))
    return {'content': 'applied'}


def _cluster_parts():
    cluster = _lib('efa_cluster')
    return cluster, cluster.folder(ETC), cluster.read_state(ETC)


def _host_port(value, default):
    host, _, port = value.strip().rpartition(':') if value.count(':') == 1 else (value.strip(), '', '')
    host = host or value.strip()
    if not HOST_RE.match(host) or ':' in host or (port and not port.isdigit()):
        raise EfaError('Master: a host name or address, with :port if not the default.')
    return host, int(port) if port else default


def cluster_status(_args):
    """The cluster: on the master each node with its state, on a client its master."""
    cluster, base, state = _cluster_parts()
    if not state:
        return {'role': 'none', 'mode': cluster_mode() or 'master-client', 'note': 'Not in a cluster. Start one with cluster-init on the master.'}
    with open(os.path.join(base, 'node.crt')) as f:
        own = f.read()
    result = {'role': state['role'], 'name': state['name'], 'port': state.get('port', cluster.PORT), 'mode': state.get('mode', 'master-client'),
              'certificate_until': time.strftime('%Y-%m-%d', time.localtime(cluster.cert_end(own)))}
    if state['role'] == 'master':
        rows = []
        journal = cluster.journal_read(base)
        seq = journal[-1]['seq'] if journal else 0
        result['journal'] = seq
        for name, node in sorted(state.get('nodes', {}).items()):
            row = {'node': name, 'address': f"{node['host']}:{node['port']}", 'joined': node.get('joined'), 'confirmed': node.get('applied', 0)}
            try:
                answer = cluster.call(base, node['host'], node['port'], '/v1/status', timeout=5)
                row.update(reachable=True, status=answer.get('status'), down=answer.get('down', []), version=answer.get('version'),
                           behind=max(0, seq - int(answer.get('applied', 0))), failed=answer.get('failed', []))
            except (OSError, ValueError) as err:
                row.update(reachable=False, error=str(err)[:120])
            rows.append(row)
        result['nodes'] = rows
    else:
        result['master'] = state['master']
        if state.get('mode', 'master-client') == 'master-client':
            result['managed_by'] = state['master'].get('name', '')
    return result


def _cluster_each(command, args, key):
    """One command on the master and on every node; the rows of key from all, each with its node."""
    cluster, base, state = _cluster_parts()
    if state.get('role') != 'master':
        raise EfaError('Only the master shows all nodes.')
    rows, errors = [], []
    local = COMMANDS[command]['func'](argparse.Namespace(**{arg['name']: args.get(arg['name'], '') for arg in COMMANDS[command]['args']}))
    rows += [{**row, 'node': state['name']} for row in local.get(key, [])]
    for name, node in sorted(state.get('nodes', {}).items()):
        try:
            answer = cluster.call(base, node['host'], node['port'], '/v1/run', {'command': command, 'args': {k: v for k, v in args.items() if v}}, timeout=60)
        except (OSError, ValueError) as err:
            errors.append(f'{name}: {err}'[:200])
            continue
        if 'error' in answer:
            errors.append(f"{name}: {answer['error']}"[:200])
        rows += [{**row, 'node': name} for row in answer.get(key, [])]
    return rows, errors


def cluster_maillog(args):
    """The mail log of all nodes, newest first."""
    limit = (args.limit or '').strip() or '100'
    rows, errors = _cluster_each('maillog-search', {'text': args.text or '', 'limit': limit}, 'mails')
    rows.sort(key=lambda row: str(row.get('ts', '')), reverse=True)
    return {'mails': rows[:int(limit) if limit.isdigit() else 100], 'unreachable': errors}


def cluster_quarantine(_args):
    """The held mail of all nodes."""
    rows, errors = _cluster_each('quarantine-list', {}, 'quarantine')
    return {'quarantine': rows, 'unreachable': errors}


def cluster_queue(args):
    """The mail queues of all nodes."""
    rows, errors = _cluster_each('queue-list', {'queue': args.queue or '', 'text': args.text or ''}, 'mails')
    counts = {}
    for row in rows:
        counts[row['node']] = counts.get(row['node'], 0) + 1
    return {'mails': rows, 'per_node': counts, 'unreachable': errors}


CLUSTER_MAIL_ACTIONS = {'release': ('quarantine-release', {}), 'delete': ('quarantine-delete', {'confirm': 'yes'}),
                        'requeue': ('queue-action', {'action': 'requeue', 'confirm': 'yes'}), 'hold': ('queue-action', {'action': 'hold', 'confirm': 'yes'})}


def cluster_unban(args):
    """Lifts a ban of Fail2Ban on all nodes, and keeps the address out of the shared bans for an hour."""
    cluster, _base, state = _cluster_parts()
    if state.get('role') != 'master':
        raise EfaError('Only the master lifts bans of the cluster.')
    try:
        address = str(ipaddress.ip_address(args.address.strip()))
    except ValueError:
        raise EfaError('Address: an IPv4 or IPv6 address.')
    now = time.time()
    state['unbans'] = {key: until for key, until in state.get('unbans', {}).items() if until > now}
    state['unbans'][address] = now + cluster.BAN_SECONDS
    state['bans'] = {key: item for key, item in state.get('bans', {}).items() if item['address'] != address}
    cluster.write_state(state, ETC)
    cluster.f2b_unban(address)
    return {'unbanned': address, 'on_all_nodes_within_seconds': 30, 'kept_out_until': time.strftime('%H:%M', time.localtime(now + cluster.BAN_SECONDS))}


def cluster_mail_action(args):
    """Release or delete a held mail, or requeue or hold one in the queue, on the node that has it."""
    cluster, base, state = _cluster_parts()
    if state.get('role') != 'master':
        raise EfaError('Only the master acts on other nodes.')
    action, node, mail = args.action.strip(), args.node.strip(), args.id.strip()
    if action not in CLUSTER_MAIL_ACTIONS or not QUEUE_ID_RE.match(mail):
        raise EfaError('Action: release, delete, requeue or hold; and a queue ID.')
    command, extra = CLUSTER_MAIL_ACTIONS[action]
    if node == state['name']:
        spec = COMMANDS[command]
        return spec['func'](argparse.Namespace(**{arg['name']: {**extra, 'id': mail}.get(arg['name'], '') for arg in spec['args']}))
    if node not in state.get('nodes', {}):
        raise EfaError('No such node.')
    target = state['nodes'][node]
    try:
        return cluster.call(base, target['host'], target['port'], '/v1/run', {'command': command, 'args': {**extra, 'id': mail}}, timeout=60)
    except (OSError, ValueError) as err:
        raise EfaError(f'{node} not reached: {err}')


def cluster_init(args):
    """This node becomes the master of a new cluster: its own certificate authority and certificate."""
    cluster, base, state = _cluster_parts()
    name = args.name.strip().lower()
    mode = (getattr(args, 'mode', '') or 'master-client').strip()
    if mode not in CLUSTER_MODES:
        raise EfaError('Mode: master-client or ha.')
    if state:
        raise EfaError('This node is in a cluster already.')
    if not cluster.valid_name(name):
        raise EfaError('Name: small letters, digits and dashes.')
    os.makedirs(base, mode=0o700, exist_ok=True)
    try:
        cluster.make_ca(base, name)
        cert = cluster.sign(base, cluster.make_request(base, name), name)
    except (RuntimeError, ValueError) as err:
        raise EfaError(str(err))
    _write(os.path.join(base, 'node.crt'), cert)
    cluster.write_state({'role': 'master', 'name': name, 'port': cluster.PORT, 'mode': mode, 'nodes': {}, 'tokens': {}}, ETC)
    _cluster_service(True)
    return cluster_status(None)


def cluster_mode_set(args):
    """On the master: master/client or HA. Each node takes all settings anew once it sees the new mode."""
    cluster, _base, state = _cluster_parts()
    if state.get('role') != 'master':
        raise EfaError('The mode is set on the master.')
    mode = args.mode.strip()
    if mode not in CLUSTER_MODES:
        raise EfaError('Mode: master-client or ha.')
    _confirm(args)
    old = state.get('mode', 'master-client')
    if old != mode:
        state['mode'] = mode
        cluster.write_state(state, ETC)
        _event('cluster_mode', 'notice', user=_dmarc_who(), old=old, new=mode)
    return {**cluster_status(None), 'changed': old != mode, 'note': 'Each node takes all settings anew within a minute (cluster-resync).'}


def _cluster_service(on):
    try:
        if on:
            _platform().service_enable(CLUSTER_UNIT, start=True)
        else:
            _platform().service_disable(CLUSTER_UNIT, stop=True)
    except Exception as err:  # the StepError of the platform layer
        raise EfaError(f'The cluster service: {err}')


def cluster_token(_args):
    """A one-time token for one node to join, valid for one hour, with the fingerprint of the CA to check on the node."""
    cluster, base, state = _cluster_parts()
    if state.get('role') != 'master':
        raise EfaError('Only the master gives out tokens.')
    token = secrets.token_urlsafe(24)
    now = time.time()
    state['tokens'] = {key: until for key, until in state.get('tokens', {}).items() if until > now}
    state['tokens'][cluster.token_hash(token)] = now + 3600
    cluster.write_state(state, ETC)
    with open(os.path.join(base, 'ca.crt')) as f:
        fingerprint = cluster.fingerprint_pem(f.read())
    return {'token': token, 'ca_fingerprint': fingerprint, 'valid_until': time.strftime('%Y-%m-%d %H:%M', time.localtime(now + 3600)),
            'on_the_node': f'efactl cluster-join --master <this host>:{state.get("port", cluster.PORT)} --name <node> --address <node address> '
                           f'--ca_fingerprint {fingerprint} (the token on the secret input)'}


def cluster_join(args):
    """This node joins a cluster: the CA of the master is checked by its fingerprint, then the request goes over TLS that
    trusts only that CA, with the one-time token on the secret input."""
    cluster, base, state = _cluster_parts()
    if state:
        raise EfaError('This node is in a cluster already.')
    name, address = args.name.strip().lower(), args.address.strip()
    if not cluster.valid_name(name) or not HOST_RE.match(address):
        raise EfaError('Name: small letters, digits and dashes; address: where the master reaches this node.')
    host, port = _host_port(args.master, cluster.PORT)
    token = _secrets(1, 'Token')[0].strip()
    try:
        ca = cluster.fetch_ca(host, port)
    except (OSError, ValueError, KeyError) as err:
        raise EfaError(f'The master does not answer: {err}')
    if cluster.fingerprint_pem(ca) != args.ca_fingerprint.strip().upper():
        raise EfaError('The CA of the master does not have the fingerprint you gave: not joined. Check the address and the fingerprint.')
    own_port = int((getattr(args, 'port', '') or '').strip() or cluster.PORT)
    os.makedirs(base, mode=0o700, exist_ok=True)
    try:
        csr = cluster.make_request(base, name)
        result = cluster.join_request(host, port, ca, {'token': token, 'name': name, 'host': address, 'port': own_port, 'csr': csr})
    except urllib.error.HTTPError as err:
        shutil.rmtree(base, ignore_errors=True)
        raise EfaError(f'The master refused: {err.read().decode("utf-8", "replace")[:200]}')
    except (OSError, RuntimeError, ValueError) as err:
        shutil.rmtree(base, ignore_errors=True)
        raise EfaError(f'Not joined: {err}')
    if result.get('ca') != ca:
        shutil.rmtree(base, ignore_errors=True)
        raise EfaError('The master answered with another CA: not joined.')
    _write(os.path.join(base, 'ca.crt'), ca)
    _write(os.path.join(base, 'node.crt'), result['cert'])
    cluster.write_state({'role': 'client', 'name': name, 'port': own_port,
                         'master': {'name': result.get('master'), 'host': host, 'port': port, 'fingerprint': result['master_fingerprint']}}, ETC)
    _cluster_service(True)
    try:
        synced = cluster_resync(None)
    except EfaError as err:  # joined; the sync can run again with cluster-resync
        synced = {'error': str(err)}
    return {**cluster_status(None), 'sync': synced}


def cluster_node_remove(args):
    """The master forgets a node: its certificate is no longer taken, whatever it says."""
    cluster, _base, state = _cluster_parts()
    if state.get('role') != 'master':
        raise EfaError('Only the master removes nodes.')
    if state.get('nodes', {}).pop(args.name.strip().lower(), None) is None:
        raise EfaError('No such node.')
    cluster.write_state(state, ETC)
    return cluster_status(None)


def cluster_promote(args):
    """9g-b: a client becomes the master of a new cluster, by hand, when the old master is gone. It makes its own new CA, so
    the CA key stays in one place; the other nodes join it anew, the old master leaves its cluster before it does."""
    _confirm(args)
    cluster, base, state = _cluster_parts()
    if state.get('role') != 'client':
        raise EfaError('Only a client takes over; this node is not one.')
    master = state['master']
    for attempt in range(3):
        try:
            cluster.call(base, master['host'], master['port'], '/v1/status', timeout=5)
            raise EfaError(f"The master {master.get('name')} answers: no take-over while it runs (that would make two masters).")
        except (OSError, ValueError):
            time.sleep(0 if attempt == 2 else 3)
    kept = f"{base}-before-promote-{time.strftime('%Y%m%d%H%M%S')}"
    shutil.copytree(base, kept)
    _cluster_service(False)
    shutil.rmtree(base)
    result = cluster_init(argparse.Namespace(name=state['name'], mode=state.get('mode', 'master-client')))
    _audit(f"cluster: {state['name']} took over from the master {master.get('name')}, which did not answer, by {_dmarc_who()}")
    return {**result, 'kept': kept,
            'next': ['On each other node: efactl cluster-leave --confirm yes, then efactl cluster-join with a token of this node.',
                     f"On the old master {master.get('name')}, once it is back: efactl cluster-leave --confirm yes before it joins this node."]}


def cluster_leave(args):
    """This node leaves the cluster: its certificates and keys are removed. On the master the whole cluster ends."""
    _confirm(args)
    _cluster, base, state = _cluster_parts()
    if not state:
        raise EfaError('Not in a cluster.')
    _cluster_service(False)
    shutil.rmtree(base, ignore_errors=True)
    return {'role': 'none', 'left': state.get('name')}


def disclaimer_status(_args):
    """Disclaimers per domain, and whether the milter runs."""
    state = _json_read(OUTBOUND_FILE, {'domains': {}})
    domains = state.get('domains', {})
    if identity_now and identity_now['domains'] is not None:
        domains = {key: value for key, value in domains.items() if key in identity_now['domains']}
    templates = [{key: item.get(key) for key in ('id', 'name', 'scope', 'target', 'groups', 'format', 'priority', 'enabled', 'valid_from', 'valid_until')}
                 | {'media': len(item.get('media') or []), 'attachments': len(item.get('attachments') or [])}
                 for item in state.get('disclaimers', []) if _disclaimer_visible(item)]
    return {'domains': [{'domain': key, 'text': value.get('text', ''), 'html': bool(value.get('html'))} for key, value in sorted(domains.items())],
            'templates': templates, 'milter_in_chain': OUTBOUND_PORT in _milter_ports_now()}


def disclaimer_set(args):
    """The disclaimer of a domain for outgoing mail, as text and optionally as HTML. Empty text removes it."""
    domain = args.domain.strip().lower()
    if not DOMAIN_RE.match(domain):
        raise EfaError('Invalid domain.')
    if identity_now and identity_now['domains'] is not None and domain not in identity_now['domains']:
        raise EfaError('Not allowed: name one of your own domains.')
    text = (args.text or '').replace('\\n', '\n').strip()
    html = (args.html or '').strip()
    if len(text) > 2000 or len(html) > 5000 or re.search(r'<\s*(script|iframe|object|embed|form)\b|\bon\w+\s*=|javascript:', html, re.I):
        raise EfaError('Text up to 2000 characters, HTML up to 5000 and without scripts, frames, forms or event handlers.')
    state = _json_read(OUTBOUND_FILE, {})
    state.setdefault('domains', {})
    if text:
        state['domains'][domain] = {'text': text, 'html': html}
    else:
        state['domains'].pop(domain, None)
    _outbound_write(state)
    return disclaimer_status(None)


# 8k: disclaimer templates for all domains, a tenant, a domain or groups of senders in a domain (efa_disclaimer.py). The
# templates are in outbound.json, their pictures and attachments in DISCLAIMER_DIR/<id>/, the older versions in <id>.1, <id>.2.
# Below /etc: the cluster journal hands the folder to the nodes (CLUSTER_DISCLAIMER), each builds its outbound.json from it.
DISCLAIMER_DIR = ETC + '/eFa/disclaimers'
LEGAL_ACCEPTED = ETC + '/eFa/legal-accepted.json'
DISCLAIMER_CHANGED = []  # a provisioning call that changed something; only then the nodes get the folder
DISCLAIMER_KEEP = 3
DISCLAIMER_MAX = 200


def _disclaimer_allowed(template):
    """All domains only the main admin, a tenant its admins, a domain or its groups the admins of the domain."""
    if not identity_now or identity_now['domains'] is None:
        return
    if template['scope'] == 'global':
        raise EfaError('Not allowed: a disclaimer for all domains is for the main admin.')
    if template['scope'] == 'tenant':
        if _tenant_id(template['target']) not in (identity_now['tenant_ids'] or []):
            raise EfaError('Not allowed: name your own tenant.')
    elif template['target'] not in identity_now['domains']:
        raise EfaError('Not allowed: name one of your own domains.')


def _disclaimer_visible(template):
    if not identity_now or identity_now['domains'] is None:
        return True
    if template['scope'] == 'tenant':
        return any(_tenant_of_domain(domain) in (identity_now['tenant_ids'] or []) for domain in identity_now['domains']
                   if template['target'] == _tenant_name_of_domain(domain))
    return template['scope'] == 'global' or template['target'] in identity_now['domains']


def _tenant_name_of_domain(domain):
    rows = _admin_query('SELECT t.name FROM tenants t JOIN tenant_domains d ON d.tenant_id = t.id WHERE d.domain = %s', (domain.lower(),))
    return rows[0]['name'].lower() if rows else ''


def _disclaimer_files(template_id):
    folder = f'{DISCLAIMER_DIR}/{template_id}'
    return {name: open(f'{folder}/{name}', 'rb').read() for name in os.listdir(folder) if name != 'template.json'} if os.path.isdir(folder) else {}


def _disclaimer_store(template, files):
    """The files of a template in a new folder, then the switch; the last versions stay for the way back."""
    os.makedirs(DISCLAIMER_DIR, mode=0o755, exist_ok=True)
    folder = f'{DISCLAIMER_DIR}/{template["id"]}'
    new = folder + '.new'
    shutil.rmtree(new, ignore_errors=True)
    os.makedirs(new, mode=0o755)
    for name, content in files.items():
        with open(f'{new}/{name}', 'wb') as f:
            f.write(content)
        os.chmod(f'{new}/{name}', 0o644)  # the milter runs as a dynamic user; a disclaimer goes out with every mail anyway
    _json_write(new + '/template.json', template)
    _disclaimer_shift(folder)
    os.replace(new, folder)


def _disclaimer_shift(folder):
    shutil.rmtree(f'{folder}.{DISCLAIMER_KEEP}', ignore_errors=True)
    for number in range(DISCLAIMER_KEEP - 1, 0, -1):
        if os.path.exists(f'{folder}.{number}'):
            os.replace(f'{folder}.{number}', f'{folder}.{number + 1}')
    if os.path.exists(folder):
        os.replace(folder, folder + '.1')


def _disclaimer_put(template, files):
    """Checks a template, stores it with its files and puts it into the milter."""
    lib = _lib('efa_disclaimer')
    problem = lib.template_problem(template)
    if problem:
        raise EfaError(problem)
    if template['scope'] in ('domain', 'group') and not DOMAIN_RE.match(template['target']):
        raise EfaError('Target: a domain.')
    if template['scope'] == 'tenant':
        _tenant_id(template['target'])
    _disclaimer_allowed(template)
    state = _json_read(OUTBOUND_FILE, {})
    others = [item for item in state.get('disclaimers', []) if item['id'] != template['id']]
    if len(others) >= DISCLAIMER_MAX:
        raise EfaError(f'Up to {DISCLAIMER_MAX} disclaimers.')
    _disclaimer_store(template, files)
    state['disclaimers'] = sorted(others + [template], key=lambda item: item['id'])
    _outbound_write(state)
    DISCLAIMER_CHANGED.append(template['id'])
    _audit(f"disclaimer {template['id']} ({template['scope']} {template.get('target') or ''}, {template['format']}) set by {_dmarc_who()}")


def _disclaimer_group_members(key):
    """Addresses in a group: ldap:<DN of the directory group> or the name of an eFa-next group."""
    if key.lower().startswith('ldap:'):
        return _rule_group_members(key[5:])
    return [row['username'].lower() for row in _admin_query('SELECT u.username FROM user_groups u JOIN efa_groups g ON g.id = u.group_id WHERE g.name = %s',
                                                             (key,)) if '@' in row['username']]


def _disclaimer_lookups(state):
    """What the milter needs to pick: the tenant of each domain and the groups of each sender, read now so mail never waits."""
    templates = state.get('disclaimers', [])
    state.pop('tenant_of', None)
    if any(item['scope'] == 'tenant' for item in templates):
        state['tenant_of'] = {row['domain'].lower(): row['name'].lower() for row in
                              _admin_query('SELECT d.domain, t.name FROM tenant_domains d JOIN tenants t ON t.id = d.tenant_id')}
    keys = sorted({key for item in templates if item['scope'] == 'group' for key in item.get('groups', [])})
    if not keys:
        state.pop('sender_groups', None)
        return
    try:
        found = {}
        for key in keys:
            for address in _disclaimer_group_members(key):
                found.setdefault(address, []).append(key)
        state['sender_groups'] = found
    except (OSError, subprocess.SubprocessError, EfaError) as err:  # the directory is away: the last known members stay
        print(f'efactl: disclaimer groups not read, the last ones stay: {err}', file=sys.stderr)


def _disclaimer_args(args, old):
    keep = lambda name: (getattr(args, name, None) or '').strip() if (getattr(args, name, None) or '').strip() else old.get(name, '')  # noqa: E731
    groups = (args.groups or '').strip()
    return {'id': args.id.strip().lower(), 'name': keep('name')[:80], 'scope': keep('scope'), 'target': keep('target').lower(),
            'groups': [item.strip() for item in groups.split(';') if item.strip()] if groups else old.get('groups', []),
            'format': keep('format'), 'text': (args.text or '').replace('\\n', '\n').strip() if args.text is not None else old.get('text', ''),
            'html': (args.html or '').strip() if args.html is not None else old.get('html', ''),
            'priority': int(keep('priority') or 100) if str(keep('priority') or 100).isdigit() else -1,
            'enabled': (args.enabled or '').strip() != 'off' if (args.enabled or '').strip() else old.get('enabled', True),
            'valid_from': keep('valid_from'), 'valid_until': keep('valid_until'),
            'media': old.get('media', []), 'attachments': old.get('attachments', [])}


def disclaimer_template_set(args):
    """A disclaimer for all domains, a tenant, a domain or groups of senders in a domain. Pictures and attachments come with a ZIP
    (disclaimer-import); a change here keeps them."""
    template_id = args.id.strip().lower()
    old = next((item for item in _json_read(OUTBOUND_FILE, {}).get('disclaimers', []) if item['id'] == template_id), {})
    if old:
        _disclaimer_allowed(old)
    template = _disclaimer_args(args, old)
    if template['priority'] < 0:
        raise EfaError('Priority: a number up to 9999.')
    _disclaimer_put(template, _disclaimer_files(template_id) if old else {})
    return disclaimer_status(None)


def disclaimer_template_remove(args):
    """Takes a disclaimer out of the mail; its folder stays as the last version for the way back."""
    template_id = args.id.strip().lower()
    state = _json_read(OUTBOUND_FILE, {})
    template = next((item for item in state.get('disclaimers', []) if item['id'] == template_id), None)
    if template is None:
        raise EfaError(f'No disclaimer {template_id}.')
    _disclaimer_allowed(template)
    state['disclaimers'] = [item for item in state['disclaimers'] if item['id'] != template_id]
    _outbound_write(state)
    _disclaimer_shift(f'{DISCLAIMER_DIR}/{template_id}')
    DISCLAIMER_CHANGED.append(template_id)
    _audit(f'disclaimer {template_id} removed by {_dmarc_who()}')
    return disclaimer_status(None)


def disclaimer_restore(args):
    """The version of a disclaimer before the last change, or the removed one."""
    template_id = args.id.strip().lower()
    folder = f'{DISCLAIMER_DIR}/{template_id}'
    if not _lib('efa_disclaimer').ID_RE.match(template_id) or not os.path.exists(folder + '.1/template.json'):
        raise EfaError(f'No earlier version of {template_id}.')
    template = _json_read(folder + '.1/template.json', {})
    files = _disclaimer_files(template_id + '.1')
    _disclaimer_put(template, files)
    shutil.rmtree(folder + '.2', ignore_errors=True)  # the restored one was .2 after the shift, it is the current one now
    for number in range(3, DISCLAIMER_KEEP + 1):
        if os.path.exists(f'{folder}.{number}'):
            os.replace(f'{folder}.{number}', f'{folder}.{number - 1}')
    return disclaimer_status(None)


def disclaimer_zip_in(data, dry_run):
    """A template from a ZIP: checked whole, then stored, or with dry_run only shown."""
    try:
        template, files = _lib('efa_disclaimer').read_zip(data)
    except ValueError as err:
        raise EfaError(f'ZIP refused, nothing changed: {err}')
    if template['scope'] in ('domain', 'group') and not DOMAIN_RE.match(template['target']):
        raise EfaError('ZIP refused, nothing changed: the target is no domain.')
    if template['scope'] == 'tenant':
        _tenant_id(template['target'])
    _disclaimer_allowed(template)
    preview = {key: template[key] for key in ('id', 'name', 'scope', 'target', 'groups', 'format', 'priority', 'enabled', 'valid_from', 'valid_until')}
    preview.update(media=[item['file'] for item in template['media']], attachments=[item['file'] for item in template['attachments']],
                   bytes=sum(map(len, files.values())), text=template['text'][:300] or _lib('efa_disclaimer').text_of(template['html'])[:300])
    if dry_run:
        return {'dry_run': True, 'template': preview}
    _disclaimer_put(template, files)
    return {'imported': preview}


def disclaimer_import(args):
    """A disclaimer as ZIP (docs/api-disclaimer.md): manifest.json, body.html and/or body.txt, media/, attachments/."""
    import base64 as b64
    if (args.file or '').strip() and os.environ.get('SUDO_USER') == 'efa-web':
        raise EfaError('A file on the host only on the command line.')
    if (args.file or '').strip():
        with open(args.file.strip(), 'rb') as f:
            data = f.read(_lib('efa_disclaimer').MAX_TEMPLATE_BYTES + 1)
    else:
        try:
            data = b64.b64decode(sys.stdin.readline().strip(), validate=True)
        except ValueError:
            raise EfaError('Give the disclaimer as a .zip file.')
    args.file = ''  # the nodes of a cluster get the stored folder, not the file name of this host
    if not data or len(data) > _lib('efa_disclaimer').MAX_TEMPLATE_BYTES:
        raise EfaError('A ZIP of up to 5 MB.')
    return disclaimer_zip_in(data, (args.dry_run or '').strip() == 'on')


def disclaimer_export(args):
    """A disclaimer as ZIP, as disclaimer-import takes it: written to --file, or as base64."""
    import base64 as b64
    template_id = args.id.strip().lower()
    template = next((item for item in _json_read(OUTBOUND_FILE, {}).get('disclaimers', []) if item['id'] == template_id), None)
    if template is None or not _disclaimer_visible(template):
        raise EfaError(f'No disclaimer {template_id}.')
    files = _disclaimer_files(template_id)
    data = _lib('efa_disclaimer').write_zip(template, files.get)
    if (args.file or '').strip() and os.environ.get('SUDO_USER') == 'efa-web':
        raise EfaError('A file on the host only on the command line.')
    if (args.file or '').strip():
        with open(args.file.strip(), 'wb') as f:
            f.write(data)
        return {'id': template_id, 'file': args.file.strip(), 'bytes': len(data)}
    return {'id': template_id, 'zip': b64.b64encode(data).decode(), 'bytes': len(data)}


def disclaimer_which(args):
    """Which disclaimer a sender gets: the most specific one that fits (group, domain, tenant, all domains)."""
    sender = args.sender.strip().lower()
    if not SENDER_RE.match(sender) or '@' not in sender:
        raise EfaError('Sender: a mail address.')
    if identity_now and identity_now['domains'] is not None and sender.rpartition('@')[2] not in identity_now['domains']:
        raise EfaError('Not allowed: a sender of your own domains.')
    state = _json_read(OUTBOUND_FILE, {})
    _disclaimer_lookups(state)
    templates = state.get('disclaimers', []) + legacy_disclaimers(state)
    found = _lib('efa_disclaimer').pick(templates, sender, lambda domain: state.get('tenant_of', {}).get(domain, ''),
                                        lambda address: state.get('sender_groups', {}).get(address, ()))
    if not found:
        return {'sender': sender, 'disclaimer': None}
    return {'sender': sender, 'disclaimer': found['id'], 'name': found.get('name', ''), 'scope': found['scope'], 'format': found['format'],
            'text': found.get('text') or _lib('efa_disclaimer').text_of(found.get('html') or '')}


def disclaimer_provision_apply(args):
    """For efa-dkim-api only: one disclaimer call of a source, {method, id, zip} on stdin; answers {code, body}. A source sets
    only disclaimers of its own domains, or of a tenant all of whose domains are its own, and only the ones it delivered."""
    result, call = _disclaimer_provision(args)
    _audit(f"disclaimer provisioning: {call.get('method', '?')} {str(call.get('id') or '/')[:40]} by the source {args.source.strip()[:40]}: {result['code']}")
    return result


def _disclaimer_public(item):
    return {key: item.get(key) for key in ('id', 'name', 'scope', 'target', 'groups', 'format', 'priority', 'enabled', 'valid_from', 'valid_until')}


def _disclaimer_provision(args):
    import base64 as b64
    call, state, source = {}, _provision_state(), args.source.strip()
    if state['mode'] != 'on':
        return {'code': 403, 'body': {'error': 'the provisioning is off'}}, call
    if source not in state['sources']:
        return {'code': 401, 'body': {'error': 'unknown source'}}, call
    if 'disclaimer' not in (state['sources'][source].get('rights') or ['dkim']):
        return {'code': 403, 'body': {'error': 'this source has no right for disclaimer'}}, call
    try:
        call = json.loads(sys.stdin.read(8 * 1024 * 1024))
    except ValueError:
        return {'code': 400, 'body': {'error': 'no valid JSON'}}, call
    call = call if isinstance(call, dict) else {}
    method, template_id = call.get('method'), str(call.get('id') or '').strip().lower()
    templates = _json_read(OUTBOUND_FILE, {}).get('disclaimers', [])
    mine = {item['id']: item for item in templates if item.get('source') == source}
    if method == 'GET':
        if not template_id:
            return {'code': 200, 'body': {'disclaimers': [_disclaimer_public(item) for _key, item in sorted(mine.items())]}}, call
        return ({'code': 200, 'body': _disclaimer_public(mine[template_id])} if template_id in mine else {'code': 404, 'body': {'error': 'not delivered'}}), call
    if method == 'DELETE':
        if template_id not in mine:
            return {'code': 404, 'body': {'error': 'not delivered'}}, call
        disclaimer_template_remove(argparse.Namespace(id=template_id))
        return {'code': 200, 'body': {'id': template_id, 'removed': True}}, call
    if method != 'PUT':
        return {'code': 405, 'body': {'error': 'GET, PUT or DELETE'}}, call
    try:
        template, files = _lib('efa_disclaimer').read_zip(b64.b64decode(call.get('zip') or '', validate=True))
    except ValueError as err:
        return {'code': 400, 'body': {'error': f'ZIP refused: {err}'}}, call
    if template['id'] != template_id:
        return {'code': 400, 'body': {'error': 'the id in manifest.json differs from the address'}}, call
    if any(item['id'] == template_id and item.get('source') != source for item in templates):
        return {'code': 409, 'body': {'error': 'this id belongs to another source or to the admins'}}, call
    own = set(state['sources'][source].get('domains') or [])
    if template['scope'] == 'global':
        return {'code': 403, 'body': {'error': 'a source cannot set a disclaimer for all domains'}}, call
    if template['scope'] == 'tenant':
        domains = {row['domain'] for row in _admin_query('SELECT d.domain FROM tenant_domains d JOIN tenants t ON t.id = d.tenant_id WHERE t.name = %s',
                                                         (template['target'],))}
        if not domains or not domains <= own:
            return {'code': 403, 'body': {'error': 'not all domains of this tenant belong to the source'}}, call
    elif template['target'] not in own:
        return {'code': 403, 'body': {'error': 'not a domain of this source'}}, call
    template['source'] = source
    try:
        _disclaimer_put(template, files)
    except EfaError as err:
        return {'code': 400, 'body': {'error': str(err)}}, call
    return {'code': 200, 'body': _disclaimer_public(template)}, call


def disclaimer_sync(_args):
    """On a cluster node: the disclaimers as the master has them in its folder, into the milter of this node."""
    lib = _lib('efa_disclaimer')
    found = []
    for name in sorted(os.listdir(DISCLAIMER_DIR)) if os.path.isdir(DISCLAIMER_DIR) else []:
        path = f'{DISCLAIMER_DIR}/{name}/template.json'
        if lib.ID_RE.match(name) and os.path.exists(path):
            template = _json_read(path, {})
            if template.get('id') == name and lib.template_problem(template) is None:
                found.append(template)
    state = _json_read(OUTBOUND_FILE, {})
    state['disclaimers'] = found
    _outbound_write(state)
    return {'disclaimers': [item['id'] for item in found]}


def legal_status(_args):
    """The legal texts of this version (5y): their digest, where they are, and the confirmation that holds for them."""
    lib = _lib('efa_legal')
    now = lib.current()
    found = lib.accepted(LEGAL_ACCEPTED, now)
    return {'digest': now, 'texts': [f'{lib.FOLDER}/{name}' for name in lib.NAMES], 'pdf': f'{lib.FOLDER}/{lib.ALL_PDF}',
            'accepted': bool(found), 'accepted_by': (found or {}).get('who', ''), 'accepted_at': (found or {}).get('when', ''),
            'warnings': [] if found or not now else ['The legal texts of this version are not confirmed yet: the next admin login asks for it.']}


def legal_accept(args):
    """Notes the confirmation of the legal texts: the digest must be the one of the installed texts. Kept with time, who,
    from where and the version, and in the audit log."""
    lib = _lib('efa_legal')
    now = lib.current()
    given = (args.digest or '').strip().lower()
    if not now:
        raise EfaError(f'The legal texts are missing in {lib.FOLDER}.')
    if given != now:
        raise EfaError(f'The digest does not match the legal texts of this version ({now}).')
    if (args.confirm or '').strip().lower() not in ('ja', 'yes'):
        raise EfaError('Confirm with ja or yes: qualified administrator, no consumer, texts read and accepted.')
    who = acting_user or ('admin (web)' if os.environ.get('SUDO_USER') == 'efa-web' else f"console ({os.environ.get('SUDO_USER') or 'root'})")
    client = (acting_client or 'console').strip()[:45]
    entry = {'digest': now, 'when': time.strftime('%Y-%m-%d %H:%M:%S %z'), 'who': who, 'from': client, 'version': _efa_version()}
    _json_write(LEGAL_ACCEPTED, entry)
    os.chmod(LEGAL_ACCEPTED, 0o644)  # efa-web reads it before each admin page; it holds no secret
    _audit(f'legal texts {now} confirmed by {who} from {client}: qualified administrator, no consumer')
    return legal_status(None)


def legacy_disclaimers(state):
    """The disclaimers of before 8k (disclaimer-set, one per domain) as domain templates."""
    return [{'id': f'domain-{domain}'[:40], 'scope': 'domain', 'target': domain, 'format': 'html' if item.get('html') else 'text',
             'text': item.get('text', ''), 'html': item.get('html', ''), 'priority': 100} for domain, item in sorted(state.get('domains', {}).items())]


def dlp_status(_args):
    """Data loss prevention of outgoing mail: the rules and what each does."""
    dlp = {**DLP_DEFAULTS, **_json_read(OUTBOUND_FILE, {}).get('dlp', {})}
    return {**dlp, 'milter_in_chain': OUTBOUND_PORT in _milter_ports_now()}


def _dlp_action(value, keep):
    value = (value or '').strip()
    if not value:
        return keep
    if value not in DLP_ACTIONS:
        raise EfaError('Action: off, log, encrypt, hold or reject.')
    if value == 'encrypt' and not shutil.which('qpdf'):
        raise EfaError('Encryption needs qpdf: install the package qpdf first.')
    return value


def _dlp_ignore(text):
    """Own IBANs, comma separated, spaces inside allowed; - for none."""
    ignore = [] if text.strip() == '-' else sorted({re.sub(r'\s', '', item).upper() for item in re.split(r'[,;\n]+', text) if item.strip()})
    bad = [item for item in ignore if not IBAN_RE.match(item)]
    if bad:
        raise EfaError(f'No IBAN: {", ".join(bad)}')
    return ignore


def dlp_set(args):
    """What happens to outgoing mail with card numbers or IBANs, and the own IBANs that may leave."""
    state = _json_read(OUTBOUND_FILE, {})
    dlp = {**DLP_DEFAULTS, **state.get('dlp', {})}
    dlp['cards'] = _dlp_action(args.cards, dlp['cards'])
    dlp['iban'] = _dlp_action(args.iban, dlp['iban'])
    dlp['ids'] = _dlp_action(args.ids, dlp['ids'])
    if args.ignore is not None and args.ignore.strip() != '':
        dlp['ignore'] = _dlp_ignore(args.ignore)
    state['dlp'] = dlp
    _outbound_write(state)
    return dlp_status(None)


def dlp_rule_set(args):
    """An own rule: a search pattern in subject, text and text attachments of outgoing mail. Empty pattern removes the rule."""
    name, pattern = args.name.strip().lower(), (args.pattern or '').strip()
    if not DLP_NAME_RE.match(name) or name in ('cards', 'iban'):
        raise EfaError('Name: up to 32 small letters, digits, - or _, not cards or iban.')
    state = _json_read(OUTBOUND_FILE, {})
    dlp = {**DLP_DEFAULTS, **state.get('dlp', {})}
    rules = [rule for rule in dlp['rules'] if rule['name'] != name]
    if pattern:
        # A search pattern of the admin runs on every outgoing mail: short, and no nested repeats that can take forever.
        if len(pattern) > 200 or re.search(r'\([^)]*[+*}]\)[+*{]', pattern):
            raise EfaError('Pattern: up to 200 characters, without nested repeats such as (a+)+.')
        try:
            re.compile(pattern, re.I)
        except re.error as err:
            raise EfaError(f'Pattern does not work: {err}')
        rules.append({'name': name, 'pattern': pattern, 'action': _dlp_action(args.action, 'log')})
    if len(rules) > 50:
        raise EfaError('Up to 50 own rules.')
    dlp['rules'] = sorted(rules, key=lambda rule: rule['name'])
    state['dlp'] = dlp
    _outbound_write(state)
    return dlp_status(None)


def _pdf_passwords_write(passwords):
    fd = os.open(PDF_PASSWORDS + '.new', os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, 'w') as f:
        json.dump(passwords, f)
    os.replace(PDF_PASSWORDS + '.new', PDF_PASSWORDS)


def pdf_status(_args):
    """Mail as encrypted PDF: the keyword in the subject, and who has an agreed password (the passwords stay hidden)."""
    state = _json_read(OUTBOUND_FILE, {})
    agreed = sorted(_json_read(PDF_PASSWORDS, {})) if os.path.exists(PDF_PASSWORDS) else []
    if identity_now and identity_now['domains'] is not None:
        agreed = [item for item in agreed if item.rpartition('@')[2] in identity_now['domains']]
    return {'keyword': state.get('pdf', {}).get('keyword', ''), 'qpdf_installed': bool(shutil.which('qpdf')), 'agreed_passwords': agreed,
            'milter_in_chain': OUTBOUND_PORT in _milter_ports_now()}


def pdf_set(args):
    """The keyword in the subject that sends a mail as encrypted PDF; - for none. DLP rules can ask for it too (action encrypt)."""
    keyword = (args.keyword or '').strip()
    if keyword != '-' and not PDF_KEYWORD_RE.match(keyword):
        raise EfaError('Keyword: 3 to 30 characters without spaces, such as [secure]; - for none.')
    if keyword != '-' and not shutil.which('qpdf'):
        raise EfaError('Encryption needs qpdf: install the package qpdf first.')
    state = _json_read(OUTBOUND_FILE, {})
    state['pdf'] = {**state.get('pdf', {}), 'keyword': '' if keyword == '-' else keyword}
    _outbound_write(state)
    return pdf_status(None)


def pdf_password_set(args):
    """The password agreed with a recipient (address or whole domain), asked twice. Empty removes it: then the sender gets one per mail."""
    recipient = args.recipient.strip().lower()
    if not (DOMAIN_RE.match(recipient) or SENDER_RE.match(recipient)):
        raise EfaError('Recipient: a mail address or a domain.')
    first, second = _secrets(2, 'Password, then again')
    if first != second:
        raise EfaError(PASSWORD_DIFFER + ' Nothing was changed.')
    if first and len(first) < 10:
        raise EfaError('Password: at least 10 characters.')
    passwords = _json_read(PDF_PASSWORDS, {}) if os.path.exists(PDF_PASSWORDS) else {}
    if first:
        passwords[recipient] = first
    else:
        passwords.pop(recipient, None)
    _pdf_passwords_write(passwords)
    # systemd hands the file over at the start only.
    try:
        _platform().service_try_restart(OUTBOUND_UNIT)
    except Exception as err:  # the StepError of the platform layer
        raise EfaError(f'Saved, but the outbound milter did not restart: {err}')
    return pdf_status(None)


def links_status(_args):
    """The link check: on or off, the address links lead over, the domains left as they are. The key is never shown."""
    links = content_state()['links']
    return {key: value for key, value in links.items() if key != 'key'}


def links_set(args):
    """Rewrite links in incoming mail to the check of this server, which looks at them again on each click. Off by default."""
    state = content_state()
    links = state['links']
    links['enabled'] = _on_off(args.mode)
    base = (args.base or '').strip().rstrip('/') or links['base'] or uq_state().get('public_url', '')
    if links['enabled'] and not base:
        raise EfaError('The public https address of this server is needed, for the links.')
    links['base'] = https_url(base) if base else ''
    if (args.allow_continue or '').strip():
        links['continue'] = _on_off(args.allow_continue)
    unchecked = (getattr(args, 'unchecked', '') or '').strip()
    if unchecked:
        if unchecked not in LINK_UNCHECKED:
            raise EfaError('When rspamd does not answer: page, follow or block.')
        links['unchecked'] = unchecked
    for field, change in (('add', set.union), ('remove', set.difference)):
        items = {item.strip().lower() for item in (getattr(args, field, '') or '').replace(',', ' ').split()}
        if any(not DOMAIN_RE.match(item) for item in items):
            raise EfaError('Exceptions are domains, such as partner.example.')
        links['exceptions'] = sorted(change(set(links['exceptions']), items))
    links.setdefault('key', secrets.token_hex(32))
    _content_apply(state)
    return links_status(None)


def _qpdf_install(platform_now):
    """qpdf from the repository, only it and what it needs, and only if no package script would touch firewalld."""
    if platform_now.package_installed('qpdf'):
        return 'present'
    if update_window_wait(datetime.datetime.now()):
        raise EfaError(f'qpdf is installed only between minute {UPDATE_WINDOW[0]} and {UPDATE_WINDOW[1]}, like every package.')
    folder = tempfile.mkdtemp(prefix='efa-qpdf-', dir='/var/tmp')
    try:
        files = platform_now.package_fetch(['qpdf'], folder)
        risky = [line for path in files for line in firewall_script_lines(platform_now.package_scripts(path))]
        if risky:
            raise EfaError(f'Not installed: a package script would touch firewalld: {risky[0][:160]}')
        platform_now.package_install(files)
    finally:
        shutil.rmtree(folder, ignore_errors=True)
    return 'installed'


def cdr_set(args):
    """Switch content disarm. On installs qpdf if needed, starts the milter and puts it right after rspamd."""
    on = _on_off(args.mode)
    qpdf = None
    if on:
        try:
            qpdf = _qpdf_install(_platform())
        except EfaError:
            raise
        except Exception as err:  # the StepError of the platform layer
            raise EfaError(str(err))
    state = content_state()
    state['cdr'] = on
    _content_apply(state)
    return {**cdr_status(None), 'qpdf_install': qpdf}


def cdr_list(_args):
    """Originals of disarmed mail, newest first: sender, recipients and what was done."""
    rows = []
    for path in sorted(glob.glob(CDR_STORE + '/*.json'), reverse=True)[:200]:
        info = _json_read(path, {})
        rows.append({'id': os.path.basename(path)[:-5], 'ts': info.get('ts'), 'sender': info.get('sender'), 'rcpts': ', '.join(info.get('rcpts', [])),
                     'done': '; '.join(info.get('done', []))})
    return {'originals': rows}


def cdr_release(args):
    """Deliver the original of a disarmed mail, unchanged, to its recipients. It does not pass the filters again."""
    _confirm(args)
    key = args.id.strip()
    if not CDR_KEY_RE.match(key) or not os.path.exists(f'{CDR_STORE}/{key}.json'):
        raise EfaError('No such original.')
    info = _json_read(f'{CDR_STORE}/{key}.json', {})
    rcpts = [rcpt for rcpt in info.get('rcpts', []) if SENDER_RE.match(rcpt)]
    if not rcpts:
        raise EfaError('The original names no recipient.')
    with open(f'{CDR_STORE}/{key}.eml', 'rb') as f:
        done = subprocess.run(['sendmail', '-i', '-f', info.get('sender') or '', '--', *rcpts], stdin=f, capture_output=True, timeout=60)
    if done.returncode != 0:
        raise EfaError(f'sendmail failed: {done.stderr.decode("utf-8", "replace")[-200:]}')
    for ending in ('.eml', '.json'):
        os.remove(f'{CDR_STORE}/{key}{ending}')
    _audit(f'disarmed original {key} delivered to {", ".join(rcpts)} by {_dmarc_who()}')
    return {'delivered': key, 'rcpts': rcpts}


def _cdr_job():
    """Hourly: originals older than the days to keep are removed."""
    cutoff = time.time() - retention('cdr') * 86400
    for path in glob.glob(CDR_STORE + '/*.json'):
        if os.path.getmtime(path) < cutoff:
            for item in (path, path[:-5] + '.eml'):
                if os.path.exists(item):
                    os.remove(item)


# The neural network of rspamd: it learns from mail with clear scores by itself. eFa-next only sets how much and how strongly.
NEURAL_CONF = RSPAMD_DIR + '/local.d/neural.conf'
NEURAL_GROUP_CONF = RSPAMD_DIR + '/local.d/neural_group.conf'
NEURAL_DEFAULTS = {'enabled': None, 'max_trains': 1000, 'max_usages': 20, 'score_spam': 3.0, 'score_ham': -2.0}
NEURAL_FILE = ETC + '/eFa/neural.json'
TRAIN_PER_DAY = 50


def neural_state():
    return {**NEURAL_DEFAULTS, **_json_read(NEURAL_FILE, {})}


def neural_texts(state):
    """The rspamd settings of the neural module and the scores of its two symbols."""
    conf = (f"enabled = {'true' if state['enabled'] else 'false'};\nrules {{\n  default {{\n    train {{\n"
            f"      max_trains = {state['max_trains']};\n      max_usages = {state['max_usages']};\n    }}\n"
            f'    symbol_spam = "NEURAL_SPAM";\n    symbol_ham = "NEURAL_HAM";\n  }}\n}}\n')
    group = (f'symbols = {{\n  "NEURAL_SPAM" {{ weight = {state["score_spam"]}; description = "Neural network: spam"; }}\n'
             f'  "NEURAL_HAM" {{ weight = {state["score_ham"]}; description = "Neural network: ham"; }}\n}}\n')
    return conf, group


def neural_status(_args):
    """The neural network: on or off, how many mails it has collected to learn from, and whether it has learned."""
    state = neural_state()
    sets, trained = {}, 0
    done = subprocess.run(['redis-cli', '--raw', '--scan', '--pattern', 'rn_*'], capture_output=True, text=True, timeout=30)
    for key in done.stdout.split():
        if key.endswith(('_spam_set', '_ham_set')):
            size = subprocess.run(['redis-cli', '--raw', 'SCARD', key], capture_output=True, text=True, timeout=30).stdout.strip()
            kind = 'spam' if key.endswith('_spam_set') else 'ham'
            sets[kind] = sets.get(kind, 0) + int(size or 0)
        else:
            trained += 1
    return {**state, 'enabled': state['enabled'] if state['enabled'] is not None else 'rspamd default', 'collected_spam': sets.get('spam', 0),
            'collected_ham': sets.get('ham', 0), 'trained_networks': trained,
            'note': 'It learns once it has collected max_trains mails of each kind, then again as new ones come.'}


def neural_settings(_args):
    """The settings of the neural network from the configuration of eFa-next only: for the form, without counting in redis."""
    state = neural_state()
    return {**state, 'enabled': state['enabled'] if state['enabled'] is not None else 'rspamd default'}


def neural_set(args):
    """Switch the neural network and set how much it collects before it learns, and the weight of its result."""
    state = neural_state()
    state['enabled'] = _on_off(args.mode)
    for key, low, high, kind in (('max_trains', 100, 100000, int), ('max_usages', 1, 1000, int), ('score_spam', 0, 20, float), ('score_ham', -20, 0, float)):
        value = (getattr(args, key, '') or '').strip()
        if value:
            try:
                number = kind(value)
            except ValueError:
                raise EfaError(f'{key}: a number.')
            if not low <= number <= high:
                raise EfaError(f'{key}: {low} to {high}.')
            state[key] = number
    conf, group = neural_texts(state)
    old = [open(path).read() if os.path.exists(path) else None for path in (NEURAL_CONF, NEURAL_GROUP_CONF)]
    _write(NEURAL_CONF, conf)
    _write(NEURAL_GROUP_CONF, group)
    if not _rspamd_config_ok():
        for path, text in zip((NEURAL_CONF, NEURAL_GROUP_CONF), old):
            if text is None:
                os.remove(path)
            else:
                _write(path, text)
        raise EfaError('rspamd rejected the settings, nothing changed.')
    _json_write(NEURAL_FILE, state)
    _reload_rspamd()
    return neural_status(None)


def _train_message(source, ref):
    """The raw mail a training request is about: held mail of a user, mail in the quarantine of the mail queue, or a reported one."""
    if source == 'phish':
        rows = _admin_query("SELECT raw FROM train_requests WHERE id = %s AND source = 'phish'", (int(ref),)) if str(ref).isdigit() else []
        if not rows or not rows[0]['raw']:
            raise EfaError('The reported mail is gone.')
        raw = zlib.decompress(rows[0]['raw'])
        head = raw.split(b'\n\n', 1)[0].decode('utf-8', 'replace')
        sender = re.search(r'^From:\s*(.*)$', head, re.M | re.I)
        subject = re.search(r'^Subject:\s*(.*)$', head, re.M | re.I)
        return raw, sender.group(1)[:255] if sender else '', subject.group(1)[:500] if subject else ''
    if source == 'uq':
        item = _uq_item(ref, None, ('held', 'requested', 'released', 'deleted'))
        return _uq_read(item['mail_id']), item['sender'], item['subject']
    if not re.fullmatch(r'[A-Za-z0-9]{5,20}', ref):
        raise EfaError('Invalid queue ID.')
    done = subprocess.run(['postcat', '-hbq', ref], capture_output=True, timeout=30)
    if done.returncode != 0:
        raise EfaError('This mail is not in quarantine.')
    head = done.stdout.split(b'\n\n', 1)[0].decode('utf-8', 'replace')
    sender = re.search(r'^From:\s*(.*)$', head, re.M | re.I)
    subject = re.search(r'^Subject:\s*(.*)$', head, re.M | re.I)
    return done.stdout, sender.group(1)[:255] if sender else '', subject.group(1)[:500] if subject else ''


# Phishing reports: addresses of the domains go to a pipe that keeps the reported mails for the decision of an admin.
PHISH_FILE = ETC + '/eFa/phish.json'
PHISH_TRANSPORT = ETC + '/postfix/efa-phish-transport'
PHISH_SERVICE = 'efa-phish'
PHISH_MASTER = 'efa-phish unix - n n - 4 pipe flags=Rq user=efa-web argv=/usr/bin/python3 /usr/local/sbin/efa-phish.py ${sender}'
PHISH_KEEP_DAYS = 30
BANNER_DEFAULTS = {'enabled': False, 'text': '', 'unsigned_only': True, 'exceptions': []}


def phish_set(args):
    """A report address of a domain, such as phishing@example.org: users forward suspicious mail there, an admin decides."""
    action, address = args.action.strip(), (args.address or '').strip().lower()
    if action not in ('add', 'remove') or not SENDER_RE.match(address):
        raise EfaError("Action 'add' or 'remove', and an address such as phishing@example.org.")
    if identity_now and identity_now['domains'] is not None and address.rpartition('@')[2] not in identity_now['domains']:
        raise EfaError('Not allowed: name one of your own domains.')
    state = _json_read(PHISH_FILE, {'addresses': []})
    addresses = set(state['addresses'])
    addresses = addresses | {address} if action == 'add' else addresses - {address}
    state['addresses'] = sorted(addresses)
    if state['addresses']:
        subprocess.run(['postconf', '-M', f'{PHISH_SERVICE}/unix={PHISH_MASTER}'], check=True, capture_output=True)
    _rule_map(PHISH_TRANSPORT, [f'{item} {PHISH_SERVICE}:' for item in state['addresses']])
    if not state['addresses']:
        subprocess.run(['postconf', '-MX', f'{PHISH_SERVICE}/unix'], check=False, capture_output=True)
    wanted = rule_map_value(_postconf('transport_maps'), PHISH_TRANSPORT, bool(state['addresses']))
    if wanted != _postconf('transport_maps'):
        _postconf_set('transport_maps', wanted)
    subprocess.run(['postfix', 'reload'], check=False, capture_output=True)
    _json_write(PHISH_FILE, state)
    return {'addresses': state['addresses'], 'note': 'Reports appear under Spam reports; Bayes learns from the ones an admin approves.'}


def _milter_ports():
    """The milter ports Postfix calls (inet:127.0.0.1:PORT in smtpd_milters), without the health milter itself."""
    out = subprocess.run(['postconf', '-h', 'smtpd_milters'], capture_output=True, text=True).stdout
    return [p for p in re.findall(r'inet:127\.0\.0\.1:(\d+)', out) if p != '8999']


def milter_health_status(_args):
    """Which milters turn mail away when they are down (tempfail), and which only let it pass (accept, the default)."""
    chosen = set(_json_read(MILTER_HEALTH_FILE, {}).get('tempfail', []))
    ports = _milter_ports()
    return {'milter_default_action': 'accept', 'milters': [{'port': p, 'action': 'tempfail' if p in chosen else 'accept'} for p in ports],
            'tempfail': sorted(p for p in chosen if p in ports)}


def milter_health_set(args):
    """Per milter: accept (let mail pass when it is down, the default) or tempfail (turn mail away with a retryable 4xx)."""
    port, action = (args.milter or '').strip(), (args.action or '').strip()
    if port not in _milter_ports():
        raise EfaError('Name a milter port that Postfix calls. See milter-health-status.')
    if action not in ('accept', 'tempfail'):
        raise EfaError("Action must be 'accept' or 'tempfail'.")
    chosen = {p for p in _json_read(MILTER_HEALTH_FILE, {}).get('tempfail', []) if p in _milter_ports()}
    chosen = chosen | {port} if action == 'tempfail' else chosen - {port}
    _json_write(MILTER_HEALTH_FILE, {'tempfail': sorted(chosen)})
    os.chmod(MILTER_HEALTH_FILE, 0o640)
    try:
        shutil.chown(MILTER_HEALTH_FILE, 'root', 'efa-mail')
    except (OSError, LookupError):
        pass  # on the host it is root:efa-mail; the mode 0640 is the guard
    return milter_health_status(None)


def banner_set(args):
    """A warning at the top of incoming mail from outside. By default only on mail without a valid DKIM signature, so no signature breaks."""
    state = content_state()
    banner = {**BANNER_DEFAULTS, **state.get('banner', {})}
    banner['enabled'] = _on_off(args.mode)
    text = ' '.join((args.text or '').split())
    if text:
        if len(text) > 300 or any(ch in text for ch in '<>'):
            raise EfaError('Banner text: up to 300 characters, no < or >.')
        banner['text'] = text
    if (args.unsigned_only or '').strip():
        banner['unsigned_only'] = _on_off(args.unsigned_only)
    for field, change in (('add', set.union), ('remove', set.difference)):
        items = {item.strip().lower() for item in (getattr(args, field, '') or '').replace(',', ' ').split()}
        if any(not DOMAIN_RE.match(item) for item in items):
            raise EfaError('Exceptions are domains, such as partner.example.')
        banner['exceptions'] = sorted(change(set(banner['exceptions']), items))
    state['banner'] = banner
    _content_apply(state)
    return banner


def _phish_job():
    """Hourly: the mails of reports past their days are removed; the rows of the decisions stay."""
    _admin_query("UPDATE train_requests SET raw = NULL WHERE source = 'phish' AND raw IS NOT NULL AND ts < NOW() - INTERVAL %s DAY", (retention('phish'),))


def train_request(args):
    """Report a held mail as spam or as wanted. An admin decides; after that Bayes learns from it."""
    source, ref, verdict = args.source.strip(), args.id.strip(), args.verdict.strip()
    if source not in ('uq', 'quarantine') or verdict not in ('spam', 'ham'):  # phishing reports come from the pipe only
        raise EfaError("Source 'uq' or 'quarantine', verdict 'spam' or 'ham'.")
    if source == 'uq':
        _uq_item(ref, identity_now, ('held', 'requested'))
    elif identity_now and 'quarantine.view' not in identity_now['grants']:
        raise EfaError('Not allowed: this needs the permission quarantine.view.')
    username = identity_now['username'] if identity_now else (acting_user or 'admin')
    today = _admin_query('SELECT COUNT(*) AS n FROM train_requests WHERE username = %s AND ts >= CURDATE()', (username,))[0]['n']
    if today >= TRAIN_PER_DAY:
        raise EfaError(f'At most {TRAIN_PER_DAY} reports a day.')
    if _admin_query("SELECT 1 FROM train_requests WHERE source = %s AND ref = %s AND state = 'pending' LIMIT 1", (source, ref)):
        raise EfaError('This mail is reported already.')
    _raw, sender, subject = _train_message(source, ref)
    _admin_query('INSERT INTO train_requests (username, source, ref, sender, subject, verdict) VALUES (%s, %s, %s, %s, %s, %s)',
                 (username, source, ref, sender, subject, verdict))
    return {'reported': ref, 'verdict': verdict, 'note': 'An admin decides; then the spam filter learns from it.'}


def train_list(args):
    """Reports waiting for a decision, and the last ones decided."""
    state = (args.state or '').strip() or 'pending'
    if state not in ('pending', 'done', 'rejected'):
        raise EfaError("State 'pending', 'done' or 'rejected'.")
    return {'reports': _admin_query('SELECT id, CAST(ts AS CHAR) AS ts, username, source, ref, sender, subject, verdict, state, decided_by, result '
                                    'FROM train_requests WHERE state = %s ORDER BY id DESC LIMIT 200', (state,))}


def rspamc_learn_result(text):
    """The answer of rspamc learn_spam or learn_ham in a few words."""
    if 'already learned' in text:
        return 'learned before'
    if re.search(r'success\s*=\s*true', text):
        return 'learned'
    error = re.search(r'error\s*=\s*"?([^";\n]+)', text)
    return error.group(1)[:250] if error else (text.strip().splitlines() or ['no answer'])[-1][:250]


def train_decide(args):
    """Approve a report, so Bayes learns from the mail, or reject it. The mail itself stays where it is."""
    if not str(args.id).strip().isdigit():
        raise EfaError('Invalid ID.')
    rows = _admin_query("SELECT * FROM train_requests WHERE id = %s AND state = 'pending'", (int(args.id),))
    if not rows:
        raise EfaError('No such report waiting.')
    row, decision = rows[0], args.decision.strip()
    if decision not in ('approve', 'reject'):
        raise EfaError("Decision 'approve' or 'reject'.")
    result = 'rejected'
    if decision == 'approve':
        raw, _sender, _subject = _train_message(row['source'], row['id'] if row['source'] == 'phish' else row['ref'])
        done = subprocess.run(['rspamc', 'learn_spam' if row['verdict'] == 'spam' else 'learn_ham'], input=raw, capture_output=True, timeout=60)
        result = rspamc_learn_result((done.stdout + done.stderr).decode('utf-8', 'replace'))
        if done.returncode != 0 and result != 'learned before':
            raise EfaError(f'Bayes did not learn it: {result}')
        if row['verdict'] == 'spam':
            fuzzy = fuzzy_learn(raw)
            result = f'{result}; {fuzzy}' if fuzzy else result
    features = json.dumps(rspamc_symbols(raw)) if decision == 'approve' else None
    _admin_query('UPDATE train_requests SET state = %s, decided_by = %s, decided = NOW(), result = %s, features = %s WHERE id = %s',
                 ('done' if decision == 'approve' else 'rejected', _dmarc_who()[:120], result, features, row['id']))
    return {'report': row['id'], 'decision': decision, 'result': result}


# A small model of its own: logistic regression over the rspamd symbols of the reports admins approved. Standard library only.
ML_FILE = ETC + '/eFa/ml.json'
ML_MODEL = RSPAMD_DIR + '/efa-ml.json'
ML_LUA = RSPAMD_DIR + '/efa-ml.lua'
ML_LOAD_LINE = ("do local ok, err = pcall(dofile, '" + ML_LUA + "'); if not ok then require('rspamd_logger').errx(rspamd_config, 'efa-ml: %s', err) end end "
                "-- efa-ml\n")
ML_DEFAULTS = {'enabled': False, 'min_each': 20, 'score': 4.0, 'trained': None, 'samples': 0}
ML_OWN = ('EFA_ML_SPAM', 'EFA_ML_HAM')
ML_LUA_TEXT = r'''-- Written by efactl ml-train. Do not edit.
-- The model of efactl ml-train: a weight per rspamd symbol; very sure spam or ham adds its score, scaled by how sure.
local ucl = require 'ucl'
local parser = ucl.parser()
if not parser:parse_file('/etc/rspamd/efa-ml.json') then return end
local model = parser:get_object()
local SCORE = %(score)s
rspamd_config:register_symbol({name = 'EFA_ML_SPAM', score = SCORE, group = 'efa_ml', type = 'virtual', parent = -1})
rspamd_config:register_symbol({name = 'EFA_ML_HAM', score = -SCORE, group = 'efa_ml', type = 'virtual', parent = -1})
rspamd_config:register_symbol({name = 'EFA_ML', type = 'postfilter', priority = 5, callback = function(task)
  local z = model.bias or 0
  for _, symbol in ipairs(task:get_symbols_all() or {}) do
    if symbol.name ~= 'EFA_ML_SPAM' and symbol.name ~= 'EFA_ML_HAM' then z = z + (model.weights[symbol.name] or 0) end
  end
  local p = 1 / (1 + math.exp(-z))
  if p >= 0.9 then task:insert_result('EFA_ML_SPAM', (p - 0.5) * 2, string.format('%%.2f', p))
  elseif p <= 0.1 then task:insert_result('EFA_ML_HAM', (0.5 - p) * 2, string.format('%%.2f', p)) end
end})
'''


def ml_train_model(samples, rounds=200, rate=0.1, l2=0.01):
    """Logistic regression by gradient descent. samples: [(symbols, 1 for spam or 0 for ham)]. Returns bias and weights."""
    import math
    weights, bias = {}, 0.0
    for _ in range(rounds):
        for symbols, label in samples:
            z = bias + sum(weights.get(name, 0.0) for name in symbols)
            error = (1 / (1 + math.exp(-max(-30, min(30, z))))) - label
            bias -= rate * error
            for name in symbols:
                weights[name] = weights.get(name, 0.0) - rate * (error + l2 * weights.get(name, 0.0))
    return {'bias': round(bias, 4), 'weights': {name: round(value, 4) for name, value in weights.items() if abs(value) >= 0.001}}


def ml_state():
    return {**ML_DEFAULTS, **_json_read(ML_FILE, {})}


def _ml_samples():
    rows = _admin_query("SELECT verdict, features FROM train_requests WHERE state = 'done' AND features IS NOT NULL")
    samples = []
    for row in rows:
        try:
            symbols = [name for name in json.loads(row['features']) if name not in ML_OWN]
        except ValueError:
            continue
        samples.append((symbols, 1 if row['verdict'] == 'spam' else 0))
    return samples


def ml_status(_args):
    """The own model: on or off, how many approved reports it can learn from, and when it learned last."""
    state = ml_state()
    samples = _ml_samples()
    return {**state, 'spam_reports': sum(1 for _s, label in samples if label), 'ham_reports': sum(1 for _s, label in samples if not label)}


def ml_settings(_args):
    """The settings of the own model from the configuration of eFa-next only: for the form, without reading the reports."""
    return ml_state()


def ml_train(_args=None):
    """Learn from the approved reports and give the model to rspamd. Needs min_each spam and ham reports."""
    state, samples = ml_state(), _ml_samples()
    spam, ham = sum(1 for _s, label in samples if label), sum(1 for _s, label in samples if not label)
    if spam < state['min_each'] or ham < state['min_each']:
        raise EfaError(f"It needs {state['min_each']} approved spam and ham reports each, there are {spam} and {ham}.")
    _write(ML_MODEL, json.dumps(ml_train_model(samples)))
    state.update(trained=time.strftime('%Y-%m-%d %H:%M:%S'), samples=len(samples))
    _ml_apply(state)
    return ml_status(None)


def _ml_apply(state):
    with open(RSPAMD_LOCAL_LUA) as f:
        before = f.read()
    text = re.sub(r'^.*-- efa-ml\n', '', before, flags=re.M)
    if state['enabled'] and os.path.exists(ML_MODEL):
        _write(ML_LUA, ML_LUA_TEXT % {'score': state['score']})
        text = text.rstrip('\n') + '\n' + ML_LOAD_LINE
    _write(RSPAMD_LOCAL_LUA, text)
    if not _rspamd_config_ok():
        _write(RSPAMD_LOCAL_LUA, before)
        raise EfaError('rspamd rejected the model, nothing changed.')
    _json_write(ML_FILE, state)
    _reload_rspamd()


def ml_set(args):
    """Switch the own model, the reports it needs of each kind, and its score. Off by default."""
    state = ml_state()
    state['enabled'] = _on_off(args.mode)
    for key, low, high, kind in (('min_each', 5, 10000, int), ('score', 0.5, 20, float)):
        value = (getattr(args, key, '') or '').strip()
        if value:
            try:
                number = kind(value)
            except ValueError:
                raise EfaError(f'{key}: a number.')
            if not low <= number <= high:
                raise EfaError(f'{key}: {low} to {high}.')
            state[key] = number
    _ml_apply(state)
    return ml_status(None)


def rspamc_symbols(raw):
    """The rspamd symbols of a mail, for the model."""
    done = subprocess.run(['rspamc', '--json', 'symbols'], input=raw, capture_output=True, timeout=60)
    try:
        reply = json.loads(done.stdout.decode('utf-8', 'replace'))
    except ValueError:
        return []
    return sorted((reply.get('default') or reply).get('symbols', {}).keys()) if isinstance(reply, dict) else []


def bec_state():
    state = {**BEC_DEFAULTS, **_json_read(BEC_FILE, {})}
    state['scores'] = {**BEC_DEFAULTS['scores'], **state.get('scores', {})}
    return state


def _own_domains():
    """Domains this server takes mail for or signs: what a lookalike would imitate."""
    found = {line.split()[0].lower() for line in _read_lines(TRANSPORT) if line.split() and DOMAIN_RE.match(line.split()[0].lower())}
    found |= set(_dkim_conf_domains())
    try:
        found |= {domain for domains in _tenant_domains().values() for domain in domains}
    except Exception:  # no database yet: the files are enough
        pass
    return found


def bec_conf(state, own):
    """The settings rspamd reads: protected domains, VIPs, scores."""
    return {'protected': sorted(set(own) | set(state['partners'])), 'vips': state['vips'], 'scores': state['scores'],
            'relation_days': state['relation_days'], 'style_min': state['style_min'], 'phrases': BEC_PHRASES, 'young_days': state['young_days'],
            'pattern_min': state.get('pattern_min', 20)}


def rdap_servers(bootstrap):
    """The IANA bootstrap file to a map ending -> RDAP base address; only https servers."""
    found = {}
    for endings, urls in bootstrap.get('services', []):
        base = next((url for url in urls if url.startswith('https://')), None)
        if base:
            for ending in endings:
                found[ending.lower()] = base if base.endswith('/') else base + '/'
    return found


def _rdap_refresh():
    """Fetches the RDAP servers of the registries from IANA, once a day while the domain age counts."""
    if os.path.exists(RDAP_MAP) and time.time() - os.path.getmtime(RDAP_MAP) < 86400:
        return False
    with urllib.request.urlopen(RDAP_BOOTSTRAP, timeout=30) as reply:
        servers = rdap_servers(json.loads(reply.read()))
    if len(servers) < 100:
        raise EfaError('The RDAP list of IANA looks incomplete, the old one stays.')
    _write(RDAP_MAP, json.dumps(servers))
    return True


def _bec_apply(state):
    with open(RSPAMD_LOCAL_LUA) as f:
        before = f.read()
    # Every line with the mark, also one an older version wrote.
    text = re.sub(r'^.*-- efa-bec\n', '', before, flags=re.M)
    if state['enabled']:
        _write(BEC_CONF, json.dumps(bec_conf(state, _own_domains()), indent=1))
        _write(BEC_LUA, BEC_LUA_TEXT)
        text = text.rstrip('\n') + '\n' + BEC_LOAD_LINE
    _write(RSPAMD_LOCAL_LUA, text)
    if not _rspamd_config_ok():
        _write(RSPAMD_LOCAL_LUA, before)
        raise EfaError('rspamd rejected the BEC settings, nothing changed.')
    _json_write(BEC_FILE, state)
    _reload_rspamd()


def _bec_refresh():
    """The protected domains anew after a domain came or went, while the BEC checks are on."""
    state = bec_state()
    if not state['enabled']:
        return
    wanted = json.dumps(bec_conf(state, _own_domains()), indent=1)
    if (open(BEC_CONF).read() if os.path.exists(BEC_CONF) else '') != wanted:
        _write(BEC_CONF, wanted)
        _reload_rspamd()


def bec_status(_args):
    """Impersonation and BEC checks: switch, VIPs, partner domains, scores, and the own domains they protect."""
    state = bec_state()
    return {**state, 'own_domains': sorted(_own_domains())}


def bec_set(args):
    """Switch the BEC checks and set their scores. Off by default."""
    state = bec_state()
    state['enabled'] = _on_off(args.mode)
    for key in ('vip', 'lookalike', 'first_contact', 'style', 'language', 'young_domain', 'pattern'):
        value = (getattr(args, f'score_{key}', '') or '').strip()
        if value:
            try:
                score = float(value)
            except ValueError:
                raise EfaError('Scores must be numbers.')
            if not -20 <= score <= 50:
                raise EfaError('Scores: -20 to 50.')
            state['scores'][key] = score
    days = (args.relation_days or '').strip()
    if days:
        if not days.isdigit() or not 30 <= int(days) <= 3650:
            raise EfaError('Days a mail relation counts: 30 to 3650.')
        state['relation_days'] = int(days)
    young = (getattr(args, 'young_days', '') or '').strip()
    if young:
        if not young.isdigit() or int(young) not in BEC_YOUNG_CHOICES:
            raise EfaError('A domain counts as young for 7, 14, 30, 90 or 365 days.')
        state['young_days'] = int(young)
    if state['enabled'] and state['scores']['young_domain']:
        try:
            _rdap_refresh()
        except (OSError, ValueError) as err:
            raise EfaError(f'The RDAP list of IANA could not be fetched: {err}')
    _bec_apply(state)
    return bec_status(None)


def bec_vip_set(args):
    """A VIP: their name in the display name with any other address counts as impersonation."""
    state, action = bec_state(), args.action.strip()
    name, address = ' '.join((args.name or '').split()), (args.address or '').strip().lower()
    if action not in ('add', 'remove') or not 3 <= len(name) <= 100 or any(ch in name for ch in '\r\n\0"\\'):
        raise EfaError("Action 'add' or 'remove', and a name of 3 to 100 characters.")
    vips = [vip for vip in state['vips'] if vip['name'].lower() != name.lower()]
    if action == 'add':
        if not SENDER_RE.match(address):
            raise EfaError('The real address of the VIP is needed.')
        vips.append({'name': name, 'address': address})
    elif len(vips) == len(state['vips']):
        raise EfaError('No such VIP.')
    state['vips'] = sorted(vips, key=lambda vip: vip['name'].lower())
    _bec_apply(state)
    return {'vips': state['vips']}


def bec_partner_set(args):
    """A partner domain is protected like an own one: lookalikes of it count."""
    state, action, domain = bec_state(), args.action.strip(), args.domain.strip().lower()
    if action not in ('add', 'remove') or not DOMAIN_RE.match(domain):
        raise EfaError("Action 'add' or 'remove', and a domain.")
    if action == 'add':
        state['partners'] = sorted(set(state['partners']) | {domain})
    elif domain in state['partners']:
        state['partners'].remove(domain)
    else:
        raise EfaError('No such partner domain.')
    _bec_apply(state)
    return {'partners': state['partners']}


# C7: limits for the virus scan of one mail, and what happens when the scan fails. Off after an upgrade (rspamd and clamd as
# before); a fresh install sets the defaults with fail closed. The values reach clamd through efa_services too (setup reruns).
SCAN_FILE = ETC + '/eFa/scan-limits.json'
SCAN_CONF = RSPAMD_DIR + '/efa-scan.json'
SCAN_LUA = RSPAMD_DIR + '/efa-scan.lua'
SCAN_AV_CONF = RSPAMD_DIR + '/local.d/antivirus.conf'
SCAN_OPTIONS = RSPAMD_DIR + '/local.d/options.inc'
CLAMD_SCAN_CONF = ETC + '/clamd.d/scan.conf'
SCAN_LOAD_LINE = ("do local ok, err = pcall(dofile, '" + SCAN_LUA + "'); if not ok then require('rspamd_logger').errx(rspamd_config, 'efa-scan: %s', err) end end "
                  "-- efa-scan\n")
SCAN_DEFAULTS = {'enabled': False, 'av_seconds': 10, 'scan_mb': 50, 'task_seconds': 30, 'fail': 'open', 'tenants': {}}
# What the setup writes (rspamd-config.sh, efa_services): back to it when the limits go off.
SCAN_AV_DEFAULT = '''clamav {
  type = "clamav";
  servers = "/run/clamd.scan/clamd.sock";
  symbol = "CLAM_VIRUS";
  action = "reject";
  scan_mime_parts = false;
}
'''
SCAN_CLAMD_DEFAULT = {'MaxScanTime': '120000', 'StreamMaxLength': '64M', 'MaxFileSize': '64M', 'MaxScanSize': '256M', 'AlertExceedsMax': 'no'}
SCAN_CHOICES = {'av_seconds': (5, 10, 15, 20), 'scan_mb': (10, 25, 50, 64), 'task_seconds': (8, 15, 30, 60)}
SCAN_LUA_TEXT = r'''-- Written by efactl scan-limits-set. Do not edit.
-- C7: a mail whose virus scan failed (clamd down, too slow, too large to scan) is deferred or rejected for the domains that fail
-- closed, instead of passing unscanned.
local rspamd_logger = require 'rspamd_logger'
local ucl = require 'ucl'
local parser = ucl.parser()
local ok = parser:parse_file('/etc/rspamd/efa-scan.json')
if not ok then
  rspamd_logger.errx(rspamd_config, 'efa-scan: no settings, scan failures pass as before')
  return
end
local conf = parser:get_object()
local closed, open = {}, {}
for _, d in ipairs(conf.closed or {}) do closed[d] = true end
for _, d in ipairs(conf.open or {}) do open[d] = true end
local function fails_closed(task)
  for _, rcpt in ipairs(task:get_recipients('smtp') or {}) do
    local d = string.lower(rcpt.domain or '')
    if closed[d] or (conf.all_closed and not open[d]) then return true end
  end
  return false
end
rspamd_config:register_symbol({name = 'EFA_SCAN_FAIL', score = 0.0, group = 'efa_scan', type = 'postfilter', priority = 5,
  description = 'The virus scan failed or the mail was too large to scan',
  callback = function(task)
    if task:has_symbol('CLAM_VIRUS') then return end
    local too_big = task:get_size() > conf.max_bytes
    if not (too_big or task:has_symbol('CLAM_VIRUS_FAIL') or task:has_symbol('CLAM_LIMITS_EXCEEDED')) then return end
    if not fails_closed(task) then
      task:insert_result('EFA_SCAN_FAIL', 1.0, 'open')
      return
    end
    task:insert_result('EFA_SCAN_FAIL', 1.0, 'closed')
    if too_big then
      task:set_pre_result({action = 'reject', message = 'Message too large to be scanned for viruses', module = 'efa_scan', priority = 3})
    else
      task:set_pre_result({action = 'soft reject', message = 'Virus scanner not available, try again later', module = 'efa_scan', priority = 3})
    end
  end,
})
'''


def scan_state():
    state = {**SCAN_DEFAULTS, **_json_read(SCAN_FILE, {})}
    state['tenants'] = dict(state.get('tenants') or {})
    return state


def scan_conf(state, tenant_domains):
    """What rspamd reads: the largest mail scanned, and the domains that fail closed or stay open against the global mode."""
    closed, open_ = set(), set()
    for tenant, mode in state['tenants'].items():
        (closed if mode == 'closed' else open_).update(tenant_domains.get(int(tenant), []) if str(tenant).isdigit() else [])
    return {'max_bytes': state['scan_mb'] * 1024 * 1024, 'all_closed': state['fail'] == 'closed',
            'closed': sorted(closed), 'open': sorted(open_)}


def scan_clamd_settings(state):
    """clamd directives of the limits; efa_services reads the same file when the setup runs again."""
    mb = state['scan_mb']
    # clamd gives up a little before rspamd stops waiting, and says so: Heuristics.Limits.Exceeded becomes a scan failure.
    return {'MaxScanTime': str(max(1, state['av_seconds'] - 1) * 1000), 'StreamMaxLength': f'{mb}M', 'MaxFileSize': f'{mb}M',
            'MaxScanSize': f'{mb * 4}M', 'AlertExceedsMax': 'yes'}


def scan_rspamd_av(state, tenant_yara=False):
    """local.d/antivirus.conf: the limits of C7 when they are on; with YARA rules of tenants (M5) their hits get a symbol of their
    own and eFa-next rejects (EFA_AV_REJECT) instead of the antivirus module, so a rule of one tenant does not reject mail of another."""
    lines = ['clamav {', '  type = "clamav";', '  servers = "/run/clamd.scan/clamd.sock";', '  symbol = "CLAM_VIRUS";']
    if not tenant_yara:
        lines.append('  action = "reject";')
    lines.append('  scan_mime_parts = false;')
    if state['enabled']:
        lines += [f'  timeout = {state["av_seconds"]}.0;', '  retransmits = 1;', f'  max_size = {state["scan_mb"] * 1024 * 1024};',
                  '  patterns_fail {', '    CLAM_LIMITS_EXCEEDED = "^Heuristics\\\\.Limits\\\\.Exceeded";', '  }']
    if tenant_yara:
        lines += ['  patterns {', '    EFA_TENANT_YARA = "^YARA\\\\.t[0-9]+_";', '  }']
    return '\n'.join(lines + ['}']) + '\n'


def _tenant_yara_on():
    return any(item.get('tenant') for item in _json_read(OWN_BLOCK_FILE, {}).get('yara_rules', []))


def _set_directives(text, values):
    out, seen = [], set()
    for line in text.splitlines():
        word = line.split(None, 1)[0] if line.strip() and not line.lstrip().startswith('#') else None
        if word in values:
            if word not in seen:
                out.append(f'{word} {values[word]}')
                seen.add(word)
            continue
        out.append(line)
    out += [f'{key} {value}' for key, value in values.items() if key not in seen]
    return '\n'.join(out) + '\n'


def _scan_apply(state):
    files = {path: (open(path).read() if os.path.exists(path) else None) for path in (RSPAMD_LOCAL_LUA, SCAN_AV_CONF, SCAN_OPTIONS, CLAMD_SCAN_CONF)}
    lua = re.sub(r'^.*-- efa-scan\n', '', files[RSPAMD_LOCAL_LUA] or '', flags=re.M)
    options = re.sub(r'^task_timeout = .*\n', '', files[SCAN_OPTIONS] or '', flags=re.M)
    try:
        _write(SCAN_AV_CONF, scan_rspamd_av(state, _tenant_yara_on()))
        if state['enabled']:
            _write(SCAN_CONF, json.dumps(scan_conf(state, _tenant_domains_or_none()), indent=1))
            _write(SCAN_LUA, SCAN_LUA_TEXT)
            _write(SCAN_OPTIONS, options + f'task_timeout = {state["task_seconds"]}s;\n')
            lua = lua.rstrip('\n') + '\n' + SCAN_LOAD_LINE
        else:
            _write(SCAN_OPTIONS, options)
        _write(RSPAMD_LOCAL_LUA, lua)
        if not _rspamd_config_ok():
            raise EfaError('rspamd rejected the scan limits, nothing changed.')
        if files[CLAMD_SCAN_CONF] is not None:
            _write(CLAMD_SCAN_CONF, _set_directives(files[CLAMD_SCAN_CONF], scan_clamd_settings(state) if state['enabled'] else SCAN_CLAMD_DEFAULT))
    except Exception:
        for path, text in files.items():
            if text is not None:
                _write(path, text)
        raise
    _json_write(SCAN_FILE, state)
    _reload_rspamd()
    if files[CLAMD_SCAN_CONF] is not None and files[CLAMD_SCAN_CONF] != open(CLAMD_SCAN_CONF).read():
        # clamd reads its limits only at the start; while it loads, the domains that fail closed defer their mail.
        _platform().service_try_restart('clamd@scan')


def _tenant_domains_or_none():
    try:
        return _tenant_domains()
    except Exception:  # no database yet: only the global mode counts
        return {}


def scan_status(_args):
    """Limits of the virus scan of one mail and what happens when it fails."""
    state = scan_state()
    names = {}
    try:
        names = {str(row['id']): row['name'] for row in _admin_query('SELECT id, name FROM tenants')}
    except Exception:
        pass
    return {**{key: state[key] for key in ('enabled', 'av_seconds', 'scan_mb', 'task_seconds', 'fail')},
            'tenants': [{'tenant': names.get(tenant, tenant), 'fail': mode} for tenant, mode in sorted(state['tenants'].items())]}


def scan_limits_set(args):
    """Time and size limits of the virus scan per mail, and fail open or closed when the scan fails."""
    state = scan_state()
    state['enabled'] = _on_off(args.mode)
    for key, allowed in SCAN_CHOICES.items():
        value = (getattr(args, key, '') or '').strip()
        if value:
            if not value.isdigit() or int(value) not in allowed:
                raise EfaError(f'{key}: one of ' + ', '.join(map(str, allowed)))
            state[key] = int(value)
    fail = (args.fail or '').strip()
    if fail:
        if fail not in ('open', 'closed'):
            raise EfaError("When the scan fails: 'open' or 'closed'.")
        state['fail'] = fail
    if state['av_seconds'] >= state['task_seconds']:
        raise EfaError('The virus scan needs less time than the whole check of a mail.')
    _scan_apply(state)
    return scan_status(None)


def scan_fail_set(args):
    """A tenant fails open or closed against the global setting; inherit takes the global one again."""
    mode, state = args.fail.strip(), scan_state()
    if mode not in ('inherit', 'open', 'closed'):
        raise EfaError("Mode: 'inherit', 'open' or 'closed'.")
    tenant = str(_tenant_id(args.tenant.strip()))
    if mode == 'inherit':
        state['tenants'].pop(tenant, None)
    else:
        state['tenants'][tenant] = mode
    _scan_apply(state)
    return scan_status(None)


def _scan_refresh():
    """The domains of the tenants anew after a domain came or went, while the limits are on."""
    state = scan_state()
    if not state['enabled'] or not state['tenants']:
        return
    wanted = json.dumps(scan_conf(state, _tenant_domains_or_none()), indent=1)
    if (open(SCAN_CONF).read() if os.path.exists(SCAN_CONF) else '') != wanted:
        _write(SCAN_CONF, wanted)
        _reload_rspamd()


# M5: own blocks. SHA-256 of attachments and YARA rules, each either for one tenant ("only this tenant", the default) or for
# all ("for all", only with security.rules.global). Hashes are checked in rspamd. YARA rules go into one database of ClamAV: a
# rule of a tenant is named t<id>_<rule> there, rspamd gives its hits the symbol EFA_TENANT_YARA, and eFa-next rejects them only for
# mail to that tenant. Every change and every switch of the scope is in the audit log and builds the database anew.
OWN_BLOCK_FILE = ETC + '/eFa/own-blocks.json'
OWN_HASH_CONF = RSPAMD_DIR + '/efa-own-hash.json'
OWN_HASH_LUA = RSPAMD_DIR + '/efa-own-hash.lua'
OWN_YARA = SANE_DB_DIR + '/efa-own.yar'
OWN_YARA_BYTES = 256 * 1024
OWN_SCOPES = ('tenant', 'all')
OWN_HASH_LOAD_LINE = ("do local ok, err = pcall(dofile, '" + OWN_HASH_LUA + "'); if not ok then require('rspamd_logger').errx(rspamd_config, 'efa-own-hash: %s', err) "
                      "end end -- efa-own-hash\n")
OWN_HASH_LUA_TEXT = r'''-- Written by efactl own-hash-set and own-yara-set. Do not edit.
-- M5: an attachment whose SHA-256 is on the own list of all domains or of the tenant of a recipient is rejected. With YARA rules
-- of tenants the virus check rejects here: a hit of a tenant rule (EFA_TENANT_YARA) only for mail to that tenant.
local rspamd_logger = require 'rspamd_logger'
local hash = require 'rspamd_cryptobox_hash'
local ucl = require 'ucl'
local parser = ucl.parser()
if not parser:parse_file('/etc/rspamd/efa-own-hash.json') then
  rspamd_logger.errx(rspamd_config, 'efa-own-hash: no settings, own blocks are not checked')
  return
end
local conf = parser:get_object()
local all = {}
for _, h in ipairs(conf.all or {}) do all[h] = true end
local function tenants_of(task)
  local found = {}
  for _, rcpt in ipairs(task:get_recipients('smtp') or {}) do
    local t = (conf.domain_tenant or {})[string.lower(rcpt.domain or '')]
    if t then found[t] = true end
  end
  return found
end
rspamd_config:register_symbol({name = 'EFA_OWN_HASH', score = 0.0, group = 'efa_own', description = 'An attachment is on the own block list',
  callback = function(task)
    local wanted = {}
    for t in pairs(tenants_of(task)) do
      for _, h in ipairs((conf.tenant_hashes or {})[t] or {}) do wanted[h] = true end
    end
    for _, part in ipairs(task:get_parts() or {}) do
      if part:is_attachment() or part:get_filename() then
        local digest = hash.create_specific('sha256', part:get_content()):hex()
        if all[digest] or wanted[digest] then
          task:insert_result('EFA_OWN_HASH', 1.0, digest)
          task:set_pre_result({action = 'reject', message = 'Attachment blocked by the administrator', module = 'efa_own', priority = 3})
          return
        end
      end
    end
  end,
})
if conf.tenant_yara then
  rspamd_config:register_symbol({name = 'EFA_AV_REJECT', score = 0.0, group = 'efa_own', type = 'postfilter', priority = 5,
    description = 'Virus or a YARA rule of the tenant of a recipient',
    callback = function(task)
      if task:has_symbol('CLAM_VIRUS') then
        task:set_pre_result({action = 'reject', message = 'Virus found', module = 'efa_av', priority = 1})
        return
      end
      local hit = task:get_symbol('EFA_TENANT_YARA')
      if not hit then return end
      local tenants = tenants_of(task)
      for _, name in ipairs(hit[1].options or {}) do
        local t = string.match(name, '^YARA%.t(%d+)_')
        if t and tenants[t] then
          task:insert_result('EFA_AV_REJECT', 1.0, name)
          task:set_pre_result({action = 'reject', message = 'Blocked by a rule of the administrator', module = 'efa_av', priority = 1})
          return
        end
      end
    end,
  })
end
'''
OWN_HASH_RE = re.compile(r'^[0-9a-f]{64}$')
YARA_RULE_RE = re.compile(r'^\s*(?:(?:private|global)\s+)*rule\s+([A-Za-z_][A-Za-z0-9_]{0,63})\b', re.M)


def _own_blocks():
    state = {'hashes': [], 'yara_rules': [], **_json_read(OWN_BLOCK_FILE, {})}
    state.pop('yara', None)
    return state


def _own_scope(args):
    """(scope, tenant id as text or ''): a tenant admin gets the own tenant; 'for all' needs security.rules.global."""
    scope = (getattr(args, 'scope', '') or 'tenant').strip()
    if scope not in OWN_SCOPES:
        raise EfaError("Scope: 'tenant' (only this tenant) or 'all' (for all).")
    if scope == 'all':
        if identity_now and 'security.rules.global' not in identity_now['grants']:
            raise EfaError('Only a super admin, or a login with security.rules.global, sets rules for all tenants.')
        return 'all', ''
    name = (getattr(args, 'tenant', '') or '').strip()
    mine = identity_now.get('tenant_ids') if identity_now else None
    if not name and mine and len(mine) == 1:
        return 'tenant', str(mine[0])
    if not name:
        raise EfaError('Name the tenant of the rule, or choose the scope for all.')
    tenant = _tenant_id(name)
    if mine is not None and tenant not in mine:
        raise EfaError('Not allowed: this tenant is outside your scope.')
    return 'tenant', str(tenant)


def own_visible(items):
    """A tenant admin sees the rules of the own tenants and that rules for all exist, never the rules of other tenants."""
    mine = identity_now.get('tenant_ids') if identity_now else None
    return [item for item in items if mine is None or not item.get('tenant') or int(item['tenant']) in mine]


def own_hash_conf(hashes, tenant_domains, tenant_yara=False):
    domain_tenant = {domain: str(tid) for tid, domains in tenant_domains.items() for domain in domains}
    per_tenant = {}
    for item in hashes:
        if item.get('tenant'):
            per_tenant.setdefault(str(item['tenant']), set()).add(item['sha256'])
    return {'all': sorted(item['sha256'] for item in hashes if not item.get('tenant')), 'tenant_hashes': {t: sorted(h) for t, h in sorted(per_tenant.items())},
            'domain_tenant': dict(sorted(domain_tenant.items())), 'tenant_yara': tenant_yara}


def yara_compiled(rules):
    """The text of the ClamAV database: rules for all as they are, rules of a tenant named t<id>_<rule>."""
    parts = []
    for item in sorted(rules, key=lambda rule: (rule.get('tenant', ''), rule['name'])):
        text = item['text']
        if item.get('tenant'):
            text = YARA_RULE_RE.sub(lambda m: m.group(0)[:m.start(1) - m.start(0)] + f"t{item['tenant']}_{m.group(1)}", text, count=1)
        parts.append(text.strip() + '\n')
    return '\n'.join(parts)


def _own_apply(state):
    """rspamd (hashes, the tenant check of YARA hits, the antivirus settings) and ClamAV (the YARA database), with a way back."""
    tenant_yara = any(item.get('tenant') for item in state['yara_rules'])
    with open(RSPAMD_LOCAL_LUA) as f:
        before = f.read()
    av_before = open(SCAN_AV_CONF).read() if os.path.exists(SCAN_AV_CONF) else None
    text = re.sub(r'^.*-- efa-own-hash\n', '', before, flags=re.M)
    if state['hashes'] or tenant_yara:
        _write(OWN_HASH_CONF, json.dumps(own_hash_conf(state['hashes'], _tenant_domains_or_none(), tenant_yara), indent=1))
        _write(OWN_HASH_LUA, OWN_HASH_LUA_TEXT)
        text = text.rstrip('\n') + '\n' + OWN_HASH_LOAD_LINE
    _write(RSPAMD_LOCAL_LUA, text)
    _write(SCAN_AV_CONF, scan_rspamd_av(scan_state(), tenant_yara))
    if not _rspamd_config_ok():
        _write(RSPAMD_LOCAL_LUA, before)
        if av_before is not None:
            _write(SCAN_AV_CONF, av_before)
        raise EfaError('rspamd rejected the own blocks, nothing changed.')
    compiled = yara_compiled(state['yara_rules'])
    if compiled.strip():
        _write(OWN_YARA, compiled)
    elif os.path.exists(OWN_YARA):
        os.remove(OWN_YARA)
    _json_write(OWN_BLOCK_FILE, state)
    _reload_rspamd()
    _sane_reload()


def own_block_status(_args):
    """Own blocks: SHA-256 of attachments and YARA rules, each for one tenant or for all."""
    state = _own_blocks()
    names = {}
    try:
        names = {str(row['id']): row['name'] for row in _admin_query('SELECT id, name FROM tenants')}
    except Exception:  # no database yet
        pass

    def shown(item, keep_text):
        row = {**item, 'scope': 'only this tenant' if item.get('tenant') else 'for all', 'tenant': names.get(item.get('tenant', ''), item.get('tenant', ''))}
        if not keep_text:
            row.pop('text', None)
        return row
    mine = identity_now.get('tenant_ids') if identity_now else None
    return {'hashes': [shown(item, True) for item in own_visible(state['hashes'])],
            'yara_rules': [shown(item, mine is None or bool(item.get('tenant'))) for item in own_visible(state['yara_rules'])]}


def own_hash_set(args):
    """Adds, removes or moves the SHA-256 of a file that is rejected as attachment, for one tenant or for all."""
    action, digest, label = (args.action or '').strip(), (args.sha256 or '').strip().lower(), ' '.join((args.name or '').split())[:100]
    if action not in ('add', 'remove') or not OWN_HASH_RE.match(digest):
        raise EfaError("Action 'add' or 'remove' and a SHA-256 of 64 hex digits.")
    scope, tenant = _own_scope(args)
    state = _own_blocks()
    mine = own_visible(state['hashes'])
    old = next((item for item in mine if item['sha256'] == digest and (action == 'add' or item.get('tenant', '') == tenant)), None)
    if action == 'remove' and old is None:
        raise EfaError('No such hash in that list.')
    if old is not None and not old.get('tenant'):
        _own_scope(argparse.Namespace(scope='all', tenant=''))  # a rule for all is changed only by those who may set one
    state['hashes'] = [item for item in state['hashes'] if item is not old]
    if action == 'add':
        state['hashes'].append({'sha256': digest, 'name': label or (old or {}).get('name', ''), 'tenant': tenant, 'by': _dmarc_who(),
                                'at': time.strftime('%Y-%m-%d %H:%M')})
    state['hashes'].sort(key=lambda item: (item.get('tenant', ''), item['sha256']))
    _own_apply(state)
    moved = f' (was {"tenant " + old["tenant"] if old.get("tenant") else "for all"})' if old and action == 'add' else ''
    _audit(f'own hash {digest} {action} for {"tenant " + tenant if tenant else "all"}{moved} by {_dmarc_who()}')
    return own_block_status(None)


def yara_load_problem(text, run=None):
    """None when clamscan takes these YARA rules in a test of their own, else its complaint."""
    if len(text.encode()) > OWN_YARA_BYTES:
        return f'at most {OWN_YARA_BYTES // 1024} KB of rules'
    if run is None and not shutil.which('clamscan'):
        return 'clamscan is missing (package clamav): the rules cannot be checked, so they are not taken'
    with tempfile.TemporaryDirectory() as work:
        rules, sample = os.path.join(work, 'own.yar'), os.path.join(work, 'sample.txt')
        _write(rules, text)
        _write(sample, 'eFa-next YARA load test\n')
        done = (run or subprocess.run)(['clamscan', f'--database={rules}', sample], capture_output=True, text=True, timeout=120)
    # clamscan skips a rule it cannot take with a warning and still exits 0 (ClamAV 1.4): every rule must be counted as loaded.
    output = f"{done.stderr or ''}\n{getattr(done, 'stdout', '') or ''}"
    wanted = len(YARA_RULE_RE.findall(text))
    loaded = re.search(r'^Known viruses:\s*(\d+)', output, re.M)
    syntax = re.search(r'yyerror\(\):\s*(.+)', output)
    if syntax:
        return f'syntax error: {syntax.group(1).strip()[:200]}'
    if 'no supported strings' in output:
        return 'the rule has no strings; ClamAV skips such rules (YARA in ClamAV needs at least one string, no modules)'
    if done.returncode != 0:
        return f'clamscan refused the rules: {(done.stderr or "").strip()[:200]}'
    if not loaded or int(loaded.group(1)) != wanted:
        return f'ClamAV loaded {loaded.group(1) if loaded else "no"} of {wanted} rules'
    return None


def yara_problem(text, run=None):
    """None when the text is one YARA rule that clamscan takes, else the complaint."""
    if not text.strip():
        return 'no rule'
    if re.search(r'^\s*(import|include)\b', text, re.M):
        return 'import and include are not allowed'
    if len(YARA_RULE_RE.findall(text)) != 1:
        return 'exactly one rule per entry'
    return yara_load_problem(text, run)


def own_yara_set(args):
    """Adds, changes, moves or removes one YARA rule, for one tenant (default) or for all; a hit rejects the mail."""
    action = (args.action or '').strip()
    if action not in ('add', 'remove'):
        raise EfaError("Action 'add' or 'remove'.")
    scope, tenant = _own_scope(args)
    state = _own_blocks()
    if action == 'remove':
        name = (args.name or '').strip()
        old = next((item for item in own_visible(state['yara_rules']) if item['name'] == name and item.get('tenant', '') == tenant), None)
        if old is None:
            raise EfaError('No such rule in that scope.')
        state['yara_rules'].remove(old)
    else:
        file = (getattr(args, 'file', '') or '').strip()
        if file and os.environ.get('SUDO_USER') == 'efa-web':
            raise EfaError('Not allowed from the web interface: paste the rule instead.')
        text = (open(file, encoding='utf-8').read() if file else (args.rules or '').replace('\\n', '\n')).replace('\r\n', '\n')
        problem = yara_problem(text)
        if problem:
            raise EfaError(f'Nothing changed: {problem}.')
        name = YARA_RULE_RE.findall(text)[0]
        old = next((item for item in own_visible(state['yara_rules']) if item['name'] == name), None)
        if old is not None and not old.get('tenant'):
            _own_scope(argparse.Namespace(scope='all', tenant=''))
        rest = [item for item in state['yara_rules'] if item is not old]
        if any(item['name'] == name and item.get('tenant', '') == tenant for item in rest):
            raise EfaError(f'A rule named {name} exists in this scope already.')
        state['yara_rules'] = rest + [{'name': name, 'tenant': tenant, 'text': text, 'by': _dmarc_who(), 'at': time.strftime('%Y-%m-%d %H:%M')}]
        whole = yara_load_problem(yara_compiled(state['yara_rules']))
        if whole:
            raise EfaError(f'Nothing changed: together with the other rules {whole}.')
    _own_apply(state)
    _audit(f'own YARA rule {name} {action} for {"tenant " + tenant if tenant else "all"} by {_dmarc_who()}')
    return own_block_status(None)


# 2: graymail. Newsletters and other bulk mail that is not spam: by List-Unsubscribe, List-Id or Precedence bulk/list, and
# not spam. Each user chooses deliver, mark (header X-eFa-Graymail and an optional subject prefix) or keep it in the own
# quarantine (needs the quarantine for users). Off by default.
GRAY_FILE = ETC + '/eFa/graymail.json'
GRAY_CONF = RSPAMD_DIR + '/efa-graymail.json'
GRAY_LUA = RSPAMD_DIR + '/efa-graymail.lua'
GRAY_MODES = ('deliver', 'mark', 'quarantine')
GRAY_DEFAULTS = {'enabled': False, 'default': 'mark', 'subject': '', 'users': {}}
GRAY_LOAD_LINE = ("do local ok, err = pcall(dofile, '" + GRAY_LUA + "'); if not ok then require('rspamd_logger').errx(rspamd_config, 'efa-graymail: %s', err) "
                  "end end -- efa-graymail\n")
GRAY_LUA_TEXT = r'''-- Written by efactl graymail-set. Do not edit.
local rspamd_http = require 'rspamd_http'
local rspamd_util = require 'rspamd_util'
local ucl = require 'ucl'
local parser = ucl.parser()
if not parser:parse_file('/etc/rspamd/efa-graymail.json') then return end
local conf = parser:get_object()
rspamd_config:register_symbol({name = 'EFA_GRAYMAIL', score = 0.0, group = 'efa_graymail', type = 'postfilter', priority = 4,
  description = 'Newsletter or other bulk mail, not spam', callback = function(task)
    if task:has_pre_result() or task:has_symbol('CLAM_VIRUS') or task:get_user() then return end
    local action = task:get_metric_action('default')
    if action ~= 'no action' and action ~= 'greylist' then return end
    local precedence = string.lower(task:get_header('Precedence') or '')
    if not (task:get_header('List-Unsubscribe') or task:get_header('List-Id') or precedence == 'bulk' or precedence == 'list') then return end
    local modes, rcpts = {}, {}
    for _, rcpt in ipairs(task:get_recipients('smtp') or {}) do
      local mode = (conf.users or {})[string.lower(rcpt.addr)] or conf.default
      modes[mode] = true
      rcpts[#rcpts + 1] = rcpt.addr
    end
    if #rcpts == 0 then return end
    if modes.quarantine and not modes.mark and not modes.deliver and conf.quarantine then
      task:insert_result('EFA_GRAYMAIL', 1.0, 'quarantine')
      local senders = task:get_from('smtp')
      local meta = {sender = senders and senders[1] and senders[1].addr or '', rcpts = rcpts, subject = task:get_subject() or '', score = 0,
                    malware = 0, message_id = task:get_message_id() or '', ip = tostring(task:get_from_ip() or ''), qid = task:get_queue_id() or ''}
      rspamd_http.request({task = task, url = 'http://127.0.0.1:8906/quarantine', timeout = 20, body = task:get_content(),
        headers = {['X-Efa-Meta'] = tostring(rspamd_util.encode_base64(ucl.to_format(meta, 'json-compact'), 0))},
        callback = function(err, code)
          if not err and code == 200 then
            task:set_pre_result({action = 'discard', message = 'Held in quarantine (graymail)', module = 'efa_graymail', priority = 2})
          end
        end})
      return
    end
    if modes.mark or modes.quarantine then
      task:insert_result('EFA_GRAYMAIL', 1.0, 'mark')
      local reply = {add_headers = {['X-eFa-Graymail'] = 'yes'}}
      if (conf.subject or '') ~= '' then
        reply.remove_headers = {['Subject'] = 1}
        reply.add_headers['Subject'] = conf.subject .. ' ' .. (task:get_header('Subject') or '')
      end
      task:set_milter_reply(reply)
    end
  end})
'''


def gray_state():
    state = {**GRAY_DEFAULTS, **_json_read(GRAY_FILE, {})}
    state['users'] = dict(state.get('users') or {})
    return state


def gray_conf(state, quarantine_on):
    return {'default': state['default'], 'subject': state['subject'], 'users': state['users'], 'quarantine': quarantine_on}


def _gray_apply(state):
    with open(RSPAMD_LOCAL_LUA) as f:
        before = f.read()
    text = re.sub(r'^.*-- efa-graymail\n', '', before, flags=re.M)
    if state['enabled']:
        _write(GRAY_CONF, json.dumps(gray_conf(state, uq_state()['enabled']), indent=1))
        _write(GRAY_LUA, GRAY_LUA_TEXT)
        text = text.rstrip('\n') + '\n' + GRAY_LOAD_LINE
    _write(RSPAMD_LOCAL_LUA, text)
    if not _rspamd_config_ok():
        _write(RSPAMD_LOCAL_LUA, before)
        raise EfaError('rspamd rejected the graymail settings, nothing changed.')
    _json_write(GRAY_FILE, state, mode=0o644)
    _reload_rspamd()


def graymail_status(_args):
    """Graymail: on or off, the choice for all, the subject prefix, and the own choice of a user."""
    state = gray_state()
    me = (identity_now or {}).get('username') or ''
    return {'enabled': state['enabled'], 'default': state['default'], 'subject': state['subject'], 'mine': state['users'].get(me.lower(), 'as for all'),
            'mine_choice': state['users'].get(me.lower(), 'inherit'),
            'users_with_own_choice': len(state['users'])}


def graymail_set(args):
    """Graymail on or off, what happens with it for users without own choice, and the prefix of the subject."""
    state = gray_state()
    state['enabled'] = _on_off(args.mode)
    default = (args.default or '').strip()
    if default:
        if default not in GRAY_MODES:
            raise EfaError('For all: deliver, mark or quarantine.')
        state['default'] = default
    if getattr(args, 'subject', None) is not None and args.subject.strip() != '':
        subject = args.subject.strip()
        if subject == '-':
            subject = ''
        if len(subject) > 30 or any(ch in subject for ch in '\r\n"\\'):
            raise EfaError('Subject prefix: up to 30 characters, - for none.')
        state['subject'] = subject
    _gray_apply(state)
    return graymail_status(None)


def graymail_mine_set(args):
    """A user chooses for the own mailbox: deliver, mark or keep newsletters in the own quarantine; as for all again."""
    me = ((identity_now or {}).get('username') or '').lower()
    if '@' not in me:
        raise EfaError('Only a login with a mail address chooses this for its mailbox.')
    mode, state = (args.mode or '').strip(), gray_state()
    if mode == 'inherit':
        state['users'].pop(me, None)
    elif mode in GRAY_MODES:
        state['users'][me] = mode
    else:
        raise EfaError('Newsletters: deliver, mark, quarantine or inherit.')
    _gray_apply(state) if state['enabled'] else _json_write(GRAY_FILE, state, mode=0o644)
    return graymail_status(None)


# 3: the own spam limit of a user, within what the admin allows: a settings rule of rspamd for the address, between the limits
# of the domains (priority 4) and the rules of the admins (10).
USER_SPAM_FILE = ETC + '/eFa/user-spam.json'
USER_SPAM_DEFAULTS = {'allowed': False, 'low': 4.0, 'high': 10.0, 'users': {}}


def user_spam_state():
    state = {**USER_SPAM_DEFAULTS, **_json_read(USER_SPAM_FILE, {})}
    state['users'] = dict(state.get('users') or {})
    return state


def user_spam_rules(state):
    """One rule per user with an own limit: mail from this score on is marked as spam (and goes to the own quarantine if that is on)."""
    if not state['allowed']:
        return []
    return [{'name': 'user_' + hashlib.sha256(addr.encode()).hexdigest()[:12], 'kind': 'recipient', 'value': addr, 'priority': '5',
             'reject': '', 'add_header': f'{score:g}', 'greylist': '', 'quarantine': False, 'route': '', 'enabled': True}
            for addr, score in sorted(state['users'].items()) if state['low'] <= score <= state['high']]


def user_spam_set(args):
    """Whether users set their own spam limit, and between which scores."""
    state = user_spam_state()
    state['allowed'] = _on_off(args.mode)
    for key in ('low', 'high'):
        value = (getattr(args, key, '') or '').strip()
        if value:
            try:
                state[key] = float(value)
            except ValueError:
                raise EfaError('Limits: numbers.')
    if not 1 <= state['low'] < state['high'] <= 30:
        raise EfaError('Limits: from 1 to 30, the lower one first.')
    _json_write(USER_SPAM_FILE, state, mode=0o644)
    _rules_apply()
    return user_spam_status(None)


def user_spam_status(_args):
    state = user_spam_state()
    me = ((identity_now or {}).get('username') or '').lower()
    return {'allowed': state['allowed'], 'low': state['low'], 'high': state['high'], 'mine': state['users'].get(me, 'as set by the admin')}


def user_spam_mine_set(args):
    """A user sets the own spam limit within the limits of the admin; inherit takes the limit of the admin again."""
    me = ((identity_now or {}).get('username') or '').lower()
    state = user_spam_state()
    if '@' not in me or not state['allowed']:
        raise EfaError('Own spam limits are not open for this login.')
    value = (args.score or '').strip()
    if value == 'inherit':
        state['users'].pop(me, None)
    else:
        try:
            score = float(value)
        except ValueError:
            raise EfaError('A number, or inherit.')
        if not state['low'] <= score <= state['high']:
            raise EfaError(f"Between {state['low']:g} and {state['high']:g}.")
        state['users'][me] = score
    _json_write(USER_SPAM_FILE, state, mode=0o644)
    _rules_apply()
    return user_spam_status(None)

# 12, N1, 5v (c): threat feeds. Each feed is off until its terms are confirmed; the job of every hour fetches what changed
# (ETag, If-Modified-Since), only over HTTPS, at most 50 MB, and writes four local lists. rspamd reads them as file maps: it
# loads a list again only when it changed, no reload. Keys of TAXII and MISP are for root only and never in a log.
FEEDS_FILE = ETC + '/eFa/feeds.json'
FEEDS_STATE = '/var/lib/eFa/feeds-state.json'
FEEDS_DIR = '/var/lib/eFa/feeds'
FEED_MAPS = {kind: RSPAMD_DIR + f'/maps.d/efa-feed-{kind}.map' for kind in ('url', 'domain', 'sha256', 'ip')}
FEED_LUA = RSPAMD_DIR + '/efa-feeds.lua'
FEED_CONF = RSPAMD_DIR + '/efa-feeds.json'
FEED_KINDS = ('urlhaus', 'threatfox', 'stix', 'misp', 'list')
FEED_PRESETS = {
    'urlhaus': {'kind': 'urlhaus', 'url': 'https://urlhaus.abuse.ch/downloads/text_online/', 'terms': 'https://urlhaus.abuse.ch/api/',
                'note': 'abuse.ch URLhaus: URLs that spread malware, CC0'},
    'threatfox': {'kind': 'threatfox', 'url': 'https://threatfox.abuse.ch/export/json/recent/', 'terms': 'https://threatfox.abuse.ch/faq/',
                  'note': 'abuse.ch ThreatFox: indicators of the last 48 hours, CC0'},
}
FEED_SCORES = {'url': 8.0, 'domain': 6.0, 'sha256': 15.0, 'ip': 5.0}
FEED_MAX = 50 * 1024 * 1024
FEED_LOAD_LINE = ("do local ok, err = pcall(dofile, '" + FEED_LUA + "'); if not ok then require('rspamd_logger').errx(rspamd_config, 'efa-feeds: %s', err) "
                  "end end -- efa-feeds\n")
FEED_LUA_TEXT = r'''-- Written by efactl feed-set. Do not edit.
local hash = require 'rspamd_cryptobox_hash'
local ucl = require 'ucl'
local parser = ucl.parser()
if not parser:parse_file('/etc/rspamd/efa-feeds.json') then return end
local conf = parser:get_object()
local maps = {}
for _, kind in ipairs({'url', 'domain', 'sha256', 'ip'}) do
  maps[kind] = rspamd_config:add_map({type = kind == 'ip' and 'radix' or 'set', url = '/etc/rspamd/maps.d/efa-feed-' .. kind .. '.map',
                                      description = 'eFa-next threat feed: ' .. kind})
end
local parent = rspamd_config:register_symbol({name = 'EFA_FEED', score = 0.0, group = 'efa_feeds', description = 'A link, domain, attachment or IP is in a threat feed',
  callback = function(task)
    local function hit(kind, value)
      task:insert_result('EFA_FEED_' .. string.upper(kind), 1.0, value)
    end
    local ip = task:get_from_ip()
    if ip and ip:is_valid() and maps.ip and maps.ip:get_key(ip) then hit('ip', tostring(ip)) end
    for _, url in ipairs(task:get_urls() or {}) do
      local text, host = url:get_text(), string.lower(url:get_host() or '')
      if maps.url and maps.url:get_key(text) then hit('url', text) end
      if maps.domain and host ~= '' and (maps.domain:get_key(host) or maps.domain:get_key(url:get_tld() or '')) then hit('domain', host) end
    end
    for _, part in ipairs(task:get_parts() or {}) do
      if part:is_attachment() or part:get_filename() then
        local digest = hash.create_specific('sha256', part:get_content()):hex()
        if maps.sha256 and maps.sha256:get_key(digest) then hit('sha256', digest) end
      end
    end
  end})
for _, kind in ipairs({'url', 'domain', 'sha256', 'ip'}) do
  rspamd_config:register_symbol({name = 'EFA_FEED_' .. string.upper(kind), score = conf.scores[kind], group = 'efa_feeds', type = 'virtual',
                                 parent = parent, description = 'Threat feed: ' .. kind})
end
'''


def _feeds():
    return {'feeds': {}, **_json_read(FEEDS_FILE, {})}


def feed_status(_args):
    """The threat feeds: on or off, kind, last fetch and how many indicators each gave."""
    state, run = _feeds(), _json_read(FEEDS_STATE, {})
    rows = [{'name': name, 'kind': item['kind'], 'url': item['url'], 'enabled': item.get('enabled', False), 'terms_confirmed': item.get('accepted', ''),
             'last': run.get(name, {}).get('last', ''), 'result': run.get(name, {}).get('result', ''), 'indicators': run.get(name, {}).get('count', 0)}
            for name, item in sorted(state['feeds'].items())]
    presets = [{'name': name, **preset} for name, preset in FEED_PRESETS.items() if name not in state['feeds']]
    return {'feeds': rows, 'presets': presets, 'totals': {kind: len(_read_lines(path)) for kind, path in FEED_MAPS.items()}}


def feed_set(args):
    """Adds, switches or removes a feed: a preset (urlhaus, threatfox) or an own one (STIX/TAXII 2.1, MISP, plain list over HTTPS)."""
    name, action = (args.name or '').strip().lower(), (args.action or '').strip()
    if not re.fullmatch(r'[a-z0-9][a-z0-9-]{0,31}', name) or action not in ('add', 'remove', 'off'):
        raise EfaError("Name: small letters, digits, dashes; action add, off or remove.")
    state = _feeds()
    if action == 'remove':
        state['feeds'].pop(name, None)
    elif action == 'off':
        if name not in state['feeds']:
            raise EfaError('No such feed.')
        state['feeds'][name]['enabled'] = False
    else:
        preset = FEED_PRESETS.get(name, {})
        kind = (args.kind or '').strip() or preset.get('kind', '')
        url = https_url((args.url or '').strip() or preset.get('url', ''))
        if kind not in FEED_KINDS or not url:
            raise EfaError('Kind: ' + ', '.join(FEED_KINDS) + '; an https address.')
        if (args.accept_terms or '').strip() != 'yes':
            raise EfaError('Read the terms of use of the feed and type yes to accept them' + (f" ({preset['terms']})." if preset else '.'))
        item = {'kind': kind, 'url': url, 'enabled': True, 'accepted': f"{_dmarc_who()} {time.strftime('%Y-%m-%d %H:%M')}"}
        key = _secrets(1, 'API key, empty for none')[0].strip() if kind in ('stix', 'misp') else ''
        if key:
            os.makedirs(FEEDS_DIR, mode=0o700, exist_ok=True)
            _write_secret(f'{FEEDS_DIR}/{name}.key', key)
        state['feeds'][name] = item
    _json_write(FEEDS_FILE, state)
    _feeds_apply(state)
    _audit(f'threat feed {name} {action} by {_dmarc_who()}')
    return feed_status(None)


def _write_secret(path, text):
    fd = os.open(path + '.tmp', os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, 'w') as f:
        f.write(text + '\n')
    os.replace(path + '.tmp', path)


def _feeds_apply(state):
    """The Lua and its settings while a feed is on; the lists stay where they are."""
    on = any(item.get('enabled') for item in state['feeds'].values())
    with open(RSPAMD_LOCAL_LUA) as f:
        before = f.read()
    text = re.sub(r'^.*-- efa-feeds\n', '', before, flags=re.M)
    if on:
        for path in FEED_MAPS.values():
            if not os.path.exists(path):
                _write(path, '')
        _write(FEED_CONF, json.dumps({'scores': {**FEED_SCORES, **state.get('scores', {})}}, indent=1))
        _write(FEED_LUA, FEED_LUA_TEXT)
        text = text.rstrip('\n') + '\n' + FEED_LOAD_LINE
    _write(RSPAMD_LOCAL_LUA, text)
    if not _rspamd_config_ok():
        _write(RSPAMD_LOCAL_LUA, before)
        raise EfaError('rspamd rejected the feeds, nothing changed.')
    _reload_rspamd()


def feed_fetch(name, item, previous, opener=None):
    """One download, conditional: (data or None when it did not change, new state). Never over plain HTTP, at most FEED_MAX."""
    headers = {'User-Agent': 'eFa-next feed check'}
    if previous.get('etag'):
        headers['If-None-Match'] = previous['etag']
    if previous.get('modified'):
        headers['If-Modified-Since'] = previous['modified']
    method, body = 'GET', None
    key_path = f'{FEEDS_DIR}/{name}.key'
    key = open(key_path).read().strip() if os.path.exists(key_path) else ''
    if item['kind'] == 'stix':
        headers['Accept'] = 'application/taxii+json;version=2.1'
        if key:
            headers['Authorization'] = 'Basic ' + base64.b64encode(key.encode()).decode() if ':' in key else 'Bearer ' + key
    if item['kind'] == 'misp':
        method, body = 'POST', json.dumps({'returnFormat': 'json', 'type': ['url', 'link', 'domain', 'hostname', 'sha256', 'ip-dst'], 'last': '7d',
                                           'to_ids': True}).encode()
        headers.update({'Accept': 'application/json', 'Content-Type': 'application/json', 'Authorization': key})
    request = urllib.request.Request(item['url'], data=body, headers=headers, method=method)
    try:
        reply = (opener or urllib.request.urlopen)(request, timeout=60)
    except urllib.error.HTTPError as err:
        if err.code == 304:
            return None, previous
        raise
    with reply:
        data = reply.read(FEED_MAX + 1)
        if len(data) > FEED_MAX:
            raise ValueError('larger than 50 MB')
        return data, {'etag': reply.headers.get('ETag', ''), 'modified': reply.headers.get('Last-Modified', '')}


def feeds_run(_args=None):
    """The job of every hour: each feed that is on, then the four lists when something changed."""
    state = _feeds()
    run = _json_read(FEEDS_STATE, {})
    feeds = {name: item for name, item in state['feeds'].items() if item.get('enabled')}
    if not feeds:
        return {'feeds': 0}
    os.makedirs(FEEDS_DIR, mode=0o700, exist_ok=True)
    feeds_lib, changed = _lib('efa_feeds'), False
    for name, item in sorted(feeds.items()):
        previous = run.get(name, {})
        try:
            data, cache = feed_fetch(name, item, previous)
            if data is not None:
                found = feeds_lib.parse(item['kind'], data)
                _write(f'{FEEDS_DIR}/{name}.json', json.dumps({kind: sorted(values) for kind, values in found.items()}))
                changed = True
                count = sum(len(values) for values in found.values())
            else:
                count = previous.get('count', 0)
            run[name] = {**cache, 'last': time.strftime('%Y-%m-%d %H:%M'), 'result': 'ok' if data is not None else 'unchanged', 'count': count}
        except (OSError, ValueError, urllib.error.URLError) as err:
            run[name] = {**previous, 'last': time.strftime('%Y-%m-%d %H:%M'), 'result': str(err)[:200]}
            _event('feed_failed', 'warning', feed=name)
    if changed:
        merged = {kind: set() for kind in FEED_MAPS}
        for name in feeds:
            stored = _json_read(f'{FEEDS_DIR}/{name}.json', {})
            for kind in merged:
                merged[kind] |= set(stored.get(kind, []))
        for kind, path in FEED_MAPS.items():
            text = ''.join(f'{value}\n' for value in sorted(merged[kind]))
            if (open(path).read() if os.path.exists(path) else None) != text:
                _write(path + '.tmp', text)
                os.replace(path + '.tmp', path)
    _json_write(FEEDS_STATE, run)
    return {'feeds': len(feeds), 'changed': changed}

# 5x, 9: QR codes in pictures and PDF files ("quishing"). rspamd hands the parts to efa-qr; the URLs found count as EFA_QR_URL,
# more in a mail almost without text, and as EFA_QR_FEED when a threat feed names them. No OCR (docs/design-decisions.md).
QR_FILE = ETC + '/eFa/qr.json'
QR_LUA = RSPAMD_DIR + '/efa-qr.lua'
QR_UNIT = 'efa-qr'
QR_LOAD_LINE = "do local ok, err = pcall(dofile, '" + QR_LUA + "'); if not ok then require('rspamd_logger').errx(rspamd_config, 'efa-qr: %s', err) end end -- efa-qr\n"
QR_LUA_TEXT = r'''-- Written by efactl qr-set. Do not edit.
local rspamd_http = require 'rspamd_http'
local ucl = require 'ucl'
local url_map = rspamd_config:add_map({type = 'set', url = '/etc/rspamd/maps.d/efa-feed-url.map', description = 'eFa-next threat feed: url'})
local domain_map = rspamd_config:add_map({type = 'set', url = '/etc/rspamd/maps.d/efa-feed-domain.map', description = 'eFa-next threat feed: domain'})
local parent = rspamd_config:register_symbol({name = 'EFA_QR', score = 0.0, group = 'efa_qr', description = 'QR codes in pictures and PDF files',
  callback = function(task)
    local text = 0
    for _, part in ipairs(task:get_text_parts() or {}) do text = text + (part:get_length() or 0) end
    local sent = 0
    for _, part in ipairs(task:get_parts() or {}) do
      local kind = string.lower(part:get_type_full() or '')
      local size = part:get_length() or 0
      if sent < 5 and size > 100 and size <= 10485760 and (kind:find('^image/') or kind == 'application/pdf') then
        sent = sent + 1
        rspamd_http.request({task = task, url = 'http://127.0.0.1:8909/', method = 'POST', body = part:get_content(), timeout = 12,
          callback = function(err, code, body)
            if err or code ~= 200 or not body then return end
            local reply = ucl.parser()
            if not reply:parse_string(tostring(body)) then return end
            for _, url in ipairs(reply:get_object().urls or {}) do
              task:insert_result(text < 200 and 'EFA_QR_URL_TEXTLESS' or 'EFA_QR_URL', 1.0, url)
              local host = string.lower(url:match('^%a+://([^/:?#]+)') or '')
              if (url_map and url_map:get_key(url)) or (domain_map and host ~= '' and domain_map:get_key(host)) then
                task:insert_result('EFA_QR_FEED', 1.0, url)
              end
            end
          end})
      end
    end
  end})
rspamd_config:register_symbol({name = 'EFA_QR_URL', score = 2.0, group = 'efa_qr', type = 'virtual', parent = parent, description = 'A QR code with a link'})
rspamd_config:register_symbol({name = 'EFA_QR_URL_TEXTLESS', score = 5.0, group = 'efa_qr', type = 'virtual', parent = parent,
                               description = 'A QR code with a link in a mail almost without text'})
rspamd_config:register_symbol({name = 'EFA_QR_FEED', score = 10.0, group = 'efa_qr', type = 'virtual', parent = parent, description = 'The link of a QR code is in a threat feed'})
'''


def qr_status(_args):
    platform_now = _platform()
    return {'enabled': bool(_json_read(QR_FILE, {}).get('enabled')), 'service': _safe(lambda: platform_now.service_is_active(QR_UNIT), False),
            'zbar': bool(shutil.which('zbarimg')), 'pdftoppm': bool(shutil.which('pdftoppm'))}


def qr_set(args):
    """5x: QR codes in pictures and PDF files read and their links checked. Needs zbar and poppler-utils from the repositories."""
    on = _on_off(args.mode)
    platform_now = _platform()
    if on and not (shutil.which('zbarimg') and shutil.which('pdftoppm')):
        try:
            platform_now.package_install(['zbar', 'poppler-utils'])
        except Exception as err:  # the StepError of the platform layer
            raise EfaError(f'zbar and poppler-utils could not be installed (zbar comes from EPEL): {str(err)[:200]}')
    with open(RSPAMD_LOCAL_LUA) as f:
        before = f.read()
    text = re.sub(r'^.*-- efa-qr\n', '', before, flags=re.M)
    try:
        if on:
            platform_now.service_enable(QR_UNIT, start=True)
            _write(QR_LUA, QR_LUA_TEXT)
            text = text.rstrip('\n') + '\n' + QR_LOAD_LINE
        _write(RSPAMD_LOCAL_LUA, text)
        if not _rspamd_config_ok():
            raise EfaError('rspamd rejected the QR check, nothing changed.')
        if not on:
            platform_now.service_disable(QR_UNIT, stop=True)
    except EfaError:
        _write(RSPAMD_LOCAL_LUA, before)
        raise
    except Exception as err:  # the StepError of the platform layer
        _write(RSPAMD_LOCAL_LUA, before)
        raise EfaError(str(err))
    _json_write(QR_FILE, {'enabled': on}, mode=0o644)
    _reload_rspamd()
    _audit(f'QR check {"on" if on else "off"} by {_dmarc_who()}')
    return qr_status(None)

# 8j: job applications to the wrong address of a domain with EU relation are refused at the end of DATA with a fixed text,
# nothing is stored and no bounce is sent by eFa-next (the sending server tells its user). Detection by words of German and
# English applications in the subject, the text and the names of attachments. Per domain or subdomain: allowed to all (default,
# with a dashboard hint until confirmed), or only to a list of addresses. Exceptions for senders such as recruiters.
APPLICATION_FILE = ETC + '/eFa/applications.json'
APPLICATION_CONF = RSPAMD_DIR + '/efa-applications.json'
APPLICATION_LUA = RSPAMD_DIR + '/efa-applications.lua'
APPLICATION_TEXT = ('Ihre Nachricht wurde aus Datenschutzgründen nicht angenommen. Bitte erfragen Sie beim Empfänger den korrekten Weg bzw. die '
                    'korrekte Adresse für Bewerbungen. / Your message was not accepted for data protection reasons. Please ask the recipient '
                    'for the correct way or address to send applications.')
APPLICATION_WORDS = {
    'subject': ['bewerbung', 'initiativbewerbung', 'job application', 'application for', 'bewerbung als', 'lebenslauf', 'curriculum vitae', 'resume', 'résumé'],
    'text': ['bewerbe mich', 'bewerbe ich mich', 'meine bewerbung', 'meinen lebenslauf', 'i am applying', 'i would like to apply', 'my application',
             'my resume', 'my cv', 'attached my cv', 'anbei meine bewerbungsunterlagen', 'bewerbungsunterlagen'],
    'file': ['lebenslauf', 'bewerbung', 'zeugnis', 'zeugnisse', 'anschreiben', 'cv', 'resume', 'curriculum', 'cover_letter', 'cover-letter', 'motivationsschreiben'],
}
APPLICATION_LOAD_LINE = ("do local ok, err = pcall(dofile, '" + APPLICATION_LUA + "'); if not ok then require('rspamd_logger').errx(rspamd_config, 'efa-applications: %s', err) "
                         "end end -- efa-applications\n")
APPLICATION_LUA_TEXT = r'''-- Written by efactl application-set. Do not edit.
local ucl = require 'ucl'
local parser = ucl.parser()
if not parser:parse_file('/etc/rspamd/efa-applications.json') then return end
local conf = parser:get_object()
local function lower(text) return string.lower(tostring(text or '')) end
local function any_word(text, words)
  for _, word in ipairs(words or {}) do if text:find(word, 1, true) then return word end end
end
rspamd_config:register_symbol({name = 'EFA_APPLICATION', score = 0.0, group = 'efa_applications', type = 'postfilter', priority = 6,
  description = 'A job application to an address of the domain that does not take them', callback = function(task)
    if task:get_user() then return end
    local from = task:get_from('smtp')
    local sender = from and from[1] and lower(from[1].addr) or ''
    local sender_domain = sender:match('@(.+)$') or ''
    for _, item in ipairs(conf.exceptions or {}) do if sender == item or sender_domain == item then return end end
    local blocked
    for _, rcpt in ipairs(task:get_recipients('smtp') or {}) do
      local addr, domain = lower(rcpt.addr), lower(rcpt.domain)
      local rule = (conf.domains or {})[domain]
      if not rule then
        local parent = domain:match('^[^.]+%.(.+)$')
        rule = parent and (conf.domains or {})[parent]
      end
      if rule and rule.mode == 'list' then
        local allowed = false
        for _, item in ipairs(rule.allowed or {}) do if item == addr then allowed = true end end
        if not allowed then blocked = rule end
      end
    end
    if not blocked then return end
    local signals = {}
    local word = any_word(lower(task:get_subject()), conf.words.subject)
    if word then signals[#signals + 1] = 'subject:' .. word end
    for _, part in ipairs(task:get_text_parts() or {}) do
      local content = part:get_content()
      if content and #content < 200000 then
        word = any_word(lower(content), conf.words.text)
        if word then signals[#signals + 1] = 'text:' .. word; break end
      end
    end
    for _, part in ipairs(task:get_parts() or {}) do
      local name = lower(part:get_filename())
      if name ~= '' then
        word = any_word(name, conf.words.file)
        if word then signals[#signals + 1] = 'file:' .. word; break end
      end
    end
    if #signals >= (conf.min_signals or 2) then
      task:insert_result('EFA_APPLICATION', 1.0, table.concat(signals, ','))
      task:set_pre_result({action = 'reject', message = blocked.text or conf.text, module = 'efa_applications', priority = 4})
    end
  end})
'''


def application_state():
    return {'domains': {}, 'exceptions': [], 'min_signals': 2, **_json_read(APPLICATION_FILE, {})}


def application_conf(state):
    return {'domains': {domain: {'mode': rule['mode'], 'allowed': rule.get('allowed', []), 'text': rule.get('text') or APPLICATION_TEXT}
                        for domain, rule in state['domains'].items() if rule.get('mode') == 'list'},
            'exceptions': state['exceptions'], 'min_signals': state['min_signals'], 'words': APPLICATION_WORDS, 'text': APPLICATION_TEXT}


def _application_apply(state):
    conf = application_conf(state)
    with open(RSPAMD_LOCAL_LUA) as f:
        before = f.read()
    text = re.sub(r'^.*-- efa-applications\n', '', before, flags=re.M)
    if conf['domains']:
        _write(APPLICATION_CONF, json.dumps(conf, indent=1, ensure_ascii=False))
        _write(APPLICATION_LUA, APPLICATION_LUA_TEXT)
        text = text.rstrip('\n') + '\n' + APPLICATION_LOAD_LINE
    _write(RSPAMD_LOCAL_LUA, text)
    if not _rspamd_config_ok():
        _write(RSPAMD_LOCAL_LUA, before)
        raise EfaError('rspamd rejected the settings for applications, nothing changed.')
    _json_write(APPLICATION_FILE, state, mode=0o644)
    _reload_rspamd()


def application_status(_args):
    """8j: per domain whether job applications go to everybody or only to listed addresses, and the exceptions."""
    state = application_state()
    rows = [{'domain': domain, **rule} for domain, rule in sorted(state['domains'].items())
            if not identity_now or identity_now.get('domains') is None or domain in identity_now['domains']]
    return {'domains': rows, 'exceptions': state['exceptions'], 'open_unconfirmed': application_unconfirmed(state)}


def application_unconfirmed(state):
    """Own domains with EU relation without a choice for applications: the dashboard asks for it."""
    return sorted(domain for domain in _local_domains() if eu_relation(domain) is not False and domain not in state['domains'])


def application_set(args):
    """For a domain or subdomain: applications allowed to all (confirmed), or only to these addresses; with the own refusal text."""
    domain, mode = (args.domain or '').strip().lower(), (args.mode or '').strip()
    if not DOMAIN_RE.match(domain):
        raise EfaError('Invalid domain.')
    if identity_now and identity_now.get('domains') is not None and domain not in identity_now['domains'] and \
            not any(domain.endswith('.' + item) for item in identity_now['domains']):
        raise EfaError('Not allowed: name one of your own domains.')
    if mode not in ('open', 'list', 'inherit'):
        raise EfaError("Mode: open (allowed to all), list (only the allowed addresses) or inherit.")
    state = application_state()
    if mode == 'inherit':
        state['domains'].pop(domain, None)
    else:
        rule = {'mode': mode}
        if mode == 'list':
            allowed = sorted({item.strip().lower() for item in re.split(r'[\s,;]+', args.allowed or '') if item.strip()})
            if not allowed or not all(SENDER_RE.match(item) and item.endswith('@' + domain) for item in allowed):
                raise EfaError(f'Allowed addresses: one or more addresses of {domain}, such as jobs@{domain}.')
            rule['allowed'] = allowed
        text = ' '.join((args.text or '').split())
        if text:
            if '@' in text or len(text) > 400:
                raise EfaError('The refusal text: up to 400 characters and no address in it.')
            rule['text'] = text
        state['domains'][domain] = rule
    _application_apply(state)
    _audit(f'applications of {domain} set to {mode} by {_dmarc_who()}')
    return application_status(None)


def application_exception_set(args):
    """A sender or sender domain, such as a recruiter, whose applications always pass."""
    item, action = (args.sender or '').strip().lower(), (args.action or '').strip()
    if not (SENDER_RE.match(item) or DOMAIN_RE.match(item)) or action not in ('add', 'remove'):
        raise EfaError("An address or a domain, and the action 'add' or 'remove'.")
    state = application_state()
    state['exceptions'] = sorted(set(state['exceptions']) | {item}) if action == 'add' else [x for x in state['exceptions'] if x != item]
    _application_apply(state)
    _audit(f'application exception {item} {action} by {_dmarc_who()}')
    return application_status(None)

# 9o: the CVE watch, every 15 minutes and after each change of the installed packages. Sources: the OVAL data of the
# distribution (with the CVSS vector and CWE of each CVE), the signed advisory feed of eFa-next, and the list of exploited
# vulnerabilities of ENISA (EUVD), which only raises the priority. Only GETs, never a package list or host name. It warns the
# admins at once of a hole that can be reached over the network (AV:N or AV:A) and breaks confidentiality or integrity, or is
# remote code, an auth bypass or a leak, in a package of a listening or mail-handling service; the rest comes once a week.
# The web page reads the result of the last run.
CVE_FILE = ETC + '/eFa/cve-watch.json'
CVE_STATE = '/var/lib/eFa/cve-watch.json'
CVE_FEED = 'https://repo.efa-next.eu/advisories/advisories.json'
EUVD_URL = 'https://euvdservices.enisa.europa.eu/api/search?exploited=true&size=100'
WEB_STACK = ('nginx', 'nginx-core', 'nginx-filesystem', 'python3', 'python3-libs', 'openssl', 'openssl-libs', 'glibc', 'eFa-next', 'eFa-next-base')
MAIL_STACK = WEB_STACK + ('postfix', 'rspamd', 'clamav', 'clamd', 'clamav-lib', 'dovecot', 'mariadb', 'mariadb-server', 'redis', 'valkey',
                          'unbound', 'unbound-libs', 'openssh-server', 'cyrus-sasl', 'cyrus-sasl-lib', 'libxml2', 'zlib', 'libarchive',
                          'poppler', 'poppler-utils', 'zbar', 'file-libs', 'pcre2', 'libssh', 'krb5-libs', 'curl', 'libcurl')
# Code from outside, a way past the login, a leak: these count even without a high impact in the vector.
CWE_SERIOUS = {'CWE-77', 'CWE-78', 'CWE-94', 'CWE-502', 'CWE-287', 'CWE-288', 'CWE-290', 'CWE-306', 'CWE-200', 'CWE-918', 'CWE-22'}
CWE_WEB = {'CWE-77', 'CWE-78', 'CWE-94', 'CWE-502', 'CWE-287', 'CWE-288', 'CWE-290', 'CWE-306'}
CERTBOT_STACK = {'python3', 'python3-libs', 'openssl', 'openssl-libs', 'glibc'}
LOCKDOWN_UNITS = ('nginx', 'efa-web', 'efa-portal')
LOCKDOWN_EFFECTS = ('the web interface, the user portal and the release links are not reachable', 'mail flows on',
                    "Let's Encrypt renews with its own short web server on port 80 while nginx is stopped",
                    'the DKIM API (8463) and the cluster port stay on: close them yourself if they are reachable from outside')
MOTD_FILE = ETC + '/motd.d/efa-web-lockdown'
CVE_ITEMS_MAX, EXPLOITED_MAX = 200, 20000


def cve_settings():
    return {'mode': 'on', 'lockdown': 'off', 'muted': {}, **_json_read(CVE_FILE, {})}


def cvss_metrics(vector):
    """{'AV': 'N', 'C': 'H', ...} of a CVSS 3 vector such as CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H; {} without one."""
    return dict(part.split(':', 1) for part in str(vector or '').split('/')[1:] if ':' in part)


def cve_serious(vector, cwe):
    """Reachable over the network, and confidentiality or integrity high, or code, a login bypass or a leak."""
    metrics = cvss_metrics(vector)
    return metrics.get('AV') in ('N', 'A') and (metrics.get('C') == 'H' or metrics.get('I') == 'H' or cwe in CWE_SERIOUS)


def cve_web_hole(item):
    """9o-b: a hole of the web stack anyone reaches without a login: AV:N, PR:N and C:H or I:H, or code / a login bypass."""
    metrics = cvss_metrics(item.get('vector'))
    return item['package'] in WEB_STACK and (item.get('web_rce') or metrics.get('AV') == 'N' and metrics.get('PR') == 'N' and
                                             (metrics.get('C') == 'H' or metrics.get('I') == 'H' or item.get('cwe') in CWE_WEB))


def cve_key(item):
    """The key of a warning; a new assessment (another fix, vector or CWE) is another key, so a mute ends with it."""
    return hashlib.sha256(f"{item['cve']}|{item['package']}|{item['fixed']}|{item.get('vector')}|{item.get('cwe')}".encode()).hexdigest()[:16]


def _newest(versions, older):
    newest = versions[0] if versions else None
    for have in versions[1:]:
        if older(newest, have):
            newest = have
    return newest


def _evr(version):
    return (f'{version[0]}:' if version[0] not in ('', '0', None) else '') + '-'.join(str(part) for part in version[1:])


def cve_items(definitions, package_tests, installed, older, exposed, exploited, ports=None):
    """One item per package and CVE that this host lacks the fix of, for listening and mail-handling packages only."""
    found = {}
    for item in definitions:
        details = item.get('details', {})
        for test in item['tests']:
            if test not in package_tests:
                continue
            name, fixed = package_tests[test]
            if name not in exposed and name not in MAIL_STACK:
                continue
            newest = _newest(installed.get(name, []), older)
            if newest is None or not oval_same_stream(newest, fixed) or not older(newest, fixed):
                continue
            for cve in item['cves'] or [item['title'].split(':')[0]]:
                vector, cwe, link = details.get(cve, ('', '', ''))
                key = (name, cve)
                if key in found and not older(tuple(found[key]['fixed_evr']), fixed):
                    continue
                found[key] = {'cve': cve, 'package': name, 'installed': _evr(newest), 'fixed': _evr(fixed), 'fixed_evr': list(fixed),
                              'vector': vector, 'cwe': cwe, 'severity': item['severity'], 'advisory': item['title'].split(':')[0][:40],
                              'link': link or f'https://euvd.enisa.europa.eu/search?text={cve}', 'source': 'OVAL',
                              'exploited': cve in exploited, 'exposed': name in exposed, 'ports': (ports or {}).get(name, [])}
    return list(found.values())


def advisory_items(advisories, installed, older, exposed, exploited, ports=None):
    """The entries of the signed feed of eFa-next whose fix this host lacks, as items like those of OVAL."""
    found = []
    for entry in advisories:
        name, fixed = str(entry.get('package', '')), entry.get('fixed')
        newest = _newest(installed.get(name, []), older)
        if newest is None or not isinstance(fixed, list) or len(fixed) != 3:
            continue
        fixed = tuple(str(part) for part in fixed)
        if not older(newest, fixed):
            continue
        for cve in [str(cve)[:20] for cve in entry.get('cves', [])][:10] or [str(entry.get('id', ''))[:40]]:
            found.append({'cve': cve, 'package': name, 'installed': _evr(newest), 'fixed': _evr(fixed), 'fixed_evr': list(fixed),
                          'vector': str(entry.get('vector', ''))[:80], 'cwe': str(entry.get('cwe', ''))[:12], 'severity': str(entry.get('severity', ''))[:12],
                          'advisory': str(entry.get('id', ''))[:40], 'link': str(entry.get('link', ''))[:200], 'source': 'eFa-next advisory',
                          'summary': str(entry.get('summary', ''))[:200], 'remote': bool(entry.get('remote')), 'web_rce': bool(entry.get('web_rce')),
                          'exploited': cve in exploited, 'exposed': name in exposed, 'ports': (ports or {}).get(name, [])})
    return found


def cve_urgent(item):
    return item.get('remote') or item.get('severity') == 'Critical' or cve_serious(item.get('vector'), item.get('cwe'))


def cve_sorted(items):
    """Urgent first, then exploited, then reachable from outside."""
    return sorted(items, key=lambda item: (not cve_urgent(item), not item['exploited'], not item['exposed'], item['package'], item['cve']))


def cve_alerts(items, muted):
    return [item for item in cve_sorted(items) if cve_urgent(item) and cve_key(item) not in muted]


def lockdown_trigger(items):
    """9o-b: only items of the distribution or of the signed feed (EUVD never counts alone, it only marks), never OVAL guesses."""
    return sorted({f"{item['cve']} ({item['package']})" for item in items if item['source'] in ('OVAL', 'eFa-next advisory') and cve_web_hole(item)})


def cve_line(item):
    where = f" on port {', '.join(str(port) for port in item['ports'])}" if item.get('ports') else ''
    return (f"{item['cve']} in {item['package']}{where}: installed {item['installed']}, fixed in {item['fixed']}"
            f"{' (exploited, EUVD)' if item['exploited'] else ''}. {item['link']}")


def _admin_addresses():
    """The alert address and every active super admin with an address: the warning goes to all of them."""
    found = {_admin_email()} - {''}
    try:
        found |= {row['email'] for row in _admin_query("SELECT u.email FROM users u JOIN user_groups m ON m.username = u.username JOIN efa_groups g "
                                                       "ON g.id = m.group_id WHERE g.builtin = 'super' AND u.disabled = 0 AND u.email LIKE '%%@%%'")}
    except Exception:  # no database (yet): the alert address only
        pass
    return sorted(found)


def _admins_notify(subject, text):
    for address in _admin_addresses():
        subprocess.run(['sendmail', '-t'], input=f'To: {address}\nSubject: {subject}\n\n{text}\n', text=True, capture_output=True, check=False)


def _fetch_json(url, state, name, limit):
    """A JSON document, loaded only when it changed (ETag); None when unchanged or not reachable, then the reason in state."""
    headers = {'User-Agent': 'eFa-next'}
    if state.get(name + '_etag'):
        headers['If-None-Match'] = state[name + '_etag']
    try:
        with urllib.request.urlopen(urllib.request.Request(url, headers=headers), timeout=20) as reply:
            data = reply.read(limit + 1)
            if len(data) > limit:
                state[name + '_status'] = 'too large'
                return None
            state[name + '_etag'] = reply.headers.get('ETag', '')
            state[name + '_ok'] = time.time()
            state[name + '_status'] = 'loaded'
            return data
    except urllib.error.HTTPError as err:
        if err.code == 304:
            state.update({name + '_ok': time.time(), name + '_status': 'unchanged'})
        else:
            state[name + '_status'] = f'HTTP {err.code}'
    except OSError as err:
        state[name + '_status'] = f'not reachable: {str(err)[:80]}'
    return None


def _advisories(state):
    """The signed feed of eFa-next: the last good copy when it is unchanged, not reachable, or its signature does not fit."""
    data = _fetch_json(CVE_FEED, state, 'feed', 4 * 1024 * 1024)
    if data is not None:
        sign = _lib('efa_sign')
        try:
            with urllib.request.urlopen(urllib.request.Request(CVE_FEED + '.sig', headers={'User-Agent': 'eFa-next'}), timeout=20) as reply:
                signature = reply.read(65536)
            with open(sign.KEY_FILE, 'rb') as f:
                good = sign.verify(data, signature, f.read())
        except OSError:
            good = False
        try:
            feed = json.loads(data).get('advisories', []) if good else None
        except (ValueError, AttributeError):
            feed = None
        if isinstance(feed, list):
            state['feed'] = [item for item in feed if isinstance(item, dict)][:2000]
        else:
            state.update(feed_status='the signature of the feed does not fit, the last good copy is used', feed_etag='', feed_ok=0)
    return state.get('feed', [])


def euvd_exploited(pages, state):
    """The CVEs of the exploited vulnerabilities of ENISA: {cve: since}. Each page: {'items': [{'aliases', 'exploitedSince'}]}."""
    found = state.get('exploited', {})
    for page in pages:
        for item in (page.get('items') if isinstance(page, dict) else None) or []:
            if isinstance(item, dict):
                for alias in str(item.get('aliases', '')).split():
                    if re.fullmatch(r'CVE-\d{4}-\d{4,7}', alias):
                        found[alias] = str(item.get('exploitedSince', ''))[:40]
    return dict(sorted(found.items())[-EXPLOITED_MAX:])


def _euvd_job(state):
    """Once an hour: the exploited list of ENISA, changed entries only after the first full load."""
    if time.time() - state.get('euvd_at', 0) < 3600:
        return
    since = time.strftime('%Y-%m-%d', time.gmtime(state['euvd_at'] - 86400)) if state.get('euvd_at') else ''
    pages = []
    for number in range(30):
        data = _fetch_json(EUVD_URL + f'&page={number}' + (f'&fromUpdatedDate={since}' if since else ''), {}, 'euvd', 2 * 1024 * 1024)
        try:
            page = json.loads(data) if data else None
        except ValueError:
            page = None
        if not isinstance(page, dict):
            break
        pages.append(page)
        if len(page.get('items') or []) < 100:
            break
    if pages:
        state.update(exploited=euvd_exploited(pages, state), euvd_at=time.time(), euvd_status=f'{len(pages)} pages')
    else:
        state['euvd_status'] = 'not reachable'


def cve_watch_run(_args=None):
    """The job: OVAL, the signed feed and EUVD against the installed packages; urgent warnings once (again after a day), the rest weekly."""
    settings_now = cve_settings()
    if settings_now['mode'] != 'on':
        return {'mode': 'off'}
    platform_now = _platform()
    try:
        listening = platform_now.listening()
    except Exception:  # the StepError of the platform layer
        listening = []
    ports = {}
    for item in listening:
        if item['package'] and item['address'] not in ('127.0.0.1', '::1'):
            ports.setdefault(item['package'], sorted(set(ports.get(item['package'], [])) | {item['port']}))
    installed, now = platform_now.package_versions(), time.time()
    oval_status = _oval_fetch()
    state = _json_read(CVE_STATE, {})
    if oval_status in ('loaded', 'unchanged'):
        state['oval_ok'] = now
    _euvd_job(state)
    exploited = state.get('exploited', {})
    # OVAL is parsed again only when it, the installed packages or the exploited list changed: not every 15 minutes.
    key = hashlib.sha256(json.dumps([sorted(installed.items()), sorted(ports.items()), len(exploited)], default=list).encode()).hexdigest()
    if os.path.exists(OVAL_FILE) and (oval_status == 'loaded' or state.get('oval_key') != key or 'oval_items' not in state):
        import bz2
        with bz2.open(OVAL_FILE) as stream:
            definitions, package_tests = oval_parse(stream)
        state.update(oval_items=cve_sorted(cve_items(definitions, package_tests, installed, platform_now.version_older, set(ports), exploited, ports))[:CVE_ITEMS_MAX],
                     oval_key=key)
    items = state.get('oval_items', []) + advisory_items(_advisories(state), installed, platform_now.version_older, set(ports), exploited, ports)
    alerts = cve_alerts(items, settings_now['muted'])
    told = hashlib.sha256(json.dumps(sorted(cve_key(item) for item in alerts)).encode()).hexdigest()
    if alerts and (told != state.get('told_key') or now - state.get('told_at', 0) > 86400):
        _admins_notify('eFa-next: CVE warning / CVE-Warnung', '\n'.join('- ' + cve_line(item) for item in alerts[:30]) +
                       '\n\nInstall the updates: Maintenance & update, Update system (efactl update-now --confirm yes).')
        for item in alerts:
            _event('cve_alert', 'critical', cve=item['cve'], package=item['package'], installed=item['installed'], fixed=item['fixed'],
                   exploited=item['exploited'], source=item['source'])
        _audit(f'CVE watch warned of {len(alerts)} items: ' + ', '.join(item['cve'] for item in alerts[:10]))
        state.update(told_key=told, told_at=now)
    rest = [item for item in items if not cve_urgent(item)]
    if rest and now - state.get('weekly_at', 0) > 7 * 86400:
        _admins_notify('eFa-next: CVE summary of the week / CVE-Wochenübersicht', f'{len(rest)} known holes without urgency on this host:\n' +
                       '\n'.join('- ' + cve_line(item) for item in rest[:50]))
        state['weekly_at'] = now
    state.update(last=now, alerts=alerts[:CVE_ITEMS_MAX], rest=len(rest), oval_status=oval_status)
    _lockdown_check(lockdown_trigger(items), settings_now, state)
    _lockdown_certificate(state, items)
    _json_write(CVE_STATE, state, mode=0o644)
    return {'alerts': len(alerts), 'later': len(rest), 'oval': oval_status, 'feed': state.get('feed_status', ''), 'euvd': state.get('euvd_status', '')}


def cve_notices():
    """The dashboard: a lock of the web services, and no source answering for 6 hours. The warnings themselves: cve_banner."""
    state, found = _json_read(CVE_STATE, {}), []
    if cve_settings()['mode'] != 'on' or not state.get('last'):
        return found
    if time.time() - max(state.get('oval_ok', 0), state.get('feed_ok', 0)) > 6 * 3600:
        found.append(_text('CVE watch: no source of security advisories answered for 6 hours ({status}).', status=state.get('oval_status', '')))
    return found


def cve_banner():
    """The red banner of the dashboard, in the standard view too: each urgent hole with package, versions, port and what to do."""
    state = _json_read(CVE_STATE, {})
    if cve_settings()['mode'] != 'on':
        return []
    found = [_text('Web services locked because of {items}: install the update (Maintenance & update), then they come back.',
                   items=', '.join(state['locked']['for']))] if state.get('locked') else []
    for item in state.get('alerts', [])[:5]:
        found.append(_text('CVE warning: {line} Install the updates (Maintenance & update, Update system).', line=cve_line(item)))
    if len(state.get('alerts', [])) > 5:
        found.append(_text('{count} more CVE warnings: Security, CVE watch.', count=len(state['alerts']) - 5))
    return found


def cve_watch_status(_args):
    """9o: the last result of the CVE watch, and the self-lockdown of the web services."""
    state, settings_now = _json_read(CVE_STATE, {}), cve_settings()
    return {'mode': settings_now['mode'], 'lockdown': settings_now['lockdown'], 'locked_now': state.get('locked'),
            'last': time.strftime('%Y-%m-%d %H:%M', time.localtime(state['last'])) if state.get('last') else 'never',
            'alerts': [{'key': cve_key(item), **{name: item[name] for name in ('cve', 'package', 'installed', 'fixed', 'ports', 'exploited', 'source', 'link')}}
                       for item in state.get('alerts', [])],
            'later': state.get('rest', 0), 'oval': state.get('oval_status', ''), 'feed': state.get('feed_status', ''),
            'euvd': state.get('euvd_status', ''), 'muted': settings_now['muted']}


def cluster_cve(_args):
    """9o on the master of a cluster: the warnings of every node."""
    rows, errors = _cluster_each('cve-watch-status', {}, 'alerts')
    return {'alerts': rows, 'unreachable': errors}


def cve_watch_set(args):
    """The CVE watch on or off (on by default), and the self-lockdown of the web services (off by default, super admin)."""
    settings_now = cve_settings()
    settings_now['mode'] = 'on' if _on_off(args.mode) else 'off'
    lockdown = (getattr(args, 'lockdown', '') or '').strip()
    if lockdown:
        if lockdown not in ('off', 'all', 'admin-nets'):
            raise EfaError("Self-lockdown: off, all or admin-nets.")
        if identity_now and identity_now.get('role') != 'super':
            raise EfaError('Only a super admin sets the self-lockdown.')
        if lockdown != 'off' and (getattr(args, 'confirm', '') or '').strip() != 'yes':
            raise EfaError('Type yes. At a critical hole of the web stack: ' + '; '.join(LOCKDOWN_EFFECTS) + '.')
        if lockdown == 'admin-nets' and not _web_allow_state()['entries']:
            raise EfaError('Admin networks first: Security, Admin access (web allowlist).')
        settings_now['lockdown'] = lockdown
    _json_write(CVE_FILE, settings_now, mode=0o644)
    _audit(f'CVE watch {settings_now["mode"]}, self-lockdown {settings_now["lockdown"]} by {_dmarc_who()}')
    return {**cve_watch_status(None), 'side_effects': list(LOCKDOWN_EFFECTS) if settings_now['lockdown'] != 'off' else []}


def cve_mute(args):
    """Mutes one warning of the CVE watch, with a reason; a new assessment of the hole warns again."""
    key, reason = (args.key or '').strip(), ' '.join((args.reason or '').split())
    if not re.fullmatch(r'[0-9a-f]{16}', key):
        raise EfaError('The key of the warning, as cve-watch-status shows it.')
    if len(reason) < 5:
        raise EfaError('A reason of at least 5 characters.')
    item = next((item for item in _json_read(CVE_STATE, {}).get('alerts', []) if cve_key(item) == key), None)
    if item is None:
        raise EfaError('No open warning with this key.')
    settings_now = cve_settings()
    settings_now['muted'][key] = f"{item['cve']} {item['package']}: {reason[:200]} ({_dmarc_who()})"
    _json_write(CVE_FILE, settings_now, mode=0o644)
    _audit(f"CVE warning {item['cve']} in {item['package']} muted by {_dmarc_who()}: {reason[:200]}")
    return cve_watch_status(None)


def _lockdown_check(trigger, settings_now, state):
    """9o-b: lock the web services while a trigger is there, open them again once it is gone. Never in a loop after a manual release."""
    locked = state.get('locked')
    if trigger and settings_now['lockdown'] != 'off' and not locked and not set(trigger) <= set(state.get('released_for', [])):
        _lockdown(True, settings_now['lockdown'], trigger)
        state.update(locked={'since': time.time(), 'for': trigger, 'mode': settings_now['lockdown']})
    elif locked and not trigger:
        _lockdown(False, locked['mode'], [])
        state.pop('locked', None)
    if not trigger:
        state.pop('released_for', None)


def _lockdown(on, mode, trigger):
    platform_now = _platform()
    if on:
        if mode == 'admin-nets':
            web_allowlist_lock(True)
        else:
            for unit in LOCKDOWN_UNITS:
                _safe(lambda unit=unit: platform_now.service_stop(unit), None)
        _write(MOTD_FILE, f"eFa-next: the web services are locked because of {', '.join(trigger)}. Install the update (efactl update-now --confirm yes), "
                          'or release them: efactl web-lockdown --action release --reason "..."\n')
        _admins_notify('eFa-next: web services locked / Webdienste gesperrt', f"Because of {', '.join(trigger)} the web services are locked ({mode}). "
                       'Mail flows on; the user portal is off too. Install the update, then they come back by themselves.')
        _event('web_lockdown', 'critical', reason=', '.join(trigger)[:200], mode=mode)
    else:
        if mode == 'admin-nets':
            web_allowlist_lock(False)
        for unit in LOCKDOWN_UNITS:
            _safe(lambda unit=unit: platform_now.service_start(unit), None)
        if os.path.exists(MOTD_FILE):
            os.remove(MOTD_FILE)
        _event('web_lockdown_end', 'notice')
    _audit(f'web services {"locked" if on else "opened"} ({mode}) for {", ".join(trigger) or "the patch is in"}')


def _lockdown_certificate(state, items):
    """While nginx is stopped, Let's Encrypt renews with the short web server of certbot on port 80 (open already for the
    challenge, nothing in the firewall changes); not when the hole is in the stack certbot itself runs on."""
    locked = state.get('locked')
    if not locked or locked['mode'] != 'all' or not glob.glob('/etc/letsencrypt/renewal/*.conf') or state.get('renew_day') == _today().isoformat():
        return
    end = _safe(_certificate_end, None)
    if end is None or end - time.time() > 30 * 86400:
        return
    state['renew_day'] = _today().isoformat()
    if any(item['package'] in CERTBOT_STACK for item in items if cve_web_hole(item)):
        _admins_notify("eFa-next: Let's Encrypt waits / Zertifikat wartet", 'The certificate expires within 30 days, but the hole that locked the '
                       'web services is in the stack of certbot itself: the renewal waits for the update.')
        _audit('certificate renewal during the self-lockdown postponed: the hole is in the stack of certbot')
        return
    done = subprocess.run(['certbot', 'renew', '--authenticator', 'standalone', '--non-interactive', '--quiet'], capture_output=True, text=True, timeout=300)
    if done.returncode == 0:
        _platform().service_reload_if_active('postfix')
    result = 'renewed' if done.returncode == 0 else 'failed: ' + (done.stderr or done.stdout)[-200:]
    _admins_notify("eFa-next: Let's Encrypt during the lock / Zertifikat während der Sperre", f'Renewal with the own web server of certbot: {result}')
    _audit(f'certificate renewal during the self-lockdown: {result}')


def web_allowlist_lock(on):
    """admin-nets: while locked only the networks of the web allowlist reach nginx at all, the portal too (the ACME challenge
    stays open); then the list of before. nginx refuses the file: the services stop instead (fail closed)."""
    state = _web_allow_state()
    text = admin_allow_conf({'mode': 'allowed', 'entries': state['entries']}, portal_open=False) if on else admin_allow_conf(state)
    before = open(NGINX_ADMIN_ALLOW).read() if os.path.exists(NGINX_ADMIN_ALLOW) else ''
    _write(NGINX_ADMIN_ALLOW, text)
    if subprocess.run(['nginx', '-t'], capture_output=True).returncode != 0:
        _write(NGINX_ADMIN_ALLOW, before)
        if on:
            for unit in LOCKDOWN_UNITS:
                _safe(lambda unit=unit: _platform().service_stop(unit), None)
        return
    _platform().service_reload_if_active('nginx')


def web_lockdown(args):
    """9o-b: the state of the self-lockdown, or a release by hand with a reason (it does not lock again for the same items)."""
    action = (args.action or 'status').strip()
    state = _json_read(CVE_STATE, {})
    if action == 'status':
        return {'locked': state.get('locked'), 'mode': cve_settings()['lockdown']}
    if action != 'release':
        raise EfaError("Action: status or release.")
    reason = ' '.join((args.reason or '').split())
    if len(reason) < 5 or not state.get('locked'):
        raise EfaError('Nothing is locked, or the reason is shorter than 5 characters.')
    _lockdown(False, state['locked']['mode'], [])
    state['released_for'] = state['locked']['for']
    state.pop('locked', None)
    _json_write(CVE_STATE, state, mode=0o644)
    _audit(f'web self-lockdown released by {_dmarc_who()}: {reason[:200]}')
    return {'locked': None}


# 6a: the mail security of each own domain from DNS, through the own resolver and two public ones (IPv4 and IPv6): MX, SPF,
# DKIM, DMARC, MTA-STS, TLS-RPT, DNSSEC, DANE, BIMI, PTR/HELO, and what the outside sees differently. Every 6 hours in the
# hourly job and on demand; the page reads the last result. The public resolvers are those of the DKIM rotation, or DNS4EU
# and Quad9 (EU / Switzerland). They see only the names of the own domains, which are public anyway.
DOMAIN_CHECK_FILE = ETC + '/eFa/domain-check.json'
DOMAIN_CHECK_STATE = '/var/lib/eFa/domain-check.json'
DOMAIN_CHECK_RESOLVERS = {'ipv4_1': '86.54.11.100', 'ipv4_2': '9.9.9.9', 'ipv6_1': '2a13:1001::86:54:11:100', 'ipv6_2': '2620:fe::fe'}
DOMAIN_CHECK_HOURS = 6


def domain_check_settings():
    return {'mode': 'off', 'prompt': 'on', **_json_read(DOMAIN_CHECK_FILE, {})}


def _dig(name, rtype, resolver='127.0.0.1', dnssec=False):
    """(answers, ad flag, status) of one query; status NOERROR, NXDOMAIN, SERVFAIL or timeout."""
    try:
        done = subprocess.run(['dig', '+time=3', '+tries=1', '+noall', '+answer', '+comments', *(['+dnssec'] if dnssec else []), rtype, name,
                               f'@{resolver}'], capture_output=True, text=True, timeout=10)
    except subprocess.TimeoutExpired:
        return [], False, 'timeout'
    match = re.search(r'status: (\w+)', done.stdout)
    status = match.group(1) if match else 'timeout' if done.returncode else 'NOERROR'
    answers = [line.split(None, 4)[4] for line in done.stdout.splitlines()
               if line and not line.startswith(';') and len(line.split(None, 4)) == 5 and line.split(None, 4)[3] == rtype]
    return answers, bool(re.search(r'flags:[^;]*\bad\b', done.stdout)), status


def _domain_dkim(domain, keys):
    found = []
    for key in keys:
        answers, _ad, _status = _dig(f"{key['selector']}._domainkey.{domain}", 'TXT')
        if _dns_shows_key(answers, key['public'][1]):
            found.append(_lib('efa_domaincheck').check(f"DKIM {key['selector']}", 'green', 'the key in DNS is the one eFa-next signs with'))
        else:
            found.append(_lib('efa_domaincheck').check(f"DKIM {key['selector']}", 'red', 'missing in DNS' if not answers else 'another key in DNS',
                                                       'the key of eFa-next', f"{key['selector']}._domainkey.{domain}. IN TXT \"{_dkim_value(key)}\""))
    return found or [_lib('efa_domaincheck').check('DKIM', 'yellow', 'eFa-next signs no mail of this domain', 'a key: DKIM, ARC & DMARC')]


def _domain_mta_sts(domain, dc):
    item = _json_read(MTA_STS_FILE, {}).get(domain)
    if item:
        problems = _json_read(MTA_STS_STATE, {}).get('domains', {}).get(domain)
        if problems is None:
            return dc.check('MTA-STS', 'yellow', 'policy written here, not checked yet', 'MTA-STS: check now')
        return dc.check('MTA-STS', 'red' if problems else 'green', '; '.join(problems) or f"mode {item['mode']}, id {item['id']}")
    answers, _ad, _status = _dig(f'_mta-sts.{domain}', 'TXT')
    if not any(dc.txt_value(line).startswith('v=STSv1') for line in answers):
        return dc.check('MTA-STS', 'red', 'no MTA-STS record', 'a policy: Protection, MTA-STS (testing first)')
    fetched = _mta_sts_fetch(domain)
    try:
        policy = mta_sts_parse(fetched) if not fetched.startswith('error: ') else None
    except ValueError as err:
        return dc.check('MTA-STS', 'red', f'the policy served is not valid: {err}')
    if policy is None:
        return dc.check('MTA-STS', 'red', f'policy not reachable: {fetched[7:]}')
    return dc.check('MTA-STS', 'green', f"mode {policy['mode']}, mx {', '.join(policy['mx'])} (not written here)")


def domain_check_one(domain, resolvers, own_host, own_ips, spki, keys, report_address):
    """The checks of one domain."""
    dc = _lib('efa_domaincheck')
    txt = lambda name: _dig(name, 'TXT')[0]
    checks = []
    mx = sorted(line.split()[-1].lower().rstrip('.') for line in _dig(domain, 'MX')[0] if len(line.split()) == 2)
    if not mx:
        checks.append(dc.check('MX', 'red', 'no MX record', f'{own_host} or the server before it', f'{domain}. IN MX 10 {own_host}.'))
    else:
        checks.append(dc.check('MX', 'green' if own_host in mx else 'yellow', ', '.join(mx),
                               '' if own_host in mx else f'this server ({own_host}) is not an MX: fine behind another gateway'))
    checks.append(dc.spf_check(domain, txt(domain), txt))
    checks += _domain_dkim(domain, [key for key in keys if key['domain'] == domain and key['state'] == 'active' and key['public']])
    dmarc_saved = (_json_read(DMARC_RECORDS, {}).get(domain) or {}).get('current', {}).get('record', '')
    checks.append(dc.dmarc_check(domain, txt(f'_dmarc.{domain}'), f'_dmarc.{domain}. IN TXT "{dmarc_saved}"' if dmarc_saved else ''))
    checks.append(_domain_mta_sts(domain, dc))
    checks.append(dc.tlsrpt_check(domain, txt(f'_smtp._tls.{domain}'), report_address))
    _answers, signed, status = _dig(domain, 'SOA', dnssec=True)
    checks.append(dc.check('DNSSEC', 'green' if signed else 'yellow', 'signed and valid' if signed else f'not signed ({status})',
                           'DNSSEC at the registrar: it protects MX, TLSA and the records above'))
    for host in [host for host in mx if host == own_host]:
        tlsa = [line.split()[-1].lower() for line in _dig(f'_25._tcp.{host}', 'TLSA')[0] if line.split()[:3] == ['3', '1', '1']]
        wanted = hashlib.sha256(spki).hexdigest() if spki else ''
        if not tlsa:
            checks.append(dc.check(f'DANE {host}', 'yellow' if signed else 'grey', 'no TLSA record', 'TLSA 3 1 1 of the key of this server',
                                   tlsa_records(spki, host)[0] if spki else ''))
        else:
            checks.append(dc.check(f'DANE {host}', 'green' if wanted in tlsa else 'red', 'TLSA fits the certificate' if wanted in tlsa else
                                   'no TLSA record fits the key of this server: DANE senders cannot deliver', 'TLSA 3 1 1 of the key',
                                   tlsa_records(spki, host)[0] if spki else ''))
    checks.append(dc.bimi_check(domain, txt(f'default._bimi.{domain}')))
    if domain in _json_read(ROLES_FORWARD, {}).get('domains', []):
        checks.append(dc.check('Role addresses', 'green' if own_host in mx else 'red', 'taken by this server' if own_host in mx else
                               'eFa-next takes the role addresses, but this server is not an MX: they never arrive here', f'MX {own_host}'))
    if own_host in mx:
        names = {ip: [name.rstrip('.').lower() for name in _dig(ipaddress.ip_address(ip).reverse_pointer, 'PTR')[0]] for ip in own_ips}
        bad = sorted(ip for ip, found in names.items() if own_host not in found)
        checks.append(dc.check('PTR/HELO', 'red' if bad or not own_ips else 'green',
                               f"no PTR {own_host} for {', '.join(bad)}" if bad else 'no address for the host name' if not own_ips else
                               f"PTR and HELO {own_host}", f'PTR of each address = {own_host} (at the provider of the address)'))
    # What the outside sees: the records above from the public resolvers, against the own one.
    differs = []
    for name, rtype in ((domain, 'MX'), (domain, 'TXT'), (f'_dmarc.{domain}', 'TXT'), (f'_mta-sts.{domain}', 'TXT'), (f'_smtp._tls.{domain}', 'TXT')):
        inside = sorted(_dig(name, rtype)[0])
        for label, resolver in resolvers.items():
            outside, _ad, status = _dig(name, rtype, resolver)
            if status == 'timeout':
                continue
            if sorted(outside) != inside:
                differs.append(f'{rtype} {name} at {resolver}')
    checks.append(dc.check('Inside / outside', 'yellow' if differs else 'green', '; '.join(differs[:6]) or 'the public resolvers see the same',
                           'the same everywhere: an old copy waits out its TTL, else check the zone' if differs else ''))
    return checks


def domain_check_run(args=None):
    """6a: checks every own domain (or one) now and keeps the result; the hourly job calls it every 6 hours."""
    settings_now = domain_check_settings()
    only = (getattr(args, 'domain', '') or '').strip().lower() if args else ''
    domains = [domain for domain in _own_domains() if not only or domain == only]
    if identity_now and identity_now.get('domains') is not None:
        domains = [domain for domain in domains if domain in identity_now['domains']]
    if only and not domains:
        raise EfaError('Not one of your own domains.')
    dc = _lib('efa_domaincheck')
    rotation = _rotation_state()['resolvers']
    resolvers = {label: value for label, value in rotation.items() if value} or DOMAIN_CHECK_RESOLVERS
    own_host = _postconf('myhostname').lower()
    own_ips = [line for rtype in ('A', 'AAAA') for line in _dig(own_host, rtype)[0]]
    try:
        with open(_postconf('smtpd_tls_cert_file'), 'rb') as f:
            spki = _spki_of(f.read())
    except (OSError, EfaError, subprocess.CalledProcessError):
        spki = None
    keys = _dkim_keys()
    reports = _json_read(REPORTS_FILE_IN, {})
    address = reports.get('address', '') if reports.get('enabled') else ''
    state = _json_read(DOMAIN_CHECK_STATE, {'domains': {}})
    with concurrent.futures.ThreadPoolExecutor(max_workers=4) as pool:
        results = dict(zip(domains, pool.map(lambda domain: domain_check_one(domain, resolvers, own_host, own_ips, spki, keys, address), domains)))
    now = time.time()
    for domain, checks in results.items():
        previous = state['domains'].get(domain, {})
        state['domains'][domain] = {'checks': checks, 'light': dc.light(checks), 'checked': now, 'prompted': previous.get('prompted', 0)}
    for domain in [domain for domain in state['domains'] if domain not in _own_domains()]:
        state['domains'].pop(domain)
    if not only and (not identity_now or identity_now.get('domains') is None):
        state['last'] = now
    if settings_now['prompt'] == 'on':
        for domain, item in sorted(state['domains'].items()):
            missing = dc.prompt_needed(item['checks'])
            if missing and now - item.get('prompted', 0) > 7 * 86400:
                _admins_notify(f'eFa-next: {domain} lacks {", ".join(missing)}',
                               f'The domain check of {domain} found: ' + '; '.join(f"{check['check']}: {check['is']}" for check in item['checks']
                                                                                   if check['check'] in missing) +
                               '\n\nThe DNS records to publish: Domain settings, Domain check. This mail comes at most once a week per domain '
                               '(switch it off: domain-check-set --prompt off).')
                item['prompted'] = now
    _json_write(DOMAIN_CHECK_STATE, state, mode=0o644)
    return domain_check_status(None)


def _domain_check_job():
    if domain_check_settings()['mode'] == 'on' and time.time() - _json_read(DOMAIN_CHECK_STATE, {}).get('last', 0) > DOMAIN_CHECK_HOURS * 3600 - 300:
        domain_check_run()


def domain_check_status(_args):
    """6a: the light of each own domain, from the last check."""
    state = _json_read(DOMAIN_CHECK_STATE, {'domains': {}})
    rows = [{'domain': domain, 'light': item['light'], 'problems': [f"{check['check']}: {check['is']}" for check in item['checks'] if check['light'] in ('red', 'yellow')],
             'checked': time.strftime('%Y-%m-%d %H:%M', time.localtime(item['checked']))}
            for domain, item in sorted(state.get('domains', {}).items())
            if not identity_now or identity_now.get('domains') is None or domain in identity_now['domains']]
    return {**domain_check_settings(), 'domains': rows, 'last': time.strftime('%Y-%m-%d %H:%M', time.localtime(state['last'])) if state.get('last') else 'never'}


def domain_check_show(args):
    """6a: every check of one domain: what is there, what should be, and the DNS record to publish."""
    domain = (args.domain or '').strip().lower()
    if identity_now and identity_now.get('domains') is not None and domain not in identity_now['domains']:
        raise EfaError('Not allowed: name one of your own domains.')
    item = _json_read(DOMAIN_CHECK_STATE, {'domains': {}}).get('domains', {}).get(domain)
    if item is None:
        raise EfaError('Not checked yet: Domain check, check now.')
    return {'domain': domain, 'light': item['light'], 'checks': item['checks'],
            'records': [check['record'] for check in item['checks'] if check['record'] and check['light'] != 'green']}


def domain_check_set(args):
    """6a: the check every 6 hours, and the weekly mail while SPF, DMARC, MTA-STS or TLS-RPT are missing or wrong."""
    settings_now = domain_check_settings()
    settings_now['mode'] = 'on' if _on_off(args.mode) else 'off'
    if (getattr(args, 'prompt', '') or '').strip():
        settings_now['prompt'] = 'on' if _on_off(args.prompt) else 'off'
    _json_write(DOMAIN_CHECK_FILE, settings_now, mode=0o644)
    _audit(f"domain check {settings_now['mode']}, mail prompt {settings_now['prompt']} by {_dmarc_who()}")
    return domain_check_status(None)


def domain_check_notices():
    """The dashboard: domains that lack SPF, DMARC, MTA-STS or TLS-RPT (red), while the prompt is on."""
    if domain_check_settings()['mode'] != 'on' or domain_check_settings()['prompt'] != 'on':
        return []
    dc = _lib('efa_domaincheck')
    found = []
    for domain, item in sorted(_json_read(DOMAIN_CHECK_STATE, {}).get('domains', {}).items()):
        missing = dc.prompt_needed(item['checks'])
        if missing:
            found.append(_text('{domain} lacks {checks}: the DNS records are in Domain settings, Domain check.', domain=domain, checks=', '.join(missing)))
    return found[:5]

# 6b: role addresses of a domain (postmaster@ RFC 5321; abuse@, security@, hostmaster@, webmaster@, noc@ RFC 2142; the report
# addresses of DMARC and TLS-RPT; the contact for vulnerabilities after the CRA and NIS2) go to the targets set for them, with
# SRS. Per domain or subdomain on or off (off: to the backend as before), with defaults for all and per tenant for new domains.
# postmaster@ and abuse@ are never refused as spam, only the virus scan and the size limit count.
ROLES_FILE = ETC + '/eFa/roles.json'
ROLES_FORWARD = ETC + '/eFa/roles-forward.json'
ROLES_TRANSPORT = ETC + '/postfix/efa-roles-transport'
ROLES_SRS_TRANSPORT = ETC + '/postfix/efa-roles-srs'
SRS_KEY = ETC + '/eFa/srs.key'
ROLES_SERVICE = 'efa-roles'
ROLES_MASTER = 'efa-roles unix - n n - 4 pipe flags=DRq user=efa-web argv=/usr/bin/python3 /usr/local/sbin/efa-roles.py ${sender} ${recipient}'
ROLE_LOCALS = {'postmaster': 'postmaster', 'abuse': 'abuse', 'security': 'security', 'hostmaster': 'hostmaster', 'webmaster': 'webmaster',
               'noc': 'noc', 'dmarc': 'dmarc', 'tls-reports': 'tls-reports', 'cra': 'security-cra', 'nis2': 'nis2'}
ROLES_NO_SPAM = ('postmaster', 'abuse')


def roles_state():
    return {'all': {'enabled': False, 'targets': {}}, 'tenants': {}, 'domains': {}, **_json_read(ROLES_FILE, {})}


def role_effective(domain, state, tenant_of):
    """(on, {role: targets}, where from) of a domain: the domain, its parent domain, its tenant, then all."""
    chain = [state['domains'].get(domain), state['domains'].get(domain.split('.', 1)[1]) if '.' in domain else None,
             state['tenants'].get(str(tenant_of.get(domain))) if tenant_of.get(domain) is not None else None, state['all']]
    names = ['domain', 'parent domain', 'tenant', 'all']
    on, source, targets = False, 'all', {}
    for item, name in zip(chain, names):
        if item and item.get('enabled') is not None:
            on, source = item['enabled'], name
            break
    for role in ROLE_LOCALS:
        for item in chain:
            if item and role in item.get('targets', {}):
                if item['targets'][role]:
                    targets[role] = item['targets'][role]
                break
    return on, targets, source


def roles_forward(state, domains, tenant_of, skip):
    """{address: targets} of the role addresses that eFa-next takes, and the domains with them; skip: addresses used otherwise."""
    roles, used = {}, []
    for domain in domains:
        on, targets, _source = role_effective(domain, state, tenant_of)
        if not on:
            continue
        for role, items in targets.items():
            address = f'{ROLE_LOCALS[role]}@{domain}'
            # A target that is the address itself would loop: left out.
            items = [item.replace('{domain}', domain) for item in items if item.replace('{domain}', domain) != address]
            if address not in skip and items:
                roles[address] = items
        if any(address.endswith('@' + domain) for address in roles):
            used.append(domain)
    return {'roles': roles, 'domains': used}


def role_spam_rules():
    """postmaster@ and abuse@ of the domains with role addresses: no spam action, only the virus scan rejects (force action)."""
    forward = _json_read(ROLES_FORWARD, {'roles': {}})
    return [{'name': 'role_' + hashlib.sha256(address.encode()).hexdigest()[:12], 'kind': 'recipient', 'value': address, 'priority': '9',
             'spam_off': True, 'reject': '', 'add_header': '', 'greylist': '', 'quarantine': False, 'route': '', 'enabled': True}
            for address in sorted(forward['roles']) if address.split('@')[0] in (ROLE_LOCALS[role] for role in ROLES_NO_SPAM)]


def _tenant_of():
    return {domain: tenant for tenant, domains in _tenant_domains_or_none().items() for domain in domains}


def _roles_apply(state):
    domains = _own_domains()
    skip = {_json_read(REPORTS_FILE_IN, {}).get('address', '')} | set(_json_read(PHISH_FILE, {'addresses': []})['addresses'])
    forward = roles_forward(state, domains, _tenant_of(), skip)
    on = bool(forward['roles'])
    if on and not os.path.exists(SRS_KEY):
        _write(SRS_KEY, secrets.token_hex(32) + '\n')
    for path in (SRS_KEY,) if on else ():
        os.chmod(path, 0o640)
        shutil.chown(path, 'root', 'efa-web')
    _json_write(ROLES_FORWARD, forward, mode=0o640)
    if os.path.exists(ROLES_FORWARD):
        shutil.chown(ROLES_FORWARD, 'root', 'efa-web')
    if on:
        subprocess.run(['postconf', '-M', f'{ROLES_SERVICE}/unix={ROLES_MASTER}'], check=True, capture_output=True)
    _rule_map(ROLES_TRANSPORT, [f'{address} {ROLES_SERVICE}:' for address in sorted(forward['roles'])])
    # Bounces to an SRS address of a role domain come back to the pipe, which checks the hash and sends them to the sender.
    srs = '|'.join(re.escape(domain) for domain in forward['domains'])
    if srs:
        _write(ROLES_SRS_TRANSPORT, f'/^srs[01]=[^@]+@({srs})$/i {ROLES_SERVICE}:\n')
    elif os.path.exists(ROLES_SRS_TRANSPORT):
        os.remove(ROLES_SRS_TRANSPORT)
    value = rule_map_value(_postconf('transport_maps'), ROLES_TRANSPORT, on)
    value = map_list_value(value, f'regexp:{ROLES_SRS_TRANSPORT}', bool(srs))
    if value != _postconf('transport_maps'):
        _postconf_set('transport_maps', value)
    if _postconf('relay_recipient_maps').strip():
        # A list of valid recipients: the role and SRS addresses must be on it too.
        relay = rule_map_value(_postconf('relay_recipient_maps'), ROLES_TRANSPORT, on)
        relay = map_list_value(relay, f'regexp:{ROLES_SRS_TRANSPORT}', bool(srs))
        if relay != _postconf('relay_recipient_maps'):
            _postconf_set('relay_recipient_maps', relay)
    if not on:
        subprocess.run(['postconf', '-MX', f'{ROLES_SERVICE}/unix'], check=False, capture_output=True)
    _json_write(ROLES_FILE, state, mode=0o640)
    _safe(_rules_apply, None)
    subprocess.run(['postfix', 'reload'], check=False, capture_output=True)
    return forward


def role_status(_args):
    """6b: per own domain whether eFa-next takes the role addresses, from where, and where each one goes."""
    state, tenant_of = roles_state(), _tenant_of()
    rows = []
    for domain in _own_domains():
        if identity_now and identity_now.get('domains') is not None and domain not in identity_now['domains']:
            continue
        on, targets, source = role_effective(domain, state, tenant_of)
        rows.append({'domain': domain, 'on': on, 'from': source,
                     'roles': {f'{ROLE_LOCALS[role]}@{domain}': ', '.join(items) for role, items in sorted(targets.items())}})
    return {'domains': rows, 'roles': ROLE_LOCALS, 'default_new_domains': state['all']['enabled']}


def _role_scope(level, target):
    """The entry of the state a change goes to, after the rights of the login."""
    if level == 'all':
        if identity_now and identity_now.get('role') != 'super':
            raise EfaError('Only a super admin sets the role addresses for all.')
        return 'all', None
    if level == 'tenant':
        tenant = str(_tenant_id(target))
        if identity_now and identity_now.get('tenant_ids') is not None and int(tenant) not in identity_now['tenant_ids']:
            raise EfaError('Not allowed: name your own tenant.')
        return 'tenants', tenant
    if level == 'domain':
        domain = target.lower()
        if not DOMAIN_RE.match(domain) or not any(domain == item or domain.endswith('.' + item) for item in _own_domains()):
            raise EfaError('Domain: one of the own domains or a subdomain of it.')
        if identity_now and identity_now.get('domains') is not None and not any(domain == item or domain.endswith('.' + item)
                                                                                for item in identity_now['domains']):
            raise EfaError('Not allowed: name one of your own domains.')
        return 'domains', domain
    raise EfaError("Level: all, tenant or domain.")


def role_set(args):
    """6b: role addresses on or off, and the targets of one role, for all (default of new domains), a tenant, or a domain."""
    level, target = (args.level or '').strip(), (args.target or '').strip()
    mode, role = (args.mode or '').strip(), (args.role or '').strip()
    where, key = _role_scope(level, target)
    state = roles_state()
    entry = state['all'] if where == 'all' else state[where].setdefault(key, {})
    if mode:
        if mode not in ('on', 'off', 'inherit') or mode == 'inherit' and where == 'all':
            raise EfaError("Mode: on, off, or inherit (not for all).")
        if mode == 'inherit':
            entry.pop('enabled', None)
        else:
            entry['enabled'] = mode == 'on'
    if role:
        if role not in ROLE_LOCALS:
            raise EfaError('Role: ' + ', '.join(ROLE_LOCALS) + '.')
        text = (args.addresses or '').strip()
        if text == 'inherit':
            entry.setdefault('targets', {}).pop(role, None)
        else:
            items = sorted({item.lower() for item in re.split(r'[\s,;]+', text) if item})
            if not items or len(items) > 5 or not all(SENDER_RE.match(item.replace('{domain}', 'example.org')) for item in items):
                raise EfaError('One to five target addresses, such as security-team@example.org; {domain} stands for the domain.')
            if any(item.split('@')[0] == ROLE_LOCALS[role] and '{domain}' in item for item in items):
                raise EfaError('A target may not be the role address itself.')
            own = _own_domains()
            far = sorted({item.split('@')[1] for item in items if '{domain}' not in item and item.split('@')[1] not in own})
            relation = eu_relation(key if where == 'domains' else '')
            if far and relation is not False:
                eu_transfer_check(key or 'all', far, args.confirm, f'Mail to {ROLE_LOCALS[role]}@')
            entry.setdefault('targets', {})[role] = items
    if not mode and not role:
        raise EfaError('Give a mode, or a role with its targets.')
    if where != 'all' and not entry:
        state[where].pop(key, None)
    _roles_apply(state)
    _audit(f"role addresses {level} {target or ''}: mode {mode or 'unchanged'}, {role or ''} {args.addresses or ''} by {_dmarc_who()}".strip())
    return role_status(None)


def security_txt(args):
    """RFC 9116: a security.txt for a domain with the security@ role address, valid for a year, to put on its web server."""
    domain = (args.domain or '').strip().lower()
    if not DOMAIN_RE.match(domain) or identity_now and identity_now.get('domains') is not None and domain not in identity_now['domains']:
        raise EfaError('Domain: one of your own domains.')
    on, targets, _source = role_effective(domain, roles_state(), _tenant_of())
    contact = f"{ROLE_LOCALS['security']}@{domain}"
    expires = (datetime.datetime.now(datetime.timezone.utc) + datetime.timedelta(days=365)).strftime('%Y-%m-%dT%H:%M:%SZ')
    text = (f'Contact: mailto:{contact}\nExpires: {expires}\nPreferred-Languages: de, en\n'
            f'Canonical: https://{domain}/.well-known/security.txt\n')
    note = '' if on and 'security' in targets else f'eFa-next does not take {contact} yet: switch the role addresses on and give security@ a target.'
    return {'text': text, 'name': 'security.txt', 'note': note}


def role_notices():
    """After the update: the role addresses can now be taken per domain (nothing changed)."""
    version = ETC + '/eFa-Version'
    if os.path.exists(ROLES_FILE) or not os.path.exists(version) or time.time() - os.stat(version).st_mtime > 30 * 86400:
        return []
    return [_text('New: eFa-next can take postmaster@, abuse@, security@ and the other role addresses of a domain and send them on '
                  '(Domain settings, Role addresses). Nothing changed: they still go to the mail server of the domain.')]

# 10: encrypted ZIP archives. rspamd hands an encrypted archive with the subject and text of the mail to efa-unlock, which tries
# the passwords it finds there and gives each file to clamd. A virus inside rejects the mail; an archive opened and clean takes
# back the mark of encrypted archives; one that stays shut is marked as before. Nothing is kept. Off by default.
UNLOCK_FILE = ETC + '/eFa/unlock.json'
UNLOCK_LUA = RSPAMD_DIR + '/efa-unlock.lua'
UNLOCK_UNIT = 'efa-unlock'
UNLOCK_LOAD_LINE = ("do local ok, err = pcall(dofile, '" + UNLOCK_LUA + "'); if not ok then require('rspamd_logger').errx(rspamd_config, 'efa-unlock: %s', err) "
                    "end end -- efa-unlock\n")
UNLOCK_LUA_TEXT = r'''-- Written by efactl unlock-set. Do not edit.
local rspamd_http = require 'rspamd_http'
local rspamd_util = require 'rspamd_util'
local ucl = require 'ucl'
local parent = rspamd_config:register_symbol({name = 'EFA_ARCHIVE', score = 0.0, group = 'efa_unlock', description = 'Encrypted ZIP archives opened for the virus scan',
  callback = function(task)
    local text, sent = tostring(task:get_subject() or ''), 0
    for _, part in ipairs(task:get_text_parts() or {}) do
      local content = part:get_content()
      if content and #text < 20000 then text = text .. '\n' .. tostring(content):sub(1, 20000 - #text) end
    end
    for _, part in ipairs(task:get_parts() or {}) do
      local archive = part:get_archive()
      local size = part:get_length() or 0
      if sent < 3 and archive and archive:get_type() == 'zip' and archive:is_encrypted() and size <= 10485760 then
        sent = sent + 1
        local body = ucl.to_format({archive = tostring(rspamd_util.encode_base64(part:get_content())), text = text}, 'json-compact')
        rspamd_http.request({task = task, url = 'http://127.0.0.1:8910/', method = 'POST', body = body, timeout = 15,
          headers = {['Content-Type'] = 'application/json'},
          callback = function(err, code, reply)
            if err or code ~= 200 or not reply then return end
            local parser = ucl.parser()
            if not parser:parse_string(tostring(reply)) then return end
            local result = parser:get_object()
            if result.state == 'unlocked' and result.virus and result.virus ~= '' then
              task:insert_result('EFA_ARCHIVE_VIRUS', 1.0, result.virus)
              task:set_pre_result({action = 'reject', message = 'Virus found in an encrypted archive: ' .. result.virus, module = 'efa_unlock', priority = 4})
            elseif result.state == 'unlocked' then
              local mark = task:get_symbol('MIME_ENCRYPTED_ARCHIVE')
              local weight = mark and mark[1] and math.abs(mark[1].score or 0) or 0
              task:insert_result('EFA_ARCHIVE_UNLOCKED', weight, tostring(result.files or 0) .. ' files clean')
            end
          end})
      end
    end
  end})
rspamd_config:register_dependency('EFA_ARCHIVE', 'MIME_TYPES_CALLBACK')
rspamd_config:register_symbol({name = 'EFA_ARCHIVE_VIRUS', score = 20.0, group = 'efa_unlock', type = 'virtual', parent = parent,
                               description = 'A virus in an encrypted archive, found with the password of the mail'})
rspamd_config:register_symbol({name = 'EFA_ARCHIVE_UNLOCKED', score = -1.0, group = 'efa_unlock', type = 'virtual', parent = parent,
                               description = 'The encrypted archive was opened and is clean: the mark of encrypted archives is taken back'})
'''


def unlock_status(_args):
    platform_now = _platform()
    return {'enabled': bool(_json_read(UNLOCK_FILE, {}).get('enabled')), 'service': _safe(lambda: platform_now.service_is_active(UNLOCK_UNIT), False)}


def unlock_set(args):
    """10: encrypted ZIP archives opened with a password found in the mail, and their files scanned for viruses."""
    on = _on_off(args.mode)
    platform_now = _platform()
    with open(RSPAMD_LOCAL_LUA) as f:
        before = f.read()
    text = re.sub(r'^.*-- efa-unlock\n', '', before, flags=re.M)
    try:
        if on:
            platform_now.service_enable(UNLOCK_UNIT, start=True)
            _write(UNLOCK_LUA, UNLOCK_LUA_TEXT)
            text = text.rstrip('\n') + '\n' + UNLOCK_LOAD_LINE
        _write(RSPAMD_LOCAL_LUA, text)
        if not _rspamd_config_ok():
            raise EfaError('rspamd rejected the archive check, nothing changed.')
        if not on and not _json_read(OLE_FILE, {}).get('enabled'):
            # 5v (b): the macro check uses the same service.
            platform_now.service_disable(UNLOCK_UNIT, stop=True)
    except EfaError:
        _write(RSPAMD_LOCAL_LUA, before)
        raise
    except Exception as err:  # the StepError of the platform layer
        _write(RSPAMD_LOCAL_LUA, before)
        raise EfaError(str(err))
    _json_write(UNLOCK_FILE, {'enabled': on}, mode=0o644)
    _reload_rspamd()
    _audit(f'encrypted archives opened for the scan {"on" if on else "off"} by {_dmarc_who()}')
    return unlock_status(None)

# 11: the outbreak filter. A new wave (the same attachment or text to many recipients in a short time) is deferred with a
# temporary error until it is some minutes old; the sending servers try again, and by then the virus signatures and feeds may
# know it. Known senders (a pair from outbound mail, BEC) and the exceptions pass. Counters in Redis, a day long. Off by default.
OUTBREAK_FILE = ETC + '/eFa/outbreak.json'
OUTBREAK_CONF = RSPAMD_DIR + '/efa-outbreak.json'
OUTBREAK_LUA = RSPAMD_DIR + '/efa-outbreak.lua'
OUTBREAK_DEFAULTS = {'enabled': False, 'recipients': 30, 'window': 10, 'hold': 30, 'exceptions': []}
OUTBREAK_HOLDS = (15, 30, 60)
OUTBREAK_LOAD_LINE = ("do local ok, err = pcall(dofile, '" + OUTBREAK_LUA + "'); if not ok then require('rspamd_logger').errx(rspamd_config, 'efa-outbreak: %s', err) "
                      "end end -- efa-outbreak\n")
OUTBREAK_LUA_TEXT = r'''-- Written by efactl outbreak-set. Do not edit.
local rspamd_redis = require 'rspamd_redis'
local ucl = require 'ucl'
local parser = ucl.parser()
if not parser:parse_file('/etc/rspamd/efa-outbreak.json') then return end
local conf = parser:get_object()
local REDIS = '127.0.0.1:6379'
local function lower(text) return string.lower(tostring(text or '')) end
local parent = rspamd_config:register_symbol({name = 'EFA_OUTBREAK', score = 0.0, group = 'efa_outbreak', priority = 5,
  description = 'A new wave of the same mail to many recipients, deferred until it is some minutes old', callback = function(task)
    if task:get_user() then return end
    local from = task:get_from('smtp')
    local sender = from and from[1] and lower(from[1].addr) or ''
    local sender_domain = sender:match('@(.+)$') or ''
    for _, item in ipairs(conf.exceptions or {}) do if sender == item or sender_domain == item then return end end
    local digests = {}
    for _, part in ipairs(task:get_parts() or {}) do
      local size = part:get_length() or 0
      if #digests < 3 and size >= 1024 and not part:is_text() and not part:is_multipart() then digests[#digests + 1] = part:get_digest() end
    end
    if #digests == 0 then
      local text = (task:get_text_parts() or {})[1]
      if text and (text:get_length() or 0) >= 200 then digests[1] = text:get_digest() end
    end
    if #digests == 0 then return end
    local rcpts = task:get_recipients('smtp') or {}
    local count, now = #rcpts, os.time()
    local function check()
      for _, digest in ipairs(digests) do
        local key = 'efa:ob:' .. digest
        rspamd_redis.make_request({task = task, host = REDIS, cmd = 'HSETNX', args = {key, 'first', tostring(now)}, callback = function()
          rspamd_redis.make_request({task = task, host = REDIS, cmd = 'HINCRBY', args = {key, 'n', tostring(count)}, callback = function(err, total)
            if err then return end
            rspamd_redis.make_request({task = task, host = REDIS, cmd = 'EXPIRE', args = {key, '86400'}, callback = function() end})
            rspamd_redis.make_request({task = task, host = REDIS, cmd = 'HGET', args = {key, 'first'}, callback = function(err2, first)
              if err2 then return end
              local age = now - (tonumber(first) or now)
              if tonumber(total) >= conf.recipients and age <= conf.window * 60 then
                rspamd_redis.make_request({task = task, host = REDIS, cmd = 'HSET', args = {key, 'wave', '1'}, callback = function() end})
              end
              rspamd_redis.make_request({task = task, host = REDIS, cmd = 'HGET', args = {key, 'wave'}, callback = function(err3, wave)
                if not err3 and tonumber(wave) == 1 and age < conf.hold * 60 then
                  task:insert_result('EFA_OUTBREAK_HELD', 1.0, digest:sub(1, 16) .. ':' .. tostring(total))
                  task:set_pre_result({action = 'soft reject', module = 'efa_outbreak', priority = 3,
                    message = 'Delayed: a new wave of this mail is checked again in a few minutes, please try later'})
                end
              end})
            end})
          end})
        end})
      end
    end
    -- A sender this recipient wrote to (a pair of the BEC check) is known: its mail is never held.
    if sender ~= '' and rcpts[1] then
      rspamd_redis.make_request({task = task, host = REDIS, cmd = 'EXISTS', args = {'efa:bec:rel:' .. lower(rcpts[1].addr) .. '|' .. sender},
        callback = function(err, known) if err or tonumber(known) == 0 then check() end end})
    else
      check()
    end
  end})
rspamd_config:register_symbol({name = 'EFA_OUTBREAK_HELD', score = 0.0, group = 'efa_outbreak', type = 'virtual', parent = parent,
                               description = 'Deferred as part of a new wave'})
'''


def outbreak_state():
    return {**OUTBREAK_DEFAULTS, **_json_read(OUTBREAK_FILE, {})}


def _outbreak_apply(state):
    with open(RSPAMD_LOCAL_LUA) as f:
        before = f.read()
    text = re.sub(r'^.*-- efa-outbreak\n', '', before, flags=re.M)
    if state['enabled']:
        _write(OUTBREAK_CONF, json.dumps({key: state[key] for key in ('recipients', 'window', 'hold', 'exceptions')}, indent=1))
        _write(OUTBREAK_LUA, OUTBREAK_LUA_TEXT)
        text = text.rstrip('\n') + '\n' + OUTBREAK_LOAD_LINE
    _write(RSPAMD_LOCAL_LUA, text)
    if not _rspamd_config_ok():
        _write(RSPAMD_LOCAL_LUA, before)
        raise EfaError('rspamd rejected the outbreak filter, nothing changed.')
    _json_write(OUTBREAK_FILE, state, mode=0o644)
    _reload_rspamd()


def outbreak_status(_args):
    """11: whether new waves are deferred, from how many recipients in how many minutes, and for how long."""
    return outbreak_state()


def outbreak_set(args):
    """11: new waves of the same mail deferred for some minutes, so fresh signatures see them; known senders pass."""
    state = outbreak_state()
    state['enabled'] = _on_off(args.mode)
    for key, low, high in (('recipients', 5, 1000), ('window', 1, 60)):
        value = (getattr(args, key, '') or '').strip()
        if value:
            if not value.isdigit() or not low <= int(value) <= high:
                raise EfaError(f'{key}: a number from {low} to {high}.')
            state[key] = int(value)
    hold = (getattr(args, 'hold', '') or '').strip()
    if hold:
        if not hold.isdigit() or int(hold) not in OUTBREAK_HOLDS:
            raise EfaError('Hold: 15, 30 or 60 minutes.')
        state['hold'] = int(hold)
    text = getattr(args, 'exceptions', None)
    if text is not None and text.strip():
        items = [] if text.strip() == '-' else sorted({item.lower() for item in re.split(r'[\s,;]+', text) if item})
        if not all(SENDER_RE.match(item) or DOMAIN_RE.match(item) for item in items):
            raise EfaError('Exceptions: addresses or domains, such as newsletter@partner.example or partner.example; - for none.')
        state['exceptions'] = items
    _outbreak_apply(state)
    _audit(f"outbreak filter {'on' if state['enabled'] else 'off'} ({state['recipients']} recipients in {state['window']} min, hold {state['hold']} min) "
           f'by {_dmarc_who()}')
    return outbreak_status(None)

# N4: an own fuzzy store. rspamd keeps fuzzy hashes of the spam that admins approved from the reports (phishing reports, spam
# reports of users) in Redis, on this host only, and new variants of the same waves count as EFA_FUZZY_LOCAL. Nothing goes out.
FUZZY_FILE = ETC + '/eFa/fuzzy.json'
FUZZY_WORKER = RSPAMD_DIR + '/local.d/worker-fuzzy.inc'
FUZZY_CHECK = RSPAMD_DIR + '/local.d/fuzzy_check.conf'
FUZZY_FLAG = 11
COMMUNITY_FILE = ETC + '/eFa/fuzzy-community.json'
FUZZY_MARK = '# Written by efactl fuzzy-set. Do not edit.\n'
FUZZY_WORKER_TEXT = FUZZY_MARK + '''bind_socket = "127.0.0.1:11335";
backend = "redis";
servers = "127.0.0.1:6379";
expire = 90d;
allow_update = ["127.0.0.1", "::1"];
'''
FUZZY_CHECK_TEXT = FUZZY_MARK + '''rule "efa_local" {
  servers = "127.0.0.1:11335";
  symbol = "EFA_FUZZY_LOCAL_UNKNOWN";
  mime_types = ["*"];
  max_score = 20.0;
  read_only = false;
  skip_unknown = true;
  fuzzy_map = {
    EFA_FUZZY_LOCAL {
      max_score = %(score)s;
      flag = %(flag)d;
    }
  }
}
'''


def fuzzy_state():
    return {'enabled': False, 'score': 8.0, **_json_read(FUZZY_FILE, {})}


def fuzzy_status(_args):
    """N4: the own fuzzy store and how many hashes it holds."""
    state = fuzzy_state()
    count = None
    if state['enabled']:
        done = _safe(lambda: subprocess.run(['rspamc', 'fuzzy_stat'], capture_output=True, text=True, timeout=10), None)
        match = re.search(r'Stored hashes:\s*(\d+)', done.stdout) if done else None
        count = int(match.group(1)) if match else None
    return {**state, 'hashes': count}


def fuzzy_set(args):
    """N4: an own fuzzy store of the spam admins approved; its variants count with this score."""
    state = fuzzy_state()
    state['enabled'] = _on_off(args.mode)
    score = (getattr(args, 'score', '') or '').strip()
    if score:
        try:
            state['score'] = float(score)
        except ValueError:
            raise EfaError('Score: a number from 1 to 20.')
        if not 1 <= state['score'] <= 20:
            raise EfaError('Score: a number from 1 to 20.')
    before = {path: open(path).read() if os.path.exists(path) else None for path in (FUZZY_WORKER, FUZZY_CHECK)}
    for path, text in before.items():
        if text is not None and not text.startswith(FUZZY_MARK):
            raise EfaError(f'{path} was not written by eFa-next, nothing changed.')
    if state['enabled']:
        _write(FUZZY_WORKER, FUZZY_WORKER_TEXT)
    elif os.path.exists(FUZZY_WORKER):
        os.remove(FUZZY_WORKER)
    # P7: the rule of the community store stays in the same file.
    if state['enabled'] or community_state()['enabled']:
        _write(FUZZY_CHECK, fuzzy_check_text(state, community_state()))
    elif os.path.exists(FUZZY_CHECK):
        os.remove(FUZZY_CHECK)
    if not _rspamd_config_ok():
        for path, text in before.items():
            if text is None:
                if os.path.exists(path):
                    os.remove(path)
            else:
                _write(path, text)
        raise EfaError('rspamd rejected the fuzzy store, nothing changed.')
    _json_write(FUZZY_FILE, state, mode=0o644)
    # A new worker needs a restart of rspamd, a reload does not start it.
    _platform().service_restart('rspamd', check=False)
    _audit(f"own fuzzy store {'on' if state['enabled'] else 'off'} (score {state['score']:g}) by {_dmarc_who()}")
    return fuzzy_status(None)


def fuzzy_learn(raw):
    """A mail approved as spam goes into the own fuzzy store, and to the community store when this host shares (P7); '' when
    both are off, else the results in a few words."""
    results = []
    community = community_state()
    for flag, wanted, name in ((FUZZY_FLAG, fuzzy_state()['enabled'], 'fuzzy'), (COMMUNITY_FLAG, community['enabled'] and community['share'], 'community')):
        if wanted:
            done = subprocess.run(['rspamc', '-f', str(flag), '-w', '10', 'fuzzy_add'], input=raw, capture_output=True, timeout=60)
            results.append(f'{name} learned' if done.returncode == 0 else f'{name}: ' + rspamc_learn_result((done.stdout + done.stderr).decode('utf-8', 'replace')))
    return '; '.join(results)

# M6: spam trap addresses per domain, which never get real mail. A Postfix pipe takes their mail and drops it after Bayes and the
# own fuzzy store learned it; the sending servers of the last 7 days form a block map of rspamd (EFA_TRAP_IP). Off while no trap.
TRAP_FILE = ETC + '/eFa/traps.json'
TRAP_TRANSPORT = ETC + '/postfix/efa-trap-transport'
TRAP_SERVICE = 'efa-trap'
TRAP_MASTER = 'efa-trap unix - n n - 4 pipe flags=Rq user=efa-web argv=/usr/bin/python3 /usr/local/sbin/efa-trap.py ${sender} ${client_address} ${recipient}'
TRAP_MAP = RSPAMD_DIR + '/maps.d/efa-trap-ip.map'
TRAP_LUA = RSPAMD_DIR + '/efa-trap.lua'
TRAP_DAYS, TRAP_KEEP_DAYS = 7, 30
TRAP_LOAD_LINE = "do local ok, err = pcall(dofile, '" + TRAP_LUA + "'); if not ok then require('rspamd_logger').errx(rspamd_config, 'efa-trap: %s', err) end end -- efa-trap\n"
TRAP_LUA_TEXT = r'''-- Written by efactl trap-set. Do not edit.
local trap_map = rspamd_config:add_map({type = 'radix', url = '/etc/rspamd/maps.d/efa-trap-ip.map', description = 'eFa-next: servers that wrote to spam traps'})
rspamd_config:register_symbol({name = 'EFA_TRAP_IP', score = 6.0, group = 'efa_trap', description = 'The server sent to a spam trap in the last days',
  callback = function(task)
    local ip = task:get_from_ip()
    if trap_map and ip and ip:is_valid() and trap_map:get_key(ip) then return true end
  end})
'''


def trap_state():
    return {'addresses': [], **_json_read(TRAP_FILE, {})}


def _trap_apply(state):
    on = bool(state['addresses'])
    if on:
        subprocess.run(['postconf', '-M', f'{TRAP_SERVICE}/unix={TRAP_MASTER}'], check=True, capture_output=True)
    _rule_map(TRAP_TRANSPORT, [f'{item} {TRAP_SERVICE}:' for item in state['addresses']])
    for parameter in ('transport_maps', 'relay_recipient_maps'):
        current = _postconf(parameter)
        if parameter == 'relay_recipient_maps' and not current.strip():
            continue
        wanted = rule_map_value(current, TRAP_TRANSPORT, on)
        if wanted != current:
            _postconf_set(parameter, wanted)
    if not on:
        subprocess.run(['postconf', '-MX', f'{TRAP_SERVICE}/unix'], check=False, capture_output=True)
    with open(RSPAMD_LOCAL_LUA) as f:
        before = f.read()
    text = re.sub(r'^.*-- efa-trap\n', '', before, flags=re.M)
    if on:
        if not os.path.exists(TRAP_MAP):
            _write(TRAP_MAP, '')
        _write(TRAP_LUA, TRAP_LUA_TEXT)
        text = text.rstrip('\n') + '\n' + TRAP_LOAD_LINE
    _write(RSPAMD_LOCAL_LUA, text)
    if not _rspamd_config_ok():
        _write(RSPAMD_LOCAL_LUA, before)
        raise EfaError('rspamd rejected the trap map, nothing changed.')
    _json_write(TRAP_FILE, state, mode=0o644)
    _reload_rspamd()
    subprocess.run(['postfix', 'reload'], check=False, capture_output=True)


def trap_status(_args):
    """M6: the trap addresses, and how many servers wrote to them in the last days."""
    state = trap_state()
    rows = _safe(lambda: _admin_query('SELECT domain, COUNT(*) AS hits, COUNT(DISTINCT ip) AS servers FROM trap_hits '
                                      'WHERE ts >= NOW() - INTERVAL %s DAY GROUP BY domain ORDER BY domain', (TRAP_DAYS,)), [])
    mine = identity_now.get('domains') if identity_now else None
    return {'addresses': [item for item in state['addresses'] if mine is None or item.rpartition('@')[2] in mine],
            'last_days': [row for row in rows if mine is None or row['domain'] in mine]}


def trap_set(args):
    """M6: a spam trap address of an own domain, which never gets real mail: its mail teaches the filter and is dropped."""
    action, address = (args.action or '').strip(), (args.address or '').strip().lower()
    if action not in ('add', 'remove') or not SENDER_RE.match(address):
        raise EfaError("Action 'add' or 'remove', and an address such as old-catalog@example.org.")
    domain = address.rpartition('@')[2]
    if domain not in _own_domains() or identity_now and identity_now.get('domains') is not None and domain not in identity_now['domains']:
        raise EfaError('Not allowed: name an address of one of your own domains.')
    if action == 'add' and address in set(_json_read(ROLES_FORWARD, {'roles': {}})['roles']) | set(_json_read(PHISH_FILE, {'addresses': []})['addresses']):
        raise EfaError('This address is a role or report address already.')
    state = trap_state()
    items = set(state['addresses'])
    state['addresses'] = sorted(items | {address} if action == 'add' else items - {address})
    _trap_apply(state)
    _audit(f'spam trap {address} {action} by {_dmarc_who()}')
    return trap_status(None)


def trap_map_text(rows):
    return ''.join(f"{row['ip']}\n" for row in sorted(rows, key=lambda row: row['ip']))


def _trap_job():
    """Hourly: the map of the servers of the last 7 days; hits older than 30 days go."""
    if not trap_state()['addresses']:
        return
    _admin_query('DELETE FROM trap_hits WHERE ts < NOW() - INTERVAL %s DAY', (TRAP_KEEP_DAYS,))
    text = trap_map_text(_admin_query('SELECT DISTINCT ip FROM trap_hits WHERE ts >= NOW() - INTERVAL %s DAY', (TRAP_DAYS,)))
    if (open(TRAP_MAP).read() if os.path.exists(TRAP_MAP) else None) != text:
        _write(TRAP_MAP + '.tmp', text)
        os.replace(TRAP_MAP + '.tmp', TRAP_MAP)

# 7: more virus scanners through the external_services module of rspamd: ICAP servers and the engines rspamd speaks to (the
# operator brings the scanner and its licence). Each scanner rejects or marks what it finds. A scanner outside the own networks
# with EU relation only after the typed confirmation. Off while none is set.
SCANNERS_FILE = ETC + '/eFa/scanners.json'
SCANNERS_CONF = RSPAMD_DIR + '/local.d/external_services.conf'
SCANNERS_MARK = '# Written by efactl scanner-set. Do not edit.\n'
SCANNER_TYPES = ('icap', 'kaspersky_se', 'avast', 'fprot', 'sophos', 'savapi', 'virustotal')
SCANNER_ACTIONS = {'reject': None, 'mark': 6.0}


def scanners_state():
    return {'scanners': {}, **_json_read(SCANNERS_FILE, {})}


def scanners_conf(state):
    """The external_services blocks of rspamd, one per scanner."""
    blocks = []
    for name, item in sorted(state['scanners'].items()):
        lines = [f'{name} {{', f'  type = "{item["type"]}";', f'  servers = "{item["server"]}";', f'  symbol = "EFA_SCAN_{name.upper()}";',
                 '  scan_mime_parts = true;', '  max_size = 20000000;', '  timeout = 15.0;', '  retransmits = 1;', '  log_clean = false;']
        if item['type'] == 'icap' and item.get('service'):
            lines.append(f'  scheme = "{item["service"]}";')
        if item['action'] == 'reject':
            lines.append('  action = "reject";')
        lines.append('}')
        blocks.append('\n'.join(lines))
    return SCANNERS_MARK + '\n'.join(blocks) + ('\n' if blocks else '')


def scanners_group(state):
    """The scores of the marking scanners, in the group external_services of rspamd."""
    lines = [f'  "EFA_SCAN_{name.upper()}" {{ weight = {SCANNER_ACTIONS["mark"]}; }}\n' for name, item in sorted(state['scanners'].items())
             if item['action'] == 'mark']
    return SCANNERS_MARK + 'symbols {\n' + ''.join(lines) + '}\n'


def scanner_status(_args):
    """7: the extra scanners and what they do with a hit."""
    return {'scanners': [{'name': name, **item} for name, item in sorted(scanners_state()['scanners'].items())], 'types': list(SCANNER_TYPES)}


def scanner_set(args):
    """7: an extra scanner (ICAP or an engine rspamd knows) that rejects or marks what it finds; remove takes it out."""
    name, action = (args.name or '').strip().lower(), (args.action or '').strip()
    if not re.fullmatch(r'[a-z][a-z0-9_]{1,30}', name):
        raise EfaError('Name: letters, digits and _, such as icap_office.')
    state = scanners_state()
    if action == 'remove':
        state['scanners'].pop(name, None)
    else:
        kind, server, service = (args.type or '').strip(), (args.server or '').strip(), (args.service or '').strip()
        if action not in SCANNER_ACTIONS or kind not in SCANNER_TYPES:
            raise EfaError('Action reject, mark or remove, and a type: ' + ', '.join(SCANNER_TYPES) + '.')
        host, _, port = server.rpartition(':')
        if not port.isdigit() or not 0 < int(port) < 65536 or not re.fullmatch(r'[A-Za-z0-9.\-]+|\[[0-9a-fA-F:]+\]', host or '-'):
            raise EfaError('Server: host:port, such as 192.0.2.10:1344.')
        if service and not re.fullmatch(r'[A-Za-z0-9_.\-/]{1,64}', service):
            raise EfaError('ICAP service: letters, digits and _ . - /, such as srv_clamav.')
        try:
            local = ipaddress.ip_address(host.strip('[]')).is_private
        except ValueError:
            local = host.endswith(tuple('.' + item for item in _own_domains())) or host in _own_domains()
        if not local and eu_relation('') is not False:
            eu_transfer_check('all', [host], getattr(args, 'confirm', ''), f'Mail parts to the scanner {name}')
        state['scanners'][name] = {'type': kind, 'server': server, 'service': service, 'action': action}
    before = open(SCANNERS_CONF).read() if os.path.exists(SCANNERS_CONF) else None
    if before is not None and not before.startswith(SCANNERS_MARK):
        raise EfaError(f'{SCANNERS_CONF} was not written by eFa-next, nothing changed.')
    group = RSPAMD_DIR + '/local.d/external_services_group.conf'
    if state['scanners']:
        _write(SCANNERS_CONF, scanners_conf(state))
        _write(group, scanners_group(state))
    else:
        for path in (SCANNERS_CONF, group):
            if os.path.exists(path):
                os.remove(path)
    if not _rspamd_config_ok():
        if before is None:
            if os.path.exists(SCANNERS_CONF):
                os.remove(SCANNERS_CONF)
        else:
            _write(SCANNERS_CONF, before)
        raise EfaError('rspamd rejected the scanner, nothing changed.')
    _json_write(SCANNERS_FILE, state, mode=0o644)
    _reload_rspamd()
    _audit(f'extra scanner {name} {action} by {_dmarc_who()}')
    return scanner_status(None)

# 14: a self-hosted CAPEv2 sandbox for suspicious attachments (programs, scripts, Office files, PDF, archives, disk images).
# efa-sandbox keeps the verdicts by hash; a new file goes to the sandbox and its mail is deferred until the verdict is there
# (at most 30 minutes, then it is only marked). No sandbox on this host. HTTPS only; off by default.
SANDBOX_FILE = ETC + '/eFa/sandbox.json'
SANDBOX_SERVICE_CONF = ETC + '/eFa/sandbox-service.json'
SANDBOX_LUA = RSPAMD_DIR + '/efa-sandbox.lua'
SANDBOX_UNIT = 'efa-sandbox'
SANDBOX_LOAD_LINE = ("do local ok, err = pcall(dofile, '" + SANDBOX_LUA + "'); if not ok then require('rspamd_logger').errx(rspamd_config, 'efa-sandbox: %s', err) "
                     "end end -- efa-sandbox\n")
SANDBOX_LUA_TEXT = r'''-- Written by efactl sandbox-set. Do not edit.
local rspamd_http = require 'rspamd_http'
local rspamd_util = require 'rspamd_util'
local hash = require 'rspamd_cryptobox_hash'
local ucl = require 'ucl'
local risky = {exe = true, dll = true, scr = true, com = true, js = true, jse = true, vbs = true, vbe = true, wsf = true, hta = true, ps1 = true,
  bat = true, cmd = true, lnk = true, jar = true, msi = true, iso = true, img = true, vhd = true, one = true, doc = true, docm = true, xls = true,
  xlsm = true, xlsb = true, ppt = true, pptm = true, rtf = true, pdf = true, zip = true, rar = true, ['7z'] = true, gz = true, tar = true}
local parent = rspamd_config:register_symbol({name = 'EFA_SANDBOX', score = 0.0, group = 'efa_sandbox', description = 'Suspicious attachments checked in the own sandbox',
  callback = function(task)
    if task:get_user() then return end
    local sent = 0
    for _, part in ipairs(task:get_parts() or {}) do
      local name = string.lower(tostring(part:get_filename() or ''))
      local ending = name:match('%.([%w]+)$')
      local size = part:get_length() or 0
      if sent < 3 and ending and risky[ending] and size > 0 and size <= 20971520 then
        sent = sent + 1
        local content = part:get_content()
        local body = ucl.to_format({sha256 = hash.create_specific('sha256', content):hex(), name = name,
                                    file = tostring(rspamd_util.encode_base64(content))}, 'json-compact')
        rspamd_http.request({task = task, url = 'http://127.0.0.1:8911/', method = 'POST', body = body, timeout = 40,
          headers = {['Content-Type'] = 'application/json'},
          callback = function(err, code, reply)
            if err or code ~= 200 or not reply then task:insert_result('EFA_SANDBOX_ERROR', 1.0, name) return end
            local parser = ucl.parser()
            if not parser:parse_string(tostring(reply)) then return end
            local result = parser:get_object()
            if result.state == 'malicious' then
              task:insert_result('EFA_SANDBOX_MALICIOUS', 1.0, name .. ':' .. tostring(result.score))
              task:set_pre_result({action = 'reject', message = 'The sandbox found ' .. name .. ' malicious', module = 'efa_sandbox', priority = 4})
            elseif result.state == 'pending' then
              task:insert_result('EFA_SANDBOX_PENDING', 1.0, name)
              task:set_pre_result({action = 'soft reject', message = 'Delayed: an attachment is being checked, please try again later', module = 'efa_sandbox', priority = 3})
            elseif result.state == 'timeout' then
              task:insert_result('EFA_SANDBOX_TIMEOUT', 1.0, name)
            elseif result.state == 'error' then
              task:insert_result('EFA_SANDBOX_ERROR', 1.0, name)
            end
          end})
      end
    end
  end})
rspamd_config:register_symbol({name = 'EFA_SANDBOX_MALICIOUS', score = 20.0, group = 'efa_sandbox', type = 'virtual', parent = parent, description = 'The sandbox found an attachment malicious'})
rspamd_config:register_symbol({name = 'EFA_SANDBOX_PENDING', score = 0.0, group = 'efa_sandbox', type = 'virtual', parent = parent, description = 'An attachment is in the sandbox'})
rspamd_config:register_symbol({name = 'EFA_SANDBOX_TIMEOUT', score = 3.0, group = 'efa_sandbox', type = 'virtual', parent = parent, description = 'The sandbox gave no verdict in 30 minutes'})
rspamd_config:register_symbol({name = 'EFA_SANDBOX_ERROR', score = 0.0, group = 'efa_sandbox', type = 'virtual', parent = parent, description = 'The sandbox could not be asked'})
'''


def sandbox_status(_args):
    """14: the sandbox: on or off, its address (never the token) and the threshold of the malscore."""
    state = {'enabled': False, 'url': '', 'threshold': 5.0, **_json_read(SANDBOX_FILE, {})}
    return {**state, 'service': _safe(lambda: _platform().service_is_active(SANDBOX_UNIT), False)}


def sandbox_set(args):
    """14: suspicious attachments to the own CAPEv2 sandbox (HTTPS, API token); a malscore from the threshold on rejects."""
    on = _on_off(args.mode)
    state = {'enabled': False, 'url': '', 'threshold': 5.0, **_json_read(SANDBOX_FILE, {})}
    service = _json_read(SANDBOX_SERVICE_CONF, {})
    url = (args.url or '').strip() or state['url']
    # The token is a secret: from the prompt or stdin, never an argument; empty keeps the one stored.
    token = (_secrets(1, 'API token of the sandbox, empty keeps it')[0].strip() if on else '') or service.get('token', '')
    if on:
        host = urllib.parse.urlsplit(url).hostname or ''
        if not url.startswith('https://') or not host:
            raise EfaError('The address of the sandbox: https://cape.example.org (HTTPS only; add an own CA to the system trust).')
        if not re.fullmatch(r'[A-Za-z0-9._-]{16,200}', token):
            raise EfaError('The API token of the sandbox (Token authentication of CAPEv2).')
        try:
            local = ipaddress.ip_address(host).is_private
        except ValueError:
            local = host in _own_domains() or host.endswith(tuple('.' + item for item in _own_domains()))
        if not local and eu_relation('') is not False:
            eu_transfer_check('all', [host], getattr(args, 'confirm', ''), 'Attachments to the sandbox')
    threshold = (args.threshold or '').strip()
    if threshold:
        try:
            state['threshold'] = float(threshold)
        except ValueError:
            raise EfaError('Threshold: the malscore of CAPEv2 from which a file counts as malicious, 1 to 10.')
        if not 1 <= state['threshold'] <= 10:
            raise EfaError('Threshold: the malscore of CAPEv2 from which a file counts as malicious, 1 to 10.')
    state.update(enabled=on, url=url)
    platform_now = _platform()
    with open(RSPAMD_LOCAL_LUA) as f:
        before = f.read()
    text = re.sub(r'^.*-- efa-sandbox\n', '', before, flags=re.M)
    try:
        if on:
            _json_write(SANDBOX_SERVICE_CONF, {'url': url, 'token': token, 'threshold': state['threshold']}, mode=0o600)
            platform_now.service_enable(SANDBOX_UNIT, start=True)
            # The token comes in as a credential at the start: a restart takes a new one.
            platform_now.service_restart(SANDBOX_UNIT, check=False)
            _write(SANDBOX_LUA, SANDBOX_LUA_TEXT)
            text = text.rstrip('\n') + '\n' + SANDBOX_LOAD_LINE
        _write(RSPAMD_LOCAL_LUA, text)
        if not _rspamd_config_ok():
            raise EfaError('rspamd rejected the sandbox check, nothing changed.')
        if not on:
            platform_now.service_disable(SANDBOX_UNIT, stop=True)
    except EfaError:
        _write(RSPAMD_LOCAL_LUA, before)
        raise
    except Exception as err:  # the StepError of the platform layer
        _write(RSPAMD_LOCAL_LUA, before)
        raise EfaError(str(err))
    _json_write(SANDBOX_FILE, state, mode=0o644)
    _reload_rspamd()
    _audit(f"sandbox {'on' if on else 'off'} ({url}, threshold {state['threshold']:g}) by {_dmarc_who()}")
    return sandbox_status(None)

# M4: lookalike domains in new certificates (Certificate Transparency). Once a day the CT search of crt.sh is asked for the names
# of the own and partner domains; a new certificate for a domain that imitates one of them (as the BEC check judges it) shows on
# the dashboard, can be mailed, and goes into a block map of rspamd (EFA_LOOKALIKE_CT). The query tells crt.sh the own names:
# off by default, and with EU relation only after the typed confirmation (crt.sh is run by Sectigo in the UK).
LOOKALIKE_FILE = ETC + '/eFa/lookalike.json'
LOOKALIKE_STATE = '/var/lib/eFa/lookalike.json'
LOOKALIKE_MAP = RSPAMD_DIR + '/maps.d/efa-lookalike-ct.map'
LOOKALIKE_LUA = RSPAMD_DIR + '/efa-lookalike.lua'
LOOKALIKE_SOURCE = 'https://crt.sh/'
LOOKALIKE_DAYS = 7
LOOKALIKE_LOAD_LINE = ("do local ok, err = pcall(dofile, '" + LOOKALIKE_LUA + "'); if not ok then require('rspamd_logger').errx(rspamd_config, 'efa-lookalike: %s', err) "
                       "end end -- efa-lookalike\n")
LOOKALIKE_LUA_TEXT = r'''-- Written by efactl lookalike-set. Do not edit.
local rspamd_util = require 'rspamd_util'
local ct_map = rspamd_config:add_map({type = 'set', url = '/etc/rspamd/maps.d/efa-lookalike-ct.map', description = 'eFa-next: lookalike domains from CT'})
rspamd_config:register_symbol({name = 'EFA_LOOKALIKE_CT', score = 8.0, group = 'efa_bec', description = 'The sender domain imitates an own or partner domain (new certificate)',
  callback = function(task)
    if not ct_map or task:get_user() then return end
    for _, field in ipairs({'mime', 'smtp'}) do
      local from = task:get_from(field)
      local domain = from and from[1] and string.lower(from[1].domain or '') or ''
      while domain ~= '' do
        if ct_map:get_key(domain) then return true, 1.0, domain end
        domain = domain:match('^[^.]+%.(.+)$') or ''
      end
    end
  end})
'''


def lookalike_settings():
    return {'enabled': False, 'mail': True, 'allowed': [], **_json_read(LOOKALIKE_FILE, {})}


def lookalike_hits(rows, protected, seen, now, allowed):
    """New lookalikes from crt.sh rows: [{'domain', 'imitates', 'kind', 'issuer', 'seen'}]; seen and allowed ones are left out."""
    look = _lib('efa_lookalike')
    found = {}
    for row in rows if isinstance(rows, list) else []:
        if not isinstance(row, dict):
            continue
        stamp = str(row.get('entry_timestamp') or row.get('not_before') or '')[:19]
        try:
            age = now - datetime.datetime.fromisoformat(stamp).replace(tzinfo=datetime.timezone.utc).timestamp()
        except ValueError:
            continue
        if age > LOOKALIKE_DAYS * 86400:
            continue
        for name in str(row.get('name_value', '')).lower().split('\n')[:100]:
            name = name.strip().lstrip('*.').rstrip('.')
            if not name or name in seen or name in found or name in allowed or not DOMAIN_RE.match(name):
                continue
            match = look.lookalike(name, protected)
            if match:
                found[name] = {'domain': name, 'imitates': match[0], 'kind': match[1], 'issuer': str(row.get('issuer_name', ''))[:120], 'seen': stamp}
    return list(found.values())


def _crtsh(label):
    """The certificates of the last weeks whose names hold label; [] when crt.sh does not answer."""
    url = LOOKALIKE_SOURCE + '?' + urllib.parse.urlencode({'q': f'%{label}%', 'output': 'json', 'exclude': 'expired'})
    try:
        with urllib.request.urlopen(urllib.request.Request(url, headers={'User-Agent': 'eFa-next'}), timeout=90) as reply:
            return json.loads(reply.read(20 * 1024 * 1024))
    except (OSError, ValueError):
        return []


def lookalike_run(_args=None):
    """M4: asks crt.sh for each own and partner name, keeps the new lookalikes, the map, and tells the admins."""
    settings_now = lookalike_settings()
    if not settings_now['enabled']:
        return {'enabled': False}
    protected = sorted(set(_own_domains()) | set(bec_state()['partners']))
    state = _json_read(LOOKALIKE_STATE, {'hits': []})
    seen = {hit['domain'] for hit in state['hits']}
    now, new = time.time(), []
    labels = sorted({domain.split('.')[0] for domain in protected if len(domain.split('.')[0]) >= 4})
    for label in labels[:50]:
        new += lookalike_hits(_crtsh(label), protected, seen | {hit['domain'] for hit in new}, now, set(settings_now['allowed']))
    state['hits'] = (state['hits'] + new)[-500:]
    state['last'] = now
    _json_write(LOOKALIKE_STATE, state, mode=0o644)
    text = ''.join(f"{hit['domain']}\n" for hit in sorted(state['hits'], key=lambda hit: hit['domain']) if hit['domain'] not in settings_now['allowed'])
    if (open(LOOKALIKE_MAP).read() if os.path.exists(LOOKALIKE_MAP) else None) != text:
        _write(LOOKALIKE_MAP + '.tmp', text)
        os.replace(LOOKALIKE_MAP + '.tmp', LOOKALIKE_MAP)
    if new:
        _audit(f'lookalike domains in new certificates: {", ".join(hit["domain"] for hit in new[:10])}')
        _event('lookalike_certificate', 'warning', domains=', '.join(hit['domain'] for hit in new[:10]))
        if settings_now['mail']:
            _admins_notify('eFa-next: lookalike domains / Doppelgänger-Domains', '\n'.join(
                f"- {hit['domain']} imitates {hit['imitates']} ({hit['kind']}), certificate of {hit['issuer']} from {hit['seen']}" for hit in new[:30]) +
                '\n\nMail from them now scores EFA_LOOKALIKE_CT. Allow a domain that is yours: efactl lookalike-allow --domain ...')
    return {'new': len(new), 'known': len(state['hits'])}


def _lookalike_job(state):
    if lookalike_settings()['enabled'] and state.get('lookalike_day') != _today().isoformat():
        state['lookalike_day'] = _today().isoformat()
        lookalike_run()


def lookalike_status(_args):
    """M4: the lookalike domains found in new certificates."""
    state = _json_read(LOOKALIKE_STATE, {'hits': []})
    settings_now = lookalike_settings()
    return {**settings_now, 'hits': list(reversed(state['hits'][-100:])),
            'last': time.strftime('%Y-%m-%d %H:%M', time.localtime(state['last'])) if state.get('last') else 'never'}


def lookalike_set(args):
    """M4: watch new certificates for lookalikes of the own and partner domains (asks crt.sh once a day); off by default."""
    settings_now = lookalike_settings()
    on = _on_off(args.mode)
    if on and not settings_now['enabled'] and eu_relation('') is not False:
        eu_transfer_check('all', ['crt.sh'], getattr(args, 'confirm', ''), 'The names of the own and partner domains to the CT search')
    settings_now['enabled'] = on
    if (getattr(args, 'mail', '') or '').strip():
        settings_now['mail'] = _on_off(args.mail)
    with open(RSPAMD_LOCAL_LUA) as f:
        before = f.read()
    text = re.sub(r'^.*-- efa-lookalike\n', '', before, flags=re.M)
    if on:
        if not os.path.exists(LOOKALIKE_MAP):
            _write(LOOKALIKE_MAP, '')
        _write(LOOKALIKE_LUA, LOOKALIKE_LUA_TEXT)
        text = text.rstrip('\n') + '\n' + LOOKALIKE_LOAD_LINE
    _write(RSPAMD_LOCAL_LUA, text)
    if not _rspamd_config_ok():
        _write(RSPAMD_LOCAL_LUA, before)
        raise EfaError('rspamd rejected the lookalike map, nothing changed.')
    _json_write(LOOKALIKE_FILE, settings_now, mode=0o644)
    _reload_rspamd()
    _audit(f"lookalike watch {'on' if on else 'off'} by {_dmarc_who()}")
    return lookalike_status(None)


def lookalike_allow(args):
    """M4: a domain found that is in fact yours or harmless: out of the map, and never reported again."""
    domain = (args.domain or '').strip().lower()
    if not DOMAIN_RE.match(domain):
        raise EfaError('Invalid domain.')
    settings_now = lookalike_settings()
    settings_now['allowed'] = sorted(set(settings_now['allowed']) | {domain})
    _json_write(LOOKALIKE_FILE, settings_now, mode=0o644)
    state = _json_read(LOOKALIKE_STATE, {'hits': []})
    text = ''.join(f"{hit['domain']}\n" for hit in sorted(state['hits'], key=lambda hit: hit['domain']) if hit['domain'] not in settings_now['allowed'])
    if os.path.exists(LOOKALIKE_MAP):
        _write(LOOKALIKE_MAP, text)
    _audit(f'lookalike {domain} allowed by {_dmarc_who()}')
    return lookalike_status(None)


def lookalike_notices():
    state = _json_read(LOOKALIKE_STATE, {'hits': []})
    if not lookalike_settings()['enabled']:
        return []
    recent = [hit for hit in state['hits'] if hit.get('seen', '') >= (datetime.date.today() - datetime.timedelta(days=7)).isoformat()]
    return [_text('Lookalike domain {domain} imitates {own} (new certificate): mail from it scores EFA_LOOKALIKE_CT.', domain=hit['domain'],
                  own=hit['imitates']) for hit in recent[-5:]]

# P6 and P1: outgoing mail that waits for its sender in the hold queue. P6: every mail of a logged-in user waits 1 to 5 minutes and
# can be withdrawn in the portal. P1: a mail with attachment to a recipient the sender never wrote to waits for a confirmation
# by link; not confirmed in time, it goes back to the sender. efa-outbound holds the mail and writes a note; this job, every
# minute, does the rest. Per domain or tenant, off by default.
HOLD_NOTES = '/var/lib/efa-outbound/held'
RECALL_MINUTES = (1, 2, 3, 4, 5)
MISDIRECT_HOURS = (1, 4, 24)


def _hold_targets(level, target):
    """The own domains of a domain or a tenant, after the rights of the login."""
    if level == 'tenant':
        tid = _tenant_id(target)
        if identity_now and identity_now.get('tenant_ids') is not None and tid not in identity_now['tenant_ids']:
            raise EfaError('Not allowed: name your own tenant.')
        return sorted(_tenant_domains_or_none().get(tid, []))
    domain = target.lower()
    if not DOMAIN_RE.match(domain) or domain not in _local_domains():
        raise EfaError('Domain: one of the own domains.')
    if identity_now and identity_now.get('domains') is not None and domain not in identity_now['domains']:
        raise EfaError('Not allowed: name one of your own domains.')
    return [domain]


def outbound_hold_status(_args):
    """P6 and P1: per domain the recall window and the confirmation of attachments to new recipients, and what waits now."""
    state = _json_read(OUTBOUND_FILE, {})
    mine = identity_now.get('domains') if identity_now else None
    notes = [note for note in _hold_notes() if mine is None or note['sender'].rpartition('@')[2] in mine]
    return {'recall_minutes': {d: m for d, m in sorted(state.get('recall', {}).items()) if mine is None or d in mine},
            'confirm_hours': {d: h for d, h in sorted(state.get('misdirect', {}).items()) if mine is None or d in mine},
            'waiting': [{key: note[key] for key in ('qid', 'kind', 'sender', 'subject')} | {'until': time.strftime('%Y-%m-%d %H:%M', time.localtime(note['until']))}
                        for note in notes]}


def outbound_hold_set(args):
    """P6: a recall window of 1 to 5 minutes; P1: attachments to new recipients wait for the sender (1, 4 or 24 hours); 0 is off."""
    kind, level, target, value = (args.kind or '').strip(), (args.level or '').strip(), (args.target or '').strip(), (args.value or '').strip()
    if kind not in ('recall', 'confirm') or level not in ('domain', 'tenant'):
        raise EfaError("Kind 'recall' or 'confirm', level 'domain' or 'tenant'.")
    allowed = RECALL_MINUTES if kind == 'recall' else MISDIRECT_HOURS
    if not value.isdigit() or int(value) not in (0,) + allowed:
        raise EfaError(f"Value: 0 (off) or {', '.join(map(str, allowed))}.")
    state = _json_read(OUTBOUND_FILE, {})
    key = 'recall' if kind == 'recall' else 'misdirect'
    entries = state.setdefault(key, {})
    for domain in _hold_targets(level, target):
        if int(value):
            entries[domain] = int(value)
        else:
            entries.pop(domain, None)
    _outbound_write(state)
    _audit(f'{kind} hold for {level} {target} set to {value} by {_dmarc_who()}')
    return outbound_hold_status(None)


def _hold_notes():
    found = []
    for path in sorted(glob.glob(HOLD_NOTES + '/*.json')):
        note = _json_read(path, None)
        if isinstance(note, dict) and re.fullmatch(r'[0-9A-Za-z]{6,20}', str(note.get('qid', ''))):
            found.append({**note, 'path': path})
    return found


def _postsuper(flag, qid):
    return subprocess.run(['postsuper', flag, qid], capture_output=True, text=True).returncode == 0


def _held_ids():
    done = subprocess.run(['postqueue', '-j'], capture_output=True, text=True)
    return {item.get('queue_id') for line in done.stdout.splitlines() if line.strip() for item in [_safe(lambda line=line: json.loads(line), {})]
            if item.get('queue_name') == 'hold'}


def hold_decision(note, now, held):
    """What the job does with a note: 'gone' (not in the hold queue any more), 'release', 'return', 'ask' (send the link) or 'wait'."""
    if note['qid'] not in held:
        return 'gone'
    if note.get('confirmed'):
        return 'release'
    if note['kind'] == 'recall':
        return 'release' if now >= note['until'] else 'wait'
    if now >= note['until']:
        return 'return'
    return 'wait' if note.get('asked') else 'ask'


def outbound_hold_run(_args=None):
    """Every minute: recall windows that are over go out; confirmations are asked for, confirmed mail goes out, the rest goes back."""
    notes = _hold_notes()
    if not notes:
        return {'notes': 0}
    held, now, counts = _held_ids(), time.time(), {}
    public = uq_state().get('public_url', '').rstrip('/')
    for note in notes:
        decision = hold_decision(note, now, held)
        counts[decision] = counts.get(decision, 0) + 1
        path = note.pop('path')
        if decision == 'gone':
            os.remove(path)
        elif decision == 'release':
            if _postsuper('-H', note['qid']):
                os.remove(path)
        elif decision == 'ask':
            token = uq_link_make('send', note['sender'], ref=note['qid'])
            _send_text(note['sender'], 'Bitte bestätigen / please confirm',
                       f"Ihre Nachricht \"{note['subject']}\" mit Anhang an {', '.join(note['rcpts'])} wartet: an diese Empfänger haben Sie noch "
                       f"nie geschrieben. Senden: {public}/q/{token}\nOhne Bestätigung geht sie bis "
                       f"{time.strftime('%Y-%m-%d %H:%M', time.localtime(note['until']))} an Sie zurück.\n\n"
                       f"Your message \"{note['subject']}\" with attachment to {', '.join(note['rcpts'])} waits: you never wrote to these "
                       f"recipients before. Send it: {public}/q/{token}\nWithout a confirmation it comes back to you at that time.\n")
            note['asked'] = now
            _json_write(path, note, mode=0o600)
        elif decision == 'return':
            _hold_return(note)
            os.remove(path)
    return {'notes': len(notes), **counts}


def _send_text(to, subject, text):
    message = email.message.EmailMessage()
    message['From'], message['To'], message['Subject'] = f"eFa-next <postmaster@{_postconf('myhostname')}>", to, subject
    message['Message-ID'] = email.utils.make_msgid(domain=_postconf('myhostname'))
    message.set_content(text)
    subprocess.run(['sendmail', '-f', '', '-t'], input=message.as_bytes(), capture_output=True, check=False)


def _hold_return(note):
    """P1: not confirmed in time: the mail goes back to its sender as an attachment, out of the hold queue; the pairs it made go."""
    done = subprocess.run(['postcat', '-hbq', note['qid']], capture_output=True, timeout=30)
    message = email.message.EmailMessage()
    message['From'], message['To'] = f"eFa-next <postmaster@{_postconf('myhostname')}>", note['sender']
    message['Subject'] = 'Nicht gesendet / not sent: ' + note['subject'][:150]
    message.set_content(f"Nicht gesendet, weil nicht bestätigt: an {', '.join(note['rcpts'])}. Die Nachricht liegt bei.\n\n"
                        f"Not sent, as it was not confirmed: to {', '.join(note['rcpts'])}. The message is attached.\n")
    if done.returncode == 0 and len(done.stdout) < 30 * 1024 * 1024:
        message.add_attachment(done.stdout, maintype='message', subtype='rfc822', filename='original.eml')
    subprocess.run(['sendmail', '-f', '', '-t'], input=message.as_bytes(), capture_output=True, check=False)
    _postsuper('-d', note['qid'])
    for rcpt in note['rcpts']:
        subprocess.run(['redis-cli', 'DEL', f"efa:bec:rel:{note['sender']}|{rcpt}"], capture_output=True, check=False)
    _audit(f"P1: mail {note['qid']} of {note['sender']} not confirmed, returned")


def recall_list(_args):
    """P6 in the portal: my mails that wait in the recall window."""
    me = (identity_now or {}).get('username', '')
    return {'mails': [{'qid': note['qid'], 'to': ', '.join(note['rcpts']), 'subject': note['subject'],
                       'until': time.strftime('%H:%M:%S', time.localtime(note['until']))}
                      for note in _hold_notes() if note['kind'] == 'recall' and (not identity_now or note['login'] == me or note['sender'] == me)]}


def recall_withdraw(args):
    """P6: withdraw a mail of mine while it waits; it is deleted and never sent."""
    qid, me = (args.qid or '').strip(), (identity_now or {}).get('username', '')
    note = next((note for note in _hold_notes() if note['qid'] == qid and note['kind'] == 'recall'), None)
    if note is None or identity_now and note['login'] != me and note['sender'] != me:
        raise EfaError('No such mail of yours waits, or it is gone already.')
    if not _postsuper('-d', qid):
        raise EfaError('The mail is not in the hold queue any more: it was sent already.')
    os.remove(note['path'])
    _audit(f'P6: mail {qid} of {note["sender"]} withdrawn by {_dmarc_who()}')
    return recall_list(None)

# P7: a community fuzzy store, run by the operators themselves (for example one for several eFa-next installations in the EU).
# rspamd asks it with the fuzzy hashes of each mail, encrypted with the key of the store; with sharing on, the spam admins approve
# goes there too, as hashes only (no content, no addresses). Opt-in, after the EU rule for external services.
COMMUNITY_FLAG = 12
COMMUNITY_RULE = '''rule "efa_community" {
  servers = "%(server)s";
  encryption_key = "%(key)s";
  symbol = "EFA_FUZZY_COMMUNITY_UNKNOWN";
  mime_types = ["*"];
  max_score = 20.0;
  read_only = %(read_only)s;
  skip_unknown = true;
  fuzzy_map = {
    EFA_FUZZY_COMMUNITY {
      max_score = %(score)s;
      flag = %(flag)d;
    }
  }
}
'''


def community_state():
    return {'enabled': False, 'server': '', 'key': '', 'share': False, 'score': 5.0, **_json_read(COMMUNITY_FILE, {})}


def fuzzy_check_text(fuzzy, community):
    """local.d/fuzzy_check.conf: the own store (N4) and the community store (P7), each when it is on."""
    text = FUZZY_MARK
    if fuzzy['enabled']:
        text += FUZZY_CHECK_TEXT[len(FUZZY_MARK):] % {'score': f"{fuzzy['score']:g}", 'flag': FUZZY_FLAG}
    if community['enabled']:
        text += COMMUNITY_RULE % {'server': community['server'], 'key': community['key'], 'read_only': 'false' if community['share'] else 'true',
                                  'score': f"{community['score']:g}", 'flag': COMMUNITY_FLAG}
    return text


def community_status(_args):
    """P7: the community fuzzy store: its address, whether this host shares, and the score of a hit."""
    return community_state()


def community_set(args):
    """P7: ask a community fuzzy store of the operators, and share the hashes of approved spam with it if wanted."""
    state = community_state()
    on = _on_off(args.mode)
    server, key = (args.server or '').strip() or state['server'], (args.key or '').strip() or state['key']
    if on:
        host, _, port = server.rpartition(':')
        if not port.isdigit() or not DOMAIN_RE.match(host.lower()) and not _safe(lambda: ipaddress.ip_address(host), None):
            raise EfaError('Server: host:port of the community store, such as fuzzy.example.eu:11335.')
        if not re.fullmatch(r'[a-z0-9]{40,60}', key):
            raise EfaError('Key: the public key of the store (rspamadm keypair, base32, about 52 letters).')
        try:
            local = ipaddress.ip_address(host).is_private
        except ValueError:
            local = host in _own_domains() or host.endswith(tuple('.' + item for item in _own_domains()))
        if not local and eu_relation('') is not False and (not state['enabled'] or state['server'] != server):
            eu_transfer_check('all', [host], getattr(args, 'confirm', ''), 'Fuzzy hashes of mail to the community store')
    if (getattr(args, 'share', '') or '').strip():
        state['share'] = _on_off(args.share)
    state.update(enabled=on, server=server, key=key)
    before = open(FUZZY_CHECK).read() if os.path.exists(FUZZY_CHECK) else None
    if before is not None and not before.startswith(FUZZY_MARK):
        raise EfaError(f'{FUZZY_CHECK} was not written by eFa-next, nothing changed.')
    if fuzzy_state()['enabled'] or on:
        _write(FUZZY_CHECK, fuzzy_check_text(fuzzy_state(), state))
    elif before is not None:
        os.remove(FUZZY_CHECK)
    if not _rspamd_config_ok():
        if before is None:
            if os.path.exists(FUZZY_CHECK):
                os.remove(FUZZY_CHECK)
        else:
            _write(FUZZY_CHECK, before)
        raise EfaError('rspamd rejected the community store, nothing changed.')
    _json_write(COMMUNITY_FILE, state, mode=0o644)
    _reload_rspamd()
    _audit(f"community fuzzy store {'on' if on else 'off'} ({server}, sharing {'on' if state['share'] else 'off'}) by {_dmarc_who()}")
    return community_status(None)

# 5v (j) and N6: the check after delivery. While it is on, efa-maillog keeps hashes of the links, hosts and attachments of each
# delivered mail for 72 hours (never the links themselves). When the threat feeds bring new entries, those hashes are compared:
# a hit tells the admins and, if wanted, the recipients; the link check blocks such links from then on anyway (the feed knows
# them). N6 can also take the mail back out of the mailbox, over IMAP with the own credentials of the operator (no cloud API).
RETRO_FILE = ETC + '/eFa/retro.json'
RETRO_FLAG = RSPAMD_DIR + '/efa-retro.on'
RETRO_STATE = '/var/lib/eFa/retro.json'
RETRO_HOURS = 72
RETRO_IMAP_SECRET = ETC + '/eFa/retro-imap.json'


def retro_settings():
    return {'enabled': False, 'tell_recipients': False, 'imap': {'enabled': False, 'host': '', 'port': 993, 'login': '{user}*{master}', 'master': '',
                                                                  'folder': 'Junk', 'action': 'move'}, **_json_read(RETRO_FILE, {})}


def retro_feed_hashes(maps):
    """The feed entries as the hashes efa-maillog keeps: {kind: {hash: entry}}."""
    found = {'url': {}, 'domain': {}, 'sha256': {}}
    for kind, path in maps.items():
        if kind not in found or not os.path.exists(path):
            continue
        with open(path, encoding='utf-8', errors='replace') as f:
            for line in f:
                entry = line.strip()
                if entry:
                    found[kind][entry.lower() if kind == 'sha256' else hashlib.sha256((entry.lower() if kind == 'domain' else entry).encode()).hexdigest()] = entry
    return found


def retro_matches(rows, feed):
    """The delivered mails one of whose hashes a feed names now: {maillog_id: [entries]}."""
    hits = {}
    for row in rows:
        entry = feed.get(row['kind'], {}).get(row['h'])
        if entry:
            hits.setdefault(row['maillog_id'], []).append(entry)
    return hits


def retro_run(_args=None):
    """After a feed update: the hashes of the mails of the last 72 hours against the new entries; each mail told once."""
    if not retro_settings()['enabled']:
        return {'enabled': False}
    settings_now = retro_settings()
    _admin_query('DELETE FROM delivered_iocs WHERE ts < NOW() - INTERVAL %s HOUR', (RETRO_HOURS,))
    feed = retro_feed_hashes(FEED_MAPS)
    rows = _admin_query('SELECT maillog_id, kind, h FROM delivered_iocs')
    hits = retro_matches(rows, feed)
    state = _json_read(RETRO_STATE, {'told': []})
    told = set(state['told'])
    new = {mid: entries for mid, entries in hits.items() if mid not in told}
    for mid, entries in sorted(new.items()):
        mail = (_admin_query('SELECT CAST(ts AS CHAR) AS ts, message_id, sender, rcpt, subject FROM maillog WHERE id = %s', (mid,)) or [None])[0]
        if not mail:
            continue
        what = ', '.join(sorted(set(entries))[:5])
        _audit(f"check after delivery: mail {mail['message_id']} to {mail['rcpt']} holds {what}")
        _event('retro_hit', 'warning', message_id=str(mail['message_id'])[:200], rcpt=str(mail['rcpt'])[:320])
        pulled = _safe(lambda mail=mail: retro_pull(mail, settings_now['imap']), 'not taken back: error') if settings_now['imap']['enabled'] else ''
        _admins_notify('eFa-next: delivered mail is dangerous now / zugestellte Mail ist jetzt gefährlich',
                       f"A threat feed now names a link or attachment of a delivered mail:\n\n  {mail['ts']} from {mail['sender']} to {mail['rcpt']}\n"
                       f"  Subject: {mail['subject']}\n  Named: {what}\n  {pulled}\n\nThe link check blocks these links from now on.")
        if settings_now['tell_recipients']:
            for rcpt in str(mail['rcpt']).split(','):
                _send_text(rcpt.strip(), 'Warnung zu einer Mail / warning about a mail',
                           f"Die Mail \"{mail['subject']}\" von {mail['sender']} vom {mail['ts']} enthält einen Link oder Anhang, der inzwischen als "
                           f"gefährlich bekannt ist. Bitte nicht öffnen und löschen.\n\nThe mail \"{mail['subject']}\" from {mail['sender']} of "
                           f"{mail['ts']} holds a link or attachment now known as dangerous. Please do not open it, and delete it.\n")
        told.add(mid)
    state['told'] = sorted(told)[-5000:]
    _json_write(RETRO_STATE, state)
    return {'checked': len(rows), 'hits': len(hits), 'new': len(new)}


def retro_pull(mail, imap):
    """N6: the mail out of the mailbox of each recipient over IMAP with TLS: moved to the folder, or deleted. The words for the mail."""
    import imaplib
    secret = _json_read(RETRO_IMAP_SECRET, {})
    done = []
    for rcpt in str(mail['rcpt']).split(','):
        rcpt = rcpt.strip()
        if not rcpt:
            continue
        login = imap['login'].replace('{user}', rcpt).replace('{master}', imap['master'])
        context = ssl.create_default_context()
        with imaplib.IMAP4_SSL(imap['host'], int(imap['port']), ssl_context=context, timeout=30) as conn:
            conn.login(login, secret.get('password', ''))
            conn.select('INBOX')
            mid = str(mail['message_id'] or '').strip('<>').replace('"', '')
            status, data = conn.search(None, 'HEADER', 'Message-ID', f'<{mid}>')
            numbers = data[0].split() if status == 'OK' and data and data[0] else []
            for number in numbers:
                if imap['action'] == 'move':
                    conn.copy(number, imap['folder'])
                conn.store(number, '+FLAGS', '\\Deleted')
            conn.expunge()
        done.append(f"{rcpt}: {len(numbers)} {'moved to ' + imap['folder'] if imap['action'] == 'move' else 'deleted'}")
        _audit(f"N6: mail {mail['message_id']} of {rcpt} {imap['action']} over IMAP ({len(numbers)} found)")
    return 'taken back: ' + '; '.join(done)


def retro_status(_args):
    """5v (j) and N6: the check after delivery, and the pull-back over IMAP (never the password)."""
    settings_now = retro_settings()
    count = _safe(lambda: _admin_query('SELECT COUNT(DISTINCT maillog_id) AS n FROM delivered_iocs')[0]['n'], None)
    return {**settings_now, 'mails_indexed': count, 'hours': RETRO_HOURS, 'told': len(_json_read(RETRO_STATE, {'told': []})['told'])}


def retro_set(args):
    """5v (j): keep hashes of delivered mail for 72 hours and check them after each feed update; tell the admins (and recipients)."""
    state = retro_settings()
    state['enabled'] = _on_off(args.mode)
    if (getattr(args, 'tell_recipients', '') or '').strip():
        state['tell_recipients'] = _on_off(args.tell_recipients)
    if state['enabled']:
        _write(RETRO_FLAG, 'on\n')
    elif os.path.exists(RETRO_FLAG):
        os.remove(RETRO_FLAG)
    _json_write(RETRO_FILE, state, mode=0o644)
    # The exporter of rspamd reads the flag when it loads: links and attachment hashes go to efa-maillog only while it is on.
    _reload_rspamd()
    if not state['enabled']:
        _safe(lambda: _admin_query('DELETE FROM delivered_iocs'), None)
    _audit(f"check after delivery {'on' if state['enabled'] else 'off'} by {_dmarc_who()}")
    return retro_status(None)


def retro_imap_set(args):
    """N6: take dangerous mail back out of the mailboxes over IMAP (TLS), with a master login of the operator's mail server."""
    state = retro_settings()
    imap = state['imap']
    on = _on_off(args.mode)
    if on:
        host, port = (args.host or '').strip() or imap['host'], (args.port or '').strip() or str(imap['port'])
        login, master = (args.login or '').strip() or imap['login'], (args.master or '').strip() or imap['master']
        action, folder = (args.action or '').strip() or imap['action'], (args.folder or '').strip() or imap['folder']
        if not DOMAIN_RE.match(host.lower()) and not _safe(lambda: ipaddress.ip_address(host), None):
            raise EfaError('Host of the IMAP server, such as imap.example.org.')
        if not port.isdigit() or not 0 < int(port) < 65536:
            raise EfaError('Port: 993 for IMAP over TLS.')
        if '{user}' not in login or len(login) > 200:
            raise EfaError('Login: with {user} for the address, such as {user}*{master} (Dovecot master user).')
        if action not in ('move', 'delete') or not re.fullmatch(r'[\w .\-/]{1,60}', folder):
            raise EfaError("Action 'move' (into the folder) or 'delete'; folder letters, digits and . - /.")
        password = _secrets(1, 'Password of the master login, empty keeps it')[0]
        if password:
            _json_write(RETRO_IMAP_SECRET, {'password': password}, mode=0o600)
        elif not _json_read(RETRO_IMAP_SECRET, {}).get('password'):
            raise EfaError('The password of the master login.')
        imap.update(enabled=True, host=host, port=int(port), login=login, master=master, action=action, folder=folder)
    else:
        imap['enabled'] = False
    _json_write(RETRO_FILE, state, mode=0o644)
    _audit(f"N6 pull-back over IMAP {'on' if on else 'off'} ({imap['host']}, {imap['action']}) by {_dmarc_who()}")
    return retro_status(None)

# 5n: reading received mail when the mail servers behind this one are down. Two sources: mail that waits in the queue of Postfix
# because its server does not answer, and (per domain or tenant, off by default) a copy of each delivered mail for 1 to 30 days,
# sealed with the key of the tenant. Users see the mail to their own addresses; an admin needs the right mail.emergency.read and
# gives a reason. Text only, never HTML; attachments only as files. Every access is audited. No replies: this is no webmail.
EMERGENCY_FILE = WEB_DIR + '/emergency.json'
EMERGENCY_BCC = ETC + '/postfix/efa-emergency-bcc'
EMERGENCY_TRANSPORT = ETC + '/postfix/efa-emergency-transport'
EMERGENCY_SERVICE = 'efa-emergency'
EMERGENCY_MASTER = 'efa-emergency unix - n n - 4 pipe flags=Rq user=efa-web argv=/usr/bin/python3 /usr/local/sbin/efa-emergency.py ${sender} ${recipient}'
EMERGENCY_DAYS = (1, 3, 7, 14, 30)


def emergency_bcc_lines(domains):
    """The copy of each mail to a domain with the copy, to an address that names the recipient (regexp of Postfix)."""
    if not domains:
        return []
    names = '|'.join(re.escape(domain) for domain in sorted(domains))
    return [f'/^(.+)@({names})$/ efa-em+${{1}}=${{2}}@efa-emergency.invalid']


def emergency_status(_args):
    """5n: the days of the emergency copy per domain, and how much is kept."""
    state = _json_read(EMERGENCY_FILE, {'domains': {}})
    mine = identity_now.get('domains') if identity_now else None
    size = _safe(lambda: _admin_query('SELECT COUNT(*) AS n, COALESCE(SUM(size), 0) AS bytes FROM emergency_mail')[0], {'n': 0, 'bytes': 0})
    return {'domains': {d: days for d, days in sorted(state['domains'].items()) if mine is None or d in mine}, 'mails': size['n'], 'bytes': int(size['bytes'])}


def emergency_set(args):
    """5n: keep a sealed copy of each delivered mail of a domain or tenant for 1 to 30 days; 0 is off and deletes them."""
    level, target, value = (args.level or '').strip(), (args.target or '').strip(), (args.days or '').strip()
    if level not in ('domain', 'tenant') or not value.isdigit() or int(value) not in (0,) + EMERGENCY_DAYS:
        raise EfaError('Level domain or tenant; days 0 (off), 1, 3, 7, 14 or 30.')
    domains = _hold_targets(level, target)
    state = _json_read(EMERGENCY_FILE, {'domains': {}})
    for domain in domains:
        if int(value):
            state['domains'][domain] = int(value)
        else:
            state['domains'].pop(domain, None)
            _safe(lambda domain=domain: _admin_query('DELETE FROM emergency_mail WHERE rcpt LIKE %s', ('%@' + domain,)), None)
    on = bool(state['domains'])
    if on:
        # Sealed always: the keys of the tenants exist from here on, also when held mail is not sealed (D3).
        _uq_keys_refresh(force=True)
        subprocess.run(['postconf', '-M', f'{EMERGENCY_SERVICE}/unix={EMERGENCY_MASTER}'], check=True, capture_output=True)
    lines = emergency_bcc_lines(state['domains'])
    if lines:
        _write(EMERGENCY_BCC, '\n'.join(lines) + '\n')
    elif os.path.exists(EMERGENCY_BCC):
        os.remove(EMERGENCY_BCC)
    _rule_map(EMERGENCY_TRANSPORT, ['efa-emergency.invalid efa-emergency:'] if on else [])
    for parameter, entry in (('recipient_bcc_maps', f'regexp:{EMERGENCY_BCC}'), ('transport_maps', f'hash:{EMERGENCY_TRANSPORT}')):
        wanted = map_list_value(_postconf(parameter), entry, on)
        if wanted != _postconf(parameter):
            _postconf_set(parameter, wanted)
    if not on:
        subprocess.run(['postconf', '-MX', f'{EMERGENCY_SERVICE}/unix'], check=False, capture_output=True)
    _json_write(EMERGENCY_FILE, state, mode=0o640)
    shutil.chown(EMERGENCY_FILE, 'root', 'efa-web')
    subprocess.run(['postfix', 'reload'], check=False, capture_output=True)
    _audit(f'emergency copy of {level} {target} set to {value} days by {_dmarc_who()}')
    return emergency_status(None)


def _emergency_who(args):
    """The addresses the reader may see: a user only the own one; an admin with the right and a reason, the own domains."""
    if identity_now and identity_now.get('role') == 'user':
        return 'user', identity_now['username'].lower()
    if identity_now and 'mail.emergency.read' not in identity_now.get('grants', set()) and identity_now.get('role') != 'super':
        raise EfaError('Not allowed: this needs the right mail.emergency.read.')
    reason = ' '.join((getattr(args, 'reason', '') or '').split())
    if len(reason) < 5:
        raise EfaError('A reason of at least 5 characters: every access to mail is kept in the audit log.')
    return 'admin', reason


def _emergency_allowed(rcpt, kind, who):
    if kind == 'user':
        return rcpt.lower() == who
    mine = identity_now.get('domains') if identity_now else None
    return mine is None or rcpt.rpartition('@')[2].lower() in mine


def emergency_list(args):
    """5n: mail that waits in the queue for a mail server that is down, and the emergency copies, newest first."""
    kind, who = _emergency_who(args)
    address = (getattr(args, 'address', '') or '').strip().lower()
    rows = []
    done = subprocess.run(['postqueue', '-j'], capture_output=True, text=True)
    local = set(_local_domains())
    for line in done.stdout.splitlines():
        item = _safe(lambda line=line: json.loads(line), {})
        if item.get('queue_name') != 'deferred':
            continue
        for rcpt in item.get('recipients', []):
            address_now = str(rcpt.get('address', '')).lower()
            if address_now.rpartition('@')[2] in local and _emergency_allowed(address_now, kind, who) and (not address or address_now == address):
                rows.append({'id': 'q:' + item['queue_id'], 'ts': time.strftime('%Y-%m-%d %H:%M', time.localtime(item.get('arrival_time', 0))),
                             'rcpt': address_now, 'sender': item.get('sender', ''), 'subject': '', 'source': 'queue', 'size': item.get('message_size', 0)})
    copies = _safe(lambda: _admin_query('SELECT id, CAST(ts AS CHAR) AS ts, rcpt, sender, subject, size FROM emergency_mail WHERE until > NOW() '
                                        + ('AND rcpt = %s ' if address or kind == 'user' else '') + 'ORDER BY id DESC LIMIT 500',
                                        ((address or who),) if address or kind == 'user' else ()), [])
    rows += [{'id': f"c:{row['id']}", 'ts': row['ts'][:16], 'rcpt': row['rcpt'], 'sender': row['sender'], 'subject': row['subject'], 'source': 'copy',
              'size': row['size']} for row in copies if _emergency_allowed(row['rcpt'], kind, who)]
    _audit(f"emergency list{' of ' + address if address else ''} by {_dmarc_who()}" + (f': {who}' if kind == 'admin' else ''))
    return {'mails': sorted(rows, key=lambda row: row['ts'], reverse=True)}


def _emergency_raw(mail_id, kind, who):
    """The mail of an id (q:<queue id> or c:<copy>) as bytes, when the reader may see it."""
    if mail_id.startswith('q:') and re.fullmatch(r'[0-9A-Za-z]{6,20}', mail_id[2:]):
        envelope = subprocess.run(['postcat', '-eq', mail_id[2:]], capture_output=True, text=True, timeout=30).stdout
        rcpts = re.findall(r'^recipient: (.+)$', envelope, re.M)
        if not any(_emergency_allowed(rcpt.strip(), kind, who) for rcpt in rcpts):
            raise EfaError('No such mail of yours.')
        done = subprocess.run(['postcat', '-bhq', mail_id[2:]], capture_output=True, timeout=60)
        if done.returncode != 0:
            raise EfaError('The mail is not in the queue any more: it was delivered.')
        return done.stdout
    if mail_id.startswith('c:') and mail_id[2:].isdigit():
        rows = _admin_query('SELECT rcpt, sealed FROM emergency_mail WHERE id = %s AND until > NOW()', (int(mail_id[2:]),))
        if not rows or not _emergency_allowed(rows[0]['rcpt'], kind, who):
            raise EfaError('No such mail of yours.')
        try:
            return _lib('efa_qcrypt').decrypt(rows[0]['sealed'], _uq_privates())
        except ValueError as err:
            raise EfaError(f'This copy cannot be read: {err}.')
    raise EfaError('Invalid mail.')


def emergency_show(args):
    """5n: the text of a mail (never as HTML, nothing is loaded), and the list of its attachments."""
    kind, who = _emergency_who(args)
    raw = _emergency_raw((args.id or '').strip(), kind, who)
    _audit(f'emergency read of {args.id} by {_dmarc_who()}' + (f': {who}' if kind == 'admin' else ''))
    head = raw.split(b'\n\n', 1)[0].decode('utf-8', 'replace')[:4000]
    view = mail_text(raw, CONTENT_MORE)
    for index, item in enumerate(view['attachments']):
        item.update(index=index, dangerous=item['name'].rpartition('.')[2].lower() in ATTACH_DANGEROUS)
    return {'id': args.id, 'headers': head, **view}


def emergency_file(args):
    """5n: one attachment (index), or the whole mail as .eml (index 'eml'), as a file to save; a dangerous one only with yes."""
    kind, who = _emergency_who(args)
    raw = _emergency_raw((args.id or '').strip(), kind, who)
    which = (args.index or '').strip()
    if which == 'eml':
        data, name = raw, 'mail.eml'
    else:
        message = email.parser.BytesParser(policy=email.policy.default).parsebytes(raw)
        parts = list(message.iter_attachments())
        if not which.isdigit() or int(which) >= len(parts):
            raise EfaError('No such attachment.')
        part = parts[int(which)]
        data = part.get_payload(decode=True) or b''
        name = re.sub(r'[^\w.\-]', '_', str(part.get_filename() or 'attachment'))[:100]
        if name.rpartition('.')[2].lower() in ATTACH_DANGEROUS and (getattr(args, 'confirm', '') or '').strip() != 'yes':
            raise EfaError(f'{name} is a kind of file that can run code. Type yes to save it anyway; open it only if you trust it.')
    _audit(f'emergency download of {args.id} ({name}) by {_dmarc_who()}' + (f': {who}' if kind == 'admin' else ''))
    return {'name': name, 'file': base64.b64encode(data).decode()}


# The daily jobs write what the notices show: the status call reads only this file (no query, no openssl per page).
NOTICE_STATE = '/var/lib/eFa/daily-notices.json'


def _notice_state_set(key, value):
    state = _json_read(NOTICE_STATE, {})
    state[key] = value
    _json_write(NOTICE_STATE, state)


def _emergency_job():
    """Daily: copies past their days go; a note when they take much of the disk."""
    _admin_query('DELETE FROM emergency_mail WHERE until <= NOW()')
    used = int(_admin_query('SELECT COALESCE(SUM(size), 0) AS bytes FROM emergency_mail')[0]['bytes'])
    usage = shutil.disk_usage('/var/lib/mysql') if os.path.isdir('/var/lib/mysql') else None
    _notice_state_set('emergency_bytes', used if usage and used > usage.free * 0.25 else 0)


def emergency_notices():
    used = _json_read(NOTICE_STATE, {}).get('emergency_bytes', 0)
    if not used or not _json_read(EMERGENCY_FILE, {'domains': {}})['domains']:
        return []
    return [_text('The emergency copies take {size} MB, more than a quarter of the free disk: fewer days or fewer domains (Mail & quarantine, '
                  'Emergency access).', size=used // 1048576)]

# O1: the history of the configuration. Before each change through efactl the files of eFa-next are read; after it, those that
# changed are kept with their old and new text (secrets never: keys, passwords and files only root may read). The history shows
# each change with its diff, and one click takes a change back: the files of before, checked by Postfix, rspamd and nginx, then
# reloaded; a check that fails puts the files of after back. What lives in the database (rules, users, settings of tenants) is
# in the audit log, not here.
HISTORY_DIR = '/var/lib/eFa/config-history'
# Jobs and reads that write state but no configuration: no snapshot for them.
HISTORY_QUIET = {'outbound-hold-run', 'cve-watch-run', 'domain-check-run', 'mta-sts-check', 'retro-run', 'lookalike-run'}
HISTORY_KEEP, HISTORY_DAYS, HISTORY_MAX_FILE = 500, 90, 512 * 1024
HISTORY_GLOBS = ('/eFa/*.json', '/efa-web/*.json', '/postfix/main.cf', '/postfix/master.cf', '/postfix/efa-*', '/postfix/transport',
                 '/rspamd/local.d/*.conf', '/rspamd/local.d/*.inc', '/rspamd/override.d/*.conf', '/rspamd/efa-*.json', '/rspamd/efa-*.lua',
                 '/rspamd/rspamd.local.lua', '/nginx/conf.d/efa*.conf', '/fail2ban/jail.d/efa*.local')
HISTORY_SECRET = re.compile(r'(key|secret|passw|\.pw$|\.pem$|token|sasl_passwd|credential|\.db$)', re.I)


def history_files():
    """The files of the configuration that the history keeps: no secrets, no file only root may read, nothing large."""
    found = set()
    for pattern in HISTORY_GLOBS:
        for path in glob.glob(ETC + pattern):
            try:
                info = os.stat(path)
            except OSError:
                continue
            if os.path.isfile(path) and not HISTORY_SECRET.search(os.path.basename(path)) and info.st_mode & 0o044 and info.st_size <= HISTORY_MAX_FILE:
                found.add(path)
    return found


def history_read(paths):
    contents = {}
    for path in paths:
        try:
            with open(path, 'rb') as f:
                contents[path] = f.read()
        except OSError:
            pass
    return contents


def history_changes(before, after):
    """{path: (old bytes or None, new bytes or None)} of the files that differ."""
    return {path: (before.get(path), after.get(path)) for path in sorted(set(before) | set(after)) if before.get(path) != after.get(path)}


def history_record(command, before):
    """After a change: an entry with the files it changed, if any. Never stops the change itself."""
    try:
        changes = history_changes(before, history_read(history_files() | set(before)))
        if not changes:
            return None
        os.makedirs(HISTORY_DIR, mode=0o700, exist_ok=True)
        entry_id = time.strftime('%Y%m%d%H%M%S-') + secrets.token_hex(3)
        entry = {'id': entry_id, 'ts': time.strftime('%Y-%m-%d %H:%M:%S'), 'who': _dmarc_who(), 'command': command,
                 'files': {path: [None if old is None else base64.b64encode(old).decode(), None if new is None else base64.b64encode(new).decode()]
                           for path, (old, new) in changes.items()}}
        with gzip.open(f'{HISTORY_DIR}/{entry_id}.json.gz', 'wt') as f:
            json.dump(entry, f)
        entries = sorted(glob.glob(HISTORY_DIR + '/*.json.gz'))
        limit = time.strftime('%Y%m%d', time.localtime(time.time() - HISTORY_DAYS * 86400))
        for path in entries[:-HISTORY_KEEP] + [item for item in entries if os.path.basename(item)[:8] < limit]:
            _safe(lambda path=path: os.remove(path), None)
        return entry_id
    except OSError as err:
        print(f'config history: {err}', file=sys.stderr)
        return None


def _history_entry(entry_id):
    if not re.fullmatch(r'\d{14}-[0-9a-f]{6}', entry_id or ''):
        raise EfaError('Invalid entry.')
    try:
        with gzip.open(f'{HISTORY_DIR}/{entry_id}.json.gz', 'rt') as f:
            return json.load(f)
    except OSError:
        raise EfaError('No such entry in the history.')


def history_list(_args):
    """O1: the changes of the configuration, newest first: when, who, which command, which files."""
    rows = []
    for path in sorted(glob.glob(HISTORY_DIR + '/*.json.gz'), reverse=True)[:200]:
        entry = _safe(lambda path=path: _history_entry(os.path.basename(path)[:-8]), None)
        if entry:
            rows.append({'id': entry['id'], 'ts': entry['ts'], 'who': entry['who'], 'command': entry['command'],
                         'files': ', '.join(os.path.relpath(item, ETC) for item in entry['files'])})
    return {'changes': rows}


def history_diff_text(files):
    import difflib
    lines = []
    for path, (old, new) in sorted(files.items()):
        old_text = base64.b64decode(old).decode('utf-8', 'replace').splitlines(keepends=True) if old else []
        new_text = base64.b64decode(new).decode('utf-8', 'replace').splitlines(keepends=True) if new else []
        lines += difflib.unified_diff(old_text, new_text, f'{path} (before)', f'{path} (after)', n=2)
    return ''.join(lines)[:200000]


def history_show(args):
    """O1: one change as a diff of its files."""
    entry = _history_entry((args.id or '').strip())
    return {'id': entry['id'], 'ts': entry['ts'], 'who': entry['who'], 'command': entry['command'], 'diff': history_diff_text(entry['files'])}


def _history_put(path, data, info=None):
    """A file with its bytes as they were, keeping its mode and owner (or those of before the change)."""
    info = info or _safe(lambda: os.stat(path), None)
    with open(path + '.efa-undo', 'wb') as f:
        f.write(data)
    if info:
        os.chmod(path + '.efa-undo', info.st_mode & 0o7777)
        _safe(lambda: os.chown(path + '.efa-undo', info.st_uid, info.st_gid), None)
    os.replace(path + '.efa-undo', path)


def _history_apply_checks(paths):
    """Postfix, rspamd and nginx check what they read, then load it; the first that refuses names itself."""
    touched = ' '.join(paths)
    if '/postfix/' in touched:
        done = subprocess.run(['postfix', 'check'], capture_output=True, text=True)
        if done.returncode != 0:
            return 'Postfix: ' + (done.stderr or done.stdout)[-200:]
    if '/rspamd/' in touched and not _rspamd_config_ok():
        return 'rspamd refused the configuration'
    if '/nginx/' in touched:
        done = subprocess.run(['nginx', '-t'], capture_output=True, text=True)
        if done.returncode != 0:
            return 'nginx: ' + done.stderr[-200:]
    return None


def history_undo(args):
    """O1: take one change back. Only while its files are still as it left them: later changes first."""
    _confirm(args)
    entry = _history_entry((args.id or '').strip())
    files = {path: (base64.b64decode(old) if old else None, base64.b64decode(new) if new else None) for path, (old, new) in entry['files'].items()}
    now = history_read(set(files))
    changed_since = [path for path, (_old, new) in files.items() if now.get(path) != new]
    if changed_since:
        raise EfaError('Changed again since: ' + ', '.join(os.path.relpath(path, ETC) for path in changed_since[:5]) + '. Take the later changes back first.')
    for path, (old, _new) in files.items():
        if old is None:
            os.remove(path)
        else:
            _history_put(path, old)
    problem = _history_apply_checks(files)
    if problem:
        for path, (_old, new) in files.items():
            if new is None:
                _safe(lambda path=path: os.remove(path), None)
            else:
                _history_put(path, new)
        raise EfaError(f'Not taken back, {problem}; the files are as before.')
    touched = ' '.join(files)
    for name, wanted in (('postfix', '/postfix/'), ('rspamd', '/rspamd/'), ('nginx', '/nginx/'), ('fail2ban', '/fail2ban/')):
        if wanted in touched:
            _platform().service_reload_if_active(name)
    _audit(f"config change {entry['id']} ({entry['command']} of {entry['who']}) taken back by {_dmarc_who()}")
    return {'undone': entry['id'], 'files': [os.path.relpath(path, ETC) for path in files]}


# P2: four eyes for critical changes. While it is on (for all, or for a tenant), a critical command of an admin login only asks:
# it waits until a second admin, who may run it too, confirms it; then it runs with both names in the audit log. A super admin
# may push an own request through at once with a reason (emergency). Commands that take a secret (passwords) are left out: the
# secret would have to wait in a file. The console of root is not affected.
FOUR_EYES_FILE = ETC + '/eFa/four-eyes.json'
FOUR_EYES_PENDING = '/var/lib/eFa/four-eyes-pending.json'
FOUR_EYES_DAYS = 7
FOUR_EYES_COMMANDS = {
    'rule-set', 'quarantine-release', 'uq-release', 'cdr-release', 'cluster-mail-action',
    'cdr-set', 'attachment-set', 'scan-fail-set', 'scan-limits-set', 'spam-scores-set', 'bec-set', 'links-set', 'dlp-set', 'dlp-rule-set',
    'tls-min-set', 'firewall-set', 'scanner-set', 'web-allowlist-set', 'ssh-root-set',
    'group-set', 'group-remove', 'group-state', 'group-map-set', 'user-state', 'user-2fa-reset', 'token-create', 'token-revoke', 'api-set', 'audit-mode'}


def four_eyes_state():
    return {'all': False, 'tenants': [], **_json_read(FOUR_EYES_FILE, {})}


def four_eyes_needed(command, identity, state):
    """Whether this call of a command waits for a second admin."""
    if command not in FOUR_EYES_COMMANDS or not identity or identity.get('role') == 'user':
        return False
    marker = os.environ.get('EFA_FOUR_EYES')
    if marker:
        # The confirmed run: only for a request that runs now, for this very command.
        item = _json_read(FOUR_EYES_PENDING, {}).get(marker)
        if not item or item['state'] != 'running' or item['command'] != command:
            raise EfaError('Four eyes: no confirmed request for this change.')
        return False
    if any(arg.get('secret') for arg in COMMANDS.get(command, {}).get('args', [])):
        return False
    return state['all'] or str(identity.get('tenant_id')) in {str(item) for item in state['tenants']}


def _four_eyes_pending():
    pending = _json_read(FOUR_EYES_PENDING, {})
    limit = time.time() - FOUR_EYES_DAYS * 86400
    return {key: item for key, item in pending.items() if item['since'] > limit and item['state'] == 'waiting'}


def four_eyes_request(command, args):
    """The call as a request that waits; its arguments as they were given."""
    values = {arg['name']: getattr(args, arg['name'], '') for arg in COMMANDS[command]['args'] if not arg.get('secret')}
    pending = _four_eyes_pending()
    key = secrets.token_hex(6)
    pending[key] = {'command': command, 'args': values, 'by': acting_user, 'tenant': str((identity_now or {}).get('tenant_id') or ''),
                    'since': time.time(), 'state': 'waiting'}
    _json_write(FOUR_EYES_PENDING, pending)
    _audit(f'four eyes: {command} asked by {_dmarc_who()}, waits for a second admin ({key})')
    _event('four_eyes_request', 'notice', user=_dmarc_who(), command=command)
    return {'waiting': key, 'command': command, 'note': 'A second admin confirms it under Four eyes; then it runs.'}


def four_eyes_list(_args):
    """P2: the changes that wait for a second admin, of the own tenant."""
    mine = (identity_now or {}).get('tenant_ids')
    rows = [{'id': key, 'command': item['command'], 'args': item['args'], 'by': item['by'],
             'since': time.strftime('%Y-%m-%d %H:%M', time.localtime(item['since']))}
            for key, item in sorted(_four_eyes_pending().items(), key=lambda pair: pair[1]['since'])
            if mine is None or not item['tenant'] or int(item['tenant']) in mine]
    return {'waiting': rows, **four_eyes_state()}


def four_eyes_decide(args):
    """P2: confirm a waiting change (it runs now, as the confirming admin, with both names), reject it, or as super admin push an
    own change through with a reason."""
    key, decision = (args.id or '').strip(), (args.decision or '').strip()
    pending = _four_eyes_pending()
    item = pending.get(key)
    if item is None:
        raise EfaError('No such change waits.')
    if decision == 'reject':
        if acting_user != item['by'] and not command_allowed(identity_now, item['command'], True):
            raise EfaError('Not allowed: only the admin who asked, or one who may run it, rejects it.')
        item['state'] = 'rejected'
        _json_write(FOUR_EYES_PENDING, {**_json_read(FOUR_EYES_PENDING, {}), key: item})
        _audit(f"four eyes: {item['command']} of {item['by']} rejected by {_dmarc_who()} ({key})")
        return four_eyes_list(None)
    if decision == 'confirm':
        if acting_user == item['by']:
            raise EfaError('A second admin confirms it, not the one who asked.')
    elif decision == 'urgent':
        reason = ' '.join((getattr(args, 'reason', '') or '').split())
        if acting_user != item['by'] or not identity_now or identity_now.get('role') != 'super' or len(reason) < 5:
            raise EfaError('Only the super admin who asked pushes an own change through, with a reason of at least 5 characters.')
        _audit(f"four eyes: emergency path for {item['command']} by {_dmarc_who()}: {reason[:200]}")
    else:
        raise EfaError("Decision: confirm, reject or urgent.")
    if not command_allowed(identity_now, item['command'], True):
        raise EfaError('Not allowed: you may not run this change yourself.')
    item['state'] = 'running'
    _json_write(FOUR_EYES_PENDING, {**_json_read(FOUR_EYES_PENDING, {}), key: item})
    flags = [f'--{name}={value}' for name, value in item['args'].items() if value not in (None, '')]
    done = subprocess.run([sys.argv[0] if sys.argv and sys.argv[0].endswith('efactl') else '/usr/sbin/efactl', '--as', acting_user,
                           '--client', acting_client, item['command'], *flags], capture_output=True, text=True, timeout=600,
                          env={**os.environ, 'EFA_FOUR_EYES': key})
    item['state'] = 'done' if done.returncode == 0 else 'failed'
    _json_write(FOUR_EYES_PENDING, {**_json_read(FOUR_EYES_PENDING, {}), key: item})
    _audit(f"four eyes: {item['command']} asked by {item['by']}, {decision} by {_dmarc_who()}: {item['state']} ({key})")
    try:
        result = json.loads(done.stdout or '{}')
    except ValueError:
        result = {'output': done.stdout[-500:]}
    if done.returncode != 0:
        raise EfaError(result.get('error', 'The change failed.'))
    return {'done': key, 'result': result}


def four_eyes_set(args):
    """P2: four eyes for critical changes, for all or a tenant. Only a super admin switches it."""
    if identity_now and identity_now.get('role') != 'super':
        raise EfaError('Only a super admin switches four eyes.')
    on, tenant = _on_off(args.mode), (args.tenant or '').strip()
    state = four_eyes_state()
    if tenant:
        tid = str(_tenant_id(tenant))
        state['tenants'] = sorted(set(map(str, state['tenants'])) | {tid}) if on else [item for item in map(str, state['tenants']) if item != tid]
    else:
        state['all'] = on
    _json_write(FOUR_EYES_FILE, state, mode=0o644)
    _audit(f"four eyes {'on' if on else 'off'} for {tenant or 'all'} by {_dmarc_who()}")
    return four_eyes_list(None)

# O2: staged updates of a cluster. While it is on, the nodes do not install eFa-next updates by themselves; the master, in its
# maintenance window, has one node install first, waits the health window (reachable, the new version, nothing down), then the
# next nodes one by one, and itself last. A node that is not healthy stops the rollout and tells the admins.
UPDATE_STAGED_FILE = ETC + '/eFa/update-staged.json'
CLUSTER_UPDATE_FILE = ETC + '/eFa/cluster-update.json'
CLUSTER_UPDATE_STATE = '/var/lib/eFa/cluster-update.json'
CLUSTER_UPDATE_WINDOWS = (1, 2, 4)


def update_staged_set(args):
    """O2 on a node: the master decides when this node installs an update (on), or the node itself as before (off)."""
    on = _on_off(args.mode)
    _json_write(UPDATE_STAGED_FILE, {'staged': on}, mode=0o644)
    _audit(f"staged updates {'on' if on else 'off'} on this node by {_dmarc_who()}")
    return {'staged': on}


def update_staged():
    return bool(_json_read(UPDATE_STAGED_FILE, {}).get('staged'))


def cluster_update_settings():
    return {'enabled': False, 'window': 1, 'first': '', **_json_read(CLUSTER_UPDATE_FILE, {})}


def cluster_update_next(state, nodes, version, statuses, now, window):
    """The next step of a rollout: ('install', node), ('wait', node), ('self', None), ('stop', reason) or ('done', None).
    statuses: {node: the answer of /v1/status, or None when it does not answer}."""
    order = state['order']
    while state['index'] < len(order):
        node = order[state['index']]
        if node not in nodes:
            state['index'] += 1
            continue
        status = statuses.get(node)
        if state.get('started') is None:
            return 'install', node
        healthy = status is not None and status.get('version') == version and not status.get('down') and status.get('status') in (None, 'ok')
        if healthy and now - state['started'] >= window * 3600:
            state['index'] += 1
            state['started'] = None
            continue
        if not healthy and now - state['started'] > max(2, window) * 3600:
            return 'stop', f"{node} is not healthy after the update ({'not reachable' if status is None else status.get('down') or status.get('version')})"
        return 'wait', node
    return ('self', None) if not state.get('self_done') else ('done', None)


def cluster_update_step():
    """The master, from its hourly update job: starts a rollout in the window, or goes one step on."""
    settings_now = cluster_update_settings()
    if not settings_now['enabled'] or cluster_role() != 'master':
        return None
    cluster, base, cstate = _cluster_parts()
    nodes = cstate.get('nodes', {})
    update = _update_state()
    state = _json_read(CLUSTER_UPDATE_STATE, {})
    now = time.time()
    if not state.get('version') or state.get('phase') in ('done', 'stopped'):
        if not (_update_available(update) and _update_in_window(update, datetime.datetime.now())) or state.get('version') == update['latest']:
            return None
        first = settings_now['first'] if settings_now['first'] in nodes else (sorted(nodes)[0] if nodes else '')
        state = {'version': update['latest'], 'phase': 'running', 'order': [first] + sorted(set(nodes) - {first}) if first else [], 'index': 0,
                 'started': None, 'since': now}
        _audit(f"staged update to {state['version']} started, first {first or 'the master (no nodes)'}")
    statuses = {}
    for name in state['order'][state['index']:state['index'] + 1]:
        node = nodes.get(name)
        statuses[name] = _safe(lambda node=node: cluster.call(base, node['host'], node['port'], '/v1/status', timeout=10), None) if node else None
    action, target = cluster_update_next(state, nodes, state['version'], statuses, now, settings_now['window'])
    if action == 'install':
        node = nodes[target]
        answer = _safe(lambda: cluster.call(base, node['host'], node['port'], '/v1/run', {'command': 'update-install', 'args': {'confirm': 'yes'}}, timeout=60),
                       {'error': 'not reachable'})
        state['started'] = now
        _audit(f"staged update: {target} installs {state['version']}" + (f" ({answer['error']})" if 'error' in answer else ''))
    elif action == 'self':
        state['self_done'] = True
        state['phase'] = 'done'
        _audit(f"staged update: the master installs {state['version']} last")
        _update_install(update)
    elif action == 'stop':
        state['phase'] = 'stopped'
        state['reason'] = target
        _admins_notify('eFa-next: staged update stopped / gestaffeltes Update angehalten', f"The update to {state['version']} stopped: {target}. "
                       'The other nodes keep their version. Check the node, then start it again: efactl cluster-update-set --mode on.')
        _event('cluster_update_stopped', 'warning', reason=target[:200])
        _audit(f'staged update stopped: {target}')
    _json_write(CLUSTER_UPDATE_STATE, state)
    return {'action': action, 'node': target}


def cluster_update_status(_args):
    """O2: staged updates of the cluster and the rollout of now."""
    return {**cluster_update_settings(), 'rollout': _json_read(CLUSTER_UPDATE_STATE, {})}


def cluster_update_set(args):
    """O2: on the master: staged updates of the nodes, one first, a health window, then the rest and the master last."""
    if cluster_role() != 'master':
        raise EfaError('Only on the master of a cluster.')
    settings_now = cluster_update_settings()
    on = _on_off(args.mode)
    window = (args.window or '').strip()
    if window:
        if not window.isdigit() or int(window) not in CLUSTER_UPDATE_WINDOWS:
            raise EfaError('Health window: 1, 2 or 4 hours.')
        settings_now['window'] = int(window)
    settings_now['first'] = (args.first or '').strip() or settings_now['first']
    settings_now['enabled'] = on
    cluster, base, cstate = _cluster_parts()
    failed = []
    for name, node in sorted(cstate.get('nodes', {}).items()):
        answer = _safe(lambda node=node: cluster.call(base, node['host'], node['port'], '/v1/run', {'command': 'update-staged-set', 'args': {'mode': 'on' if on else 'off'}},
                                                      timeout=30), {'error': 'not reachable'})
        if 'error' in answer:
            failed.append(f"{name}: {answer['error']}")
    _json_write(CLUSTER_UPDATE_FILE, settings_now, mode=0o644)
    if on:
        # A rollout that stopped starts again with the next window.
        state = _json_read(CLUSTER_UPDATE_STATE, {})
        if state.get('phase') == 'stopped':
            _json_write(CLUSTER_UPDATE_STATE, {})
    _audit(f"staged cluster updates {'on' if on else 'off'} (window {settings_now['window']} h) by {_dmarc_who()}")
    return {**cluster_update_status(None), 'unreachable': failed}

# AD signatures: the fields of each sender from LDAP or Active Directory (the login directory, global and of each tenant) for the
# placeholders of the disclaimer templates ({{name}}, {{title}}, {{phone}} ...). Once an hour into a file only efa-outbound gets,
# as a systemd credential; the milter starts again only when the fields changed. Off by default.
SIGNATURE_FILE = ETC + '/eFa/signature.json'
SIGNATURE_FIELDS = ETC + '/eFa/signature-fields.json'
# dict() form: the text catalog takes every value of a quoted title key for a text of the interface.
SIGNATURE_LDAP = dict(mail='mail', displayName='name', givenName='first', sn='last', title='title', department='department', company='company',
                      telephoneNumber='phone', mobile='mobile', facsimileTelephoneNumber='fax', streetAddress='street', postalCode='postcode', l='city',
                      co='country', wWWHomePage='web')


def ldif_records(text):
    """The entries of ldapsearch -LLL as {attribute: first value}; base64 values (attr:: ...) decoded."""
    records, current = [], {}
    for line in text.splitlines() + ['']:
        if not line.strip():
            if current:
                records.append(current)
            current = {}
            continue
        name, sep, value = line.partition(':')
        if not sep or name in current:
            continue
        if value.startswith(':'):
            value = _safe(lambda value=value: base64.b64decode(value[1:].strip()).decode('utf-8', 'replace'), '')
        current[name] = value.strip()
    return records


def signature_map(records, domains):
    """{address: {field: value}} for the addresses of the own domains; values cut to 200 characters, no line breaks."""
    found = {}
    for record in records:
        mail = record.get('mail', '').lower()
        if not SENDER_RE.match(mail) or mail.rpartition('@')[2] not in domains:
            continue
        found[mail] = {field: ' '.join(record[attr].split())[:200] for attr, field in SIGNATURE_LDAP.items() if record.get(attr)}
    return found


def signature_sync(_args=None):
    """Reads the fields of all users from the directories and hands them to efa-outbound when they changed."""
    if not _json_read(SIGNATURE_FILE, {}).get('enabled'):
        return {'enabled': False}
    domains, records, problems = set(_local_domains()), [], []
    for path in [LDAP_FILE] + sorted(glob.glob(IDP_DIR + '/ldap-*.json')):
        state = _json_read(path, {})
        if not state.get('ldap'):
            continue
        with tempfile.NamedTemporaryFile('w', dir='/run', prefix='efa-ldap-') as service:
            service.write(state['bind_password'])
            service.flush()
            done = subprocess.run(ldap_command('ldapsearch', state, state['bind_dn'], service.name) +
                                  ['-LLL', '-o', 'ldif-wrap=no', '-E', 'pr=500/noprompt', '-b', state['base'], '(mail=*)', *SIGNATURE_LDAP],
                                  capture_output=True, text=True, timeout=120)
        if done.returncode != 0:
            problems.append(f'{os.path.basename(path)}: {done.stderr.strip()[-150:]}')
            continue
        records += ldif_records(done.stdout)
    fields = signature_map(records, domains)
    before = open(SIGNATURE_FIELDS).read() if os.path.exists(SIGNATURE_FIELDS) else None
    text = json.dumps(fields, sort_keys=True)
    if before != text and not problems:
        fd = os.open(SIGNATURE_FIELDS + '.new', os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, 'w') as f:
            f.write(text)
        os.replace(SIGNATURE_FIELDS + '.new', SIGNATURE_FIELDS)
        # The credential of the milter is read at its start.
        _safe(lambda: _platform().service_restart(OUTBOUND_UNIT, check=False), None)
    _json_write(SIGNATURE_FILE, {**_json_read(SIGNATURE_FILE, {}), 'last': time.strftime('%Y-%m-%d %H:%M'), 'users': len(fields), 'problems': problems},
                mode=0o644)
    return signature_status(None)


def signature_status(_args):
    """AD signatures: on or off, when the directory was read, how many users, and the placeholders the templates may use."""
    return {'enabled': False, **_json_read(SIGNATURE_FILE, {}), 'placeholders': ' '.join('{{' + name + '}}' for name in _lib('efa_disclaimer').FIELDS)}


def signature_set(args):
    """AD signatures: fill the placeholders of the disclaimer templates from the directory, per sender."""
    on = _on_off(args.mode)
    if on and not _json_read(LDAP_FILE, {}).get('ldap') and not glob.glob(IDP_DIR + '/ldap-*.json'):
        raise EfaError('First a login directory (LDAP or Active Directory): Users, Directory login.')
    _json_write(SIGNATURE_FILE, {**_json_read(SIGNATURE_FILE, {}), 'enabled': on}, mode=0o644)
    _audit(f"AD signatures {'on' if on else 'off'} by {_dmarc_who()}")
    return signature_sync() if on else signature_status(None)

# 13: the Outlook add-in for reports. The manifest names a report address of the phishing reports (6.0.0.4); its task pane is a
# static page under /outlook/ (nginx, no own service) that opens a new message to that address with the open mail attached.
OUTLOOK_MANIFEST = '''<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="MailApp">
  <Id>%(id)s</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>eFa-next</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Report to eFa-next"/>
  <Description DefaultValue="Sends a suspicious mail to %(address)s for a check."/>
  <IconUrl DefaultValue="%(base)s/outlook/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="%(base)s/outlook/icon-128.png"/>
  <SupportUrl DefaultValue="%(base)s/portal/"/>
  <AppDomains><AppDomain>%(base)s</AppDomain></AppDomains>
  <Hosts><Host Name="Mailbox"/></Hosts>
  <Requirements><Sets><Set Name="Mailbox" MinVersion="1.1"/></Sets></Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings><SourceLocation DefaultValue="%(base)s/outlook/taskpane.html?to=%(to)s"/><RequestedHeight>250</RequestedHeight></DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or"><Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/></Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>
</OfficeApp>
'''


def outlook_manifest(address, base):
    """The manifest of the add-in for one report address; its Id stays the same for the address, so an update replaces it."""
    import uuid
    return OUTLOOK_MANIFEST % {'id': uuid.uuid5(uuid.NAMESPACE_URL, f'{base}/outlook/{address}'), 'address': html.escape(address),
                               'base': html.escape(base), 'to': urllib.parse.quote(address)}


def outlook_addin(args):
    """13: the manifest of the Outlook add-in for a report address, to install in Exchange or Microsoft 365 (central deployment)."""
    address = (args.address or '').strip().lower()
    if address not in _json_read(PHISH_FILE, {'addresses': []})['addresses']:
        raise EfaError('One of the report addresses (Spam & virus, Phishing reports).')
    if identity_now and identity_now.get('domains') is not None and address.rpartition('@')[2] not in identity_now['domains']:
        raise EfaError('Not allowed: name an address of your own domains.')
    base = uq_state().get('public_url', '').rstrip('/')
    if not base.startswith('https://'):
        raise EfaError('The public address of the portal first, https only (Quarantine for users, public address).')
    return {'text': outlook_manifest(address, base), 'name': 'efa-next-report-manifest.xml'}

# M7 = P4: operation without internet. (1) A local mirror of the eFa-next repository (the same signed SHA256SUMS, checked with the
# same key): updates come from there only. (2) Signed bundles for networks without any connection: an eFa-next host with
# internet packs the release packages, the ClamAV signatures and the threat maps into one file and signs its list with its own
# Ed25519 key; the isolated host trusts that key (offline-trust-set) and applies a bundle only when the signature and every
# checksum fit. The dashboard tells when the virus signatures get old.
MIRROR_FILE = ETC + '/eFa/update-mirror.json'
OFFLINE_KEY = ETC + '/eFa/offline-bundle.key'
OFFLINE_TRUST = ETC + '/eFa/offline-trust.json'
OFFLINE_DIR = '/var/lib/eFa/offline'
CLAMAV_DB = '/var/lib/clamav'
OFFLINE_MAX = 4 * 1024 * 1024 * 1024
SIGNATURE_AGE_DAYS = 3


def _update_apis():
    mirror = _json_read(MIRROR_FILE, {}).get('url')
    return (f'{mirror}/latest.json',) if mirror else (UPDATE_API, UPDATE_MIRROR_API)


def _update_bases(version):
    mirror = _json_read(MIRROR_FILE, {}).get('url')
    return (f'{mirror}/{version}',) if mirror else (UPDATE_DOWNLOAD.format(tag=version), UPDATE_MIRROR_DOWNLOAD.format(tag=version))


def update_mirror_set(args):
    """M7: updates of eFa-next only from a local mirror of repo.efa-next.eu/el9 (https); empty goes back to the repository."""
    url = (args.url or '').strip().rstrip('/')
    if url and not re.fullmatch(r'https://[A-Za-z0-9.\-]+(:\d+)?(/[\w.\-/]*)?', url):
        raise EfaError('The mirror: https://host/path, a copy of https://repo.efa-next.eu/el9 (the signature is checked as before).')
    _json_write(MIRROR_FILE, {'url': url} if url else {}, mode=0o644)
    _audit(f"update mirror {'set to ' + url if url else 'removed'} by {_dmarc_who()}")
    return {'mirror': url or 'none: repo.efa-next.eu and the GitHub mirror', 'trust': UPDATE_TRUST_NOTE}


def _offline_key():
    from cryptography.hazmat.primitives import serialization
    from cryptography.hazmat.primitives.asymmetric import ed25519
    if not os.path.exists(OFFLINE_KEY):
        fd = os.open(OFFLINE_KEY, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, 'wb') as f:
            f.write(ed25519.Ed25519PrivateKey.generate().private_bytes(serialization.Encoding.PEM, serialization.PrivateFormat.PKCS8,
                                                                        serialization.NoEncryption()))
    with open(OFFLINE_KEY, 'rb') as f:
        return serialization.load_pem_private_key(f.read(), None)


def offline_list(files):
    """The signed list of a bundle: name and sha256 of each file, one per line, sorted."""
    return ''.join(f'{hashlib.sha256(data).hexdigest()}  {name}\n' for name, data in sorted(files.items())).encode()


def offline_check(listing, signature, public, files):
    """The problems of a bundle: the signature of its list against the trusted key, then each file against the list."""
    from cryptography.exceptions import InvalidSignature
    from cryptography.hazmat.primitives.asymmetric import ed25519
    try:
        ed25519.Ed25519PublicKey.from_public_bytes(public).verify(signature, listing)
    except (InvalidSignature, ValueError):
        return ['the signature of the bundle does not fit the trusted key']
    wanted = dict(reversed(line.split('  ', 1)) for line in listing.decode().splitlines() if '  ' in line)
    problems = [f'{name}: checksum does not fit' for name, data in files.items() if wanted.get(name) != hashlib.sha256(data).hexdigest()]
    problems += [f'{name}: missing' for name in wanted if name not in files]
    return problems


def offline_bundle_make(_args):
    """M7, on a host with internet: the release packages, the ClamAV signatures and the threat maps in one signed file."""
    import tarfile
    os.makedirs(OFFLINE_DIR, mode=0o700, exist_ok=True)
    files = {}
    state = _update_state()
    version = state.get('latest') or _update_installed()
    work = tempfile.mkdtemp(prefix='efa-bundle-')
    try:
        for path in _safe(lambda: _update_download(version, work), []) or []:
            with open(path, 'rb') as f:
                files['rpms/' + os.path.basename(path)] = f.read()
    finally:
        shutil.rmtree(work, ignore_errors=True)
    for path in sorted(glob.glob(CLAMAV_DB + '/*.cvd') + glob.glob(CLAMAV_DB + '/*.cld') + glob.glob(CLAMAV_DB + '/*.ndb') + glob.glob(CLAMAV_DB + '/*.hdb')):
        with open(path, 'rb') as f:
            files['clamav/' + os.path.basename(path)] = f.read()
    for kind, path in FEED_MAPS.items():
        if os.path.exists(path):
            with open(path, 'rb') as f:
                files[f'maps/{kind}'] = f.read()
    if sum(len(data) for data in files.values()) > OFFLINE_MAX:
        raise EfaError('The bundle would be larger than 4 GB.')
    listing = offline_list(files)
    signature = _offline_key().sign(listing)
    name = f"{OFFLINE_DIR}/efa-next-bundle-{time.strftime('%Y%m%d-%H%M')}.tar"
    with tarfile.open(name, 'w') as tar:
        for arc, data in [('SHA256SUMS', listing), ('SHA256SUMS.sig', signature)] + sorted(files.items()):
            info = tarfile.TarInfo(arc)
            info.size, info.mtime, info.mode = len(data), int(time.time()), 0o644
            tar.addfile(info, io.BytesIO(data))
    _audit(f'offline bundle {os.path.basename(name)} made by {_dmarc_who()}')
    return {'bundle': name, 'files': len(files), 'version': version, 'key': key_fingerprint(_raw_public(_offline_key().public_key())),
            'public_key': base64.b64encode(_raw_public(_offline_key().public_key())).decode(),
            'note': 'Copy the file to the isolated host; trust this key there once: efactl offline-trust-set --key <public_key>.'}


def offline_trust_set(args):
    """M7, on the isolated host: the public key whose bundles it applies (from offline-bundle-make of the host with internet)."""
    text = (args.key or '').strip()
    try:
        raw = base64.b64decode(text, validate=True)
    except ValueError:
        raw = b''
    if len(raw) != 32:
        raise EfaError('The public key from offline-bundle-make (base64, 32 bytes).')
    _json_write(OFFLINE_TRUST, {'key': text, 'fingerprint': key_fingerprint(raw)}, mode=0o644)
    _audit(f'offline bundle key {key_fingerprint(raw)} trusted by {_dmarc_who()}')
    return {'trusted': key_fingerprint(raw)}


def offline_bundle_apply(args):
    """M7: a bundle applied only when its signature and every checksum fit: packages through dnf without repositories (their own
    signatures checked by rpm too), the ClamAV signatures after a check by sigtool, the threat maps."""
    import tarfile
    _confirm(args)
    trust = _json_read(OFFLINE_TRUST, {})
    if not trust.get('key'):
        raise EfaError('No trusted bundle key yet: offline-trust-set.')
    path = (args.file or '').strip()
    if not path.startswith(('/var/tmp/', '/tmp/', OFFLINE_DIR + '/', '/media/', '/mnt/')) or '..' in path or not os.path.isfile(path):
        raise EfaError('The bundle file, under /var/tmp, /tmp, /media, /mnt or ' + OFFLINE_DIR + '.')
    if os.path.getsize(path) > OFFLINE_MAX + 1024 * 1024:
        raise EfaError('The bundle is larger than 4 GB.')
    files = {}
    with tarfile.open(path) as tar:
        for member in tar.getmembers():
            if not member.isfile() or member.name.startswith(('/', '..')) or '/../' in member.name or len(files) > 2000:
                raise EfaError(f'Not a bundle of eFa-next: {member.name[:80]}.')
            files[member.name] = tar.extractfile(member).read()
    listing, signature = files.pop('SHA256SUMS', b''), files.pop('SHA256SUMS.sig', b'')
    problems = offline_check(listing, signature, base64.b64decode(trust['key']), files)
    if problems:
        _audit(f'offline bundle {os.path.basename(path)} refused: {problems[0]}')
        raise EfaError('Refused, nothing applied: ' + '; '.join(problems[:3]))
    done = []
    work = tempfile.mkdtemp(prefix='efa-bundle-')
    try:
        clam = [name for name in files if name.startswith('clamav/')]
        for name in clam:
            target = os.path.join(work, os.path.basename(name))
            with open(target, 'wb') as f:
                f.write(files[name])
            if name.endswith(('.cvd', '.cld')) and subprocess.run(['sigtool', '--info', target], capture_output=True).returncode != 0:
                raise EfaError(f'{name}: sigtool does not take it, nothing applied.')
        for name in clam:
            shutil.copyfile(os.path.join(work, os.path.basename(name)), os.path.join(CLAMAV_DB, os.path.basename(name)))
            _safe(lambda name=name: shutil.chown(os.path.join(CLAMAV_DB, os.path.basename(name)), 'clamupdate', 'clamupdate'), None)
        if clam:
            _platform().service_reload_if_active('clamd@scan')
            done.append(f'{len(clam)} ClamAV signature files')
        for name in [name for name in files if name.startswith('maps/')]:
            kind = name.split('/', 1)[1]
            if kind in FEED_MAPS:
                _write(FEED_MAPS[kind] + '.tmp', files[name].decode('utf-8', 'replace'))
                os.replace(FEED_MAPS[kind] + '.tmp', FEED_MAPS[kind])
                done.append(f'threat map {kind}')
        rpms = [name for name in files if name.startswith('rpms/') and name.endswith('.rpm')]
        if rpms:
            for name in rpms:
                with open(os.path.join(work, os.path.basename(name)), 'wb') as f:
                    f.write(files[name])
                if not _platform().package_signature_ok(os.path.join(work, os.path.basename(name))):
                    raise EfaError(f'{name}: the package signature does not fit, no package installed.')
            ok, output = _platform().package_upgrade_files([os.path.join(work, os.path.basename(name)) for name in rpms])
            done.append('packages: ' + ('installed' if ok else 'the install failed: ' + output))
    finally:
        shutil.rmtree(work, ignore_errors=True)
    _audit(f"offline bundle {os.path.basename(path)} applied by {_dmarc_who()}: {', '.join(done)}")
    return {'applied': done}


def offline_status(_args):
    """M7: the mirror, the trusted bundle key, and how old the virus signatures are."""
    newest = max((os.path.getmtime(path) for path in glob.glob(CLAMAV_DB + '/*.c[lv]d')), default=0)
    return {'mirror': _json_read(MIRROR_FILE, {}).get('url', ''), 'trusted_key': _json_read(OFFLINE_TRUST, {}).get('fingerprint', ''),
            'virus_signatures_days': round((time.time() - newest) / 86400, 1) if newest else None}


def offline_notices():
    newest = max((os.path.getmtime(path) for path in glob.glob(CLAMAV_DB + '/*.c[lv]d')), default=0)
    if newest and time.time() - newest > SIGNATURE_AGE_DAYS * 86400:
        return [_text('The virus signatures are {days} days old: check freshclam, or apply an offline bundle (System, Offline operation).',
                      days=int((time.time() - newest) // 86400))]
    return []

# 15: S/MIME and PGP at the gateway. Keys of own addresses or whole own domains (domain certificates between gateways), and of
# partners; a policy per domain or address: sign, encrypt (always or if a key is there), decrypt incoming mail. efa-outbound
# does the work with OpenSSL and GnuPG; it gets the keys as systemd credentials and starts again when they change. Off by default.
CRYPTO_DIR = ETC + '/eFa/crypto'
CRYPTO_KINDS = ('smime-own', 'smime-peer', 'pgp-own', 'pgp-peer')
CRYPTO_ID_RE = re.compile(r'^(@[a-z0-9.-]+\.[a-z]{2,}|[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,})$')


def _crypto_path(kind, key_id):
    if kind not in CRYPTO_KINDS or not CRYPTO_ID_RE.match(key_id):
        raise EfaError(f"Kind: {', '.join(CRYPTO_KINDS)}; id: an address or @domain.")
    return f"{CRYPTO_DIR}/{kind}-{key_id}.{'pem' if kind.startswith('smime') else 'asc'}"


def _crypto_own_scope(key_id):
    domain = key_id.lstrip('@').rpartition('@')[2] if '@' in key_id.lstrip('@') else key_id.lstrip('@')
    if domain not in _local_domains():
        raise EfaError('Own keys: an address or @domain of the own domains.')
    if identity_now and identity_now.get('domains') is not None and domain not in identity_now['domains']:
        raise EfaError('Not allowed: name one of your own domains.')


def _crypto_store(path, data):
    os.makedirs(CRYPTO_DIR, mode=0o700, exist_ok=True)
    fd = os.open(path + '.new', os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, 'wb') as f:
        f.write(data)
    os.replace(path + '.new', path)
    _safe(lambda: _platform().service_restart(OUTBOUND_UNIT, check=False), None)


def crypto_cert_info(pem):
    """Subject, end date and SHA-256 fingerprint of the first certificate of a PEM; EfaError for no certificate."""
    done = subprocess.run(['openssl', 'x509', '-noout', '-subject', '-enddate', '-fingerprint', '-sha256'], input=pem, capture_output=True, timeout=30)
    if done.returncode != 0:
        raise EfaError('No valid certificate (PEM).')
    text = done.stdout.decode('utf-8', 'replace')
    found = dict(line.split('=', 1) for line in text.splitlines() if '=' in line)
    return {'subject': found.get('subject', '').strip()[:200], 'until': found.get('notAfter', '').strip(),
            'fingerprint': found.get('sha256 Fingerprint', found.get('SHA256 Fingerprint', '')).strip()}


def crypto_status(_args):
    """15: the keys and certificates (never a private key), and the policy."""
    rows = []
    for path in sorted(glob.glob(CRYPTO_DIR + '/*')):
        name = os.path.basename(path)
        match = re.fullmatch(r'(smime-own|smime-peer|pgp-own|pgp-peer)-(.+)\.(pem|asc|json)', name)
        if not match:
            continue
        info = {'kind': match.group(1), 'id': match.group(2), 'hsm': match.group(3) == 'json'}
        if match.group(1).startswith('smime'):
            pem = (_json_read(path, {}).get('cert', '').encode() if match.group(3) == 'json' else open(path, 'rb').read())
            info.update(_safe(lambda pem=pem: crypto_cert_info(pem), {}))
        rows.append(info)
    return {'keys': rows, 'policy': _json_read(OUTBOUND_FILE, {}).get('crypto', {})}


def crypto_key_make(args):
    """15: a new own key. S/MIME: a key with a request (CSR) for a CA and, until its certificate comes, a self-signed one (enough
    between gateways that trust each other). PGP: an Ed25519 key with an encryption subkey; the public key is shown to hand on."""
    kind, key_id = (args.kind or '').strip(), (args.id or '').strip().lower()
    path = _crypto_path(f'{kind}-own', key_id)
    _crypto_own_scope(key_id)
    work = tempfile.mkdtemp(prefix='efa-crypto-')
    try:
        if kind == 'smime':
            name = key_id.lstrip('@')
            subject = f'/CN={name}'
            extension = f"subjectAltName={'email:' + key_id if not key_id.startswith('@') else 'DNS:' + name}"
            subprocess.run(['openssl', 'req', '-new', '-newkey', 'rsa:3072', '-nodes', '-subj', subject, '-addext', extension, '-addext',
                            'keyUsage=critical,digitalSignature,keyEncipherment', '-addext', 'extendedKeyUsage=emailProtection',
                            '-keyout', f'{work}/key.pem', '-out', f'{work}/req.pem'], check=True, capture_output=True, timeout=60)
            subprocess.run(['openssl', 'x509', '-req', '-in', f'{work}/req.pem', '-key', f'{work}/key.pem', '-days', '730', '-copy_extensions', 'copy',
                            '-out', f'{work}/cert.pem'], check=True, capture_output=True, timeout=60)
            pem = open(f'{work}/cert.pem', 'rb').read()
            _crypto_store(path, pem + open(f'{work}/key.pem', 'rb').read())
            result = {'id': key_id, 'request': open(f'{work}/req.pem').read(), 'certificate': pem.decode(), **crypto_cert_info(pem)}
        elif kind == 'pgp':
            uid = key_id if not key_id.startswith('@') else f'gateway{key_id}'
            gpg = ['gpg', '--homedir', work, '--batch', '--pinentry-mode', 'loopback', '--passphrase', '']
            subprocess.run(gpg + ['--quick-generate-key', uid, 'ed25519', 'sign', '3y'], check=True, capture_output=True, timeout=120)
            fpr = re.search(r'fpr:+([0-9A-F]{40})', subprocess.run(gpg + ['--with-colons', '--list-keys'], capture_output=True, text=True).stdout).group(1)
            subprocess.run(gpg + ['--quick-add-key', fpr, 'cv25519', 'encr', '3y'], check=True, capture_output=True, timeout=120)
            _crypto_store(path, subprocess.run(gpg + ['--armor', '--export-secret-keys', fpr], check=True, capture_output=True).stdout)
            result = {'id': key_id, 'fingerprint': fpr, 'public_key': subprocess.run(gpg + ['--armor', '--export', fpr], capture_output=True, text=True).stdout}
            subprocess.run(['gpgconf', '--homedir', work, '--kill', 'all'], capture_output=True)
        else:
            raise EfaError('Kind: smime or pgp.')
    except subprocess.CalledProcessError as err:
        raise EfaError(f'The key could not be made: {(err.stderr or b"").decode("utf-8", "replace")[-200:]}')
    finally:
        shutil.rmtree(work, ignore_errors=True)
    _audit(f'own {kind} key for {key_id} made by {_dmarc_who()}')
    return result


def crypto_import(args):
    """15: a certificate or public key of a partner (an address or @domain of a gateway), or the certificate a CA signed for an
    own key. Only public data: own private keys never come in through a form."""
    kind, key_id, data = (args.kind or '').strip(), (args.id or '').strip().lower(), (args.data or '').strip().encode()
    if kind == 'smime-own-cert':
        path = _crypto_path('smime-own', key_id)
        _crypto_own_scope(key_id)
        if not os.path.exists(path):
            raise EfaError('No own key for this id: crypto-key-make first.')
        own = open(path, 'rb').read()
        key = re.search(rb'-----BEGIN [A-Z ]*PRIVATE KEY-----.*?-----END [A-Z ]*PRIVATE KEY-----\s*', own, re.S).group(0)
        info = crypto_cert_info(data)
        modulus = lambda tool, blob: subprocess.run(['openssl', tool, '-noout', '-pubkey'] if tool == 'x509' else ['openssl', 'pkey', '-pubout'],
                                                     input=blob, capture_output=True).stdout
        if modulus('x509', data) != modulus('pkey', key):
            raise EfaError('This certificate is not for the own key of this id.')
        _crypto_store(path, data + b'\n' + key)
    elif kind == 'smime-peer':
        info = crypto_cert_info(data)
        _crypto_store(_crypto_path(kind, key_id), data + b'\n')
    elif kind == 'pgp-peer':
        shown = subprocess.run(['gpg', '--batch', '--with-colons', '--import-options', 'show-only', '--import'], input=data, capture_output=True, timeout=30)
        found = re.search(rb'^fpr:+([0-9A-F]{40}):', shown.stdout, re.M)
        if shown.returncode != 0 or not found or b'PRIVATE KEY' in data:
            raise EfaError('No public PGP key (armored).')
        info = {'fingerprint': found.group(1).decode()}
        _crypto_store(_crypto_path(kind, key_id), data + b'\n')
    else:
        raise EfaError('Kind: smime-peer, pgp-peer or smime-own-cert.')
    _audit(f"{kind} for {key_id} imported by {_dmarc_who()} ({info.get('fingerprint', '')[:40]})")
    return {'id': key_id, **info}


def crypto_remove(args):
    """15: a key or certificate out; the policy that needs it then refuses or skips as set."""
    _confirm(args)
    path = _crypto_path((args.kind or '').strip(), (args.id or '').strip().lower())
    if not os.path.exists(path):
        raise EfaError('No such key.')
    os.remove(path)
    _safe(lambda: _platform().service_restart(OUTBOUND_UNIT, check=False), None)
    _audit(f'{args.kind} key of {args.id} removed by {_dmarc_who()}')
    return crypto_status(None)


def crypto_policy_set(args):
    """15: sign the mail of an own domain or address (smime, pgp or off); encrypt to a domain or address (always, if-possible or off,
    with smime, pgp or auto); decrypt incoming mail of an own domain (on or off); keep the certificates of signed mail (harvest)."""
    scope, target, mode, kind = (args.scope or '').strip(), (args.target or '').strip().lower(), (args.mode or '').strip(), (args.kind or 'auto').strip()
    state = _json_read(OUTBOUND_FILE, {})
    crypto = {'sign': {}, 'encrypt': {}, 'decrypt': [], 'harvest': False, **state.get('crypto', {})}
    if scope == 'harvest':
        crypto['harvest'] = _on_off(mode)
    elif scope in ('sign', 'decrypt'):
        domain = target.rpartition('@')[2]
        if not (DOMAIN_RE.match(target) or SENDER_RE.match(target)) or domain not in _local_domains():
            raise EfaError('Target: an own domain or an address of it.')
        if identity_now and identity_now.get('domains') is not None and domain not in identity_now['domains']:
            raise EfaError('Not allowed: name one of your own domains.')
        if scope == 'sign':
            if mode not in ('smime', 'pgp', 'off'):
                raise EfaError('Sign: smime, pgp or off.')
            crypto['sign'].pop(target, None) if mode == 'off' else crypto['sign'].update({target: mode})
        else:
            if '@' in target:
                raise EfaError('Decrypt: a whole own domain.')
            crypto['decrypt'] = sorted(set(crypto['decrypt']) | {target}) if _on_off(mode) else [item for item in crypto['decrypt'] if item != target]
    elif scope == 'encrypt':
        if not (DOMAIN_RE.match(target) or SENDER_RE.match(target)):
            raise EfaError('Target: a recipient domain or address.')
        if mode not in ('always', 'if-possible', 'off') or kind not in ('smime', 'pgp', 'auto'):
            raise EfaError('Encrypt: always, if-possible or off; kind smime, pgp or auto.')
        crypto['encrypt'].pop(target, None) if mode == 'off' else crypto['encrypt'].update({target: {'mode': mode, 'kind': kind}})
    else:
        raise EfaError('Scope: sign, encrypt, decrypt or harvest.')
    state['crypto'] = crypto if (crypto['sign'] or crypto['encrypt'] or crypto['decrypt'] or crypto['harvest']) else {}
    _outbound_write(state)
    _audit(f'crypto policy {scope} {target} {mode} {kind if scope == "encrypt" else ""} by {_dmarc_who()}'.strip())
    return crypto_status(None)


def _crypto_job():
    """Daily: own certificates that end within 30 days, for crypto_notices."""
    ending = []
    for path in glob.glob(CRYPTO_DIR + '/smime-own-*.pem'):
        info = _safe(lambda path=path: crypto_cert_info(open(path, 'rb').read()), {})
        end = _safe(lambda info=info: time.mktime(time.strptime(info['until'].replace(' GMT', ''), '%b %d %H:%M:%S %Y')), None)
        if end and end - time.time() < 30 * 86400:
            ending.append({'id': os.path.basename(path)[10:-4], 'until': info['until'], 'at': os.stat(path).st_mtime})
    _notice_state_set('crypto_ending', ending)


def hosts_foreign(text, names, is_local):
    """The addresses /etc/hosts gives one of the names that are no address of this host (loopback counts as own)."""
    found = []
    for line in text.splitlines():
        fields = line.partition('#')[0].split()
        if len(fields) >= 2 and set(fields[1:]) & names and fields[0] not in found and not is_local(fields[0]):
            found.append(fields[0])
    return found


def _address_local(address):
    """An address of this host: binding a UDP socket to it works only then (nothing is sent, no program runs)."""
    try:
        ip = ipaddress.ip_address(address.split('%')[0])
    except ValueError:
        return True  # not an address: nothing to say about it
    if ip.is_loopback:
        return True
    try:
        with socket.socket(socket.AF_INET6 if ip.version == 6 else socket.AF_INET, socket.SOCK_DGRAM) as probe:
            probe.bind((str(ip), 0))
        return True
    except OSError:
        return False


def hosts_loopback_names(text, own):
    """Full names other than the own one on 127.0.0.0/8 or ::1: the resolver gives such a name to programs that ask for their full name."""
    found = []
    for line in text.splitlines():
        fields = line.partition('#')[0].split()
        if len(fields) >= 2 and (fields[0].startswith('127.') or fields[0] == '::1'):
            found += [name for name in fields[1:] if '.' in name and name.lower() != own and name not in found
                      and not re.match(r'^localhost[46]?(\.localdomain[46]?)?$', name)]
    return found


def hosts_notices():
    """The own host name in /etc/hosts on an address no interface has, or another full name on loopback. Only a warning."""
    # The configured name (myhostname, else the kernel's), never the full name of the resolver: that can ask DNS on every status call.
    fqdn = own_hostname()
    names = {fqdn, fqdn.split('.')[0], socket.gethostname()} - {'', 'localhost', 'localhost.localdomain'}
    text = '\n'.join(_read_lines(HOSTS))
    found = [_text('The host name {name} has the address {address} in /etc/hosts, which no interface of this host has: correct the line.',
                   name=fqdn, address=address) for address in hosts_foreign(text, names, _address_local)]
    found += [_text('In /etc/hosts the loopback address carries {name}, not the host name {own}: programs that ask for their full name '
                    'get the old one. Correct the line.', name=name, own=fqdn) for name in hosts_loopback_names(text, fqdn)]
    return found


def crypto_notices():
    """Own certificates that end within 30 days, as the daily job found them; one removed or replaced since no longer counts."""
    found = []
    for item in _json_read(NOTICE_STATE, {}).get('crypto_ending', []):
        changed = _safe(lambda item=item: os.stat(f'{CRYPTO_DIR}/smime-own-{item["id"]}.pem').st_mtime, None)
        if changed is not None and changed <= item.get('at', 0):
            found.append(_text('The own S/MIME certificate of {id} ends on {date}: a new one (S/MIME and PGP).', id=item['id'], date=item['until']))
    return found

# P3: keys in a hardware module (HSM) or token through PKCS#11, with the pkcs11 provider of OpenSSL 3 (package pkcs11-provider).
# For the signing key of the backups (Ed25519) and for own S/MIME keys; the private key never leaves the module. Software keys as
# before by default. DKIM and ARC sign in rspamd, which has no PKCS#11: their keys stay software keys (docs/hsm.md).
BACKUP_HSM = ETC + '/eFa/backup-hsm.json'
PKCS11_MODULE_DIRS = ('/usr/lib64/pkcs11/', '/usr/lib64/', '/usr/lib/pkcs11/', '/opt/')


def pkcs11_argv(spec):
    """The options of openssl for a key in a module, and its environment (the module of the provider)."""
    return ['-provider', 'pkcs11', '-provider', 'default'], {**os.environ, 'PKCS11_PROVIDER_MODULE': spec['module']}


class Pkcs11Ed25519:
    """An Ed25519 key in a module, with the two methods the backup signature uses: public_key() and sign()."""

    def __init__(self, spec):
        self.spec = spec

    def public_key(self):
        from cryptography.hazmat.primitives.asymmetric import ed25519
        return ed25519.Ed25519PublicKey.from_public_bytes(base64.b64decode(self.spec['public']))

    def sign(self, data):
        extra, env = pkcs11_argv(self.spec)
        with tempfile.NamedTemporaryFile(delete=False) as source:
            source.write(data)
        try:
            done = subprocess.run(['openssl', 'pkeyutl', '-sign', '-rawin', *extra, '-inkey', self.spec['uri'], '-in', source.name],
                                  capture_output=True, env=env, timeout=60)
        finally:
            os.remove(source.name)
        if done.returncode != 0 or len(done.stdout) != 64:
            raise EfaError('The hardware module did not sign: ' + done.stderr.decode('utf-8', 'replace')[-200:])
        self.public_key().verify(done.stdout, data)
        return done.stdout


def _pkcs11_spec(args, what):
    """The module and the key of a form; the URI with its PIN is a secret (stdin)."""
    module = (args.module or '').strip()
    if not module.startswith(PKCS11_MODULE_DIRS) or '..' in module or not module.endswith('.so') or not os.path.isfile(module):
        raise EfaError('The PKCS#11 module of the HSM, a .so under /usr/lib64 or /opt, such as /usr/lib64/pkcs11/opensc-pkcs11.so.')
    uri = _secrets(1, f'PKCS#11 URI of the {what}, with pin-value or pin-source')[0].strip()
    if not uri.startswith('pkcs11:') or 'type=private' not in uri:
        raise EfaError('A PKCS#11 URI of a private key: pkcs11:token=...;object=...;type=private;pin-value=...')
    if not shutil.which('openssl') or not glob.glob('/usr/lib64/ossl-modules/pkcs11.so'):
        raise EfaError('The pkcs11 provider of OpenSSL is missing: dnf install pkcs11-provider (AppStream).')
    return {'module': module, 'uri': uri}


def backup_hsm_set(args):
    """P3: the backups are signed by an Ed25519 key in an HSM (on), or by the software key as before (off)."""
    if not _on_off(args.mode):
        if os.path.exists(BACKUP_HSM):
            os.remove(BACKUP_HSM)
        _audit(f'backup signing key back to software by {_dmarc_who()}')
        return backup_key_show(None)
    spec = _pkcs11_spec(args, 'Ed25519 key')
    extra, env = pkcs11_argv(spec)
    public = subprocess.run(['openssl', 'pkey', *extra, '-in', spec['uri'], '-pubout', '-outform', 'DER'], capture_output=True, env=env, timeout=60)
    if public.returncode != 0 or len(public.stdout) != 44:
        raise EfaError('No Ed25519 key behind this URI: ' + public.stderr.decode('utf-8', 'replace')[-200:])
    spec['public'] = base64.b64encode(public.stdout[-32:]).decode()
    Pkcs11Ed25519(spec).sign(b'efa-next test')
    _json_write(BACKUP_HSM, spec, mode=0o600)
    _audit(f'backup signing key in the HSM {spec["module"]} set by {_dmarc_who()}')
    return backup_key_show(None)


def crypto_hsm_set(args):
    """P3: an own S/MIME key in an HSM: its certificate here, the key in the module; replaces a software key of the id."""
    key_id = (args.id or '').strip().lower()
    _crypto_own_scope(key_id)
    cert = (args.cert or '').strip().encode()
    info = crypto_cert_info(cert)
    spec = {**_pkcs11_spec(args, 'S/MIME key'), 'cert': cert.decode()}
    path = _crypto_path('smime-own', key_id)
    _crypto_store(path[:-4] + '.json', json.dumps(spec).encode())
    if os.path.exists(path):
        os.remove(path)
    _audit(f'S/MIME key of {key_id} in the HSM {spec["module"]} set by {_dmarc_who()}')
    return {'id': key_id, **info}

# 5v (b): VBA macros of Office files read by olevba (oletools, EPEL) in the sandboxed service efa-unlock: macros that start on
# opening (AutoExec) and suspicious calls (Shell, CreateObject, downloads) count as rspamd symbols, both together much more.
# Next to the own macro check of the content disarm, which only knows whether there are macros. Off by default.
OLE_FILE = ETC + '/eFa/ole.json'
OLE_LUA = RSPAMD_DIR + '/efa-ole.lua'
OLE_LOAD_LINE = "do local ok, err = pcall(dofile, '" + OLE_LUA + "'); if not ok then require('rspamd_logger').errx(rspamd_config, 'efa-ole: %s', err) end end -- efa-ole\n"
OLE_LUA_TEXT = r'''-- Written by efactl ole-set. Do not edit.
local rspamd_http = require 'rspamd_http'
local ucl = require 'ucl'
local office = {doc = true, dot = true, docm = true, dotm = true, xls = true, xlt = true, xlsm = true, xlsb = true, xltm = true, ppt = true,
  pps = true, pptm = true, ppsm = true, potm = true, rtf = true, mht = true}
local parent = rspamd_config:register_symbol({name = 'EFA_OLE', score = 0.0, group = 'efa_ole', description = 'VBA macros of Office files read by olevba',
  callback = function(task)
    local sent = 0
    for _, part in ipairs(task:get_parts() or {}) do
      local name = string.lower(tostring(part:get_filename() or ''))
      local ending = name:match('%.([%w]+)$')
      local size = part:get_length() or 0
      if sent < 3 and ending and office[ending] and size > 0 and size <= 10485760 then
        sent = sent + 1
        rspamd_http.request({task = task, url = 'http://127.0.0.1:8910/ole', method = 'POST', body = part:get_content(), timeout = 15,
          callback = function(err, code, reply)
            if err or code ~= 200 or not reply then return end
            local parser = ucl.parser()
            if not parser:parse_string(tostring(reply)) then return end
            local result = parser:get_object()
            local auto, suspicious = result.autoexec or {}, result.suspicious or {}
            if #auto > 0 and #suspicious > 0 then
              task:insert_result('EFA_OLE_AUTOEXEC_SUSPICIOUS', 1.0, name .. ':' .. table.concat(auto, ',') .. '/' .. table.concat(suspicious, ','))
            elseif #auto > 0 then
              task:insert_result('EFA_OLE_AUTOEXEC', 1.0, name .. ':' .. table.concat(auto, ','))
            elseif #suspicious > 0 then
              task:insert_result('EFA_OLE_SUSPICIOUS', 1.0, name .. ':' .. table.concat(suspicious, ','))
            end
          end})
      end
    end
  end})
rspamd_config:register_symbol({name = 'EFA_OLE_AUTOEXEC', score = 4.0, group = 'efa_ole', type = 'virtual', parent = parent, description = 'A macro that starts on opening'})
rspamd_config:register_symbol({name = 'EFA_OLE_SUSPICIOUS', score = 3.0, group = 'efa_ole', type = 'virtual', parent = parent, description = 'A macro with suspicious calls'})
rspamd_config:register_symbol({name = 'EFA_OLE_AUTOEXEC_SUSPICIOUS', score = 10.0, group = 'efa_ole', type = 'virtual', parent = parent,
                               description = 'A macro that starts on opening and makes suspicious calls'})
'''


def ole_status(_args):
    # The module efa-unlock imports, found without loading it, instead of rpm -q (about 50 ms per page).
    import importlib.util
    return {'enabled': bool(_json_read(OLE_FILE, {}).get('enabled')), 'oletools': importlib.util.find_spec('oletools') is not None,
            'service': _safe(lambda: _platform().service_is_active(UNLOCK_UNIT), False)}


def ole_set(args):
    """5v (b): VBA macros of Office files read by olevba (oletools from EPEL) and scored in rspamd."""
    on = _on_off(args.mode)
    platform_now = _platform()
    if on and not _safe(lambda: platform_now.package_installed('python3-oletools'), False):
        try:
            platform_now.package_install(['python3-oletools'])
        except Exception as err:  # the StepError of the platform layer
            raise EfaError(f'python3-oletools could not be installed (it comes from EPEL): {str(err)[:200]}')
    with open(RSPAMD_LOCAL_LUA) as f:
        before = f.read()
    text = re.sub(r'^.*-- efa-ole\n', '', before, flags=re.M)
    try:
        if on:
            platform_now.service_enable(UNLOCK_UNIT, start=True)
            _write(OLE_LUA, OLE_LUA_TEXT)
            text = text.rstrip('\n') + '\n' + OLE_LOAD_LINE
        _write(RSPAMD_LOCAL_LUA, text)
        if not _rspamd_config_ok():
            raise EfaError('rspamd rejected the macro check, nothing changed.')
        if not on and not _json_read(UNLOCK_FILE, {}).get('enabled'):
            platform_now.service_disable(UNLOCK_UNIT, stop=True)
    except EfaError:
        _write(RSPAMD_LOCAL_LUA, before)
        raise
    except Exception as err:  # the StepError of the platform layer
        _write(RSPAMD_LOCAL_LUA, before)
        raise EfaError(str(err))
    _json_write(OLE_FILE, {'enabled': on}, mode=0o644)
    _reload_rspamd()
    _audit(f'macro check with oletools {"on" if on else "off"} by {_dmarc_who()}')
    return ole_status(None)

def uq_set(args):
    """Store mail above the limit and viruses instead of rejecting them. Users release it themselves, by digest mail or login."""
    state, enabled = uq_state(), _on_off(args.mode)
    try:
        score, days = float((args.score or '').strip() or state['score']), int((args.days or '').strip() or state['days'])
    except ValueError:
        raise EfaError('Limit and days must be numbers.')
    if not 1 <= score <= 1000 or not 1 <= days <= 3650:
        raise EfaError('Limit: 1 to 1000. Days: 1 to 3650.')
    public_url = (args.public_url or '').strip().rstrip('/') or state['public_url']
    https_url(public_url)
    digest = (args.digest or '').strip() or ('on' if state['digest'] else 'off')
    self_release = (args.self_release or '').strip() or ('on' if state['self_release'] else 'off')
    state.update(enabled=enabled, score=score, days=days, digest=_on_off(digest), self_release=_on_off(self_release), public_url=public_url)
    if state['digest'] and not public_url:
        raise EfaError('The digest needs the public address of this server, for its links.')
    with open(RSPAMD_LOCAL_LUA) as f:
        before = f.read()
    text = before.replace(UQ_LOAD_LINE, '')
    if enabled:
        actions = open(ACTIONS_CONF).read() if os.path.exists(ACTIONS_CONF) else ''
        if ACTION_DISCARD not in actions:
            _write(ACTIONS_CONF, actions.rstrip('\n') + ('\n' if actions else '') + ACTION_DISCARD)
        os.makedirs(UQ_DIR, mode=0o700, exist_ok=True)
        shutil.chown(UQ_DIR, 'efa-mail', 'efa-mail')
        _write(UQ_LUA, UQ_LUA_TEXT % {'score': score})
        text = text.rstrip('\n') + '\n' + UQ_LOAD_LINE
    _write(RSPAMD_LOCAL_LUA, text)
    if not _rspamd_config_ok():
        _write(RSPAMD_LOCAL_LUA, before)
        raise EfaError('rspamd rejected the settings, nothing changed.')
    _json_write(UQ_FILE, state)
    # The writer may only reach a folder that exists when it starts.
    subprocess.run(['systemctl', 'try-restart', 'efa-maillog'], check=False, capture_output=True)
    subprocess.run(['systemctl', 'try-reload-or-restart', 'rspamd'], check=False, capture_output=True)
    return state


def uq_mailbox(identity):
    """The one address of a plain user: the email of the entry, or a user name that is an address."""
    if identity is None:
        return None
    address = identity.get('email') or identity['username']
    return address.lower() if '@' in address else ''


def uq_scope(identity):
    """A WHERE part that limits quarantine rows to the caller. Values travel as parameters."""
    if identity is None:
        return '', []
    if 'quarantine.view' not in identity['grants']:
        return ' AND r.rcpt = %s', [uq_mailbox(identity) or '-']
    scope = identity['grants']['quarantine.view']
    if scope is None:
        return '', []
    if not scope['domains']:
        return ' AND FALSE', []
    domains = sorted(scope['domains'])
    return ' AND (' + ' OR '.join(['r.rcpt LIKE %s'] * len(domains)) + ')', ['%@' + domain for domain in domains]


def uq_can_release(identity, malware, self_release):
    """A virus only by a super-admin. Whether a user may release alone is a setting, otherwise the user asks."""
    if identity is None:
        return True
    if malware:
        return 'quarantine.release_malware' in identity['grants']
    return 'quarantine.release' in identity['grants'] or self_release


def uq_list(args):
    """Mail in quarantine: yours as a user, that of your domains as an admin."""
    limit = (args.limit or '').strip() or '200'
    if not limit.isdigit() or not 1 <= int(limit) <= 1000:
        raise EfaError('Limit must be 1 to 1000.')
    scope, params = uq_scope(identity_now)
    needle = (args.text or '').strip()
    if needle:
        scope += ' AND (m.sender LIKE %s OR r.rcpt LIKE %s OR m.subject LIKE %s)'
        pattern = '%' + search_pattern(needle) + '%'
        params = [*params, pattern, pattern, pattern]
    rows = _admin_query('SELECT r.id, r.rcpt, r.state, CAST(m.ts AS CHAR) AS ts, m.sender, m.subject, m.score, m.malware, m.size FROM quarantine_rcpt r '
                        "JOIN quarantine_mail m ON m.id = r.mail_id WHERE r.state IN ('held', 'requested')" + scope + ' ORDER BY m.ts DESC, r.id DESC LIMIT %s', (*params, int(limit)))
    return {'mails': rows, 'self_release': uq_state()['self_release']}


def _uq_item(item_id, identity=None, states=('held', 'requested')):
    """One quarantine row the caller may touch. Someone else's mail looks like a missing one."""
    if not str(item_id).strip().isdigit():
        raise EfaError('Invalid ID.')
    scope, params = uq_scope(identity)
    rows = _admin_query('SELECT r.id, r.mail_id, r.rcpt, r.state, m.sender, m.subject, m.score, m.malware FROM quarantine_rcpt r '
                        'JOIN quarantine_mail m ON m.id = r.mail_id WHERE r.id = %s' + scope, (int(item_id), *params))
    if not rows or rows[0]['state'] not in states:
        raise EfaError('This mail is not in quarantine.')
    return rows[0]


def _uq_path(mail_id):
    if not re.fullmatch(r'[0-9a-f]{32}', mail_id):
        raise EfaError('Invalid mail.')
    return f'{UQ_DIR}/{mail_id}.eml'


# D3: held mail encrypted at rest, a key pair per tenant (efa_qcrypt). efa-maillog reads only the public keys from the web
# settings folder; the private keys are in a folder for root. Off after an upgrade, on for a new install.
UQ_KEY_DIR = ETC + '/eFa/quarantine-keys'
UQ_PUBLIC = WEB_DIR + '/quarantine-keys.json'


def _uq_privates():
    found = {}
    for path in glob.glob(UQ_KEY_DIR + '/*.pem'):
        with open(path, 'rb') as f:
            found[os.path.basename(path)[:-4]] = f.read()
    return found


def _uq_read(mail_id, limit=None):
    """A held mail as bytes, decrypted if it is sealed."""
    with open(_uq_path(mail_id), 'rb') as f:
        blob = f.read()
    try:
        data = _lib('efa_qcrypt').decrypt(blob, _uq_privates())
    except ValueError as err:
        raise EfaError(f'This held mail cannot be read: {err}.')
    return data[:limit] if limit else data


def uq_key_map(tenant_domains, publics):
    """What efa-maillog reads: the tenant of each domain and the public key of each tenant; 'global' for the rest."""
    return {'domains': {domain: str(tid) for tid, domains in tenant_domains.items() for domain in domains if str(tid) in publics},
            'keys': dict(sorted(publics.items()))}


def _uq_keys_refresh(force=False):
    """A key pair for every tenant and for global, and the map of the public keys. Only while the encryption is on, or the
    emergency copy (5n) needs them."""
    if not force and not _json_read(UQ_FILE, {}).get('encrypt'):
        return False
    os.makedirs(UQ_KEY_DIR, mode=0o700, exist_ok=True)
    tenants = _tenant_domains_or_none()
    publics = dict(_json_read(UQ_PUBLIC, {}).get('keys', {}))
    crypt = _lib('efa_qcrypt')
    for name in ['global'] + [str(tid) for tid in tenants]:
        path = f'{UQ_KEY_DIR}/{name}.pem'
        if not os.path.exists(path) or name not in publics:
            if os.path.exists(path):
                from cryptography.hazmat.primitives import serialization
                with open(path, 'rb') as f:
                    key = serialization.load_pem_private_key(f.read(), None)
                publics[name] = base64.b64encode(key.public_key().public_bytes(serialization.Encoding.Raw, serialization.PublicFormat.Raw)).decode()
            else:
                private, publics[name] = crypt.new_key_pair()
                fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
                with os.fdopen(fd, 'wb') as f:
                    f.write(private)
    wanted = uq_key_map(tenants, publics)
    if _json_read(UQ_PUBLIC, {}) != wanted:
        _json_write(UQ_PUBLIC, wanted, mode=0o640)
        shutil.chown(UQ_PUBLIC, 'root', 'efa-web')
    return True


def _uq_seal_old():
    """The held mails stored before the encryption was on, sealed for the tenants of their recipients."""
    keys = _json_read(UQ_PUBLIC, {})
    crypt, sealed = _lib('efa_qcrypt'), 0
    for path in glob.glob(UQ_DIR + '/*.eml'):
        with open(path, 'rb') as f:
            blob = f.read()
        if crypt.is_sealed(blob):
            continue
        rcpts = [row['rcpt'] for row in _admin_query('SELECT rcpt FROM quarantine_rcpt WHERE mail_id = %s', (os.path.basename(path)[:-4],))]
        tenants = {keys['domains'].get(rcpt.rpartition('@')[2], 'global') for rcpt in rcpts} or {'global'}
        fd = os.open(path + '.seal', os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, 'wb') as f:
            f.write(crypt.encrypt(blob, {tenant: keys['keys'][tenant] for tenant in tenants if tenant in keys['keys']}))
        shutil.chown(path + '.seal', *_owner_of(path))
        os.replace(path + '.seal', path)
        sealed += 1
    return sealed


def _owner_of(path):
    info = os.stat(path)
    return info.st_uid, info.st_gid


def uq_encrypt_set(args):
    """D3: held mail stored encrypted, with a key for each tenant; the mails held so far are sealed too. Off keeps them readable."""
    on = _on_off(args.mode)
    state = uq_state()
    state['encrypt'] = on
    _json_write(UQ_FILE, {**_json_read(UQ_FILE, {}), 'encrypt': on})
    sealed = 0
    if on:
        _uq_keys_refresh()
        sealed = _uq_seal_old()
    elif os.path.exists(UQ_PUBLIC):
        os.remove(UQ_PUBLIC)
    _audit(f'held mail encryption {"on" if on else "off"} by {_dmarc_who()}, {sealed} mails sealed')
    return {'encrypt': on, 'sealed_now': sealed,
            'note': 'The keys are in /etc/eFa/quarantine-keys (root) and in every backup; without them sealed mails cannot be read.'}


def _uq_mark(item, state, who):
    _admin_query('UPDATE quarantine_rcpt SET state = %s, changed = NOW(), changed_by = %s WHERE id = %s', (state, who[:120], item['id']))
    _event(f'quarantine_{state}', 'notice', user=who, rcpt=item['rcpt'], sender=item['sender'], malware=bool(item['malware']))
    left = _admin_query("SELECT 1 FROM quarantine_rcpt WHERE mail_id = %s AND state IN ('held', 'requested') LIMIT 1", (item['mail_id'],))
    if not left and os.path.exists(_uq_path(item['mail_id'])):
        os.remove(_uq_path(item['mail_id']))


def uq_show(args):
    """The headers of a mail in quarantine. The body stays closed: it may be harmful."""
    item = _uq_item(args.id, identity_now)
    head = _uq_read(item['mail_id'], 65536).decode('utf-8', 'replace')
    qid = _admin_query('SELECT qid FROM quarantine_mail WHERE id = %s', (item['mail_id'],))
    return {'id': item['id'], 'rcpt': item['rcpt'], 'verdict': _verdict_by_qid(qid[0]['qid'] if qid else ''),
            'headers': re.split(r'\r?\n\r?\n', head, maxsplit=1)[0][:20000]}


CONTENT_LIMIT = 100 * 1024
CONTENT_MORE = 1024 * 1024


class _HtmlText(html.parser.HTMLParser):
    """HTML as plain text: no scripts or styles, links as 'text [URL]', nothing loaded."""
    BLOCKS = {'p', 'div', 'br', 'tr', 'li', 'h1', 'h2', 'h3', 'h4', 'table', 'blockquote'}

    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.parts, self.skip, self.links = [], 0, []

    def handle_starttag(self, tag, attrs):
        if tag in ('script', 'style', 'head', 'title'):
            self.skip += 1
        elif tag in self.BLOCKS:
            self.parts.append('\n')
        if tag == 'a':
            self.links.append(dict(attrs).get('href') or '')

    def handle_endtag(self, tag):
        if tag in ('script', 'style', 'head', 'title'):
            self.skip = max(0, self.skip - 1)
        elif tag == 'a' and self.links:
            target = self.links.pop()
            if target and not target.startswith('#'):
                self.parts.append(f' [{target}]')

    def handle_data(self, data):
        if not self.skip:
            self.parts.append(data)


def html_text(markup):
    parser = _HtmlText()
    parser.feed(markup)
    parser.close()
    return re.sub(r'\n\s*\n+', '\n\n', re.sub(r'[ \t]+', ' ', ''.join(parser.parts))).strip()


def mail_text(raw, limit=CONTENT_LIMIT):
    """The readable text of a mail, never as HTML: the plain part, or the HTML part as text. Attachments only as a list."""
    message = email.parser.BytesParser(policy=email.policy.default).parsebytes(raw)
    body, source = message.get_body(preferencelist=('plain', 'html')), 'none'
    text = ''
    if body is not None:
        try:
            text = body.get_content()
        except (LookupError, UnicodeError, KeyError):
            text = (body.get_payload(decode=True) or b'').decode('utf-8', 'replace')
        source = body.get_content_type()
        if source == 'text/html':
            text = html_text(text)
    text = ''.join(ch if ch in '\n\t' or ch >= ' ' else ' ' for ch in text.replace('\r\n', '\n')).rstrip()
    attachments = []
    for part in message.iter_attachments():
        payload = part.get_payload(decode=True) or b''
        name = re.sub(r'[\x00-\x1f\x7f]', '', str(part.get_filename() or '(no name)'))[:200]
        attachments.append({'name': name, 'type': part.get_content_type(), 'size': len(payload)})
    return {'text': text[:limit], 'cut': len(text) > limit, 'source': source, 'attachments': attachments}


def uq_content(args):
    """The text of a held mail, to judge it before a release. Never shown as HTML, no attachment opens."""
    item = _uq_item(args.id, identity_now)
    raw = _uq_read(item['mail_id'], 64 * 1024 * 1024)
    return {'id': item['id'], 'rcpt': item['rcpt'], **mail_text(raw, CONTENT_MORE if (args.more or '').strip() == 'yes' else CONTENT_LIMIT)}


def quarantine_content(args):
    """The text of a mail in the quarantine of the mail queue."""
    queue_id = _held_id(args)
    done = subprocess.run(['postcat', '-bhq', queue_id], capture_output=True, check=True, timeout=60)
    return {'id': queue_id, **mail_text(done.stdout[:64 * 1024 * 1024], CONTENT_MORE if (args.more or '').strip() == 'yes' else CONTENT_LIMIT)}


def _uq_deliver(item):
    """Back to the mail server for this one recipient. Not through the filters again: they would stop it again."""
    done = subprocess.run(['sendmail', '-G', '-i', '-f', item['sender'] or '<>', '--', item['rcpt']], input=_uq_read(item['mail_id']), capture_output=True)
    if done.returncode != 0:
        raise EfaError('The mail server did not take the mail, it stays in quarantine.')


def uq_release(args):
    """Deliver a mail to its recipient."""
    item = _uq_item(args.id, identity_now)
    if not uq_can_release(identity_now, item['malware'], uq_state()['self_release']):
        raise EfaError('This mail can only be released by an admin. You can ask for it.')
    _uq_deliver(item)
    _uq_mark(item, 'released', _dmarc_who())
    return {'released': item['id']}


def _uq_request(item):
    if item['state'] != 'requested':
        _admin_query("UPDATE quarantine_rcpt SET state = 'requested', changed = NOW() WHERE id = %s", (item['id'],))
        _admin_notify('eFa-next: a release was requested', f"{item['rcpt']} asks for a mail from {item['sender']}: {item['subject']}\nSee Users' quarantine in the web interface.")


def uq_request(args):
    """Ask an admin to release a mail."""
    item = _uq_item(args.id, identity_now)
    _uq_request(item)
    return {'requested': item['id']}


def uq_delete(args):
    """Delete a mail for its recipient. Gone for good."""
    _confirm(args)
    item = _uq_item(args.id, identity_now)
    _uq_mark(item, 'deleted', _dmarc_who())
    return {'deleted': item['id']}


# Allowing or blocking a sender still makes sense after the mail was released.
UQ_SENDER_STATES = ('held', 'requested', 'released')


def _uq_sender(item, which):
    if not item['sender'] or not SENDER_RE.match(item['sender'].lower()):
        raise EfaError('This mail has no sender to put on a list.')
    return sender_rule_set(argparse.Namespace(list=which, action='add', sender=item['sender'], recipient=item['rcpt']))


def uq_sender(args):
    """Always allow or block the sender of a mail, for its recipient only."""
    which = args.list.strip()
    if which not in ('allow', 'block'):
        raise EfaError("List must be 'allow' or 'block'.")
    item = _uq_item(args.id, identity_now, UQ_SENDER_STATES)
    _uq_sender(item, which)
    return {'list': which, 'sender': item['sender'], 'recipient': item['rcpt']}


UQ_LINK_ACTIONS = {'release': 'Release this mail', 'request': 'Ask an admin to release this mail', 'allow': 'Always allow this sender',
                   'block': 'Always block this sender', 'login': 'Open my quarantine', 'send': 'Send this mail'}


def uq_link_make(purpose, rcpt, item_id=None, ref=None):
    token = secrets.token_urlsafe(32)
    _admin_query('INSERT INTO quarantine_links (token_sha256, purpose, rcpt, rcpt_id, ref, expires) VALUES (%s, %s, %s, %s, %s, NOW() + INTERVAL %s DAY)',
                 (hashlib.sha256(token.encode()).hexdigest(), purpose, rcpt, item_id, ref, UQ_LINK_DAYS))
    return token


def _uq_link():
    sha = hashlib.sha256(_secrets(1, 'Token')[0].strip().encode()).hexdigest()
    rows = _admin_query('SELECT purpose, rcpt, rcpt_id, ref FROM quarantine_links WHERE token_sha256 = %s AND used IS NULL AND expires > NOW()', (sha,))
    if not rows:
        raise EfaError('This link has expired or was already used.')
    return sha, rows[0]



def _send_note(link):
    """P1: the note of the held mail a send link is for, while it waits."""
    note = next((note for note in _hold_notes() if note['qid'] == link.get('ref') and note['kind'] == 'confirm' and note['sender'] == link['rcpt']), None)
    if note is None or time.time() >= note['until']:
        raise EfaError('This mail does not wait any more.')
    return note

def uq_link_view(_args):
    """What a link would do. Opening it changes nothing: mail scanners open links too."""
    _sha, link = _uq_link()
    view = {'purpose': link['purpose'], 'question': UQ_LINK_ACTIONS[link['purpose']], 'rcpt': link['rcpt']}
    if link['purpose'] == 'send':
        note = _send_note(link)
        view.update(to=', '.join(note['rcpts']), subject=note['subject'])
    elif link['rcpt_id']:
        item = _uq_item(link['rcpt_id'], None, UQ_SENDER_STATES if link['purpose'] in ('allow', 'block') else ('held', 'requested'))
        view.update(sender=item['sender'], subject=item['subject'])
    return view


def uq_link_use(_args):
    """Does what a link promised, once."""
    sha, link = _uq_link()
    purpose, result = link['purpose'], {'purpose': link['purpose'], 'done': UQ_LINK_ACTIONS[link['purpose']]}
    if purpose == 'send':
        # P1: the sender confirmed: the mail leaves the hold queue now.
        note = _send_note(link)
        if not _postsuper('-H', note['qid']):
            raise EfaError('The mail is not waiting any more.')
        os.remove(note['path'])
        _audit(f"P1: mail {note['qid']} of {note['sender']} confirmed by the sender")
    elif purpose == 'login':
        _admin_query("INSERT INTO users (username, role, email, source, groups_migrated) VALUES (%s, 'user', %s, 'link', 1) "
                     "ON DUPLICATE KEY UPDATE last_login = NOW()", (link['rcpt'], link['rcpt']))
        known = _load_identity(link['rcpt'], allow_disabled=True)
        if known['source'] == 'link' and not known['memberships']:
            _admin_query("INSERT IGNORE INTO user_groups (username, group_id) SELECT %s, id FROM efa_groups WHERE builtin = 'user'", (link['rcpt'],))
            known = _load_identity(link['rcpt'], allow_disabled=True)
        if known['role'] != 'user' or known['disabled']:
            raise EfaError('This address has a login of its own, please use that.')
        result.update(username=known['username'], role=known['role'])
    else:
        item = _uq_item(link['rcpt_id'], None, UQ_SENDER_STATES if purpose in ('allow', 'block') else ('held', 'requested'))
        if purpose == 'release':
            if not uq_can_release({'grants': {}}, item['malware'], uq_state()['self_release']):
                raise EfaError('This mail can only be released by an admin.')
            _uq_deliver(item)
            _uq_mark(item, 'released', 'digest link')
        elif purpose == 'request':
            _uq_request(item)
        else:
            _uq_sender(item, purpose)
    _admin_query('UPDATE quarantine_links SET used = NOW() WHERE token_sha256 = %s', (sha,))
    return result


def uq_digest_text(items, links, base, intro=''):
    """Text and HTML of a digest. Senders and subjects come from outside: everything is escaped."""
    lines, cells = ([intro, ''] if intro else []), []
    for item in items:
        actions = links.get(item['id'], {})
        lines.append(f"{item['ts']}  {item['sender'] or '(empty)'}  {item['subject']}")
        lines += [f'    {UQ_LINK_ACTIONS[name]}: {base}/q/{token}' for name, token in actions.items()]
        buttons = ' | '.join(f'<a href="{html.escape(f"{base}/q/{token}", quote=True)}">{html.escape(UQ_LINK_ACTIONS[name])}</a>' for name, token in actions.items())
        cells.append(f"<tr><td>{html.escape(str(item['ts']))}</td><td>{html.escape(item['sender'] or '(empty)')}</td><td>{html.escape(item['subject'] or '')}</td><td>{buttons}</td></tr>")
    lead = ''.join(f'<p>{html.escape(part)}</p>' for part in intro.split('\n') if part.strip())
    return '\n'.join(lines) + '\n', ('<!doctype html><html><body style="font-family:sans-serif"><h1 style="font-size:1.2em">Mail held for you</h1>'
                                     f'{lead}<table cellpadding="4">{"".join(cells)}</table></body></html>')


def _uq_digests(hour=None, layers=None):
    """Once a day: one mail per recipient about what is new. Links stay valid for some days and work once.
    With hour, only recipients whose domain sends at that hour; layers gives the text of each domain."""
    state = uq_state()
    rows = _admin_query("SELECT r.id, r.rcpt, CAST(m.ts AS CHAR) AS ts, m.sender, m.subject, m.malware FROM quarantine_rcpt r JOIN quarantine_mail m ON m.id = r.mail_id "
                        "WHERE r.state = 'held' AND r.digested = 0 ORDER BY r.rcpt, m.ts LIMIT 5000")
    recipients = {}
    for row in rows:
        recipients.setdefault(row['rcpt'], []).append(row)
    for rcpt, items in recipients.items():
        domain_values = (layers or {}).get(rcpt.rsplit('@', 1)[-1].lower(), {})
        if hour is not None and int(domain_values.get('digest_hour', ('0', 'global'))[0]) != hour:
            continue
        links = {}
        shown = items[:UQ_DIGEST_LINES]
        for item in shown:
            names = ['request'] if item['malware'] else (['release'] if state['self_release'] else ['request']) + ['allow', 'block']
            links[item['id']] = {name: uq_link_make(name, rcpt, item['id']) for name in names}
        plain, page = uq_digest_text(shown, links, state['public_url'], domain_values.get('digest_text', ('', 'global'))[0])
        brand = _brand_of_domain(rcpt.rsplit('@', 1)[-1])
        page = brand_html(page, brand)
        login = f"{state['public_url']}/q/{uq_link_make('login', rcpt)}"
        message = email.message.EmailMessage()
        message['To'] = rcpt
        message['Subject'] = f'{len(items)} mails held for you'
        message.set_content(f'{plain}\nOpen my quarantine: {login}\n')
        message.add_alternative(page.replace('</body>', f'<p><a href="{html.escape(login, quote=True)}">Open my quarantine</a></p></body>'), subtype='html')
        brand_logo(message, brand)
        subprocess.run(['sendmail', '-t'], input=message.as_bytes(), capture_output=True, check=False)
        _admin_query('UPDATE quarantine_rcpt SET digested = 1 WHERE id IN (' + ','.join(['%s'] * len(items)) + ')', [item['id'] for item in items])


def _uq_job(state_now, today):
    """Hourly: removes what is past its time, and sends the digest once a day."""
    settings_now = uq_state()
    rows, tenant_domains = _layer_rows(), _tenant_domains()
    layers = {domain: layer_effective(domain, tenant, rows, {}) for domain, tenant in layer_domains(rows, tenant_domains).items()}
    own_days = {domain: int(values['quarantine_days'][0]) for domain, values in layers.items() if values['quarantine_days'][1] != 'global'}
    if not own_days:
        old = _admin_query('SELECT id FROM quarantine_mail WHERE ts < NOW() - INTERVAL %s DAY', (settings_now['days'],))
    else:
        # Per recipient: its domain keeps its mail for its own days; a mail goes once no recipient is left.
        for domain, days in own_days.items():
            _admin_query('DELETE r FROM quarantine_rcpt r JOIN quarantine_mail m ON m.id = r.mail_id WHERE r.rcpt LIKE %s AND m.ts < NOW() - INTERVAL %s DAY',
                         ('%@' + domain.replace('_', '\\_'), days))
        expired = _admin_query('SELECT r.id, r.rcpt FROM quarantine_rcpt r JOIN quarantine_mail m ON m.id = r.mail_id WHERE m.ts < NOW() - INTERVAL %s DAY',
                               (settings_now['days'],))
        for row in expired:
            if row['rcpt'].rsplit('@', 1)[-1].lower() not in own_days:
                _admin_query('DELETE FROM quarantine_rcpt WHERE id = %s', (row['id'],))
        # A fresh mail can be in the table a moment before its recipients.
        old = _admin_query('SELECT m.id FROM quarantine_mail m WHERE m.ts < NOW() - INTERVAL 1 HOUR AND NOT EXISTS (SELECT 1 FROM quarantine_rcpt r WHERE r.mail_id = m.id)')
    for row in old:
        if os.path.exists(_uq_path(row['id'])):
            os.remove(_uq_path(row['id']))
        _admin_query('DELETE FROM quarantine_rcpt WHERE mail_id = %s', (row['id'],))
        _admin_query('DELETE FROM quarantine_mail WHERE id = %s', (row['id'],))
    _admin_query('DELETE FROM quarantine_links WHERE expires < NOW()')
    if not (settings_now['enabled'] and settings_now['digest']):
        return
    if not any(values['digest_hour'][1] != 'global' for values in layers.values()):
        if state_now.get('uq_digest_day') != today.isoformat():
            _uq_digests(None, layers)
            state_now['uq_digest_day'] = today.isoformat()
        return
    # Some domains send at their own hour: each hour once, for the recipients of that hour; global is hour 0.
    hour = datetime.datetime.now().hour
    slot = f'{today.isoformat()}-{hour}'
    if state_now.get('uq_digest_slot') != slot:
        _uq_digests(hour, layers)
        state_now['uq_digest_slot'] = slot
        state_now['uq_digest_day'] = today.isoformat()


def _efa_version():
    lines = _read_lines(ETC + '/eFa-Version')
    return lines[0].replace('eFa-', '', 1) if lines else 'unknown'


def events_on():
    """events.json is written only while something reads it: OTLP, the SIEM export or Wazuh."""
    return bool(_json_read(OTLP_FILE, {}).get('enabled') or _json_read(SIEM_FILE, {}).get('siem') or _json_read(WAZUH_FILE, {}).get('events'))


def events_marker():
    """Keeps the marker of the timer in line with the consumers."""
    if events_on():
        _write(EVENTS_MARKER, '')
    elif os.path.exists(EVENTS_MARKER):
        os.remove(EVENTS_MARKER)


def event_record(event, severity, now=None, **fields):
    """One line of events.json. The fields stay stable, consumers parse them."""
    if severity not in EVENT_SEVERITIES:
        severity = 'info'
    stamp = datetime.datetime.fromtimestamp(now if now is not None else time.time(), datetime.timezone.utc)
    record = {'timestamp': stamp.isoformat(timespec='milliseconds').replace('+00:00', 'Z'), 'event': event, 'severity': severity,
              'user': fields.pop('user', '') or '', 'src_ip': fields.pop('src_ip', '') or '', 'tenant': fields.pop('tenant', '') or '',
              'host': own_hostname(), 'efa_version': _efa_version()}
    record.update({key: value for key, value in fields.items() if value not in (None, '')})
    return record


def _event(event, severity='info', **fields):
    """Appends one event. A full disk or a missing folder must never stop the work itself."""
    if not events_on():
        return
    try:
        record = event_record(event, severity, **fields)
        if os.path.exists(EVE_SETTINGS) and os.path.isdir(EVE_DIR):
            fd = os.open(EVE_FILE, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o640)
            os.fchmod(fd, 0o640)  # the umask must not take the group read away
            with os.fdopen(fd, 'a') as f:
                f.write(json.dumps(eve_event_line(record), sort_keys=True, separators=(',', ':')) + '\n')
            if os.stat(EVE_FILE).st_uid == 0:
                shutil.chown(EVE_FILE, 'efa-mail', 'efa-mail')
        line = json.dumps(record, sort_keys=True) + '\n'
        fd = os.open(EVENTS_LOG, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o640)
        os.fchmod(fd, 0o640)  # the umask must not take the group read away
        with os.fdopen(fd, 'a') as f:
            f.write(line)
        try:
            # Wazuh reads it with its own group, if that exists.
            os.chown(EVENTS_LOG, 0, grp.getgrnam('wazuh').gr_gid)
        except KeyError:
            pass
    except OSError as err:
        print(f'events: {err}', file=sys.stderr)


LOGIN_RE = re.compile(r'efa-web login (ok|failed) (?:user (\S+) )?from (\S+)')
LINK_EVENT_RE = re.compile(r'efa-web link (blocked|unchecked) (\S+)')
DLP_EVENT_RE = re.compile(r'efa-outbound dlp (log|encrypt|hold|reject) rules=(\S+) from=(\S*) id=(\S+)')
LIMIT_EVENT_RE = re.compile(r'efa-outbound limit (log|throttle|hold|reject) (recipients|domains) who=(\S+) from=(\S*)')
BAN_RE = re.compile(r'\[([\w-]+)\] (Ban|Unban) ([0-9a-fA-F.:]+)')


def journal_events(lines):
    """Events from the journal lines of efa-web and Fail2Ban."""
    found = []
    for line in lines:
        login = LOGIN_RE.search(line)
        if login:
            found.append(('login_ok', 'info', {'user': login.group(2) or 'admin', 'src_ip': login.group(3)}) if login.group(1) == 'ok'
                         else ('login_failed', 'warning', {'user': login.group(2) or '', 'src_ip': login.group(3)}))
            continue
        limit = LIMIT_EVENT_RE.search(line)
        if limit:
            found.append(('sending_limit', 'warning', {'action': limit.group(1), 'limit': limit.group(2), 'who': limit.group(3), 'sender': limit.group(4)}))
            continue
        dlp = DLP_EVENT_RE.search(line)
        if dlp:
            found.append(('dlp_match', 'notice' if dlp.group(1) == 'log' else 'warning',
                          {'action': dlp.group(1), 'rules': dlp.group(2), 'sender': dlp.group(3), 'queue_id': dlp.group(4)}))
            continue
        link = LINK_EVENT_RE.search(line)
        if link:
            found.append((f'link_{link.group(1)}', 'warning' if link.group(1) == 'blocked' else 'notice', {'url': link.group(2)[:200]}))
            continue
        ban = BAN_RE.search(line)
        if ban:
            found.append(('ip_banned' if ban.group(2) == 'Ban' else 'ip_unbanned', 'notice', {'src_ip': ban.group(3), 'jail': ban.group(1)}))
    return found


def counter_events(before, after):
    """Summaries, not one event per mail: viruses and blocklist hits since the last run."""
    found = []
    delta = {name: after[name] - before.get(name, 0) for name in after if after[name] > before.get(name, 0)}
    if delta.get('CLAM_VIRUS'):
        found.append(('virus_found', 'warning', {'count': delta['CLAM_VIRUS']}))
    lists = {preset['id']: _rbl_hits(delta, preset['symbols']) for preset in RBL_PRESETS}
    lists = {name: hits for name, hits in lists.items() if hits}
    if lists:
        found.append(('rbl_hits', 'info', {'count': sum(lists.values()), 'lists': lists}))
    return found


def service_events(before, after):
    found = []
    for name in sorted(set(after) - set(before)):
        found.append(('service_down', 'error', {'service': name}))
    for name in sorted(set(before) - set(after)):
        found.append(('service_up', 'notice', {'service': name}))
    return found


def _events_collect(state):
    """What the other parts of the system know already: the journal, the health service, the rspamd counters."""
    command = ['journalctl', '-o', 'cat', '--show-cursor', '-u', 'efa-web', '-u', 'fail2ban', '-u', 'efa-outbound', '--no-pager']
    command += ['--after-cursor', state['cursor']] if state.get('cursor') else ['--since', '-2min']
    done = subprocess.run(command, capture_output=True, text=True, timeout=60)
    lines = done.stdout.splitlines()
    if lines and lines[-1].startswith('-- cursor: '):
        state['cursor'] = lines.pop()[len('-- cursor: '):]
    found = journal_events(lines)
    counters = _rbl_counters()
    if 'counters' in state:
        found += counter_events(state['counters'], counters)
    state['counters'] = counters
    try:
        down = sorted(status(None).get('down', []))
    except EfaError:
        down = state.get('down', [])
    found += service_events(state.get('down', []), down)
    state['down'] = down
    try:
        active = bayes_status(None)['active']
    except (EfaError, OSError, subprocess.SubprocessError):
        active = state.get('bayes_active')
    if 'bayes_active' in state and active is not None and active != state['bayes_active']:
        found.append(('bayes_active' if active else 'bayes_inactive', 'notice', {}))
    state['bayes_active'] = active
    for event, severity, fields in found:
        _event(event, severity, **fields)


def otlp_state():
    return {'enabled': False, 'endpoint': '', 'auth': 'none', 'header_name': 'X-API-Key', 'secret': '', 'headers': {}, 'verify': True,
            'ca_file': '', 'client_cert': '', 'client_key': '', 'signals': list(OTLP_SIGNALS), 'buffer_mb': 50, **_json_read(OTLP_FILE, {})}


def otlp_status(_args):
    """Export to an OpenTelemetry receiver over OTLP/HTTP with JSON. Off by default."""
    state, run = otlp_state(), _json_read(OTLP_DIR + '/state.json', {})
    shown = {key: value for key, value in state.items() if key not in ('secret', 'headers')}
    shown['secret'] = 'set' if state['secret'] else 'not set'
    shown['headers'] = {name: 'set' for name in state['headers']}
    buffered = sum(os.path.getsize(path) for path in glob.glob(OTLP_DIR + '/*.jsonl'))
    return {**shown, 'buffer_kb': buffered // 1024, 'dropped': run.get('dropped', 0), 'last_status': run.get('last_status', ''),
            'last_sent': run.get('last_sent', ''), 'next_try': run.get('next_try', '')}


def otlp_headers_parse(text):
    """'Name: value; Other: value'. Names as in HTTP, values without line breaks."""
    headers = {}
    for part in (text or '').split(';'):
        if not part.strip():
            continue
        name, separator, value = part.partition(':')
        name, value = name.strip(), value.strip()
        if not separator or not HEADER_NAME_RE.match(name) or not value or any(ch in value for ch in '\r\n\0'):
            raise EfaError('Extra headers: Name: value, separated by ;')
        headers[name] = value
    return headers


def _otlp_file(path):
    path = (path or '').strip()
    if path and (not path.startswith('/') or not os.path.isfile(path)):
        raise EfaError(f'Not a file: {path}')
    return path


def otlp_set(args):
    """Settings of the OTLP export. The token is asked twice and only readable by root. Empty fields keep the old value."""
    state = otlp_state()
    enabled = _on_off(args.mode)
    if not enabled:
        # Off keeps the other settings, so switching on again needs no new token.
        state['enabled'] = False
        _json_write(OTLP_FILE, state, mode=0o600)
        events_marker()
        return otlp_status(None)
    endpoint = (args.endpoint or '').strip().rstrip('/') or state['endpoint']
    https_url(endpoint) if endpoint.startswith('https://') else None
    if enabled and not re.fullmatch(r'https://[A-Za-z0-9.:\[\]-]+(:\d+)?(/[A-Za-z0-9._~/-]*)?', endpoint):
        raise EfaError('Endpoint: the base address of the receiver, like https://otel.example.org:4318')
    auth = (args.auth or '').strip() or state['auth']
    if auth not in OTLP_AUTH:
        raise EfaError('Auth: none, bearer or apikey.')
    header_name = (args.header_name or '').strip() or state['header_name']
    if not HEADER_NAME_RE.match(header_name):
        raise EfaError('Header name: letters, digits and dashes.')
    signals = [item for item in re.split(r'[\s,]+', (args.signals or '').strip()) if item] or state['signals']
    if any(item not in OTLP_SIGNALS for item in signals):
        raise EfaError('Signals: ' + ', '.join(OTLP_SIGNALS))
    first, second = _secrets(2, 'Token, then again')
    if first != second:
        raise EfaError(PASSWORD_DIFFER + ' Nothing was changed.')
    secret = first or state['secret']
    if auth != 'none' and not secret:
        raise EfaError('This kind of auth needs a token.')
    if (args.verify or '').strip() == 'off':
        raise EfaError('The certificate of the receiver is always checked; for an own CA give --ca_file.')
    verify = 'on'
    headers = otlp_headers_parse(args.headers) if (args.headers or '').strip() else state['headers']
    buffer_mb = (args.buffer_mb or '').strip() or str(state['buffer_mb'])
    if not buffer_mb.isdigit() or not 1 <= int(buffer_mb) <= 2000:
        raise EfaError('Buffer: 1 to 2000 MB.')
    state.update(enabled=enabled, endpoint=endpoint, auth=auth, header_name=header_name, secret=secret, headers=headers, signals=signals,
                 verify=_on_off(verify), ca_file=_otlp_file(args.ca_file) if (args.ca_file or '').strip() else state['ca_file'],
                 client_cert=_otlp_file(args.client_cert) if (args.client_cert or '').strip() else state['client_cert'],
                 client_key=_otlp_file(args.client_key) if (args.client_key or '').strip() else state['client_key'], buffer_mb=int(buffer_mb))
    _json_write(OTLP_FILE, state, mode=0o600)
    events_marker()
    return otlp_status(None)


def otlp_value(value):
    if isinstance(value, bool):
        return {'boolValue': value}
    if isinstance(value, int):
        return {'intValue': str(value)}
    if isinstance(value, float):
        return {'doubleValue': value}
    return {'stringValue': value if isinstance(value, str) else json.dumps(value, sort_keys=True)}


def otlp_attributes(values):
    return [{'key': key, 'value': otlp_value(value)} for key, value in sorted(values.items()) if value not in (None, '')]


def otlp_resource():
    return {'attributes': otlp_attributes({'service.name': 'efa-next', 'service.version': _efa_version(), 'host.name': own_hostname()})}


def otlp_log_record(event):
    """An event of events.json, or a mail log row, as an OTLP log record."""
    stamp = event.get('timestamp', '')
    try:
        nanos = int(datetime.datetime.fromisoformat(stamp.replace('Z', '+00:00')).timestamp() * 1e9)
    except ValueError:
        nanos = int(time.time() * 1e9)
    severity = event.get('severity', 'info')
    attributes = {key: value for key, value in event.items() if key not in ('timestamp', 'severity', 'host', 'efa_version')}
    if 'tenant' in attributes:
        attributes['efa.tenant'] = attributes.pop('tenant')
    return {'timeUnixNano': str(nanos), 'severityText': severity.upper(), 'severityNumber': OTLP_SEVERITY.get(severity, 9),
            'body': {'stringValue': event.get('event', '')}, 'attributes': otlp_attributes(attributes)}


METRIC_LINE_RE = re.compile(r'^([a-zA-Z_:][a-zA-Z0-9_:]*)(?:\{(.*)\})? (\S+)$')
METRIC_LABEL_RE = re.compile(r'(\w+)="((?:[^"\\]|\\.)*)"')


def otlp_metric_points(text, nanos):
    """The values of /metrics as OTLP gauge points, one JSON object per line in the buffer."""
    points = []
    for line in text.splitlines():
        match = METRIC_LINE_RE.match(line)
        if not match:
            continue
        labels = {key: value.replace('\\"', '"').replace('\\\\', '\\') for key, value in METRIC_LABEL_RE.findall(match.group(2) or '')}
        points.append({'name': match.group(1), 'point': {'timeUnixNano': str(nanos), 'asDouble': float(match.group(3)), 'attributes': otlp_attributes(labels)}})
    return points


def otlp_payloads(kind, items):
    """The JSON bodies for /v1/logs or /v1/metrics, in batches under the record and size limits."""
    batches, current, size = [], [], 0
    for item in items:
        length = len(json.dumps(item))
        if current and (len(current) >= OTLP_BATCH_RECORDS or size + length > OTLP_BATCH_BYTES):
            batches.append(current)
            current, size = [], 0
        current.append(item)
        size += length
    if current:
        batches.append(current)
    scope = {'name': 'efa-next', 'version': _efa_version()}
    bodies = []
    for batch in batches:
        if kind == 'logs':
            bodies.append((len(batch), {'resourceLogs': [{'resource': otlp_resource(), 'scopeLogs': [{'scope': scope, 'logRecords': batch}]}]}))
        else:
            metrics = {}
            for item in batch:
                metrics.setdefault(item['name'], []).append(item['point'])
            bodies.append((len(batch), {'resourceMetrics': [{'resource': otlp_resource(), 'scopeMetrics': [{'scope': scope, 'metrics': [
                {'name': name, 'gauge': {'dataPoints': points}} for name, points in metrics.items()]}]}]}))
    return bodies


def otlp_buffer_add(path, items, limit_bytes):
    """Appends to the disk buffer. Over its limit the oldest lines go, and their number is returned."""
    if items:
        with open(path, 'a') as f:
            f.writelines(json.dumps(item, sort_keys=True) + '\n' for item in items)
        os.chmod(path, 0o600)
    if not os.path.exists(path) or os.path.getsize(path) <= limit_bytes:
        return 0
    with open(path) as f:
        lines = f.readlines()
    kept, size = [], 0
    for line in reversed(lines):
        if size + len(line) > limit_bytes:
            break
        kept.append(line)
        size += len(line)
    with open(path + '.tmp', 'w') as f:
        f.writelines(reversed(kept))
    os.chmod(path + '.tmp', 0o600)
    os.replace(path + '.tmp', path)
    return len(lines) - len(kept)


def otlp_backoff(failures, retry_after=None):
    """Seconds until the next try: Retry-After if the receiver gave one, otherwise doubling from 30 s, at most an hour."""
    if retry_after and str(retry_after).strip().isdigit():
        return min(int(retry_after), OTLP_BACKOFF_MAX)
    return min(30 * 2 ** max(failures - 1, 0), OTLP_BACKOFF_MAX)


def _otlp_context(state):
    # S1: always checked, also for a setup of before that had it off; the dashboard says so (_system_notices).
    context = ssl.create_default_context(cafile=state['ca_file'] or None)
    if state['client_cert']:
        context.load_cert_chain(state['client_cert'], state['client_key'] or None)
    return context


def _otlp_post(state, kind, body):
    """One request. Returns (HTTP status or 0, Retry-After, text for the admin). Secrets never reach the text."""
    if not str(state['endpoint']).startswith('https://'):
        # S1: a token and mail log rows never go out in clear text, also not for a setup of before.
        return 0, None, 'Not sent: the receiver must be an https:// address (otlp-set).'
    headers = {'Content-Type': 'application/json', 'Content-Encoding': 'gzip', **state['headers']}
    if state['auth'] == 'bearer':
        headers['Authorization'] = 'Bearer ' + state['secret']
    elif state['auth'] == 'apikey':
        headers[state['header_name']] = state['secret']
    request = urllib.request.Request(f"{state['endpoint']}/v1/{kind}", data=gzip.compress(json.dumps(body).encode()), headers=headers, method='POST')
    try:
        context = _otlp_context(state) if state['endpoint'].startswith('https://') else None
        with urllib.request.urlopen(request, timeout=20, context=context) as reply:
            return reply.status, None, f'{reply.status} accepted'
    except urllib.error.HTTPError as err:
        text = {401: 'the receiver refused the token', 403: 'the receiver refused access', 404: 'wrong endpoint path',
                413: 'the batch is too big for the receiver', 429: 'the receiver asks to slow down'}.get(err.code, 'error at the receiver')
        return err.code, err.headers.get('Retry-After'), f'{err.code} {text}'
    except ssl.SSLError as err:
        return 0, None, f'TLS: {err.reason or err}'
    except (OSError, ValueError) as err:
        return 0, None, f'not reachable: {getattr(err, "reason", err)}'


def _otlp_flush(state, run, now):
    """Sends what waits in the buffer. On 429, 5xx or no answer it keeps the data and waits longer each time."""
    if run.get('next_try_epoch', 0) > now:
        return
    for kind, path in (('logs', OTLP_DIR + '/logs.jsonl'), ('metrics', OTLP_DIR + '/metrics.jsonl')):
        if not os.path.exists(path) or not os.path.getsize(path):
            continue
        with open(path) as f:
            items = [json.loads(line) for line in f if line.strip()]
        sent = 0
        for count, body in otlp_payloads(kind, items):
            code, retry_after, text = _otlp_post(state, kind, body)
            run['last_status'] = text
            if not 200 <= code < 300:
                run['failures'] = run.get('failures', 0) + 1
                run['next_try_epoch'] = now + otlp_backoff(run['failures'], retry_after)
                run['next_try'] = datetime.datetime.fromtimestamp(run['next_try_epoch']).strftime('%Y-%m-%d %H:%M:%S')
                break
            sent += count
            run.update(failures=0, next_try_epoch=0, next_try='', last_sent=time.strftime('%Y-%m-%d %H:%M:%S'))
        with open(path + '.tmp', 'w') as f:
            f.writelines(json.dumps(item, sort_keys=True) + '\n' for item in items[sent:])
        os.chmod(path + '.tmp', 0o600)
        os.replace(path + '.tmp', path)
        if run.get('failures'):
            return


def _events_new(state):
    """New lines of events.json since the last run. A rotated file starts from the beginning."""
    try:
        info = os.stat(EVENTS_LOG)
    except FileNotFoundError:
        return []
    offset = state.get('offset', 0) if state.get('inode') == info.st_ino and state.get('offset', 0) <= info.st_size else 0
    with open(EVENTS_LOG, 'rb') as f:
        f.seek(offset)
        data = f.read(8 * 1024 * 1024)
    complete = data[:data.rfind(b'\n') + 1]
    state.update(inode=info.st_ino, offset=offset + len(complete))
    events = []
    for line in complete.decode('utf-8', 'replace').splitlines():
        try:
            events.append(json.loads(line))
        except ValueError:
            continue
    return events


def _otlp_run(state, now):
    otlp = otlp_state()
    os.makedirs(OTLP_DIR, mode=0o700, exist_ok=True)
    run = _json_read(OTLP_DIR + '/state.json', {})
    logs = []
    if 'events' in otlp['signals']:
        logs += [otlp_log_record(event) for event in _events_new(state)]
    if 'maillog' in otlp['signals']:
        try:
            db = _maillog_db()
            try:
                with db.cursor() as cur:
                    cur.execute('SELECT id, CAST(ts AS CHAR) AS ts, qid, sender, rcpt, ip, action, score, subject, spf, dkim, dmarc FROM maillog '
                                'WHERE id > %s ORDER BY id LIMIT %s', (run.get('maillog_id', 0), OTLP_MAILLOG_ROWS))
                    rows = cur.fetchall()
            finally:
                db.close()
            if 'maillog_id' not in run:
                # The first run starts from now, not with the whole history.
                rows = []
                run['maillog_id'] = int(_admin_query('SELECT COALESCE(MAX(id), 0) AS n FROM maillog')[0]['n'])
            for row in rows:
                run['maillog_id'] = int(row['id'])
                stamp = datetime.datetime.fromisoformat(row.pop('ts')).astimezone(datetime.timezone.utc).isoformat().replace('+00:00', 'Z')
                logs.append(otlp_log_record({'timestamp': stamp, 'event': 'mail', 'severity': 'info', **{key: value for key, value in row.items() if key != 'id'}}))
        except (EfaError, OSError, ValueError) as err:
            print(f'otlp maillog: {err}', file=sys.stderr)
    limit = otlp['buffer_mb'] * 1024 * 1024
    dropped = otlp_buffer_add(OTLP_DIR + '/logs.jsonl', logs, limit)
    if 'metrics' in otlp['signals']:
        dropped += otlp_buffer_add(OTLP_DIR + '/metrics.jsonl', otlp_metric_points(metrics(None)['text'], int(now * 1e9)), limit)
    run['dropped'] = run.get('dropped', 0) + dropped
    _otlp_flush(otlp, run, now)
    _json_write(OTLP_DIR + '/state.json', run)


def events_run(_args):
    """Every minute: collects events and sends them on. Without a consumer it does nothing."""
    if not events_on():
        return {'events': 'off'}
    state = _json_read(EVENTS_STATE, {})
    _events_collect(state)
    if otlp_state()['enabled']:
        _otlp_run(state, time.time())
    _json_write(EVENTS_STATE, state)
    return {'events': 'done'}


def otlp_test(_args):
    """Sends one test record now and shows how the receiver answered."""
    state = otlp_state()
    if not state['endpoint']:
        raise EfaError('Set the endpoint first.')
    record = otlp_log_record(event_record('otlp_test', 'info', user=_dmarc_who()))
    code, _retry, text = _otlp_post(state, 'logs', otlp_payloads('logs', [record])[0][1])
    return {'http_status': code, 'result': text, 'ok': 200 <= code < 300}


def wazuh_settings():
    return {'events': False, 'manager': '', 'port': 1514, 'enrollment_port': 1515, 'agent_name': '', 'groups': '', 'active_response': False,
            **_json_read(WAZUH_FILE, {})}


def wazuh_block(settings_now):
    """The part of ossec.conf that eFa-next owns. FIM checks hashes only: report_changes stays off, so no file content leaves the host."""
    lines = [WAZUH_BEGIN, '<ossec_config>']
    if settings_now['events']:
        lines += ['  <localfile>', '    <log_format>json</log_format>', f'    <location>{EVENTS_LOG}</location>', '  </localfile>']
    lines += ['  <localfile>', '    <log_format>syslog</log_format>', '    <location>/var/log/maillog</location>', '  </localfile>',
              '  <syscheck>', '    <directories check_all="yes" report_changes="no">/etc/eFa,/etc/postfix,/etc/rspamd/local.d,/etc/nginx</directories>', '  </syscheck>',
              '  <sca>', '    <policies>', f'      <policy>{WAZUH_SCA}</policy>', '    </policies>', '  </sca>']
    if not settings_now['active_response']:
        # The manager could otherwise change firewalld at any time, see docs/WAZUH.md.
        lines += ['  <active-response>', '    <disabled>yes</disabled>', '  </active-response>']
    return '\n'.join(lines + ['</ossec_config>', WAZUH_END]) + '\n'


def wazuh_conf_update(conf, settings_now):
    """ossec.conf with the eFa-next block at the end, and the manager in the client section. Everything else stays as it is."""
    if '<client>' not in conf or '</client>' not in conf:
        raise EfaError('ossec.conf has no client section, nothing was changed.')
    conf = re.sub(re.escape(WAZUH_BEGIN) + r'.*?' + re.escape(WAZUH_END) + r'\n?', '', conf, flags=re.S)
    if settings_now['manager']:
        start, end = conf.index('<client>'), conf.index('</client>') + len('</client>')
        client = conf[start:end]
        client = re.sub(r'<address>[^<]*</address>', f"<address>{settings_now['manager']}</address>", client, count=1)
        client = re.sub(r'<port>[^<]*</port>', f"<port>{settings_now['port']}</port>", client, count=1)
        enrollment = (f"<enrollment>\n      <enabled>yes</enabled>\n      <port>{settings_now['enrollment_port']}</port>\n"
                      + (f"      <agent_name>{settings_now['agent_name']}</agent_name>\n" if settings_now['agent_name'] else '')
                      + (f"      <groups>{settings_now['groups']}</groups>\n" if settings_now['groups'] else '')
                      + f"      <authorization_pass_path>{WAZUH_AUTHD_PASS}</authorization_pass_path>\n    </enrollment>")
        if '<enrollment>' in client:
            client = re.sub(r'<enrollment>.*?</enrollment>', lambda found: enrollment, client, count=1, flags=re.S)
        else:
            client = client.replace('</client>', f'  {enrollment}\n  </client>', 1)
        conf = conf[:start] + client + conf[end:]
    return conf.rstrip('\n') + '\n' + wazuh_block(settings_now)


def wazuh_foreign(installed, state):
    """An agent that eFa-next did not install or take over: eFa-next only reads its status."""
    return bool(installed) and not state.get('managed')


def _wazuh_guard(args=None):
    """Stops before anything touches an agent of someone else. Taking it over needs --adopt yes and the confirmation."""
    state = wazuh_settings()
    if not wazuh_foreign(_wazuh_installed(), state):
        return state
    if args is not None and (getattr(args, 'adopt', '') or '').strip() == 'yes':
        _confirm(args)
        state['managed'] = True
        return state
    raise EfaError('A Wazuh agent is installed that eFa-next did not install. eFa-next does not change it; '
                   'to let eFa-next manage it, run wazuh-config with --adopt yes and confirm.')


def _wazuh_installed():
    done = subprocess.run(['rpm', '-q', '--qf', '%{VERSION}-%{RELEASE}', 'wazuh-agent'], capture_output=True, text=True)
    return done.stdout.strip() if done.returncode == 0 else ''


def wazuh_last_error(lines):
    """Why the agent is not connected, from the end of its log: the manager names it (an unknown group, a wrong password)."""
    for line in reversed(lines[-400:]):
        if 'wazuh-agentd: INFO: (4102)' in line or 'Connected to the server' in line:
            return ''
        if 'wazuh-agentd: ERROR:' in line:
            return line.split('ERROR:', 1)[1].strip()[:200]
    return ''


def wazuh_status(_args):
    """The Wazuh agent: installed version, running, connected to the manager, last keep-alive. The agent itself runs as root."""
    version = _wazuh_installed()
    agent = {key: value.strip("'") for key, _sep, value in (line.partition('=') for line in _read_lines(WAZUH_STATE)) if value}
    conf = open(WAZUH_CONF).read() if os.path.exists(WAZUH_CONF) else ''
    address = re.search(r'<client>.*?<address>([^<]*)</address>', conf, re.S)
    state = wazuh_settings()
    foreign = wazuh_foreign(version, state)
    return {'installed': version or 'not present', 'managed_by_efa': bool(version) and not foreign,
            **({'warning': 'Agent present, not managed by eFa-next: only its status is shown.'} if foreign else {}), 'running': bool(version) and subprocess.run(['systemctl', 'is-active', '--quiet', 'wazuh-agent']).returncode == 0,
            'connection': agent.get('status', 'unknown') if version else 'not present', 'last_keepalive': agent.get('last_keepalive', ''),
            **({'last_error': wazuh_last_error(_read_lines(WAZUH_LOG))} if version and agent.get('status') != 'connected' else {}),
            'manager': address.group(1) if address else '', 'efa_block': WAZUH_BEGIN in conf, 'repo': os.path.exists(WAZUH_REPO),
            'events': state['events'], 'active_response': state['active_response'], 'enrollment_password': 'set' if os.path.exists(WAZUH_AUTHD_PASS) else 'not set',
            'note': 'The Wazuh agent is a third-party program and runs as root.'}


def _wazuh_repo():
    """The repository of Wazuh, off by default: only the buttons of eFa-next install or update from it, never dnf-automatic."""
    with urllib.request.urlopen(WAZUH_KEY_URL, timeout=30) as reply:
        key = reply.read()
    shown = subprocess.run(['gpg', '--show-keys', '--with-colons'], input=key, capture_output=True, check=False).stdout.decode()
    if f':{WAZUH_KEY_FINGERPRINT}:' not in shown:
        raise EfaError('The Wazuh signing key has an unexpected fingerprint, nothing was installed.')
    fd, path = tempfile.mkstemp(suffix='.asc')
    with os.fdopen(fd, 'wb') as f:
        f.write(key)
    try:
        subprocess.run(['rpm', '--import', path], check=True, capture_output=True)
    finally:
        os.remove(path)
    _write(WAZUH_REPO, '[wazuh]\nname=Wazuh repository\nbaseurl=https://packages.wazuh.com/4.x/yum/\ngpgcheck=1\n'
                       f'gpgkey={WAZUH_KEY_URL}\nenabled=0\nprotect=1\n')


def wazuh_script_problems(scripts):
    """Lines of the package scripts that would touch the firewall."""
    return [line.strip() for line in scripts.splitlines() if WAZUH_FORBIDDEN_SCRIPT.search(line)]


def _wazuh_fetch(version):
    """Downloads the package, checks its signature and its scripts. Returns the file, or stops before anything is installed."""
    if version and not re.fullmatch(r'\d+\.\d+\.\d+(-\d+)?', version):
        raise EfaError('Version like 4.14.10 or 4.14.10-1.')
    _wazuh_repo()
    folder = tempfile.mkdtemp(prefix='efa-wazuh-')
    name = 'wazuh-agent' + (f'-{version}' if version else '')
    try:
        # The repository has the packages of all architectures under one name.
        subprocess.run(['dnf', '-q', '--enablerepo=wazuh', 'download', '--arch', os.uname().machine, '--destdir', folder, name],
                       check=True, capture_output=True, timeout=600)
        files = glob.glob(folder + '/wazuh-agent-*.rpm')
        if len(files) != 1:
            raise EfaError('The download did not give one package.')
        signature = subprocess.run(['rpm', '-K', files[0]], capture_output=True, text=True)
        if signature.returncode != 0 or 'signatures OK' not in signature.stdout:
            raise EfaError('The package signature does not check out, nothing was installed.')
        scripts = subprocess.run(['rpm', '-qp', '--scripts', files[0]], capture_output=True, text=True, check=True).stdout
        problems = wazuh_script_problems(scripts)
        if problems:
            raise EfaError('The package scripts would touch the firewall, nothing was installed: ' + '; '.join(problems[:3]))
    except BaseException:
        shutil.rmtree(folder, ignore_errors=True)
        raise
    return files[0]


def wazuh_check(args):
    """Downloads the agent package and checks it, without installing it."""
    path = _wazuh_fetch((args.version or '').strip())
    try:
        name = subprocess.run(['rpm', '-qp', path], capture_output=True, text=True, check=True).stdout.strip()
    finally:
        shutil.rmtree(os.path.dirname(path), ignore_errors=True)
    return {'package': name, 'signature': 'ok', 'scripts': 'do not touch the firewall'}


def wazuh_install(args):
    """Install the Wazuh agent from the official repository. It starts only after wazuh-config."""
    _confirm(args)
    if _wazuh_installed():
        raise EfaError('The Wazuh agent is installed already.')
    path = _wazuh_fetch((args.version or '').strip())
    try:
        subprocess.run(['dnf', '-y', 'install', path], check=True, capture_output=True, timeout=900)
    finally:
        shutil.rmtree(os.path.dirname(path), ignore_errors=True)
    _json_write(WAZUH_FILE, {**wazuh_settings(), 'managed': True})
    subprocess.run(['systemctl', 'disable', '--now', 'wazuh-agent'], check=False, capture_output=True)
    return wazuh_status(None)


def wazuh_update(args):
    """Update the Wazuh agent, only with this button. The same checks as for the install."""
    _confirm(args)
    if not _wazuh_installed():
        raise EfaError('The Wazuh agent is not installed.')
    _wazuh_guard()
    path = _wazuh_fetch((args.version or '').strip())
    try:
        subprocess.run(['dnf', '-y', 'upgrade', path], check=True, capture_output=True, timeout=900)
    finally:
        shutil.rmtree(os.path.dirname(path), ignore_errors=True)
    return wazuh_status(None)


def wazuh_config(args):
    """Manager, ports, name, groups and the eFa-next block of ossec.conf. The enrollment password is asked twice, readable only by root and the agent."""
    state = _wazuh_guard(args) if os.path.exists(WAZUH_CONF) else wazuh_settings()
    manager = (args.manager or '').strip() or state['manager']
    if manager:
        try:
            ipaddress.ip_address(manager)
        except ValueError:
            if not DOMAIN_RE.match(manager):
                raise EfaError('Manager: a host name or an IP address.')
    ports = {}
    for key in ('port', 'enrollment_port'):
        value = (getattr(args, key) or '').strip() or str(state[key])
        if not value.isdigit() or not 1 <= int(value) <= 65535:
            raise EfaError('Ports: 1 to 65535.')
        ports[key] = int(value)
    name = (args.agent_name or '').strip() or state['agent_name']
    groups = (args.groups or '').strip() or state['groups']
    if (name and not WAZUH_NAME_RE.match(name)) or (groups and not re.fullmatch(r'[A-Za-z0-9_-]+(,[A-Za-z0-9_-]+)*', groups)):
        raise EfaError('Agent name: letters, digits, . _ -. Groups: separated by commas.')
    state.update(manager=manager, agent_name=name, groups=groups, events=_on_off((args.events or '').strip() or ('on' if state['events'] else 'off')),
                 active_response=_on_off((args.active_response or '').strip() or ('on' if state['active_response'] else 'off')), **ports)
    first, second = _secrets(2, 'Enrollment password, then again')
    if first != second:
        raise EfaError(PASSWORD_DIFFER + ' Nothing was changed.')
    if not os.path.exists(WAZUH_CONF):
        raise EfaError('The Wazuh agent is not installed.')
    with open(WAZUH_CONF) as f:
        conf = f.read()
    new = wazuh_conf_update(conf, state)
    real = WAZUH_CONF == '/var/ossec/etc/ossec.conf'
    if first and real:
        fd = os.open(WAZUH_AUTHD_PASS + '.tmp', os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o640)
        os.fchmod(fd, 0o640)  # the umask must not take the group read away
        with os.fdopen(fd, 'w') as f:
            f.write(first + '\n')
        shutil.chown(WAZUH_AUTHD_PASS + '.tmp', 'root', 'wazuh')
        os.replace(WAZUH_AUTHD_PASS + '.tmp', WAZUH_AUTHD_PASS)
    with open(WAZUH_CONF + '.efa-tmp', 'w') as f:
        f.write(new)
    shutil.copymode(WAZUH_CONF, WAZUH_CONF + '.efa-tmp')
    if real:
        shutil.chown(WAZUH_CONF + '.efa-tmp', 'root', 'wazuh')
    os.replace(WAZUH_CONF + '.efa-tmp', WAZUH_CONF)
    _json_write(WAZUH_FILE, state)
    events_marker()
    if real and manager:
        subprocess.run(['systemctl', 'enable', '--now', 'wazuh-agent'], check=False, capture_output=True)
        subprocess.run(['systemctl', 'restart', 'wazuh-agent'], check=False, capture_output=True)
    return {**wazuh_status(None), 'written': WAZUH_CONF}


def wazuh_service(args):
    """Start, stop or restart the Wazuh agent."""
    action = args.action.strip()
    if action not in ('start', 'stop', 'restart'):
        raise EfaError("Action must be 'start', 'stop' or 'restart'.")
    if not _wazuh_installed():
        raise EfaError('The Wazuh agent is not installed.')
    _wazuh_guard()
    subprocess.run(['systemctl', action, 'wazuh-agent'], check=True, capture_output=True, timeout=120)
    return wazuh_status(None)


def wazuh_remove(args):
    """Stop and remove the agent and the eFa block. The repository goes only if asked."""
    _confirm(args)
    _wazuh_guard()
    if _wazuh_installed():
        subprocess.run(['systemctl', 'disable', '--now', 'wazuh-agent'], check=False, capture_output=True)
        subprocess.run(['dnf', '-y', 'remove', 'wazuh-agent'], check=True, capture_output=True, timeout=600)
    for path in glob.glob('/var/ossec/etc/ossec.conf*'):
        with open(path) as f:
            text = f.read()
        if WAZUH_BEGIN in text:
            _write(path, re.sub(re.escape(WAZUH_BEGIN) + r'.*?' + re.escape(WAZUH_END) + r'\n?', '', text, flags=re.S))
    if (args.repo or '').strip() == 'yes' and os.path.exists(WAZUH_REPO):
        os.remove(WAZUH_REPO)
    _json_write(WAZUH_FILE, {**wazuh_settings(), 'events': False, 'managed': False})
    events_marker()
    return wazuh_status(None)


def _report_settings():
    return _json_read(REPORT_FILE, {'daily': False})


def sign_rows(day, fields):
    """Redis hash fields kind|domain|selector to rows for sign_daily. Odd fields are skipped, they come from rspamd."""
    rows = []
    for field, count in fields.items():
        parts = field.split('|')
        if len(parts) == 3 and parts[0] in ('dkim', 'arc', 'unsigned') and DOMAIN_RE.match(parts[1]) and str(count).isdigit():
            rows.append((day, parts[0], parts[1][:253], parts[2][:64], int(count)))
    return rows


def _sign_counts_store(today):
    """The signing and sealing counters of the last days, from Redis into MariaDB. Today is overwritten each hour."""
    rows = []
    for offset in range(3):
        day = (today - datetime.timedelta(days=offset)).isoformat()
        done = subprocess.run(['redis-cli', '--raw', 'HGETALL', SIGN_KEY + day], capture_output=True, text=True)
        values = done.stdout.splitlines() if done.returncode == 0 else []
        rows += sign_rows(day, dict(zip(values[::2], values[1::2])))
    if not rows:
        return 0
    db = _admin_db()
    try:
        with db.cursor() as cur:
            cur.executemany('REPLACE INTO sign_daily (day, kind, domain, selector, n) VALUES (%s, %s, %s, %s, %s)', rows)
    finally:
        db.close()
    return len(rows)


def mailreport_run(_args):
    """Hourly job: reads only the new log lines. The first run of a day also mails yesterday, if that is on."""
    state = _json_read(REPORT_STATE, {'inode': None, 'offset': 0, 'pending': {}, 'last_daily': None})
    today = _today()
    info = os.stat(REPORT_LOG)
    # shortcut: lines between the last run and a log rotation are lost, at most an hour of one day each week; read the rotated file if that ever matters.
    offset = state['offset'] if state['inode'] == info.st_ino and state['offset'] <= info.st_size else 0
    days, pending, new_lines = {}, state['pending'], []
    with open(REPORT_LOG, 'rb') as log:
        log.seek(offset)
        for raw in log:
            if not raw.endswith(b'\n'):
                break
            offset += len(raw)
            line = raw.decode('utf-8', 'replace')
            new_lines.append(line)
            match = REPORT_LINE.match(line)
            if match and match.group(1) in REPORT_MONTHS:
                date = _report_day(match.group(1), match.group(2), today)
                if date not in days:
                    days[date] = _report_read(date) or _report_empty()
                _report_line(days, pending, line, today)
    os.makedirs(REPORT_DIR, mode=0o750, exist_ok=True)
    today_text = today.isoformat()
    if today_text not in days:
        days[today_text] = _report_read(today_text) or _report_empty()
    days[today_text]['queue'] = _report_queue()
    for date, agg in days.items():
        _report_trim(agg)
        _json_write(f'{REPORT_DIR}/{date}.json', agg)
    for path in glob.glob(REPORT_DIR + '/*.json'):
        if os.path.basename(path)[:-5] < (today - datetime.timedelta(days=REPORT_DAYS)).isoformat():
            os.remove(path)
    # Mail that is still in the queue after this many entries is unusual, its size only feeds the delivered bytes.
    state.update(inode=info.st_ino, offset=offset, pending=dict(list(pending.items())[-REPORT_PENDING:]))
    yesterday = (today - datetime.timedelta(days=1)).isoformat()
    # Tenants and directory groups change without anyone touching the rules.
    try:
        if _rules() or _layer_rows():
            _rules_apply()
        _tenant_limits_job(today)
        _headers_job(today, state)
        try:
            if bec_state()['enabled'] and bec_state()['scores']['young_domain']:
                _rdap_refresh()
        except (EfaError, OSError, ValueError) as err:
            print(f'RDAP list: {err}', file=sys.stderr)
        try:
            state_ml = ml_state()
            if state_ml['enabled'] and len(_ml_samples()) > state_ml['samples']:
                ml_train()
        except (EfaError, OSError) as err:
            print(f'own model: {err}', file=sys.stderr)
        try:
            _queue_job(new_lines)
        except (EfaError, OSError, ValueError) as err:
            print(f'queue: {err}', file=sys.stderr)
        try:
            _phish_job()
        except (EfaError, OSError) as err:
            print(f'phishing reports: {err}', file=sys.stderr)
        try:
            _cdr_job()
        except OSError as err:
            print(f'disarm originals: {err}', file=sys.stderr)
        try:
            _strict_job(today)
        except (EfaError, OSError) as err:
            print(f'strict audit log: {err}', file=sys.stderr)
        try:
            if feeds_run().get('changed'):
                retro_run()
        except Exception as err:  # also pymysql errors: the other jobs go on
            print(f'threat feeds: {err}', file=sys.stderr)
        try:
            _domain_check_job()
        except (EfaError, OSError, ValueError) as err:
            print(f'domain check: {err}', file=sys.stderr)
        try:
            _trap_job()
        except Exception as err:  # also pymysql errors: the other jobs go on
            print(f'spam traps: {err}', file=sys.stderr)
        try:
            signature_sync()
        except (EfaError, OSError, subprocess.TimeoutExpired) as err:
            print(f'AD signatures: {err}', file=sys.stderr)
        if state.get('dkim_selector_day') != today.isoformat():
            try:
                _dkim_key_bits_job()
                state['dkim_selector_day'] = today.isoformat()
            except Exception as err:  # no database tables yet
                print(f'dkim selectors: {err}', file=sys.stderr)
        try:
            _lookalike_job(state)
        except (EfaError, OSError, ValueError) as err:
            print(f'lookalike watch: {err}', file=sys.stderr)
        if state.get('emergency_day') != today.isoformat():
            try:
                _emergency_job()
                state['emergency_day'] = today.isoformat()
            except Exception as err:  # no table yet
                print(f'emergency copies: {err}', file=sys.stderr)
        if state.get('crypto_day') != today.isoformat():
            try:
                _crypto_job()
                state['crypto_day'] = today.isoformat()
            except (EfaError, OSError) as err:
                print(f'own certificates: {err}', file=sys.stderr)
        try:
            _sign_counts_store(today)
        except (EfaError, OSError) as err:
            print(f'signing counters: {err}', file=sys.stderr)
        _exports_job()
        if _json_read(MTA_STS_FILE, {}) and state.get('mta_sts_day') != today.isoformat():
            state['mta_sts_day'] = today.isoformat()
            mta_sts_check()
        if _json_read(SECURITY_SETTINGS, {}).get('daily') and state.get('security_day') != today.isoformat():
            state['security_day'] = today.isoformat()
            security_check(None)
        if state.get('floor_day') != today.isoformat():
            # 6.0.0.5: the security minimum once a day too, and a new EU link locks the EU settings of the setup again.
            state['floor_day'] = today.isoformat()
            try:
                floor_check(argparse.Namespace(mode='check', service=''))
            except (EfaError, OSError, subprocess.SubprocessError) as err:
                print(f'security minimum: {err}', file=sys.stderr)
            _safe(setup_eu_autolock, None)
    except Exception as err:  # also pymysql errors, before the upgrade made the columns: the mail report still runs
        print(f'rules and tenants: {err}', file=sys.stderr)
    if uq_state()['enabled']:
        try:
            _uq_job(state, today)
        except (EfaError, OSError, subprocess.CalledProcessError) as err:
            print(f'quarantine: {err}', file=sys.stderr)
    wanted = _json_read(REPORTS_FILE, {})
    # The new daily report replaces the short one.
    if not wanted.get('daily') and _report_settings()['daily'] and state.get('last_daily') != yesterday and _report_read(yesterday):
        _admin_notify(f'eFa-next: mail report {yesterday}', _report_text(_report_view(_report_merge([yesterday]), yesterday)))
        state['last_daily'] = yesterday
    for period in reports_due(wanted, state, today):
        try:
            _reports_send(period, today)
            state[f'sent_{period}'] = today.isoformat()
        except EfaError as err:
            print(f'report {period}: {err}', file=sys.stderr)
    _json_write(REPORT_STATE, state)
    return {'lines_read_to': offset}


def mailreport_today(_args):
    """Today so far, as of the last hourly run."""
    day = _today().isoformat()
    return _report_view(_report_merge([day]), day)


def mailreport_yesterday(_args):
    """Yesterday."""
    day = (_today() - datetime.timedelta(days=1)).isoformat()
    return _report_view(_report_merge([day]), day)


def mailreport_week(_args):
    """The last 7 days."""
    days = [(_today() - datetime.timedelta(days=offset)).isoformat() for offset in range(7)]
    return _report_view(_report_merge(days), f'{days[-1]} to {days[0]}')


def mailreport_set(args):
    """Daily mail with yesterday's report to the admin."""
    data = {'daily': _on_off(args.mode)}
    _json_write(REPORT_FILE, data)
    return data


