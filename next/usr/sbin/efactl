        em_codes, em_sql, em_sent, em_noted, em_given = {}, [], [], [], []

        def em_query(sql, params=()):
            em_sql.append((sql, params))
            if sql.startswith('SELECT password, disabled, email FROM users'):
                return [dict(em_users[params[0]])] if params[0] in em_users else []
            if sql.startswith('SELECT sends FROM user_email_codes'):
                return [{'sends': em_codes[params[0]]['sends']}] if params[0] in em_codes else []
            if sql.startswith('REPLACE INTO user_email_codes'):
                em_codes[params[0]] = {'code_hash': params[1], 'expires': time.time() + params[2] * 60, 'tries': 0, 'sends': params[3]}
            elif sql.startswith('SELECT code_hash, tries'):
                row = em_codes.get(params[0])
                return [{'code_hash': row['code_hash'], 'tries': row['tries'], 'fresh': int(row['expires'] > time.time())}] if row else []
            elif sql.startswith('UPDATE user_email_codes SET tries'):
                em_codes[params[2]].update(tries=params[0], code_hash=params[1])
            elif sql.startswith('UPDATE user_email_codes SET code_hash = NULL'):
                em_codes[params[0]]['code_hash'] = None
            elif sql.startswith('REPLACE INTO user_totp'):
                em_totp[params[0]] = {'secret': '', 'active': 0, 'last_step': 0, 'recovery': None, 'reenroll': 1}
            elif sql.startswith('SELECT reenroll'):
                return [{'reenroll': em_totp[params[0]]['reenroll']}] if params[0] in em_totp else []
            return []
        globals().update(_admin_query=em_query, _audit=em_noted.append, _account_mail=lambda *a: em_sent.append(a), identity_now=None,
                         strict_record=lambda *a, **k: None, own_hostname=lambda: 'mx.example.org', _totp_row=lambda user: em_totp.get(user),
