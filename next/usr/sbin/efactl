            elif sql.startswith('INSERT INTO user_totp'):
                re_db.setdefault(params[0], {'reenroll': 0}).update(secret=params[1], active=0, last_step=0, recovery=None)
            elif sql.startswith('UPDATE user_totp SET active = 1'):
                re_db[params[2]].update(active=1, last_step=params[0], recovery=params[1], reenroll=0)
            elif sql.startswith('SELECT reenroll'):
                return [{'reenroll': re_db[params[0]]['reenroll']}] if params[0] in re_db else []
            return []
        globals().update(_admin_query=re_query, _audit=re_noted.append, _account_mail=lambda *a: re_sent.append(a),
                         _account_row=lambda user: {'email': user + '@example.org'}, identity_now={'username': 'boss', 'role': 'super'},
