        from cryptography import x509
        from cryptography.hazmat.primitives import hashes, serialization
        from cryptography.hazmat.primitives.asymmetric import ec
        from cryptography.x509.oid import NameOID

        def certificate(issuer_name, names, days=30):
            key = ec.generate_private_key(ec.SECP256R1())
            now = datetime.datetime.now(datetime.timezone.utc)
            builder = (x509.CertificateBuilder().subject_name(x509.Name([x509.NameAttribute(NameOID.COMMON_NAME, names[0])]))
                       .issuer_name(x509.Name([x509.NameAttribute(NameOID.COMMON_NAME, issuer_name)])).public_key(key.public_key())
                       .serial_number(1).not_valid_before(now - datetime.timedelta(days=1)).not_valid_after(now + datetime.timedelta(days=days))
                       .add_extension(x509.SubjectAlternativeName([x509.DNSName(name) for name in names]), critical=False))
            return builder.sign(key, hashes.SHA256()).public_bytes(serialization.Encoding.PEM)
        assert certificate_for('mx.example.org', certificate('R11', ['mx.example.org'])) == ''
        assert certificate_for('mx.example.org', certificate('R11', ['*.example.org'])) == ''
        assert certificate_for('MX.Example.ORG', certificate('R11', ['mx.example.org'])) == '', 'a host name in capitals'
        assert 'self-signed' in certificate_for('mx.example.org', certificate('mx.example.org', ['mx.example.org']))
        import warnings
        assert 'not valid now' in certificate_for('mx.example.org', certificate('R11', ['mx.example.org'], days=0))
        with warnings.catch_warnings():
            warnings.simplefilter('error')
            dated = x509.load_pem_x509_certificate(certificate('R11', ['mx.example.org']))
            assert cert_valid_from(dated).tzinfo and cert_valid_from(dated) < cert_valid_until(dated), 'no deprecation warning'

        class OldCert:
            not_valid_before, not_valid_after = datetime.datetime(2026, 1, 1), datetime.datetime(2026, 4, 1)
        assert cert_valid_until(OldCert()) == datetime.datetime(2026, 4, 1, tzinfo=datetime.timezone.utc), 'cryptography before 42 (EL9)'
        assert 'does not name' in certificate_for('mx.example.org', certificate('R11', ['other.example.org']))
        # MIG-LE: a lineage of eFa 5 (RSA) is taken as it is: no new key, the key type stays, renewals keep the key.
        from cryptography.hazmat.primitives.asymmetric import rsa
        rsa_key = rsa.generate_private_key(public_exponent=65537, key_size=2048)
        stamp = datetime.datetime.now(datetime.timezone.utc)
        rsa_cert = (x509.CertificateBuilder().subject_name(x509.Name([x509.NameAttribute(NameOID.COMMON_NAME, 'mx.example.org')]))
                    .issuer_name(x509.Name([x509.NameAttribute(NameOID.COMMON_NAME, 'R11')])).public_key(rsa_key.public_key()).serial_number(2)
                    .not_valid_before(stamp - datetime.timedelta(days=1)).not_valid_after(stamp + datetime.timedelta(days=60))
                    .add_extension(x509.SubjectAlternativeName([x509.DNSName('mx.example.org')]), critical=False)
                    .sign(rsa_key, hashes.SHA256()).public_bytes(serialization.Encoding.PEM))
        rsa_pem = rsa_key.private_bytes(serialization.Encoding.PEM, serialization.PrivateFormat.PKCS8, serialization.NoEncryption())
        other_pem = ec.generate_private_key(ec.SECP256R1()).private_bytes(serialization.Encoding.PEM, serialization.PrivateFormat.PKCS8,
                                                                             serialization.NoEncryption())
        assert certificate_problem('mx.example.org', rsa_cert, rsa_pem) == ''
        assert certificate_problem('mx.example.org', rsa_cert, other_pem) == 'the key does not fit the certificate'
        assert 'does not name' in certificate_problem('other.example.org', rsa_cert, rsa_pem)
        renewal_rsa = 'version = 1.22.0\narchive_dir = /etc/letsencrypt/archive/mx.example.org\n\n[renewalparams]\nkey_type = rsa\nrsa_key_size = 2048\n' \
                      'authenticator = apache\ninstaller = apache\npre_hook = systemctl stop httpd\naccount = 0a1b\n'
