        # Escalation: within the own tenant yes, beyond it or above the own permissions no.
        grants = lambda *members: grants_of([{'group': built[key], 'tenant_id': tenant, 'domain': domain} for key, tenant, domain in members], tenant_domains)
        assert grants_cover(None, grants(('super', None, None))) and grants_cover(super_user['grants'], grants(('tenant', 1, None)))
        assert grants_cover(tenant_user['grants'], grants(('domain', None, 'a.example'))) and grants_cover(tenant_user['grants'], grants(('helpdesk', 1, None)))
        assert grants_cover(tenant_user['grants'], grants(('user', 1, None))) and grants_cover(tenant_user['grants'], grants(('tenant', 1, None)))
        assert not grants_cover(tenant_user['grants'], grants(('super', None, None))) and not grants_cover(tenant_user['grants'], grants(('domain', None, 'b.example')))
        assert not grants_cover(tenant_user['grants'], grants(('user', None, None))) and not grants_cover(tenant_user['grants'], grants(('helpdesk', None, None)))
        assert not grants_cover(tenant_user['grants'], grants(('tenant', 2, None))) and not grants_cover(domain_user['grants'], grants(('user', 1, None)))
        assert not command_allowed(global_help, 'user-set', True) and not command_allowed(scoped_help, 'user-set', True), 'without users.manage no user changes'
        assert grants_cover(tenant_user['grants'], grants(('readonly', 1, None))) and not grants_cover(tenant_user['grants'], grants(('readonly', None, None)))
        # Permissions add up over groups; a global-only permission in a scoped group does not count.
        two = grants(('domain', None, 'a.example'), ('auditor', 2, None))
        assert two['audit.view'] == {'tenants': {2}, 'domains': {'b.example'}} and two['search'] == {'tenants': set(), 'domains': {'a.example'}}
        assert 'settings.view' not in grants(('readonly', 1, None)) and grants(('readonly', None, None))['settings.view'] is None
        own = _group_row({'id': 99, 'name': 'mail team', 'builtin': None, 'description': '', 'permissions': 'search export quarantine.view', 'scope': 'domains',
                          'scope_tenants': '', 'scope_domains': 'a.example,c.example', 'disabled': 0})
