        assert '/var/lib/clamav' in sandbox_text('clamav-freshclam') and '/var/lib/unbound' in sandbox_text('unbound')
        class SandboxPlatform:
            def __init__(self):
                self.on, self.active, self.checks = {'unbound'}, {'rspamd': True, 'nginx': True, 'redis': True, 'unbound': False}, {}
            def service_exists(self, name): return name in self.active
            def service_hardening(self, name, on):
                changed = (name in self.on) != on
                (self.on.add if on else self.on.discard)(name)
                return changed
            def service_restart(self, name, check=True):
                if name == 'redis' and name in self.on:
                    raise RuntimeError('Job for redis.service failed')
                self.active[name], self.checks[name] = not (name == 'nginx' and name in self.on), 0
            def service_try_restart(self, name): self.service_restart(name)
            def service_is_enabled(self, name): return True
            def service_is_active(self, name):
                # rspamd with the sandbox comes up and falls over after three checks.
                self.checks[name] = self.checks.get(name, 0) + 1
                return self.active.get(name, False) and not (name == 'rspamd' and name in self.on and self.checks[name] > 3)
        saved_sandbox = (_platform, HARDEN_FILE, time.sleep, HARDENED_SERVICES, UNHARDENED_SERVICES, _event)
        sandbox, events = SandboxPlatform(), []
        globals().update(_platform=lambda: sandbox, HARDEN_FILE=tmp + '/hardening.json', HARDENED_SERVICES=('rspamd', 'nginx', 'redis'),
                         UNHARDENED_SERVICES=('unbound',), _event=lambda name, severity='info', **fields: events.append(fields['service']))
        time.sleep = lambda seconds: None
        try:
            result = service_harden(ns(mode='on'))['services']
            on_after, events_after = set(sandbox.on), sorted(events)
            kept_mode = service_harden(ns(mode='keep'))['mode']
        finally:
            time.sleep = saved_sandbox[2]
            globals().update(_platform=saved_sandbox[0], HARDEN_FILE=saved_sandbox[1], HARDENED_SERVICES=saved_sandbox[3],
                             UNHARDENED_SERVICES=saved_sandbox[4], _event=saved_sandbox[5])
        failed = 'failed with the sandbox, back without it'
        assert result == {'unbound': 'sandbox removed (not tested with SELinux)', 'rspamd': failed, 'nginx': failed, 'redis': failed}, result
        assert on_after == set() and sandbox.active['unbound'] and sandbox.active['redis'] and events_after == ['nginx', 'redis', 'rspamd']
        assert kept_mode == 'on', 'the update keeps the choice'
        # D-1: default puts only the tested mail services in the sandbox and takes it off the others; keep keeps default.
        class CalmPlatform(SandboxPlatform):
            def service_restart(self, name, check=True): self.active[name] = True
            def service_is_active(self, name): return self.active.get(name, False)
        calm = CalmPlatform()
