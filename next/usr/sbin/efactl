            for _ in range(4):
                uplink_watch_run(None, probe=lambda p: True)
            assert switches == ['backup'] and uplink_watch_run(None, probe=lambda p: True)['active'] == 'main' and switches == ['backup', 'main']
            _json_write(UPLINK_FAILOVER_FILE, {'enabled': True, 'backup': 'ens36'})
            for _ in range(4):
                held = uplink_watch_run(None, probe=lambda p: False, ready=lambda *a: 'no PTR')
            assert held['active'] == 'main' and held['ready'] is False and switches == ['backup', 'main'], 'not fit: no switch'
        finally:
            globals().update(kept_g719)
        # F11 (security review 2026-11-24): the subject of a copy is sealed like the mail, never kept in clear text.
        assert emergency_subject(None, {}) == '' and emergency_subject(b'', {}) == ''
        assert emergency_subject(b'x', {'t': b'k'}, decrypt=lambda blob, keys: b'Hello \xc3\xa4' if keys == {'t': b'k'} else b'') == 'Hello \u00e4'
        assert emergency_subject(b'x', {}, decrypt=lambda blob, keys: (_ for _ in ()).throw(ValueError('no key'))) == ''
        assert 'subject_sealed BLOB' in ADMIN_SQL and "SET subject = ''" in ADMIN_SQL
        # G7-20: mboxrd quotes every From_ line once more, the ZIP names its files by number only.
        box = mboxrd([('a@x.example', 0, b'Subject: s\r\n\r\nFrom here\r\n>From there\r\nend'), ('', 0, b'Subject: t\n\nok\n')])
        assert box.startswith(b'From a@x.example Thu Jan  1 00:00:00 1970\n') and b'\n>From here\n>>From there\nend\n\n' in box
        assert b'From MAILER-DAEMON ' in box and box.count(b'\nFrom ') == 1
        names = zipfile.ZipFile(io.BytesIO(emergency_zip([('a@x.example', 0, b'Subject: secret\r\n\r\nx')] * 2))).namelist()
        assert names == ['0001.eml', '0002.eml']
        kept_g720 = {name: globals()[name] for name in ('EMERGENCY_EXPORTS', 'identity_now', '_emergency_mailbox', '_audit', '_emergency_who')}
        try:
            globals().update(EMERGENCY_EXPORTS=tmp + '/exports.json', _audit=lambda text: None, _emergency_who=lambda args: ('user', 'anna@own.example'),
                             identity_now={'username': 'anna@own.example', 'role': 'user', 'domains': None},
                             _emergency_mailbox=lambda address, kind, who: [('b@x.example', 0, b'Subject: hi\n\nhello\n')])
            asked = emergency_export(argparse.Namespace(address='anna@own.example', format='mbox', reason='', notify=''))
            for bad in (argparse.Namespace(address='bert@own.example', format='zip', reason='', notify=''),
                        argparse.Namespace(address='anna@own.example', format='pst', reason='', notify='')):
                try:
                    emergency_export(bad)
                    raise AssertionError(vars(bad))
                except EfaError:
                    pass
            got = emergency_export_fetch(argparse.Namespace(export=asked['export']))
            assert got['name'].endswith(f"-{asked['export']}.mbox") and base64.b64decode(got['file']).startswith(b'From b@x.example ')
            for again in (asked['export'], '1', 'x'):
                try:
                    emergency_export_fetch(argparse.Namespace(export=again))
                    raise AssertionError('fetched twice or a strange number')
                except EfaError:
                    pass
            other = emergency_export(argparse.Namespace(address='anna@own.example', format='zip', reason='', notify=''))
            globals()['identity_now'] = {'username': 'carl@own.example', 'role': 'user', 'domains': None}
            try:
                emergency_export_fetch(argparse.Namespace(export=other['export']))
                raise AssertionError('another login fetched it')
            except EfaError:
                pass
        finally:
            globals().update(kept_g720)
        assert 'emergency-export' in FOUR_EYES_COMMANDS and not os.path.exists(tmp + '/exports.json.tmp')
        # G7-23: rules that ClamAV refuses are left out one by one; the others stay together.
        rules = ''.join(f'rule r{n} {{ strings: $a = "x{n}" condition: $a }}\n' for n in range(6)) + 'rule bad { condition: true }\n'
        load = lambda args, **kw: argparse.Namespace(returncode=0, stdout=f"Known viruses: {open(args[1].split('=', 1)[1]).read().count('rule ')}\n"
                                                      + ('Infected files: 0\n' if '--recursive' in args else ''),
                                                      stderr='no supported strings' if 'rule bad' in open(args[1].split('=', 1)[1]).read() else '')
        good, gone = yara_loadable(rules, load)
        assert gone == 1 and good.count('rule r') == 6 and 'rule bad' not in good, (gone, good)
        assert [YARA_RULE_RE.search(item).group(1) for item in yara_split('// eFa-next YARA bundle 2026.11\nrule a { condition: true }\nprivate rule b { condition: true }\n')] == ['a', 'b']
        kept_g723 = {name: globals()[name] for name in ('YARA_COMMUNITY_FILE', 'YARA_COMMUNITY_DB', '_sane_reload', '_audit', '_yara_community_fetch')}
        try:
            globals().update(YARA_COMMUNITY_FILE=tmp + '/yc.json', YARA_COMMUNITY_DB=tmp + '/yc.yar', _sane_reload=lambda: None, _audit=lambda text: None,
                             _yara_community_fetch=lambda fetch=None: '// eFa-next YARA bundle 2026.11\n// expires 2999-01-01\n' + rules)
            _json_write(YARA_COMMUNITY_FILE, {'enabled': True})
            done = yara_community_run(None, run=load)
            assert done['rules'] == 6 and done['left_out'] == 1 and done['version'] == '2026.11' and 'rule bad' not in open(YARA_COMMUNITY_DB).read()
            # F6 (security review 2026-11-24): an older bundle (a replay) and an expired one are refused, the rules of before stay.
            globals()['_yara_community_fetch'] = lambda fetch=None: '// eFa-next YARA bundle 2026.10\n// expires 2999-01-01\n' + rules
            assert 'older' in yara_community_run(None, run=load)['error'] and os.path.exists(YARA_COMMUNITY_DB)
            globals()['_yara_community_fetch'] = lambda fetch=None: '// eFa-next YARA bundle 2026.12\n// expires 2000-01-01\n' + rules
            assert 'expired' in yara_community_run(None, run=load)['error']
            globals()['_yara_community_fetch'] = lambda fetch=None: '// eFa-next YARA bundle 2026.12\n' + rules
            assert 'no expiry' in yara_community_run(None, run=load)['error']
            # F6: a set that hits a clean mail is refused; the real load of the final set is what is measured.
            hit = lambda args, **kw: argparse.Namespace(returncode=1 if '--recursive' in args else 0, stderr='',
                                                         stdout=('Infected files: 2\n' if '--recursive' in args else f"Known viruses: {open(args[1].split('=', 1)[1]).read().count('rule ')}\n"))
            globals()['_yara_community_fetch'] = lambda fetch=None: '// eFa-next YARA bundle 2026.12\n// expires 2999-01-01\n' + rules
            assert 'false positives' in yara_community_run(None, run=hit)['error'] and _json_read(YARA_COMMUNITY_FILE, {})['version'] == '2026.11'
            assert yara_community_run(None, run=load)['version'] == '2026.12'
            assert yara_clean_scan('rule r { strings: $a = "zz" condition: $a }\n', load, {'a.eml': 'x'})[0] == 0
            # F6: the search for refused rules stops after YARA_BISECT_RUNS test loads.
            refuse = lambda args, **kw: argparse.Namespace(returncode=0, stdout='Known viruses: 0\n', stderr='')
            try:
                yara_loadable(''.join(f'rule q{n} {{ strings: $a = "q{n}" condition: $a }}\n' for n in range(200)), refuse)
                raise AssertionError('no bound')
            except EfaError as err:
                assert 'test loads' in str(err)
            assert set(YARA_CLEAN_SET) >= {'plain.eml', 'newsletter.eml', 'invoice.eml'}
            globals()['_yara_community_fetch'] = lambda fetch=None: (_ for _ in ()).throw(EfaError('The signature of the bundle does not fit the eFa-next key.'))
            _json_write(YARA_COMMUNITY_FILE, {**_json_read(YARA_COMMUNITY_FILE, {}), 'version': ''})
            assert 'stay' in yara_community_run(None, run=load)['error'] and os.path.exists(YARA_COMMUNITY_DB), 'a bad signature keeps the old rules'
            _json_write(YARA_COMMUNITY_FILE, {'enabled': False})
            yara_community_run(None)
            assert not os.path.exists(YARA_COMMUNITY_DB), 'off: the rules go'
        finally:
            globals().update(kept_g723)
        model = ml_train_model([(['BAYES_SPAM', 'RBL_X'], 1)] * 10 + [(['BAYES_HAM', 'DKIM_OK'], 0)] * 10)
        assert model['weights']['BAYES_SPAM'] > 0.5 and model['weights']['BAYES_HAM'] < -0.5, model
        assert '//' not in ML_LUA_TEXT and 'utf8.' not in ML_LUA_TEXT and "%.2f" in ML_LUA_TEXT % {'score': 4.0}
        conf, group = neural_texts({**NEURAL_DEFAULTS, 'enabled': True, 'max_trains': 500})
        assert 'enabled = true;' in conf and 'max_trains = 500;' in conf and 'symbol_spam = "NEURAL_SPAM";' in conf
        assert '"NEURAL_HAM" { weight = -2.0;' in group and 'enabled = false;' in neural_texts({**NEURAL_DEFAULTS, 'enabled': False})[0]
        tls = _report_tls(_report_merge([now.isoformat()]))
        assert (tls['inbound_percent'], tls['outbound_percent'], tls['failed_inbound'], tls['failed_outbound']) == (50, 100, 1, 0), tls
        assert tls['inbound'] == [{'name': 'TLSv1.3 TLS_AES_256_GCM_SHA384', 'mails': 1}] and tls['outbound_trust'] == [{'name': 'Verified', 'mails': 1}]
        assert sign_rows('2026-11-05', {'dkim|x.org|efa-rsa': '3', 'unsigned|x.org|': '1', 'arc|x.org|efa-arc': '2', 'bad': '1', 'dkim|a b|s': '1',
                                        'dkim|x.org|s': 'x'}) == [('2026-11-05', 'dkim', 'x.org', 'efa-rsa', 3), ('2026-11-05', 'unsigned', 'x.org', '', 1),
                                                                 ('2026-11-05', 'arc', 'x.org', 'efa-arc', 2)]
        keys = [{'domain': 'x.org', 'selector': 'efa-rsa', 'public': ('rsa', ''), 'purpose': 'dkim', 'state': 'active', 'path': tmp + '/none'},
                {'domain': 'x.org', 'selector': 'efa-ed25519', 'public': ('ed25519', ''), 'purpose': 'dkim', 'state': 'active', 'path': tmp + '/none'}]
        signing = _report_signing([{'kind': 'dkim', 'domain': 'x.org', 'selector': 'efa-rsa', 'n': 3}, {'kind': 'dkim', 'domain': 'x.org', 'selector': 'efa-ed25519', 'n': 2},
                                   {'kind': 'arc', 'domain': 'x.org', 'selector': 'efa-arc', 'n': 1}, {'kind': 'unsigned', 'domain': 'x.org', 'selector': '', 'n': 4}],
                                  keys, [{'domain': 'x.org', 'next_rotation': '2027-02-01', 'auto_rotate': True}])
        assert signing == [{'domain': 'x.org', 'rsa': 3, 'ed25519': 2, 'arc': 1, 'unsigned': 4, 'key_age_days': None, 'next_rotation': '2027-02-01',
                            'auto_rotate': True}], signing
        auth = _report_auth([{'domain': 'a.org', 'spf': 'pass', 'dkim': 'fail', 'dmarc': 'fail', 'arc': '', 'n': 2},
                             {'domain': 'a.org', 'spf': 'pass', 'dkim': 'pass', 'dmarc': 'pass', 'arc': 'pass', 'n': 5}])
        assert auth == [{'domain': 'a.org', 'mails': 7, 'dkim_fail': 2, 'dmarc_fail': 2, 'arc_none': 2}], auth
        assert report_domains(['a.org', 'b.org'], 'B.org') == ['b.org'] and report_domains(None, '') is None and report_domains(['a.org'], '') == ['a.org']
        rejected(lambda item: report_domains(['a.org'], item), 'c.org')
        page = report_html({'from': '2026-11-04', 'to': '2026-11-04', 'total': 7, 'actions': {}, 'failed_checks': {}, 'per_day': [], 'top_blocked_senders': [],
                            'top_targets': [], 'auth_by_sender_domain': auth, 'top_failing_sources': [], 'signing': signing, 'tls': tls,
                            'dmarc_aggregate': [{'domain': 'x.org', 'reports': 2}]})
        assert 'Outbound signing by own domain' in page and 'RSA 3, Ed25519 2, ARC seals 1, unsigned 4' in page and 'TLSv1.3 TLS_AES_128_GCM_SHA256' in page
        assert 'DMARC aggregate reports received' in page and 'TLS reports received' not in page
        with open(REPORT_LOG, 'a') as f:
            f.write(f'{head}/smtpd[1]: connect from d.example[192.0.2.5]\n')
        mailreport_run(ns())
        assert mailreport_today(ns())['summary']['smtp_connections'] == 3 and mailreport_today(ns())['summary']['received'] == 1
        assert _report_day('Dec', '31', datetime.date(2027, 1, 1)) == '2026-12-31' and _report_day('Jan', '1', datetime.date(2027, 1, 1)) == '2027-01-01'
        assert mailreport_yesterday(ns())['summary']['received'] == 0 and mailreport_week(ns())['summary']['received'] == 1
        rejected(lambda item: mailreport_set(item), ns(mode='x'))
    print('self-test ok')


