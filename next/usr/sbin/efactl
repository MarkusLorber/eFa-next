        second = dmarc_record_set(ns(domain='d.example', p='reject', sp='quarantine', np='reject', adkim='s', aspf='s', t='y',
                                     rua='mailto:r@other.example', ruf_enable='on', ruf='mailto:f@d.example', fo='1', ruf_ack='yes', external_confirm=EU_CONFIRM))
        assert second['record'] == ('v=DMARC1; p=reject; sp=quarantine; np=reject; adkim=s; aspf=s; '
                                    'rua=mailto:r@other.example; ruf=mailto:f@d.example; fo=1; t=y')
