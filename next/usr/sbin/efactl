        assert added['added'] == ['198.51.100.0/24', '2001:db8::/32'] and postfix['mynetworks'].count('198.51') == 0
        assert any('overlaps' in w for w in relay_networks_add(ns(networks='192.0.2.128/25', description=''))['warnings'])
        assert any('very broad' in w for w in relay_networks_add(ns(networks='8.0.0.0/8', description=''))['warnings'])
        relay_networks_remove(ns(network='8.0.0.0/8'))
        relay_networks_remove(ns(network='192.0.2.128/25'))
        rejected(lambda item: relay_networks_remove(item), ns(network='127.0.0.0/8'), ns(network='203.0.113.0/24'))
        relay_networks_remove(ns(network='192.0.2.0/24'))
