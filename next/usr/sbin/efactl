            os.symlink('eFa-next-Version', tmp + '/vf/eFa-Version')
            assert not _version_file_after_downgrade() and os.path.exists(tmp + '/vf/eFa-next-Version')
        finally:
            globals().update(ETC=saved_etc, _audit=saved_audit)
        assert _update_state()['mode'] == 'notify'
        rejected(lambda item: autoupdate_set(item), ns(mode='x', days='sun', time='03:00'), ns(mode='auto', days='xx', time='03:00'),
