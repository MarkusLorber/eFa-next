# The terms of use of each list, as their providers publish them; None: no terms found, the website applies. State of the
# links: RBL_TERMS_AS_OF. A new state asks the admins to confirm again; active lists stay active until then.
RBL_TERMS_AS_OF = '2026-11-06'
RBL_TERMS = {
    'spamcop': 'https://www.spamcop.net/fom-serve/cache/297.html', 'psbl': None,
    'uceprotect': 'https://www.uceprotect.net/en/index.php?m=13&s=0', 'barracuda': None,
    'spamhaus': 'https://www.spamhaus.org/blocklists/dnsbl-fair-use-policy/', 'spamhaus-dbl': 'https://www.spamhaus.org/blocklists/dnsbl-fair-use-policy/',
