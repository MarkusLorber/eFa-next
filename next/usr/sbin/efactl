def schema(_args):
    return {name: {key: cmd.get(key) for key in ('title', 'args', 'writes')} for name, cmd in COMMANDS.items()
            if command_allowed(identity_now, name, cmd.get('writes'))}


def menu():
    """Interactive menu, built from the same table as the web forms."""
    entries = [item for item in COMMANDS.items() if item[0] != 'backup-read'] + [('admin-password', {**CLI_ONLY['admin-password'], 'title': 'Web admin password',
                                                            'writes': True})]
    while True:
        print('\n--- eFa configuration ---')
        for number, (_, cmd) in enumerate(entries, 1):
            print(f'{number:>3}) {cmd["title"]}')
        print('  s) Shell\n  l) Log out')
        try:
            choice = input('[eFa] : ').strip()
        except EOFError:
            return 0
        if choice == 's':
            return 0
        if choice == 'l':
            subprocess.run(['pkill', '-KILL', '-t', os.ttyname(0).replace('/dev/', '')], check=False)
            return 0
        if not choice.isdigit() or not 1 <= int(choice) <= len(entries):
            print(f'Error "{choice}" is not an option...')
            continue
        name, cmd = entries[int(choice) - 1]
        values = {}
        for arg in cmd['args']:
            if arg.get('secret'):
                continue
            default = arg.get('default', '')
            label = arg.get('label', arg['name']) + (f' [{default}]' if default else '')
            values[arg['name']] = input(f'{label}: ').strip() or default
        try:
            result = cmd['func'](argparse.Namespace(**values))
            print(result['text'] if name == 'dkim-export' else json.dumps(result, indent=2))
        except (EfaError, subprocess.CalledProcessError, OSError) as err:
            print(f'ERROR: {err}')


def self_test():
    # A1: every subprocess.run gets a timeout; dnf and the like get a longer one; a caller's own timeout is kept.
    seen = {}
    real_run = _subprocess.run
    _subprocess.run = lambda cmd, **kw: seen.update(cmd=cmd, **kw)
    try:
        subprocess.run(['postconf', '-n'], capture_output=True)
        assert seen['timeout'] == SUBPROCESS_TIMEOUT and seen['capture_output'] is True, seen
        long_program = 'ssh'  # one of the programs that may run long (kept out of the os-lint patterns)
        subprocess.run([long_program, 'host'])
        assert seen['timeout'] == SUBPROCESS_LONG[long_program] == 1800
        subprocess.run(['dig', 'x'], timeout=5)
        assert seen['timeout'] == 5
    finally:
        _subprocess.run = real_run
    # A5: per-milter accept/tempfail. milter_default_action stays accept; only chosen milters turn mail away.
    global MILTER_HEALTH_FILE, _milter_ports
    real_ports, real_mh = _milter_ports, MILTER_HEALTH_FILE
    MILTER_HEALTH_FILE = os.path.join(tempfile.mkdtemp(), 'mh.json')
    _milter_ports = lambda: ['11332', '8907']
    try:
        assert milter_health_status(None)['milter_default_action'] == 'accept'
        assert all(m['action'] == 'accept' for m in milter_health_status(None)['milters']), 'default is accept'
        try:
            milter_health_set(argparse.Namespace(milter='25', action='tempfail'))
            raise AssertionError('a port Postfix does not call was taken')
        except EfaError:
            pass
        assert milter_health_set(argparse.Namespace(milter='11332', action='tempfail'))['tempfail'] == ['11332']
        assert _json_read(MILTER_HEALTH_FILE, {})['tempfail'] == ['11332']
        assert milter_health_set(argparse.Namespace(milter='11332', action='accept'))['tempfail'] == []
    finally:
        _milter_ports, MILTER_HEALTH_FILE = real_ports, real_mh
    global RSPAMD_DIR, DKIM_DIR, DKIM_CONF, SUBJECT_TAG, OPENDKIM_KEYS
    with tempfile.TemporaryDirectory() as tmp:
        RSPAMD_DIR, DKIM_DIR = tmp, tmp + '/dkim'
        os.makedirs(tmp + '/local.d')
        DKIM_CONF, SUBJECT_TAG, OPENDKIM_KEYS = tmp + '/local.d/d.conf', tmp + '/tag', tmp + '/none'
        ns = argparse.Namespace
        assert subject_get(ns())['subject_tag'] == ''
        assert subject_set(ns(text='[X]'))['subject_tag'] == '[X]'
        assert subject_get(ns())['subject_tag'] == '[X]'
        assert subject_set(ns(text=''))['subject_tag'] == ''
        for call, bad in ((subject_set, ns(text='a"b')), (dkim_generate, ns(domain='x;rm', bits='2048')),
                          (dkim_generate, ns(domain='a.example', bits='1024')),
                          (dkim_generate, ns(domain='a.example', bits='4097')),
                          (dkim_generate, ns(domain='a.example', bits='3000')),
                          (dkim_generate, ns(domain='a.example', bits='abc'))):
            try:
                call(bad)
            except EfaError:
                continue
            raise AssertionError(bad)
        for call, bad in ((relay_networks_set, ns(networks='0.0.0.0/0')), (relay_networks_set, ns(networks='x y')),
                          (smarthost_set, ns(host='a b;id')), (message_size_set, ns(megabytes='0')),
                          (spam_scores_set, ns(greylist='9', mark='6', reject='15')),
                          (greylisting_set, ns(mode='maybe')), (maintenance_set, ns(mode='')),
                          (sender_list_set, ns(list='x', action='add', address='a@b.de')),
                          (sender_list_set, ns(list='allow', action='add', address='a b@c.de'))):
            try:
                call(bad)
            except EfaError:
                continue
            raise AssertionError(bad)
        for call, bad in ((transport_set, ns(domain='x;id', action='add', destination='a.example')),
                          (transport_set, ns(domain='a.example', action='add', destination='a b')),
                          (transport_set, ns(domain='a.example', action='x', destination='b.example')),
                          (admin_email_set, ns(email='not an address')), (reboot_host, ns(confirm='no')),
                          (halt_host, ns(confirm='')), (update_now, ns(confirm='y'))):
            try:
                call(bad)
            except EfaError:
                continue
            raise AssertionError(bad)
        for call, bad in ((restore, ns(name='../../etc/passwd', confirm='yes')), (restore, ns(name='x', confirm='no')),
                          (network_set, ns(hostname='bad name', method='auto', address='', gateway='', ipv6_method='',
                                           ipv6_address='', ipv6_gateway='', confirm='yes')),
                          (letsencrypt_set, ns(domain='a.example', email='a@b.example', accept_tos='no')),
                          (letsencrypt_set, ns(domain='x;id', email='a@b.example', accept_tos='yes'))):
            try:
                call(bad)
            except EfaError:
                continue
            raise AssertionError(bad)
        for call, bad in ((maillog_search, ns(text='', limit='x')), (maillog_search, ns(text='', limit='0')),
                          (maillog_retention_set, ns(days='0')), (maillog_retention_set, ns(days='x')),
                          (maillog_retention_set, ns(days='3651')), (maillog_size_set, ns(megabytes='-1'))):
            try:
                call(bad)
            except EfaError:
                continue
            raise AssertionError(bad)
        for call, bad in ((milter_chain_set, ns(ports='x')), (milter_chain_set, ns(ports='11332')),
                          (milter_chain_set, ns(ports='11332 8999 11332')), (dns_zone_set, ns(zone='x;id', action='add', servers='1.1.1.1')),
                          (dns_zone_set, ns(zone='a.example', action='add', servers='nope')),
                          (dns_zone_set, ns(zone='a.example', action='add', servers='')),
                          (extra_service_set, ns(name='a;b', action='add')), (extra_service_set, ns(name='ok', action='x'))):
            try:
                call(bad)
            except EfaError:
                continue
            raise AssertionError(bad)
        global DMARC_CONF
        DMARC_CONF = tmp + '/local.d/dmarc.conf'
        for call, bad in ((quarantine_set, ns(mode='x')), (quarantine_days_set, ns(days='0')),
                          (sender_rule_set, ns(list='x', action='add', sender='a.example', recipient='')),
                          (sender_rule_set, ns(list='allow', action='add', sender='a|b', recipient='')),
                          (sender_rule_set, ns(list='allow', action='add', sender='***', recipient='')),
