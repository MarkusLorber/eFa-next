        # 12, N1: a feed fetched again only when it changed; the four lists from all feeds that are on.
        class Reply:
            def __init__(self, data, headers):
                self.data, self.headers = data, headers
            def read(self, size): return self.data[:size]
            def __enter__(self): return self
            def __exit__(self, *args): return False
        seen = []

        def opener(request, timeout):
            seen.append(dict(request.header_items()))
            if request.get_header('If-none-match') == '"v1"':
                raise urllib.error.HTTPError(request.full_url, 304, 'Not Modified', {}, None)
            return Reply(b'http://evil.example/x\n', {'ETag': '"v1"', 'Last-Modified': 'x'})
        item = {'kind': 'urlhaus', 'url': 'https://urlhaus.example/'}
        data, cache = feed_fetch('urlhaus', item, {}, opener)
        assert data == b'http://evil.example/x\n' and cache['etag'] == '"v1"'
        assert feed_fetch('urlhaus', item, cache, opener) == (None, cache) and seen[-1].get('If-none-match') == '"v1"'
        saved_feeds = (FEEDS_FILE, FEEDS_STATE, FEEDS_DIR, FEED_MAPS, feed_fetch)
        globals().update(FEEDS_FILE=tmp + '/feeds.json', FEEDS_STATE=tmp + '/feeds-state.json', FEEDS_DIR=tmp + '/feeds',
