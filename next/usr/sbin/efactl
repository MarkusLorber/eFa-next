        # Dovecot only while port 587 has logins: off is stopped and disabled, and 587 offers no AUTH.
        done_calls = []

        class FakePlatform:
            def service(self, logical):
                return {'sasl': 'dovecot', 'mta': 'postfix'}[logical]

            def service_exists(self, name):
                return True

            def __getattr__(self, name):
                return lambda *args, **kwargs: done_calls.append((name, args, kwargs))
        saved_platform, kept_run = globals()['_platform'], subprocess.run
        globals()['_platform'] = FakePlatform
        subprocess.run = lambda argv, **kwargs: done_calls.append(('run', tuple(argv), {}))
        try:
            _sasl_apply(False, pam_on=False)
            assert ('service_disable', ('efa-sasl.socket',), {'stop': True}) in done_calls
            assert ('run', ('postconf', '-P', 'submission/inet/smtpd_sasl_auth_enable=no'), {}) in done_calls
            done_calls.clear()
            _sasl_apply(True, pam_on=False)
            assert ('service_enable', ('efa-sasl.socket',), {'start': True}) in done_calls and ('service_disable', ('dovecot',), {'stop': True}) in done_calls
            assert ('run', ('postconf', '-P', 'submission/inet/smtpd_sasl_auth_enable=yes'), {}) in done_calls
            assert ('run', ('postconf', '-P', 'submission/inet/smtpd_sasl_path=/run/efa-sasl/auth'), {}) in done_calls
            done_calls.clear()
            _sasl_apply(True, pam_on=True)
            assert ('run', ('postconf', '-PX', 'submission/inet/smtpd_sasl_path'), {}) in done_calls, 'Dovecot: the socket of Postfix again'
            assert ('service_enable', ('dovecot',), {'start': True}) in done_calls and ('service_disable', ('efa-sasl.socket',), {'stop': True}) in done_calls
        finally:
            globals()['_platform'], subprocess.run = saved_platform, kept_run
