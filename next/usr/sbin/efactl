                         feed_fetch=lambda name, item, previous: (b'https://bad.example/a\n' if name == 'a' else b'http://worse.example/b\n', {}))
        _json_write(FEEDS_FILE, {'feeds': {'a': {'kind': 'urlhaus', 'url': 'https://a/', 'enabled': True}, 'b': {'kind': 'list', 'url': 'https://b/', 'enabled': True},
