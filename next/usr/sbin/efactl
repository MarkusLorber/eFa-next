        BACKUP_PATHS, BACKUP_DATA_PATHS = saved_paths

        # Automatic updates: versions, window and blockers.
        global UPDATE_FILE, MONITOR_CRON, RESTORE_RUNNING
        UPDATE_FILE, MONITOR_CRON, RESTORE_RUNNING = tmp + '/update.json', tmp + '/monitor', tmp + '/restore'
        # The way back to 6.0.0.5.x: its own /etc/eFa-Version file, the newer name goes; on 6.0.0.6 (a symlink) both stay.
        saved_etc, saved_audit = globals()['ETC'], globals()['_audit']
        try:
            globals().update(ETC=tmp + '/vf', _audit=lambda text: None)
            os.makedirs(tmp + '/vf', exist_ok=True)
            for name, text in (('eFa-next-Version', 'eFa-6.0.0.6\n'), ('eFa-Version', 'eFa-6.0.0.5.2\n')):
                with open(f'{tmp}/vf/{name}', 'w') as f:
                    f.write(text)
            assert _version_file_after_downgrade() and not os.path.exists(tmp + '/vf/eFa-next-Version')
            assert _update_installed() == 'eFa-6.0.0.5.2'
            with open(tmp + '/vf/eFa-next-Version', 'w') as f:
                f.write('eFa-6.0.0.6\n')
