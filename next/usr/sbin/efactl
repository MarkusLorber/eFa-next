        # /etc/hosts: the own name on an address of no interface is a warning; loopback and own addresses are not.
        hosts_text = '127.0.0.1 mx1.example.org mx1 localhost\n192.0.2.1 mx1.example.org mx1 # gateway by mistake\n192.0.2.3 mx1.example.org\n'
