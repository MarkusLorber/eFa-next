        # 5v (h): no distribution unit is on the list until it is tested with SELinux; their old drop-ins go and they start again.
        # A unit on the list that does not come up, flaps, or whose restart fails runs without the sandbox again.
        assert all(name.startswith('efa') for name in HARDENED_SERVICES) and not set(HARDENED_SERVICES) & set(UNHARDENED_SERVICES) and 'unbound' in UNHARDENED_SERVICES
        class SandboxPlatform:
            def __init__(self):
                self.on, self.active, self.checks = {'unbound'}, {'rspamd': True, 'nginx': True, 'redis': True, 'unbound': False}, {}
            def service_exists(self, name): return name in self.active
            def service_hardening(self, name, on):
                changed = (name in self.on) != on
                (self.on.add if on else self.on.discard)(name)
                return changed
            def service_restart(self, name, check=True):
                if name == 'redis' and name in self.on:
                    raise RuntimeError('Job for redis.service failed')
                self.active[name], self.checks[name] = not (name == 'nginx' and name in self.on), 0
            def service_try_restart(self, name): self.service_restart(name)
            def service_is_enabled(self, name): return True
            def service_is_active(self, name):
                # rspamd with the sandbox comes up and falls over after three checks.
                self.checks[name] = self.checks.get(name, 0) + 1
                return self.active.get(name, False) and not (name == 'rspamd' and name in self.on and self.checks[name] > 3)
        saved_sandbox = (_platform, HARDEN_FILE, time.sleep, HARDENED_SERVICES, UNHARDENED_SERVICES, _event)
