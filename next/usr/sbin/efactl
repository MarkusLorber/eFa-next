        # Internal DNS zones: only IP literals with an optional port, a #name only with TLS, never "." for all names; DNSSEC stays on
        # unless it is turned off for the zone; zones of older files keep their domain-insecure; a change unbound refuses goes back.
        assert dns_server_spec('192.0.2.53', False) == '192.0.2.53' and dns_server_spec('2001:DB8::53@5353', False) == '2001:db8::53@5353'
        assert dns_server_spec('192.0.2.53@853#dns.example.internal', True) == '192.0.2.53@853#dns.example.internal'
        rejected(lambda item: dns_server_spec(item, False), '192.0.2.300', 'dns.example.internal', '192.0.2.53;reboot', '$(id)', '192.0.2.53@0',
                 '192.0.2.53@70000', '192.0.2.53#dns.example.internal', '')
        rejected(lambda item: dns_server_spec(item, True), '192.0.2.53@853', '192.0.2.53@853#bad name')
