        class Done:
            def __init__(self, code, stderr='', stdout=''):
                self.returncode, self.stderr, self.stdout = code, stderr, stdout
        # What clamscan of ClamAV 1.4.6 prints, each with exit code 0: a rule without strings and a broken rule are skipped.
        good = 'rule a { strings: $a = "x" condition: $a }'
        assert yara_problem(good, run=lambda *a, **k: Done(0, '', 'sample.txt: OK\nKnown viruses: 1\n')) is None
        assert yara_problem(good, run=lambda *a, **k: Done(2, 'LibClamAV Error: cannot open')) == 'clamscan refused the rules: LibClamAV Error: cannot open'
        no_strings = Done(0, 'LibClamAV Warning: load_oneyara: yara rule contains no supported strings, skipping YARA.r\n', 'Known viruses: 0\n')
        assert yara_problem('rule r { condition: false }', run=lambda *a, **k: no_strings).startswith('the rule has no strings')
        broken = Done(0, 'LibClamAV Error: yyerror(): /tmp/x/own.yar line 1 syntax error, unexpected $end\n'
                         'LibClamAV Warning: cli_loadyara: failed to parse or load 1 yara rules from file /tmp/x/own.yar, successfully loaded 0 rules.\n'
                         'LibClamAV Warning: cli_loadyara: empty database file\n', 'Known viruses: 0\n')
        assert yara_problem('rule broken { condition: ', run=lambda *a, **k: broken) == 'syntax error: /tmp/x/own.yar line 1 syntax error, unexpected $end'
        assert yara_problem(good, run=lambda *a, **k: Done(0, '', 'Known viruses: 0\n')) == 'ClamAV loaded 0 of 1 rules'
        assert yara_problem(good, run=lambda *a, **k: Done(0, '', '')) == 'ClamAV loaded no of 1 rules'
        two = yara_compiled([{'name': 'a', 'tenant': '', 'text': good}, {'name': 'b', 'tenant': '', 'text': good.replace('rule a', 'rule b')}])
        assert yara_load_problem(two, run=lambda *a, **k: Done(0, '', 'Known viruses: 1\n')) == 'ClamAV loaded 1 of 2 rules'
        # The real check with clamscan (package clamav, a Requires of eFa-next-base): without it the self-test fails.
        assert shutil.which('clamscan'), 'self-test: clamscan missing, the YARA check cannot run'
