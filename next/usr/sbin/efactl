        if shutil.which('rspamadm'):
            # The lookalike check itself, in the Lua of rspamd (without its TLD list: get_tld gives the name back).
            part = BEC_LUA_TEXT[BEC_LUA_TEXT.index('local function lower'):BEC_LUA_TEXT.index('local function outbound')]
            cases = {'example.com.evil.net': 'subdomain', 'x.example.com.evil.net': 'subdomain', 'mail.example.com': 'none',
                     'example.com': 'none', 'example.net': 'tld', 'example.co': 'tld', 'exmple.com': 'typo', 'example-secure.net': 'cousin',
                     'unrelated.org': 'none', 'partner.example': 'none', 'mail.partner.example': 'none', 'partner.example.evil.org': 'subdomain'}
            script = ("local rspamd_util = require 'rspamd_util'\nlocal conf = {protected = {'example.com', 'partner.example'}, vips = {}}\n" + part +
                      ''.join(f"do local o, why = lookalike('{name}'); print('{name}=' .. (why or 'none')) end\n" for name in cases))
            with tempfile.NamedTemporaryFile('w', suffix='.lua', delete=False) as f:
                f.write(script)
            try:
                out = subprocess.run(['rspamadm', 'lua', f.name], capture_output=True, text=True, timeout=60).stdout
                # Only the result lines: a first start of rspamadm may print notes of its own.
                found = {name: why for name, _, why in (line.strip().partition('=') for line in out.splitlines()) if name in cases}
            finally:
                os.unlink(f.name)
            assert found == cases, found
