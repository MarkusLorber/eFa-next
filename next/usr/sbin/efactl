        from cryptography import x509
        from cryptography.hazmat.primitives import hashes, serialization
        from cryptography.hazmat.primitives.asymmetric import ec
        from cryptography.x509.oid import NameOID

        def certificate(issuer_name, names, days=30):
            key = ec.generate_private_key(ec.SECP256R1())
            now = datetime.datetime.now(datetime.timezone.utc)
            builder = (x509.CertificateBuilder().subject_name(x509.Name([x509.NameAttribute(NameOID.COMMON_NAME, names[0])]))
                       .issuer_name(x509.Name([x509.NameAttribute(NameOID.COMMON_NAME, issuer_name)])).public_key(key.public_key())
                       .serial_number(1).not_valid_before(now - datetime.timedelta(days=1)).not_valid_after(now + datetime.timedelta(days=days))
                       .add_extension(x509.SubjectAlternativeName([x509.DNSName(name) for name in names]), critical=False))
            return builder.sign(key, hashes.SHA256()).public_bytes(serialization.Encoding.PEM)
        assert certificate_for('mx.example.org', certificate('R11', ['mx.example.org'])) == ''
        assert certificate_for('mx.example.org', certificate('R11', ['*.example.org'])) == ''
