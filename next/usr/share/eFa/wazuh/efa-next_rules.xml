<!--
  eFa-next rules for the Wazuh manager. Copy to /var/ossec/etc/rules/.
  Rule IDs 108000-108099 and 108200-108299 (108100-108199 are the checks of the SCA policy). The fields are those of /var/log/eFa/events.json, see docs/WAZUH.md.
  The compliance groups (pci_dss_, gdpr_, hipaa_, nist_800_53_, gpg13_, tsc_) are copied from comparable rules of the
  Wazuh ruleset 4.14; the mapping is in docs/WAZUH.md.
-->
<group name="efa-next,">

  <rule id="108000" level="0">
    <decoded_as>json</decoded_as>
    <field name="efa_version">\.+</field>
    <field name="event">\.+</field>
    <description>eFa-next: event</description>
  </rule>

  <rule id="108001" level="0">
    <decoded_as>efa-events</decoded_as>
    <description>eFa-next: event over syslog</description>
  </rule>

  <rule id="108010" level="3">
