msgid "Add a domain and its mail server"
msgstr "Domain und ihren Mailserver hinzufügen"

msgid "Internal mail server, such as mail.example.org or 192.0.2.10:25"
msgstr "Interner Mailserver, etwa mail.example.org oder 192.0.2.10:25"

msgid "Harden this server"
msgstr "Diesen Server härten"

msgid "Standards"
msgstr "Standards"

msgid "Port 25"
msgstr "Port 25"

