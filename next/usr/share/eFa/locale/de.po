msgstr "Name der Quelle"

msgid "Client certificate of the source (PEM file on this host)"
msgstr "Client-Zertifikat der Quelle (PEM-Datei auf diesem Host)"

msgid "Domains it may deliver, separated by commas"
msgstr "Domains, die sie liefern darf, mit Komma getrennt"

msgid "Allowed addresses or networks, empty for any"
msgstr "Erlaubte Adressen oder Netze, leer für alle"

