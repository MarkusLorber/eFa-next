[Unit]
Description=eFa outbound milter: data loss prevention and disclaimers
After=network-online.target
Before=postfix.service

[Service]
Type=simple
DynamicUser=yes
LoadCredential=pdf-passwords:/etc/eFa/pdf-passwords.json
ExecStart=/usr/bin/python3 /usr/local/sbin/efa-outbound.py
Restart=always
RestartSec=5
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
MemoryMax=256M

[Install]
WantedBy=multi-user.target
