[Unit]
Description=eFa-next check after each change of the installed packages

[Path]
PathChanged=/var/lib/rpm/rpmdb.sqlite
Unit=efa-os-check.service
TriggerLimitIntervalSec=300
TriggerLimitBurst=3

[Install]
WantedBy=paths.target
