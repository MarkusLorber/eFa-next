[Unit]
Description=eFa-next cluster service: master and clients over mutual TLS
After=network-online.target
# Not started at all on a host that is no member of a cluster: without its certificate it would only start again and again.
ConditionPathExists=/etc/eFa/cluster/node.crt

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/sbin/efa-cluster.py
Restart=always
RestartSec=5
# A node applies the settings of its master through efactl: Postfix, rspamd and the files of eFa-next under /etc change. So no
# ProtectSystem here; the service itself only speaks mutual TLS and runs a fixed list of efactl commands.
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
MemoryMax=256M

[Install]
WantedBy=multi-user.target
