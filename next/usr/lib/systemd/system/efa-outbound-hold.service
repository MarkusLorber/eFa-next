[Unit]
Description=eFa-next recall window and confirmation of attachments
# Nothing waits: not even a process is started.
ConditionDirectoryNotEmpty=/var/lib/efa-outbound/held

[Service]
Type=oneshot
ExecStart=/usr/sbin/efactl outbound-hold-run
