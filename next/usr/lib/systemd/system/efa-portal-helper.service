[Unit]
Description=eFa user portal helper: the fixed efactl commands of the portal, for its logged-in users only
After=network-online.target mariadb.service

[Service]
Type=simple
User=root
Group=efa-portal
ExecStart=/usr/bin/python3 /usr/local/sbin/efa-portal-helper.py
Restart=always
RestartSec=5
# The socket folder: root and the group of the portal.
RuntimeDirectory=efa-portal-helper
RuntimeDirectoryMode=0750
UMask=0007
PrivateTmp=yes
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
