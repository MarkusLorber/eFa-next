[Unit]
Description=eFa-next SASL socket for Postfix (SMTP-AUTH logins of port 587)

[Socket]
# Under /run, where systemd makes sockets (SELinux keeps it out of the private folder of Postfix); port 587 asks here.
ListenStream=/run/efa-sasl/auth
SocketUser=efa-sasl
SocketGroup=postfix
SocketMode=0660
DirectoryMode=0755
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
