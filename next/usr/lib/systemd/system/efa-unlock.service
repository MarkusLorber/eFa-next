[Unit]
Description=eFa-next unlock: encrypted ZIP archives opened for the virus scan of rspamd
After=network-online.target clamd@scan.service
Before=rspamd.service

[Service]
Type=simple
DynamicUser=yes
# clamd takes the files over its socket, which the group virusgroup may use.
SupplementaryGroups=virusgroup
ExecStart=/usr/bin/python3 /usr/local/sbin/efa-unlock.py
Restart=always
RestartSec=5
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
MemoryMax=256M
CPUQuota=50%
TasksMax=32

[Install]
WantedBy=multi-user.target
