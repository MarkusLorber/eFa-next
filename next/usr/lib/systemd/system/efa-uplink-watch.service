[Unit]
Description=eFa-next uplink failover watch (only while the failover is on)
After=network-online.target

[Service]
Type=oneshot
# A planned stop ends one round; the next minute asks again.
SuccessExitStatus=SIGTERM
ExecStart=/usr/sbin/efactl uplink-watch-run
