[Unit]
Description=eFa-next check after a reboot from the system update
ConditionPathExists=/etc/eFa/post-boot-check
After=network-online.target postfix.service rspamd.service nginx.service efa-web.service mariadb.service

[Service]
Type=oneshot
ExecStart=/usr/sbin/efactl update-post-boot

[Install]
WantedBy=multi-user.target
