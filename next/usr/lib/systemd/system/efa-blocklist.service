[Unit]
Description=eFa-next IP blocklists: fetch the feeds that are due and keep the table loaded
After=network-online.target nftables.service firewalld.service

[Service]
Type=oneshot
# A run that a planned stop ends (an update restarting the units of eFa-next) is no failure: the timer starts the next
# one. Without this the unit stays "failed" and the dashboard names it.
SuccessExitStatus=SIGTERM
ExecStart=/usr/sbin/efactl blocklist-run
