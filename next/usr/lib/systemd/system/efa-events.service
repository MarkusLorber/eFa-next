[Unit]
Description=eFa-next events: collect and send on
After=network-online.target
# Off, nothing to do: not even a process is started.
ConditionPathExists=/var/lib/eFa/events-on

[Service]
Type=oneshot
ExecStart=/usr/sbin/efactl events-run
