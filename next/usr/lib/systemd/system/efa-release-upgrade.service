[Unit]
Description=eFa-next release upgrade to EL10: one step (preflight, preupgrade or start)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# Lock, state and log are kept by efactl: /var/lib/eFa/release-upgrade/, /var/log/eFa/release-upgrade.log.
ExecStart=/usr/sbin/efactl release-upgrade-run
TimeoutStartSec=6h
