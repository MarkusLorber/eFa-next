[Unit]
Description=eFa-next QR: QR codes in pictures and PDF files for rspamd
After=network-online.target
Before=rspamd.service

[Service]
Type=simple
DynamicUser=yes
ExecStart=/usr/bin/python3 /usr/local/sbin/efa-qr.py
Restart=always
RestartSec=5
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
MemoryMax=256M
CPUQuota=50%
TasksMax=32

[Install]
WantedBy=multi-user.target
