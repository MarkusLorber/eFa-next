[Unit]
Description=eFa mail log writer
After=mariadb.service

[Service]
Type=simple
User=efa-mail
Group=efa-mail
# Reads the settings of root:efa-web 0640; as its own user it gets no root efactl through efactl-runner.
SupplementaryGroups=efa-web
ExecStart=/usr/bin/python3 /usr/local/sbin/efa-maillog.py
Restart=always
RestartSec=5
ProtectSystem=strict
# The prefix: the folder only exists once the quarantine for users is on.
ReadWritePaths=-/var/spool/efa-quarantine
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
