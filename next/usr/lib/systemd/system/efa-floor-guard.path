[Unit]
Description=eFa-next security minimum: check again after each change of the TLS settings of postfix, nginx and dovecot

[Path]
PathChanged=/etc/postfix/main.cf
PathChanged=/etc/postfix/master.cf
PathChanged=/etc/nginx/nginx.conf
PathChanged=/etc/nginx/efa-hardening.inc
PathChanged=/etc/nginx/conf.d
PathChanged=/etc/nginx/default.d
PathChanged=/etc/dovecot/dovecot.conf
PathChanged=/etc/dovecot/conf.d
Unit=efa-floor-guard.service

[Install]
WantedBy=paths.target
