[Unit]
Description=eFa: apply the settings of an unattended (kickstart) install
Wants=network-online.target
After=network-online.target mariadb.service
ConditionPathExists=/var/lib/eFa/setup/kickstart.conf

[Service]
Type=oneshot
ExecStart=/usr/sbin/efa-apply --verbose --answers /var/lib/eFa/setup/kickstart.conf --all
TimeoutStartSec=30min

[Install]
WantedBy=multi-user.target
