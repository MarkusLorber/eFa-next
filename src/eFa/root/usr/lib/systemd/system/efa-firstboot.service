[Unit]
Description=eFa: steps after the first boot that follows the setup
Wants=network-online.target
After=network-online.target NetworkManager.service
ConditionPathExists=/var/lib/eFa/firstboot-pending

[Service]
Type=oneshot
ExecStart=/usr/libexec/eFa/efa-firstboot
TimeoutStartSec=30min

[Install]
WantedBy=multi-user.target
