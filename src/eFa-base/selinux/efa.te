# eFa-next SELinux policy module. Rules only where a test on a host in enforcing mode showed them needed (README.md).

module efa 1.4.0;

require {
	type antivirus_t;
	type fail2ban_t;
	type kernel_t;
	class system module_request;
	type postfix_smtpd_t;
	type var_run_t;
	type unconfined_service_t;
	type unconfined_t;
	type httpd_var_run_t;
	type init_t;
	class file { create };
	class sock_file write;
	class unix_stream_socket connectto;
}

# 5u: Postfix (smtpd of port 587) asks efa-sasl on /run/efa-sasl/auth. systemd opens that socket (socket activation) and
# hands it to efa-sasl; Postfix got "Permission denied" there without these rules (AlmaLinux 9, enforcing).
# shortcut: var_run_t is the label of all of /run; a type of its own for /run/efa-sasl needs a file context in the package, later.
allow postfix_smtpd_t var_run_t:sock_file write;
allow postfix_smtpd_t unconfined_service_t:unix_stream_socket connectto;
allow postfix_smtpd_t init_t:unix_stream_socket connectto;

# NGINX-PID: "nginx -t" creates the pid file when it is not there (empty). efactl runs it in many places (security minimum,
# check after package updates, TLS, restore) as unconfined_service_t, an admin as unconfined_t: then /run/nginx.pid got the
# label of /run (var_run_t), and the next start of nginx (httpd_t) failed with "open() /run/nginx.pid failed (13: Permission
# denied)" (first boot of a new install, 2026-11-12). The pid file now gets the type of nginx whoever creates it.
type_transition unconfined_service_t var_run_t:file httpd_var_run_t "nginx.pid";
type_transition unconfined_t var_run_t:file httpd_var_run_t "nginx.pid";

# freshclam (libcurl) opens an IPv6 socket also where IPv6 is off, and the kernel tries to load net-pf-10: denied, and logged
# as an AVC on every update (AlmaLinux 9.8, enforcing, host without IPv6). Nothing breaks; only the log entry goes. Redis does
# the same and is avoided by its bind (efactl redis-tune).
dontaudit antivirus_t kernel_t:system module_request;

# fail2ban (its firewalld action) does the same at boot on a host without IPv6: kmod net-pf-10, denied, an AVC each boot.
# Only the log entry of this one request goes; the request itself stays denied.
dontaudit fail2ban_t kernel_t:system module_request;
